toolchain {
    host = ".prismio/build/debug/prismio"
}

project {
    name = "prismio"
    version = "0.1.0"
    prismio = "0.1.0"
    description = "The Prismio programming language and compiler"
    license = "Apache-2.0"
    authors = [
        "Saksham Jaiswal"
    ]
}

targets {
    executable("prismio") {
        entry = "src/main.psm"
        link {
            component("prismio.backend")
        }
    }
}

commands {
    command("dist") {
        description = "Package an installable toolchain and check the runtime/backend split"
        shell("tools/package.sh", "--compiler", ".prismio/build/debug/prismio",
              "--out", "dist/Prismio")
        shell("tools/verify_separation.sh", "--dist", "dist/Prismio")
    }

    command("suite") {
        description = "Run the compiler test suite against the project compiler"
        shell("python3", "tests/test_runner.py", args)
    }
}
