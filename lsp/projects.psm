// Which program a file belongs to.
//
// A module is not a program, and checking it as one is wrong (IDE_PROTOCOL.md): its imports
// resolve against the entry's directory, and it may use names the program shares without
// importing them. So the server checks the program a file belongs to, with the file's text
// overlaid. The compiler cannot say which program that is; this can, from the same sources the
// build uses:
//
//   1. the file declares `main`: it is a program of its own;
//   2. it is a module of the standard library in a Prismio checkout: checked alone, under the
//      name its importers use (`--module std.map`), which is what gives it its package's access;
//   3. a `build.ums` above it names entries: the entry whose directory holds the file, nearest
//      first (a module is found by its entry's directory);
//   4. otherwise the file alone.

import lsp.uri
import std.fs
import std.option
import std.string
import std.vec
import ums.model.project
import ums.model.workspace
import ums.targets.target

public struct Program {
    // The file to hand `check`.
    public entry: String,
    // The name for `--module`, or "" when `entry` is a program.
    public module: String
}

// Whether `path` is below `directory`, as a path and not as a prefix of a longer name.
fn projectIsUnder(path: String, directory: String) -> Bool {
    if (directory.equals("")) { return false }
    return path.startsWith(directory.concat("/"))
}

// `std.map` for a file `.../std/map.psm` in a checkout, "" for any other file.
fn projectStandardModuleName(path: String) -> String {
    let directory = directoryOf(path)
    if (directory.endsWith("/std") == false and directory.endsWith("\\std") == false) { return "".clone() }
    let root = directoryOf(directory)
    if (fileExists(joinPath(joinPath(root, "runtime"), "lang_runtime.c")) == false) { return "".clone() }
    let leaf = path.substring(directory.length + 1, path.length - directory.length - 1)
    if (leaf.endsWith(".psm") == false) { return "".clone() }
    return "std.".concat(leaf.substring(0, leaf.length - 4))
}

// The manifests this server has read, and what each declares. A manifest is read by the manifest
// language's own loader, in this process, which keeps what it lexes (the ownership analysis cannot
// release a Vec of structs that hold strings), so it is read once per change of the file, not once
// per request: a row is added when a manifest's size or time of change differs from the row's.
public struct ProgramCache {
    // The workspace folder: where the search for a program that imports a file stops when no manifest does.
    public root: String,
    manifests: Vec<String>,
    stamps: Vec<String>,
    // The sources the manifest's targets start at, one per line.
    entries: Vec<String>
}

public fn programCache() -> ProgramCache {
    return ProgramCache { root: "".clone(), manifests: [], stamps: [], entries: [] }
}

// The nearest `build.ums` at or above `directory`, or "".
fn projectFindManifest(directory: String) -> String {
    let mut current = directory.clone()
    loop {
        let candidate = joinPath(current, "build.ums")
        if (fileExists(candidate)) { return candidate }
        let parent = directoryOf(current)
        if (parent.equals(current) or parent.equals("")) { return "".clone() }
        current = parent
    }
}

fn projectStamp(path: String) -> String {
    let found = metadata(path)
    if (found == none) { return "".clone() }
    let m = expect(found)
    return m.size.toString().concat(":", m.modified.asMillis.toString())
}

// `parse.stmt` for `<dir>/parse/stmt.psm`: the name `file` is imported by from `dir`.
fn projectModuleName(dir: String, file: String) -> String {
    let mut leaf = file.slice(dir.length + 1, file.length).replaceAll("\\", "/")
    if (leaf.endsWith(".psm")) { leaf = leaf.slice(0, leaf.length - 4).clone() }
    return leaf.replaceAll("/", ".")
}

// Whether `text` imports `module`: by name (`import parse.stmt`, with a selection or an alias after it), with its
// package (`import parse.*`, `import * from parse`) or in a group (`import {stmt, expr} from parse`).
fn projectImports(text: String, module: String) -> Bool {
    let dot = module.lastIndexOf(".")
    for raw in text.split("\n") {
        let line = raw.trim()
        if (line.startsWith("import") == false) { continue }
        let rest = line.slice(6, line.length).trim()
        if (rest.equals(module) or rest.startsWith(module.concat(" ")) or rest.startsWith(module.concat("."))) { return true }
        if (dot < 0) { continue }
        let pkg = module.slice(0, dot).clone()
        let leaf = module.slice(dot + 1, module.length).clone()
        if (rest.startsWith(pkg.concat(".*"))) { return true }
        if (rest.startsWith("*")) {
            let after = rest.slice(1, rest.length).trim()
            if (after.startsWith("from ")) {
                let named = after.slice(5, after.length).trim()
                if (named.equals(pkg) or named.startsWith(pkg.concat(" "))) { return true }
            }
        }
        if (rest.startsWith("{")) {
            let close = rest.indexOf("}")
            if (close < 0) { continue }
            let tail = rest.slice(close + 1, rest.length).trim()
            if (tail.startsWith("from ") == false) { continue }
            let named = tail.slice(5, tail.length).trim()
            if (named.equals(pkg) == false and named.startsWith(pkg.concat(" ")) == false) { continue }
            for item in rest.slice(1, close).split(",") {
                let words = item.trim().split(" ")
                if (words.length > 0 and words[0].equals(leaf)) { return true }
            }
        }
    }
    return false
}

impl ProgramCache {
    // The nearest program, at or above the file's directory, that imports the file by the name it has from there:
    // the search ends at the manifest's directory, or at the workspace folder when there is no manifest, so a file
    // outside any project is looked for in its own directory only, not through every folder up to the root.
    // "" when none does. The first by name, so the answer does not depend on the order a directory lists in.
    fn importerOf(self, path: String) -> String {
        let manifest = projectFindManifest(directoryOf(path))
        let mut manifestDirectory = "".clone()
        if (manifest.equals("") == false) { manifestDirectory = directoryOf(manifest) }
        let mut directory = directoryOf(path)
        loop {
            let module = projectModuleName(directory, path)
            let mut best = "".clone()
            for name in listDirectory(directory) {
                if (name.endsWith(".psm") == false) { continue }
                let candidate = joinPath(directory, name)
                if (candidate.equals(path)) { continue }
                if (best.equals("") == false and candidate.compare(best) > 0) { continue }
                let candidateText = readFile(candidate)
                if (candidateText.contains("fn main(") and projectImports(candidateText, module)) { best = candidate.clone() }
            }
            if (best.equals("") == false) { return best }
            if (directory.equals(manifestDirectory)) { return "".clone() }
            if (manifestDirectory.equals("")) {
                if (self.root.equals("") or projectIsUnder(path, self.root) == false or directory.equals(self.root)) { return "".clone() }
            }
            let parent = directoryOf(directory)
            if (parent.equals(directory) or parent.equals("")) { return "".clone() }
            directory = parent
        }
    }

    // The entries `manifest` declares, as it is now.
    fn entriesOf(self, manifest: String) -> String {
        let stamp = projectStamp(manifest)
        let mut at = self.manifests.length - 1
        while (at >= 0) {
            if (self.manifests[at].equals(manifest) and self.stamps[at].equals(stamp)) { return self.entries[at].clone() }
            at = at - 1
        }
        let workspace = umsLoadText(readFile(manifest), manifest, directoryOf(manifest), "debug")
        let mut declared = "".clone()
        for target in workspace.project.targets {
            if (target.sourcePath.equals("")) { continue }
            declared = declared.concat(pathCanonical(target.sourcePath), "\n")
        }
        self.manifests.push(manifest.clone())
        self.stamps.push(stamp.clone())
        self.entries.push(declared.clone())
        return declared
    }

    // The entries of the manifest above `path`, the nearest target whose directory holds the file first and the
    // others in the order the manifest declares them, as `entry<TAB>` lines: a program that never reads the file
    // says so (P1075), and the next is tried.
    fn manifestCandidates(self, path: String) -> Vec<String> {
        let mut found: Vec<String> = []
        let manifest = projectFindManifest(directoryOf(path))
        if (manifest.equals("")) { return found }
        let mut best = "".clone()
        let mut bestDirectory = "".clone()
        let declared = self.entriesOf(manifest)
        for entry in declared.split("\n") {
            if (entry.equals("")) { continue }
            if (entry.equals(path)) {
                best = entry.clone()
                break
            }
            let directory = directoryOf(entry)
            if (projectIsUnder(path, directory) and directory.length > bestDirectory.length) {
                best = entry.clone()
                bestDirectory = directory.clone()
            }
        }
        if (best.equals("") == false) { found.push(best.concat("\t")) }
        for entry in declared.split("\n") {
            if (entry.equals("") or entry.equals(best)) { continue }
            found.push(entry.concat("\t"))
        }
        return found
    }

    // The programs to try for `path`, most likely first, as `entry<TAB>module` lines: the file itself if it declares
    // `main`; a standard-library module alone under its name; the manifest's targets; a program that imports it; and the
    // file alone, which is the last resort. The slow searches are made only when the faster ones have been tried.
    fn candidates(self, path: String, text: String, attempt: Int) -> Vec<String> {
        let mut found: Vec<String> = []
        if (text.contains("fn main(")) {
            found.push(path.concat("\t"))
            return found
        }
        let module = projectStandardModuleName(path)
        if (module.equals("") == false) {
            found.push(path.concat("\t", module))
            return found
        }
        for entry in self.manifestCandidates(path) { found.push(entry.clone()) }
        if (attempt >= found.length) {
            let importer = self.importerOf(path)
            if (importer.equals("") == false) { found.push(importer.concat("\t")) }
        }
        found.push(path.concat("\t"))
        return found
    }

    // The program to check `path` through on its `attempt`th try (0 is the most likely).
    public fn programFor(self, path: String, text: String, attempt: Int) -> Program {
        let list = self.candidates(path, text, attempt)
        let mut at = attempt
        if (at >= list.length) { at = list.length - 1 }
        let parts = list[at].split("\t")
        return Program { entry: parts[0].clone(), module: parts[1].clone() }
    }

    // How many programs there are to try for `path`: a document whose program does not read it moves on to
    // the next until this many have been tried.
    public fn programCount(self, path: String, text: String) -> Int {
        return self.candidates(path, text, 1000000).length
    }
}
