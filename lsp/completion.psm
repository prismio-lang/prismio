// Completion: what could be written where the cursor is.
//
// The buffer at the cursor seldom parses, and a name the user is half way through typing is not yet a
// name. So the word under the cursor is replaced by a placeholder identifier and the compiler is asked
// to analyse that buffer and to say what it could have been (`check --complete`, src/index/complete.psm):
// the members of the type before a `.`, the names in scope, the contents of a module. The server adds
// the keywords of the language (from `dump-tokens`, never a list of its own) and the protocol's shape.

import analysis
import documents
import index
import positions
import projects
import runner
import std.fs
import std.json
import std.string
import std.vec

// Must be the same word as `ixPlaceholder` in src/index/complete.psm.
let COMPLETION_PLACEHOLDER = "ixcursor__"

fn completionIsWordByte(b: Int) -> Bool {
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or (b >= 48 and b <= 57) or b >= 128
}

fn completionItemKind(kind: String) -> Int {
    if (kind.equals("fn") or kind.equals("extern")) { return 3 }
    if (kind.equals("method")) { return 2 }
    if (kind.equals("prop")) { return 10 }
    if (kind.equals("field")) { return 5 }
    if (kind.equals("let") or kind.equals("param") or kind.equals("global") or kind.equals("externvar")) { return 6 }
    if (kind.equals("const") or kind.equals("assocconst")) { return 21 }
    if (kind.equals("struct") or kind.equals("typelist")) { return 22 }
    if (kind.equals("enum") or kind.equals("codeset")) { return 13 }
    if (kind.equals("variant") or kind.equals("code")) { return 20 }
    if (kind.equals("trait")) { return 8 }
    if (kind.equals("import")) { return 9 }
    if (kind.equals("typeparam") or kind.equals("assoctype")) { return 25 }
    if (kind.equals("keyword")) { return 14 }
    return 1
}

// The empty result, which a client reads as "nothing to offer".
// The modules the document imports, as written after `import` (`std.string`): the lines that begin with the word.
fn completionImports(text: String) -> Vec<String> {
    let mut found: Vec<String> = []
    let mut at = 0
    while (at < text.length) {
        let mut end = at
        while (end < text.length and text.byteAt(end) != 10) { end = end + 1 }
        if (end - at > 7 and text.slice(at, at + 7).equals("import ")) {
            let mut from = at + 7
            while (from < end and text.byteAt(from) == 32) { from = from + 1 }
            let mut stop = from
            while (stop < end and (completionIsWordByte(text.byteAt(stop)) or text.byteAt(stop) == 46)) { stop = stop + 1 }
            if (stop > from) { found.push(text.slice(from, stop).clone()) }
        }
        at = end + 1
    }
    return found
}

// The 0-based line a new `import` goes on: among the document's imports in sorted order (before the first that sorts
// after it, else after the last), or the first line when it has none.
fn completionImportLine(text: String, module: String) -> Int {
    let mut line = 0
    let mut lastImport = 0 - 1
    let mut before = 0 - 1
    let mut at = 0
    while (at < text.length) {
        let mut end = at
        while (end < text.length and text.byteAt(end) != 10) { end = end + 1 }
        if (end - at > 7 and text.slice(at, at + 7).equals("import ")) {
            lastImport = line
            let mut from = at + 7
            while (from < end and text.byteAt(from) == 32) { from = from + 1 }
            let mut stop = from
            while (stop < end and (completionIsWordByte(text.byteAt(stop)) or text.byteAt(stop) == 46)) { stop = stop + 1 }
            if (before < 0 and stop > from and text.slice(from, stop).compare(module) > 0) { before = line }
        }
        line = line + 1
        at = end + 1
    }
    if (before >= 0) { return before }
    if (lastImport >= 0) { return lastImport + 1 }
    return 0
}

// The library's modules, `std.<name>` for each `<name>.plib` beside the compiler (bin/, lib/ and stdlib/ are one
// layout), so that a completion can see every library name and say which import each one needs.
fn completionLibraryModules(compiler: String) -> Vec<String> {
    let mut modules: Vec<String> = []
    let mut real = compiler.clone()
    let resolved = realPath(compiler)
    if (resolved != none) { real = expect(resolved).clone() }
    let stdlib = joinPath(directoryOf(directoryOf(real)), "stdlib")
    if (directoryExists(stdlib) == false) { return modules }
    for name in listDirectory(stdlib) {
        if (name.endsWith(".plib")) { modules.push("std.".concat(name.slice(0, name.length - 5))) }
    }
    return modules
}

// Whether the caret is inside a string literal or a `//` comment of its line.
fn completionInTextOrComment(text: String, offset: Int) -> Bool {
    let mut from = offset
    while (from > 0 and text.byteAt(from - 1) != 10) { from = from - 1 }
    let mut inString = false
    let mut i = from
    while (i < offset) {
        let b = text.byteAt(i)
        if (inString) {
            if (b == 92) {
                i = i + 2
                continue
            }
            if (b == 34) { inString = false }
        } else {
            if (b == 34) { inString = true }
            if (b == 47 and i + 1 < offset and text.byteAt(i + 1) == 47) { return true }
        }
        i = i + 1
    }
    return inString
}

// `text` with the 1-based `line` emptied (its break kept, so the others stay where they are).
fn completionBlankLine(text: String, line: Int) -> String {
    let mut at = 0
    let mut current = 1
    while (current < line and at < text.length) {
        if (text.byteAt(at) == 10) { current = current + 1 }
        at = at + 1
    }
    let mut end = at
    while (end < text.length and text.byteAt(end) != 10) { end = end + 1 }
    return text.slice(0, at).concat(text.slice(end, text.length))
}

// The word before the one being typed, or "".
fn completionPreviousWord(text: String, start: Int) -> String {
    let mut stop = start
    while (stop > 0 and (text.byteAt(stop - 1) == 32 or text.byteAt(stop - 1) == 9)) { stop = stop - 1 }
    let mut first = stop
    while (first > 0 and completionIsWordByte(text.byteAt(first - 1))) { first = first - 1 }
    return text.slice(first, stop).clone()
}

// Whether the word being typed is the name of something being declared (`let |`, `fn |`, `struct |`): nothing to suggest.
fn completionDeclaresName(text: String, start: Int) -> Bool {
    let previous = completionPreviousWord(text, start)
    if (previous.equals("let") or previous.equals("fn") or previous.equals("struct") or previous.equals("enum")
            or previous.equals("trait") or previous.equals("typelist") or previous.equals("codeset") or previous.equals("var")) {
        return true
    }
    if (previous.equals("mut")) {
        let mut stop = start
        while (stop > 0 and (text.byteAt(stop - 1) == 32 or text.byteAt(stop - 1) == 9)) { stop = stop - 1 }
        let mut first = stop - 3
        if (first >= 0) {
            return completionPreviousWord(text, first).equals("let")
        }
    }
    return false
}

// The language's keywords alone: what an editor still wants where the buffer does not parse well enough to analyse
// (the top level of a file, an `import` line).
fn completionKeywordsOnly(keywords: Vec<String>) -> String {
    let out = JsonWriter()
    out.beginObject()
    out.key("isIncomplete")
    out.bool(false)
    out.key("items")
    out.beginArray()
    for word in keywords {
        out.beginObject()
        out.key("label")
        out.string(word)
        out.key("kind")
        out.int(14)
        out.key("sortText")
        out.string("9".concat(word))
        out.endObject()
    }
    out.endArray()
    out.endObject()
    return out.finish()
}

// A completion list of plain names, `kind` as the protocol numbers it (9 module, 14 keyword).
fn completionNames(labels: Vec<String>, kind: Int) -> String {
    let out = JsonWriter()
    out.beginObject()
    out.key("isIncomplete")
    out.bool(false)
    out.key("items")
    out.beginArray()
    for label in labels {
        out.beginObject()
        out.key("label")
        out.string(label)
        out.key("kind")
        out.int(kind)
        out.endObject()
    }
    out.endArray()
    out.endObject()
    return out.finish()
}

// The modules a directory holds, for `from dir import {...}`: the library's for `std`, else the `.psm` files beside
// the document (or in `dir` under it), without the extension. With `directories`, its subdirectories as well.
fn completionDirectoryModules(compiler: String, docPath: String, directory: String, directories: Bool) -> Vec<String> {
    let mut found: Vec<String> = []
    if (directory.equals("std")) {
        for module in completionLibraryModules(compiler) { found.push(module.slice(4, module.length).clone()) }
        return found
    }
    let mut root = directoryOf(docPath).clone()
    if (directory.equals("") == false) { root = joinPath(root, directory) }
    if (directoryExists(root) == false) { return found }
    for name in listDirectory(root) {
        if (name.endsWith(".psm")) {
            let module = name.slice(0, name.length - 4).clone()
            if (joinPath(root, name).equals(docPath) == false) { found.push(module) }
        } else if (directories and directoryExists(joinPath(root, name)) and name.startsWith(".") == false) {
            found.push(name.clone())
        }
    }
    return found
}

// The word at `from` in `text`, up to a space, `{`, `}` or the end.
fn completionWordAt(text: String, from: Int) -> String {
    let mut i = from
    while (i < text.length and text.byteAt(i) == 32) { i = i + 1 }
    let mut stop = i
    while (stop < text.length and text.byteAt(stop) != 32 and text.byteAt(stop) != 123 and text.byteAt(stop) != 125 and text.byteAt(stop) != 10) {
        stop = stop + 1
    }
    return text.slice(i, stop).clone()
}

// The library module an `import std.string.<caret>` line asks the members of, or "".
fn completionImportedModule(text: String, offset: Int) -> String {
    let mut lineStart = offset
    while (lineStart > 0 and text.byteAt(lineStart - 1) != 10) { lineStart = lineStart - 1 }
    let before = text.slice(lineStart, offset)
    if (before.startsWith("import ") == false or before.contains("{") or before.contains("*")) { return "".clone() }
    let mut from = 7
    while (from < before.length and before.byteAt(from) == 32) { from = from + 1 }
    let mut stop = from
    while (stop < before.length and (completionIsWordByte(before.byteAt(stop)) or before.byteAt(stop) == 46)) { stop = stop + 1 }
    let path = before.slice(from, stop).clone()
    let dot = path.lastIndexOf(".")
    if (dot <= 0) { return "".clone() }
    let parent = path.slice(0, dot).clone()
    if (parent.startsWith("std.") and parent.length > 4) { return parent }
    return "".clone()
}

// What belongs at the caret of an `import` or `from` line, or "" when the caret is not on one: the module paths, the
// modules of a directory inside a group, `from` after a group that is closed, the directories after `from`.
fn completionImportItems(compiler: String, docPath: String, text: String, offset: Int) -> String {
    let mut lineStart = offset
    while (lineStart > 0 and text.byteAt(lineStart - 1) != 10) { lineStart = lineStart - 1 }
    let mut lineEnd = offset
    while (lineEnd < text.length and text.byteAt(lineEnd) != 10) { lineEnd = lineEnd + 1 }
    let before = text.slice(lineStart, offset)
    let after = text.slice(offset, lineEnd)
    let mut names: Vec<String> = []
    if (before.startsWith("from ")) {
        if (before.contains(" import")) {
            let directory = completionWordAt(before, 5)
            return completionNames(completionDirectoryModules(compiler, docPath, directory, false), 9)
        }
        names.push("std".clone())
        for entry in completionDirectoryModules(compiler, docPath, "", true) {
            if (directoryExists(joinPath(directoryOf(docPath), entry))) { names.push(entry.clone()) }
        }
        return completionNames(names, 9)
    }
    if (before.startsWith("import ") == false) { return "".clone() }
    let rest = before.slice(7, before.length)
    if (rest.contains("{")) {
        if (rest.contains("}")) {
            if (rest.contains(" from") or rest.endsWith("}") == false and rest.contains("}") and rest.contains("from ")) { return completionNone() }
            names.push("from".clone())
            return completionNames(names, 14)
        }
        // Inside the group: the directory is written after the closing brace, or it is the library.
        let mut directory = "std".clone()
        let closing = after.indexOf("}")
        if (closing >= 0) {
            let tail = after.slice(closing + 1, after.length)
            let from = tail.indexOf("from ")
            if (from >= 0) { directory = completionWordAt(tail, from + 5) }
        }
        return completionNames(completionDirectoryModules(compiler, docPath, directory, false), 9)
    }
    if (rest.startsWith("*")) {
        if (rest.contains("from")) { return completionNone() }
        names.push("from".clone())
        return completionNames(names, 14)
    }
    // A dotted path: `std.` lists the library's modules, a bare caret every module path.
    let mut path = rest.clone()
    let mut cut = path.length
    while (cut > 0 and (completionIsWordByte(path.byteAt(cut - 1)) or path.byteAt(cut - 1) == 46)) { cut = cut - 1 }
    path = path.slice(cut, path.length).clone()
    let lastDot = path.lastIndexOf(".")
    if (lastDot < 0) {
        names.push("std".clone())
        for module in completionLibraryModules(compiler) { names.push(module.clone()) }
        for entry in completionDirectoryModules(compiler, docPath, "", true) { names.push(entry.clone()) }
        return completionNames(names, 9)
    }
    let parent = path.slice(0, lastDot).clone()
    if (parent.equals("std")) { return completionNames(completionDirectoryModules(compiler, docPath, "std", false), 9) }
    if (parent.startsWith("std.")) { return completionNone() }
    return completionNames(completionDirectoryModules(compiler, docPath, parent.replaceAll(".", "/"), true), 9)
}

fn completionNone() -> String {
    return "{\"isIncomplete\":false,\"items\":[]}".clone()
}

// Modules that are the library's way into the machine (`import std.raw` is the marker that a file means to). Their names are
// offered, with the import they need, only to a document that already imports them: otherwise `s.` on a String lists
// `asmOps` and `offsetOf` because they happen to take a String first.
fn completionIsLowLevelModule(module: String) -> Bool {
    return module.equals("std.raw") or module.equals("std.asm") or module.equals("std.port") or module.equals("std.syscall")
}

// ---------------------------------------------------------------------------------------------------------------------
// Struct literals: `Point { x: 1, | }` asks for the fields the literal has not set.
// ---------------------------------------------------------------------------------------------------------------------

fn completionIsSpace(b: Int) -> Bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

// The type whose literal the caret is inside, at the place a field's name goes, or "". `start` is where the word being
// typed begins. The caret must be right after the literal's `{` or a `,` of it (with the nearest open bracket that `{`), and
// the word in front of that brace a type's name: not a keyword (`if x {`, `struct P {`, `impl P {`, `-> Int {`).
fn completionStructLiteralType(text: String, start: Int) -> String {
    let mut at = start
    while (at > 0 and completionIsSpace(text.byteAt(at - 1))) { at = at - 1 }
    if (at == 0) { return "".clone() }
    let last = text.byteAt(at - 1)
    if (last != 123 and last != 44) { return "".clone() }
    // The nearest bracket that is still open.
    let mut open = at - 1
    if (last == 44) {
        let mut depth = 0
        open = at - 2
        while (open >= 0) {
            let b = text.byteAt(open)
            if (b == 41 or b == 93 or b == 125) { depth = depth + 1 }
            if (b == 40 or b == 91 or b == 123) {
                if (depth == 0) { break }
                depth = depth - 1
            }
            open = open - 1
        }
        if (open < 0 or text.byteAt(open) != 123) { return "".clone() }
    }
    // The word in front of the brace, past a `<...>`.
    let mut stop = open
    while (stop > 0 and completionIsSpace(text.byteAt(stop - 1))) { stop = stop - 1 }
    if (stop > 0 and text.byteAt(stop - 1) == 62 and (stop < 2 or text.byteAt(stop - 2) != 45)) {
        let mut depth = 0
        while (stop > 0) {
            let b = text.byteAt(stop - 1)
            if (b == 62) { depth = depth + 1 }
            if (b == 60) { depth = depth - 1 }
            stop = stop - 1
            if (depth == 0) { break }
        }
        while (stop > 0 and completionIsSpace(text.byteAt(stop - 1))) { stop = stop - 1 }
    }
    let mut first = stop
    while (first > 0 and completionIsWordByte(text.byteAt(first - 1))) { first = first - 1 }
    if (first == stop) { return "".clone() }
    let name = text.slice(first, stop).clone()
    let initial = name.byteAt(0)
    if (initial < 65 or initial > 90) { return "".clone() }
    // A declaration's or a function's brace is not a literal's.
    let before = completionPreviousWord(text, first)
    if (before.equals("struct") or before.equals("enum") or before.equals("impl") or before.equals("trait")
            or before.equals("for") or before.equals("where") or before.equals("is") or before.equals("typelist")
            or before.equals("codeset")) {
        return "".clone()
    }
    let mut back = first
    while (back > 0 and completionIsSpace(text.byteAt(back - 1))) { back = back - 1 }
    if (back > 0) {
        let b = text.byteAt(back - 1)
        // `-> Int {`, `x: Int {`, `T.Variant {` and `a & B {` are not a literal of `B`.
        if (b == 62 or b == 58 or b == 46) { return "".clone() }
    }
    return name
}

// ---------------------------------------------------------------------------------------------------------------------
// Call snippets: choosing `push` inserts `push(value)` with `value` selected.
// ---------------------------------------------------------------------------------------------------------------------

fn completionParameterName(parameter: String) -> String {
    let colon = parameter.indexOf(":")
    let mut head = parameter.trim().clone()
    if (colon >= 0) { head = parameter.slice(0, colon).trim().clone() }
    let space = head.lastIndexOf(" ")
    if (space >= 0) { head = head.slice(space + 1, head.length).clone() }
    while (head.startsWith(".")) { head = head.slice(1, head.length).clone() }
    return head
}

// The parameter names a declaration's signature writes (`fn push(self, value: T)` -> `self`, `value`), or none when `label`
// is not found in it as a function. Generics, nested brackets and the `->` of a function type are stepped over.
fn completionParameterNames(detail: String, label: String) -> Vec<String> {
    let mut names: Vec<String> = []
    let needle = "fn ".concat(label)
    let at = detail.indexOf(needle)
    if (at < 0) { return names }
    let mut i = at + needle.length
    if (i < detail.length and detail.byteAt(i) == 60) {
        let mut depth = 0
        while (i < detail.length) {
            let b = detail.byteAt(i)
            if (b == 60) { depth = depth + 1 }
            if (b == 62 and detail.byteAt(i - 1) != 45) { depth = depth - 1 }
            i = i + 1
            if (depth == 0) { break }
        }
    }
    if (i >= detail.length or detail.byteAt(i) != 40) { return names }
    i = i + 1
    let mut depth = 0
    let mut from = i
    while (i < detail.length) {
        let b = detail.byteAt(i)
        if (b == 40 or b == 91 or b == 123 or b == 60) { depth = depth + 1 }
        if (b == 41 or b == 93 or b == 125 or (b == 62 and detail.byteAt(i - 1) != 45)) {
            if (depth == 0) {
                if (i > from) { names.push(completionParameterName(detail.slice(from, i))) }
                return names
            }
            depth = depth - 1
        }
        if (b == 44 and depth == 0) {
            names.push(completionParameterName(detail.slice(from, i)))
            from = i + 1
        }
        i = i + 1
    }
    return names
}

// `name(${1:a}, ${2:b})` for a function or a method, or "" when choosing it should insert the bare name. After a value a
// method is called without its receiver (`self`, or the first parameter of a free function offered as a method).
fn completionCallSnippet(label: String, kind: String, detail: String) -> String {
    if (kind.equals("fn") == false and kind.equals("method") == false and kind.equals("extern") == false) { return "".clone() }
    let names = completionParameterNames(detail, label)
    if (detail.contains("fn ".concat(label)) == false) { return "".clone() }
    let mut out = label.concat("(")
    let mut number = 0
    let mut index = 0
    for name in names {
        let receiver = index == 0 and kind.equals("method")
        index = index + 1
        if (receiver or name.equals("self") or name.equals("")) { continue }
        number = number + 1
        if (number > 1) { out = out.concat(", ") }
        // `$` and `{` are two strings: together they would open an interpolation.
        out = out.concat("$", "{", number.toString(), ":", name, "}")
    }
    return out.concat(")")
}

// ---------------------------------------------------------------------------------------------------------------------
// Documentation: what the popup shows is the first paragraph, without the banners a source file draws around a section.
// ---------------------------------------------------------------------------------------------------------------------

fn completionIsBanner(line: String) -> Bool {
    let t = line.trim()
    if (t.length < 4) { return false }
    for i in 0..<t.length {
        let b = t.byteAt(i)
        if (b != 45 and b != 61 and b != 95 and b != 42 and b != 35 and b != 126) { return false }
    }
    return true
}

fn completionTrimDoc(doc: String) -> String {
    if (doc.equals("")) { return "".clone() }
    let lines = doc.split("\n")
    let mut at = 0
    while (at < lines.length and lines[at].trim().equals("")) { at = at + 1 }
    // `-----` / a title / `-----` is a heading for what follows it, not the documentation of the declaration.
    if (at < lines.length and completionIsBanner(lines[at])) {
        let mut close = at + 1
        while (close < lines.length and completionIsBanner(lines[close]) == false) { close = close + 1 }
        if (close < lines.length) { at = close + 1 } else { at = at + 1 }
        while (at < lines.length and (lines[at].trim().equals("") or completionIsBanner(lines[at]))) { at = at + 1 }
    }
    let mut out = "".clone()
    let mut fenced = false
    while (at < lines.length) {
        let line = lines[at]
        if (line.trim().startsWith("```")) { fenced = fenced == false }
        if (fenced == false and line.trim().equals("")) { break }
        if (out.equals("") == false) { out = out.concat("\n") }
        out = out.concat(line)
        at = at + 1
    }
    if (fenced) { out = out.concat("\n```") }
    if (out.length > 600) {
        let mut cut = 600
        while (cut > 400 and out.byteAt(cut) != 32 and out.byteAt(cut) != 10) { cut = cut - 1 }
        out = out.slice(0, cut).concat("...")
    }
    return out
}

public fn completionItems(compiler: String, program: Program, docs: Documents, docPath: String, documentText: String,
                          documentOffset: Int, scratch: String, keywords: Vec<String>) -> String {
    // `import std.string.|` asks for what the module declares: the compiler is asked through a program that imports it
    // and names it (`string.|`), the question it already answers.
    let mut text = documentText.clone()
    let mut offset = documentOffset
    let asked = completionImportedModule(documentText, documentOffset)
    if (asked.equals("") == false) {
        let name = asked.slice(asked.lastIndexOf(".") + 1, asked.length)
        text = "import ".concat(asked, "\n\nfn main() -> Int {\n    ", name, ".")
        offset = text.length
        text = text.concat("\n    return 0\n}\n")
    }
    // The word being typed: back from the cursor to its start, forward to its end.
    let mut start = offset
    while (start > 0 and completionIsWordByte(text.byteAt(start - 1))) { start = start - 1 }
    let mut end = offset
    while (end < text.length and completionIsWordByte(text.byteAt(end))) { end = end + 1 }
    let mut before = start
    while (before > 0 and (text.byteAt(before - 1) == 32 or text.byteAt(before - 1) == 9)) { before = before - 1 }
    let afterDot = before > 0 and text.byteAt(before - 1) == 46
    if (completionInTextOrComment(text, offset) or completionDeclaresName(text, start)) { return completionNone() }
    let importItems = completionImportItems(compiler, docPath, text, offset)
    if (importItems.equals("") == false) { return importItems }

    // The placeholder's place, in the compiler's terms.
    let index = lineIndex(text)
    let mut line0 = 0
    while (line0 + 1 < index.lineCount() and index.lineStart(line0 + 1) <= start) { line0 = line0 + 1 }
    let col = start - index.lineStart(line0) + 1

    let output = joinPath(scratch, "complete.idx")
    // `slice`, not `substring`: a `substring` of the document made the whole program decide the document was
    // never released (a copy of it per request); `slice` is the same cut by a different route.
    // Every library module the document does not import is imported in the scratch copy, so that every library name
    // is visible to the compiler; the ones the document lacks are offered with the import they need.
    let imports = completionImports(text)
    let mut header = "".clone()
    let mut added = 0
    if (program.module.equals("")) {
        for module in completionLibraryModules(compiler) {
            let mut known = false
            for earlier in imports {
                if (earlier.equals(module)) { known = true }
            }
            if (known == false and completionIsLowLevelModule(module) == false) {
                header = header.concat("import ", module, "\n")
                added = added + 1
            }
        }
    }
    let mut placeholder = COMPLETION_PLACEHOLDER.clone()
    // A generic type before the dot (`Result<Int, String>.`) only parses as the callee of a call.
    if (afterDot and before > 1 and text.byteAt(before - 2) == 62) { placeholder = COMPLETION_PLACEHOLDER.concat("()") }
    // In a struct literal's field-name position the placeholder is a field being set, which is the only shape that parses.
    let literalType = completionStructLiteralType(text, start)
    let mut atFieldName = false
    if (afterDot == false and literalType.equals("") == false) {
        let mut next = end
        while (next < text.length and (text.byteAt(next) == 32 or text.byteAt(next) == 9)) { next = next + 1 }
        if (next >= text.length or text.byteAt(next) != 58) { placeholder = placeholder.concat(": 0") }
        atFieldName = true
    }
    let mut body = text.slice(0, start).concat(placeholder, text.slice(end, text.length))

    let mut tries = 0
    let mut ran = false
    loop {
        // A scratch copy of its own for each attempt: an attempt is a new file to the compiler.
        let buffer = joinPath(scratch, "complete-buffer-".concat(tries.toString(), ".psm"))
        writeFile(buffer, header)
        appendFile(buffer, body)
        deleteFile(output)
        let mut arguments: Vec<String> = []
        arguments.push("check")
        arguments.push(program.entry.clone())
        arguments.push("--partial")
        if (program.module.equals("") == false) {
            arguments.push("--module")
            arguments.push(program.module.clone())
        }
        for i in 0..<docs.count() {
            if (docs.files[i].equals("") or docs.paths[i].endsWith(".ums")) { continue }
            arguments.push("--overlay")
            arguments.push(docs.paths[i].clone())
            if (docs.paths[i].equals(docPath)) { arguments.push(buffer.clone()) } else { arguments.push(docs.files[i].clone()) }
        }
        arguments.push("--emit-index")
        arguments.push(output.clone())
        arguments.push("--complete")
        arguments.push(docPath.clone())
        arguments.push((line0 + 1 + added).toString())
        arguments.push(col.toString())
        arguments.push("--diagnostic-format=json")
        // A check that finds errors exits non-zero, which is the normal case here: only the index counts. The compiler
        // drops the statement that does not parse and keeps the function; only when the file ends inside one (nothing to
        // resume at) is the whole function lost, so when it did not reach the caret and says which other lines are the
        // trouble, those lines are emptied in the scratch copy and it is asked again.
        let run = runCapturedErrors(compiler, arguments, 8000)
        deleteFile(buffer)
        ran = run.ok
        if (run.ok == false or tries >= 3) { break }
        if (fileExists(output) and indexCompletionContext(output).equals("") == false) { break }
        let mut blanked = false
        for report in run.output.split("\n") {
            if (report.startsWith("{") == false) { continue }
            let diagnostic = parseJson(report)
            if (diagnostic.ok == false) { continue }
            let code = diagnostic.text(diagnostic.member(diagnostic.root, "code").unwrapOr(0 - 1))
            let reported = diagnostic.int(diagnostic.member(diagnostic.root, "line").unwrapOr(0 - 1)) - added
            if (code.startsWith("P32") and reported >= 1 and reported != line0 + 1) {
                body = completionBlankLine(body, reported)
                blanked = true
            }
        }
        if (blanked == false) { break }
        tries = tries + 1
    }
    if (ran == false or fileExists(output) == false) {
        if (afterDot) { return completionNone() }
        return completionKeywordsOnly(keywords)
    }

    // Keywords belong to a scope; after a dot, in a type or after a module's name they are not what is being written.
    let context = indexCompletionContext(output)
    let offerKeywords = afterDot == false and (context.equals("") or context.equals("scope"))
    let out = JsonWriter()
    out.beginObject()
    out.key("isIncomplete")
    out.bool(false)
    out.key("items")
    out.beginArray()
    let mut offered: Vec<String> = []
    let found = indexCompletions(output)
    // Overloads of one name are one entry: the first is shown, and the others are listed in its documentation.
    let mut leader: Vec<Int> = []
    for i in 0..<found.length {
        let mut lead = i
        for j in 0..<i {
            if (leader[j] == j and found[j].label.equals(found[i].label) and found[j].kind.equals(found[i].kind)) {
                lead = j
                break
            }
        }
        leader.push(lead)
    }
    // A call's parentheses are not inserted in front of ones that are already there.
    let mut parenthesised = false
    if (end < text.length and text.byteAt(end) == 40) { parenthesised = true }
    for i in 0..<found.length {
        if (leader[i] != i) { continue }
        // The overload shown is the one with the fewest parameters: `concat(other)` before `concat(a, b, c, d, e, f, ...more)`.
        let mut chosen = i
        let mut fewest = completionParameterNames(found[i].detail, found[i].label).length
        for j in (i + 1)..<found.length {
            if (leader[j] == i) {
                let count = completionParameterNames(found[j].detail, found[j].label).length
                if (count < fewest) {
                    fewest = count
                    chosen = j
                }
            }
        }
        let item = found[chosen]
        let mut overloads: Vec<String> = []
        for j in i..<found.length {
            if (leader[j] == i and j != chosen and found[j].detail.equals("") == false) { overloads.push(found[j].detail.clone()) }
        }
        offered.push(item.label.clone())
        out.beginObject()
        out.key("label")
        out.string(item.label)
        out.key("kind")
        out.int(completionItemKind(item.kind))
        if (item.detail.equals("") == false) {
            out.key("detail")
            out.string(item.detail)
        }
        // An overload with no documentation of its own borrows the first that has some.
        let mut written = item.doc.clone()
        if (written.equals("")) {
            for j in i..<found.length {
                if (leader[j] == i and found[j].doc.equals("") == false and written.equals("")) { written = found[j].doc.clone() }
            }
        }
        let mut doc = completionTrimDoc(written)
        if (overloads.length > 0) {
            if (doc.equals("") == false) { doc = doc.concat("\n\n") }
            doc = doc.concat("**Also:**\n```\n")
            for other in overloads { doc = doc.concat(other, "\n") }
            doc = doc.concat("```")
        }
        if (doc.equals("") == false) {
            out.key("documentation")
            out.beginObject()
            out.key("kind")
            out.string("markdown")
            out.key("value")
            out.string(doc)
            out.endObject()
        }
        // What is inserted: a call with its parameters to fill in, a field with its colon, else the name alone.
        if (parenthesised == false) {
            let snippet = completionCallSnippet(item.label, item.kind, item.detail)
            if (snippet.equals("") == false) {
                out.key("insertText")
                out.string(snippet)
                out.key("insertTextFormat")
                out.int(2)
            }
        }
        if (atFieldName and context.equals("field")) {
            out.key("insertText")
            out.string(item.label.concat(": "))
        }
        // A name from a module the document does not import goes after the ones it can already use.
        let mut rank = item.rank
        let mut imported = true
        if (item.module.equals("") == false) {
            imported = false
            for earlier in imports {
                if (earlier.equals(item.module)) { imported = true }
            }
            if (imported == false) { rank = rank + 3 }
        }
        out.key("sortText")
        out.string(rank.toString().concat(item.label))
        if (overloads.length > 0 or item.module.equals("") == false) {
            out.key("labelDetails")
            out.beginObject()
            if (overloads.length > 0) {
                out.key("detail")
                let mut plural = "s".clone()
                if (overloads.length == 1) { plural = "".clone() }
                out.string(" (+".concat(overloads.length.toString(), " overload", plural, ")"))
            }
            if (item.module.equals("") == false) {
                out.key("description")
                out.string(item.module)
            }
            out.endObject()
        }
        if (item.module.equals("") == false and imported == false) {
            let importLine = completionImportLine(text, item.module)
            out.key("additionalTextEdits")
            out.beginArray()
            out.beginObject()
            out.key("range")
            out.raw("{\"start\":{\"line\":".concat(importLine.toString(), ",\"character\":0},\"end\":{\"line\":",
                                                   importLine.toString(), ",\"character\":0}}"))
            out.key("newText")
            out.string("import ".concat(item.module, "\n"))
            out.endObject()
            out.endArray()
        }
        out.endObject()
    }
    if (offerKeywords) {
        for word in keywords {
            let mut taken = false
            for earlier in offered {
                if (earlier.equals(word)) { taken = true }
            }
            if (taken) { continue }
            out.beginObject()
            out.key("label")
            out.string(word)
            out.key("kind")
            out.int(14)
            out.key("sortText")
            out.string("9".concat(word))
            out.endObject()
        }
    }
    out.endArray()
    out.endObject()
    deleteFile(output)
    return out.finish()
}
