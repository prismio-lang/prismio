// Messages on standard input and output: `Content-Length: N`, a blank line, then N bytes.
//
// Reading is blocking on purpose: the server loop waits (std.poll) until input is there and
// only then calls `readMessage`, so a message that has begun arriving is read to its end. A
// client that sends half a message and stalls stalls the server too, which is the protocol's
// own behaviour, not a loss.

import std.input
import std.io
import std.option
import std.string

// The body of the next message, or "" when input has ended (or ended inside a message, which
// is the same thing to a server: there is no one left to answer). "" rather than `none`: no
// message has an empty body, and a `String?` handed back and then unwrapped was one block per
// message that was never released. A message with no `Content-Length` is skipped, and the
// stream resynchronises on the next header block.
public fn readMessage() -> String {
    loop {
        let mut length = 0 - 1
        loop {
            let line = readLine()
            if (line == none) { return "".clone() }
            let header = expect(line)
            if (header.equals("")) { break }
            let announced = transportContentLength(header)
            if (announced >= 0) { length = announced }
        }
        if (length < 0) { continue }
        let body = readBytes(length)
        if (body.length < length) { return "".clone() }
        return body
    }
}

// The length `line` announces if it is the Content-Length header (compared without regard to
// case), otherwise -1. Read straight from the bytes: this runs for every message, and the
// ownership analysis shares one allocation site per library function, so a `substring` or
// `trim` here is released or leaked according to what unrelated code does with its own.
fn transportContentLength(line: String) -> Int {
    let name = "content-length"
    let colon = line.indexOf(":")
    if (colon != name.length) { return 0 - 1 }
    for i in 0..<colon {
        if (transportLowerAscii(line.byteAt(i)) != name.byteAt(i)) { return 0 - 1 }
    }
    let mut value = 0
    let mut seen = false
    for i in (colon + 1)..<line.length {
        let c = line.byteAt(i)
        if (c >= 48 and c <= 57) {
            value = value * 10 + (c - 48)
            seen = true
        } else if (c != 32 and c != 9) {
            return 0 - 1
        }
    }
    if (seen == false) { return 0 - 1 }
    return value
}

// An ASCII letter in lower case, anything else unchanged.
fn transportLowerAscii(byte: Int) -> Int {
    if (byte >= 65 and byte <= 90) { return byte + 32 }
    return byte
}

// One framed message in one write, so two messages cannot interleave and a client never reads a
// header whose body has not been written.
public fn writeMessage(body: String) {
    print("Content-Length: ".concat(body.length.toString(), "\r\n\r\n", body))
}
