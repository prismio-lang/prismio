// Integer compute: checksums, hashing, bit work, fixed-point arithmetic and a
// dispatch loop. No floating point, because the target keeps its FP unit off.
// The same programs as ../c/compute.c and ../rust/compute.rs.

export fn bench_crc32(scale: U32) -> U32 {
    let mut table: Array<U32, 256>
    let mut i = 0
    while (i < 256) {
        let mut c = i as U32
        let mut k = 0
        while (k < 8) {
            if ((c & 1) != 0) {
                c = 0xEDB88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        table[i] = c
        i = i + 1
    }
    let mut buffer: Array<U8, 32768>
    let mut s: U32 = 2024
    i = 0
    while (i < 32768) {
        s = s * 1664525 + 1013904223
        buffer[i] = (s >> 24) as U8
        i = i + 1
    }
    let mut crc: U32 = 0xFFFFFFFF
    let mut r: U32 = 0
    while (r < 32 * scale) {
        i = 0
        while (i < 32768) {
            crc = table[((crc ^ (buffer[i] as U32)) & 255) as Int] ^ (crc >> 8)
            i = i + 1
        }
        r = r + 1
    }
    return crc ^ 0xFFFFFFFF
}

fn rotr(x: U32, n: U32) -> U32 {
    return (x >> n) | (x << (32 - n))
}

export fn bench_sha256(scale: U32) -> U32 {
    let k: Array<U32, 64> = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    let mut h: Array<U32, 8> = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                                0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    let mut w: Array<U32, 64>
    let mut s: U32 = 808
    let mut block: U32 = 0
    while (block < 3000 * scale) {
        let mut t = 0
        while (t < 16) {
            s = s * 1664525 + 1013904223
            w[t] = s
            t = t + 1
        }
        t = 16
        while (t < 64) {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = w[t - 16] + s0 + w[t - 7] + s1
            t = t + 1
        }
        let mut a = h[0]
        let mut b = h[1]
        let mut c = h[2]
        let mut d = h[3]
        let mut e = h[4]
        let mut f = h[5]
        let mut g = h[6]
        let mut hh = h[7]
        t = 0
        while (t < 64) {
            let big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g)
            let t1 = hh + big1 + ch + k[t] + w[t]
            let big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = big0 + maj
            hh = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
            t = t + 1
        }
        h[0] = h[0] + a
        h[1] = h[1] + b
        h[2] = h[2] + c
        h[3] = h[3] + d
        h[4] = h[4] + e
        h[5] = h[5] + f
        h[6] = h[6] + g
        h[7] = h[7] + hh
        block = block + 1
    }
    return h[0] ^ h[1] ^ h[2] ^ h[3] ^ h[4] ^ h[5] ^ h[6] ^ h[7]
}

export fn bench_popcount(scale: U32) -> U32 {
    let mut s: U32 = 55
    let mut bits: U32 = 0
    let mut i: U32 = 0
    while (i < 600000 * scale) {
        s = s * 1664525 + 1013904223
        let mut x = s
        while (x != 0) {
            x = x & (x - 1)
            bits = bits + 1
        }
        i = i + 1
    }
    return bits
}

export fn bench_mandelbrot_fixed(scale: U32) -> U32 {
    let mut total: U32 = 0

    repeat(6) {
        for py in 0..<96 as I32 {
            for px in 0..<96 as I32 {

                let cr = -131072 + px * 2048
                let ci = -98304 + py * 2048
                let mut zr = 0
                let mut zi = 0
                let mut it: U32 = 0
                while (it < 40) {
                    let zr2 = (((zr as I64) * (zr as I64)) >> 16) as Int
                    let zi2 = (((zi as I64) * (zi as I64)) >> 16) as Int
                    if (zr2 + zi2 > 262144) {
                        break
                    } else {
                        zi = ((((zr as I64) * (zi as I64)) >> 15) as Int) + ci
                        zr = zr2 - zi2 + cr
                        it = it + 1
                    }
                }
                total = total + it
            }
        }
    }
    return total
}

export fn bench_bytecode_interpreter(scale: U32) -> U32 {
    // op, a, b, c
    let program: Array<U32, 32> = [
        0, 0, 1, 2,
        1, 1, 0, 3,
        2, 2, 1, 1,
        3, 3, 2, 0,
        4, 0, 0, 7,
        5, 1, 3, 0,
        0, 2, 2, 0,
        1, 3, 3, 1
    ]
    let mut reg: Array<U32, 4> = [1, 2, 3, 4]
    let mut pc: U32 = 0
    let mut step: U32 = 0
    while (step < 400000 * scale) {
        let base = (pc * 4) as Int
        let op = program[base]
        let a = program[base + 1] as Int
        let b = program[base + 2] as Int
        let c = program[base + 3]
        if (op == 0) {
            reg[a] = reg[b] + reg[c as Int]
        } else if (op == 1) {
            reg[a] = reg[b] ^ reg[c as Int]
        } else if (op == 2) {
            reg[a] = reg[b] * reg[c as Int]
        } else if (op == 3) {
            reg[a] = reg[b] << 1
        } else if (op == 4) {
            reg[a] = reg[b] + c
        } else {
            reg[a] = reg[b]
        }
        if (pc == 7) { pc = 0 } else { pc = pc + 1 }
        step = step + 1
    }
    return reg[0] ^ reg[1] ^ reg[2] ^ reg[3]
}
