// Algorithms over fixed arrays in the frame: no allocation, no library. The same
// programs, statement for statement, as ../c/algorithms.c and ../rust/algorithms.rs.

fn fib(n: U32) -> U32 {
    if (n < 2) { return n }
    return fib(n - 1) + fib(n - 2)
}

export fn bench_fibonacci(scale: U32) -> U32 {
    let mut total: U32 = 0
    let mut r: U32 = 0
    while (r < scale) {
        total = total + fib(27)
        r = r + 1
    }
    return total
}

export fn bench_prime_sieve(scale: U32) -> U32 {
    let mut total: U32 = 0
    let mut r: U32 = 0
    while (r < scale) {
        let mut flags: Array<U8, 200000>
        let mut count: U32 = 0
        let mut i = 2
        while (i < 200000) {
            if (flags[i] == 0) {
                count = count + 1
                let mut j = i + i
                while (j < 200000) {
                    flags[j] = 1
                    j = j + i
                }
            }
            i = i + 1
        }
        total = total + count
        r = r + 1
    }
    return total
}

fn gcd(a0: U32, b0: U32) -> U32 {
    let mut a = a0
    let mut b = b0
    while (b != 0) {
        let t = a % b
        a = b
        b = t
    }
    return a
}

export fn bench_gcd_lcm(scale: U32) -> U32 {
    let mut total: U32 = 0
    let mut r: U32 = 0
    while (r < scale) {
        let mut a: U32 = 1
        while (a <= 400) {
            let mut b: U32 = 1
            while (b <= 400) {
                total = total + gcd(a, b)
                b = b + 1
            }
            a = a + 1
        }
        r = r + 1
    }
    return total
}

export fn bench_binary_search(scale: U32) -> U32 {
    let mut table: Array<U32, 4096>
    let mut i = 0
    while (i < 4096) {
        table[i] = (i as U32) * 7 + 3
        i = i + 1
    }
    let mut s: U32 = 12345
    let mut found: U32 = 0
    let mut acc: U32 = 0
    let mut q: U32 = 0
    while (q < 100000 * scale) {
        s = s * 1664525 + 1013904223
        let key = s % 30000
        let mut lo: U32 = 0
        let mut hi: U32 = 4096
        while (lo < hi) {
            let mid = (lo + hi) >> 1
            if (table[mid as Int] < key) {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if (lo < 4096 and table[lo as Int] == key) {
            found = found + 1
            acc = acc + lo
        }
        q = q + 1
    }
    return found + acc * 3
}

fn quick(inout a: [U32], lo: Int, hi: Int) {
    if (lo >= hi) { return }
    let p = a[(lo + hi) >> 1]
    let mut i = lo
    let mut j = hi
    while (i <= j) {
        while (a[i] < p) { i = i + 1 }
        while (a[j] > p) { j = j - 1 }
        if (i <= j) {
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i = i + 1
            j = j - 1
        }
    }
    quick(a, lo, j)
    quick(a, i, hi)
}

export fn bench_quicksort(scale: U32) -> U32 {
    let mut data: Array<U32, 2048>
    let mut s: U32 = 777
    let mut sum: U32 = 0
    let mut r: U32 = 0
    while (r < 40 * scale) {
        let mut i = 0
        while (i < 2048) {
            s = s * 1664525 + 1013904223
            data[i] = s >> 4
            i = i + 1
        }
        quick(data, 0, 2047)
        i = 0
        while (i < 2048) {
            sum = sum + data[i] * ((i as U32) + 1)
            i = i + 1
        }
        r = r + 1
    }
    return sum
}

fn sift(inout a: [U32], start: Int, end: Int) {
    let mut root = start
    while (root * 2 + 1 <= end) {
        let child = root * 2 + 1
        let mut pick = root
        if (a[pick] < a[child]) { pick = child }
        if (child + 1 <= end and a[pick] < a[child + 1]) { pick = child + 1 }
        if (pick == root) { return }
        let t = a[root]
        a[root] = a[pick]
        a[pick] = t
        root = pick
    }
}

export fn bench_heapsort(scale: U32) -> U32 {
    let mut data: Array<U32, 2048>
    let mut s: U32 = 4242
    let mut sum: U32 = 0
    let mut r: U32 = 0
    while (r < 24 * scale) {
        let mut i = 0
        while (i < 2048) {
            s = s * 1664525 + 1013904223
            data[i] = s >> 4
            i = i + 1
        }
        let mut start = (2048 - 2) / 2
        while (start >= 0) {
            sift(data, start, 2047)
            start = start - 1
        }
        let mut end = 2047
        while (end > 0) {
            let t = data[0]
            data[0] = data[end]
            data[end] = t
            sift(data, 0, end - 1)
            end = end - 1
        }
        i = 0
        while (i < 2048) {
            sum = sum + data[i] * ((i as U32) + 1)
            i = i + 1
        }
        r = r + 1
    }
    return sum
}

export fn bench_knapsack(scale: U32) -> U32 {
    let mut weight: Array<Int, 64>
    let mut value: Array<Int, 64>
    let mut s: U32 = 99
    let mut i = 0
    while (i < 64) {
        s = s * 1664525 + 1013904223
        weight[i] = (((s >> 8) % 37) as Int) + 3
        s = s * 1664525 + 1013904223
        value[i] = (((s >> 8) % 97) as Int) + 1
        i = i + 1
    }
    let mut total: U32 = 0
    let mut r: U32 = 0
    while (r < 6 * scale) {
        let mut best: Array<Int, 1501>
        i = 0
        while (i < 64) {
            let w = weight[i]
            let v = value[i]
            let mut c = 1500
            while (c >= w) {
                best[c] = __builtin_max(best[c], best[c - w] + v)
                c = c - 1
            }
            i = i + 1
        }
        total = total + (best[1500] as U32)
        r = r + 1
    }
    return total
}

export fn bench_edit_distance(scale: U32) -> U32 {
    let mut a: Array<U8, 600>
    let mut b: Array<U8, 600>
    let mut s: U32 = 31337
    let mut i = 0
    while (i < 600) {
        s = s * 1664525 + 1013904223
        a[i] = ((s >> 12) & 3) as U8
        i = i + 1
    }
    i = 0
    while (i < 600) {
        s = s * 1664525 + 1013904223
        b[i] = ((s >> 12) & 3) as U8
        i = i + 1
    }
    let mut total: U32 = 0
    let mut r: U32 = 0
    while (r < scale) {
        let mut prev: Array<Int, 601>
        let mut cur: Array<Int, 601>
        let mut j = 0
        while (j <= 600) {
            prev[j] = j
            j = j + 1
        }
        i = 1
        while (i <= 600) {
            cur[0] = i
            j = 1
            while (j <= 600) {
                let mut cost = 1
                if (a[i - 1] == b[j - 1]) { cost = 0 }
                cur[j] = __builtin_min(__builtin_min(prev[j] + 1, cur[j - 1] + 1), prev[j - 1] + cost)
                j = j + 1
            }
            j = 0
            while (j <= 600) {
                prev[j] = cur[j]
                j = j + 1
            }
            i = i + 1
        }
        total = total + (prev[600] as U32)
        r = r + 1
    }
    return total
}

export fn bench_matrix_multiply(scale: U32) -> U32 {
    let mut a: Array<U32, 4096>
    let mut b: Array<U32, 4096>
    let mut c: Array<U32, 4096>
    let mut i = 0
    while (i < 64) {
        let mut j = 0
        while (j < 64) {
            a[i * 64 + j] = (((i * 3 + j * 5) % 17) as U32)
            b[i * 64 + j] = (((i * 7 + j * 2) % 13) as U32)
            j = j + 1
        }
        i = i + 1
    }
    let mut total: U32 = 0
    let mut r: U32 = 0
    while (r < 8 * scale) {
        i = 0
        while (i < 64) {
            let mut j = 0
            while (j < 64) {
                let mut sum: U32 = 0
                let mut k = 0
                while (k < 64) {
                    sum = sum + a[i * 64 + k] * b[k * 64 + j]
                    k = k + 1
                }
                c[i * 64 + j] = sum
                j = j + 1
            }
            i = i + 1
        }
        i = 0
        while (i < 4096) {
            total = total + c[i]
            i = i + 1
        }
        a[(r % 64) as Int] = a[(r % 64) as Int] + 1
        r = r + 1
    }
    return total
}
