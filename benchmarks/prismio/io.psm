import common
import std.fs
import std.string

fn benchByteSum(text: String) -> Int {
    let n = text.length()
    let mut checksum = 0
    let mut i = 0
    while (i < n) {
        checksum = (checksum + text.byteAt(i)) % 1000000007
        i = i + 1
    }
    return checksum + n
}

fn benchFileRead(path: String) -> Int {
    return benchByteSum(readFile(path))
}

fn benchFileWrite(scale: Int, path: String) -> Int {
    let content = "0123456789abcdef\n".repeat(4096 * scale)
    if (writeFile(path, content)) { return benchByteSum(content) }
    return -1
}

fn benchLineProcessing(path: String) -> Int {
    let text = readFile(path)
    let lines = text.lines()
    let mut checksum = 0
    let mut i = 0
    while (i < list_len(lines)) {
        let line = list_get(lines, i)
        checksum = (checksum + line.length() * 31 + line.count('a')) % 1000000007
        i = i + 1
    }
    return checksum + list_len(lines)
}

fn benchTokenization(scale: Int) -> Int {
    let text = "let value_17 = alpha + beta * 17;\n".repeat(1500 * scale)
    let n = text.length()
    let mut position = 0
    let mut tokens = 0
    let mut checksum = 0
    while (position < n) {
        let c = text.charAt(position)
        if (c.isSpace()) {
            position = position + 1
        } else {
            let start = position
            if (c.isAlpha() or c == '_') {
                position = position + 1
                while (position < n) {
                    let next = text.charAt(position)
                    if (next.isAlnum() == false and next != '_') { break }
                    position = position + 1
                }
            } else if (c.isDigit()) {
                position = position + 1
                while (position < n and text.charAt(position).isDigit()) {
                    position = position + 1
                }
            } else {
                position = position + 1
            }
            let token = text.substring(start, position - start)
            tokens = tokens + 1
            checksum = (checksum + token.length() * tokens) % 1000000007
        }
    }
    return checksum + tokens
}
