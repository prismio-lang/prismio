import common
import std.fs
import std.string

public fn benchByteSum(text: String) -> Int {
    let n = text.length()
    let mut checksum = 0
    let mut i = 0
    while (i < n) {
        checksum = (checksum + text.byteAt(i)) % 1000000007
        i = i + 1
    }
    return checksum + n
}

public fn benchFileRead(path: String) -> Int {
    return benchByteSum(readFile(path))
}

public fn benchFileWrite(scale: Int, path: String) -> Int {
    let content = "0123456789abcdef\n".repeat(4096 * scale)
    if (writeFile(path, content)) { return benchByteSum(content) }
    return -1
}

public fn benchLineProcessing(path: String) -> Int {
    let text = readFile(path)
    let lines = text.lines()
    let mut checksum = 0
    let mut i = 0
    while (i < lines.length) {
        let line = lines[i]
        checksum = (checksum + line.length() * 31 + line.count('a')) % 1000000007
        i = i + 1
    }
    return checksum + lines.length
}

public fn benchTokenization(scale: Int) -> Int {
    let text = "let value_17 = alpha + beta * 17;\n".repeat(1500 * scale)
    let n = text.length()
    let mut position = 0
    let mut tokens = 0
    let mut checksum = 0
    while (position < n) {
        let c = text.charAt(position)
        if (c.isSpace()) {
            position = position + 1
        } else {
            let start = position
            if (c.isAlpha() or c == '_') {
                position = position + 1
                while (position < n) {
                    let next = text.charAt(position)
                    if (next.isAlnum() == false and next != '_') { break }
                    position = position + 1
                }
            } else if (c.isDigit()) {
                position = position + 1
                while (position < n and text.charAt(position).isDigit()) {
                    position = position + 1
                }
            } else {
                position = position + 1
            }
            let token = text.substring(start, position - start)
            tokens = tokens + 1
            checksum = (checksum + token.length() * tokens) % 1000000007
        }
    }
    return checksum + tokens
}

public fn benchBase64Codec(scale: Int) -> Int {
    let n = 30000 * scale
    let mut input: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut seed = 17
    let mut i = 0
    while (i < n) {
        seed = benchRandom(seed)
        input.push(seed % 256)
        i = i + 1
    }

    let b64Chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let encodedLen = (n / 3) * 4
    let mut encoded: Vec<Int> = Vec<Int>.withCapacity(encodedLen)
    let mut initJ = 0
    while (initJ < encodedLen) {
        encoded.push(0)
        initJ = initJ + 1
    }

    let mut k = 0
    let mut j = 0
    while (k < n) {
        let b0 = input[k]
        let b1 = input[k + 1]
        let b2 = input[k + 2]

        let i0 = b0 >> 2
        let i1 = ((b0 & 3) << 4) | (b1 >> 4)
        let i2 = ((b1 & 15) << 2) | (b2 >> 6)
        let i3 = b2 & 63

        encoded[j] = b64Chars.byteAt(i0)
        encoded[j + 1] = b64Chars.byteAt(i1)
        encoded[j + 2] = b64Chars.byteAt(i2)
        encoded[j + 3] = b64Chars.byteAt(i3)

        k = k + 3
        j = j + 4
    }

    let mut inv: Vec<Int> = Vec<Int>.withCapacity(256)
    let mut initInv = 0
    while (initInv < 256) {
        inv.push(0)
        initInv = initInv + 1
    }
    let mut ti = 0
    while (ti < 64) {
        inv[b64Chars.byteAt(ti)] = ti
        ti = ti + 1
    }

    let mut decoded: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut initDec = 0
    while (initDec < n) {
        decoded.push(0)
        initDec = initDec + 1
    }

    let mut dj = 0
    let mut di = 0
    while (dj < encodedLen) {
        let c0 = inv[encoded[dj]]
        let c1 = inv[encoded[dj + 1]]
        let c2 = inv[encoded[dj + 2]]
        let c3 = inv[encoded[dj + 3]]

        decoded[di] = (c0 << 2) | (c1 >> 4)
        decoded[di + 1] = ((c1 & 15) << 4) | (c2 >> 2)
        decoded[di + 2] = ((c2 & 3) << 6) | c3

        dj = dj + 4
        di = di + 3
    }

    let mut checksum: I64 = 0
    let mut ci = 0
    while (ci < n) {
        checksum = (checksum * 31 + (decoded[ci] as I64)) % 1000000007
        ci = ci + 1
    }
    return ((checksum + (encodedLen as I64)) % 1000000007) as Int
}

public fn benchCsvParse(scale: Int) -> Int {
    let rows = 2500 * scale

    let mut csvData = ""
    let mut seed = 61
    let mut r = 0
    while (r < rows) {
        seed = benchRandom(seed)
        let id = 1000 + (seed % 9000)
        seed = benchRandom(seed)
        let amount = seed % 10000
        seed = benchRandom(seed)
        let score = seed % 100

        let mut nameStr = ""
        if (r % 3 == 0) {
            nameStr = "\"User \"\"Super\"\" " + (r % 100).toString() + "\","
        } else {
            nameStr = "User_" + (r % 500).toString() + ","
        }

        let mut statusStr = ""
        if (r % 2 == 0) {
            statusStr = "active"
        } else {
            statusStr = "pending"
        }

        let p1 = id.toString() + "," + nameStr
        let p2 = amount.toString() + "," + statusStr
        let p3 = "," + score.toString() + "\n"
        let line = p1 + p2 + p3
        csvData = csvData + line
        r = r + 1
    }

    let n = csvData.length()
    let mut sumId: I64 = 0
    let mut sumLen: I64 = 0
    let mut sumAmount: I64 = 0
    let mut sumStatus: I64 = 0
    let mut sumScore: I64 = 0

    let mut pos = 0
    let mut col = 0
    let mut fieldInt = 0
    let mut fieldLen = 0
    let mut inQuote = false

    while (pos < n) {
        let b = csvData.byteAt(pos)
        if (b == 34) { // '"'
            if (inQuote and pos + 1 < n and csvData.byteAt(pos + 1) == 34) {
                fieldLen = fieldLen + 1
                pos = pos + 2
            } else {
                inQuote = inQuote == false
                pos = pos + 1
            }
        } else if (inQuote == false and (b == 44 or b == 10)) { // ',' or '\n'
            if (col == 0) { sumId = (sumId + (fieldInt as I64)) % 1000000007 }
            else if (col == 1) { sumLen = (sumLen + (fieldLen as I64)) % 1000000007 }
            else if (col == 2) { sumAmount = (sumAmount + (fieldInt as I64)) % 1000000007 }
            else if (col == 3) { sumStatus = (sumStatus + (fieldLen as I64)) % 1000000007 }
            else if (col == 4) { sumScore = (sumScore + (fieldInt as I64)) % 1000000007 }

            fieldInt = 0
            fieldLen = 0
            if (b == 44) {
                col = col + 1
            } else {
                col = 0
            }
            pos = pos + 1
        } else {
            if (b >= 48 and b <= 57) { // '0'..'9'
                fieldInt = fieldInt * 10 + (b - 48)
            }
            fieldLen = fieldLen + 1
            pos = pos + 1
        }
    }

    let checksum = (sumId * 10007 + sumLen * 31 + sumAmount * 17 + sumStatus * 13 + sumScore) % 1000000007
    return checksum as Int
}
