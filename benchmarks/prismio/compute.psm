public fn benchSha256(scale: Int) -> Int {
    let mut h0: U32 = 1779033703 as U32
    let mut h1: U32 = 3144134277 as U32
    let mut h2: U32 = 1013904242 as U32
    let mut h3: U32 = 2773480762 as U32
    let mut h4: U32 = 1359893119 as U32
    let mut h5: U32 = 2600822924 as U32
    let mut h6: U32 = 528734635 as U32
    let mut h7: U32 = 1541459225 as U32

    let k = makeSha256K()
    let totalBlocks = 200 * scale
    let mut seed = 42
    let mut w: Vec<U32> = list_new_with_capacity(64)
    let mut initI = 0
    while (initI < 64) {
        list_push(w, 0 as U32)
        initI = initI + 1
    }

    let mut b = 0
    while (b < totalBlocks) {
        let mut i = 0
        while (i < 16) {
            seed = benchRandom(seed)
            let v1 = seed as U32
            seed = benchRandom(seed)
            let v2 = seed as U32
            list_set(w, i, (v1 << 16) | v2)
            i = i + 1
        }

        let mut t = 16
        while (t < 64) {
            let wt15 = list_get(w, t - 15)
            let wt2 = list_get(w, t - 2)
            let s0 = rotR(wt15, 7) ^ rotR(wt15, 18) ^ (wt15 >> 3)
            let s1 = rotR(wt2, 17) ^ rotR(wt2, 19) ^ (wt2 >> 10)
            let wt16 = list_get(w, t - 16)
            let wt7 = list_get(w, t - 7)
            list_set(w, t, wt16 + s0 + wt7 + s1)
            t = t + 1
        }

        let mut a = h0
        let mut bVal = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        let mut f = h5
        let mut g = h6
        let mut h = h7

        let mut step = 0
        while (step < 64) {
            let s1 = rotR(e, 6) ^ rotR(e, 11) ^ rotR(e, 25)
            let ch = (e & f) ^ ((~e) & g)
            let kt = list_get(k, step)
            let wt = list_get(w, step)
            let temp1 = h + s1 + ch + kt + wt
            let s0 = rotR(a, 2) ^ rotR(a, 13) ^ rotR(a, 22)
            let maj = (a & bVal) ^ (a & c) ^ (bVal & c)
            let temp2 = s0 + maj

            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = bVal
            bVal = a
            a = temp1 + temp2
            step = step + 1
        }

        h0 = h0 + a
        h1 = h1 + bVal
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + h
        b = b + 1
    }

    let checksum = ((h0 ^ h1 ^ h2 ^ h3 ^ h4 ^ h5 ^ h6 ^ h7) & (2147483647 as U32)) as Int
    return checksum
}

// BLAKE3's G mixing step on four words of the state. `v` is the caller's array,
// written in place, as the Rust arm's `&mut [u32; 16]` and the C++ arm's
// references are.
fn blake3G(v: [U32], a: Int, b: Int, c: Int, d: Int, mx: U32, my: U32) {
    v[a] = v[a] + v[b] + mx
    v[d] = rotR(v[d] ^ v[a], 16)
    v[c] = v[c] + v[d]
    v[b] = rotR(v[b] ^ v[c], 12)
    v[a] = v[a] + v[b] + my
    v[d] = rotR(v[d] ^ v[a], 8)
    v[c] = v[c] + v[d]
    v[b] = rotR(v[b] ^ v[c], 7)
}

public fn benchBlake3Chunk(scale: Int) -> Int {
    let totalChunks = 300 * scale
    let mut seed = 99

    let IV: [U32] = [
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
    ]
    let MSG_PERM: [Int] = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]

    let mut totalChecksum: U32 = 0
    let m: Array<U32, 16>
    let v: Array<U32, 16>
    let nextM: Array<U32, 16>

    let mut chunk = 0
    while (chunk < totalChunks) {
        let mut i = 0
        while (i < 16) {
            seed = benchRandom(seed)
            let v1 = seed as U32
            seed = benchRandom(seed)
            let v2 = seed as U32
            m[i] = (v1 << 16) | v2
            i = i + 1
        }

        i = 0
        while (i < 8) {
            v[i] = IV[i]
            i = i + 1
        }
        v[8] = IV[0]
        v[9] = IV[1]
        v[10] = IV[2]
        v[11] = IV[3]
        v[12] = chunk as U32
        v[13] = 0
        v[14] = 1024
        v[15] = 0

        let mut round = 0
        while (round < 7) {
            blake3G(v, 0, 4, 8, 12, m[0], m[1])
            blake3G(v, 1, 5, 9, 13, m[2], m[3])
            blake3G(v, 2, 6, 10, 14, m[4], m[5])
            blake3G(v, 3, 7, 11, 15, m[6], m[7])

            blake3G(v, 0, 5, 10, 15, m[8], m[9])
            blake3G(v, 1, 6, 11, 12, m[10], m[11])
            blake3G(v, 2, 7, 8, 13, m[12], m[13])
            blake3G(v, 3, 4, 9, 14, m[14], m[15])

            i = 0
            while (i < 16) {
                nextM[i] = m[MSG_PERM[i]]
                i = i + 1
            }
            i = 0
            while (i < 16) {
                m[i] = nextM[i]
                i = i + 1
            }
            round = round + 1
        }

        let mut chunkHash: U32 = 0
        i = 0
        while (i < 8) {
            chunkHash = chunkHash ^ (v[i] ^ v[i + 8])
            i = i + 1
        }
        totalChecksum = (totalChecksum * 31 + chunkHash) & 2147483647
        chunk = chunk + 1
    }

    return totalChecksum as Int
}

public fn benchRaytracerSphere(scale: Int) -> Int {
    let width = 50 * scale
    let height = 50 * scale

    let spheres: Vec<Float> = list_new()
    // Sphere 0
    list_push(spheres, 0.0)
    list_push(spheres, 0.0)
    list_push(spheres, 3.0)
    list_push(spheres, 1.0)
    list_push(spheres, 255.0)
    list_push(spheres, 30.0)
    list_push(spheres, 30.0)
    // Sphere 1
    list_push(spheres, 2.0)
    list_push(spheres, 1.0)
    list_push(spheres, 4.0)
    list_push(spheres, 1.0)
    list_push(spheres, 30.0)
    list_push(spheres, 255.0)
    list_push(spheres, 30.0)
    // Sphere 2
    list_push(spheres, -2.0)
    list_push(spheres, 1.0)
    list_push(spheres, 4.0)
    list_push(spheres, 1.0)
    list_push(spheres, 30.0)
    list_push(spheres, 30.0)
    list_push(spheres, 255.0)
    // Sphere 3 (ground)
    list_push(spheres, 0.0)
    list_push(spheres, -1001.0)
    list_push(spheres, 0.0)
    list_push(spheres, 1000.0)
    list_push(spheres, 200.0)
    list_push(spheres, 200.0)
    list_push(spheres, 200.0)

    let light_x = -10.0
    let light_y = 20.0
    let light_z = -10.0

    let cam_x = 0.0
    let cam_y = 0.0
    let cam_z = -5.0

    let mut checksum: I64 = 0

    let mut py = 0
    while (py < height) {
        let screen_y = -((((py as Float) + 0.5) / (height as Float)) * 2.0 - 1.0)
        let mut px = 0
        while (px < width) {
            let screen_x = (((px as Float) + 0.5) / (width as Float)) * 2.0 - 1.0
            let mut dir_x = screen_x
            let mut dir_y = screen_y
            let mut dir_z = 2.0
            let inv_len = 1.0 / sqrt(dir_x * dir_x + dir_y * dir_y + dir_z * dir_z)
            dir_x = dir_x * inv_len
            dir_y = dir_y * inv_len
            dir_z = dir_z * inv_len

            let mut closest_t = 1000000000000000000000000000000.0
            let mut hit_idx = -1
            let mut s = 0
            while (s < 4) {
                let off = s * 7
                let sx = list_get(spheres, off)
                let sy = list_get(spheres, off + 1)
                let sz = list_get(spheres, off + 2)
                let sr = list_get(spheres, off + 3)

                let oc_x = cam_x - sx
                let oc_y = cam_y - sy
                let oc_z = cam_z - sz
                let b = oc_x * dir_x + oc_y * dir_y + oc_z * dir_z
                let c = (oc_x * oc_x + oc_y * oc_y + oc_z * oc_z) - sr * sr
                let disc = b * b - c
                if (disc > 0.0) {
                    let t = -b - sqrt(disc)
                    if (t > 0.001 and t < closest_t) {
                        closest_t = t
                        hit_idx = s
                    }
                }
                s = s + 1
            }

            if (hit_idx >= 0) {
                let off = hit_idx * 7
                let sx = list_get(spheres, off)
                let sy = list_get(spheres, off + 1)
                let sz = list_get(spheres, off + 2)
                let sr = list_get(spheres, off + 3)
                let scr = list_get(spheres, off + 4)
                let scg = list_get(spheres, off + 5)
                let scb = list_get(spheres, off + 6)

                let hx = cam_x + closest_t * dir_x
                let hy = cam_y + closest_t * dir_y
                let hz = cam_z + closest_t * dir_z

                let nx = (hx - sx) / sr
                let ny = (hy - sy) / sr
                let nz = (hz - sz) / sr

                let mut lx = light_x - hx
                let mut ly = light_y - hy
                let mut lz = light_z - hz
                let ldist = sqrt(lx * lx + ly * ly + lz * lz)
                lx = lx / ldist
                ly = ly / ldist
                lz = lz / ldist

                let sh_ox = hx + nx * 0.001
                let sh_oy = hy + ny * 0.001
                let sh_oz = hz + nz * 0.001
                let mut in_shadow = false

                let mut ss = 0
                while (ss < 4) {
                    let soff = ss * 7
                    let ssx = list_get(spheres, soff)
                    let ssy = list_get(spheres, soff + 1)
                    let ssz = list_get(spheres, soff + 2)
                    let ssr = list_get(spheres, soff + 3)

                    let oc_x = sh_ox - ssx
                    let oc_y = sh_oy - ssy
                    let oc_z = sh_oz - ssz
                    let b = oc_x * lx + oc_y * ly + oc_z * lz
                    let c = (oc_x * oc_x + oc_y * oc_y + oc_z * oc_z) - ssr * ssr
                    let disc = b * b - c
                    if (disc > 0.0) {
                        let t = -b - sqrt(disc)
                        if (t > 0.001 and t < ldist) {
                            in_shadow = true
                            ss = 4 // break
                        }
                    }
                    ss = ss + 1
                }

                let mut dot = nx * lx + ny * ly + nz * lz
                if (dot < 0.0) { dot = 0.0 }
                let mut diff = dot * 0.85
                if (in_shadow) { diff = 0.0 }
                let intensity = 0.15 + diff

                let mut r = (scr * intensity) as Int
                let mut g = (scg * intensity) as Int
                let mut b_col = (scb * intensity) as Int
                if (r > 255) { r = 255 }
                if (g > 255) { g = 255 }
                if (b_col > 255) { b_col = 255 }

                let pixVal: I64 = ((r as I64) * 65537 + (g as I64) * 257 + (b_col as I64))
                checksum = (checksum * 31 + pixVal) % 1000000007
            } else {
                checksum = (checksum * 31 + 17) % 1000000007
            }
            px = px + 1
        }
        py = py + 1
    }

    return checksum as Int
}

struct WorkConfig {
    count: Int
}

struct Msg {
    val: Int
}

public fn stage1(ch: Channel<Msg>, cfg: WorkConfig) -> Int {
    let mut i = 0
    let total = cfg.count
    while (i < total) {
        let x = (i * 25173 + 13849) % 65521
        chan_send(ch, Msg { val: x })
        i = i + 1
    }
    chan_close(ch)
    return i
}

public fn stage2(in_ch: Channel<Msg>, out_ch: Channel<Msg>) -> Int {
    let mut count = 0
    loop {
        let taken = chan_recv(in_ch)
        if (taken == none) { break }
        let msg = expect(taken)
        let x = msg.val
        let y: I64 = ((x as I64) * 17 + 31) % 1000000007
        chan_send(out_ch, Msg { val: y as Int })
        count = count + 1
    }
    chan_close(out_ch)
    return count
}

public fn benchChannelPipeline(scale: Int) -> Int {
    let count = 5000 * scale
    let cfg = WorkConfig { count: count }
    let ch1: Channel<Msg> = chan_new(64)
    let ch2: Channel<Msg> = chan_new(64)

    let w1 = spawn stage1(chan_share(ch1), cfg)
    let w2 = spawn stage2(chan_share(ch1), chan_share(ch2))

    let mut checksum: I64 = 0
    loop {
        let taken = chan_recv(ch2)
        if (taken == none) { break }
        let msg = expect(taken)
        checksum = (checksum * 31 + (msg.val as I64)) % 1000000007
    }

    let _j1 = join w1
    let _j2 = join w2
    chan_free(ch1)
    chan_free(ch2)

    return checksum as Int
}

// A stack machine over a decoded instruction stream: the shape of a real
// interpreter loop, which `switch_dispatch` is not. That benchmark branches on a
// value; this one carries a stack across iterations, so the dispatch and the
// data traffic are dependent and the branch predictor sees a trace rather than a
// distribution.
//
// Stack values are reduced modulo 46337 because 46336 squared is the largest
// product that fits a signed 32-bit int. Prismio's `Int` wraps on overflow and
// C++'s signed overflow is undefined, so an arm that promoted to 64 bits to stay
// defined would be a different program -- which is how the first version of this
// benchmark was caught, by the three checksums disagreeing.
//
// Instructions are two parallel Int arrays rather than a payload enum, because
// the three arms have to be the same program: an enum with payloads, a
// `std::variant` and a tagged struct have three different representations, and
// the difference would be measured instead of the interpreter.
public fn benchBytecodeInterpreter(scale: Int) -> Int {
    let program = 4096
    let mut ops: Vec<Int> = list_new_with_capacity(program)
    let mut args: Vec<Int> = list_new_with_capacity(program)
    let mut seed = 11
    let mut p = 0
    while (p < program) {
        seed = benchRandom(seed)
        list_push(ops, seed % 6)
        list_push(args, (seed % 251) + 1)
        p = p + 1
    }

    let mut stack: Vec<Int> = list_new_with_capacity(64)
    let mut s = 0
    while (s < 64) {
        list_push(stack, 0)
        s = s + 1
    }

    let mut accumulator = 0
    let mut top = 0
    let rounds = 900 * scale
    let mut r = 0
    while (r < rounds) {
        let mut pc = 0
        while (pc < program) {
            let op = list_get(ops, pc)
            let argument = list_get(args, pc)
            if (op == 0) {
                if (top < 63) {
                    list_set(stack, top, argument)
                    top = top + 1
                }
            } else if (op == 1) {
                if (top > 1) {
                    let b = list_get(stack, top - 1)
                    let a = list_get(stack, top - 2)
                    list_set(stack, top - 2, (a + b) % 46337)
                    top = top - 1
                }
            } else if (op == 2) {
                if (top > 1) {
                    let b = list_get(stack, top - 1)
                    let a = list_get(stack, top - 2)
                    list_set(stack, top - 2, (a * b) % 46337)
                    top = top - 1
                }
            } else if (op == 3) {
                if (top > 0) {
                    top = top - 1
                    accumulator = (accumulator + list_get(stack, top)) % 1000000007
                }
            } else if (op == 4) {
                if (top > 0) {
                    let value = list_get(stack, top - 1)
                    list_set(stack, top - 1, (value ^ argument) % 46337)
                }
            } else {
                if (top > 0 and list_get(stack, top - 1) % 2 == 0) {
                    pc = pc + 1
                }
            }
            pc = pc + 1
        }
        r = r + 1
    }
    return (accumulator + top) % 1000000007
}
