import common
import std.math


struct BenchParticle {
    x: Float,
    y: Float,
    vx: Float,
    vy: Float,
    life: Int
}

public fn benchMatrixMultiply(scale: Int) -> Int {
    let n = 32 * scale
    let count = n * n
    let mut a: Vec<Int> = Vec<Int>.withCapacity(count)
    let mut b: Vec<Int> = Vec<Int>.withCapacity(count)
    let mut c: Vec<Int> = Vec<Int>.withCapacity(count)
    let mut i = 0
    while (i < count) {
        a.push((i * 17) % 101)
        b.push((i * 29) % 103)
        c.push(0)
        i = i + 1
    }
    let mut row = 0
    while (row < n) {
        let mut col = 0
        while (col < n) {
            let mut sum = 0
            let mut k = 0
            while (k < n) {
                sum = (sum + a[row * n + k] * b[k * n + col]) % 1000000007
                k = k + 1
            }
            c[row * n + col] = sum
            col = col + 1
        }
        row = row + 1
    }
    let mut checksum = 0
    let mut at = 0
    while (at < count) {
        checksum = (checksum + c[at]) % 1000000007
        at = at + 1
    }
    return checksum
}

public fn benchMandelbrot(scale: Int) -> Int {
    let side = 96 * scale
    let mut inside = 0
    let mut py = 0
    while (py < side) {
        let cy = (py as Float) * 2.0 / (side as Float) - 1.0
        let mut px = 0
        while (px < side) {
            let cx = (px as Float) * 3.0 / (side as Float) - 2.0
            let mut x = 0.0
            let mut y = 0.0
            let mut iter = 0
            while (x * x + y * y <= 4.0 and iter < 60) {
                let nextX = x * x - y * y + cx
                y = 2.0 * x * y + cy
                x = nextX
                iter = iter + 1
            }
            if (iter == 60) { inside = inside + 1 }
            px = px + 1
        }
        py = py + 1
    }
    return inside
}

public fn benchFftTransform(inout real: Vec<Float>, inout imag: Vec<Float>, n: Int) {
    let mut j = 0
    let mut i = 1
    while (i < n) {
        let mut bit = n / 2
        while (j >= bit) {
            j = j - bit
            bit = bit / 2
        }
        j = j + bit
        if (i < j) {
            let realSwap = real[i]
            let imagSwap = imag[i]
            real[i] = real[j]
            imag[i] = imag[j]
            real[j] = realSwap
            imag[j] = imagSwap
        }
        i = i + 1
    }

    let mut length = 2
    while (length <= n) {
        let angle = -6.283185307179586 / (length as Float)
        let stepReal = cos(angle)
        let stepImag = sin(angle)
        let half = length / 2
        let mut block = 0
        while (block < n) {
            let mut weightReal = 1.0
            let mut weightImag = 0.0
            let mut offset = 0
            while (offset < half) {
                let left = block + offset
                let right = left + half
                let rightReal = real[right]
                let rightImag = imag[right]
                let valueReal = rightReal * weightReal - rightImag * weightImag
                let valueImag = rightReal * weightImag + rightImag * weightReal
                let leftReal = real[left]
                let leftImag = imag[left]
                real[left] = leftReal + valueReal
                imag[left] = leftImag + valueImag
                real[right] = leftReal - valueReal
                imag[right] = leftImag - valueImag
                let nextReal = weightReal * stepReal - weightImag * stepImag
                weightImag = weightReal * stepImag + weightImag * stepReal
                weightReal = nextReal
                offset = offset + 1
            }
            block = block + length
        }
        length = length * 2
    }
}

public fn benchFft(scale: Int) -> Int {
    let mut n = 1024 * scale
    if (scale == 12) { n = 16384 }
    let mut real: Vec<Float> = Vec<Float>.withCapacity(n)
    let mut imag: Vec<Float> = Vec<Float>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        real.push(1.0)
        imag.push(0.0)
        i = i + 1
    }
    let rounds = 20 * scale
    let mut checksum = 0
    let mut round = 0
    while (round < rounds) {
        let mut k = 0
        while (k < n) {
            real[k] = 1.0
            imag[k] = 0.0
            k = k + 1
        }
        benchFftTransform(real, imag, n)
        checksum = checksum + (real[0] as Int)
        round = round + 1
    }
    return checksum
}

public fn benchNumericalIntegration(scale: Int) -> Int {
    let steps = 1000000 * scale
    let width = 1.0 / (steps as Float)
    let mut sum = 0.0
    let mut i = 0
    while (i < steps) {
        let x = ((i as Float) + 0.5) * width
        sum = sum + (4.0 / (1.0 + x * x))
        i = i + 1
    }
    return (sum * width * 100000000.0) as Int
}

public fn benchVectorDot(scale: Int) -> Int {
    let n = 1000000 * scale
    let mut a: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut b: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        a.push(i % 101)
        b.push((i * 3) % 103)
        i = i + 1
    }
    let mut sum = 0
    let mut k = 0
    while (k < n) {
        sum = (sum + a[k] * b[k]) % 1000000007
        k = k + 1
    }
    return sum
}

public fn benchConvolution(scale: Int) -> Int {
    let n = 300000 * scale
    let mut input: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut output: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        input.push(i % 251)
        output.push(0)
        i = i + 1
    }
    let mut at = 3
    while (at + 3 < n) {
        let value = input[at - 3] + 2 * input[at - 2]
            + 3 * input[at - 1] + 4 * input[at]
            + 3 * input[at + 1] + 2 * input[at + 2]
            + input[at + 3]
        output[at] = value
        at = at + 1
    }
    let mut checksum = 0
    let mut k = 0
    while (k < n) {
        checksum = (checksum + output[k]) % 1000000007
        k = k + 1
    }
    return checksum
}

public fn benchMonteCarlo(scale: Int) -> Int {
    let samples = 2000000 * scale
    let mut seed = 31
    let mut inside = 0
    let mut i = 0
    while (i < samples) {
        seed = benchRandom(seed)
        let x = seed % 10000
        seed = benchRandom(seed)
        let y = seed % 10000
        if (x * x + y * y <= 100000000) { inside = inside + 1 }
        i = i + 1
    }
    return inside
}

public fn benchPolynomial(scale: Int) -> Int {
    let evaluations = 2000000 * scale
    let mut checksum = 0
    let mut i = 0
    while (i < evaluations) {
        let x = i % 97
        let mut value = 3
        value = (value * x + 5) % 1000003
        value = (value * x + 7) % 1000003
        value = (value * x + 11) % 1000003
        value = (value * x + 13) % 1000003
        value = (value * x + 17) % 1000003
        checksum = (checksum + value) % 1000000007
        i = i + 1
    }
    return checksum
}

public fn benchEcsUpdate(scale: Int) -> Int {
    let n = 50000 * scale
    let rounds = 20
    let mut particles: Vec<BenchParticle> = Vec<BenchParticle>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        particles.push(BenchParticle {
            x: (i % 1000) as Float, y: (i % 500) as Float,
            vx: ((i % 7) + 1) as Float, vy: ((i % 11) + 1) as Float,
            life: 100
        })
        i = i + 1
    }
    let mut round = 0
    while (round < rounds) {
        let mut k = 0
        while (k < n) {
            let p = particles[k]
            p.x = p.x + p.vx * 0.016
            p.y = p.y + p.vy * 0.016
            p.life = p.life - 1
            k = k + 1
        }
        round = round + 1
    }
    let mut checksum = 0
    let mut q = 0
    while (q < n) {
        let p = particles[q]
        checksum = (checksum + (p.x as Int) + (p.y as Int) + p.life) % 1000000007
        q = q + 1
    }
    return checksum
}

public fn benchBandSum(band: BenchBand) -> Int {
    let mut state = band.seed
    let mut sum = 0
    let mut i = 0
    while (i < band.steps) {
        state = benchRandom(state)
        sum = (sum + state) % 1000000007
        i = i + 1
    }
    return sum
}

public fn benchParallelReduction(scale: Int) -> Int {
    let steps = 500000 * scale
    let w0 = spawn benchBandSum(BenchBand { seed: 1, steps: steps })
    let w1 = spawn benchBandSum(BenchBand { seed: 101, steps: steps })
    let w2 = spawn benchBandSum(BenchBand { seed: 1001, steps: steps })
    let w3 = spawn benchBandSum(BenchBand { seed: 10001, steps: steps })
    return (((join w0 + join w1) % 1000000007) + ((join w2 + join w3) % 1000000007)) % 1000000007
}

public fn rotR(x: U32, n: Int) -> U32 {
    return (x >> n) | (x << (32 - n))
}

