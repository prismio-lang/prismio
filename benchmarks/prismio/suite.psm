import algorithms
import adversarial
import common
import compute
import data_structures
import io
import memory
import std.process
import std.string

fn benchRun(name: String, scale: Int, inputPath: String, outputPath: String) -> Int {
    if (name.equals("fibonacci")) { return benchFibonacci(scale) }
    if (name.equals("prime_sieve")) { return benchPrimeSieve(scale) }
    if (name.equals("gcd_lcm")) { return benchGcdLcm(scale) }
    if (name.equals("binary_search")) { return benchBinarySearch(scale) }
    if (name.equals("quicksort")) { return benchQuicksort(scale) }
    if (name.equals("mergesort")) { return benchMergesort(scale) }
    if (name.equals("string_search")) { return benchStringSearch(scale) }
    if (name.equals("graph_bfs")) { return benchGraphBfs(scale) }
    if (name.equals("knapsack")) { return benchKnapsack(scale) }
    if (name.equals("tree_traversal")) { return benchTreeTraversal(scale) }
    if (name.equals("hashmap_insert_lookup")) { return benchHashMap(scale) }
    if (name.equals("vector_growth")) { return benchVectorGrowth(scale) }
    if (name.equals("vector_iteration")) { return benchVectorIteration(scale) }
    if (name.equals("key_value_update")) { return benchKeyValueUpdate(scale) }
    if (name.equals("matrix_multiply")) { return benchMatrixMultiply(scale) }
    if (name.equals("mandelbrot")) { return benchMandelbrot(scale) }
    if (name.equals("fft")) { return benchFft(scale) }
    if (name.equals("numerical_integration")) { return benchNumericalIntegration(scale) }
    if (name.equals("vector_dot")) { return benchVectorDot(scale) }
    if (name.equals("convolution")) { return benchConvolution(scale) }
    if (name.equals("monte_carlo")) { return benchMonteCarlo(scale) }
    if (name.equals("polynomial_evaluation")) { return benchPolynomial(scale) }
    if (name.equals("ecs_component_update")) { return benchEcsUpdate(scale) }
    if (name.equals("parallel_reduction")) { return benchParallelReduction(scale) }
    if (name.equals("transient_allocation")) { return benchTransientAllocation(scale) }
    if (name.equals("struct_creation")) { return benchStructCreation(scale) }
    if (name.equals("allocation_mutation")) { return benchAllocationMutation(scale) }
    if (name.equals("nested_collection")) { return benchNestedCollection(scale) }
    if (name.equals("large_buffer_copy")) { return benchLargeBufferCopy(scale) }
    if (name.equals("recursive_tree_rebuild")) { return benchRecursiveTreeRebuild(scale) }
    if (name.equals("file_read")) { return benchFileRead(inputPath) }
    if (name.equals("file_write")) { return benchFileWrite(scale, outputPath) }
    if (name.equals("line_processing")) { return benchLineProcessing(inputPath) }
    if (name.equals("tokenization")) { return benchTokenization(scale) }
    if (name.equals("dijkstra_shortest_path")) { return benchDijkstraShortestPath(scale) }
    if (name.equals("lz4_compress")) { return benchLz4Compress(scale) }
    if (name.equals("s_expression_parse")) { return benchSExprParse(scale) }
    if (name.equals("flat_bitset")) { return benchFlatBitset(scale) }
    if (name.equals("trie_search")) { return benchTrieSearch(scale) }
    if (name.equals("sha256")) { return benchSha256(scale) }
    if (name.equals("blake3_chunk")) { return benchBlake3Chunk(scale) }
    if (name.equals("raytracer_sphere")) { return benchRaytracerSphere(scale) }
    if (name.equals("channel_pipeline")) { return benchChannelPipeline(scale) }
    if (name.equals("base64_codec")) { return benchBase64Codec(scale) }
    if (name.equals("csv_parse")) { return benchCsvParse(scale) }
    if (name.equals("pointer_chase")) { return benchPointerChase(scale) }
    if (name.equals("random_gather")) { return benchRandomGather(scale) }
    if (name.equals("branch_mispredict")) { return benchBranchMispredict(scale) }
    if (name.equals("strided_memory")) { return benchStridedMemory(scale) }
    if (name.equals("allocation_escape")) { return benchAllocationEscape(scale) }
    if (name.equals("function_call_overhead")) { return benchFunctionCallOverhead(scale) }
    if (name.equals("indirect_calls")) { return benchIndirectCalls(scale) }
    if (name.equals("dependency_chain")) { return benchDependencyChain(scale) }
    if (name.equals("aos_vs_soa")) { return benchAosVsSoa(scale) }
    if (name.equals("switch_dispatch")) { return benchSwitchDispatch(scale) }
    if (name.equals("memcpy_mix")) { return benchMemcpyMix(scale) }
    if (name.equals("dead_code_elimination")) { return benchDeadCodeElimination(scale) }
    return -1
}

fn main() -> Int {
    if (argCount() < 2) {
        benchPrintln("usage: suite <benchmark> [input] [output]")
        return 2
    }
    let name = arg(1)
    let scale = 4
    let inputPath = arg(2)
    let outputPath = arg(3)
    let t0 = benchNow()
    let result = benchRun(name, scale, inputPath, outputPath)
    let t1 = benchNow()
    if (result < 0) {
        benchPrintln("unknown or failed benchmark")
        return 2
    }
    benchPrint("result: ")
    benchPrintln(result)
    benchPrint("elapsed_ns: ")
    benchPrintln((t1 - t0) as Int)
    return 0
}
