import std.string

extern fn clock_gettime(clk: Int, stamp: BenchTimespec) -> Int

// The suite does not import std.io on purpose: an imported module's allocation
// sites enter this program's AIF analysis whether or not they ever run. So it
// reaches the descriptor the same way std/io.psm does, with the same
// declaration -- the fd is a C `int`, the count and the result are 64-bit.
extern fn write(fd: Int, buffer: String borrow, count: I64) -> I64

private fn benchWrite(text: String) {
    write(1, text, __builtin_string_len(text) as I64)
}

fn benchPrint(text: String) { benchWrite(text) }
fn benchPrintln(text: String) { benchWrite(text) benchWrite("\n") }
fn benchPrintln(value: Int) { benchWrite(value.toString()) benchWrite("\n") }

struct BenchTimespec {
    seconds: I64,
    nanoseconds: I64
}

fn benchNow() -> I64 {
    let stamp = BenchTimespec { seconds: 0, nanoseconds: 0 }
    clock_gettime(4, stamp)
    return stamp.seconds * 1000000000 + stamp.nanoseconds
}

struct BenchBucket {
    values: List<Int>
}

struct BenchBand {
    seed: Int,
    steps: Int
}

enum BenchTree {
    Empty,
    Node(BenchTree, Int, BenchTree)
}

fn benchRandom(seed: Int) -> Int {
    return (seed * 25173 + 13849) % 65521
}
