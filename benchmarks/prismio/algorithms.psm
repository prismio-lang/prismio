import common
import std.vec
import std.map
import std.math
import std.string

public fn benchGcd(a0: Int, b0: Int) -> Int {
    let mut a = a0
    let mut b = b0
    while (b != 0) {
        let t = a % b
        a = b
        b = t
    }
    return a
}

public fn benchFibonacci(scale: Int) -> Int {
    let limit = 1000000 * scale
    let mut a = 1
    let mut b = 1
    let mut checksum = 0
    let mut i = 0
    while (i < limit) {
        let c = (a + b) % 1000003
        a = b
        b = c
        checksum = (checksum + c) % 1000000007
        i = i + 1
    }
    return checksum
}

public fn benchPrimeSieve(scale: Int) -> Int {
    let n = 100000 * scale
    let mut prime: Vec<Bool> = list_new_with_capacity(n + 1)
    let mut i = 0
    while (i <= n) {
        list_push(prime, true)
        i = i + 1
    }
    list_set(prime, 0, false)
    list_set(prime, 1, false)
    let mut p = 2
    while (p * p <= n) {
        if (list_get(prime, p)) {
            let mut multiple = p * p
            while (multiple <= n) {
                list_set(prime, multiple, false)
                multiple = multiple + p
            }
        }
        p = p + 1
    }
    let mut count = 0
    let mut sum = 0
    let mut k = 2
    while (k <= n) {
        if (list_get(prime, k)) {
            count = count + 1
            sum = (sum + k) % 1000000007
        }
        k = k + 1
    }
    return (sum + count) % 1000000007
}

public fn benchGcdLcm(scale: Int) -> Int {
    let limit = 300000 * scale
    let mut checksum = 0
    let mut i = 1
    while (i <= limit) {
        let a = i % 30000 + 1
        let b = (i * 17) % 30000 + 1
        let g = benchGcd(a, b)
        let l = (a / g) * b
        checksum = (checksum + g + l) % 1000000007
        i = i + 1
    }
    return checksum
}

public fn benchBinarySearch(scale: Int) -> Int {
    let n = 100000 * scale
    let queries = 500000 * scale
    let mut values: Vec<Int> = list_new_with_capacity(n)
    let mut i = 0
    while (i < n) {
        list_push(values, i * 2)
        i = i + 1
    }
    let mut found = 0
    let mut seed = 7
    let mut q = 0
    while (q < queries) {
        seed = benchRandom(seed)
        let needle = seed % (n * 2)
        let mut low = 0
        let mut high = n - 1
        let mut hit = false
        while (low <= high) {
            let mid = low + (high - low) / 2
            let value = list_get(values, mid)
            if (value == needle) {
                hit = true
                low = high + 1
            } else if (value < needle) {
                low = mid + 1
            } else {
                high = mid - 1
            }
        }
        if (hit) { found = found + 1 }
        q = q + 1
    }
    return found
}

public fn benchSwap(values: Vec<Int>, a: Int, b: Int) {
    let x = list_get(values, a)
    let y = list_get(values, b)
    list_set(values, a, y)
    list_set(values, b, x)
}

public fn benchQuickRange(values: Vec<Int>, low: Int, high: Int) {
    if (low >= high) { return }
    let pivot = list_get(values, low + (high - low) / 2)
    let mut i = low
    let mut j = high
    while (i <= j) {
        while (list_get(values, i) < pivot) { i = i + 1 }
        while (list_get(values, j) > pivot) { j = j - 1 }
        if (i <= j) {
            benchSwap(values, i, j)
            i = i + 1
            j = j - 1
        }
    }
    if (low < j) { benchQuickRange(values, low, j) }
    if (i < high) { benchQuickRange(values, i, high) }
}

public fn benchQuicksort(scale: Int) -> Int {
    let n = 25000 * scale
    let mut values: Vec<Int> = list_new_with_capacity(n)
    let mut seed = 19
    let mut i = 0
    while (i < n) {
        seed = benchRandom(seed)
        list_push(values, seed)
        i = i + 1
    }
    benchQuickRange(values, 0, n - 1)
    let mut checksum = 0
    let mut k = 0
    while (k < n) {
        checksum = (checksum + list_get(values, k)) % 1000000007
        k = k + 97
    }
    return checksum + list_get(values, n - 1)
}

public fn benchMergeRange(values: Vec<Int>, scratch: Vec<Int>, low: Int, high: Int) {
    if (high - low <= 1) { return }
    let mid = low + (high - low) / 2
    benchMergeRange(values, scratch, low, mid)
    benchMergeRange(values, scratch, mid, high)
    let mut left = low
    let mut right = mid
    let mut out = low
    while (left < mid and right < high) {
        if (list_get(values, left) <= list_get(values, right)) {
            list_set(scratch, out, list_get(values, left))
            left = left + 1
        } else {
            list_set(scratch, out, list_get(values, right))
            right = right + 1
        }
        out = out + 1
    }
    while (left < mid) {
        list_set(scratch, out, list_get(values, left))
        left = left + 1
        out = out + 1
    }
    while (right < high) {
        list_set(scratch, out, list_get(values, right))
        right = right + 1
        out = out + 1
    }
    let mut i = low
    while (i < high) {
        list_set(values, i, list_get(scratch, i))
        i = i + 1
    }
}

public fn benchMergesort(scale: Int) -> Int {
    let n = 25000 * scale
    let mut values: Vec<Int> = list_new_with_capacity(n)
    let mut scratch: Vec<Int> = list_new_with_capacity(n)
    let mut seed = 19
    let mut i = 0
    while (i < n) {
        seed = benchRandom(seed)
        list_push(values, seed)
        list_push(scratch, 0)
        i = i + 1
    }
    benchMergeRange(values, scratch, 0, n)
    let mut checksum = 0
    let mut k = 0
    while (k < n) {
        checksum = (checksum + list_get(values, k)) % 1000000007
        k = k + 97
    }
    return checksum + list_get(values, n - 1)
}

public fn benchStringSearch(scale: Int) -> Int {
    let text = "alpha beta gamma delta needle omega ".repeat(2000 * scale)
    let mut from = 0
    let mut count = 0
    let mut positions = 0
    loop {
        let at = text.indexOf("needle", from)
        if (at < 0) { break }
        count = count + 1
        positions = (positions + at) % 1000000007
        from = at + 6
    }
    return positions + count
}

public fn benchGraphBfs(scale: Int) -> Int {
    let width = 120 * scale
    let total = width * width
    let mut seen: Vec<Bool> = list_new_with_capacity(total)
    let mut queue: Vec<Int> = list_new_with_capacity(total)
    let mut i = 0
    while (i < total) {
        list_push(seen, false)
        i = i + 1
    }
    list_push(queue, 0)
    list_set(seen, 0, true)
    let mut head = 0
    let mut checksum = 0
    while (head < list_len(queue)) {
        let node = list_get(queue, head)
        head = head + 1
        checksum = (checksum + node) % 1000000007
        let x = node % width
        let y = node / width
        if (x > 0) {
            let next = node - 1
            if (list_get(seen, next) == false) {
                list_set(seen, next, true)
                list_push(queue, next)
            }
        }
        if (x + 1 < width) {
            let next = node + 1
            if (list_get(seen, next) == false) {
                list_set(seen, next, true)
                list_push(queue, next)
            }
        }
        if (y > 0) {
            let next = node - width
            if (list_get(seen, next) == false) {
                list_set(seen, next, true)
                list_push(queue, next)
            }
        }
        if (y + 1 < width) {
            let next = node + width
            if (list_get(seen, next) == false) {
                list_set(seen, next, true)
                list_push(queue, next)
            }
        }
    }
    return checksum + head
}

public fn benchKnapsack(scale: Int) -> Int {
    let capacity = 800 * scale
    let items = 180
    let mut best: Vec<Int> = list_new_with_capacity(capacity + 1)
    let mut c = 0
    while (c <= capacity) {
        list_push(best, 0)
        c = c + 1
    }
    let mut i = 1
    while (i <= items) {
        let weight = (i * 37) % 97 + 1
        let value = (i * 53) % 211 + 1
        let mut at = capacity
        while (at >= weight) {
            // The same statement the other two arms write, now spelled the same
            // way as well:
            //
            //   C++   best[at] = std::max(best[at], best[at - weight] + value);
            //   Rust  best[at] = best[at].max(best[at - weight] + value);
            //
            // `max` is `std.math`'s, over `llvm.smax.i32`. An *unconditional*
            // store is the load-bearing part -- this was an `if (candidate > ...)
            // { list_set(...) }`, which is a different program from the other two
            // and vectorises in none of the three languages. Written this way the
            // loop emits 22 NEON ops and four elements per iteration, the same as
            // C++.
            list_set(best, at, max(list_get(best, at), list_get(best, at - weight) + value))
            at = at - 1
        }
        i = i + 1
    }
    return list_get(best, capacity)
}

public fn benchBuildTree(depth: Int, seed: Int) -> BenchTree {
    if (depth == 0) { return BenchTree.Empty }
    return BenchTree.Node(benchBuildTree(depth - 1, seed * 2), seed,
                          benchBuildTree(depth - 1, seed * 2 + 1))
}

public fn benchTreeSum(tree: BenchTree) -> Int {
    match (tree) {
        BenchTree.Empty => { return 0 }
        BenchTree.Node(left, value, right) => {
            return (benchTreeSum(left) + value + benchTreeSum(right)) % 1000000007
        }
    }
    return 0
}

public fn benchTreeTraversal(scale: Int) -> Int {
    let depth = 13 + scale / 4
    let tree = benchBuildTree(depth, 1)
    let mut checksum = 0
    let mut i = 0
    while (i < 8 * scale) {
        checksum = (checksum + benchTreeSum(tree)) % 1000000007
        i = i + 1
    }
    return checksum
}

struct BenchHeapHandle {
    size: Int
}

// The heap the other two arms get from their standard libraries, written out:
// libc++'s `push_heap`/`pop_heap` and Rust's `BinaryHeap` both move a hole rather
// than swapping, and both pop by Floyd's method -- walk the hole to a leaf along
// the smaller child, one comparison per level, then sift the displaced last
// element up. The first version here swapped at every level and compared both
// children against the parent, which is a different algorithm with about twice
// the comparisons.
public fn benchHeapPush(data: Vec<I64>, h: BenchHeapHandle, val: I64) {
    if (h.size < list_len(data)) {
        list_set(data, h.size, val)
    } else {
        list_push(data, val)
    }
    let mut hole = h.size
    h.size = h.size + 1
    while (hole > 0) {
        let parent = (hole - 1) / 2
        let above = list_get(data, parent)
        if (val < above) {
            list_set(data, hole, above)
            hole = parent
        } else {
            break
        }
    }
    list_set(data, hole, val)
}

public fn benchHeapPop(data: Vec<I64>, h: BenchHeapHandle) -> I64 {
    let top = list_get(data, 0)
    h.size = h.size - 1
    let n = h.size
    if (n == 0) { return top }
    let last = list_get(data, n)
    let mut hole = 0
    let mut child = 1
    while (child < n) {
        if (child + 1 < n and list_get(data, child + 1) < list_get(data, child)) {
            child = child + 1
        }
        list_set(data, hole, list_get(data, child))
        hole = child
        child = 2 * hole + 1
    }
    while (hole > 0) {
        let parent = (hole - 1) / 2
        let above = list_get(data, parent)
        if (last < above) {
            list_set(data, hole, above)
            hole = parent
        } else {
            break
        }
    }
    list_set(data, hole, last)
    return top
}

public fn benchDijkstraShortestPath(scale: Int) -> Int {
    let vCount = 1000 * scale
    let eCount = vCount + 5000 * scale

    let mut head: Vec<Int> = list_new_with_capacity(vCount)
    let mut vi = 0
    while (vi < vCount) {
        list_push(head, -1)
        vi = vi + 1
    }

    let mut edgeTo: Vec<Int> = list_new_with_capacity(eCount)
    let mut edgeWeight: Vec<Int> = list_new_with_capacity(eCount)
    let mut edgeNext: Vec<Int> = list_new_with_capacity(eCount)
    let mut ei = 0
    while (ei < eCount) {
        list_push(edgeTo, 0)
        list_push(edgeWeight, 0)
        list_push(edgeNext, 0)
        ei = ei + 1
    }

    let mut edgeIdx = 0
    let mut ri = 0
    while (ri < vCount) {
        list_set(edgeTo, edgeIdx, (ri + 1) % vCount)
        list_set(edgeWeight, edgeIdx, (ri % 30) + 1)
        list_set(edgeNext, edgeIdx, list_get(head, ri))
        list_set(head, ri, edgeIdx)
        edgeIdx = edgeIdx + 1
        ri = ri + 1
    }

    let mut seed = 47
    while (edgeIdx < eCount) {
        seed = benchRandom(seed)
        let u = seed % vCount
        seed = benchRandom(seed)
        let v = seed % vCount
        seed = benchRandom(seed)
        let w = (seed % 50) + 1

        list_set(edgeTo, edgeIdx, v)
        list_set(edgeWeight, edgeIdx, w)
        list_set(edgeNext, edgeIdx, list_get(head, u))
        list_set(head, u, edgeIdx)
        edgeIdx = edgeIdx + 1
    }

    let inf = 1000000000
    let mut dist: Vec<Int> = list_new_with_capacity(vCount)
    let mut di = 0
    while (di < vCount) {
        list_push(dist, inf)
        di = di + 1
    }
    list_set(dist, 0, 0)

    let mut heap: Vec<I64> = list_new_with_capacity(eCount)
    let h = BenchHeapHandle { size: 0 }
    benchHeapPush(heap, h, 0 as I64)

    while (h.size > 0) {
        let top = benchHeapPop(heap, h)
        let d = (top >> (32 as I64)) as Int
        let u = (top & (4294967295 as I64)) as Int

        if (d <= list_get(dist, u)) {
            let mut e = list_get(head, u)
            while (e != -1) {
                let v = list_get(edgeTo, e)
                let alt = d + list_get(edgeWeight, e)
                if (alt < list_get(dist, v)) {
                    list_set(dist, v, alt)
                    let entry = ((alt as I64) << (32 as I64)) | ((v as I64) & (4294967295 as I64))
                    benchHeapPush(heap, h, entry)
                }
                e = list_get(edgeNext, e)
            }
        }
    }

    let mut checksum: I64 = 0
    let mut i = 0
    while (i < vCount) {
        let d = list_get(dist, i)
        if (d < inf) {
            let term = ((d as I64) * ((i % 100 + 1) as I64)) % 1000000007
            checksum = (checksum + term) % 1000000007
        }
        i = i + 1
    }

    return checksum as Int
}

public fn benchLz4Compress(scale: Int) -> Int {
    let n = 20000 * scale
    // Bytes, as the other two arms compress: a `Vec<Int>` here was four times the
    // input they read, which took the Prismio arm's working set out of L1.
    let mut input: Vec<U8> = list_new_with_capacity(n)

    let mut seed = 83
    let mut i = 0
    while (i < n) {
        seed = benchRandom(seed)
        if (i > 20 and (seed % 4) == 0) {
            let offset = 12 + (seed % 8)
            list_push(input, list_get(input, i - offset))
        } else {
            list_push(input, (32 + (seed % 95)) as U8)
        }
        i = i + 1
    }

    let mut table: Vec<Int> = list_new_with_capacity(4096)
    let mut ti = 0
    while (ti < 4096) {
        list_push(table, -1)
        ti = ti + 1
    }

    let mut pos = 0
    let mut tokenCount = 0
    let mut literalLen = 0
    let mut checksum: I64 = 0

    while (pos + 4 <= n) {
        let b0 = list_get(input, pos) as Int
        let b1 = list_get(input, pos + 1) as Int
        let b2 = list_get(input, pos + 2) as Int
        let b3 = list_get(input, pos + 3) as Int

        let h = ((b0 << 12) ^ (b1 << 8) ^ (b2 << 4) ^ b3) % 4096
        let refPos = list_get(table, h)
        list_set(table, h, pos)

        if (refPos != -1 and (pos - refPos) < 65535 and
            (list_get(input, refPos) as Int) == b0 and (list_get(input, refPos + 1) as Int) == b1 and
            (list_get(input, refPos + 2) as Int) == b2 and (list_get(input, refPos + 3) as Int) == b3) {

            let mut matchLen = 4
            while (pos + matchLen < n and list_get(input, pos + matchLen) == list_get(input, refPos + matchLen) and matchLen < 255) {
                matchLen = matchLen + 1
            }

            let offset = pos - refPos
            let term: I64 = (literalLen * 10007 + matchLen * 31 + offset) as I64
            checksum = (checksum * 31 + term) % 1000000007
            tokenCount = tokenCount + 1
            literalLen = 0
            pos = pos + matchLen
        } else {
            literalLen = literalLen + 1
            pos = pos + 1
        }
    }

    checksum = (checksum + (tokenCount as I64) + (literalLen as I64)) % 1000000007
    return checksum as Int
}

struct BenchSeedHolder {
    val: Int
}

struct BenchPosHolder {
    val: Int
}

public fn benchBuildOneExpr(depth: Int, s: BenchSeedHolder) -> String {
    if (depth <= 0) {
        s.val = benchRandom(s.val)
        return ((s.val % 100) + 1).toString()
    }
    s.val = benchRandom(s.val)
    let opIdx = s.val % 3
    let mut opStr = "+"
    if (opIdx == 1) { opStr = "-" }
    else if (opIdx == 2) { opStr = "*" }
    let left = benchBuildOneExpr(depth - 1, s)
    let right = benchBuildOneExpr(depth - 1, s)
    let inner = "(" + opStr + " " + left
    return inner + " " + right + ")"
}

public fn benchParseSExpr(text: String, p: BenchPosHolder, nodes: Vec<Int>) -> Int {
    let n = text.length()
    while (p.val < n and (text.byteAt(p.val) == 32 or text.byteAt(p.val) == 10)) {
        p.val = p.val + 1
    }
    if (p.val >= n) { return -1 }
    if (text.byteAt(p.val) == 40) { // '('
        p.val = p.val + 1
        while (p.val < n and text.byteAt(p.val) == 32) {
            p.val = p.val + 1
        }
        let opByte = text.byteAt(p.val)
        p.val = p.val + 1
        let leftIdx = benchParseSExpr(text, p, nodes)
        let rightIdx = benchParseSExpr(text, p, nodes)
        while (p.val < n and text.byteAt(p.val) == 32) {
            p.val = p.val + 1
        }
        if (p.val < n and text.byteAt(p.val) == 41) { // ')'
            p.val = p.val + 1
        }
        let nodeIdx = list_len(nodes) / 3
        list_push(nodes, opByte)
        list_push(nodes, leftIdx)
        list_push(nodes, rightIdx)
        return nodeIdx
    } else {
        let mut num = 0
        while (p.val < n and text.byteAt(p.val) >= 48 and text.byteAt(p.val) <= 57) {
            num = num * 10 + (text.byteAt(p.val) - 48)
            p.val = p.val + 1
        }
        let nodeIdx = list_len(nodes) / 3
        list_push(nodes, num)
        list_push(nodes, -1)
        list_push(nodes, -1)
        return nodeIdx
    }
}

public fn benchEvalNode(nodes: Vec<Int>, idx: Int) -> Int {
    let val = list_get(nodes, idx * 3)
    let leftIdx = list_get(nodes, idx * 3 + 1)
    if (leftIdx == -1) {
        return val
    }
    let rightIdx = list_get(nodes, idx * 3 + 2)
    let left: I64 = benchEvalNode(nodes, leftIdx) as I64
    let right: I64 = benchEvalNode(nodes, rightIdx) as I64
    if (val == 43) { return ((left + right) % 1000000007) as Int } // '+'
    if (val == 45) { return ((left - right + 1000000007) % 1000000007) as Int } // '-'
    if (val == 42) { return ((left * right) % 1000000007) as Int } // '*'
    return 0
}

public fn benchSExprParse(scale: Int) -> Int {
    let count = 400 * scale
    let s = BenchSeedHolder { val: 42 }
    let mut allText = ""
    let mut i = 0
    while (i < count) {
        allText = allText + benchBuildOneExpr(4, s) + "\n"
        i = i + 1
    }

    let nodes: Vec<Int> = list_new()
    let p = BenchPosHolder { val: 0 }
    let n = allText.length()
    let mut checksum: I64 = 0
    while (p.val < n) {
        let root = benchParseSExpr(allText, p, nodes)
        if (root >= 0) {
            let ev: I64 = benchEvalNode(nodes, root) as I64
            checksum = (checksum + ev) % 1000000007
        }
    }
    return checksum as Int
}

// The suite's only multi-phase workload: split, count, look up, sort. Every
// other benchmark measures one thing, and a whole-program memory model makes
// decisions -- escape, arena placement, element disposition -- that a
// single-phase loop cannot force into conflict. The phases share data here,
// which is the point.
//
// The vocabulary is looked up rather than iterated because a hash map's
// iteration order is a property of its hash function, and the three arms do not
// share one. Sorting the counts restores a total order the checksum can depend
// on.
public fn benchWordFrequency(scale: Int) -> Int {
    let text = "the quick brown fox jumps over the lazy dog while the fox naps ".repeat(400 * scale)
    let words = text.splitWhitespace()
    let counts: Map<String, Int> = mapNew<String, Int>()

    let mut i = 0
    let total = list_len(words)
    while (i < total) {
        let word = list_get(words, i)
        mapSet(counts, word, mapGetOr(counts, word, 0) + 1)
        i = i + 1
    }

    let vocabulary = "the quick brown fox jumps over lazy dog while naps".splitWhitespace()
    let mut tally: Vec<Int> = list_new_with_capacity(list_len(vocabulary))
    let mut v = 0
    while (v < list_len(vocabulary)) {
        list_push(tally, mapGetOr(counts, list_get(vocabulary, v), 0))
        v = v + 1
    }

    sort(tally)

    let mut checksum = mapLen(counts)
    let mut t = 0
    while (t < list_len(tally)) {
        checksum = (checksum + (t + 1) * list_get(tally, t)) % 1000000007
        t = t + 1
    }
    return checksum
}

// Comparison sort over elements whose compare is a call rather than a
// subtraction. `quicksort` and `mergesort` sort `Int`, where the comparison
// vectorises and the element move is a word; here neither is true, and each arm
// uses the unstable sort its own standard library ships.
public fn benchSortStrings(scale: Int) -> Int {
    let n = 20000 * scale
    let mut items: Vec<String> = list_new_with_capacity(n)
    let mut seed = 7
    let mut i = 0
    while (i < n) {
        seed = benchRandom(seed)
        list_push(items, "key".concat((seed % 65521).toString(), "-", (i % 977).toString()))
        i = i + 1
    }

    sort(items)

    let mut checksum = 0
    let mut k = 0
    while (k < n) {
        let word = list_get(items, k)
        checksum = (checksum + (k + 1) * (word.charAt(3) as Int)) % 1000000007
        k = k + 1
    }
    return checksum
}

// Two-dimensional dynamic programming over two strings, with rolling rows.
// `knapsack` is one-dimensional over one array; this indexes two different
// buffers and a third source string per iteration, which is the shape a
// bounds-check hoist has to survive.
public fn benchEditDistance(scale: Int) -> Int {
    let left = "kitten_sitting_flitting_knitting_".repeat(6 * scale)
    let right = "sitting_kitten_blitting_knotting_".repeat(6 * scale)
    let rows = left.length()
    let columns = right.length()
    let stride = columns + 1

    // Two rows in one flat buffer, alternating by offset. A row swap would be a
    // pointer exchange in C++ and Rust and a copy here, and a per-row copy in
    // all three would measure `memcpy` -- which `large_buffer_copy` already
    // does. Toggling an offset is the same program in every arm.
    let mut table: Vec<Int> = list_new_with_capacity(2 * stride)
    let mut fill = 0
    while (fill < 2 * stride) {
        list_push(table, 0)
        fill = fill + 1
    }
    let mut j = 0
    while (j <= columns) {
        list_set(table, j, j)
        j = j + 1
    }

    let mut i = 1
    while (i <= rows) {
        let current = (i % 2) * stride
        let previous = ((i - 1) % 2) * stride
        list_set(table, current, i)
        let leftChar = left.charAt(i - 1)
        let mut c = 1
        while (c <= columns) {
            let cost = 1 - ((leftChar == right.charAt(c - 1)) as Int)
            let deletion = list_get(table, previous + c) + 1
            let insertion = list_get(table, current + c - 1) + 1
            let substitution = list_get(table, previous + c - 1) + cost
            list_set(table, current + c, min(min(deletion, insertion), substitution))
            c = c + 1
        }
        i = i + 1
    }
    return list_get(table, (rows % 2) * stride + columns)
}
