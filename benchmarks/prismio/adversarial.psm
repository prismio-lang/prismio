fn benchSwitchDispatch(scale: Int) -> Int {
    let n = 250000 * scale
    let mut sequential: List<Int> = list_new_with_capacity(n)
    let mut randomized: List<Int> = list_new_with_capacity(n)
    let mut biased: List<Int> = list_new_with_capacity(n)
    let mut seed: I64 = 97
    let mut i = 0
    while (i < n) {
        list_push(sequential, i % 256)
        seed = benchAdversarialNext(seed)
        list_push(randomized, (seed % 256) as Int)
        if (seed % 20 == 0) {
            list_push(biased, (seed % 256) as Int)
        } else {
            list_push(biased, 7)
        }
        i = i + 1
    }

    let mut sum = 0
    let mut round = 0
    while (round < 3) {
        let mut k = 0
        while (k < n) {
            sum = (sum + benchSwitchCase(list_get(sequential, k), k % 1009)) % 1000000007
            sum = (sum + benchSwitchCase(list_get(randomized, k), k % 1009)) % 1000000007
            sum = (sum + benchSwitchCase(list_get(biased, k), k % 1009)) % 1000000007
            k = k + 1
        }
        round = round + 1
    }
    return sum
}

fn benchMemcpyMix(scale: Int) -> Int {
    let mut sizes: List<Int> = list_new_with_capacity(7)
    list_push(sizes, 2)
    list_push(sizes, 4)
    list_push(sizes, 8)
    list_push(sizes, 16)
    list_push(sizes, 64)
    list_push(sizes, 1024)
    list_push(sizes, 16384)

    let mut checksum = 0
    let mut s = 0
    while (s < list_len(sizes)) {
        let count = list_get(sizes, s)
        let mut source: List<Int> = list_new_with_capacity(count)
        let mut target: List<Int> = list_new_with_capacity(count)
        let mut i = 0
        while (i < count) {
            list_push(source, (i * 31 + count) % 4093)
            list_push(target, 0)
            i = i + 1
        }

        let repeats = (65536 / count) * scale
        let mut repeat = 0
        while (repeat < repeats) {
            let mut k = 0
            while (k < count) {
                list_set(target, k, list_get(source, k))
                k = k + 1
            }
            let targetAt = repeat % count
            list_set(target, targetAt, list_get(target, targetAt) + 1)

            let mut q = 0
            while (q < count) {
                list_set(source, q, list_get(target, q))
                q = q + 1
            }
            let sourceAt = (repeat * 3) % count
            list_set(source, sourceAt, list_get(source, sourceAt) + 1)
            repeat = repeat + 1
        }

        let mut c = 0
        while (c < count) {
            checksum = (checksum + list_get(source, c) + list_get(target, c)) % 1000000007
            c = c + 1
        }
        s = s + 1
    }
    return checksum
}

fn benchDeadKernel(value: Int) -> Int {
    let mut x = (value * 17 + 3) % 1009
    x = (x * x + 11) % 1009
    x = (x * 37 + 19) % 1009
    x = (x * x + value % 97) % 1009
    return x
}

fn benchDeadCodeElimination(scale: Int) -> Int {
    let n = 5000000 * scale
    let mut i = 0
    while (i < n) {
        let dead = benchDeadKernel(i)
        i = i + 1
    }
    return 17
}
