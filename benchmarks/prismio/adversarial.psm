import common

struct BenchAdversarialObject {
    a: Int,
    b: Int,
    c: Int,
    d: Int
}

struct BenchLayoutParticle {
    x: Int,
    y: Int,
    z: Int,
    velocity: Int,
    mass: Int
}

fn benchAdversarialNext(seed: I64) -> I64 {
    return (seed * 48271) % 2147483647
}

fn benchPointerChase(scale: Int) -> Int {
    let n = 131072 * scale
    let mut nodes: List<Int> = list_new_with_capacity(n)
    let mut values: List<Int> = list_new_with_capacity(n)
    let mut permutation: List<Int> = list_new_with_capacity(n)
    let mut i = 0
    while (i < n) {
        list_push(nodes, 0)
        list_push(values, (i * 37 + 11) % 251)
        list_push(permutation, i)
        i = i + 1
    }

    let mut seed: I64 = 1
    let mut at = n - 1
    while (at > 0) {
        seed = benchAdversarialNext(seed)
        let other = (seed % ((at + 1) as I64)) as Int
        let current = list_get(permutation, at)
        list_set(permutation, at, list_get(permutation, other))
        list_set(permutation, other, current)
        at = at - 1
    }

    let mut link = 0
    while (link < n) {
        let from = list_get(permutation, link)
        let to = list_get(permutation, (link + 1) % n)
        list_set(nodes, from, to)
        link = link + 1
    }

    let mut index = list_get(permutation, 0)
    let mut sum = 0
    let mut step = 0
    while (step < n * 8) {
        index = list_get(nodes, index)
        sum = (sum + list_get(values, index)) % 1000000007
        step = step + 1
    }
    return sum
}

fn benchRandomGather(scale: Int) -> Int {
    let n = 262144 * scale
    let mut values: List<Int> = list_new_with_capacity(n)
    let mut indices: List<Int> = list_new_with_capacity(n)
    let mut seed: I64 = 7
    let mut i = 0
    while (i < n) {
        list_push(values, (i * 53 + 17) % 4093)
        seed = benchAdversarialNext(seed)
        list_push(indices, (seed % (n as I64)) as Int)
        i = i + 1
    }

    let mut sum = 0
    let mut round = 0
    while (round < 8) {
        let mut k = 0
        while (k < n) {
            sum = (sum + list_get(values, list_get(indices, k))) % 1000000007
            k = k + 1
        }
        round = round + 1
    }
    return sum
}

fn benchBranchMispredict(scale: Int) -> Int {
    let n = 500000 * scale
    let mut conditions: List<Bool> = list_new_with_capacity(n)
    let mut a: List<Int> = list_new_with_capacity(n)
    let mut b: List<Int> = list_new_with_capacity(n)
    let mut seed: I64 = 19
    let mut i = 0
    while (i < n) {
        seed = benchAdversarialNext(seed)
        list_push(conditions, seed % 2 == 0)
        list_push(a, (i * 13 + 5) % 997)
        list_push(b, (i * 29 + 3) % 991)
        i = i + 1
    }

    let mut sum = 0
    let mut round = 0
    while (round < 6) {
        let mut k = 0
        while (k < n) {
            if (list_get(conditions, k)) {
                sum = (sum + list_get(a, k)) % 1000000007
            } else {
                sum = (sum + list_get(b, k)) % 1000000007
            }
            k = k + 1
        }
        round = round + 1
    }
    return sum
}

fn benchStridedMemory(scale: Int) -> Int {
    let n = 1048576 * scale
    let mut data: List<Int> = list_new_with_capacity(n)
    let mut strides: List<Int> = list_new_with_capacity(8)
    let mut i = 0
    while (i < n) {
        list_push(data, (i * 17 + 23) % 1009)
        i = i + 1
    }
    list_push(strides, 1)
    list_push(strides, 2)
    list_push(strides, 4)
    list_push(strides, 8)
    list_push(strides, 16)
    list_push(strides, 32)
    list_push(strides, 64)
    list_push(strides, 128)

    let mut sum = 0
    let mut s = 0
    while (s < list_len(strides)) {
        let stride = list_get(strides, s)
        let mut rounds = stride
        if (rounds > 16) { rounds = 16 }
        let mut round = 0
        while (round < rounds) {
            let mut at = round % stride
            while (at < n) {
                sum = (sum + list_get(data, at)) % 1000000007
                at = at + stride
            }
            round = round + 1
        }
        s = s + 1
    }
    return sum
}

fn benchMakeAdversarialObject(value: Int) -> BenchAdversarialObject {
    return BenchAdversarialObject {
        a: value,
        b: value + 1,
        c: value + 2,
        d: value + 3
    }
}

fn benchConsumeAdversarialObject(value: BenchAdversarialObject) -> Int {
    return (value.a * 3 + value.b * 5 + value.c * 7 + value.d * 11) % 1009
}

fn benchAllocationEscape(scale: Int) -> Int {
    let n = 1000000 * scale
    let mut sum = 0
    let mut i = 0
    while (i < n) {
        let value = benchMakeAdversarialObject(i % 1000)
        sum = (sum + benchConsumeAdversarialObject(value)) % 1000000007
        i = i + 1
    }
    return sum
}

fn benchTinyAdd(a: Int, b: Int) -> Int {
    return a + b
}

fn benchFunctionCallOverhead(scale: Int) -> Int {
    let n = 5000000 * scale
    let mut state = 0
    let mut i = 0
    while (i < n) {
        state = benchTinyAdd(state, i % 97)
        if (state >= 1000000007) { state = state - 1000000007 }
        i = i + 1
    }
    return state
}

fn benchIndirectAdd(value: Int) -> Int { return value + 3 }
fn benchIndirectMul(value: Int) -> Int { return value * 3 + 1 }
fn benchIndirectXor(value: Int) -> Int { return value ^ 341 }
fn benchIndirectMix(value: Int) -> Int { return (value * 17 + 23) % 1009 }

fn benchIndirectDispatch(operation: Int, value: Int) -> Int {
    if (operation == 0) { return benchIndirectAdd(value) }
    if (operation == 1) { return benchIndirectMul(value) }
    if (operation == 2) { return benchIndirectXor(value) }
    return benchIndirectMix(value)
}

fn benchIndirectCalls(scale: Int) -> Int {
    let n = 262144 * scale
    let mut operations: List<Int> = list_new_with_capacity(n)
    let mut seed: I64 = 37
    let mut i = 0
    while (i < n) {
        seed = benchAdversarialNext(seed)
        list_push(operations, (seed % 4) as Int)
        i = i + 1
    }

    let mut sum = 0
    let mut round = 0
    while (round < 8) {
        let mut k = 0
        while (k < n) {
            sum = (sum + benchIndirectDispatch(list_get(operations, k), k % 1000)) % 1000000007
            k = k + 1
        }
        round = round + 1
    }
    return sum
}

fn benchDependencyChain(scale: Int) -> Int {
    let n = 5000000 * scale
    let mut state: U32 = 123456789 as U32
    let mut i = 0
    while (i < n) {
        state = state * (1664525 as U32) + (1013904223 as U32)
        i = i + 1
    }
    return (state & (2147483647 as U32)) as Int
}

fn benchAosVsSoa(scale: Int) -> Int {
    let n = 100000 * scale
    let rounds = 20
    let mut particles: List<BenchLayoutParticle> = list_new_with_capacity(n)
    let mut i = 0
    while (i < n) {
        list_push(particles, BenchLayoutParticle {
            x: i % 1009,
            y: i % 509,
            z: i % 257,
            velocity: i % 17 + 1,
            mass: i % 31 + 1
        })
        i = i + 1
    }

    let mut round = 0
    while (round < rounds) {
        let mut k = 0
        while (k < n) {
            let particle = list_get(particles, k)
            particle.x = particle.x + particle.velocity
            particle.y = particle.y + particle.mass
            particle.z = particle.z + particle.velocity + particle.mass
            k = k + 1
        }
        round = round + 1
    }

    let mut aos = 0
    let mut a = 0
    while (a < n) {
        let particle = list_get(particles, a)
        aos = (aos + particle.x + particle.y + particle.z) % 1000000007
        a = a + 1
    }

    let mut x: List<Int> = list_new_with_capacity(n)
    let mut y: List<Int> = list_new_with_capacity(n)
    let mut z: List<Int> = list_new_with_capacity(n)
    let mut velocity: List<Int> = list_new_with_capacity(n)
    let mut mass: List<Int> = list_new_with_capacity(n)
    let mut q = 0
    while (q < n) {
        list_push(x, q % 1009)
        list_push(y, q % 509)
        list_push(z, q % 257)
        list_push(velocity, q % 17 + 1)
        list_push(mass, q % 31 + 1)
        q = q + 1
    }

    let mut soaRound = 0
    while (soaRound < rounds) {
        let mut k = 0
        while (k < n) {
            list_set(x, k, list_get(x, k) + list_get(velocity, k))
            list_set(y, k, list_get(y, k) + list_get(mass, k))
            list_set(z, k, list_get(z, k) + list_get(velocity, k) + list_get(mass, k))
            k = k + 1
        }
        soaRound = soaRound + 1
    }

    let mut soa = 0
    let mut b = 0
    while (b < n) {
        soa = (soa + list_get(x, b) + list_get(y, b) + list_get(z, b)) % 1000000007
        b = b + 1
    }
    if (aos != soa) { return -1 }
    return aos
}

