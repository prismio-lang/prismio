import common
import std.mem
import std.string

struct BenchMemoryParticle {
    x: Float,
    y: Float,
    vx: Float,
    vy: Float,
    life: Int
}

public fn benchBuildMemoryTree(depth: Int, seed: Int) -> BenchTree? {
    if (depth == 0) { return none }
    let left = benchBuildMemoryTree(depth - 1, (seed * 3 + 1) % 1009)
    let right = benchBuildMemoryTree(depth - 1, (seed * 5 + 7) % 1009)
    return BenchTree { value: seed, left: left, right: right }
}

public fn benchMemoryTreeSum(tree: BenchTree?) -> Int {
    if (tree == none) { return 0 }
    let node = expect(tree)
    return (node.value + benchMemoryTreeSum(node.left) + benchMemoryTreeSum(node.right)) % 1000000007
}

public fn benchTransientAllocation(scale: Int) -> Int {
    let rounds = 200 * scale
    let mut checksum = 0
    for r in 0..<rounds {
        let mut values: Vec<Int> = []
        for i in 0..<4000 {
            values.push((i + r) % 997)
        }
        checksum = (checksum + values[r % 4000]) % 1000000007
    }
    return checksum
}

public fn benchStructCreation(scale: Int) -> Int {
    let n = 250000 * scale
    let mut particles: Vec<BenchMemoryParticle> = Vec<BenchMemoryParticle>.withCapacity(n)
    for i in 0..<n {
        particles.push(BenchMemoryParticle {
            x: i as Float, y: (i % 31) as Float, vx: 1.0, vy: 2.0, life: i % 100
        })
    }
    let mut checksum = 0
    for p in particles {
        checksum = (checksum + (p.x as Int) + p.life) % 1000000007
    }
    return checksum
}

public fn benchAllocationMutation(scale: Int) -> Int {
    let n = 100000 * scale
    let mut particles: Vec<BenchMemoryParticle> = Vec<BenchMemoryParticle>.withCapacity(n)
    for _ in 0..<n {
        particles.push(BenchMemoryParticle { x: 0.0, y: 0.0, vx: 1.0, vy: 2.0, life: 50 })
    }
    for _ in 0..<20 {
        for p in particles {
            p.x = p.x + p.vx
            p.y = p.y + p.vy
            p.life = p.life - 1
        }
    }
    let mut checksum = 0
    for p in particles {
        checksum = (checksum + (p.x as Int) + (p.y as Int) + p.life) % 1000000007
    }
    return checksum
}

public fn benchNestedCollection(scale: Int) -> Int {
    let bucketsCount = 200 * scale
    let mut buckets: Vec<BenchBucket> = Vec<BenchBucket>.withCapacity(bucketsCount)
    for b in 0..<bucketsCount {
        let mut values: Vec<Int> = Vec<Int>.withCapacity(1000)
        for i in 0..<1000 {
            values.push((b + i) % 1021)
        }
        buckets.push(BenchBucket { values: values })
    }
    let mut checksum = 0
    for bucket in buckets {
        for value in bucket.values {
            checksum = (checksum + value) % 1000000007
        }
    }
    return checksum
}

let BENCH_MOD: I32 = 1_000_000_007

public fn benchLargeBufferCopy(scale: Int) -> Int {
    let n = 500_000 * scale
    let mut source = Vec<Int>.filled(n, 0)
    let mut target = Vec<Int>.filled(n, 0)

    for i in 0..<n {
        source[i] = i % 4093
    }

    for _ in 0..<8 {
        for i in 0..<n {
            target[i] = source[i]
        }
    }

    let mut checksum = 0

    for value in target {
        checksum = (checksum + value) % BENCH_MOD
    }

    return checksum
}

// Every node visited and changed in place, as C++'s `tree_add` does through the
// `unique_ptr`s it moves and Rust's through `Option<Box<_>>`. This arm rebuilt
// the whole tree on every pass while the enum it used could not be written to,
// which is a new allocation per node per pass that the other two never make.
public fn benchTreeAdd(tree: BenchTree?, amount: Int) {
    if (tree == none) { return }
    let node = expect(tree)
    node.value = node.value + amount
    benchTreeAdd(node.left, amount)
    benchTreeAdd(node.right, amount)
}

public fn benchRecursiveTreeRebuild(scale: Int) -> Int {
    let tree = benchBuildMemoryTree(12 + scale / 4, 1)
    for _ in 0..<4 * scale {
        benchTreeAdd(tree, 1)
    }
    return benchMemoryTreeSum(tree)
}

// Owned-string construction, which nothing else in the suite measures.
// `tokenization` scans a string, `string_search` searches one and `csv_parse`
// splits one; all three read. This one *builds*, which is where an affine string
// pays: every piece is an allocation the caller owns, and the join is a second
// pass that has to size the result before it copies.
//
// A running `result = result + piece` would be a different benchmark and a worse
// one -- quadratic in all three languages, and unavailable in Prismio, which
// ships no string builder. Collecting pieces and joining once is what each
// language's library is actually for.
public fn benchStringJoin(scale: Int) -> Int {
    let n = 60000 * scale
    let mut parts: Vec<String> = Vec<String>.withCapacity(n)
    for i in 0..<n {
        parts.push("field".concat((i % 9973).toString()))
    }

    let joined = join(parts, ",")
    let length = joined.length

    let mut checksum = length % 1000000007
    for at in 0..<length step 997 {
        checksum = (checksum + (joined.charAt(at) as Int)) % 1000000007
    }
    return checksum
}

// std.mem's three tools. Each arm is the same program: C++ writes the byte order
// with memcpy and __builtin_bswap, Rust with to_be_bytes/from_be_bytes, and the
// arena and the allocation window are hand-written the same way in all three.

// Buffer's typed writes and reads: 16-byte records, big-endian but for the last
// field, encoded once and decoded eight times.
public fn benchBinaryCodec(scale: Int) -> Int {
    let n = 100_000 * scale
    let mut buf = Buffer(n * 16)
    for i in 0..<n {
        let off = i * 16
        buf.writeU16BE(off, ((i * 7) % 65536) as U16)
        buf.writeI32BE(off + 2, (i * 13) % 100000 - 50000)
        buf.writeFloatBE(off + 6, ((i % 1000) as Float) * 0.5)
        buf.writeU16LE(off + 14, (i % 251) as U16)
    }
    let mut checksum = 0
    for round in 0..<8 {
        for i in 0..<n {
            let off = i * 16
            let v = (buf.readU16BE(off) as Int) + buf.readI32BE(off + 2)
                + (buf.readFloatBE(off + 6) as Int) + (buf.readU16LE(off + 14) as Int) + round
            checksum = (checksum + v) % BENCH_MOD
        }
    }
    return checksum
}

// alloc and free in a sliding window of 64 live blocks of 16 to 256 bytes: each
// slot's block is read and freed before the slot is refilled.
public fn benchManualAllocChurn(scale: Int) -> Int {
    let n = 400_000 * scale
    let mut blocks: Array<Usize, 64>
    let mut sizes: Array<Int, 64>
    let mut checksum = 0
    for i in 0..<n {
        let slot = i % 64
        let old = blocks[slot]
        if (old != 0) {
            checksum = (checksum + (old.loadU32() as Int) + ((old + 8).loadU32() as Int) + sizes[slot]) % BENCH_MOD
            free(old)
        }
        let size = 16 + (i * 37) % 241
        let block = alloc(size as Usize)
        block.storeU32((i % 65521) as U32)
        (block + 8).storeU32(size as U32)
        blocks[slot] = block
        sizes[slot] = size
    }
    for slot in 0..<64 {
        let old = blocks[slot]
        if (old != 0) {
            checksum = (checksum + (old.loadU32() as Int)) % BENCH_MOD
            free(old)
        }
    }
    return checksum
}

// A linked list of 20,000 nodes built in an Arena, walked, and taken back with
// one reset, per round. Every sixteenth node is followed by a 5-byte piece, so
// the next node's 8-byte alignment is real work.
public fn benchArenaBump(scale: Int) -> Int {
    let mut arena = Arena(1 << 20)
    let rounds = 300 * scale
    let mut checksum = 0
    for r in 0..<rounds {
        let mut head: Usize = 0
        for i in 0..<20000 {
            let node = arena.alloc(24, 8)
            node.storeU64(head as U64)
            (node + 8).storeU32(((i + r) % 1009) as U32)
            head = node
            if (i % 16 == 0) { arena.alloc(5, 1) }
        }
        let mut at = head
        while (at != 0) {
            checksum = (checksum + ((at + 8).loadU32() as Int)) % BENCH_MOD
            at = at.loadU64() as Usize
        }
        arena.reset()
    }
    return checksum
}
