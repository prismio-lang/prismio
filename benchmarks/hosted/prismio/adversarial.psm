import common
import std.math

struct BenchAdversarialObject {
    a: Int,
    b: Int,
    c: Int,
    d: Int
}

struct BenchLayoutParticle {
    x: Int,
    y: Int,
    z: Int,
    velocity: Int,
    mass: Int
}

public fn benchAdversarialNext(seed: I64) -> I64 {
    return (seed * 48271) % 2147483647
}

public fn benchPointerChase(scale: Int) -> Int {
    let n = 131072 * scale
    let mut nodes = Vec<Int>.filled(n, 0)
    let mut values = Vec<Int>.filled(n, 0)
    let mut permutation = Vec<Int>.filled(n, 0)
    for i in 0..<n {
        values[i] = (i * 37 + 11) % 251
        permutation[i] = i
    }

    let mut seed: I64 = 1
    for at in n - 1..1 {
        seed = benchAdversarialNext(seed)
        let other = (seed % ((at + 1) as I64)) as Int
        permutation.swap(at, other)
    }
    for link in 0..<n {
        nodes[permutation[link]] = permutation[(link + 1) % n]
    }

    let mut index = permutation[0]
    let mut sum = 0
    for _ in 0..<n * 8 {
        index = nodes[index]
        sum = (sum + values[index]) % 1000000007
    }
    return sum
}

public fn benchRandomGather(scale: Int) -> Int {
    let n = 262144 * scale
    let mut values = Vec<Int>.filled(n, 0)
    let mut indices = Vec<Int>.filled(n, 0)
    let mut seed: I64 = 7
    for i in 0..<n {
        values[i] = (i * 53 + 17) % 4093
        seed = benchAdversarialNext(seed)
        indices[i] = (seed % (n as I64)) as Int
    }

    let mut sum = 0
    for _ in 0..<8 {
        for k in 0..<n {
            sum = (sum + values[indices[k]]) % 1000000007
        }
    }
    return sum
}

public fn benchBranchMispredict(scale: Int) -> Int {
    let n = 500000 * scale
    let mut conditions = Vec<Bool>.filled(n, false)
    let mut a = Vec<Int>.filled(n, 0)
    let mut b = Vec<Int>.filled(n, 0)
    let mut seed: I64 = 19
    for i in 0..<n {
        seed = benchAdversarialNext(seed)
        conditions[i] = seed % 2 == 0
        a[i] = (i * 13 + 5) % 997
        b[i] = (i * 29 + 3) % 991
    }

    let mut sum = 0
    for _ in 0..<6 {
        for k in 0..<n {
            if (conditions[k]) {
                sum = (sum + a[k]) % 1000000007
            } else {
                sum = (sum + b[k]) % 1000000007
            }
        }
    }
    return sum
}

public fn benchStridedMemory(scale: Int) -> Int {
    let n = 1048576 * scale
    let mut data = Vec<Int>.filled(n, 0)
    for i in 0..<n {
        data[i] = (i * 17 + 23) % 1009
    }
    let strides = [1, 2, 4, 8, 16, 32, 64, 128]

    let mut sum = 0
    for stride in strides {
        let rounds = min(stride, 16)
        for round in 0..<rounds {
            for at in round % stride..<n step stride {
                sum = (sum + data[at]) % 1000000007
            }
        }
    }
    return sum
}

public fn benchMakeAdversarialObject(value: Int) -> BenchAdversarialObject {
    return BenchAdversarialObject {
        a: value,
        b: value + 1,
        c: value + 2,
        d: value + 3
    }
}

public fn benchConsumeAdversarialObject(value: BenchAdversarialObject) -> Int {
    return (value.a * 3 + value.b * 5 + value.c * 7 + value.d * 11) % 1009
}

public fn benchAllocationEscape(scale: Int) -> Int {
    let n = 1000000 * scale
    let mut sum = 0
    for i in 0..<n {
        let value = benchMakeAdversarialObject(i % 1000)
        sum = (sum + benchConsumeAdversarialObject(value)) % 1000000007
    }
    return sum
}

public fn benchTinyAdd(a: Int, b: Int) -> Int {
    return a + b
}

public fn benchFunctionCallOverhead(scale: Int) -> Int {
    let n = 5000000 * scale
    let mut state = 0
    for i in 0..<n {
        state = benchTinyAdd(state, i % 97)
        if (state >= 1000000007) { state = state - 1000000007 }
    }
    return state
}

public fn benchIndirectAdd(value: Int) -> Int { return value + 3 }
public fn benchIndirectMul(value: Int) -> Int { return value * 3 + 1 }
public fn benchIndirectXor(value: Int) -> Int { return value ^ 341 }
public fn benchIndirectMix(value: Int) -> Int { return (value * 17 + 23) % 1009 }

public fn benchIndirectDispatch(operation: Int, value: Int) -> Int {
    if (operation == 0) { return benchIndirectAdd(value) }
    if (operation == 1) { return benchIndirectMul(value) }
    if (operation == 2) { return benchIndirectXor(value) }
    return benchIndirectMix(value)
}

public fn benchIndirectCalls(scale: Int) -> Int {
    let n = 262144 * scale
    let mut operations = Vec<Int>.filled(n, 0)
    let mut seed: I64 = 37
    for i in 0..<n {
        seed = benchAdversarialNext(seed)
        operations[i] = (seed % 4) as Int
    }

    let mut sum = 0
    for _ in 0..<8 {
        for k in 0..<n {
            sum = (sum + benchIndirectDispatch(operations[k], k % 1000)) % 1000000007
        }
    }
    return sum
}

public fn benchDependencyChain(scale: Int) -> Int {
    let n = 5000000 * scale
    let mut state: U32 = 123456789
    for _ in 0..<n {
        state = state * 1664525 + 1013904223
    }
    return (state & (2147483647 as U32)) as Int
}

public fn benchAosVsSoa(scale: Int) -> Int {
    let n = 100000 * scale
    let rounds = 20
    let mut particles: Vec<BenchLayoutParticle> = Vec<BenchLayoutParticle>.withCapacity(n)
    for i in 0..<n {
        particles.push(BenchLayoutParticle {
            x: i % 1009,
            y: i % 509,
            z: i % 257,
            velocity: i % 17 + 1,
            mass: i % 31 + 1
        })
    }

    for _ in 0..<rounds {
        for particle in particles {
            particle.x = particle.x + particle.velocity
            particle.y = particle.y + particle.mass
            particle.z = particle.z + particle.velocity + particle.mass
        }
    }

    let mut aos = 0
    for particle in particles {
        aos = (aos + particle.x + particle.y + particle.z) % 1000000007
    }

    let mut x: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut y: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut z: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut velocity: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut mass: Vec<Int> = Vec<Int>.withCapacity(n)
    for i in 0..<n {
        x.push(i % 1009)
        y.push(i % 509)
        z.push(i % 257)
        velocity.push(i % 17 + 1)
        mass.push(i % 31 + 1)
    }

    for _ in 0..<rounds {
        for i in 0..<n {
            x[i] = x[i] + velocity[i]
            y[i] = y[i] + mass[i]
            z[i] = z[i] + velocity[i] + mass[i]
        }
    }

    let mut soa = 0
    for i in 0..<n {
        soa = (soa + x[i] + y[i] + z[i]) % 1000000007
    }
    if (aos != soa) { return -1 }
    return aos
}

