public fn benchSwitchDispatch(scale: Int) -> Int {
    let n = 250000 * scale
    let mut sequential = Vec<Int>.filled(n, 0)
    let mut randomized = Vec<Int>.filled(n, 0)
    let mut biased = Vec<Int>.filled(n, 0)
    let mut seed: I64 = 97
    for i in 0..<n {
        sequential[i] = i % 256
        seed = benchAdversarialNext(seed)
        randomized[i] = (seed % 256) as Int
        if (seed % 20 == 0) {
            biased[i] = (seed % 256) as Int
        } else {
            biased[i] = 7
        }
    }

    let mut sum = 0
    for _ in 0..<3 {
        for k in 0..<n {
            sum = (sum + benchSwitchCase(sequential[k], k % 1009)) % 1000000007
            sum = (sum + benchSwitchCase(randomized[k], k % 1009)) % 1000000007
            sum = (sum + benchSwitchCase(biased[k], k % 1009)) % 1000000007
        }
    }
    return sum
}

public fn benchMemcpyMix(scale: Int) -> Int {
    let sizes = [2, 4, 8, 16, 64, 1024, 16384]
    let mut checksum = 0
    for count in sizes {
        let mut source = Vec<Int>.filled(count, 0)
        let mut target = Vec<Int>.filled(count, 0)
        for i in 0..<count {
            source[i] = (i * 31 + count) % 4093
        }

        let repeats = (65536 / count) * scale
        for repeat in 0..<repeats {
            for k in 0..<count { target[k] = source[k] }
            target[repeat % count] = target[repeat % count] + 1
            for k in 0..<count { source[k] = target[k] }
            source[(repeat * 3) % count] = source[(repeat * 3) % count] + 1
        }

        for i in 0..<count {
            checksum = (checksum + source[i] + target[i]) % 1000000007
        }
    }
    return checksum
}

public fn benchDeadKernel(value: Int) -> Int {
    let mut x = (value * 17 + 3) % 1009
    x = (x * x + 11) % 1009
    x = (x * 37 + 19) % 1009
    x = (x * x + value % 97) % 1009
    return x
}

public fn benchDeadCodeElimination(scale: Int) -> Int {
    let n = 5000000 * scale
    for i in 0..<n {
        let dead = benchDeadKernel(i)
    }
    return 17
}

// Forty live 32-bit values updated in one loop body, each from three others, so the
// working set is larger than any general-purpose register file (16 on x86-64, 31 on
// AArch64) and the allocator has to choose what to keep and what to spill. Each
// update reads the value the previous line just wrote, so the body is one long
// dependent chain: the loop cannot be vectorised (the first version had independent
// updates, all three compilers vectorised it, and the three arms tied at 6.7 ms
// measuring nothing), nothing is a division and nothing is memory traffic by
// construction. What is measured is register allocation, spill code and scheduling
// of a chain. The three arms are generated from one description and differ only in
// spelling; unsigned 32-bit arithmetic wraps in all three, so no value is undefined.
public fn benchRegisterPressureTorture(scale: Int) -> Int {
    let mut s0: U32 = 40503
    let mut s1: U32 = 81006
    let mut s2: U32 = 121509
    let mut s3: U32 = 162012
    let mut s4: U32 = 202515
    let mut s5: U32 = 243018
    let mut s6: U32 = 283521
    let mut s7: U32 = 324024
    let mut s8: U32 = 364527
    let mut s9: U32 = 405030
    let mut s10: U32 = 445533
    let mut s11: U32 = 486036
    let mut s12: U32 = 526539
    let mut s13: U32 = 567042
    let mut s14: U32 = 607545
    let mut s15: U32 = 648048
    let mut s16: U32 = 688551
    let mut s17: U32 = 729054
    let mut s18: U32 = 769557
    let mut s19: U32 = 810060
    let mut s20: U32 = 850563
    let mut s21: U32 = 891066
    let mut s22: U32 = 931569
    let mut s23: U32 = 972072
    let mut s24: U32 = 1012575
    let mut s25: U32 = 1053078
    let mut s26: U32 = 1093581
    let mut s27: U32 = 1134084
    let mut s28: U32 = 1174587
    let mut s29: U32 = 1215090
    let mut s30: U32 = 1255593
    let mut s31: U32 = 1296096
    let mut s32: U32 = 1336599
    let mut s33: U32 = 1377102
