import common
import std.math


struct BenchParticle {
    x: Float,
    y: Float,
    vx: Float,
    vy: Float,
    life: Int
}

public fn benchMatrixMultiply(scale: Int) -> Int {
    let n = 32 * scale
    let count = n * n
    let mut a = Vec<Int>.filled(count, 0)
    let mut b = Vec<Int>.filled(count, 0)
    let mut c = Vec<Int>.filled(count, 0)
    for i in 0..<count {
        a[i] = (i * 17) % 101
        b[i] = (i * 29) % 103
    }
    for row in 0..<n {
        for col in 0..<n {
            let mut sum = 0
            for k in 0..<n {
                sum = (sum + a[row * n + k] * b[k * n + col]) % 1000000007
            }
            c[row * n + col] = sum
        }
    }
    let mut checksum = 0
    for value in c {
        checksum = (checksum + value) % 1000000007
    }
    return checksum
}

public fn benchMandelbrot(scale: Int) -> Int {
    let side = 96 * scale
    let mut inside = 0
    for py in 0..<side {
        let cy = (py as Float) * 2.0 / (side as Float) - 1.0
        for px in 0..<side {
            let cx = (px as Float) * 3.0 / (side as Float) - 2.0
            let mut x = 0.0
            let mut y = 0.0
            let mut iter = 0
            while (x * x + y * y <= 4.0 and iter < 60) {
                let nextX = x * x - y * y + cx
                y = 2.0 * x * y + cy
                x = nextX
                iter = iter + 1
            }
            if (iter == 60) { inside = inside + 1 }
        }
    }
    return inside
}

public fn benchFftTransform(inout real: Vec<Float>, inout imag: Vec<Float>, n: Int) {
    let mut j = 0
    for i in 1..<n {
        let mut bit = n / 2
        while (j >= bit) {
            j = j - bit
            bit = bit / 2
        }
        j = j + bit
        if (i < j) {
            let realSwap = real[i]
            let imagSwap = imag[i]
            real[i] = real[j]
            imag[i] = imag[j]
            real[j] = realSwap
            imag[j] = imagSwap
        }
    }

    let mut length = 2
    while (length <= n) {
        let angle = -6.283185307179586 / (length as Float)
        let stepReal = cos(angle)
        let stepImag = sin(angle)
        let half = length / 2
        for block in 0..<n step length {
            let mut weightReal = 1.0
            let mut weightImag = 0.0
            for offset in 0..<half {
                let left = block + offset
                let right = left + half
                let rightReal = real[right]
                let rightImag = imag[right]
                let valueReal = rightReal * weightReal - rightImag * weightImag
                let valueImag = rightReal * weightImag + rightImag * weightReal
                let leftReal = real[left]
                let leftImag = imag[left]
                real[left] = leftReal + valueReal
                imag[left] = leftImag + valueImag
                real[right] = leftReal - valueReal
                imag[right] = leftImag - valueImag
                let nextReal = weightReal * stepReal - weightImag * stepImag
                weightImag = weightReal * stepImag + weightImag * stepReal
                weightReal = nextReal
            }
        }
        length = length * 2
    }
}

public fn benchFft(scale: Int) -> Int {
    let mut n = 1024 * scale
    if (scale == 12) { n = 16384 }
    let rounds = 20 * scale
    let mut real = Vec<Float>.filled(n, 0.0)
    let mut imag = Vec<Float>.filled(n, 0.0)
    let mut checksum = 0
    for _ in 0..<rounds {
        for k in 0..<n { real[k] = 1.0 }
        for k in 0..<n { imag[k] = 0.0 }
        benchFftTransform(real, imag, n)
        checksum = checksum + (real[0] as Int)
    }
    return checksum
}

public fn benchNumericalIntegration(scale: Int) -> Int {
    let steps = 1000000 * scale
    let width = 1.0 / (steps as Float)
    let mut sum = 0.0
    for i in 0..<steps {
        let x = ((i as Float) + 0.5) * width
        sum = sum + (4.0 / (1.0 + x * x))
    }
    return (sum * width * 100000000.0) as Int
}

public fn benchVectorDot(scale: Int) -> Int {
    let n = 1000000 * scale
    let mut a: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut b: Vec<Int> = Vec<Int>.withCapacity(n)
    for i in 0..<n {
        a.push(i % 101)
        b.push((i * 3) % 103)
    }
    let mut sum = 0
    for i in 0..<n {
        sum = (sum + a[i] * b[i]) % 1000000007
    }
    return sum
}

public fn benchConvolution(scale: Int) -> Int {
    let n = 300000 * scale
    let mut input = Vec<Int>.filled(n, 0)
    let mut output = Vec<Int>.filled(n, 0)
    for i in 0..<n {
        input[i] = i % 251
    }
    for at in 3..<n - 3 {
        let value = input[at - 3] + 2 * input[at - 2]
            + 3 * input[at - 1] + 4 * input[at]
            + 3 * input[at + 1] + 2 * input[at + 2]
            + input[at + 3]
        output[at] = value
    }
    let mut checksum = 0
    for value in output {
        checksum = (checksum + value) % 1000000007
    }
    return checksum
}

public fn benchMonteCarlo(scale: Int) -> Int {
    let samples = 2000000 * scale
    let mut seed = 31
    let mut inside = 0
    for _ in 0..<samples {
        seed = benchRandom(seed)
        let x = seed % 10000
        seed = benchRandom(seed)
        let y = seed % 10000
        if (x * x + y * y <= 100000000) { inside = inside + 1 }
    }
    return inside
}

public fn benchPolynomial(scale: Int) -> Int {
    let evaluations = 2000000 * scale
    let coefficients = [5, 7, 11, 13, 17]
    let mut checksum = 0
    for i in 0..<evaluations {
        let x = i % 97
        let mut value = 3
        for coefficient in coefficients {
            value = (value * x + coefficient) % 1000003
        }
        checksum = (checksum + value) % 1000000007
    }
    return checksum
}

public fn benchEcsUpdate(scale: Int) -> Int {
    let n = 50000 * scale
    let rounds = 20
    let mut particles: Vec<BenchParticle> = Vec<BenchParticle>.withCapacity(n)
    for i in 0..<n {
        particles.push(BenchParticle {
            x: (i % 1000) as Float, y: (i % 500) as Float,
            vx: ((i % 7) + 1) as Float, vy: ((i % 11) + 1) as Float,
            life: 100
        })
    }
    for _ in 0..<rounds {
        for p in particles {
            p.x = p.x + p.vx * 0.016
            p.y = p.y + p.vy * 0.016
            p.life = p.life - 1
        }
    }
    let mut checksum = 0
    for p in particles {
        checksum = (checksum + (p.x as Int) + (p.y as Int) + p.life) % 1000000007
    }
    return checksum
}

public fn benchBandSum(band: BenchBand) -> Int {
    let mut state = band.seed
    let mut sum = 0
    for _ in 0..<band.steps {
        state = benchRandom(state)
        sum = (sum + state) % 1000000007
    }
    return sum
}

public fn benchParallelReduction(scale: Int) -> Int {
    let steps = 500000 * scale
    let w0 = spawn benchBandSum(BenchBand { seed: 1, steps: steps })
    let w1 = spawn benchBandSum(BenchBand { seed: 101, steps: steps })
    let w2 = spawn benchBandSum(BenchBand { seed: 1001, steps: steps })
    let w3 = spawn benchBandSum(BenchBand { seed: 10001, steps: steps })
    return (((join w0 + join w1) % 1000000007) + ((join w2 + join w3) % 1000000007)) % 1000000007
}

public fn rotR(x: U32, n: Int) -> U32 {
    return (x >> n) | (x << (32 - n))
}

public fn benchSha256(scale: Int) -> Int {
    let mut h0: U32 = 1779033703 as U32
    let mut h1: U32 = 3144134277 as U32
    let mut h2: U32 = 1013904242 as U32
    let mut h3: U32 = 2773480762 as U32
    let mut h4: U32 = 1359893119 as U32
    let mut h5: U32 = 2600822924 as U32
    let mut h6: U32 = 528734635 as U32
    let mut h7: U32 = 1541459225 as U32

    // C++'s `static const uint32_t K[64]` and `uint32_t w[64]`: a constant table
    // and a frame array, where this arm built K with 64 pushes on every run and
    // kept w in a Vec.
    let k: [U32] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    let totalBlocks = 200 * scale
    let mut seed = 42
    let mut w: Array<U32, 64>

    for _ in 0..<totalBlocks {
        for i in 0..<16 {
            seed = benchRandom(seed)
            let v1 = seed as U32
            seed = benchRandom(seed)
            let v2 = seed as U32
            w[i] = (v1 << 16) | v2
        }

        for t in 16..<64 {
            let s0 = rotR(w[t - 15], 7) ^ rotR(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 = rotR(w[t - 2], 17) ^ rotR(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = w[t - 16] + s0 + w[t - 7] + s1
        }

        let mut a = h0
        let mut bVal = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        let mut f = h5
        let mut g = h6
        let mut h = h7

        for step in 0..<64 {
            let s1 = rotR(e, 6) ^ rotR(e, 11) ^ rotR(e, 25)
            let ch = (e & f) ^ ((~e) & g)
            let temp1 = h + s1 + ch + k[step] + w[step]
            let s0 = rotR(a, 2) ^ rotR(a, 13) ^ rotR(a, 22)
            let maj = (a & bVal) ^ (a & c) ^ (bVal & c)
            let temp2 = s0 + maj

            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = bVal
            bVal = a
            a = temp1 + temp2
        }

        h0 = h0 + a
        h1 = h1 + bVal
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + h
    }

    let checksum = ((h0 ^ h1 ^ h2 ^ h3 ^ h4 ^ h5 ^ h6 ^ h7) & (2147483647 as U32)) as Int
    return checksum
}

// BLAKE3's G mixing step on four words of the state. `v` is the caller's array,
// written in place, as the Rust arm's `&mut [u32; 16]` and the C++ arm's
// references are.
fn blake3G(inout v: [U32], a: Int, b: Int, c: Int, d: Int, mx: U32, my: U32) {
    v[a] = v[a] + v[b] + mx
    v[d] = rotR(v[d] ^ v[a], 16)
    v[c] = v[c] + v[d]
    v[b] = rotR(v[b] ^ v[c], 12)
    v[a] = v[a] + v[b] + my
    v[d] = rotR(v[d] ^ v[a], 8)
    v[c] = v[c] + v[d]
    v[b] = rotR(v[b] ^ v[c], 7)
}

public fn benchBlake3Chunk(scale: Int) -> Int {
    let totalChunks = 300 * scale
    let mut seed = 99

    let IV: [U32] = [
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
    ]
    let MSG_PERM: [Int] = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]

    let mut totalChecksum: U32 = 0
    let mut m: Array<U32, 16>
    let mut v: Array<U32, 16>
    let mut nextM: Array<U32, 16>

    for chunk in 0..<totalChunks {
        for i in 0..<16 {
            seed = benchRandom(seed)
            let v1 = seed as U32
            seed = benchRandom(seed)
            let v2 = seed as U32
            m[i] = (v1 << 16) | v2
        }

        for i in 0..<8 {
            v[i] = IV[i]
        }
        v[8] = IV[0]
        v[9] = IV[1]
        v[10] = IV[2]
        v[11] = IV[3]
        v[12] = chunk as U32
        v[13] = 0
        v[14] = 1024
        v[15] = 0

        for _ in 0..<7 {
            blake3G(v, 0, 4, 8, 12, m[0], m[1])
            blake3G(v, 1, 5, 9, 13, m[2], m[3])
            blake3G(v, 2, 6, 10, 14, m[4], m[5])
            blake3G(v, 3, 7, 11, 15, m[6], m[7])

            blake3G(v, 0, 5, 10, 15, m[8], m[9])
            blake3G(v, 1, 6, 11, 12, m[10], m[11])
            blake3G(v, 2, 7, 8, 13, m[12], m[13])
            blake3G(v, 3, 4, 9, 14, m[14], m[15])

            for i in 0..<16 { nextM[i] = m[MSG_PERM[i]] }
            for i in 0..<16 { m[i] = nextM[i] }
        }

        let mut chunkHash: U32 = 0
        for i in 0..<8 {
            chunkHash = chunkHash ^ (v[i] ^ v[i + 8])
        }
        totalChecksum = (totalChecksum * 31 + chunkHash) & 2147483647
    }

    return totalChecksum as Int
}

struct BenchSphere {
    x: Float,
    y: Float,
    z: Float,
    r: Float,
    cr: Int,
    cg: Int,
    cb: Int
}

// C++'s `const BenchSphere spheres[4]` and Rust's array of structs. This arm
// kept the four spheres as 28 floats pushed into a Vec and read them back by
// offset, and ended the shadow loop by setting its counter past the end.
public fn benchRaytracerSphere(scale: Int) -> Int {
    let width = 50 * scale
    let height = 50 * scale

    let spheres: [BenchSphere] = [
        BenchSphere { x: 0.0, y: 0.0, z: 3.0, r: 1.0, cr: 255, cg: 30, cb: 30 },
        BenchSphere { x: 2.0, y: 1.0, z: 4.0, r: 1.0, cr: 30, cg: 255, cb: 30 },
        BenchSphere { x: -2.0, y: 1.0, z: 4.0, r: 1.0, cr: 30, cg: 30, cb: 255 },
        BenchSphere { x: 0.0, y: -1001.0, z: 0.0, r: 1000.0, cr: 200, cg: 200, cb: 200 }
    ]

    let light_x = -10.0
    let light_y = 20.0
    let light_z = -10.0
    let cam_x = 0.0
    let cam_y = 0.0
    let cam_z = -5.0

    let mut checksum: I64 = 0

    for py in 0..<height {
        let screen_y = -((((py as Float) + 0.5) / (height as Float)) * 2.0 - 1.0)
        for px in 0..<width {
            let screen_x = (((px as Float) + 0.5) / (width as Float)) * 2.0 - 1.0
            let mut dir_x = screen_x
            let mut dir_y = screen_y
            let mut dir_z = 2.0
            let inv_len = 1.0 / sqrt(dir_x * dir_x + dir_y * dir_y + dir_z * dir_z)
            dir_x = dir_x * inv_len
            dir_y = dir_y * inv_len
            dir_z = dir_z * inv_len

            let mut closest_t = 1e30
            let mut hit_idx = -1
            for s in 0..<4 {
                let oc_x = cam_x - spheres[s].x
                let oc_y = cam_y - spheres[s].y
                let oc_z = cam_z - spheres[s].z
                let b = oc_x * dir_x + oc_y * dir_y + oc_z * dir_z
                let c = (oc_x * oc_x + oc_y * oc_y + oc_z * oc_z) - spheres[s].r * spheres[s].r
                let disc = b * b - c
                if (disc > 0.0) {
                    let t = -b - sqrt(disc)
                    if (t > 0.001 and t < closest_t) {
                        closest_t = t
                        hit_idx = s
                    }
                }
            }

            if (hit_idx >= 0) {
                let hx = cam_x + closest_t * dir_x
                let hy = cam_y + closest_t * dir_y
                let hz = cam_z + closest_t * dir_z

                let nx = (hx - spheres[hit_idx].x) / spheres[hit_idx].r
                let ny = (hy - spheres[hit_idx].y) / spheres[hit_idx].r
                let nz = (hz - spheres[hit_idx].z) / spheres[hit_idx].r

                let mut lx = light_x - hx
                let mut ly = light_y - hy
                let mut lz = light_z - hz
                let ldist = sqrt(lx * lx + ly * ly + lz * lz)
                lx = lx / ldist
                ly = ly / ldist
                lz = lz / ldist

                let sh_ox = hx + nx * 0.001
                let sh_oy = hy + ny * 0.001
                let sh_oz = hz + nz * 0.001
                let mut in_shadow = false
                for s in 0..<4 {
                    let oc_x = sh_ox - spheres[s].x
                    let oc_y = sh_oy - spheres[s].y
                    let oc_z = sh_oz - spheres[s].z
                    let b = oc_x * lx + oc_y * ly + oc_z * lz
                    let c = (oc_x * oc_x + oc_y * oc_y + oc_z * oc_z) - spheres[s].r * spheres[s].r
                    let disc = b * b - c
                    if (disc > 0.0) {
                        let t = -b - sqrt(disc)
                        if (t > 0.001 and t < ldist) {
                            in_shadow = true
                            break
                        }
                    }
                }

                let mut dot = nx * lx + ny * ly + nz * lz
                if (dot < 0.0) { dot = 0.0 }
                let mut diffuse = dot * 0.85
                if (in_shadow) { diffuse = 0.0 }
                let intensity = 0.15 + diffuse
                let mut r = ((spheres[hit_idx].cr as Float) * intensity) as Int
                let mut g = ((spheres[hit_idx].cg as Float) * intensity) as Int
                let mut b_col = ((spheres[hit_idx].cb as Float) * intensity) as Int
                if (r > 255) { r = 255 }
                if (g > 255) { g = 255 }
                if (b_col > 255) { b_col = 255 }
                let pixVal: I64 = (r as I64) * 65537 + (g as I64) * 257 + (b_col as I64)
                checksum = (checksum * 31 + pixVal) % 1000000007
            } else {
                checksum = (checksum * 31 + 17) % 1000000007
            }
        }
    }

    return checksum as Int
}

struct WorkConfig {
    count: Int
}

struct Msg {
    val: Int
}

public fn stage1(ch: Channel<Msg>, cfg: WorkConfig) -> Int {
    for i in 0..<cfg.count {
        let x = (i * 25173 + 13849) % 65521
        ch.send(Msg { val: x })
    }
    ch.close()
    return cfg.count
}

public fn stage2(in_ch: Channel<Msg>, out_ch: Channel<Msg>) -> Int {
    let mut count = 0
    loop {
        let taken = in_ch.receive()
        if (taken == none) { break }
        let msg = expect(taken)
        let x = msg.val
        let y: I64 = ((x as I64) * 17 + 31) % 1000000007
        out_ch.send(Msg { val: y as Int })
        count = count + 1
    }
    out_ch.close()
    return count
}

public fn benchChannelPipeline(scale: Int) -> Int {
    let count = 5000 * scale
    let cfg = WorkConfig { count: count }
    let ch1 = Channel<Msg>(64)
    let ch2 = Channel<Msg>(64)

    let w1 = spawn stage1(ch1.share(), cfg)
    let w2 = spawn stage2(ch1.share(), ch2.share())

    let mut checksum: I64 = 0
    loop {
        let taken = ch2.receive()
        if (taken == none) { break }
        let msg = expect(taken)
        checksum = (checksum * 31 + (msg.val as I64)) % 1000000007
    }

    let _j1 = join w1
    let _j2 = join w2
    ch1.free()
    ch2.free()

    return checksum as Int
}

// A stack machine over a decoded instruction stream: the shape of a real
// interpreter loop, which `switch_dispatch` is not. That benchmark branches on a
// value; this one carries a stack across iterations, so the dispatch and the
// data traffic are dependent and the branch predictor sees a trace rather than a
// distribution.
//
// Stack values are reduced modulo 46337 because 46336 squared is the largest
// product that fits a signed 32-bit int. Prismio's `Int` wraps on overflow and
// C++'s signed overflow is undefined, so an arm that promoted to 64 bits to stay
// defined would be a different program -- which is how the first version of this
// benchmark was caught, by the three checksums disagreeing.
//
// Instructions are two parallel Int arrays rather than a payload enum, because
// the three arms have to be the same program: an enum with payloads, a
// `std::variant` and a tagged struct have three different representations, and
// the difference would be measured instead of the interpreter.
public fn benchBytecodeInterpreter(scale: Int) -> Int {
    let program = 4096
    let mut ops: Vec<Int> = Vec<Int>.withCapacity(program)
    let mut args: Vec<Int> = Vec<Int>.withCapacity(program)
    let mut seed = 11
    for _ in 0..<program {
        seed = benchRandom(seed)
        ops.push(seed % 6)
        args.push((seed % 251) + 1)
    }

    let mut stack = Vec<Int>.filled(64, 0)
    let mut accumulator = 0
    let mut top = 0
    let rounds = 900 * scale
    for _ in 0..<rounds {
        // A `while`, as C++'s `for` is in effect: the skip instruction advances
        // `pc` inside the body, which a range loop's variable cannot do.
        let mut pc = 0
        while (pc < program) {
            let op = ops[pc]
            let argument = args[pc]
            if (op == 0) {
                if (top < 63) {
                    stack[top] = argument
                    top = top + 1
                }
            } else if (op == 1) {
                if (top > 1) {
                    let b = stack[top - 1]
                    let a = stack[top - 2]
                    stack[top - 2] = (a + b) % 46337
                    top = top - 1
                }
            } else if (op == 2) {
                if (top > 1) {
                    let b = stack[top - 1]
                    let a = stack[top - 2]
                    stack[top - 2] = (a * b) % 46337
                    top = top - 1
                }
            } else if (op == 3) {
                if (top > 0) {
                    top = top - 1
                    accumulator = (accumulator + stack[top]) % 1000000007
                }
            } else if (op == 4) {
                if (top > 0) {
                    let value = stack[top - 1]
                    stack[top - 1] = (value ^ argument) % 46337
                }
            } else {
                if (top > 0 and stack[top - 1] % 2 == 0) {
                    pc = pc + 1
                }
            }
            pc = pc + 1
        }
    }
    return (accumulator + top) % 1000000007
}
