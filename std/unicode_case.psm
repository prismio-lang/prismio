// The part-th scalar `scalar` maps to in `kind`, or -1 past the end of it.
private fn unicodeCaseMapped(kind: Int, scalar: Int, part: Int) -> Int {
    let delta = unicodeCaseDelta(kind, scalar)
    if (delta == unicodeCaseMultiple()) { return unicodeCaseException(kind, scalar, part) }
    if (part == 0) { return scalar + delta }
    return 0 - 1
}

// Full lowercase mapping, SpecialCasing over UnicodeData.
public fn unicodeLowercase(scalar: Int, part: Int) -> Int { return unicodeCaseMapped(0, scalar, part) }

// Full titlecase mapping, SpecialCasing over UnicodeData.
public fn unicodeTitlecase(scalar: Int, part: Int) -> Int { return unicodeCaseMapped(1, scalar, part) }

// Full uppercase mapping, SpecialCasing over UnicodeData.
public fn unicodeUppercase(scalar: Int, part: Int) -> Int { return unicodeCaseMapped(2, scalar, part) }

// Full case folding: CaseFolding.txt statuses C and F.
public fn unicodeCaseFold(scalar: Int, part: Int) -> Int { return unicodeCaseMapped(3, scalar, part) }

// The index of the row of `table` whose [first, last] holds `scalar`, or -1.
//
// A RangeTable: rows of `stride` Ints, the first two a scalar range, sorted and
// disjoint, so membership is a binary search -- about ten probes for a table of
// a thousand ranges.
private fn unicodeCaseRangeRow(table: [Int], rows: Int, stride: Int, scalar: Int) -> Int {
    let mut low = 0
    let mut high = rows - 1
    while (low <= high) {
        let mid = (low + high) / 2
        let at = mid * stride
        if (scalar < table[at]) {
            high = mid - 1
        } else if (scalar > table[at + 1]) {
            low = mid + 1
        } else {
            return mid
        }
    }
    return 0 - 1
}

