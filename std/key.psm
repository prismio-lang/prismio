// `Key` -- what a hash table needs of a type.
//
// Hashing and equality stay together because they form one semantic contract:
// equal keys must hash equal. Copying is separate. `std.map` asks for
// `K: Key + Copy`, so a type implements storage policy independently from key
// identity and an impl is responsible only for the methods written inside it.
//
// **`eq` rather than `==`.** `String ==` compares pointers and sema rejects it,
// so a map keyed on String cannot be written in terms of the operator at all.
// That is the concrete reason `std/map.psm` was an association list that refused
// String keys: without a bound, a generic `K` admitted only the operations that
// typecheck for every type, which was the operator, which was wrong for the one
// key type everybody wants.
//
// **The hash contract**: equal keys must hash equal. Unequal keys need not hash
// unequally -- that is what the probe's `eq` is for. A `hash` that returns a
// constant is correct and slow, which is the right failure mode for a trait a
// user implements by hand.

import std.string

trait Key {
    fn hash(self) -> Int
    fn eq(self, other: Self) -> Bool
}

// One fold of the high half into the low half, which is `java.util.HashMap`'s
// `spread()` and has been the default hash of the most widely deployed hash map
// in production since 2014.
//
// **It is the identity for every key below 2^16, and that is the point.** A
// bucket index is `hash & mask`, so a mix that scrambles the low bits also
// scrambles *locality*: interned ids, counters and indices are handed out
// consecutively, and consecutive keys in consecutive buckets is a table that
// prefetches. Scattering them is a 2x tax paid on every workload to buy
// collision resistance the low bits did not need.
//
// Measured on the `key_value_update` workload, probes per lookup against the
// full MurmurHash3 finalizer this replaces:
//
// | keys          | murmur3 | this |
// |---------------|--------:|-----:|
// | 0, 1, 2, ...  |    1.21 | 1.00 |
// | i * 64        |    1.21 | 1.18 |
// | i * 65536     |    1.37 | 1.00 |
// | pre-scrambled |    1.21 | 1.18 |
//
// It is never the worse of the two on probe count and it is 2x faster in time
// on all four, because 1.21 probes is what *random* placement costs and dense
// keys placed in order cost 1.00.
//
// **The fold has one pathological family and the table handles it rather than
// this function.** `i * 65537` puts the same bits in both halves, so folding
// them cancels: every key lands in bucket 0, and the table degrades to
// 7,078 probes per lookup. `mapRehash` in std/map.psm measures its own probe
// displacement and switches that map to `keyStrengthen` when it is bad, which
// is Java's tree-bin escape hatch aimed at the hash instead of the chain. That
// is also a defence this file could not offer before: a *user's* weak
// `impl Key` now gets it too, where a strong `keyMixInt` only ever protected
// the types written here.
//
// Computed in U32 because the fold needs a *logical* right shift and `>>` on a
// signed Int is arithmetic -- an arithmetic shift feeds sign bits back in. The
// result is masked to 31 bits so it is non-negative as an Int, which is what
// lets `hash(k) & mask` be an index without a second correction.
public fn keyMixInt(value: Int) -> Int {
    let h = value as U32
    return ((h ^ (h >> 16)) & 2147483647) as Int
}

// MurmurHash3's 32-bit finalizer, applied by a table to a hash it has already
// been given. Full avalanche: every input bit changes every output bit with
// probability 1/2, so no arithmetic relationship between keys survives it.
//
// Not a `Key` implementation and deliberately not one. It is the recovery path
// for a table whose keys turned out to cluster, and it costs the locality that
// makes the ordinary path fast, so it is applied to a map only after that map
// has measured its own probe displacement and found it bad.
//
// No hex literals in the language yet, so the constants are decimal:
// 2246822507 is 0x85ebca6b and 3266489909 is 0xc2b2ae35.
public fn keyStrengthen(value: Int) -> Int {
    let mut h = value as U32
    h = h ^ (h >> 16)
    h = h * 2246822507
    h = h ^ (h >> 13)
    h = h * 3266489909
    h = h ^ (h >> 16)
    return (h & 2147483647) as Int
}

// MurmurHash3's 64-bit finalizer. Mix before narrowing: discarding the upper
// word first makes distinct 64-bit ids with identical low words all collide.
// The signed spellings encode 0xff51afd7ed558ccd and 0xc4ceb9fe1a85ec53;
// arithmetic and shifts are unsigned, including for negative I64 keys.
// Reference: https://github.com/aappleby/smhasher/blob/master/src/MurmurHash3.cpp
public fn keyMixWide(value: U64) -> Int {
    let mut h = value
    h = h ^ (h >> 33)
    h = h * ((-49064778989728563 as I64) as U64)
    h = h ^ (h >> 33)
    h = h * ((-4265267296055464877 as I64) as U64)
    h = h ^ (h >> 33)
    return (h & 2147483647) as Int
}

// Lowered, not called. A key of twelve bytes or fewer is mixed from the two
// words its pair already holds and nothing is called at all; anything longer,
// and the two storage classes with no pair to read -- a view, and a short string
// on the heap -- reach `str_hash` in runtime/lang_runtime.c, which answers the
// short case identically. See `ir_str_hash` in runtime/llvm-api-backend.c.
//
// **The call was the whole cost.** Against the FNV-1a byte loop this replaced, a
// `Map<String, Int>` of 80,000 twelve-byte keys was 26% faster and a ten-word
// table of 3-5 byte keys 19% slower, even though FNV displaced five of the ten
// words to `str_hash`'s one: the byte loop inlined into `mapProbe` whole and one
// runtime call made `mapHashOf` too large to. Lowering it removes the call in
// the shape that pays for it.
public fn keyHashBytes(s: String) -> Int {
    return __builtin_string_hash(s)
}

impl Key for Int {
    fn hash(self) -> Int { return keyMixInt(self) }
    fn eq(self, other: Self) -> Bool { return self == other }
}

impl Key for I64 {
    fn hash(self) -> Int { return keyMixWide(self as U64) }
    fn eq(self, other: Self) -> Bool { return self == other }
}

impl Key for U32 {
    fn hash(self) -> Int { return keyMixInt(self as Int) }
    fn eq(self, other: Self) -> Bool { return self == other }
}

impl Key for U64 {
    fn hash(self) -> Int { return keyMixWide(self as U64) }
    fn eq(self, other: Self) -> Bool { return self == other }
}

impl Key for Usize {
    fn hash(self) -> Int { return keyMixWide(self as U64) }
    fn eq(self, other: Self) -> Bool { return self == other }
}

impl Key for Char {
    fn hash(self) -> Int { return keyMixInt((self as U8) as Int) }
    fn eq(self, other: Self) -> Bool { return self == other }
}

impl Key for Bool {
    fn hash(self) -> Int {
        if (self) { return keyMixInt(1) }
        return keyMixInt(0)
    }
    fn eq(self, other: Self) -> Bool { return self == other }
}

// The impl this whole file exists for. `strEquals` is content equality; the
// operator would compare pointers, which is why a String key was unwritable.
impl Key for String {
    fn hash(self) -> Int { return keyHashBytes(self) }
    fn eq(self, other: Self) -> Bool { return self.equals(other) }
}

// **`Float` deliberately has no impl, and that is a decision.** NaN is not equal
// to itself, so a NaN key could be inserted and never found again -- a silently
// wrong answer, which is the one failure mode v0.1's bar names. `Map<Float, V>`
// therefore fails at the instantiation with "Float does not implement `Key`",
// which is the diagnostic a user can act on.
