// Command-line arguments and subprocesses.
//
// Two externs behind the arguments, and the interesting one is `cli_arg`.
//
// **`cli_arg` allocates nothing.** It returns `prismio_argv[index]` -- a pointer
// into the block the C runtime was handed at startup -- or the static `""` when
// the index is out of range. Its contract is `alias`, which in FFI 5.2's
// vocabulary means the return is an existing value rather than a fresh
// allocation, and with no argument to alias it resolves to "static, not
// allocated". src/main.psm has always declared it correctly; every other
// declaration of it in the tree (tests/aif_tiers.psm, tests/aif_concurrency.psm)
// leaves the contract off and gets the right answer by luck, because the
// undeclared default is `borrow` and nothing frees the result either way.
//
// A `produce(free)` on it would not leak. It would hand `argv` to the
// deallocator, which is a different and much worse category of wrong, and it is
// the mistake the six `produce(free)` externs one module over invite. That is
// why `process.args[i]` returns a **copy**.

import std.string

extern fn cli_arg_count() -> Int
extern fn cli_arg(index: Int) -> String alias

extern fn execute_command(command: String borrow) -> Int
extern fn command_quote_arg(arg: String borrow) -> String produce(free)

private fn prismioStdProcessCopyInto(out: String, source: String, length: Int) {
    let mut i = 0
    while (i < length) {
        __builtin_string_put_byte(out, i, __builtin_string_byte_at(source, i))
        i = i + 1
    }
}

// The type of `process`. It holds only the argument accessor, which holds
// nothing either: every answer is the runtime's.
struct ProcessQuery {
    args: Args
}

// The command line, as the process was given it.
//
//     let name = process.args[0]
//     let mut i = 1
//     while (i < process.args.count) {
//         println(process.args[i])
//         i = i + 1
//     }
//
// **`args[0]` is the program name and `count` is `argc`**, which is what the two
// externs answer and what every other language's `argv` means. There is no
// separate "arguments after the program name" accessor to disagree with it.
//
// This replaced five functions -- `argCount`, `arg`, `argBorrowed`, `argAt` and
// `args`. `args[i]` is `at(i)`, which is the index operator's lowering target
// (src/sema/checker.psm), and `count` is an ordinary property. Both read the two
// externs directly, so neither builds a list to answer a question about one
// element.
struct Args {
}

// Uninitialised on purpose, as `platform` is. A global cannot be initialised by
// an expression -- nothing runs before `main` -- and neither of these types has
// anything to initialise.
let process: ProcessQuery

impl Args {
    // The argument at `index`, as a string the caller owns, and `""` outside
    // `[0, count)`.
    //
    // A copy rather than the pointer, so that the result obeys the same rule as
    // every other owned String and a caller cannot accidentally free `argv`. One
    // small allocation per call, on a path that runs once per program.
    //
    // **Out of range and empty answer alike**, which is the C contract and not a
    // gap: `count` is one property away, so the caller that cares can ask, and
    // the `Option` form this replaced cost every caller a `match` to serve that
    // one.
    fn at(self, index: Int) -> String {
        let source = cli_arg(index)
        let length = strLength(source)
        let out = str_with_capacity(length)
        prismioStdProcessCopyInto(out, source, length)
        return out
    }

    // `argc`, so the program name at 0 is counted.
    fn count(self) -> Int {
        return cli_arg_count()
    }
}

// True when the command ran and exited successfully. Note the inversion against
// the C, which returns 0 for success.
fn runCommand(command: String) -> Bool {
    return execute_command(command) == 0
}

// One argument, quoted for the platform's shell. Use this on anything built
// from a path or from user input before it goes into `runCommand`.
fn quoteArg(argument: String) -> String {
    return command_quote_arg(argument)
}
