// Console output lives in Prismio source. The C runtime below this module is a
// deliberately narrow ABI boundary: it writes text (and, until Float gains a
// source-level formatter, one floating-point value). The public surface is the
// two exact-type overload sets declared here.

extern fn prismio_rt_print(text: String borrow)
extern fn prismio_rt_println(text: String borrow)
extern fn prismio_rt_print_float(value: Float)
extern fn prismio_rt_println_float(value: Float)

extern fn str_concat(left: String borrow, right: String borrow) -> String produce(free)
extern fn str_from_char(value: Char) -> String produce(free)

fn prismio_std_io_decimal_digit(value: U8) -> String {
    if (value == 0) { return "0" }
    if (value == 1) { return "1" }
    if (value == 2) { return "2" }
    if (value == 3) { return "3" }
    if (value == 4) { return "4" }
    if (value == 5) { return "5" }
    if (value == 6) { return "6" }
    if (value == 7) { return "7" }
    if (value == 8) { return "8" }
    return "9"
}

// Recursion rather than a loop, and every return an allocation rather than a
// literal. Both are the same requirement: **whatever this returns, the caller
// has to be able to free.**
//
// The loop this replaced overwrote one `text` binding once per digit, and an
// assignment releases nothing (see the note over `ir_mark_droppable` in
// src/ir/stmt.psm -- a reassigned binding is deliberately never droppable,
// because leaking beats double-freeing). So every intermediate leaked, and so
// did the result, because a `String` returned across a call had no owner at all
// until `aif_owns_call_result_at_node` learned to ask whether the returns are
// accounted for. Five allocations and five leaks for a five-digit number, in
// every program that printed one.
//
// Recursion gives each intermediate its own `let`, which is a binding the drop
// analysis can see. `str_concat(digit, "")` in the base case rather than the
// digit itself is the other half: a literal is static storage, one `return` of
// one makes the whole function unowned, and `str_substring` has carried the same
// rule in the C runtime since values became affine -- *anything declared to
// return String hands back something a release can take.*
fn prismio_std_io_unsigned_integer(value: U64) -> String {
    if (value < 10) {
        return str_concat(prismio_std_io_decimal_digit(value as U8), "")
    }
    let head = prismio_std_io_unsigned_integer(value / 10)
    return str_concat(head, prismio_std_io_decimal_digit((value % 10) as U8))
}

// Both paths bind the digits and return a concat, and the symmetry is the point
// rather than an accident of the minus sign.
//
// `return prismio_std_io_unsigned_integer(...)` would be a **pass-through**: the
// string it hands back was allocated a frame further down, and
// `aif_owns_call_result_at_node` declines those, because from the call site a
// value made below is indistinguishable from one handed *down* — and freeing the
// second is a double free through whichever binding owns it there. One concat
// makes the returned string this function's own allocation, which is what lets
// the caller free it. It costs one small allocation per formatted number and
// removes every leak on the path.
fn prismio_std_io_signed_integer(value: I64) -> String {
    if (value >= 0) {
        let digits = prismio_std_io_unsigned_integer(value as U64)
        return str_concat(digits, "")
    }

    // Negate after converting to unsigned. This also handles I64.min: its
    // positive magnitude does not fit in I64, but it does fit in U64.
    let magnitude = (0 as U64) - (value as U64)
    // Bound rather than nested in the call: an owned result passed straight into
    // a parameter is a value nothing names, and nothing names it is nothing
    // frees it.
    let digits = prismio_std_io_unsigned_integer(magnitude)
    return str_concat("-", digits)
}

fn print(value: String) {
    prismio_rt_print(value)
}

fn print(value: Int) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_print(text)
}

fn print(value: I8) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_print(text)
}

fn print(value: I16) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_print(text)
}

fn print(value: I64) {
    let text = prismio_std_io_signed_integer(value)
    prismio_rt_print(text)
}

fn print(value: Isize) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_print(text)
}

fn print(value: U8) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_print(text)
}

fn print(value: U16) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_print(text)
}

fn print(value: U32) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_print(text)
}

fn print(value: U64) {
    let text = prismio_std_io_unsigned_integer(value)
    prismio_rt_print(text)
}

fn print(value: Usize) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_print(text)
}

fn print(value: Float) {
    prismio_rt_print_float(value)
}

fn print(value: Bool) {
    if (value) {
        prismio_rt_print("true")
    } else {
        prismio_rt_print("false")
    }
}

fn print(value: Char) {
    prismio_rt_print(str_from_char(value))
}

fn println(value: String) {
    prismio_rt_println(value)
}

fn println(value: Int) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_println(text)
}

fn println(value: I8) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_println(text)
}

fn println(value: I16) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_println(text)
}

fn println(value: I64) {
    let text = prismio_std_io_signed_integer(value)
    prismio_rt_println(text)
}

fn println(value: Isize) {
    let text = prismio_std_io_signed_integer(value as I64)
    prismio_rt_println(text)
}

fn println(value: U8) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_println(text)
}

fn println(value: U16) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_println(text)
}

fn println(value: U32) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_println(text)
}

fn println(value: U64) {
    let text = prismio_std_io_unsigned_integer(value)
    prismio_rt_println(text)
}

fn println(value: Usize) {
    let text = prismio_std_io_unsigned_integer(value as U64)
    prismio_rt_println(text)
}

fn println(value: Float) {
    prismio_rt_println_float(value)
}

fn println(value: Bool) {
    if (value) {
        prismio_rt_println("true")
    } else {
        prismio_rt_println("false")
    }
}

fn println(value: Char) {
    prismio_rt_println(str_from_char(value))
}
