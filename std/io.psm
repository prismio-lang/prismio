// Console output lives in Prismio source. The C runtime below this module is a
// deliberately narrow ABI boundary: it writes text (and, until Float gains a
// source-level formatter, one floating-point value). The public surface is the
// two exact-type overload sets declared here.

extern fn prismio_rt_print(text: String borrow)
extern fn prismio_rt_println(text: String borrow)
extern fn prismio_rt_eprint(text: String borrow)
extern fn prismio_rt_eprintln(text: String borrow)
extern fn prismio_rt_print_float(value: Float)
extern fn prismio_rt_println_float(value: Float)
extern fn str_with_capacity(length: Int) -> String produce(free)

// Formatting stays native and local so importing std.io does not pull the much
// larger std.string module into every console program. Each formatter allocates
// in its own frame; delegating through a String-returning wrapper would be an
// unowned pass-through under the current ownership analysis.
private fn prismioStdIoDigitCount(value: U64) -> Int {
    let mut digits = 1
    let mut remaining = value
    while (remaining >= 10) {
        remaining = remaining / 10
        digits = digits + 1
    }
    return digits
}

private fn prismioStdIoUnsignedInteger(value: U64) -> String {
    let digits = prismioStdIoDigitCount(value)
    let out = str_with_capacity(digits)
    let mut remaining = value
    let mut at = digits - 1
    loop {
        __builtin_string_put_byte(out, at, (48 + (remaining % 10) as Int) as Char)
        if (at == 0) { break }
        remaining = remaining / 10
        at = at - 1
    }
    return out
}

private fn prismioStdIoSignedInteger(value: I64) -> String {
    let negative = value < 0
    let mut magnitude = value as U64
    if (negative) { magnitude = (0 as U64) - (value as U64) }

    let digits = prismioStdIoDigitCount(magnitude)
    let mut offset = 0
    if (negative) { offset = 1 }
    let out = str_with_capacity(digits + offset)
    if (negative) { __builtin_string_put_byte(out, 0, '-') }

    let mut remaining = magnitude
    let mut at = digits + offset - 1
    loop {
        __builtin_string_put_byte(out, at, (48 + (remaining % 10) as Int) as Char)
        if (at == offset) { break }
        remaining = remaining / 10
        at = at - 1
    }
    return out
}

private fn prismioStdIoChar(value: Char) -> String {
    if (value == '\0') { return str_with_capacity(0) }
    let out = str_with_capacity(1)
    __builtin_string_put_byte(out, 0, value)
    return out
}

fn print(value: String) {
    prismio_rt_print(value)
}

fn print(value: Int) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_print(text)
}

fn print(value: I8) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_print(text)
}

fn print(value: I16) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_print(text)
}

fn print(value: I64) {
    let text = prismioStdIoSignedInteger(value)
    prismio_rt_print(text)
}

fn print(value: Isize) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_print(text)
}

fn print(value: U8) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_print(text)
}

fn print(value: U16) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_print(text)
}

fn print(value: U32) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_print(text)
}

fn print(value: U64) {
    let text = prismioStdIoUnsignedInteger(value)
    prismio_rt_print(text)
}

fn print(value: Usize) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_print(text)
}

fn print(value: Float) {
    prismio_rt_print_float(value)
}

fn print(value: Bool) {
    if (value) {
        prismio_rt_print("true")
    } else {
        prismio_rt_print("false")
    }
}

fn print(value: Char) {
    let text = prismioStdIoChar(value)
    prismio_rt_print(text)
}

fn println(value: String) {
    prismio_rt_println(value)
}

// Status and progress text belongs here rather than on stdout, so that a
// program whose stdout is a format -- a manifest, JSON diagnostics, a pipe into
// another tool -- can still say something to the person watching without
// corrupting it. Only `String` is overloaded: every other `print` overload
// exists to render a number, and no such caller has appeared for stderr.
fn eprint(value: String) {
    prismio_rt_eprint(value)
}

fn eprintln(value: String) {
    prismio_rt_eprintln(value)
}

fn println(value: Int) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_println(text)
}

fn println(value: I8) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_println(text)
}

fn println(value: I16) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_println(text)
}

fn println(value: I64) {
    let text = prismioStdIoSignedInteger(value)
    prismio_rt_println(text)
}

fn println(value: Isize) {
    let text = prismioStdIoSignedInteger(value as I64)
    prismio_rt_println(text)
}

fn println(value: U8) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_println(text)
}

fn println(value: U16) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_println(text)
}

fn println(value: U32) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_println(text)
}

fn println(value: U64) {
    let text = prismioStdIoUnsignedInteger(value)
    prismio_rt_println(text)
}

fn println(value: Usize) {
    let text = prismioStdIoUnsignedInteger(value as U64)
    prismio_rt_println(text)
}

fn println(value: Float) {
    prismio_rt_println_float(value)
}

fn println(value: Bool) {
    if (value) {
        prismio_rt_println("true")
    } else {
        prismio_rt_println("false")
    }
}

fn println(value: Char) {
    let text = prismioStdIoChar(value)
    prismio_rt_println(text)
}
