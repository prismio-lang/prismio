// Console output lives in Prismio source. Text reaches the file descriptor
// through libc's `write`: no stdio, so there is no buffer to flush, and no
// question of a line on stdout overtaking one on stderr. The public surface is the four
// variadic functions at the end, `print`, `println`, `eprint` and `eprintln`.
//
// **The write is a builtin, not an `extern fn`, because its symbol is spelled
// differently on the three platforms this ships for.** POSIX has
// `ssize_t write(int, const void*, size_t)`; the Windows CRT has
// `int _write(int, const void*, unsigned int)` and exports no `write` at all, so
// the extern spelling linked on macOS and Linux and left an undefined symbol in
// every Windows program that printed. The name and both word widths are picked
// from the target triple in the backend, exactly as `__builtin_errno`'s accessor
// is, and the program still links its C library's own entry point directly --
// there is no runtime shim in front of it.
//
// The count and the result are `Int` on every target. That is not a narrowing of
// the POSIX signature: a String's length is an i32, so no console write can ask
// for more bytes than one holds.
//
// It carries the `bytes` contract the extern declared: the callee was handed the
// count separately and never reads to a terminator, so the String's own pointer
// crosses untouched. The retry loop below advances by taking a view of what is
// left, and under the default that view would be copied -- the whole remainder,
// on every iteration -- to supply a terminator the write does not look at.

import std.float_text

internal extern fn str_with_capacity(length: Int) -> String produce(rt_free)

// A String of twelve bytes or fewer is the inline form: the bytes live in the
// pair rather than behind the pointer, so there is nothing to offset and
// `__builtin_string_view` is not available on it. Resuming is not needed there
// either -- a buffer that small is below PIPE_BUF on every descriptor type, so
// it goes out whole or not at all. EINTR still applies and reissues all of it,
// because an interrupted `write` moved no bytes.
private fn prismioStdIoWriteShort(fd: Int, text: String, total: Int) -> Int {
    loop {
        let n = __builtin_console_write(fd, text, total)
        if (n > 0) { return n }
        if (n == 0) { return 0 }
        if (__builtin_errno() != __builtin_errno_intr()) { return 0 }
    }
}

// **One `write` is not one write.** It returns how many bytes it took, and fewer
// than asked for is an ordinary outcome, not an error: on a descriptor someone
// set `O_NONBLOCK` on -- a property of the open file description, so it is
// inherited across fork/exec and shared by every dup of it -- a 4 MB print
// delivered 65,536 bytes and exited 0. Discarding the result is how that becomes
// silent truncation.
//
// A broken pipe does not arrive here at all: nothing ignores SIGPIPE, so the
// process dies of the signal exactly as `cat` does, which is what a filter
// should do.
//
// `__builtin_string_len` and not std.string's `length`: the two are the same
// O(1) read of the String pair, but the builtin is what keeps std.io from
// pulling the much larger std.string into every console program.
private fn prismioStdIoWriteAll(fd: Int, text: String) -> Int {
    let total = __builtin_string_len(text)
    if (total == 0) { return 0 }
    if (total <= 12) { return prismioStdIoWriteShort(fd, text, total) }

    let mut done = 0
    while (done < total) {
        // The view is built into the call rather than bound to a local. It
        // aliases `text` -- that is the whole point, and how the base is kept
        // alive under it -- so a `let` here raises the base's escape to Caller
        // and every caller's drop of what it handed us is declined with it.
        let n = __builtin_console_write(fd, __builtin_string_view(text, done, total - done),
                                        total - done)
        if (n > 0) {
            done = done + n
        } else if (n < 0 and __builtin_errno() == __builtin_errno_intr()) {
            // Interrupted before a byte moved; reissue what is left.
        } else {
            return done
        }
    }
    return done
}

// The two descriptors, named here rather than as module-level `let`s. A `let` at
// module scope becomes an LLVM global, and a standard-library module's globals
// follow every program that imports it -- into its debug info, and (before they
// were made module-private) into its link, where the copy the program emits and
// the copy in `stdlib/io.plib` collided.
private fn prismioStdIoOut(text: String) {
    prismioStdIoWriteAll(1, text)
}

private fn prismioStdIoErr(text: String) {
    prismioStdIoWriteAll(2, text)
}

// Formatting stays native and local for that same reason. Each formatter
// allocates in its own frame; delegating through a String-returning wrapper
// would be an unowned pass-through under the current ownership analysis.
//
// `terminator` is written into the same allocation as the digits, so `println`
// of a formatted value costs one `write` rather than two. `'\0'` means "no
// terminator", the convention prismioStdIoChar already used for an empty
// result.
private fn prismioStdIoDigitCount(value: U64) -> Int {
    let mut digits = 1
    let mut remaining = value
    while (remaining >= 10) {
        remaining = remaining / 10
        digits = digits + 1
    }
    return digits
}

private fn prismioStdIoUnsignedInteger(value: U64, terminator: Char) -> String {
    let digits = prismioStdIoDigitCount(value)
    let mut width = digits
    if (terminator != '\0') { width = digits + 1 }
    let out = str_with_capacity(width)
    if (terminator != '\0') { __builtin_string_put_byte(out, digits, terminator) }

    let mut remaining = value
    let mut at = digits - 1
    loop {
        __builtin_string_put_byte(out, at, (48 + (remaining % 10) as Int) as Char)
        if (at == 0) { break }
        remaining = remaining / 10
        at = at - 1
    }
    return out
}

private fn prismioStdIoSignedInteger(value: I64, terminator: Char) -> String {
    let negative = value < 0
    let mut magnitude = value as U64
    if (negative) { magnitude = (0 as U64) - (value as U64) }

    let digits = prismioStdIoDigitCount(magnitude)
    let mut offset = 0
    if (negative) { offset = 1 }
    let mut width = digits + offset
    if (terminator != '\0') { width = width + 1 }
    let out = str_with_capacity(width)
    if (negative) { __builtin_string_put_byte(out, 0, '-') }
    if (terminator != '\0') { __builtin_string_put_byte(out, digits + offset, terminator) }

    let mut remaining = magnitude
    let mut at = digits + offset - 1
    loop {
        __builtin_string_put_byte(out, at, (48 + (remaining % 10) as Int) as Char)
        if (at == offset) { break }
        remaining = remaining / 10
        at = at - 1
    }
    return out
}

private fn prismioStdIoChar(value: Char, terminator: Char) -> String {
    let mut width = 1
    if (value == '\0') { width = 0 }
    if (terminator != '\0') { width = width + 1 }
    let out = str_with_capacity(width)
    if (value != '\0') { __builtin_string_put_byte(out, 0, value) }
    if (terminator != '\0') { __builtin_string_put_byte(out, width - 1, terminator) }
    return out
}

// The same text `Float.toString` gives, because it is the same function:
// a value that reaches the console and one converted to a String must not
// disagree. `terminator` rides in the same allocation, as it does for the
// integers, so `println` is one `write`.
private fn prismioStdIoFloat(value: Float, terminator: Char) -> String {
    let mut buffer: Array<U8, 32>
    let n = floatFormat(value, buffer)
    let mut width = n
    if (terminator != '\0') { width = n + 1 }
    let out = str_with_capacity(width)
    for i in 0..<n {
        __builtin_string_put_byte(out, i, buffer[i] as Char)
    }
    if (terminator != '\0') { __builtin_string_put_byte(out, n, terminator) }
    return out
}

// What the console takes: every builtin that has a text, and the optional of each. A type of your
// own prints through `Display` (std.display), whose functions take whatever these do not.
//
// **Optionals are entries, not a trait.** A list of types needs no `impl` and so no import: this
// is the whole reason `import std.io` is enough to print a number, a `String?` or a mixed line.
private typelist ConsoleText {
    String, Int, I8, I16, I64, Isize, U8, U16, U32, U64, Usize, Float, Bool, Char,
    String?, Int?, I8?, I16?, I64?, Isize?, U8?, U16?, U32?, U64?, Usize?, Float?, Bool?, Char?
}

// One value to one descriptor. `terminator` is `'\0'` for none or `'\n'` for the line's end, and
// travels in the formatter's own allocation, so a `println` of one value is one `write`.
//
// The text is bound to a local and then written, as it always was: a String-returning wrapper
// around the formatter would be an unowned pass-through under the ownership analysis.
private fn prismioStdIoEmit(fd: Int, value: String, terminator: Char) {
    if (terminator == '\0') {
        prismioStdIoWriteAll(fd, value)
        return
    }
    // The argument is borrowed, so the line must be copied before it can carry a newline. The
    // copy is the cheap half: over 300k lines to /dev/null, against the `printf("%s\n")` this
    // replaced, a copy and one write was 0.93x and two writes 1.80x.
    let width = __builtin_string_len(value)
    let out = str_with_capacity(width + 1)
    let mut at = 0
    while (at < width) {
        __builtin_string_put_byte(out, at, __builtin_string_byte_at(value, at))
        at = at + 1
    }
    __builtin_string_put_byte(out, width, terminator)
    prismioStdIoWriteAll(fd, out)
}

private fn prismioStdIoEmit(fd: Int, value: Int, terminator: Char) {
    let text = prismioStdIoSignedInteger(value as I64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: I8, terminator: Char) {
    let text = prismioStdIoSignedInteger(value as I64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: I16, terminator: Char) {
    let text = prismioStdIoSignedInteger(value as I64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: I64, terminator: Char) {
    let text = prismioStdIoSignedInteger(value, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: Isize, terminator: Char) {
    let text = prismioStdIoSignedInteger(value as I64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: U8, terminator: Char) {
    let text = prismioStdIoUnsignedInteger(value as U64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: U16, terminator: Char) {
    let text = prismioStdIoUnsignedInteger(value as U64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: U32, terminator: Char) {
    let text = prismioStdIoUnsignedInteger(value as U64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: U64, terminator: Char) {
    let text = prismioStdIoUnsignedInteger(value, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: Usize, terminator: Char) {
    let text = prismioStdIoUnsignedInteger(value as U64, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: Float, terminator: Char) {
    let text = prismioStdIoFloat(value, terminator)
    prismioStdIoWriteAll(fd, text)
}

private fn prismioStdIoEmit(fd: Int, value: Bool, terminator: Char) {
    if (terminator == '\0') {
        if (value) {
            prismioStdIoWriteAll(fd, "true")
        } else {
            prismioStdIoWriteAll(fd, "false")
        }
    } else {
        if (value) {
            prismioStdIoWriteAll(fd, "true\n")
        } else {
            prismioStdIoWriteAll(fd, "false\n")
        }
    }
}

private fn prismioStdIoEmit(fd: Int, value: Char, terminator: Char) {
    let text = prismioStdIoChar(value, terminator)
    prismioStdIoWriteAll(fd, text)
}

// A `T?` shows its value, or `none`.
private fn prismioStdIoEmitNone(fd: Int, terminator: Char) {
    if (terminator == '\0') {
        prismioStdIoWriteAll(fd, "none")
    } else {
        prismioStdIoWriteAll(fd, "none\n")
    }
}

private fn prismioStdIoEmit(fd: Int, value: Int?, terminator: Char) {
    if (value == none) {
        prismioStdIoEmitNone(fd, terminator)
    } else {
        prismioStdIoEmit(fd, expect(value), terminator)
    }
}

private fn prismioStdIoEmit(fd: Int, value: I8?, terminator: Char) {
    if (value == none) {
        prismioStdIoEmitNone(fd, terminator)
    } else {
        prismioStdIoEmit(fd, expect(value), terminator)
    }
}

private fn prismioStdIoEmit(fd: Int, value: I16?, terminator: Char) {
    if (value == none) {
        prismioStdIoEmitNone(fd, terminator)
    } else {
