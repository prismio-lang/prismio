private fn prismioStdIoEmit(fd: Int, value: String?, terminator: Char) {
    if (value == none) {
        prismioStdIoEmitNone(fd, terminator)
    } else {
        prismioStdIoEmit(fd, expect(value), terminator)
    }
}

// Python's `print()` -- the line break on its own, and the obvious way to end a line a `print`
// began. A fixed overload, so it beats the variadic one: a literal and one write, with no
// instantiation made for an empty argument list.
public fn println() {
    prismioStdIoOut("\n")
}

public fn eprintln() {
    prismioStdIoErr("\n")
}

// **Any number of values, space separated.** The function is made once per call shape, `for` over
// the arguments is unrolled, and `args.length` is a constant, so `println(n)` is the one formatter
// and the one `write` it was when this was an overload per type. The last value carries the newline
// in its own allocation, as it did.
public fn print<Ts: ConsoleText>(...args: Ts) {
    let mut first = true
    for arg in args {
        if (first == false) { prismioStdIoOut(" ") }
        first = false
        prismioStdIoEmit(1, arg, '\0')
    }
}

public fn println<Ts: ConsoleText>(...args: Ts) {
    let mut remaining = args.length
    for arg in args {
        remaining = remaining - 1
        if (remaining == 0) {
            prismioStdIoEmit(1, arg, '\n')
        } else {
            prismioStdIoEmit(1, arg, '\0')
            prismioStdIoOut(" ")
        }
    }
}

// Status and progress text belongs on stderr rather than stdout, so that a program whose stdout is a
// format -- a manifest, JSON diagnostics, a pipe into another tool -- can still say something to the
// person watching without corrupting it. The set matches stdout's, type for type, because it is the
// same list.
public fn eprint<Ts: ConsoleText>(...args: Ts) {
    let mut first = true
    for arg in args {
        if (first == false) { prismioStdIoErr(" ") }
        first = false
        prismioStdIoEmit(2, arg, '\0')
    }
}

public fn eprintln<Ts: ConsoleText>(...args: Ts) {
    let mut remaining = args.length
    for arg in args {
        remaining = remaining - 1
        if (remaining == 0) {
            prismioStdIoEmit(2, arg, '\n')
        } else {
            prismioStdIoEmit(2, arg, '\0')
            prismioStdIoErr(" ")
        }
    }
}
