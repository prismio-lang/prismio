// List algorithms that need an order -- which is to say, the ones that could not
// be written before bounded generics existed.
//
// `sort` is the reason this module exists. It is the shape v0.1's bar names
// (`list.sort()`), and it is unwritable without a bound: a generic function can
// only use the operations that typecheck for *every* `T` it is instantiated at,
// and before `T: Ord` that set did not include comparison.
//
// Only `sort`, `isSorted` and `binarySearch` take short names. Every helper is
// `list*`-prefixed for the reason `std/string.psm` gives at length: there is no
// module namespacing yet, so a short unprefixed name here is claimed for every
// program that imports this file, and `listPartition` is not a name a caller
// should have to work around.

import std.ord
import std.copy

// Below this, insertion sort wins: its O(n^2) has a tiny constant and no
// partition bookkeeping. 24 is pdqsort's cut.
private fn listSortInsertionCutoff() -> Int { return 24 }

// Above this, the pivot is Tukey's ninther -- the median of three medians of
// three -- rather than one median of three.
private fn listSortNintherCutoff() -> Int { return 128 }

private fn listSwap<T>(items: List<T>, i: Int, j: Int) {
    if (i == j) { return }
    // Read both, then write both. `list_set` transfers ownership in and releases
    // nothing, so writing before both are read would leave one slot naming an
    // element the other slot also names.
    let a = list_get(items, i)
    let b = list_get(items, j)
    list_set(items, i, b)
    list_set(items, j, a)
}

// Order two elements with one comparison.
private fn listSort2<T, F>(items: List<T>, i: Int, j: Int, order: F) {
    if (order(list_get(items, j), list_get(items, i)) < 0) { listSwap(items, i, j) }
}

private fn listSort3<T, F>(items: List<T>, i: Int, j: Int, k: Int, order: F) {
    listSort2(items, i, j, order)
    listSort2(items, j, k, order)
    listSort2(items, i, j, order)
}

// `[begin, end)` by adjacent swaps.
private fn listInsertionSort<T, F>(items: List<T>, begin: Int, end: Int, order: F) {
    let mut i = begin + 1
    while (i < end) {
        let mut j = i
        while (j > begin and order(list_get(items, j - 1), list_get(items, j)) > 0) {
            listSwap(items, j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
}

// Insertion sort that gives up after eight moves, answering whether it
// finished. Run on both sides of a partition that needed no swap, which is what
// makes an already-sorted or reversed input near-linear rather than a quicksort.
private fn listPartialInsertionSort<T, F>(items: List<T>, begin: Int, end: Int, order: F) -> Bool {
    let mut moves = 0
    let mut i = begin + 1
    while (i < end) {
        let mut j = i
        while (j > begin and order(list_get(items, j - 1), list_get(items, j)) > 0) {
            listSwap(items, j - 1, j)
            j = j - 1
            moves = moves + 1
        }
        if (moves > 8) { return false }
        i = i + 1
    }
    return true
}

private fn listSiftDown<T, F>(items: List<T>, base: Int, start: Int, count: Int, order: F) {
    let mut root = start
    loop {
        let mut child = 2 * root + 1
        if (child >= count) { return }
        if (child + 1 < count
                and order(list_get(items, base + child), list_get(items, base + child + 1)) < 0) {
            child = child + 1
        }
        if (order(list_get(items, base + root), list_get(items, base + child)) >= 0) { return }
        listSwap(items, base + root, base + child)
        root = child
    }
}

// The fallback that bounds the worst case at O(n log n): taken once a range has
// produced more badly unbalanced partitions than its size's log2 allows.
private fn listHeapSort<T, F>(items: List<T>, begin: Int, end: Int, order: F) {
    let count = end - begin
    let mut start = count / 2 - 1
    while (start >= 0) {
        listSiftDown(items, begin, start, count, order)
        start = start - 1
    }
    let mut last = count - 1
    while (last > 0) {
        listSwap(items, begin, begin + last)
        listSiftDown(items, begin, 0, last, order)
        last = last - 1
    }
}

// Partition `[begin, end)` around the pivot at `begin`: smaller elements left
// of it, the rest right. Answers the pivot's final index times two, plus one
// when no element had to move.
//
// **The pivot stays in its slot until the last swap, and that is what makes it
// safe to hold.** An inline list's `list_get` can answer a value that lives in
// the list's own block; nothing below writes `begin`, so `pivot` names the same
// element for the whole scan. Both scans are bounded as well as stopped by the
// comparator, so an ordering that is not a strict weak order yields an unsorted
// permutation rather than a read past the end.
private fn listPartitionRight<T, F>(items: List<T>, begin: Int, end: Int, order: F) -> Int {
    let pivot = list_get(items, begin)
    let mut first = begin + 1
    while (first < end and order(list_get(items, first), pivot) < 0) { first = first + 1 }
    let mut last = end - 1
    while (last >= first and order(list_get(items, last), pivot) >= 0) { last = last - 1 }
    let mut untouched = 1
    if (first < last) { untouched = 0 }
    while (first < last) {
        listSwap(items, first, last)
        first = first + 1
        while (first < end and order(list_get(items, first), pivot) < 0) { first = first + 1 }
        last = last - 1
        while (last >= first and order(list_get(items, last), pivot) >= 0) { last = last - 1 }
    }
    let pivotAt = first - 1
    listSwap(items, begin, pivotAt)
    return pivotAt * 2 + untouched
}

// The same around a pivot equal to the element just left of the range: equal
// elements go left of it and are finished. Answers the pivot's final index.
private fn listPartitionLeft<T, F>(items: List<T>, begin: Int, end: Int, order: F) -> Int {
    let pivot = list_get(items, begin)
    let mut last = end - 1
    while (last > begin and order(pivot, list_get(items, last)) < 0) { last = last - 1 }
    let mut first = begin + 1
    while (first <= last and order(pivot, list_get(items, first)) >= 0) { first = first + 1 }
    while (first < last) {
        listSwap(items, first, last)
        last = last - 1
        while (last > begin and order(pivot, list_get(items, last)) < 0) { last = last - 1 }
        first = first + 1
        while (first <= last and order(pivot, list_get(items, first)) >= 0) { first = first + 1 }
    }
    listSwap(items, begin, last)
    return last
}

// Pattern-defeating quicksort (Orson Peters, 2021 -- the algorithm behind
// Rust's `sort_unstable` before ipnsort, and Go's `sort`), over `[begin, end)`.
//
// **It replaced a three-way quicksort that was pathological on ordered input.**
// Measured on 80,000 Ints: already sorted 19.3 ms against 0.14 ms, reversed
// 15.8 ms against 0.17 ms, random 4.26 ms against 3.63 ms. The two ordered
// cases are the partial insertion sort after a partition that moved nothing.
//
// Duplicates keep the property the three-way partition was chosen for: a pivot
// equal to the element left of the range (a previous pivot, so no smaller than
// anything here) takes `listPartitionLeft`, which finishes every element equal
// to it -- so an all-equal list is linear, not n^2. Unbalanced partitions (a
// side under an eighth) are counted, break patterns by swapping a few elements,
// and after `badAllowed` of them the range goes to heapsort.
//
// Recurses on the left side and loops on the right. Every level either splits
// at worst 1:7 or spends one of `badAllowed`'s log2(n) allowances, so the depth
// is O(log n) whatever the input does.
private fn listSortRange<T, F>(items: List<T>, low: Int, end: Int, order: F, badAllowed: Int,
                               leftmost: Bool) {
    let mut begin = low
    let mut bad = badAllowed
    let mut atLeft = leftmost
    loop {
        let size = end - begin
        if (size < listSortInsertionCutoff()) {
            listInsertionSort(items, begin, end, order)
            return
        }

        // The pivot ends up at `begin`.
        let half = size / 2
        if (size > listSortNintherCutoff()) {
            listSort3(items, begin, begin + half, end - 1, order)
            listSort3(items, begin + 1, begin + half - 1, end - 2, order)
            listSort3(items, begin + 2, begin + half + 1, end - 3, order)
            listSort3(items, begin + half - 1, begin + half, begin + half + 1, order)
            listSwap(items, begin, begin + half)
        } else {
            listSort3(items, begin + half, begin, end - 1, order)
        }

        if (atLeft == false and order(list_get(items, begin - 1), list_get(items, begin)) >= 0) {
            begin = listPartitionLeft(items, begin, end, order) + 1
            continue
        }

        let packed = listPartitionRight(items, begin, end, order)
        let pivotAt = packed / 2
        let leftSize = pivotAt - begin
        let rightSize = end - pivotAt - 1
        if (leftSize < size / 8 or rightSize < size / 8) {
            bad = bad - 1
            if (bad <= 0) {
                listHeapSort(items, begin, end, order)
                return
            }
            if (leftSize >= listSortInsertionCutoff()) {
                listSwap(items, begin, begin + leftSize / 4)
                listSwap(items, pivotAt - 1, pivotAt - leftSize / 4)
            }
            if (rightSize >= listSortInsertionCutoff()) {
                listSwap(items, pivotAt + 1, pivotAt + 1 + rightSize / 4)
                listSwap(items, end - 1, end - rightSize / 4)
            }
        } else if (packed % 2 == 1) {
            if (listPartialInsertionSort(items, begin, pivotAt, order)
                    and listPartialInsertionSort(items, pivotAt + 1, end, order)) {
                return
            }
        }

        listSortRange(items, begin, pivotAt, order, bad, atLeft)
        begin = pivotAt + 1
        atLeft = false
    }
}

// v0.1's bar: `items.sort()`.
//
// In place, and **not stable** -- equal elements may be reordered. A stable sort
// needs a scratch buffer and is a different function, not a flag on this one.
//
// **One line, because `sortBy` is the implementation and `Ord` is one comparator
// among others.** The closure's parameters are written `a: T, b: T` inside a
// generic body: substitution rewrites them to the concrete types before sema sees
// them, and each instantiation lowers its own closure type. Which is a fair test
// of 3.4's lowering, and it passes.
fn sort<T: Ord>(items: List<T>) {
    sortBy(items, |a: T, b: T| cmp(a, b))
}

// The same sort under a caller's ordering. `order(a, b)` answers negative, zero
// or positive the way `cmp` does.
//
// No bound on `T` at all -- the comparator supplies the order, so the element
// type needs nothing. That is the difference between a bounded generic and a
// higher-order one, and having both is why `sortBy` can sort a type whose author
// never wrote an `impl Ord`.
fn sortBy<T, F>(items: List<T>, order: F) {
    let n = list_len(items)
    // log2(n) + 1 badly unbalanced partitions before heapsort takes a range over.
    let mut badAllowed = 1
    let mut rest = n
    while (rest > 1) {
        badAllowed = badAllowed + 1
        rest = rest / 2
    }
    listSortRange(items, 0, n, order, badAllowed, true)
}

fn isSorted<T: Ord>(items: List<T>) -> Bool {
    let n = list_len(items)
    let mut i = 1
    while (i < n) {
        let left = list_get(items, i - 1)
        let right = list_get(items, i)
        if (cmp(left, right) > 0) { return false }
        i = i + 1
    }
    return true
}

// The index of `needle`, or -1. Requires a sorted list and does not check that
// it got one -- checking would cost the linear scan the binary search exists to
// avoid. On an unsorted list the answer is unspecified, not unsafe.
//
// `low + (high - low) / 2` rather than `(low + high) / 2`: the second overflows
// once a list is longer than half the Int range, which is the oldest bug in this
// algorithm and costs nothing to avoid.
fn binarySearch<T: Ord>(items: List<T>, needle: T) -> Int {
    let mut low = 0
    let mut high = list_len(items) - 1
    while (low <= high) {
        let mid = low + (high - low) / 2
        let at = list_get(items, mid)
        let order = cmp(at, needle)
        if (order == 0) { return mid }
        if (order < 0) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return 0 - 1
}

// ---------------------------------------------------------------------------
// v0.1 3.4 -- the higher-order half
// ---------------------------------------------------------------------------

// The elements a predicate keeps, in order.
//
// `T: Copy` because the result owns its elements: `list_push(out, x)` where `x`
// came from `list_get` is "cannot move out of borrowed value", so the kept
// elements are duplicated. `copyOf` is the identity for every scalar.
fn filter<T: Copy, F>(items: List<T>, keep: F) -> List<T> {
    let n = list_len(items)
    let mut out: List<T> = list_new()
    let mut i = 0
    while (i < n) {
        let element = list_get(items, i)
        if (keep(element)) { list_push(out, copyOf(element)) }
        i = i + 1
    }
    return out
}

// `f` applied to every element, appended to `out`.
//
// **The output list is a parameter rather than a return value, and that is
// forced.** A `map` that returned `List<U>` would have to solve `U` from the
// closure's *return* type, and this compiler solves a type parameter from
// argument types only -- writing it explicitly is no escape either, because the
// closure's own type has no spelling. Taking the destination as an argument puts
// `U` in argument position, where it is solvable.
fn mapInto<T, U, F>(items: List<T>, out: List<U>, f: F) {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        list_push(out, f(list_get(items, i)))
        i = i + 1
    }
}

fn countWhere<T, F>(items: List<T>, keep: F) -> Int {
    let n = list_len(items)
    let mut found = 0
    let mut i = 0
    while (i < n) {
        if (keep(list_get(items, i))) { found = found + 1 }
        i = i + 1
    }
    return found
}

fn anyOf<T, F>(items: List<T>, keep: F) -> Bool {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        if (keep(list_get(items, i))) { return true }
        i = i + 1
    }
    return false
}

fn allOf<T, F>(items: List<T>, keep: F) -> Bool {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        if (keep(list_get(items, i)) == false) { return false }
        i = i + 1
    }
    return true
}
