    }

    // Binds a socket to the address at `address`.
    public fn bind(self, fd: Int, address: Usize, length: Int) -> I64 {
        return __builtin_syscall(104, fd as U64, address as U64, length as U64, 0, 0, 0)
    }

    // Marks a socket as accepting connections.
    public fn listen(self, fd: Int, backlog: Int) -> I64 {
        return __builtin_syscall(106, fd as U64, backlog as U64, 0, 0, 0, 0)
    }

    // Accepts a connection; answers its descriptor.
    public fn accept(self, fd: Int, address: Usize, length: Usize) -> I64 {
        return __builtin_syscall(30, fd as U64, address as U64, length as U64, 0, 0, 0)
    }

    // Shuts down part of a connection.
    public fn shutdown(self, fd: Int, how: Int) -> I64 {
        return __builtin_syscall(134, fd as U64, how as U64, 0, 0, 0, 0)
    }

    // Sends a datagram or stream bytes.
    public fn sendto(self, fd: Int, buffer: Usize, length: Usize, flags: Int, address: Usize, addressLength: Int) -> I64 {
        return __builtin_syscall(133, fd as U64, buffer as U64, length as U64, flags as U64, address as U64, addressLength as U64)
    }

    // Receives bytes.
    public fn recvfrom(self, fd: Int, buffer: Usize, length: Usize, flags: Int, address: Usize, addressLength: Usize) -> I64 {
        return __builtin_syscall(29, fd as U64, buffer as U64, length as U64, flags as U64, address as U64, addressLength as U64)
    }
}
