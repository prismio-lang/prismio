// Files and paths.
//
// Everything here is a thin skin over runtime/program_support.c, and unlike
// std/string.psm none of it could be ported: opening a file, reading a
// directory and asking the OS for the working directory are the capabilities
// the language does not have and cannot grow without a syscall layer. What this
// module adds is the two things the raw `extern fn` could not carry.
//
// **The raw functions are `internal`**: a program calls the wrappers, and the
// wrapper is where the contract and the return convention are fixed. A program
// that declares its own `extern fn read_file` still can -- that is its FFI, not
// this module's.
//
// **The ownership contract, declared once.** `read_file`, `get_directory`,
// `join_path`, `current_directory`, `executable_directory` and `list_modules`
// all return `malloc`ed memory the caller must release, and only the first three
// are in the analysis's fallback table (src/aif/contracts.psm). An application
// that declared the other three itself and left the contract off got an opaque
// return -- no owner, and a leak per call. Declaring them here means no
// application has to know which of the six the table happens to cover.
//
// **A `produce(free)` belongs only on a function that allocates.** A C function
// returning a pointer into memory it does not own -- the shape `cli_arg` had
// before std/process.psm read `argv` itself -- is `alias`, and a `produce` on it
// corrupts memory rather than leaking: it hands that memory to the deallocator.
// The warning is here because every extern in this module *is* `produce`, which
// is exactly the habit that would carry over.
//
// **Int returns are normalised to `Bool`, and the raw conventions disagree with
// each other.** `file_exists` returns 1 for yes; `delete_file` returns **0** for
// success. Two adjacent functions in one C file where 0 means opposite things is
// a trap that belongs behind a wrapper, not in a doc comment nobody reads at the
// call site.

import std.option
import std.string
import std.time
import std.vec

internal extern fn file_exists(path: String borrow) -> Int
internal extern fn read_file(path: String borrow) -> String produce(free)
internal extern fn delete_file(path: String borrow) -> Int
// Both return a status rather than a pointer, so neither carries `produce` or
// `alias`: there is nothing for a deallocator to take. `borrow` on the arguments
// is the real contract -- the runtime reads them during the call and retains
// neither.
internal extern fn write_file(path: String borrow, content: String borrow) -> Int
internal extern fn make_directory(path: String borrow) -> Int
internal extern fn directory_exists(path: String borrow) -> Int
internal extern fn get_directory(path: String borrow) -> String produce(free)
internal extern fn join_path(directory: String borrow, filename: String borrow) -> String produce(free)
internal extern fn current_directory() -> String produce(free)
internal extern fn executable_directory() -> String produce(free)
internal extern fn list_modules(directory: String borrow) -> String produce(free)

public fn fileExists(path: String) -> Bool {
    return file_exists(path) == 1
}

// The whole file as text.
//
// An unreadable file and an empty file both come back as the empty string --
// the C returns a one-byte allocation for both. `tryReadFile` is the one that
// can tell them apart, and it does it by asking `file_exists` first rather than
// by inspecting the result, because the result cannot answer.
public fn readFile(path: String) -> String {
    return read_file(path)
}

public fn tryReadFile(path: String) -> Option<String> {
    if (file_exists(path) == 0) { return Option<String>.None }
    return Option<String>.Some(read_file(path))
}

// Writes `content` over `path`, creating the file if it is absent. The parent
// directory must exist -- call `makeDirectory` first -- because silently creating
// one would make a mistyped path succeed.
public fn writeFile(path: String, content: String) -> Bool {
    return write_file(path, content) == 0
}

// Creates `path` and every missing parent. A directory that already exists is
// success, which is what makes this callable unconditionally.
public fn makeDirectory(path: String) -> Bool {
    return make_directory(path) == 0
}

// Whether `path` is an existing directory. Distinct from `fileExists`, which
// opens the path -- and opening a directory succeeds on some hosts and fails on
// others, so it cannot answer this.
public fn directoryExists(path: String) -> Bool {
    return directory_exists(path) == 1
}

// True when the file is gone afterwards. Note the inversion against the C,
// which returns 0 for success.
public fn deleteFile(path: String) -> Bool {
    return delete_file(path) == 0
}

// The directory part of a path, without the trailing separator. `"."` when the
// path has no directory part.
public fn directoryOf(path: String) -> String {
    return get_directory(path)
}

public fn joinPath(directory: String, filename: String) -> String {
    return join_path(directory, filename)
}

public fn currentDirectory() -> String {
    return current_directory()
}

// The directory holding the running executable, which is what a toolchain uses
// to find files shipped beside it. `"."` when the platform cannot answer.
public fn executableDirectory() -> String {
    return executable_directory()
}

// The `.psm` files in `directory`, sorted by name.
//
// The C hands back one newline-separated string because it has no way to build
// a `Vec<String>` -- the container is a Prismio type. Splitting it here is the
// half of `list_modules` that always belonged in Prismio, and it means callers
// stop writing the same newline scan.
//
// An empty directory yields an empty list rather than a list holding one empty
// string, which is the case a plain `strSplit` gets wrong.
public fn listModules(directory: String) -> Vec<String> {
    let listing = list_modules(directory)
    let mut out: Vec<String> = list_new()
    if (strLength(listing) == 0) { return out }
    let names = strSplit(listing, '\n')
    // Explicit, because the inferred drop does not fire here: `listing` is a
    // binding whose value reaches a call that returns a container, and the
    // analysis will not free it at scope exit on the chance the container aliases
    // it. It does not -- `strSplit` builds every part with `str_substring`, which
    // allocates -- so this is a fact the analysis cannot see and the code can
    // state. Without it `listModules` leaks exactly one allocation per call, the
    // newline-joined listing itself.
    drop(listing)
    let mut i = 0
    while (i < list_len(names)) {
        // `list_get` twice rather than a binding, and this is the rule in
        // CODE_STYLE.md rather than a preference. Binding the element makes the
        // analysis treat it as a second owner of a string the list already owns,
        // and both release it: measured here as three `release of a pointer that
        // is not live` violations, which is a double free rather than a leak.
        if (strLength(list_get(names, i)) > 0) {
            list_push(out, list_get(names, i).concat(""))
        }
        i = i + 1
    }
    return out
}

// Whether `path` names a `.psm` source file. Spelled out rather than left to
// each caller because the extension is part of the module-resolution contract
// in src/main.psm, not a convention.
public fn isSourcePath(path: String) -> Bool {
    return strEndsWith(path, ".psm")
}

// The rest of the file-system capability: a directory's entries, appending,
// renaming, removing a directory, and what a path is.
private extern fn fs_list_begin(path: String borrow) -> Int
private extern fn fs_list_name(index: Int) -> String produce(free)
private extern fn fs_list_end()
// `bytes`, with the count beside it: a view crosses without the NUL-terminated
// copy a `borrow` would make, since the callee never looks for a terminator.
private extern fn fs_append_file(path: String borrow, content: String bytes, length: Int) -> Int
private extern fn fs_rename(from: String borrow, to: String borrow) -> Int
private extern fn fs_remove_directory(path: String borrow) -> Int
private extern fn fs_metadata(path: String borrow, out: MetadataOut) -> Int

// The names in `directory` -- files, directories and anything else -- sorted by
// byte value, without `.` and `..`. Names only: `joinPath(directory, name)` is
// the path. Empty for a directory that cannot be read; `directoryExists` tells
// that from an empty one.
//
// Read one name at a time from the runtime rather than split from one string,
// as `listModules` is, because a file name may contain a newline.
public fn listDirectory(directory: String) -> Vec<String> {
    let mut out: Vec<String> = []
    let count = fs_list_begin(directory)
    let mut i = 0
    while (i < count) {
        out.push(fs_list_name(i))
        i = i + 1
    }
    fs_list_end()
    return out
}

// Adds `content` to the end of `path`, creating the file if it is absent. The
// parent directory must exist, as for `writeFile`.
public fn appendFile(path: String, content: String) -> Bool {
    return fs_append_file(path, content, strLength(content)) == 0
}

// Moves `from` to `to`, replacing a file already at `to` -- on Windows too.
// Both must be on one file system; this is a rename, not a copy.
public fn rename(from: String, to: String) -> Bool {
    return fs_rename(from, to) == 0
}

// Removes `path` if it is an empty directory. A directory with anything in it is
// refused rather than emptied.
public fn removeDirectory(path: String) -> Bool {
    return fs_remove_directory(path) == 0
}

// What `fs_metadata` writes back. Every field is 64-bit so that no padding
// question arises between this declaration and the C one, as for `SpawnOut`.
struct MetadataOut {
    size: I64,
    modifiedNanos: I64,
    isDirectory: I64,
    isFile: I64
}

// What a path names. A symbolic link answers for what it points at.
//
// `size` is in bytes, and 0 for a directory. `modified` is the last write, as a
// time since the Unix epoch -- `m.modified.asSeconds`, or compared with
// `unixTime()`. A path that is neither a directory nor a regular file (a device,
// a socket) has both flags false.
struct Metadata {
    size: I64,
    modified: Duration,
    isDirectory: Bool,
    isFile: Bool
}

// `None` when nothing is at `path`, or it cannot be examined.
public fn metadata(path: String) -> Option<Metadata> {
    let zero = 0 as I64
    let out = MetadataOut { size: zero, modifiedNanos: zero, isDirectory: zero, isFile: zero }
    if (fs_metadata(path, out) == 0) { return Option<Metadata>.None }
    return Option<Metadata>.Some(Metadata {
        size: out.size,
        modified: Duration.fromNanos(out.modifiedNanos),
        isDirectory: out.isDirectory == 1,
        isFile: out.isFile == 1
    })
}
