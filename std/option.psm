// What `T?` and `Result<T, E>` need beyond the language -- signalling absence and
// failure without a sentinel.
//
// **`T?` is the optional**, and there is no `Option<T>` beside it: a second spelling
// of "a `T` or nothing" would be one more thing to learn and to convert between.
// `none`, `==`, `expect(o)` and a scalar's `unwrapOr` are the compiler's; `??` is a
// call to `optionCoalesce` below; and the functions here are the rest of what a
// `T?` is read with -- `unwrapOr` for a reference, `expect` with a message, `map`,
// `andThen` and `okOr`. They are generics over `T?`, so `o.unwrapOr(x)` and
// `unwrapOr(o, x)` are one call, and they work for every `T` the optional does.
//
// `Result<T, E>` is the other half: a value or the error that stopped it. It is a
// payload enum, a tagged struct, so it is move-only; `ok()` and `err()` turn one
// side of it into a `T?`.
//
// **Variant order is part of the ABI here.** The tag is the variant's position,
// so reordering the variants in this file changes the tag every compiled program
// expects. Append, never insert.

// `a ?? b`: `a` when it has a value, `b` when it is `none`. The operator is this
// call (sema/checker.psm, semaCoalesceExpr), so what it may alias is read from
// these bodies like any function's -- and codegen branches around `b`, so it is
// evaluated only when `a` is absent.
public fn optionCoalesce<T>(a: T?, b: T) -> T {
    if (a != none) { return expect(a) }
    return b
}

// The same with an optional on the right, which stays one: `a ?? b ?? 0`.
public fn optionCoalesce<T>(a: T?, b: T?) -> T? {
    if (a != none) { return a }
    return b
}

// What reading a `T?` takes beyond `==`, `expect(o)` and `??`, for the values a
// reference optional holds (a scalar's `unwrapOr` is the compiler's). They are
// ordinary generics over `T?`, so `o.unwrapOr(x)` and `unwrapOr(o, x)` are one call.

// The value, or `fallback` when there is none.
public fn unwrapOr<T>(o: T?, fallback: T) -> T {
    if (o != none) { return expect(o) }
    return fallback
}

// The value, or a panic with `message` when there is none -- for the case the
// caller has already ruled out and wants said out loud if it happens. The
// message is what the panic prints, so make it specific.
public fn expect<T>(o: T?, message: String) -> T {
    if (o == none) { panic(message) }
    return expect(o)
}

// `Ok` of the value, or `Err(error)` when there is none.
public fn okOr<T, E>(o: T?, error: E) -> Result<T, E> {
    if (o == none) { return Result<T, E>.Err(error) }
    return Result<T, E>.Ok(expect(o))
}

// `f` of the value, or `none`: `o.map(|x: Int| x * 2)`. `U` is the closure's
// return type.
public fn map<T, U, F: Fn(T) -> U>(o: T?, f: F) -> U? {
    if (o == none) { return none }
    return f(expect(o))
}

// `f` of the value, which is itself optional, or `none`: a step that can fail.
public fn andThen<T, U, F: Fn(T) -> U?>(o: T?, f: F) -> U? {
    if (o == none) { return none }
    return f(expect(o))
}

enum Result<T, E> {
    Err(E),
    Ok(T)
}

public fn resultIsOk<T, E>(r: Result<T, E>) -> Bool {
    match (r) {
        Result.Ok(v) => { return true }
        Result.Err(e) => { return false }
    }
}

public fn resultIsErr<T, E>(r: Result<T, E>) -> Bool {
    match (r) {
        Result.Ok(v) => { return false }
        Result.Err(e) => { return true }
    }
}

public fn resultOr<T, E>(r: Result<T, E>, fallback: T) -> T {
    match (r) {
        Result.Ok(v) => { return v }
        Result.Err(e) => { return fallback }
    }
}

public fn resultErrOr<T, E>(r: Result<T, E>, fallback: E) -> E {
    match (r) {
        Result.Ok(v) => { return fallback }
        Result.Err(e) => { return e }
    }
}

impl<T, E> Result<T, E> {
    public prop isOk(self) -> Bool {
        match (self) {
            Result.Ok(v) => { return true }
            Result.Err(e) => { return false }
        }
    }

    public prop isErr(self) -> Bool {
        match (self) {
            Result.Ok(v) => { return false }
            Result.Err(e) => { return true }
        }
    }

    // The value, or `fallback` for an error.
    public fn unwrapOr(self, fallback: T) -> T {
        match (self) {
            Result.Ok(v) => { return v }
            Result.Err(e) => { return fallback }
        }
    }

    // The value, or a panic with `message` for an error.
    public fn expect(self, message: String) -> T {
        match (self) {
            Result.Ok(v) => { return v }
            Result.Err(e) => { panic(message) }
        }
    }

    // The value as a `T?`, dropping the error.
    public fn ok(self) -> T? {
        match (self) {
            Result.Ok(v) => { return v }
            Result.Err(e) => { return none }
        }
    }

    // The error as an `E?`, dropping the value.
    public fn err(self) -> E? {
        match (self) {
            Result.Ok(v) => { return none }
            Result.Err(e) => { return e }
        }
    }

    // `f` of the value, or the error unchanged.
    public fn map<U, F: Fn(T) -> U>(self, f: F) -> Result<U, E> {
        match (self) {
            Result.Ok(v) => { return Result<U, E>.Ok(f(v)) }
            Result.Err(e) => { return Result<U, E>.Err(e) }
        }
    }

    // The value unchanged, or `f` of the error.
    public fn mapErr<G, F: Fn(E) -> G>(self, f: F) -> Result<T, G> {
        match (self) {
            Result.Ok(v) => { return Result<T, G>.Ok(v) }
            Result.Err(e) => { return Result<T, G>.Err(f(e)) }
        }
    }

    // `f` of the value, which is itself a Result, or the error unchanged.
    public fn andThen<U, F: Fn(T) -> Result<U, E>>(self, f: F) -> Result<U, E> {
        match (self) {
            Result.Ok(v) => { return f(v) }
            Result.Err(e) => { return Result<U, E>.Err(e) }
        }
    }
}
