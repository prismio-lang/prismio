// Option<T> and Result<T, E> -- signalling absence and failure without a
// sentinel.
//
// REQUIREMENTS 14. Before these, a function that could fail returned a sentinel
// -- `-1`, `0`, an empty string -- and nothing in the type said so, so nothing
// made a caller check. `T?` (REQUIREMENTS 4) covers *reference*-shaped types
// only: `Int?` is refused, because a scalar has no spare representation. These
// two work for every type, because the tag is a separate field rather than a
// value stolen from the payload's range.
//
// **Variant order is part of the ABI here.** The tag is the variant's position,
// so reordering the variants in this file changes the tag every compiled program
// expects. Append, never insert.
//
// A note on representation: an enum with payloads becomes a tagged struct (see
// src/sema/enums.psm), which makes these move-only owned values rather than
// copied scalars. `Option<Int>` is two words and one allocation, not a register.
// That is the cost of not having a tagged *union* yet, and it is REQUIREMENTS 18
// that unlocks the smaller form.

enum Option<T> {
    None,
    Some(T)
}

public fn optionIsSome<T>(o: Option<T>) -> Bool {
    match (o) {
        Option.Some(v) => { return true }
        Option.None => { return false }
    }
}

public fn optionIsNone<T>(o: Option<T>) -> Bool {
    match (o) {
        Option.Some(v) => { return false }
        Option.None => { return true }
    }
}

// The value, or the caller's default. The only way to read an `Option` here:
// there is deliberately no unchecked `unwrap`, because the whole point of the
// type is that the absent case is unavoidable at the use site.
public fn optionOr<T>(o: Option<T>, fallback: T) -> T {
    match (o) {
        Option.Some(v) => { return v }
        Option.None => { return fallback }
    }
}

// The methods are the API; the prefixed functions stay for existing callers.
// Each method matches for itself rather than forwarding, which costs nothing
// and keeps each one a single function in a `--verify` report.
//
// Three of these shapes -- forwarding a result, returning a payload binder on
// its own, and moving one into a new enum -- released memory that was not live
// until 2026-09-25 (aif/evidence/RESULTS-ownership-shapes.md);
// tests/*_probe.psm pin each one.
impl<T> Option<T> {
    public prop isSome(self) -> Bool {
        match (self) {
            Option.Some(v) => { return true }
            Option.None => { return false }
        }
    }

    public prop isNone(self) -> Bool {
        match (self) {
            Option.Some(v) => { return false }
            Option.None => { return true }
        }
    }

    // The value, or `fallback` when there is none.
    public fn unwrapOr(self, fallback: T) -> T {
        match (self) {
            Option.Some(v) => { return v }
            Option.None => { return fallback }
        }
    }

    // The value, or a panic with `message` when there is none -- for the case
    // the caller has already ruled out and wants said out loud if it happens.
    public fn expect(self, message: String) -> T {
        match (self) {
            Option.Some(v) => { return v }
            Option.None => { panic(message) }
        }
    }

    // `Ok` of the value, or `Err(error)` when there is none.
    public fn okOr<E>(self, error: E) -> Result<T, E> {
        match (self) {
            Option.Some(v) => { return Result<T, E>.Ok(v) }
            Option.None => { return Result<T, E>.Err(error) }
        }
    }

    // `f` of the value, or `None`: `o.map(|x: Int| x * 2)`. `U` is the
    // closure's return type.
    public fn map<U, F: Fn(T) -> U>(self, f: F) -> Option<U> {
        match (self) {
            Option.Some(v) => { return Option<U>.Some(f(v)) }
            Option.None => { return Option<U>.None }
        }
    }

    // `f` of the value, which is itself an Option, or `None`: a step that can fail.
    public fn andThen<U, F: Fn(T) -> Option<U>>(self, f: F) -> Option<U> {
        match (self) {
            Option.Some(v) => { return f(v) }
            Option.None => { return Option<U>.None }
        }
    }
}

enum Result<T, E> {
    Err(E),
    Ok(T)
}

public fn resultIsOk<T, E>(r: Result<T, E>) -> Bool {
    match (r) {
        Result.Ok(v) => { return true }
        Result.Err(e) => { return false }
    }
}

public fn resultIsErr<T, E>(r: Result<T, E>) -> Bool {
    match (r) {
        Result.Ok(v) => { return false }
        Result.Err(e) => { return true }
    }
}

public fn resultOr<T, E>(r: Result<T, E>, fallback: T) -> T {
    match (r) {
        Result.Ok(v) => { return v }
        Result.Err(e) => { return fallback }
    }
}

public fn resultErrOr<T, E>(r: Result<T, E>, fallback: E) -> E {
    match (r) {
        Result.Ok(v) => { return fallback }
        Result.Err(e) => { return e }
    }
}

impl<T, E> Result<T, E> {
    public prop isOk(self) -> Bool {
        match (self) {
            Result.Ok(v) => { return true }
            Result.Err(e) => { return false }
        }
    }

    public prop isErr(self) -> Bool {
        match (self) {
            Result.Ok(v) => { return false }
            Result.Err(e) => { return true }
        }
    }

    // The value, or `fallback` for an error.
    public fn unwrapOr(self, fallback: T) -> T {
        match (self) {
            Result.Ok(v) => { return v }
            Result.Err(e) => { return fallback }
        }
    }

    // The value, or a panic with `message` for an error.
    public fn expect(self, message: String) -> T {
        match (self) {
            Result.Ok(v) => { return v }
            Result.Err(e) => { panic(message) }
        }
    }

    // The value as an `Option`, dropping the error.
    public fn ok(self) -> Option<T> {
        match (self) {
            Result.Ok(v) => { return Option<T>.Some(v) }
            Result.Err(e) => { return Option<T>.None }
        }
    }

    // The error as an `Option`, dropping the value.
    public fn err(self) -> Option<E> {
        match (self) {
            Result.Ok(v) => { return Option<E>.None }
            Result.Err(e) => { return Option<E>.Some(e) }
        }
    }

    // `f` of the value, or the error unchanged.
    public fn map<U, F: Fn(T) -> U>(self, f: F) -> Result<U, E> {
        match (self) {
            Result.Ok(v) => { return Result<U, E>.Ok(f(v)) }
            Result.Err(e) => { return Result<U, E>.Err(e) }
        }
    }

    // The value unchanged, or `f` of the error.
    public fn mapErr<G, F: Fn(E) -> G>(self, f: F) -> Result<T, G> {
        match (self) {
            Result.Ok(v) => { return Result<T, G>.Ok(v) }
            Result.Err(e) => { return Result<T, G>.Err(f(e)) }
        }
    }

    // `f` of the value, which is itself a Result, or the error unchanged.
    public fn andThen<U, F: Fn(T) -> Result<U, E>>(self, f: F) -> Result<U, E> {
        match (self) {
            Result.Ok(v) => { return f(v) }
            Result.Err(e) => { return Result<U, E>.Err(e) }
        }
    }
}
