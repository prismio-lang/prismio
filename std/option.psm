// Option<T> and Result<T, E> -- signalling absence and failure without a
// sentinel.
//
// REQUIREMENTS 14. Before these, a function that could fail returned a sentinel
// -- `-1`, `0`, an empty string -- and nothing in the type said so, so nothing
// made a caller check. `T?` (REQUIREMENTS 4) covers *reference*-shaped types
// only: `Int?` is refused, because a scalar has no spare representation. These
// two work for every type, because the tag is a separate field rather than a
// value stolen from the payload's range.
//
// **Variant order is part of the ABI here.** The tag is the variant's position,
// so reordering the variants in this file changes the tag every compiled program
// expects. Append, never insert.
//
// A note on representation: an enum with payloads becomes a tagged struct (see
// src/sema/enums.psm), which makes these move-only owned values rather than
// copied scalars. `Option<Int>` is two words and one allocation, not a register.
// That is the cost of not having a tagged *union* yet, and it is REQUIREMENTS 18
// that unlocks the smaller form.

enum Option<T> {
    None,
    Some(T)
}

public fn optionIsSome<T>(o: Option<T>) -> Bool {
    match (o) {
        Option.Some(v) => { return true }
        Option.None => { return false }
    }
}

public fn optionIsNone<T>(o: Option<T>) -> Bool {
    match (o) {
        Option.Some(v) => { return false }
        Option.None => { return true }
    }
}

// The value, or the caller's default. The only way to read an `Option` here:
// there is deliberately no unchecked `unwrap`, because the whole point of the
// type is that the absent case is unavoidable at the use site.
public fn optionOr<T>(o: Option<T>, fallback: T) -> T {
    match (o) {
        Option.Some(v) => { return v }
        Option.None => { return fallback }
    }
}

// The methods are the API. **Each matches for itself rather than forwarding to
// the prefixed function above**: `return optionOr(self, fallback)` releases a
// literal fallback when the Option came from a call -- a double free, and a
// crash without `--verify` (KNOWN_ISSUES, "A value returned through a
// forwarding call"). The prefixed functions stay for existing callers.
//
// **Not here yet** (docs/STDLIB_SHIP_PLAN.md item 5):
// - `map`, `andThen`, `mapErr`. `o.map(|x: Int| x * 2)` needs the result's `U`
//   from the closure's return type, and a type parameter is solved only from an
//   argument's type -- there is no `F: Fn(T) -> U` to say where `U` comes from.
//   That is a language decision, not a library one.
// - `okOr`, `ok`, `err`. Each moves a payload out of one enum into another, and
//   that double-frees an owned payload today, `sink self` or not (KNOWN_ISSUES,
//   "A match binder put into a new enum").
// - `expect(message)`. It returns the payload and nothing else, and a function
//   of that shape releases a *literal* payload it was handed (KNOWN_ISSUES, "A
//   match binder returned on its own"). `unwrapOr` also returns its parameter,
//   and that path is what keeps it sound.
impl<T> Option<T> {
    public prop isSome(self) -> Bool {
        match (self) {
            Option.Some(v) => { return true }
            Option.None => { return false }
        }
    }

    public prop isNone(self) -> Bool {
        match (self) {
            Option.Some(v) => { return false }
            Option.None => { return true }
        }
    }

    // The value, or `fallback` when there is none.
    public fn unwrapOr(self, fallback: T) -> T {
        match (self) {
            Option.Some(v) => { return v }
            Option.None => { return fallback }
        }
    }
}

enum Result<T, E> {
    Err(E),
    Ok(T)
}

public fn resultIsOk<T, E>(r: Result<T, E>) -> Bool {
    match (r) {
        Result.Ok(v) => { return true }
        Result.Err(e) => { return false }
    }
}

public fn resultIsErr<T, E>(r: Result<T, E>) -> Bool {
    match (r) {
        Result.Ok(v) => { return false }
        Result.Err(e) => { return true }
    }
}

public fn resultOr<T, E>(r: Result<T, E>, fallback: T) -> T {
    match (r) {
        Result.Ok(v) => { return v }
        Result.Err(e) => { return fallback }
    }
}

public fn resultErrOr<T, E>(r: Result<T, E>, fallback: E) -> E {
    match (r) {
        Result.Ok(v) => { return fallback }
        Result.Err(e) => { return e }
    }
}

impl<T, E> Result<T, E> {
    public prop isOk(self) -> Bool {
        match (self) {
            Result.Ok(v) => { return true }
            Result.Err(e) => { return false }
        }
    }

    public prop isErr(self) -> Bool {
        match (self) {
            Result.Ok(v) => { return false }
            Result.Err(e) => { return true }
        }
    }

    // The value, or `fallback` for an error.
    public fn unwrapOr(self, fallback: T) -> T {
        match (self) {
            Result.Ok(v) => { return v }
            Result.Err(e) => { return fallback }
        }
    }
}
