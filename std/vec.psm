// `Vec<T>`: the literal table, the methods that are ordinary functions, and the
// algorithms that need an order.
//
// **Not every method is here.** `v.f(a)` is `f(v, a)`, so a method is any
// function whose first parameter is the Vec -- but the ones that store an
// element or read one (`push`, `set`, `insert`, `first`, `last` ...) and the
// size queries are lowered by the compiler instead; src/sema/vec.psm says why.
// What is here reads the vector, or goes through a copy. docs/COLLECTIONS.md has the
// whole list.
//
// **`T: Copy` wherever an element leaves the vector.** A parameter is a borrow,
// so an element can only come out as a duplicate; `copyOf` is the identity on
// every scalar. `pop` and `removeAt` hand back the copy and remove the
// original, which is released with the vector unless the compiler can prove
// nothing still views it -- see list_truncate in runtime/lang_runtime.c.
//
// The private helpers are `list*`-prefixed for the reason `std/string.psm` gives
// at length: a short name here is claimed for every program that imports this
// file.

import std.ord
import std.copy
import std.eq
import std.option

// The lowering target for a list literal. `[a, b, c]` written where a `Vec<T>`
// is expected becomes `vecOf(a, b, c)` -- the same rewrite `s[i]` gets for
// `charAt`, and it carries the same obligation: a program that writes a list
// literal needs `import std.vec`, and sema says so when it does not.
//
// **One overload per arity, because there are no varargs**, exactly as
// `String.concat` has 2..6 and for the same reason. Twelve is the cap; past it
// sema names it and points at `list_new`. The cap is a property of this table
// rather than of the language, so raising it or replacing the whole table with a
// real lowering later changes no call site.
//
// Each builds and returns its own list rather than delegating to a smaller
// overload. A wrapper that took an owned list and handed it back would be the
// pass-through shape that leaks its argument, which is the reason the table is
// twelve near-identical functions instead of a chain.
//
// **`T: Copy` and `copyOf`, for the reason `Map` needs them**: a parameter is a
// borrow, so `list_push(xs, a)` on a parameter is *"cannot move out of borrowed
// value `a`"*. std/copy.psm's header has the whole argument, including why
// `sink` does not fix it. The cost is that a list literal is available for the
// element types that implement `Copy`, which is every scalar, `String`, and any
// struct that writes the impl.
public fn vecOf<T: Copy>(a: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(1)
    list_push(xs, copyOf(a))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(2)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(3)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(4)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(5)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(6)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T, g: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(7)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f)) list_push(xs, copyOf(g))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(8)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f)) list_push(xs, copyOf(g)) list_push(xs, copyOf(h))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T, i: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(9)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f)) list_push(xs, copyOf(g)) list_push(xs, copyOf(h))
    list_push(xs, copyOf(i))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T, i: T, j: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(10)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f)) list_push(xs, copyOf(g)) list_push(xs, copyOf(h))
    list_push(xs, copyOf(i)) list_push(xs, copyOf(j))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T, i: T, j: T, k: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(11)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f)) list_push(xs, copyOf(g)) list_push(xs, copyOf(h))
    list_push(xs, copyOf(i)) list_push(xs, copyOf(j)) list_push(xs, copyOf(k))
    return xs
}

public fn vecOf<T: Copy>(a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T, i: T, j: T, k: T, l: T) -> Vec<T> {
    let mut xs: Vec<T> = list_new_with_capacity(12)
    list_push(xs, copyOf(a)) list_push(xs, copyOf(b)) list_push(xs, copyOf(c)) list_push(xs, copyOf(d))
    list_push(xs, copyOf(e)) list_push(xs, copyOf(f)) list_push(xs, copyOf(g)) list_push(xs, copyOf(h))
    list_push(xs, copyOf(i)) list_push(xs, copyOf(j)) list_push(xs, copyOf(k)) list_push(xs, copyOf(l))
    return xs
}

// Below this, insertion sort wins: its O(n^2) has a tiny constant and no
// partition bookkeeping. 24 is pdqsort's cut.
private fn listSortInsertionCutoff() -> Int { return 24 }

// Above this, the pivot is Tukey's ninther -- the median of three medians of
// three -- rather than one median of three.
private fn listSortNintherCutoff() -> Int { return 128 }

// How many elements a side the partition classifies before it swaps any. 64 is
// pdqsort's block, and the length of the two offset buffers `sortBy` allocates.
private fn listSortBlock() -> Int { return 64 }

// **Every element move in this file is `list_swap`.** It exchanges two slots
// and has no ownership effect, which is the only move right for every
// representation. Reading two elements and writing them back through `list_set`
// was not: an inline element's `list_get` answers an address inside the list's
// block, so the second write copied back what the first had just written -- one
// element duplicated, one lost -- and `list_set_inline` then freed the interior
// address it copied from. `sortBy` on a list of flat structs aborted in `free`.
//
// **Called directly, not through a one-line wrapper, and the difference is
// measured.** The flat-list guard looks through a call to a function proved to
// move no block, and a wrapper around `list_swap` is one; `irFlatGuardCount`
// does not recognise `list_swap` itself, so a loop that calls it is declined.
// Declined is what insertion sort wants: its inner loop is entered once per
// element and runs a few iterations, and a guard is paid per entry. Through the
// wrapper that loop was versioned -- 216 instructions for Ints against 143 --
// and 80,000 random Ints sorted in 2.01 ms against 1.70; flat structs 0.876x.
// String and boxed lists have no guard either way. Already-sorted and reversed
// Ints, whose loops the guard did help, are 7% and 11% slower, at 0.09 and
// 0.16 ms. Teaching the guard `list_swap` would version these loops again.

// Order two elements with one comparison.
private fn listSort2<T, F>(inout items: Vec<T>, i: Int, j: Int, order: F) {
    if (order(list_get(items, j), list_get(items, i)) < 0) { list_swap(items, i, j) }
}

private fn listSort3<T, F>(inout items: Vec<T>, i: Int, j: Int, k: Int, order: F) {
    listSort2(items, i, j, order)
    listSort2(items, j, k, order)
    listSort2(items, i, j, order)
}

// `[begin, end)` by adjacent swaps.
private fn listInsertionSort<T, F>(inout items: Vec<T>, begin: Int, end: Int, order: F) {
    let mut i = begin + 1
    while (i < end) {
        let mut j = i
        while (j > begin and order(list_get(items, j - 1), list_get(items, j)) > 0) {
            list_swap(items, j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
}

// Insertion sort that gives up after eight moves, answering whether it
// finished. Run on both sides of a partition that needed no swap, which is what
// makes an already-sorted or reversed input near-linear rather than a quicksort.
private fn listPartialInsertionSort<T, F>(inout items: Vec<T>, begin: Int, end: Int, order: F) -> Bool {
    let mut moves = 0
    let mut i = begin + 1
    while (i < end) {
        let mut j = i
        while (j > begin and order(list_get(items, j - 1), list_get(items, j)) > 0) {
            list_swap(items, j - 1, j)
            j = j - 1
            moves = moves + 1
        }
        if (moves > 8) { return false }
        i = i + 1
    }
    return true
}

private fn listSiftDown<T, F>(inout items: Vec<T>, base: Int, start: Int, count: Int, order: F) {
    let mut root = start
    loop {
        let mut child = 2 * root + 1
        if (child >= count) { return }
        if (child + 1 < count
                and order(list_get(items, base + child), list_get(items, base + child + 1)) < 0) {
            child = child + 1
        }
        if (order(list_get(items, base + root), list_get(items, base + child)) >= 0) { return }
        list_swap(items, base + root, base + child)
        root = child
    }
}

// The fallback that bounds the worst case at O(n log n): taken once a range has
// produced more badly unbalanced partitions than its size's log2 allows.
//
// `cold`, because it runs only on adversarial input and every sort carried it:
// with one call site it was inlined into listSortRange, which is what made each
// instantiation the slowest function in a program to optimise.
private cold fn listHeapSort<T, F>(inout items: Vec<T>, begin: Int, end: Int, order: F) {
    let count = end - begin
    let mut start = count / 2 - 1
    while (start >= 0) {
        listSiftDown(items, begin, start, count, order)
        start = start - 1
    }
    let mut last = count - 1
    while (last > 0) {
        list_swap(items, begin, begin + last)
        listSiftDown(items, begin, 0, last, order)
        last = last - 1
    }
}

// Partition `[begin, end)` around the pivot at `begin`: smaller elements left
// of it, the rest right. Answers the pivot's final index times two, plus one
// when no element had to move.
//
// **The comparison feeds an add, not a branch.** This is BlockQuicksort's
// partition (Edelkamp and Weiss), as pdqsort's `partition_right_branchless` has
// it: up to a block of elements a side is classified into an offset buffer by an
// unconditional store and a conditional increment, and only then are the
// misplaced ones swapped, in pairs. A Hoare scan branches on every comparison,
// and on random input half those branches go the wrong way. Against the Hoare
// scan it replaced, on 80,000 elements: random Ints 0.545x, `sort_strings`'
// keys 0.557x, flat structs 0.518x, boxed ones by a String field 0.589x -- so
// it partitions every element type, not only scalars. Reversed input, where
// every element is misplaced and the bookkeeping buys nothing, is 1.07x.
//
// **The pivot stays in its slot until the last swap, and that is what makes it
// safe to hold.** An inline list's `list_get` can answer a value that lives in
// the list's own block; nothing below writes `begin`, so `pivot` names the same
// element for the whole partition. The two opening scans are bounded as well as
// stopped by the comparator, and the block indices are arithmetic on `first` and
// `last` alone, so an ordering that is not a strict weak order yields an
// unsorted permutation rather than a read past the end.
private fn listPartitionRight<T, F>(inout items: Vec<T>, begin: Int, end: Int, order: F,
                                    inout offL: Vec<Int>, inout offR: Vec<Int>) -> Int {
    let pivot = list_get(items, begin)
    let mut first = begin + 1
    while (first < end and order(list_get(items, first), pivot) < 0) { first = first + 1 }
    let mut last = end - 1
    while (last >= first and order(list_get(items, last), pivot) >= 0) { last = last - 1 }
    if (first >= last) {
        list_swap(items, begin, first - 1)
        return (first - 1) * 2 + 1
    }

    list_swap(items, first, last)
    first = first + 1
    // `[first, last)` is unclassified: `last` itself now holds a large element.
    let mut numL = 0
    let mut numR = 0
    let mut startL = 0
    let mut startR = 0
    let mut baseL = first
    let mut baseR = last
    while (first < last) {
        // Refill whichever buffer is empty, splitting what is left between the
        // two when both are.
        let unknown = last - first
        let mut leftSplit = 0
        if (numL == 0) {
            if (numR == 0) { leftSplit = unknown / 2 } else { leftSplit = unknown }
        }
        let mut rightSplit = 0
        if (numR == 0) { rightSplit = unknown - leftSplit }
        if (leftSplit > listSortBlock()) { leftSplit = listSortBlock() }
        if (rightSplit > listSortBlock()) { rightSplit = listSortBlock() }

        let mut i = 0
        while (i < leftSplit) {
            list_set(offL, numL, i)
            if (order(list_get(items, first), pivot) >= 0) { numL = numL + 1 }
            first = first + 1
            i = i + 1
        }
        i = 0
        while (i < rightSplit) {
            i = i + 1
            list_set(offR, numR, i)
            last = last - 1
            if (order(list_get(items, last), pivot) < 0) { numR = numR + 1 }
        }

        let mut num = numL
        if (numR < num) { num = numR }
        let mut k = 0
        while (k < num) {
            list_swap(items, baseL + list_get(offL, startL + k), baseR - list_get(offR, startR + k))
            k = k + 1
        }
        numL = numL - num
        numR = numR - num
        startL = startL + num
        startR = startR + num
        if (numL == 0) {
            startL = 0
            baseL = first
        }
        if (numR == 0) {
            startR = 0
            baseR = last
        }
    }

    // At most one buffer still holds misplaced elements -- each round empties
    // the smaller -- and each of them goes to the boundary in turn.
    if (numL > 0) {
        while (numL > 0) {
            numL = numL - 1
            last = last - 1
            list_swap(items, baseL + list_get(offL, startL + numL), last)
        }
        first = last
    }
    while (numR > 0) {
        numR = numR - 1
        list_swap(items, baseR - list_get(offR, startR + numR), first)
        first = first + 1
    }
    let pivotAt = first - 1
    list_swap(items, begin, pivotAt)
    return pivotAt * 2
}

// The same around a pivot equal to the element just left of the range: equal
// elements go left of it and are finished. Answers the pivot's final index.
private fn listPartitionLeft<T, F>(inout items: Vec<T>, begin: Int, end: Int, order: F) -> Int {
    let pivot = list_get(items, begin)
    let mut last = end - 1
    while (last > begin and order(pivot, list_get(items, last)) < 0) { last = last - 1 }
    let mut first = begin + 1
    while (first <= last and order(pivot, list_get(items, first)) >= 0) { first = first + 1 }
    while (first < last) {
        list_swap(items, first, last)
        last = last - 1
        while (last > begin and order(pivot, list_get(items, last)) < 0) { last = last - 1 }
        first = first + 1
        while (first <= last and order(pivot, list_get(items, first)) >= 0) { first = first + 1 }
    }
    list_swap(items, begin, last)
    return last
}

// Pattern-defeating quicksort (Orson Peters, 2021 -- the algorithm behind
// Rust's `sort_unstable` before ipnsort, and Go's `sort`), over `[begin, end)`.
//
// **It replaced a three-way quicksort that was pathological on ordered input.**
// Measured on 80,000 Ints: already sorted 19.3 ms against 0.14 ms, reversed
// 15.8 ms against 0.17 ms, random 4.26 ms against 3.63 ms. The two ordered
// cases are the partial insertion sort after a partition that moved nothing.
//
// Duplicates keep the property the three-way partition was chosen for: a pivot
// equal to the element left of the range (a previous pivot, so no smaller than
// anything here) takes `listPartitionLeft`, which finishes every element equal
// to it -- so an all-equal list is linear, not n^2. Unbalanced partitions (a
// side under an eighth) are counted, break patterns by swapping a few elements,
// and after `badAllowed` of them the range goes to heapsort.
//
// Recurses on the left side and loops on the right. Every level either splits
// at worst 1:7 or spends one of `badAllowed`'s log2(n) allowances, so the depth
// is O(log n) whatever the input does.
private fn listSortRange<T, F>(inout items: Vec<T>, low: Int, end: Int, order: F, badAllowed: Int,
                               leftmost: Bool, inout offL: Vec<Int>, inout offR: Vec<Int>) {
    let mut begin = low
    let mut bad = badAllowed
    let mut atLeft = leftmost
    loop {
        let size = end - begin
        if (size < listSortInsertionCutoff()) {
            listInsertionSort(items, begin, end, order)
            return
        }

        // The pivot ends up at `begin`.
        let half = size / 2
        if (size > listSortNintherCutoff()) {
            listSort3(items, begin, begin + half, end - 1, order)
            listSort3(items, begin + 1, begin + half - 1, end - 2, order)
            listSort3(items, begin + 2, begin + half + 1, end - 3, order)
            listSort3(items, begin + half - 1, begin + half, begin + half + 1, order)
            list_swap(items, begin, begin + half)
        } else {
            listSort3(items, begin + half, begin, end - 1, order)
        }

        if (atLeft == false and order(list_get(items, begin - 1), list_get(items, begin)) >= 0) {
            begin = listPartitionLeft(items, begin, end, order) + 1
            continue
        }

        let packed = listPartitionRight(items, begin, end, order, offL, offR)
        let pivotAt = packed / 2
        let leftSize = pivotAt - begin
        let rightSize = end - pivotAt - 1
        if (leftSize < size / 8 or rightSize < size / 8) {
            bad = bad - 1
            if (bad <= 0) {
                listHeapSort(items, begin, end, order)
                return
            }
            if (leftSize >= listSortInsertionCutoff()) {
                list_swap(items, begin, begin + leftSize / 4)
                list_swap(items, pivotAt - 1, pivotAt - leftSize / 4)
            }
            if (rightSize >= listSortInsertionCutoff()) {
                list_swap(items, pivotAt + 1, pivotAt + 1 + rightSize / 4)
                list_swap(items, end - 1, end - rightSize / 4)
            }
        } else if (packed % 2 == 1) {
            if (listPartialInsertionSort(items, begin, pivotAt, order)
                    and listPartialInsertionSort(items, pivotAt + 1, end, order)) {
                return
            }
        }

        listSortRange(items, begin, pivotAt, order, bad, atLeft, offL, offR)
        begin = pivotAt + 1
        atLeft = false
    }
}

// v0.1's bar: `items.sort()`.
//
// In place, and **not stable** -- equal elements may be reordered. A stable sort
// needs a scratch buffer and is a different function, not a flag on this one.
//
// **One line, because `sortBy` is the implementation and `Ord` is one comparator
// among others.** The closure's parameters are written `a: T, b: T` inside a
// generic body: substitution rewrites them to the concrete types before sema sees
// them, and each instantiation lowers its own closure type. Which is a fair test
// of 3.4's lowering, and it passes.
public fn sort<T: Ord>(inout items: Vec<T>) {
    sortBy(items, |a: T, b: T| cmp(a, b))
}

// The same sort under a caller's ordering. `order(a, b)` answers negative, zero
// or positive the way `cmp` does.
//
// No bound on `T` at all -- the comparator supplies the order, so the element
// type needs nothing. That is the difference between a bounded generic and a
// higher-order one, and having both is why `sortBy` can sort a type whose author
// never wrote an `impl Ord`.
public fn sortBy<T, F>(inout items: Vec<T>, order: F) {
    let n = list_len(items)
    if (n < listSortInsertionCutoff()) {
        listInsertionSort(items, 0, n, order)
        return
    }
    // log2(n) + 1 badly unbalanced partitions before heapsort takes a range over.
    let mut badAllowed = 1
    let mut rest = n
    while (rest > 1) {
        badAllowed = badAllowed + 1
        rest = rest / 2
    }
    // The partition's offset buffers, once for the whole sort rather than per
    // partition. A list short enough for insertion sort returned above without
    // paying for them.
    let mut offL: Vec<Int> = list_new_with_capacity(listSortBlock())
    let mut offR: Vec<Int> = list_new_with_capacity(listSortBlock())
    let mut i = 0
    while (i < listSortBlock()) {
        list_push(offL, 0)
        list_push(offR, 0)
        i = i + 1
    }
    listSortRange(items, 0, n, order, badAllowed, true, offL, offR)
}

public fn isSorted<T: Ord>(items: Vec<T>) -> Bool {
    let n = list_len(items)
    let mut i = 1
    while (i < n) {
        let left = list_get(items, i - 1)
        let right = list_get(items, i)
        if (cmp(left, right) > 0) { return false }
        i = i + 1
    }
    return true
}

// The index of `needle`, or -1. Requires a sorted list and does not check that
// it got one -- checking would cost the linear scan the binary search exists to
// avoid. On an unsorted list the answer is unspecified, not unsafe.
//
// `low + (high - low) / 2` rather than `(low + high) / 2`: the second overflows
// once a list is longer than half the Int range, which is the oldest bug in this
// algorithm and costs nothing to avoid.
public fn binarySearch<T: Ord>(items: Vec<T>, needle: T) -> Int {
    let mut low = 0
    let mut high = list_len(items) - 1
    while (low <= high) {
        let mid = low + (high - low) / 2
        let at = list_get(items, mid)
        let order = cmp(at, needle)
        if (order == 0) { return mid }
        if (order < 0) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return 0 - 1
}

// ---------------------------------------------------------------------------
// Methods
// ---------------------------------------------------------------------------

// The element at `index`, or `none` outside `[0, length)` -- where `v[i]`
// answers the element type's zero.
public fn get<T: Copy>(items: Vec<T>, index: Int) -> T? {
    if (index < 0 or index >= list_len(items)) { return none }
    return copyOf(list_get(items, index))
}

public fn contains<T: Eq>(items: Vec<T>, needle: T) -> Bool {
    return indexOf(items, needle) >= 0
}

// The first position holding `needle`, or -1.
public fn indexOf<T: Eq>(items: Vec<T>, needle: T) -> Int {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        if (Eq.eq(list_get(items, i), needle)) { return i }
        i = i + 1
    }
    return 0 - 1
}

// The last position holding `needle`, or -1.
public fn lastIndexOf<T: Eq>(items: Vec<T>, needle: T) -> Int {
    let mut i = list_len(items) - 1
    while (i >= 0) {
        if (Eq.eq(list_get(items, i), needle)) { return i }
        i = i - 1
    }
    return 0 - 1
}

// How many elements equal `needle`. Not `count`, which String spends on the
// same question about a substring and which a Vec of Strings would make
// ambiguous at the call.
public fn countOf<T: Eq>(items: Vec<T>, needle: T) -> Int {
    let n = list_len(items)
    let mut found = 0
    let mut i = 0
    while (i < n) {
        if (Eq.eq(list_get(items, i), needle)) { found = found + 1 }
        i = i + 1
    }
    return found
}

// The same four searches over an array. A `[T]` parameter does not know how long
// it is, so the length is passed beside it; `a.contains(x)` supplies the `N` in
// `a`'s type (src/sema/array.psm), and a parameter's owner writes `contains(xs, n, x)`.
public fn contains<T: Eq>(items: [T], count: Int, needle: T) -> Bool {
    return indexOf(items, count, needle) >= 0
}

public fn indexOf<T: Eq>(items: [T], count: Int, needle: T) -> Int {
    for i in 0..<count {
        if (Eq.eq(items[i], needle)) { return i }
    }
    return 0 - 1
}

public fn lastIndexOf<T: Eq>(items: [T], count: Int, needle: T) -> Int {
    let mut i = count - 1
    while (i >= 0) {
        if (Eq.eq(items[i], needle)) { return i }
        i = i - 1
    }
    return 0 - 1
}

public fn countOf<T: Eq>(items: [T], count: Int, needle: T) -> Int {
    let mut found = 0
    for i in 0..<count {
        if (Eq.eq(items[i], needle)) { found = found + 1 }
    }
    return found
}

// Appends a copy of every element of `other`, which is left as it was.
public fn extend<T: Copy>(inout items: Vec<T>, other: Vec<T>) {
    let n = list_len(other)
    list_reserve(items, list_len(items) + n)
    let mut i = 0
    while (i < n) {
        list_push(items, copyOf(list_get(other, i)))
        i = i + 1
    }
}

// In place. A permutation, so nothing is copied and nothing is released.
public fn reverse<T>(inout items: Vec<T>) {
    let mut low = 0
    let mut high = list_len(items) - 1
    while (low < high) {
        list_swap(items, low, high)
        low = low + 1
        high = high - 1
    }
}

// A new Vec holding a copy of every element.
public fn clone<T: Copy>(items: Vec<T>) -> Vec<T> {
    let n = list_len(items)
    let mut out: Vec<T> = list_new_with_capacity(n)
    let mut i = 0
    while (i < n) {
        list_push(out, copyOf(list_get(items, i)))
        i = i + 1
    }
    return out
}

// `Vec<T>.filled(count, value)` for a `T` that is not a scalar: `count` copies
// of `value`. A scalar never gets here -- the compiler lowers it onto the
// runtime's one-pass fill -- so this is the `String` and struct case, where each
// element has to be its own copy. `count` below zero is refused as the runtime's
// is.
public fn vecFilled<T: Copy>(count: Int, value: T) -> Vec<T> {
    if (count < 0) { panic("Vec.filled count must not be negative") }
    let mut out: Vec<T> = list_new_with_capacity(count)
    let mut i = 0
    while (i < count) {
        list_push(out, copyOf(value))
        i = i + 1
    }
    return out
}

// The last element, removed, or `none` when there is none.
public fn pop<T: Copy>(inout items: Vec<T>) -> T? {
    let n = list_len(items)
    if (n == 0) { return none }
    let taken = copyOf(list_get(items, n - 1))
    list_truncate(items, n - 1)
    return taken
}

// The element at `index`, removed, with everything after it moved down one. An
// index outside `[0, length)` is a runtime error, not an empty answer: the
// caller would otherwise be holding a copy of an element it did not take.
public fn removeAt<T: Copy>(inout items: Vec<T>, index: Int) -> T {
    // Out of range, the runtime reports and exits here, before a boxed element's
    // read answers a null the copy would follow.
    if (index < 0 or index >= list_len(items)) { list_remove_at(items, index) }
    let taken = copyOf(list_get(items, index))
    list_remove_at(items, index)
    return taken
}

// ---------------------------------------------------------------------------
// v0.1 3.4 -- the higher-order half
// ---------------------------------------------------------------------------

// The elements a predicate keeps, in order.
//
// `T: Copy` because the result owns its elements: `list_push(out, x)` where `x`
// came from `list_get` is "cannot move out of borrowed value", so the kept
// elements are duplicated. `copyOf` is the identity for every scalar.
public fn filter<T: Copy, F>(items: Vec<T>, keep: F) -> Vec<T> {
    let n = list_len(items)
    let mut out: Vec<T> = list_new()
    let mut i = 0
    while (i < n) {
        let element = list_get(items, i)
        if (keep(element)) { list_push(out, copyOf(element)) }
        i = i + 1
    }
    return out
}

// `f` applied to every element, appended to `out`.
//
// **The output list is a parameter rather than a return value, and that is
// forced.** A `map` that returned `Vec<U>` would have to solve `U` from the
// closure's *return* type, and this compiler solves a type parameter from
// argument types only -- writing it explicitly is no escape either, because the
// closure's own type has no spelling. Taking the destination as an argument puts
// `U` in argument position, where it is solvable.
public fn mapInto<T, U, F>(items: Vec<T>, inout out: Vec<U>, f: F) {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        list_push(out, f(list_get(items, i)))
        i = i + 1
    }
}

public fn countWhere<T, F>(items: Vec<T>, keep: F) -> Int {
    let n = list_len(items)
    let mut found = 0
    let mut i = 0
    while (i < n) {
        if (keep(list_get(items, i))) { found = found + 1 }
        i = i + 1
    }
    return found
}

public fn any<T, F>(items: Vec<T>, keep: F) -> Bool {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        if (keep(list_get(items, i))) { return true }
        i = i + 1
    }
    return false
}

public fn all<T, F>(items: Vec<T>, keep: F) -> Bool {
    let n = list_len(items)
    let mut i = 0
    while (i < n) {
        if (keep(list_get(items, i)) == false) { return false }
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------------------
// The rest of the 0.1 table (docs/COLLECTION_METHODS_PLAN.md, 1.2)
// ---------------------------------------------------------------------------

// The smallest and the largest element, or `none` when there is none. The first
// of equal elements wins, so `min` and `max` agree on which one they mean.
public fn min<T: Ord + Copy>(items: Vec<T>) -> T? {
    let n = list_len(items)
    if (n == 0) { return none }
    let mut best = 0
    for i in 1..<n {
        if (cmp(list_get(items, i), list_get(items, best)) < 0) { best = i }
    }
    return copyOf(list_get(items, best))
}

public fn max<T: Ord + Copy>(items: Vec<T>) -> T? {
    let n = list_len(items)
    if (n == 0) { return none }
    let mut best = 0
    for i in 1..<n {
        if (cmp(list_get(items, i), list_get(items, best)) > 0) { best = i }
    }
    return copyOf(list_get(items, best))
}

// The first element `keep` accepts, or `none`. `T: Copy` for `get`'s reason.
public fn find<T: Copy, F>(items: Vec<T>, keep: F) -> T? {
    let n = list_len(items)
    for i in 0..<n {
        let element = list_get(items, i)
        if (keep(element)) { return copyOf(element) }
    }
    return none
}

// The position of the first element `keep` accepts, or -1, as `indexOf` answers.
public fn indexWhere<T, F>(items: Vec<T>, keep: F) -> Int {
    let n = list_len(items)
    for i in 0..<n {
        if (keep(list_get(items, i))) { return i }
    }
    return 0 - 1
}

public fn forEach<T, F>(items: Vec<T>, f: F) {
    let n = list_len(items)
    for i in 0..<n {
        f(list_get(items, i))
    }
}

// `f` folded over the elements from `initial`, left to right. The result type is
// solved from `initial`, an argument, which is why this one can return a value
// and `map` cannot (see `mapInto`). `U: Copy` because the accumulator is handed
// to `f` and back, and a parameter cannot be moved out of.
public fn fold<T, U: Copy, F>(items: Vec<T>, initial: U, f: F) -> U {
    let n = list_len(items)
    let mut accumulated = copyOf(initial)
    for i in 0..<n {
        accumulated = f(accumulated, list_get(items, i))
    }
    return accumulated
}

// The first element, removed, with the rest moved down one; `none` when empty.
public fn removeFirst<T: Copy>(inout items: Vec<T>) -> T? {
    if (list_len(items) == 0) { return none }
    let taken = copyOf(list_get(items, 0))
    list_remove_at(items, 0)
    return taken
}

// The element at `index`, removed by moving the last element into its place:
// constant time, and the order is not kept. Out of range is a runtime error, as
// it is for `removeAt`.
public fn swapRemove<T: Copy>(inout items: Vec<T>, index: Int) -> T {
    let last = list_len(items) - 1
    if (index < 0 or index > last) { list_remove_at(items, index) }
    let taken = copyOf(list_get(items, index))
    list_swap(items, index, last)
    list_truncate(items, last)
    return taken
}

// Keeps the elements `keep` accepts, in their order, in place. The kept ones are
// swapped forward and the rest are truncated off the end, so nothing is copied
// and no element needs `Copy`: a swap is a permutation, and the truncation
// releases what it drops.
public fn retain<T, F>(inout items: Vec<T>, keep: F) {
    let n = list_len(items)
    let mut write = 0
    for read in 0..<n {
        if (keep(list_get(items, read))) {
            if (read != write) { list_swap(items, write, read) }
            write = write + 1
        }
    }
    list_truncate(items, write)
}

// Removes each element equal to the one before it, so `[1, 1, 2, 1]` becomes
// `[1, 2, 1]`; sort first to remove every repeat. In place, for `retain`'s reason.
public fn dedup<T: Eq>(inout items: Vec<T>) {
    let n = list_len(items)
    if (n < 2) { return }
    let mut write = 1
    for read in 1..<n {
        if (Eq.eq(list_get(items, read), list_get(items, write - 1)) == false) {
            if (read != write) { list_swap(items, write, read) }
            write = write + 1
        }
    }
    list_truncate(items, write)
}

// The copying forms of `sort` and `reverse`: a new Vec, and `items` is as it was.
public fn sorted<T: Ord + Copy>(items: Vec<T>) -> Vec<T> {
    let mut out = clone(items)
    sort(out)
    return out
}

public fn reversed<T: Copy>(items: Vec<T>) -> Vec<T> {
    let mut out = clone(items)
    reverse(out)
    return out
}

// The first `count` elements, and everything after them. A count past either end
// clamps, so `take` and `skip` never fail and `take(n)` + `skip(n)` is the Vec.
// `skip` and not `drop`, which is the compiler's own release.
public fn take<T: Copy>(items: Vec<T>, count: Int) -> Vec<T> {
    let n = list_len(items)
    let mut end = count
    if (end > n) { end = n }
    if (end < 0) { end = 0 }
    let mut out: Vec<T> = list_new_with_capacity(end)
    for i in 0..<end {
        list_push(out, copyOf(list_get(items, i)))
    }
    return out
}

public fn skip<T: Copy>(items: Vec<T>, count: Int) -> Vec<T> {
    let n = list_len(items)
    let mut start = count
    if (start > n) { start = n }
    if (start < 0) { start = 0 }
    let mut out: Vec<T> = list_new_with_capacity(n - start)
    for i in start..<n {
        list_push(out, copyOf(list_get(items, i)))
    }
    return out
}

// Every element becomes a copy of `value`; the length is unchanged.
public fn fill<T: Copy>(inout items: Vec<T>, value: T) {
    let n = list_len(items)
    for i in 0..<n {
        list_set(items, i, copyOf(value))
    }
}

// Whether `items` begins, or ends, with the elements of `other`, in order.
public fn startsWith<T: Eq>(items: Vec<T>, other: Vec<T>) -> Bool {
    let m = list_len(other)
    if (m > list_len(items)) { return false }
    for i in 0..<m {
        if (Eq.eq(list_get(items, i), list_get(other, i)) == false) { return false }
    }
    return true
}

public fn endsWith<T: Eq>(items: Vec<T>, other: Vec<T>) -> Bool {
    let m = list_len(other)
    let offset = list_len(items) - m
    if (offset < 0) { return false }
    for i in 0..<m {
        if (Eq.eq(list_get(items, offset + i), list_get(other, i)) == false) { return false }
    }
    return true
}

// A new Vec holding the elements of `items`, then those of `other`. Both are as
// they were; `extend` is the in-place form.
public fn concat<T: Copy>(items: Vec<T>, other: Vec<T>) -> Vec<T> {
    let mut out = clone(items)
    extend(out, other)
    return out
}

// ---------------------------------------------------------------------------
// Arrays and slices (docs/COLLECTION_METHODS_PLAN.md, 1.4)
// ---------------------------------------------------------------------------
//
// **An array takes its length beside it.** A `[T]` parameter does not know how
// long it is, so each function below has the array first and `count` second;
// `a.min()` is `min(a, N, ...)`, the call site supplying the `N` in `a`'s type
// (src/sema/array.psm), and a parameter's owner writes `min(xs, n)` by hand. The
// four searches above are the first of them.
//
// **A slice carries its length**, so its overloads are the Vec's with `Slice<T>`
// for `Vec<T>` and `.length` for `list_len`; they need no help from the compiler.
//
// The element reads go through `items[i]` and not `list_get`, which a `[T]` and a
// `Slice<T>` do not accept.

public fn min<T: Ord + Copy>(items: [T], count: Int) -> T? {
    if (count == 0) { return none }
    let mut best = 0
    for i in 1..<count {
        if (cmp(items[i], items[best]) < 0) { best = i }
    }
    return copyOf(items[best])
}

public fn max<T: Ord + Copy>(items: [T], count: Int) -> T? {
    if (count == 0) { return none }
    let mut best = 0
    for i in 1..<count {
        if (cmp(items[i], items[best]) > 0) { best = i }
    }
    return copyOf(items[best])
}

public fn isSorted<T: Ord>(items: [T], count: Int) -> Bool {
    for i in 1..<count {
        if (cmp(items[i - 1], items[i]) > 0) { return false }
    }
    return true
}

public fn binarySearch<T: Ord>(items: [T], count: Int, needle: T) -> Int {
    let mut low = 0
    let mut high = count - 1
    while (low <= high) {
        let mid = low + (high - low) / 2
        let order = cmp(items[mid], needle)
        if (order == 0) { return mid }
        if (order < 0) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return 0 - 1
}

public fn any<T, F>(items: [T], count: Int, keep: F) -> Bool {
    for i in 0..<count {
        if (keep(items[i])) { return true }
    }
    return false
}

public fn all<T, F>(items: [T], count: Int, keep: F) -> Bool {
    for i in 0..<count {
        if (keep(items[i]) == false) { return false }
    }
    return true
}

public fn countWhere<T, F>(items: [T], count: Int, keep: F) -> Int {
    let mut found = 0
    for i in 0..<count {
        if (keep(items[i])) { found = found + 1 }
    }
    return found
}

public fn find<T: Copy, F>(items: [T], count: Int, keep: F) -> T? {
    for i in 0..<count {
        if (keep(items[i])) { return copyOf(items[i]) }
    }
    return none
}

public fn indexWhere<T, F>(items: [T], count: Int, keep: F) -> Int {
    for i in 0..<count {
        if (keep(items[i])) { return i }
    }
    return 0 - 1
}

public fn forEach<T, F>(items: [T], count: Int, f: F) {
    for i in 0..<count {
        f(items[i])
    }
}

public fn fold<T, U: Copy, F>(items: [T], count: Int, initial: U, f: F) -> U {
    let mut accumulated = copyOf(initial)
    for i in 0..<count {
        accumulated = f(accumulated, items[i])
    }
    return accumulated
}

// A new Vec holding a copy of every element: the way from an array to the Vec
// methods that return a Vec (`a.toVec().sorted()`).
public fn toVec<T: Copy>(items: [T], count: Int) -> Vec<T> {
    let mut out: Vec<T> = list_new_with_capacity(count)
    for i in 0..<count {
        list_push(out, copyOf(items[i]))
    }
    return out
}

// The in-place changes. An array stores an element only when nothing owns it
// (sema refuses the store otherwise), so these take scalars, `Bool`, `Char` and
// enums without payloads, and say so for anything else at the store.

public fn reverse<T: Copy>(inout items: [T], count: Int) {
    let mut low = 0
    let mut high = count - 1
    while (low < high) {
        let held = copyOf(items[low])
        items[low] = items[high]
        items[high] = held
        low = low + 1
        high = high - 1
    }
}

public fn swap<T: Copy>(inout items: [T], count: Int, first: Int, second: Int) {
    if (first < 0 or first >= count or second < 0 or second >= count) {
        panic("array swap index out of range")
    }
    let held = copyOf(items[first])
    items[first] = items[second]
    items[second] = held
}

public fn fill<T: Copy>(inout items: [T], count: Int, value: T) {
    for i in 0..<count {
        items[i] = copyOf(value)
    }
}

// Sorted through a Vec: the elements are copied out, sorted by the one sort this
// library has, and copied back. One allocation, and nothing about the order is
// different from `Vec.sort`'s -- in place, not stable.
public fn sort<T: Ord + Copy>(inout items: [T], count: Int) {
    let mut scratch = toVec(items, count)
    sort(scratch)
    for i in 0..<count {
        items[i] = copyOf(list_get(scratch, i))
    }
}

public fn sortBy<T: Copy, F>(inout items: [T], count: Int, order: F) {
    let mut scratch = toVec(items, count)
    sortBy(scratch, order)
    for i in 0..<count {
        items[i] = copyOf(list_get(scratch, i))
    }
}

// The same reads over a slice, which carries its own length.

public fn contains<T: Eq>(items: Slice<T>, needle: T) -> Bool {
    return indexOf(items, needle) >= 0
}

public fn indexOf<T: Eq>(items: Slice<T>, needle: T) -> Int {
    for i in 0..<items.length {
        if (Eq.eq(items[i], needle)) { return i }
    }
    return 0 - 1
}

public fn lastIndexOf<T: Eq>(items: Slice<T>, needle: T) -> Int {
    let mut i = items.length - 1
    while (i >= 0) {
        if (Eq.eq(items[i], needle)) { return i }
        i = i - 1
    }
    return 0 - 1
}

public fn countOf<T: Eq>(items: Slice<T>, needle: T) -> Int {
    let mut found = 0
    for i in 0..<items.length {
        if (Eq.eq(items[i], needle)) { found = found + 1 }
    }
    return found
}

public fn min<T: Ord + Copy>(items: Slice<T>) -> T? {
    let n = items.length
    if (n == 0) { return none }
    let mut best = 0
    for i in 1..<n {
        if (cmp(items[i], items[best]) < 0) { best = i }
    }
    return copyOf(items[best])
}

public fn max<T: Ord + Copy>(items: Slice<T>) -> T? {
    let n = items.length
    if (n == 0) { return none }
    let mut best = 0
    for i in 1..<n {
        if (cmp(items[i], items[best]) > 0) { best = i }
    }
    return copyOf(items[best])
}

public fn isSorted<T: Ord>(items: Slice<T>) -> Bool {
    for i in 1..<items.length {
        if (cmp(items[i - 1], items[i]) > 0) { return false }
    }
    return true
}

public fn binarySearch<T: Ord>(items: Slice<T>, needle: T) -> Int {
    let mut low = 0
    let mut high = items.length - 1
    while (low <= high) {
        let mid = low + (high - low) / 2
        let order = cmp(items[mid], needle)
        if (order == 0) { return mid }
        if (order < 0) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return 0 - 1
}

public fn any<T, F>(items: Slice<T>, keep: F) -> Bool {
    for i in 0..<items.length {
        if (keep(items[i])) { return true }
    }
    return false
}

public fn all<T, F>(items: Slice<T>, keep: F) -> Bool {
    for i in 0..<items.length {
        if (keep(items[i]) == false) { return false }
    }
    return true
}

public fn countWhere<T, F>(items: Slice<T>, keep: F) -> Int {
    let mut found = 0
    for i in 0..<items.length {
        if (keep(items[i])) { found = found + 1 }
    }
    return found
}

public fn find<T: Copy, F>(items: Slice<T>, keep: F) -> T? {
    for i in 0..<items.length {
        if (keep(items[i])) { return copyOf(items[i]) }
    }
    return none
}

public fn indexWhere<T, F>(items: Slice<T>, keep: F) -> Int {
    for i in 0..<items.length {
        if (keep(items[i])) { return i }
    }
    return 0 - 1
}

public fn forEach<T, F>(items: Slice<T>, f: F) {
    for i in 0..<items.length {
        f(items[i])
    }
}

public fn fold<T, U: Copy, F>(items: Slice<T>, initial: U, f: F) -> U {
    let mut accumulated = copyOf(initial)
    for i in 0..<items.length {
        accumulated = f(accumulated, items[i])
    }
    return accumulated
}

// The way from a slice to a Vec of its own, and from a Vec to a copy of itself
// under the name the array and the slice use.
public fn toVec<T: Copy>(items: Slice<T>) -> Vec<T> {
    let n = items.length
    let mut out: Vec<T> = list_new_with_capacity(n)
    for i in 0..<n {
        list_push(out, copyOf(items[i]))
    }
    return out
}

public fn toVec<T: Copy>(items: Vec<T>) -> Vec<T> {
    return clone(items)
}

// The in-place changes over a slice write through to the Vec it views, so they
// need a slice the code may change (`let mut`, or an `inout` parameter) of a Vec
// that is itself changeable, as `slice_set` does.

public fn reverse<T: Copy>(inout items: Slice<T>) {
    let mut low = 0
    let mut high = items.length - 1
    while (low < high) {
        let held = copyOf(items[low])
        items[low] = items[high]
        items[high] = held
        low = low + 1
        high = high - 1
    }
}

public fn swap<T: Copy>(inout items: Slice<T>, first: Int, second: Int) {
    if (first < 0 or first >= items.length or second < 0 or second >= items.length) {
        panic("slice swap index out of range")
    }
    let held = copyOf(items[first])
    items[first] = items[second]
    items[second] = held
}

public fn fill<T: Copy>(inout items: Slice<T>, value: T) {
    for i in 0..<items.length {
        items[i] = copyOf(value)
    }
}

// Sorted through a Vec, as an array is: copied out, sorted, copied back.
public fn sort<T: Ord + Copy>(inout items: Slice<T>) {
    let n = items.length
    let mut scratch = toVec(items)
    sort(scratch)
    for i in 0..<n {
        items[i] = copyOf(list_get(scratch, i))
    }
}

public fn sortBy<T: Copy, F>(inout items: Slice<T>, order: F) {
    let n = items.length
    let mut scratch = toVec(items)
    sortBy(scratch, order)
    for i in 0..<n {
        items[i] = copyOf(list_get(scratch, i))
    }
}
