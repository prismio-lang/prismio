// The print family for anything that can show itself, so `println(version)` works for a type with an
// `impl Display`, and for the optionals std.core.display covers.
//
// **A part of its own, merged only in a program that names `Display`.** A generic `print` beside the
// builtin one would put std.core.display, and std.string under it, into programs that never print
// anything but a literal. The overloads std.io.output has for its own types are exact matches, and an
// exact match wins over these.
module part

import std.io.output
import std.core.display

lang("print_display") public fn print<Ts: Printable>(...args: Ts) {
    let mut first = true
    for arg in args {
        if (first == false) { print(" ") }
        first = false
        print(arg.show())
    }
}

public fn println<Ts: Printable>(...args: Ts) {
    print(...args)
    println()
}

public fn eprint<Ts: Printable>(...args: Ts) {
    let mut first = true
    for arg in args {
        if (first == false) { eprint(" ") }
        first = false
        eprint(arg.show())
    }
}

public fn eprintln<Ts: Printable>(...args: Ts) {
    eprint(...args)
    eprintln()
}
