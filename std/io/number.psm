// `print` and `println` for the floats narrower or wider than `Float`. A part of its own, merged only in
// a program that names one of those types; an integer of any width prints through std.io.output.
module part

import std.io.output
import std.core.number

lang("print_narrow") public fn print(value: F32) { print(f32Text(value)) }
public fn print(value: F16) { print(f16Text(value)) }
public fn print(value: BF16) { print(bf16Text(value)) }
public fn print(value: F128) { print(value.toString()) }

public fn println(value: F32) { println(f32Text(value)) }
public fn println(value: F16) { println(f16Text(value)) }
public fn println(value: BF16) { println(bf16Text(value)) }
public fn println(value: F128) { println(value.toString()) }
