// JSON: reading a document, and writing one.
//
//     import std.json
//
//     let doc = parseJson("{\"method\": \"initialize\", \"params\": {\"processId\": 4242}}")
//     if (doc.ok == false) { println(doc.error) }
//     let method = doc.text(doc.path(doc.root, "method"))      // "initialize"
//     let pid = doc.int(doc.path(doc.root, "params.processId")) // 4242
//
//     let out = JsonWriter()
//     out.beginObject()
//     out.key("jsonrpc")
//     out.string("2.0")
//     out.key("id")
//     out.int(7)
//     out.endObject()
//     println(out.finish())                 // {"jsonrpc":"2.0","id":7}
//
// **A document is a tape, not a tree.** Parsing records every value once, in order, in
// parallel columns -- what kind it is, where in the source it sits, its first child and its
// next sibling -- and a value is then an `Int`, its place on the tape. Nothing is copied out of
// the source until it is asked for, so reading three fields of a megabyte message allocates
// three Strings. The cost is that a handle is only meaningful for the document that made it,
// and that a missing member is `none`, not a null value: JSON's `null` is a value
// (`isNull`), and an absent key is not.
//
// Strictly RFC 8259: no comments, no trailing commas, no raw control characters in a string,
// no leading zeros. Nesting deeper than 256 is refused rather than recursed into.

import std.option
import std.string
import std.vec

enum JsonKind {
    Null,
    Bool,
    Number,
    String,
    Array,
    Object
}

// Kinds as stored in the tape. An enum is its own type and a column of them is a column of
// words either way; plain integers keep the parser's comparisons cheap.
let KIND_NULL = 0
let KIND_BOOL = 1
let KIND_NUMBER = 2
let KIND_STRING = 3
let KIND_ARRAY = 4
let KIND_OBJECT = 5

let MAX_DEPTH = 256

public struct JsonDocument {
    // False when the text was not valid JSON; then `error` and `errorAt` say why and where,
    // and `root` is -1.
    public ok: Bool,
    public error: String,
    // Byte offset of the first thing wrong.
    public errorAt: Int,
    public root: Int,
    source: String,
    kinds: Vec<Int>,
    // The value's bytes in `source`. For a string, those between the quotes.
    starts: Vec<Int>,
    ends: Vec<Int>,
    // 1 for a string that contains a backslash, so decoding is a copy when it is 0.
    escaped: Vec<Int>,
    // An array's elements, or an object's key and value alternating, as a chain.
    firsts: Vec<Int>,
    nexts: Vec<Int>,
    counts: Vec<Int>
}

struct JsonParser {
    text: String,
    length: Int,
    at: Int,
    depth: Int,
    failed: Bool,
    message: String,
    failedAt: Int,
    kinds: Vec<Int>,
    starts: Vec<Int>,
    ends: Vec<Int>,
    escaped: Vec<Int>,
    firsts: Vec<Int>,
    nexts: Vec<Int>,
    counts: Vec<Int>
}

// Reads `text` as one JSON value, with only whitespace around it.
public fn parseJson(text: String) -> JsonDocument {
    let parser = JsonParser {
        text: text.clone(),
        length: text.length,
        at: 0,
        depth: 0,
        failed: false,
        message: "",
        failedAt: 0,
        kinds: [],
        starts: [],
        ends: [],
        escaped: [],
        firsts: [],
        nexts: [],
        counts: []
    }
    parser.skipSpace()
    let root = parser.parseValue()
    parser.skipSpace()
    if (parser.failed == false and parser.at < parser.length) {
        parser.fail("unexpected text after the value")
    }
    let mut start = root
    if (parser.failed) { start = 0 - 1 }
    return JsonDocument {
        ok: parser.failed == false,
        error: parser.message.clone(),
        errorAt: parser.failedAt,
        root: start,
        source: parser.text.clone(),
        kinds: parser.kinds,
        starts: parser.starts,
        ends: parser.ends,
        escaped: parser.escaped,
        firsts: parser.firsts,
        nexts: parser.nexts,
        counts: parser.counts
    }
}

impl JsonParser {
    fn fail(self, message: String) {
        if (self.failed) { return }
        self.failed = true
        self.message = message
        self.failedAt = self.at
    }

    fn peek(self) -> Int {
        if (self.at >= self.length) { return 0 - 1 }
        return self.text.byteAt(self.at) as Int
    }

    fn skipSpace(self) {
        loop {
            let c = self.peek()
            if (c == 32 or c == 9 or c == 10 or c == 13) {
                self.at = self.at + 1
            } else {
                break
            }
        }
    }

    // A node whose bytes are known, its children not yet.
    fn add(self, kind: Int, start: Int, end: Int) -> Int {
        let node = self.kinds.length
        self.kinds.push(kind)
        self.starts.push(start)
        self.ends.push(end)
        self.escaped.push(0)
        self.firsts.push(0 - 1)
        self.nexts.push(0 - 1)
        self.counts.push(0)
        return node
    }

    fn expectWord(self, word: String, kind: Int) -> Int {
        let start = self.at
        if (self.length - self.at < word.length or self.text.substring(self.at, word.length).equals(word) == false) {
            self.fail("expected a JSON value")
            return 0 - 1
        }
        self.at = self.at + word.length
        return self.add(kind, start, self.at)
    }

    fn parseValue(self) -> Int {
        if (self.failed) { return 0 - 1 }
        let c = self.peek()
        if (c == 123) { return self.parseObject() }
        if (c == 91) { return self.parseArray() }
        if (c == 34) { return self.parseString() }
        if (c == 116) { return self.expectWord("true", KIND_BOOL) }
        if (c == 102) { return self.expectWord("false", KIND_BOOL) }
        if (c == 110) { return self.expectWord("null", KIND_NULL) }
        if (c == 45 or (c >= 48 and c <= 57)) { return self.parseNumber() }
        self.fail("expected a JSON value")
        return 0 - 1
    }

    fn digits(self) -> Int {
        let start = self.at
        loop {
            let c = self.peek()
            if (c >= 48 and c <= 57) { self.at = self.at + 1 } else { break }
        }
        return self.at - start
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
    fn parseNumber(self) -> Int {
        let start = self.at
        if (self.peek() == 45) { self.at = self.at + 1 }
        let leading = self.peek()
        let firstDigit = self.at
        let whole = self.digits()
        if (whole == 0) {
            self.fail("expected a digit")
            return 0 - 1
        }
        if (leading == 48 and whole > 1) {
            self.at = firstDigit + 1
            self.fail("a number cannot have a leading zero")
            return 0 - 1
        }
        if (self.peek() == 46) {
            self.at = self.at + 1
            if (self.digits() == 0) {
                self.fail("expected a digit after the decimal point")
                return 0 - 1
            }
        }
        let e = self.peek()
        if (e == 101 or e == 69) {
            self.at = self.at + 1
            let sign = self.peek()
            if (sign == 43 or sign == 45) { self.at = self.at + 1 }
            if (self.digits() == 0) {
                self.fail("expected a digit in the exponent")
                return 0 - 1
            }
        }
        return self.add(KIND_NUMBER, start, self.at)
    }

    fn parseString(self) -> Int {
        self.at = self.at + 1
        let start = self.at
        let mut hasEscape = 0
        loop {
            let c = self.peek()
            if (c < 0) {
                self.fail("unterminated string")
                return 0 - 1
            }
            if (c == 34) { break }
            if (c < 32) {
                self.fail("a control character in a string must be escaped")
                return 0 - 1
            }
            if (c == 92) {
                hasEscape = 1
                self.at = self.at + 1
                let next = self.peek()
                if (next < 0) {
                    self.fail("unterminated string")
                    return 0 - 1
                }
            }
            self.at = self.at + 1
        }
        let node = self.add(KIND_STRING, start, self.at)
        self.escaped[node] = hasEscape
        self.at = self.at + 1
        return node
    }

    fn parseArray(self) -> Int {
        let start = self.at
        self.at = self.at + 1
        self.depth = self.depth + 1
        if (self.depth > MAX_DEPTH) {
            self.fail("nested more than 256 deep")
            return 0 - 1
        }
        let node = self.add(KIND_ARRAY, start, start)
        let mut last = 0 - 1
        self.skipSpace()
        if (self.peek() == 93) {
            self.at = self.at + 1
        } else {
            loop {
                self.skipSpace()
                let element = self.parseValue()
                if (self.failed) { return 0 - 1 }
                last = self.link(node, last, element)
                self.skipSpace()
                let c = self.peek()
                self.at = self.at + 1
                if (c == 93) { break }
                if (c != 44) {
                    self.at = self.at - 1
                    self.fail("expected `,` or `]`")
                    return 0 - 1
                }
            }
        }
        self.ends[node] = self.at
        self.depth = self.depth - 1
        return node
    }

    fn parseObject(self) -> Int {
        let start = self.at
        self.at = self.at + 1
        self.depth = self.depth + 1
        if (self.depth > MAX_DEPTH) {
            self.fail("nested more than 256 deep")
            return 0 - 1
        }
        let node = self.add(KIND_OBJECT, start, start)
        let mut last = 0 - 1
        self.skipSpace()
        if (self.peek() == 125) {
            self.at = self.at + 1
        } else {
            loop {
                self.skipSpace()
                if (self.peek() != 34) {
                    self.fail("expected a string for the member name")
                    return 0 - 1
                }
                let name = self.parseString()
                if (self.failed) { return 0 - 1 }
                self.skipSpace()
                if (self.peek() != 58) {
                    self.fail("expected `:` after the member name")
                    return 0 - 1
                }
                self.at = self.at + 1
                self.skipSpace()
                let value = self.parseValue()
                if (self.failed) { return 0 - 1 }
                last = self.link(node, last, name)
                last = self.link(node, last, value)
                self.counts[node] = self.counts[node] + 1
                self.skipSpace()
                let c = self.peek()
                self.at = self.at + 1
                if (c == 125) { break }
                if (c != 44) {
                    self.at = self.at - 1
                    self.fail("expected `,` or `}`")
                    return 0 - 1
                }
            }
        }
        self.ends[node] = self.at
        self.depth = self.depth - 1
        return node
    }

    // Appends `child` after `last` in `parent`'s chain, and answers it as the new last.
    fn link(self, parent: Int, last: Int, child: Int) -> Int {
        if (last < 0) {
            self.firsts[parent] = child
        } else {
            self.nexts[last] = child
        }
        if (self.kinds[parent] == KIND_ARRAY) {
            self.counts[parent] = self.counts[parent] + 1
        }
        return child
    }
}

fn isHexDigit(c: Int) -> Bool {
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

fn hexValue(c: Int) -> Int {
    if (c >= 48 and c <= 57) { return c - 48 }
    if (c >= 97 and c <= 102) { return c - 87 }
    return c - 55
}

fn byteText(code: Int) -> String {
    return (code as Char).toString()
}

// A Unicode scalar value as UTF-8.
fn utf8Text(code: Int) -> String {
    if (code < 128) { return byteText(code) }
    if (code < 2048) { return byteText(192 + code / 64).concat(byteText(128 + code % 64)) }
    if (code < 65536) {
        return byteText(224 + code / 4096).concat(byteText(128 + (code / 64) % 64), byteText(128 + code % 64))
    }
    return byteText(240 + code / 262144).concat(byteText(128 + (code / 4096) % 64),
                                                byteText(128 + (code / 64) % 64),
                                                byteText(128 + code % 64))
}

impl JsonDocument {
    public fn kind(self, node: Int) -> JsonKind {
        let k = self.kinds[node]
        if (k == KIND_BOOL) { return JsonKind.Bool }
        if (k == KIND_NUMBER) { return JsonKind.Number }
        if (k == KIND_STRING) { return JsonKind.String }
        if (k == KIND_ARRAY) { return JsonKind.Array }
        if (k == KIND_OBJECT) { return JsonKind.Object }
        return JsonKind.Null
    }

    public fn isNull(self, node: Int) -> Bool {
        return node >= 0 and self.kinds[node] == KIND_NULL
    }

    public fn isObject(self, node: Int) -> Bool {
        return node >= 0 and self.kinds[node] == KIND_OBJECT
    }

    public fn isArray(self, node: Int) -> Bool {
        return node >= 0 and self.kinds[node] == KIND_ARRAY
    }

    // How many elements an array has, or members an object has; 0 for anything else.
    public fn length(self, node: Int) -> Int {
        if (node < 0) { return 0 }
        let k = self.kinds[node]
        if (k != KIND_ARRAY and k != KIND_OBJECT) { return 0 }
        return self.counts[node]
    }

    // The value of `name` in an object, or `none` if there is no such member (or `node` is not
    // an object). With a repeated name, the last one, as most readers do.
    public fn member(self, node: Int, name: String) -> Int? {
        if (self.isObject(node) == false) { return none }
        let mut found: Int? = none
        let mut key = self.firsts[node]
        while (key >= 0) {
            let value = self.nexts[key]
            if (self.text(key).equals(name)) { found = value }
            key = self.nexts[value]
        }
        return found
    }

    // The `index`th element of an array, or `none`.
    public fn element(self, node: Int, index: Int) -> Int? {
        if (self.isArray(node) == false or index < 0 or index >= self.counts[node]) { return none }
        let mut at = self.firsts[node]
        let mut i = 0
        while (i < index) {
            at = self.nexts[at]
            i = i + 1
        }
        return at
    }

    // The elements of an array, or the values of an object, in order.
    public fn children(self, node: Int) -> Vec<Int> {
        let mut out: Vec<Int> = []
        if (self.isArray(node)) {
            let mut at = self.firsts[node]
            while (at >= 0) {
                out.push(at)
                at = self.nexts[at]
            }
        } else if (self.isObject(node)) {
            let mut key = self.firsts[node]
            while (key >= 0) {
                let value = self.nexts[key]
                out.push(value)
                key = self.nexts[value]
            }
        }
        return out
    }

    // An object's member names, in order.
    public fn keys(self, node: Int) -> Vec<String> {
        let mut out: Vec<String> = []
        if (self.isObject(node)) {
            let mut key = self.firsts[node]
            while (key >= 0) {
                out.push(self.text(key))
                key = self.nexts[self.nexts[key]]
            }
        }
        return out
    }

    // A dotted path through nested objects: `path(root, "params.textDocument.uri")`.
    // Names containing a dot cannot be reached this way; use `member`. `none` if any
    // step is missing.
    public fn path(self, node: Int, dotted: String) -> Int? {
        let mut at = node
        for step in dotted.split(".") {
            let next = self.member(at, step)
            if (next == none) { return none }
            at = expect(next)
        }
        return at
    }

    // A string value's characters with its escapes decoded, "" for any other kind.
    public fn text(self, node: Int) -> String {
        if (node < 0 or self.kinds[node] != KIND_STRING) { return "" }
        let start = self.starts[node]
        let raw = self.source.substring(start, self.ends[node] - start)
        if (self.escaped[node] == 0) { return raw }
        return decodeEscapes(raw)
    }

    // A number as an integer, or the bool/number/string under `node` read leniently:
    // 0 when it is not a number, and the part before the point of a decimal.
    public fn int(self, node: Int) -> Int {
        if (node < 0 or self.kinds[node] != KIND_NUMBER) { return 0 }
        let start = self.starts[node]
        let whole = self.source.substring(start, self.ends[node] - start)
        return whole.parseInt().unwrapOr(whole.parseFloat().unwrapOr(0.0) as Int)
    }

    public fn float(self, node: Int) -> Float {
        if (node < 0 or self.kinds[node] != KIND_NUMBER) { return 0.0 }
        let start = self.starts[node]
        return self.source.substring(start, self.ends[node] - start).parseFloat().unwrapOr(0.0)
    }

    public fn bool(self, node: Int) -> Bool {
        if (node < 0 or self.kinds[node] != KIND_BOOL) { return false }
        return self.source.byteAt(self.starts[node]) == 116
    }

    // The value exactly as written, to put back unchanged: a JSON-RPC response echoes the
    // request's `id`, which may be a number or a string and must come back as the same one.
    public fn raw(self, node: Int) -> String {
        if (node < 0) { return "null" }
        let mut start = self.starts[node]
        let mut end = self.ends[node]
        if (self.kinds[node] == KIND_STRING) {
            start = start - 1
            end = end + 1
        }
        return self.source.substring(start, end - start)
    }

    // Where in the source the value begins, for a message about it.
    public fn offset(self, node: Int) -> Int {
        if (node < 0) { return 0 }
        return self.starts[node]
    }
}

// The characters a string's backslash escapes stand for. `raw` was accepted by the
// parser, so every escape is one of the eight single-character ones or `\u` with four
// digits -- except that the parser does not look inside, so a bad one becomes U+FFFD
// here rather than failing a document that was otherwise readable.
fn decodeEscapes(raw: String) -> String {
    let mut out = ""
    let mut run = 0
    let mut i = 0
    let n = raw.length
    while (i < n) {
        if (raw.byteAt(i) != 92) {
            i = i + 1
            continue
        }
        if (i > run) { out = out.concat(raw.substring(run, i - run)) }
        let mut e = 0
        if (i + 1 < n) { e = raw.byteAt(i + 1) as Int }
        i = i + 2
        if (e == 110) { out = out.concat("\n") }
        else if (e == 116) { out = out.concat("\t") }
        else if (e == 114) { out = out.concat("\r") }
        else if (e == 98) { out = out.concat(byteText(8)) }
        else if (e == 102) { out = out.concat(byteText(12)) }
        else if (e == 34) { out = out.concat("\"") }
        else if (e == 92) { out = out.concat("\\") }
        else if (e == 47) { out = out.concat("/") }
        else if (e == 117) {
            let high = hexQuad(raw, i)
            i = i + 4
            let mut code = high
            if (high >= 55296 and high <= 56319 and i + 5 < n and raw.byteAt(i) == 92 and raw.byteAt(i + 1) == 117) {
                let low = hexQuad(raw, i + 2)
                if (low >= 56320 and low <= 57343) {
                    code = 65536 + (high - 55296) * 1024 + (low - 56320)
                    i = i + 6
                }
            }
            if (code < 0 or (code >= 55296 and code <= 57343)) { code = 65533 }
            out = out.concat(utf8Text(code))
        } else {
            out = out.concat(utf8Text(65533))
        }
        run = i
    }
    if (n > run) { out = out.concat(raw.substring(run, n - run)) }
    return out
}

// Four hex digits at `at` as a number, or -1.
fn hexQuad(raw: String, at: Int) -> Int {
    if (at + 4 > raw.length) { return 0 - 1 }
    let mut value = 0
    let mut k = 0
    while (k < 4) {
        let c = raw.byteAt(at + k) as Int
        if (isHexDigit(c) == false) { return 0 - 1 }
        value = value * 16 + hexValue(c)
        k = k + 1
    }
    return value
}

// `text` as a JSON string literal, quotes included.
public fn jsonQuote(text: String) -> String {
    let n = text.length
    let mut out = "\""
    let mut run = 0
    let mut i = 0
    while (i < n) {
        let c = text.byteAt(i) as Int
        if (c >= 32 and c != 34 and c != 92) {
            i = i + 1
            continue
        }
        if (i > run) { out = out.concat(text.substring(run, i - run)) }
        if (c == 34) { out = out.concat("\\\"") }
        else if (c == 92) { out = out.concat("\\\\") }
        else if (c == 10) { out = out.concat("\\n") }
        else if (c == 13) { out = out.concat("\\r") }
        else if (c == 9) { out = out.concat("\\t") }
        else if (c == 8) { out = out.concat("\\b") }
        else if (c == 12) { out = out.concat("\\f") }
        else {
            let digits = "0123456789abcdef"
            out = out.concat("\\u00", digits.substring(c / 16, 1), digits.substring(c % 16, 1))
        }
        i = i + 1
        run = i
    }
    if (n > run) { out = out.concat(text.substring(run, n - run)) }
    return out.concat("\"")
}

// Builds a document in one pass. Commas and the colon after a key are the writer's job:
// call `key` before each value inside an object, and just the values inside an array.
//
//     out.beginArray()
//     out.int(1)
//     out.string("two")
//     out.endArray()          // [1,"two"]
public struct JsonWriter {
    pieces: Vec<String>,
    // How many items each open container holds so far.
    counts: Vec<Int>,
    pendingKey: Bool
}

public fn JsonWriter() -> JsonWriter {
    return JsonWriter { pieces: [], counts: [], pendingKey: false }
}

impl JsonWriter {
    // Everything that starts a value goes through here, for the comma.
    fn beforeValue(self) {
        if (self.pendingKey) {
            self.pendingKey = false
            return
        }
        let depth = self.counts.length
        if (depth == 0) { return }
        if (self.counts[depth - 1] > 0) { self.pieces.push(",") }
        self.counts[depth - 1] = self.counts[depth - 1] + 1
    }

    public fn beginObject(self) {
        self.beforeValue()
        self.pieces.push("{")
        self.counts.push(0)
    }

    public fn endObject(self) {
        self.counts.pop()
        self.pieces.push("}")
    }

    public fn beginArray(self) {
        self.beforeValue()
        self.pieces.push("[")
        self.counts.push(0)
    }

    public fn endArray(self) {
        self.counts.pop()
        self.pieces.push("]")
    }

    public fn key(self, name: String) {
        let depth = self.counts.length
        if (depth > 0) {
            if (self.counts[depth - 1] > 0) { self.pieces.push(",") }
            self.counts[depth - 1] = self.counts[depth - 1] + 1
        }
        self.pieces.push(jsonQuote(name))
        self.pieces.push(":")
        self.pendingKey = true
    }

    public fn string(self, text: String) {
        self.beforeValue()
        self.pieces.push(jsonQuote(text))
    }

    public fn int(self, value: Int) {
        self.beforeValue()
        self.pieces.push(value.toString())
    }

    public fn float(self, value: Float) {
        self.beforeValue()
        self.pieces.push(value.toString())
    }

    public fn bool(self, value: Bool) {
        self.beforeValue()
        if (value) { self.pieces.push("true") } else { self.pieces.push("false") }
    }

    public fn null(self) {
        self.beforeValue()
        self.pieces.push("null")
    }

    // JSON that is already written, such as a request's `id` from `raw`.
    public fn raw(self, json: String) {
        self.beforeValue()
        self.pieces.push(json.clone())
    }

    public fn finish(self) -> String {
        return self.pieces.join("")
    }
}
