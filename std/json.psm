// JSON: reading a document, and writing one.
//
//     import std.json
//
//     let doc = parseJson("{\"method\": \"initialize\", \"params\": {\"processId\": 4242}}")
//     if (doc.ok == false) { println(doc.error) }
//     let method = doc.text(doc.path(doc.root, "method"))      // "initialize"
//     let pid = doc.int(doc.path(doc.root, "params.processId")) // 4242
//
//     let out = JsonWriter()
//     out.beginObject()
//     out.key("jsonrpc")
//     out.string("2.0")
//     out.key("id")
//     out.int(7)
//     out.endObject()
//     println(out.finish())                 // {"jsonrpc":"2.0","id":7}
//
// **A document is a tape, not a tree.** Parsing records every value once, in order, in
// parallel columns -- what kind it is, where in the source it sits, its first child and its
// next sibling -- and a value is then an `Int`, its place on the tape. Nothing is copied out of
// the source until it is asked for, so reading three fields of a megabyte message allocates
// three Strings. The cost is that a handle is only meaningful for the document that made it,
// and that a missing member is `none`, not a null value: JSON's `null` is a value
// (`isNull`), and an absent key is not.
//
// Strictly RFC 8259: no comments, no trailing commas, no raw control characters in a string,
// no leading zeros. Nesting deeper than 256 is refused rather than recursed into.

import std.io
import std.option
import std.string
import std.vec

enum JsonKind {
    Null,
    Bool,
    Number,
    String,
    Array,
    Object
}

// Kinds as stored in the tape. An enum is its own type and a column of them is a column of
// words either way; plain integers keep the parser's comparisons cheap.
let JSON_KIND_NULL = 0
let JSON_KIND_BOOL = 1
let JSON_KIND_NUMBER = 2
let JSON_KIND_STRING = 3
let JSON_KIND_ARRAY = 4
let JSON_KIND_OBJECT = 5

let JSON_MAX_DEPTH = 256

public struct JsonDocument {
    // False when the text was not valid JSON; then `error` and `errorAt` say why and where,
    // and `root` is -1.
    public ok: Bool,
    public error: String,
    // Byte offset of the first thing wrong.
    public errorAt: Int,
    public root: Int,
    source: String,
    kinds: Vec<Int>,
    // The value's bytes in `source`. For a string, those between the quotes.
    starts: Vec<Int>,
    ends: Vec<Int>,
    // 1 for a string that contains a backslash, so decoding is a copy when it is 0.
    escaped: Vec<Int>,
    // An array's elements, or an object's key and value alternating, as a chain.
    firsts: Vec<Int>,
    nexts: Vec<Int>,
    counts: Vec<Int>
}

// Where the parser is in the text. Scalars only: the columns being built live in the document
// the parser is handed (`inout`), and are never moved between two structs. Building them in the
// parser and moving them into a `JsonDocument` at the end looks the same and leaks -- a struct
// that has had fields moved out of it is not released, so every message a server read left its
// copy of the text behind -- and so does keeping the document as a field of the parser.
struct JsonParser {
    length: Int,
    at: Int,
    depth: Int,
    failed: Bool
}

// Reads `text` as one JSON value, with only whitespace around it.
public fn parseJson(text: String) -> JsonDocument {
    let mut doc = JsonDocument {
        ok: true,
        error: "",
        errorAt: 0,
        root: 0 - 1,
        source: text.clone(),
        kinds: [],
        starts: [],
        ends: [],
        escaped: [],
        firsts: [],
        nexts: [],
        counts: []
    }
    let parser = JsonParser { length: text.length, at: 0, depth: 0, failed: false }
    parser.skipSpace(doc)
    let root = parser.parseValue(doc)
    parser.skipSpace(doc)
    if (parser.failed == false and parser.at < parser.length) {
        parser.fail(doc, "unexpected text after the value")
    }
    if (parser.failed == false) { doc.root = root }
    return doc
}

impl JsonParser {
    fn fail(self, inout doc: JsonDocument, message: String) {
        if (self.failed) { return }
        self.failed = true
        doc.error = message.clone()
        doc.ok = false
        doc.errorAt = self.at
    }

    fn peek(self, inout doc: JsonDocument) -> Int {
        if (self.at >= self.length) { return 0 - 1 }
        return doc.source.byteAt(self.at) as Int
    }

    fn skipSpace(self, inout doc: JsonDocument) {
        loop {
            let c = self.peek(doc)
            if (c == 32 or c == 9 or c == 10 or c == 13) {
                self.at = self.at + 1
            } else {
                break
            }
        }
    }

    // A node whose bytes are known, its children not yet.
    fn add(self, inout doc: JsonDocument, kind: Int, start: Int, end: Int) -> Int {
        let node = doc.kinds.length
        doc.kinds.push(kind)
        doc.starts.push(start)
        doc.ends.push(end)
        doc.escaped.push(0)
        doc.firsts.push(0 - 1)
        doc.nexts.push(0 - 1)
        doc.counts.push(0)
        return node
    }

    fn expectWord(self, inout doc: JsonDocument, word: String, kind: Int) -> Int {
        let start = self.at
        if (self.length - self.at < word.length or doc.source.substring(self.at, word.length).equals(word) == false) {
            self.fail(doc, "expected a JSON value")
            return 0 - 1
        }
        self.at = self.at + word.length
        return self.add(doc, kind, start, self.at)
    }

    fn parseValue(self, inout doc: JsonDocument) -> Int {
        if (self.failed) { return 0 - 1 }
        let c = self.peek(doc)
        if (c == 123) { return self.parseObject(doc) }
        if (c == 91) { return self.parseArray(doc) }
        if (c == 34) { return self.parseString(doc) }
        if (c == 116) { return self.expectWord(doc, "true", JSON_KIND_BOOL) }
        if (c == 102) { return self.expectWord(doc, "false", JSON_KIND_BOOL) }
        if (c == 110) { return self.expectWord(doc, "null", JSON_KIND_NULL) }
        if (c == 45 or (c >= 48 and c <= 57)) { return self.parseNumber(doc) }
        self.fail(doc, "expected a JSON value")
        return 0 - 1
    }

    fn digits(self, inout doc: JsonDocument) -> Int {
        let start = self.at
        loop {
            let c = self.peek(doc)
            if (c >= 48 and c <= 57) {
                self.at = self.at + 1
            } else {
                break
            }
        }
        return self.at - start
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
    fn parseNumber(self, inout doc: JsonDocument) -> Int {
        let start = self.at
        if (self.peek(doc) == 45) { self.at = self.at + 1 }
        let leading = self.peek(doc)
        let firstDigit = self.at
        let whole = self.digits(doc)
        if (whole == 0) {
            self.fail(doc, "expected a digit")
            return 0 - 1
        }
        if (leading == 48 and whole > 1) {
            self.at = firstDigit + 1
            self.fail(doc, "a number cannot have a leading zero")
            return 0 - 1
        }
        if (self.peek(doc) == 46) {
            self.at = self.at + 1
            if (self.digits(doc) == 0) {
                self.fail(doc, "expected a digit after the decimal point")
                return 0 - 1
            }
        }
        let e = self.peek(doc)
        if (e == 101 or e == 69) {
            self.at = self.at + 1
            let sign = self.peek(doc)
            if (sign == 43 or sign == 45) { self.at = self.at + 1 }
            if (self.digits(doc) == 0) {
                self.fail(doc, "expected a digit in the exponent")
                return 0 - 1
            }
        }
        return self.add(doc, JSON_KIND_NUMBER, start, self.at)
    }

    fn parseString(self, inout doc: JsonDocument) -> Int {
        self.at = self.at + 1
        let start = self.at
        let mut hasEscape = 0
        loop {
            let c = self.peek(doc)
            if (c < 0) {
                self.fail(doc, "unterminated string")
                return 0 - 1
            }
            if (c == 34) { break }
            if (c < 32) {
                self.fail(doc, "a control character in a string must be escaped")
                return 0 - 1
            }
            if (c == 92) {
                hasEscape = 1
                self.at = self.at + 1
                let next = self.peek(doc)
                if (next < 0) {
                    self.fail(doc, "unterminated string")
                    return 0 - 1
                }
            }
            self.at = self.at + 1
        }
        let node = self.add(doc, JSON_KIND_STRING, start, self.at)
        doc.escaped[node] = hasEscape
        self.at = self.at + 1
        return node
    }

    fn parseArray(self, inout doc: JsonDocument) -> Int {
        let start = self.at
        self.at = self.at + 1
        self.depth = self.depth + 1
        if (self.depth > JSON_MAX_DEPTH) {
            self.fail(doc, "nested more than 256 deep")
            return 0 - 1
        }
        let node = self.add(doc, JSON_KIND_ARRAY, start, start)
        let mut last = 0 - 1
        self.skipSpace(doc)
        if (self.peek(doc) == 93) {
            self.at = self.at + 1
        } else {
            loop {
                self.skipSpace(doc)
                let element = self.parseValue(doc)
                if (self.failed) { return 0 - 1 }
                last = self.link(doc, node, last, element)
                self.skipSpace(doc)
                let c = self.peek(doc)
                self.at = self.at + 1
                if (c == 93) { break }
                if (c != 44) {
                    self.at = self.at - 1
                    self.fail(doc, "expected `,` or `]`")
                    return 0 - 1
                }
            }
        }
        doc.ends[node] = self.at
        self.depth = self.depth - 1
        return node
    }

    fn parseObject(self, inout doc: JsonDocument) -> Int {
        let start = self.at
        self.at = self.at + 1
        self.depth = self.depth + 1
        if (self.depth > JSON_MAX_DEPTH) {
            self.fail(doc, "nested more than 256 deep")
            return 0 - 1
        }
        let node = self.add(doc, JSON_KIND_OBJECT, start, start)
        let mut last = 0 - 1
        self.skipSpace(doc)
        if (self.peek(doc) == 125) {
            self.at = self.at + 1
        } else {
            loop {
                self.skipSpace(doc)
                if (self.peek(doc) != 34) {
                    self.fail(doc, "expected a string for the member name")
                    return 0 - 1
                }
                let name = self.parseString(doc)
                if (self.failed) { return 0 - 1 }
                self.skipSpace(doc)
                if (self.peek(doc) != 58) {
                    self.fail(doc, "expected `:` after the member name")
                    return 0 - 1
                }
                self.at = self.at + 1
                self.skipSpace(doc)
                let value = self.parseValue(doc)
                if (self.failed) { return 0 - 1 }
                last = self.link(doc, node, last, name)
                last = self.link(doc, node, last, value)
                doc.counts[node] = doc.counts[node] + 1
                self.skipSpace(doc)
                let c = self.peek(doc)
                self.at = self.at + 1
                if (c == 125) { break }
                if (c != 44) {
                    self.at = self.at - 1
                    self.fail(doc, "expected `,` or `}`")
                    return 0 - 1
                }
            }
        }
        doc.ends[node] = self.at
        self.depth = self.depth - 1
        return node
    }

    // Appends `child` after `last` in `parent`'s chain, and answers it as the new last.
    fn link(self, inout doc: JsonDocument, parent: Int, last: Int, child: Int) -> Int {
        if (last < 0) {
            doc.firsts[parent] = child
        } else {
            doc.nexts[last] = child
        }
        if (doc.kinds[parent] == JSON_KIND_ARRAY) {
            doc.counts[parent] = doc.counts[parent] + 1
        }
        return child
    }
}

// `length` bytes of `source` from `start`, in an allocation of their own. Built byte by byte
// rather than with `substring`: the ownership analysis shares one allocation site per library
// function, so whether a `substring` result is released depends on what every other caller in the
// program does with theirs, and a server that read strings out of every message leaked them.
fn jsonCopy(source: String, start: Int, length: Int) -> String {
    let out = str_with_capacity(length)
    let mut i = 0
    while (i < length) {
        __builtin_string_put_byte(out, i, source.byteAt(start + i) as Char)
        i = i + 1
    }
    return out
}

fn jsonIsHexDigit(c: Int) -> Bool {
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

fn jsonHexValue(c: Int) -> Int {
    if (c >= 48 and c <= 57) { return c - 48 }
    if (c >= 97 and c <= 102) { return c - 87 }
    return c - 55
}

impl JsonDocument {
    public fn kind(self, node: Int) -> JsonKind {
        let k = self.kinds[node]
        if (k == JSON_KIND_BOOL) { return JsonKind.Bool }
        if (k == JSON_KIND_NUMBER) { return JsonKind.Number }
        if (k == JSON_KIND_STRING) { return JsonKind.String }
        if (k == JSON_KIND_ARRAY) { return JsonKind.Array }
        if (k == JSON_KIND_OBJECT) { return JsonKind.Object }
        return JsonKind.Null
    }

    public fn isNull(self, node: Int) -> Bool {
        return node >= 0 and self.kinds[node] == JSON_KIND_NULL
    }

    public fn isObject(self, node: Int) -> Bool {
        return node >= 0 and self.kinds[node] == JSON_KIND_OBJECT
    }

    public fn isArray(self, node: Int) -> Bool {
        return node >= 0 and self.kinds[node] == JSON_KIND_ARRAY
    }

    // How many elements an array has, or members an object has; 0 for anything else.
    public fn length(self, node: Int) -> Int {
        if (node < 0) { return 0 }
        let k = self.kinds[node]
        if (k != JSON_KIND_ARRAY and k != JSON_KIND_OBJECT) { return 0 }
        return self.counts[node]
    }

    // The value of `name` in an object, or `none` if there is no such member (or `node` is not
    // an object). With a repeated name, the last one, as most readers do.
    public fn member(self, node: Int, name: String) -> Int? {
        if (self.isObject(node) == false) { return none }
        let mut found: Int? = none
        let mut key = self.firsts[node]
        while (key >= 0) {
            let value = self.nexts[key]
            if (self.text(key).equals(name)) { found = value }
            key = self.nexts[value]
        }
        return found
    }

    // The `index`th element of an array, or `none`.
    public fn element(self, node: Int, index: Int) -> Int? {
        if (self.isArray(node) == false or index < 0 or index >= self.counts[node]) { return none }
        let mut at = self.firsts[node]
        let mut i = 0
        while (i < index) {
            at = self.nexts[at]
            i = i + 1
        }
        return at
    }

    // The elements of an array, or the values of an object, in order.
    public fn children(self, node: Int) -> Vec<Int> {
        let mut out: Vec<Int> = []
        if (self.isArray(node)) {
            let mut at = self.firsts[node]
            while (at >= 0) {
                out.push(at)
                at = self.nexts[at]
            }
        } else if (self.isObject(node)) {
            let mut key = self.firsts[node]
            while (key >= 0) {
                let value = self.nexts[key]
                out.push(value)
                key = self.nexts[value]
            }
        }
        return out
    }

    // An object's member names, in order.
    public fn keys(self, node: Int) -> Vec<String> {
        let mut out: Vec<String> = []
        if (self.isObject(node)) {
            let mut key = self.firsts[node]
            while (key >= 0) {
                out.push(self.text(key))
                key = self.nexts[self.nexts[key]]
            }
        }
        return out
    }

    // A dotted path through nested objects: `path(root, "params.textDocument.uri")`.
    // Names containing a dot cannot be reached this way; use `member`. `none` if any
    // step is missing.
    public fn path(self, node: Int, dotted: String) -> Int? {
        let mut at = node
        for step in dotted.split(".") {
            let next = self.member(at, step)
            if (next == none) { return none }
            at = expect(next)
        }
        return at
    }

    // A string value's characters with its escapes decoded, "" for any other kind.
    // **Always a copy of its own.** A substring of `source` returned as it is reads, to the
    // ownership analysis, as a view of the document; passed on to another function it makes the
    // whole document look like it escapes, and a server that read a string out of every message
    // then leaked the message's entire tape (16 blocks) per message.
    public fn text(self, node: Int) -> String {
        if (node < 0 or self.kinds[node] != JSON_KIND_STRING) { return "".clone() }
        let start = self.starts[node]
        if (self.escaped[node] == 0) { return jsonCopy(self.source, start, self.ends[node] - start) }
        return jsonDecodeEscapes(jsonCopy(self.source, start, self.ends[node] - start))
    }

    // A number as an integer, or the bool/number/string under `node` read leniently:
    // 0 when it is not a number, and the part before the point of a decimal.
    public fn int(self, node: Int) -> Int {
        if (node < 0 or self.kinds[node] != JSON_KIND_NUMBER) { return 0 }
        let start = self.starts[node]
        let whole = self.source.substring(start, self.ends[node] - start)
        return whole.parseInt().unwrapOr(whole.parseFloat().unwrapOr(0.0) as Int)
    }

    public fn float(self, node: Int) -> Float {
        if (node < 0 or self.kinds[node] != JSON_KIND_NUMBER) { return 0.0 }
        let start = self.starts[node]
        return self.source.substring(start, self.ends[node] - start).parseFloat().unwrapOr(0.0)
    }

    public fn bool(self, node: Int) -> Bool {
        if (node < 0 or self.kinds[node] != JSON_KIND_BOOL) { return false }
        return self.source.byteAt(self.starts[node]) == 116
    }

    // The value exactly as written, to put back unchanged: a JSON-RPC response echoes the
    // request's `id`, which may be a number or a string and must come back as the same one.
    public fn raw(self, node: Int) -> String {
        if (node < 0) { return "null".clone() }
        let mut start = self.starts[node]
        let mut end = self.ends[node]
        if (self.kinds[node] == JSON_KIND_STRING) {
            start = start - 1
            end = end + 1
        }
        return jsonCopy(self.source, start, end - start)
    }

    // Where in the source the value begins, for a message about it.
    public fn offset(self, node: Int) -> Int {
        if (node < 0) { return 0 }
        return self.starts[node]
    }
}

// The characters a string's backslash escapes stand for. `raw` was accepted by the parser, so
// every escape is one of the eight single-character ones or `\u` with four digits -- except
// that the parser does not look inside, so a bad one becomes U+FFFD here rather than failing a
// document that was otherwise readable.
//
// **Two passes over one allocation.** The first measures the decoded text, the second writes it.
// Appending as it went (`out = out.concat(...)` once per escape) copied everything decoded so
// far on every escape, which is quadratic: a 100 KiB document with a few thousand newlines
// took half a gigabyte of churn to read.
fn jsonDecodeEscapes(raw: String) -> String {
    let length = jsonDecodeScan(raw, raw, false)
    let out = str_with_capacity(length)
    jsonDecodeScan(raw, out, true)
    return out
}

// Walks `raw` decoding its escapes. Returns the decoded length; writes the bytes to `out` when
// `write` is set. One routine for both passes, so they cannot disagree about a surrogate pair.
fn jsonDecodeScan(raw: String, out: String, write: Bool) -> Int {
    let n = raw.length
    let mut at = 0
    let mut i = 0
    while (i < n) {
        let c = raw.byteAt(i)
        if (c != 92) {
            if (write) { __builtin_string_put_byte(out, at, c as Char) }
            at = at + 1
            i = i + 1
            continue
        }
        let mut e = 0
        if (i + 1 < n) { e = raw.byteAt(i + 1) }
        i = i + 2
        let mut single = 0 - 1
        if (e == 110) {
            single = 10
        }
        else if (e == 116) {
            single = 9
        }
        else if (e == 114) {
            single = 13
        }
        else if (e == 98) {
            single = 8
        }
        else if (e == 102) {
            single = 12
        }
        else if (e == 34) {
            single = 34
        }
        else if (e == 92) {
            single = 92
        }
        else if (e == 47) {
            single = 47
        }
        if (single >= 0) {
            if (write) { __builtin_string_put_byte(out, at, single as Char) }
            at = at + 1
            continue
        }
        let mut code = 65533
        if (e == 117) {
            let high = jsonHexQuad(raw, i)
            i = i + 4
            code = high
            if (high >= 55296 and high <= 56319 and i + 5 < n and raw.byteAt(i) == 92 and raw.byteAt(i + 1) == 117) {
                let low = jsonHexQuad(raw, i + 2)
                if (low >= 56320 and low <= 57343) {
                    code = 65536 + (high - 55296) * 1024 + (low - 56320)
                    i = i + 6
                }
            }
            if (code < 0 or (code >= 55296 and code <= 57343)) { code = 65533 }
        }
        at = at + jsonPutScalar(out, at, code, write)
    }
    return at
}

// The UTF-8 bytes of scalar `code` written at `at` when `write` is set; how many there are.
fn jsonPutScalar(out: String, at: Int, code: Int, write: Bool) -> Int {
    if (code < 128) {
        if (write) { __builtin_string_put_byte(out, at, code as Char) }
        return 1
    }
    if (code < 2048) {
        if (write) {
            __builtin_string_put_byte(out, at, (192 + code / 64) as Char)
            __builtin_string_put_byte(out, at + 1, (128 + code % 64) as Char)
        }
        return 2
    }
    if (code < 65536) {
        if (write) {
            __builtin_string_put_byte(out, at, (224 + code / 4096) as Char)
            __builtin_string_put_byte(out, at + 1, (128 + (code / 64) % 64) as Char)
            __builtin_string_put_byte(out, at + 2, (128 + code % 64) as Char)
        }
        return 3
    }
    if (write) {
        __builtin_string_put_byte(out, at, (240 + code / 262144) as Char)
        __builtin_string_put_byte(out, at + 1, (128 + (code / 4096) % 64) as Char)
        __builtin_string_put_byte(out, at + 2, (128 + (code / 64) % 64) as Char)
        __builtin_string_put_byte(out, at + 3, (128 + code % 64) as Char)
    }
    return 4
}

// Four hex digits at `at` as a number, or -1.
fn jsonHexQuad(raw: String, at: Int) -> Int {
    if (at + 4 > raw.length) { return 0 - 1 }
    let mut value = 0
    let mut k = 0
    while (k < 4) {
        let c = raw.byteAt(at + k)
        if (jsonIsHexDigit(c) == false) { return 0 - 1 }
        value = value * 16 + jsonHexValue(c)
        k = k + 1
    }
    return value
}

// `text` as a JSON string literal, quotes included. Two passes over one allocation, for the
// reason `jsonDecodeEscapes` gives.
public fn jsonQuote(text: String) -> String {
    let length = jsonQuoteScan(text, text, false)
    let out = str_with_capacity(length)
    jsonQuoteScan(text, out, true)
    return out
}

// The bytes `text` takes as a JSON literal; written to `out` when `write` is set.
fn jsonQuoteScan(text: String, out: String, write: Bool) -> Int {
    let n = text.length
    let digits = "0123456789abcdef"
    let mut at = 0
    if (write) { __builtin_string_put_byte(out, at, '"') }
    at = at + 1
    let mut i = 0
    while (i < n) {
        let c = text.byteAt(i)
        i = i + 1
        if (c >= 32 and c != 34 and c != 92) {
            if (write) { __builtin_string_put_byte(out, at, c as Char) }
            at = at + 1
            continue
        }
        let mut short = 0
        if (c == 34) {
            short = 34
        }
        else if (c == 92) {
            short = 92
        }
        else if (c == 10) {
            short = 110
        }
        else if (c == 13) {
            short = 114
        }
        else if (c == 9) {
            short = 116
        }
        else if (c == 8) {
            short = 98
        }
        else if (c == 12) {
            short = 102
        }
        if (short > 0) {
            if (write) {
                __builtin_string_put_byte(out, at, '\\')
                __builtin_string_put_byte(out, at + 1, short as Char)
            }
            at = at + 2
            continue
        }
        if (write) {
            __builtin_string_put_byte(out, at, '\\')
            __builtin_string_put_byte(out, at + 1, 'u')
            __builtin_string_put_byte(out, at + 2, '0')
            __builtin_string_put_byte(out, at + 3, '0')
            __builtin_string_put_byte(out, at + 4, digits.byteAt(c / 16) as Char)
            __builtin_string_put_byte(out, at + 5, digits.byteAt(c % 16) as Char)
        }
        at = at + 6
    }
    if (write) { __builtin_string_put_byte(out, at, '"') }
    return at + 1
}

// Builds a document in one pass. Commas and the colon after a key are the writer's job:
// call `key` before each value inside an object, and just the values inside an array.
//
//     out.beginArray()
//     out.int(1)
//     out.string("two")
//     out.endArray()          // [1,"two"]
public struct JsonWriter {
    pieces: Vec<String>,
    // How many items each open container holds so far.
    counts: Vec<Int>,
    pendingKey: Bool
}

public fn JsonWriter() -> JsonWriter {
    return JsonWriter { pieces: [], counts: [], pendingKey: false }
}

impl JsonWriter {
    // Everything that starts a value goes through here, for the comma.
    fn beforeValue(self) {
        if (self.pendingKey) {
            self.pendingKey = false
            return
        }
        let depth = self.counts.length
        if (depth == 0) { return }
        if (self.counts[depth - 1] > 0) { self.pieces.push(",") }
        self.counts[depth - 1] = self.counts[depth - 1] + 1
    }

    public fn beginObject(self) {
        self.beforeValue()
        self.pieces.push("{")
        self.counts.push(0)
    }

    public fn endObject(self) {
        self.counts.pop()
        self.pieces.push("}")
    }

    public fn beginArray(self) {
        self.beforeValue()
        self.pieces.push("[")
        self.counts.push(0)
    }

    public fn endArray(self) {
        self.counts.pop()
        self.pieces.push("]")
    }

    public fn key(self, name: String) {
        let depth = self.counts.length
        if (depth > 0) {
            if (self.counts[depth - 1] > 0) { self.pieces.push(",") }
            self.counts[depth - 1] = self.counts[depth - 1] + 1
        }
        self.pieces.push(jsonQuote(name))
        self.pieces.push(":")
        self.pendingKey = true
    }

    public fn string(self, text: String) {
        self.beforeValue()
        self.pieces.push(jsonQuote(text))
    }

    public fn int(self, value: Int) {
        self.beforeValue()
        self.pieces.push(value.toString())
    }

    public fn float(self, value: Float) {
        self.beforeValue()
        self.pieces.push(value.toString())
    }

    public fn bool(self, value: Bool) {
        self.beforeValue()
        if (value) {
            self.pieces.push("true")
        } else {
            self.pieces.push("false")
        }
    }

    public fn null(self) {
        self.beforeValue()
        self.pieces.push("null")
    }

    // JSON that is already written, such as a request's `id` from `raw`.
    public fn raw(self, json: String) {
        self.beforeValue()
        self.pieces.push(json.clone())
    }

    public fn finish(self) -> String {
        return self.pieces.join("")
    }
}
