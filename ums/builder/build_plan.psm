import std.io
import ums.model.project
import ums.model.diagnostic
import ums.parser.lexer
import ums.targets.target
import std.string

extern fn join_path(directory: String borrow, child: String borrow) -> String produce(free)

struct UmsBuildPlan {
    stateRoot: String,
    artifactRoot: String
}

private fn umsBuildProfileValid(profile: String) -> Bool {
    if (__builtin_string_len(profile) == 0) { return false }
    let mut i = 0
    while (i < __builtin_string_len(profile)) {
        let current = profile.charAt(i)
        if (umsIsAlnum(current) == false and current != '-' and current != '_') {
            return false
        }
        i = i + 1
    }
    return true
}

private fn umsPlannedOutput(kind: UmsTargetKind, profileRoot: String, name: String) -> String {
    let path = join_path(profileRoot, name)
    if (kind == UmsTargetKind.EXECUTABLE or kind == UmsTargetKind.TEST) {
        return umsExecutablePath(path)
    }
    return path
}

public fn umsBuildPlanCreate(project: UmsProjectModel,
                      inout diagnostics: Vec<UmsDiagnostic>) -> UmsBuildPlan {
    if (umsBuildProfileValid(project.build.profile) == false) {
        umsDiagnosticAdd(diagnostics, "UMS3001", project.manifestPath, 0, 0, 0,
            "invalid build profile '".concat(project.build.profile, "'"))
        return UmsBuildPlan { stateRoot: "".clone(), artifactRoot: "".clone() }
    }

    let stateRoot = join_path(project.root, project.build.stateDirectory)
    let artifactRoot = join_path(stateRoot, project.build.buildDirectory)
    let profileRoot = join_path(artifactRoot, project.build.profile)
    let mut i = 0
    while (i < project.targets.length) {
        let target = project.targets[i]
        let mut plannedLinks: Vec<UmsLinkInput> = []
        let mut linkIndex = 0
        while (linkIndex < target.links.length) {
            let input = target.links[linkIndex]
            plannedLinks.push(umsLinkInput(input.kind, input.value,
                      input.line, input.col, input.len))
            linkIndex = linkIndex + 1
        }
        let planned = UmsTarget {
            kind: target.kind,
            name: target.name.clone(),
            entry: target.entry.clone(),
            sourcePath: join_path(project.root, target.entry),
            outputPath: umsPlannedOutput(target.kind, profileRoot, target.name),
            links: plannedLinks,
            line: target.line,
            col: target.col,
            len: target.len
        }
        project.targets[i] = planned
        i = i + 1
    }
    return UmsBuildPlan { stateRoot: stateRoot, artifactRoot: artifactRoot }
}
