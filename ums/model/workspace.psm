import ums.model.project
import ums.commands.command
import ums.model.diagnostic
import ums.model.lowering
import ums.model.validation
import ums.parser.lexer
import ums.parser.parser
import ums.parser.ast
import ums.resolver.discovery
import ums.builder.build_plan
import std.string

extern fn read_file(path: String borrow) -> String produce(free)
extern fn get_directory(path: String borrow) -> String produce(free)
extern fn join_path(directory: String borrow, child: String borrow) -> String produce(free)

struct UmsWorkspace {
    project: UmsProjectModel,
    plan: UmsBuildPlan,
    diagnostics: List<UmsDiagnostic>,
    valid: Bool
}

private fn umsEmptyWorkspace(diagnostics: List<UmsDiagnostic>) -> UmsWorkspace {
    return UmsWorkspace {
        project: umsProjectModel("", "", "debug"),
        plan: UmsBuildPlan { stateRoot: strClone(""), artifactRoot: strClone("") },
        diagnostics: diagnostics,
        valid: false
    }
}

fn umsLoadText(source: String, manifestPath: String, root: String,
               profile: String) -> UmsWorkspace {
    let diagnostics = umsDiagnostics()
    let tokens = umsLex(source, manifestPath, diagnostics)
    let document = umsParse(tokens, manifestPath, diagnostics)
    let project = umsLowerDocument(document, root, manifestPath, profile, diagnostics)
    project.validate(diagnostics)
    let mut plan = UmsBuildPlan { stateRoot: strClone(""), artifactRoot: strClone("") }
    if (list_len(diagnostics) == 0) {
        plan = umsBuildPlanCreate(project, diagnostics)
    }
    let valid = list_len(diagnostics) == 0
    return UmsWorkspace {
        project: project,
        plan: plan,
        diagnostics: diagnostics,
        valid: valid
    }
}

fn umsLoadProject(startDirectory: String, profile: String) -> UmsWorkspace {
    let diagnostics = umsDiagnostics()
    let manifestPath = umsDiscoverManifest(startDirectory, diagnostics)
    if (__builtin_string_len(manifestPath) == 0) { return umsEmptyWorkspace(diagnostics) }
    let root = get_directory(manifestPath)
    return umsLoadText(read_file(manifestPath), manifestPath, root, profile)
}

private fn umsBootstrapPrefixLength(source: String) -> Int {
    let length = __builtin_string_len(source)
    let mut pos = 0

    // The bootstrap block is required to be first, apart from whitespace and
    // comments. That gives the installed compiler a finite prefix to scan; it
    // never has to lex syntax owned by a newer project host.
    loop {
        while (pos < length and (source.charAt(pos) == ' ' or
               source.charAt(pos) == '\t' or source.charAt(pos) == '\r' or
               source.charAt(pos) == '\n')) {
            pos = pos + 1
        }
        if (pos < length and source.charAt(pos) == '#') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
        } else if (pos + 1 < length and source.charAt(pos) == '/' and
                   source.charAt(pos + 1) == '/') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
        } else {
            break
        }
    }

    if (strMatchesAt(source, "toolchain", pos) == false) { return 0 }
    pos = pos + 9
    while (pos < length and (source.charAt(pos) == ' ' or
           source.charAt(pos) == '\t' or source.charAt(pos) == '\r' or
           source.charAt(pos) == '\n')) {
        pos = pos + 1
    }
    if (pos >= length or source.charAt(pos) != '{') { return 0 }

    let mut depth = 1
    let mut inString = false
    let mut escaped = false
    pos = pos + 1
    while (pos < length) {
        let current = source.charAt(pos)
        if (inString) {
            if (escaped) { escaped = false }
            else if (current == '\\') { escaped = true }
            else if (current == '"') { inString = false }
        } else if (current == '"') {
            inString = true
        } else if (current == '#') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
            continue
        } else if (current == '/' and pos + 1 < length and
                   source.charAt(pos + 1) == '/') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
            continue
        } else if (current == '{') {
            depth = depth + 1
        } else if (current == '}') {
            depth = depth - 1
            if (depth == 0) { return pos + 1 }
        }
        pos = pos + 1
    }
    return 0
}

// The installed compiler calls this before it parses any command. It deliberately
// reads only the first `toolchain { host = "..." }` block: all remaining syntax
// belongs to the selected host, which may implement a newer UMS.
fn umsProjectHost(startDirectory: String) -> String {
    let diagnostics = umsDiagnostics()
    let manifestPath = umsDiscoverManifest(startDirectory, diagnostics)
    if (__builtin_string_len(manifestPath) == 0) { return "" }

    let source = read_file(manifestPath)
    let prefixLength = umsBootstrapPrefixLength(source)
    if (prefixLength == 0) { return "" }

    let root = get_directory(manifestPath)
    let prefix = strSubstring(source, 0, prefixLength)
    let tokens = umsLex(prefix, manifestPath, diagnostics)
    let document = umsParse(tokens, manifestPath, diagnostics)
    let mut i = 0
    while (i < list_len(document.roots)) {
        let block = list_get(document.statements, list_get(document.roots, i))
        if (block.kind == UmsAstStatementKind.CALL and block.hasBlock and
            list_len(block.arguments) == 0 and block.name.equals("toolchain")) {
            let mut childIndex = 0
            while (childIndex < list_len(block.children)) {
                let property = list_get(document.statements,
                                        list_get(block.children, childIndex))
                if (property.kind == UmsAstStatementKind.ASSIGNMENT and
                    property.name.equals("host") and
                    property.value.kind == UmsAstValueKind.STRING and
                    __builtin_string_len(property.value.text) > 0) {
                    return join_path(root, property.value.text)
                }
                childIndex = childIndex + 1
            }
        }
        i = i + 1
    }
    return ""
}

// The workspace's target accessors. Public because `src/main.psm` walks them:
// `workspace.targetCount()` and `workspace.target(i)`.
impl UmsWorkspace {

         fn targetCount(self) -> Int {
        return list_len(self.project.targets)
    }

         fn target(self, index: Int) -> UmsTarget {
        return list_get(self.project.targets, index)
    }

    fn commandCount(self) -> Int {
        return list_len(self.project.commands)
    }

    fn command(self, index: Int) -> UmsCommand {
        return list_get(self.project.commands, index)
    }

    fn findCommand(self, name: String) -> Int {
        return umsCommandFind(self.project.commands, name)
    }
}
