import ums.model.project
import ums.commands.command
import ums.model.diagnostic
import ums.model.lowering
import ums.model.validation
import ums.parser.lexer
import ums.parser.parser
import ums.parser.ast
import ums.resolver.discovery
import ums.builder.build_plan
import ums.targets.target
import std.string
import std.fs


public struct UmsWorkspace {
    public project: UmsProjectModel,
    public plan: UmsBuildPlan,
    public diagnostics: Vec<UmsDiagnostic>,
    public valid: Bool
}

private fn umsEmptyWorkspace(diagnostics: Vec<UmsDiagnostic>) -> UmsWorkspace {
    return UmsWorkspace {
        project: umsProjectModel("", "", "debug"),
        plan: UmsBuildPlan { stateRoot: "".clone(), artifactRoot: "".clone() },
        diagnostics: diagnostics,
        valid: false
    }
}

public fn umsLoadText(source: String, manifestPath: String, root: String,
               profile: String) -> UmsWorkspace {
    let mut diagnostics = umsDiagnostics()
    let tokens = umsLex(source, manifestPath, diagnostics)
    let document = umsParse(tokens, manifestPath, diagnostics)
    let project = umsLowerDocument(document, root, manifestPath, profile, diagnostics)
    project.validate(diagnostics)
    let mut plan = UmsBuildPlan { stateRoot: "".clone(), artifactRoot: "".clone() }
    if (diagnostics.length == 0) {
        plan = umsBuildPlanCreate(project, diagnostics)
    }
    let valid = diagnostics.length == 0
    return UmsWorkspace {
        project: project,
        plan: plan,
        diagnostics: diagnostics,
        valid: valid
    }
}

public fn umsLoadProject(startDirectory: String, profile: String) -> UmsWorkspace {
    let mut diagnostics = umsDiagnostics()
    let manifestPath = umsDiscoverManifest(startDirectory, diagnostics)
    if (manifestPath.length == 0) { return umsEmptyWorkspace(diagnostics) }
    let root = directoryOf(manifestPath)
    return umsLoadText(readFile(manifestPath), manifestPath, root, profile)
}

private fn umsBootstrapPrefixLength(source: String) -> Int {
    let length = source.length
    let mut pos = 0

    // The bootstrap block is required to be first, apart from whitespace and
    // comments. That gives the installed compiler a finite prefix to scan; it
    // never has to lex syntax owned by a newer project host.
    loop {
        while (pos < length and (source.charAt(pos) == ' ' or
               source.charAt(pos) == '\t' or source.charAt(pos) == '\r' or
               source.charAt(pos) == '\n')) {
            pos = pos + 1
        }
        if (pos < length and source.charAt(pos) == '#') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
        } else if (pos + 1 < length and source.charAt(pos) == '/' and
                   source.charAt(pos + 1) == '/') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
        } else {
            break
        }
    }

    if (source.matchesAt("toolchain", pos) == false) { return 0 }
    pos = pos + 9
    while (pos < length and (source.charAt(pos) == ' ' or
           source.charAt(pos) == '\t' or source.charAt(pos) == '\r' or
           source.charAt(pos) == '\n')) {
        pos = pos + 1
    }
    if (pos >= length or source.charAt(pos) != '{') { return 0 }

    let mut depth = 1
    let mut inString = false
    let mut escaped = false
    pos = pos + 1
    while (pos < length) {
        let current = source.charAt(pos)
        if (inString) {
            if (escaped) { escaped = false }
            else if (current == '\\') { escaped = true }
            else if (current == '"') { inString = false }
        } else if (current == '"') {
            inString = true
        } else if (current == '#') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
            continue
        } else if (current == '/' and pos + 1 < length and
                   source.charAt(pos + 1) == '/') {
            while (pos < length and source.charAt(pos) != '\n') { pos = pos + 1 }
            continue
        } else if (current == '{') {
            depth = depth + 1
        } else if (current == '}') {
            depth = depth - 1
            if (depth == 0) { return pos + 1 }
        }
        pos = pos + 1
    }
    return 0
}

// `toolchain.host` as written, and the directory it is relative to.
struct UmsHostDeclaration {
    root: String,
    text: String
}

// The installed compiler calls this before it parses any command. It deliberately
// reads only the first `toolchain { host = "..." }` block: all remaining syntax
// belongs to the selected host, which may implement a newer UMS.
private fn umsReadHostDeclaration(startDirectory: String) -> UmsHostDeclaration {
    let mut diagnostics = umsDiagnostics()
    let manifestPath = umsDiscoverManifest(startDirectory, diagnostics)
    if (manifestPath.length == 0) { return UmsHostDeclaration { root: "", text: "" } }

    let source = readFile(manifestPath)
    let prefixLength = umsBootstrapPrefixLength(source)
    if (prefixLength == 0) { return UmsHostDeclaration { root: "", text: "" } }

    let root = directoryOf(manifestPath)
    let prefix = source.substring(0, prefixLength)
    let tokens = umsLex(prefix, manifestPath, diagnostics)
    let document = umsParse(tokens, manifestPath, diagnostics)
    let mut i = 0
    while (i < document.roots.length) {
        let block = document.statements[document.roots[i]]
        if (block.kind == UmsAstStatementKind.CALL and block.hasBlock and
            block.arguments.length == 0 and block.name.equals("toolchain")) {
            let mut childIndex = 0
            while (childIndex < block.children.length) {
                let property = document.statements[block.children[childIndex]]
                if (property.kind == UmsAstStatementKind.ASSIGNMENT and
                    property.name.equals("host") and
                    property.value.kind == UmsAstValueKind.STRING) {
                    return UmsHostDeclaration { root: root.clone(), text: property.value.text.clone() }
                }
                childIndex = childIndex + 1
            }
        }
        i = i + 1
    }
    return UmsHostDeclaration { root: root, text: "" }
}

// `toolchain.host` as the file the launcher runs: relative to the manifest's
// directory unless written absolute.
public fn umsHostExecutable(root: String, host: String) -> String {
    if (umsAbsolutePath(host)) { return umsExecutablePath(host) }
    return umsExecutablePath(joinPath(root, host))
}

public fn umsProjectHost(startDirectory: String) -> String {
    let declared = umsReadHostDeclaration(startDirectory)
    if (declared.text.length == 0) { return "" }
    return umsHostExecutable(declared.root, declared.text)
}

// Whether `clean` may delete the host: see umsHostIsProjectBuildOutput.
public fn umsProjectOwnsHost(startDirectory: String) -> Bool {
    return umsHostIsProjectBuildOutput(umsReadHostDeclaration(startDirectory).text)
}

// The workspace's target accessors. Public because `src/main.psm` walks them:
// `workspace.targetCount()` and `workspace.target(i)`.
impl UmsWorkspace {

    public fn targetCount(self) -> Int {
        return self.project.targets.length
    }

    public fn target(self, index: Int) -> UmsTarget {
        return self.project.targets[index]
    }

    public fn commandCount(self) -> Int {
        return self.project.commands.length
    }

    public fn command(self, index: Int) -> UmsCommand {
        return self.project.commands[index]
    }

    public fn findCommand(self, name: String) -> Int {
        return umsCommandFind(self.project.commands, name)
    }
}
