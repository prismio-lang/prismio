// Diagnostics are data until a CLI chooses to print them. Keeping them out of
// the compiler's diagnostic registry lets UMS be embedded by other Prismio tools.

import std.io
import std.string

struct UmsDiagnostic {
    code: String,
    path: String,
    line: Int,
    col: Int,
    len: Int,
    message: String
}

public fn umsDiagnostics() -> Vec<UmsDiagnostic> {
    return []
}

public fn umsDiagnosticAdd(inout diagnostics: Vec<UmsDiagnostic>, code: String, path: String,
                    line: Int, col: Int, len: Int, message: String) {
    diagnostics.push(UmsDiagnostic {
        code: code.clone(),
        path: path.clone(),
        line: line,
        col: col,
        len: len,
        message: message.clone()
    })
}

// One diagnostic, rendered. `private` because only umsDiagnosticsPrint below
// calls it, and the list form is what every caller outside this file wants.
impl UmsDiagnostic {

    private fn print(self) {
        if (__builtin_string_len(self.path) > 0) {
            print(self.path)
            if (self.line > 0) {
                print(":")
                print(self.line.toString())
                print(":")
                print(self.col.toString())
            }
            print(": ")
        }
        print("error[")
        print(self.code)
        print("]: ")
        println(self.message)
    }
}
public fn umsDiagnosticsPrint(diagnostics: Vec<UmsDiagnostic>) {
    let mut i = 0
    while (i < diagnostics.length) {
        diagnostics[i].print()
        i = i + 1
    }
}
