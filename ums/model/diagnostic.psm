// Diagnostics are data until a CLI chooses to print them. Keeping them out of
// the compiler's diagnostic registry lets UMS be embedded by other Prismio tools.

extern fn print(value: String)
extern fn println(value: String)
extern fn int_to_str(value: Int) -> String
extern fn str_clone(value: String borrow) -> String produce(free)

struct UmsDiagnostic {
    code: String,
    path: String,
    line: Int,
    col: Int,
    len: Int,
    message: String
}

fn umsDiagnostics() -> List<UmsDiagnostic> {
    return list_new()
}

fn umsDiagnosticAdd(diagnostics: List<UmsDiagnostic>, code: String, path: String,
                    line: Int, col: Int, len: Int, message: String) {
    list_push(diagnostics, UmsDiagnostic {
        code: str_clone(code),
        path: str_clone(path),
        line: line,
        col: col,
        len: len,
        message: str_clone(message)
    })
}

fn umsDiagnosticPrint(diagnostic: UmsDiagnostic) {
    if (str_length(diagnostic.path) > 0) {
        print(diagnostic.path)
        if (diagnostic.line > 0) {
            print(":")
            print(int_to_str(diagnostic.line))
            print(":")
            print(int_to_str(diagnostic.col))
        }
        print(": ")
    }
    print("error[")
    print(diagnostic.code)
    print("]: ")
    println(diagnostic.message)
}

fn umsDiagnosticsPrint(diagnostics: List<UmsDiagnostic>) {
    let mut i = 0
    while (i < list_len(diagnostics)) {
        umsDiagnosticPrint(list_get(diagnostics, i))
        i = i + 1
    }
}
