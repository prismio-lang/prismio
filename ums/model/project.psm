import ums.targets.target
import ums.commands.command
import ums.dependency.dependency
import std.string


// Where a declaration was written, so validation -- which runs on the lowered
// model, after the syntax is gone -- can still point at it. A span of zeros is
// "nowhere in particular" and prints as the manifest path alone.
struct UmsSpan {
    internal line: Int,
    internal col: Int,
    internal len: Int
}

internal fn umsSpanNone() -> UmsSpan {
    return UmsSpan { line: 0, col: 0, len: 0 }
}

struct UmsProjectMetadata {
    public name: String,
    public version: String,
    public prismioVersion: String,
    public description: String,
    public license: String,
    public licenseFile: String,
    public authors: Vec<String>,
    internal descriptionDeclared: Bool,
    internal licenseDeclared: Bool,
    internal licenseFileDeclared: Bool,
    internal authorsDeclared: Bool,
    // The project block, for a required property that was never written, and
    // then one span per property.
    internal blockSpan: UmsSpan,
    internal nameSpan: UmsSpan,
    internal versionSpan: UmsSpan,
    internal prismioSpan: UmsSpan,
    internal descriptionSpan: UmsSpan,
    internal licenseSpan: UmsSpan,
    internal licenseFileSpan: UmsSpan,
    internal authorsSpan: UmsSpan
}

// Build policy is intentionally not part of project metadata. Profiles and
// cross-target settings can grow here without changing the project's identity.
//
// `debugInfo` and `overflowChecks` are the selected profile's settings: `debug`
// starts with both on and `release` with both off, and a `profiles` block may
// change either (lowering applies the selected profile's block, and validates
// every block). The debug profile's `-g` also drops the program's object step
// to -O0, because a variable folded into a register is one a debugger cannot
// show.
struct UmsBuildConfiguration {
    public profile: String,
    public stateDirectory: String,
    public buildDirectory: String,
    public debugInfo: Bool,
    public overflowChecks: Bool
}

// Read by the installed compiler before it lowers the complete manifest. The
// `toolchain` block is therefore a deliberately small, stable bootstrap surface:
// once this host exists, that host owns the real UMS parse and command.
struct UmsToolchainConfiguration {
    public host: String
}

// Whether `toolchain.host` names this project's own build output: relative, under
// `.prismio/`, with no `..` component. It is not a condition on the host -- a
// sub-project may run its parent's, as `sandbox/` does with
// `../.prismio/build/debug/prismio` -- because what stops a cloned repository
// choosing a program for `prismio` to start is the `.trusted` stamp beside a
// host this machine promoted, not where the host lives. It decides what `clean`
// may delete: only a host the project owns, never a parent's compiler.
public fn umsHostIsProjectBuildOutput(path: String) -> Bool {
    let length = path.length
    if (length == 0 or umsAbsolutePath(path)) { return false }
    if (path.startsWith(".prismio/") == false and path.startsWith(".prismio\\") == false) {
        return false
    }
    let mut start = 0
    for i in 0..<(length + 1) {
        if (i == length or path.charAt(i) == '/' or path.charAt(i) == '\\') {
            if (i - start == 2 and path.charAt(start) == '.' and path.charAt(start + 1) == '.') {
                return false
            }
            start = i + 1
        }
    }
    return true
}

public fn umsAbsolutePath(value: String) -> Bool {
    let length = value.length
    if (length == 0) { return false }
    if (value.charAt(0) == '/' or value.charAt(0) == '\\') { return true }
    return length > 1 and value.charAt(1) == ':'
}

public struct UmsProjectModel {
    public root: String,
    public manifestPath: String,
    public metadata: UmsProjectMetadata,
    public build: UmsBuildConfiguration,
    public toolchain: UmsToolchainConfiguration,
    public targets: Vec<UmsTarget>,
    internal commands: Vec<UmsCommand>,
    public dependencies: Vec<UmsDependency>
}

internal fn umsProjectModel(root: String, manifestPath: String, profile: String) -> UmsProjectModel {
    return UmsProjectModel {
        root: root.clone(),
        manifestPath: manifestPath.clone(),
        metadata: UmsProjectMetadata {
            name: "".clone(),
            version: "".clone(),
            prismioVersion: "".clone(),
            description: "".clone(),
            license: "".clone(),
            licenseFile: "".clone(),
            authors: [],
            descriptionDeclared: false,
            licenseDeclared: false,
            licenseFileDeclared: false,
            authorsDeclared: false,
            blockSpan: umsSpanNone(),
            nameSpan: umsSpanNone(),
            versionSpan: umsSpanNone(),
            prismioSpan: umsSpanNone(),
            descriptionSpan: umsSpanNone(),
            licenseSpan: umsSpanNone(),
            licenseFileSpan: umsSpanNone(),
            authorsSpan: umsSpanNone()
        },
        build: UmsBuildConfiguration {
            profile: profile.clone(),
            stateDirectory: ".prismio".clone(),
            buildDirectory: "build".clone(),
            debugInfo: profile.equals("debug"),
            overflowChecks: profile.equals("debug")
        },
        toolchain: UmsToolchainConfiguration { host: "".clone() },
        targets: [],
        commands: [],
        dependencies: []
    }
}
