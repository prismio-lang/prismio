import ums.targets.target
import ums.commands.command
import ums.dependency.dependency
import std.string


struct UmsProjectMetadata {
    name: String,
    version: String,
    prismioVersion: String,
    description: String,
    license: String,
    licenseFile: String,
    authors: List<String>,
    descriptionDeclared: Bool,
    licenseDeclared: Bool,
    licenseFileDeclared: Bool,
    authorsDeclared: Bool
}

// Build policy is intentionally not part of project metadata. Profiles and
// cross-target settings can grow here without changing the project's identity.
struct UmsBuildConfiguration {
    profile: String,
    stateDirectory: String,
    buildDirectory: String
}

// Read by the installed compiler before it lowers the complete manifest. The
// `toolchain` block is therefore a deliberately small, stable bootstrap surface:
// once this host exists, that host owns the real UMS parse and command.
struct UmsToolchainConfiguration {
    host: String
}

struct UmsProjectModel {
    root: String,
    manifestPath: String,
    metadata: UmsProjectMetadata,
    build: UmsBuildConfiguration,
    toolchain: UmsToolchainConfiguration,
    targets: List<UmsTarget>,
    commands: List<UmsCommand>,
    dependencies: List<UmsDependency>
}

internal fn umsProjectModel(root: String, manifestPath: String, profile: String) -> UmsProjectModel {
    return UmsProjectModel {
        root: strClone(root),
        manifestPath: strClone(manifestPath),
        metadata: UmsProjectMetadata {
            name: strClone(""),
            version: strClone(""),
            prismioVersion: strClone(""),
            description: strClone(""),
            license: strClone(""),
            licenseFile: strClone(""),
            authors: list_new(),
            descriptionDeclared: false,
            licenseDeclared: false,
            licenseFileDeclared: false,
            authorsDeclared: false
        },
        build: UmsBuildConfiguration {
            profile: strClone(profile),
            stateDirectory: strClone(".prismio"),
            buildDirectory: strClone("build")
        },
        toolchain: UmsToolchainConfiguration { host: strClone("") },
        targets: list_new(),
        commands: list_new(),
        dependencies: list_new()
    }
}
