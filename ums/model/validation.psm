import std.io
import ums.model.project
import ums.model.diagnostic
import std.string

extern fn file_exists(path: String borrow) -> Int
extern fn join_path(directory: String borrow, child: String borrow) -> String produce(free)

// Public because `prismio init` derives a project name from a directory and must
// reject it by the *same* rule this validates it by. A second copy of the rule in
// the writer is a second thing to keep in step -- the mistake src/ir/stmt.psm
// names about `enumPayloadField`.
fn umsValidName(value: String) -> Bool {
    if (__builtin_string_len(value) == 0) { return false }
    let mut i = 0
    while (i < __builtin_string_len(value)) {
        let current = strCharAt(value, i)
        if (umsIsAlnum(current) == false and current != '-' and current != '_' and current != '.') {
            return false
        }
        i = i + 1
    }
    return true
}

private fn umsValidVersion(value: String, minimumComponents: Int) -> Bool {
    let mut components = 1
    let mut componentDigits = 0
    let mut i = 0
    while (i < __builtin_string_len(value)) {
        let current = strCharAt(value, i)
        if (umsIsDigit(current)) {
            componentDigits = componentDigits + 1
        } else if (current == '.' and componentDigits > 0) {
            components = components + 1
            componentDigits = 0
        } else {
            return false
        }
        i = i + 1
    }
    return componentDigits > 0 and components >= minimumComponents
}

// Validation, as methods on the model it validates. `project.validate(diags)`
// rather than `umsProjectValidate(project, diags)`: the same call after the
// checker's rewrite, and the receiver stops being an argument that happens to be
// first.
impl UmsProjectModel {

    private fn validationError(self, diagnostics: List<UmsDiagnostic>,
                          code: String, message: String) {
        umsDiagnosticAdd(diagnostics, code, self.manifestPath, 0, 0, 0, message)
    }

    internal fn validate(self, diagnostics: List<UmsDiagnostic>) {
        if (__builtin_string_len(self.metadata.name) == 0) {
            self.validationError(diagnostics, "UMS2301", "project.name is required")
        } else if (umsValidName(self.metadata.name) == false) {
            self.validationError(diagnostics, "UMS2302",
                               "project.name may contain only letters, digits, '.', '_' and '-'")
        }

        if (__builtin_string_len(self.metadata.version) == 0) {
            self.validationError(diagnostics, "UMS2303", "project.version is required")
        } else if (umsValidVersion(self.metadata.version, 3) == false) {
            self.validationError(diagnostics, "UMS2304",
                               "project.version must use semantic version form")
        }

        if (__builtin_string_len(self.metadata.prismioVersion) == 0) {
            self.validationError(diagnostics, "UMS2305", "project.prismio is required")
        } else if (umsValidVersion(self.metadata.prismioVersion, 2) == false) {
            self.validationError(diagnostics, "UMS2306",
                               "project.prismio must contain at least major and minor versions")
        }

        if (list_len(self.targets) == 0) {
            self.validationError(diagnostics, "UMS2307",
                               "at least one build target is required")
        }

        let mut targetIndex = 0
        while (targetIndex < list_len(self.targets)) {
            let target = list_get(self.targets, targetIndex)
            if (umsValidName(target.name) == false) {
                umsDiagnosticAdd(diagnostics, "UMS2308", self.manifestPath,
                    target.line, target.col, target.len,
                    strConcat(strConcat("invalid target name '", target.name), "'"))
            }
            if (__builtin_string_len(target.entry) == 0) {
                umsDiagnosticAdd(diagnostics, "UMS2309", self.manifestPath,
                    target.line, target.col, target.len,
                    strConcat(strConcat("target '", target.name), "' requires an entry source"))
            } else {
                let sourcePath = join_path(self.root, target.entry)
                if (file_exists(sourcePath) == 0) {
                    umsDiagnosticAdd(diagnostics, "UMS2310", self.manifestPath,
                        target.line, target.col, target.len,
                        strConcat(strConcat(strConcat("target '", target.name),
                                   "' entry does not exist: "), target.entry))
                }
            }
            if (target.kind == UmsTargetKind.LIBRARY) {
                umsDiagnosticAdd(diagnostics, "UMS2313", self.manifestPath,
                    target.line, target.col, target.len,
                    "library targets are modeled but artifact emission is not implemented yet")
            }
            targetIndex = targetIndex + 1
        }

        let mut dependencyIndex = 0
        while (dependencyIndex < list_len(self.dependencies)) {
            let dependency = list_get(self.dependencies, dependencyIndex)
            if (umsValidName(dependency.name) == false) {
                umsDiagnosticAdd(diagnostics, "UMS2311", self.manifestPath,
                    dependency.line, dependency.col, dependency.len,
                    strConcat(strConcat("invalid dependency name '", dependency.name), "'"))
            }
            if (__builtin_string_len(dependency.constraint) == 0) {
                umsDiagnosticAdd(diagnostics, "UMS2312", self.manifestPath,
                    dependency.line, dependency.col, dependency.len,
                    strConcat(strConcat("dependency '", dependency.name),
                               "' has an empty version constraint"))
            }
            dependencyIndex = dependencyIndex + 1
        }
    }
}
