import std.io
import ums.model.project
import ums.commands.command
import ums.parser.lexer
import ums.model.diagnostic
import ums.targets.target
import std.string
import std.fs


// Public because `prismio init` derives a project name from a directory and must
// reject it by the *same* rule this validates it by. A second copy of the rule in
// the writer is a second thing to keep in step -- the mistake src/ir/stmt.psm
// names about `enumPayloadField`.
//
// The first character is a letter or a digit. A name becomes a file under
// `.prismio/build/<profile>/`, so `.` and `..` named directories -- `executable("..")`
// validated and then failed at link time with "Is a directory" -- and a leading
// `-` made a command that parses as a flag.
public fn umsValidName(value: String) -> Bool {
    if (value.length == 0) { return false }
    if (umsIsAlnum(value.charAt(0)) == false) { return false }
    let mut i = 0
    while (i < value.length) {
        let current = value.charAt(i)
        if (umsIsAlnum(current) == false and current != '-' and current != '_' and current != '.') {
            return false
        }
        i = i + 1
    }
    return true
}

// One dot-separated run of `[0-9A-Za-z-]`, as SemVer's pre-release and build
// identifiers are. `numeric` identifiers -- all digits -- may not have a leading
// zero in a pre-release, which is the caller's to ask for.
private fn umsSemverIdentifiers(value: String, start: Int, end: Int, rejectLeadingZero: Bool) -> Bool {
    if (start >= end) { return false }
    let mut from = start
    for i in start..<(end + 1) {
        if (i == end or value.charAt(i) == '.') {
            if (i == from) { return false }
            let mut numeric = true
            for j in from..<i {
                let c = value.charAt(j)
                if (umsIsAlnum(c) == false and c != '-') { return false }
                if (umsIsDigit(c) == false) { numeric = false }
            }
            if (rejectLeadingZero and numeric and i - from > 1 and value.charAt(from) == '0') {
                return false
            }
            from = i + 1
        }
    }
    return true
}

// `MAJOR.MINOR.PATCH`, then an optional `-pre.release` and `+build`: the SemVer
// 2.0.0 grammar. The previous check counted digit groups, so it refused
// `1.0.0-beta.1` -- a valid version -- as "not semantic version form" and took
// `01.02.0003.4`. A numeric component has no leading zero.
private fn umsValidSemver(value: String) -> Bool {
    let length = value.length
    let mut coreEnd = length
    let mut preStart = -1
    let mut buildStart = -1
    for i in 0..<length {
        let c = value.charAt(i)
        if (c == '+' and buildStart < 0) {
            buildStart = i + 1
            if (coreEnd == length) { coreEnd = i }
        } else if (c == '-' and preStart < 0 and buildStart < 0) {
            preStart = i + 1
            coreEnd = i
        }
    }
    if (umsValidNumericVersion(value, 0, coreEnd, 3, 3) == false) { return false }
    if (preStart >= 0) {
        let mut preEnd = length
        if (buildStart >= 0) { preEnd = buildStart - 1 }
        if (umsSemverIdentifiers(value, preStart, preEnd, true) == false) { return false }
    }
    if (buildStart >= 0 and umsSemverIdentifiers(value, buildStart, length, false) == false) {
        return false
    }
    return true
}

// Dot-separated decimal components between `start` and `end`, at least
// `minimum` and at most `maximum` of them, none with a leading zero.
private fn umsValidNumericVersion(value: String, start: Int, end: Int,
                                  minimum: Int, maximum: Int) -> Bool {
    if (start >= end) { return false }
    let mut components = 0
    let mut from = start
    for i in start..<(end + 1) {
        if (i == end or value.charAt(i) == '.') {
            if (i == from) { return false }
            if (i - from > 1 and value.charAt(from) == '0') { return false }
            for j in from..<i {
                if (umsIsDigit(value.charAt(j)) == false) { return false }
            }
            components = components + 1
            from = i + 1
        }
    }
    return components >= minimum and components <= maximum
}

// UMS does not embed the SPDX license catalogue. It does reject strings that
// cannot be SPDX expressions at all; registry publication can later validate
// identifiers against the versioned catalogue it serves.
private fn umsValidLicenseExpression(value: String) -> Bool {
    let trimmed = value.trim()
    if (trimmed.length == 0) { return false }
    let mut i = 0
    while (i < trimmed.length) {
        let current = trimmed.charAt(i)
        if (umsIsAlnum(current) == false and current != '-' and current != '.' and
            current != '+' and current != ':' and current != '(' and
            current != ')' and current != ' ') {
            return false
        }
        i = i + 1
    }
    return true
}

// What `run` can execute besides a declared target. Deliberately two extensions
// and not "anything on disk": the toolchain has to know how to start it, and it
// knows exactly these two -- an interpreter for one, its own compiler for the
// other. A shell script is not on the list because there is no portable way to
// start one, which is the whole reason `shell` exists as a separate step.
private fn umsRunnableScript(value: String) -> Bool {
    return value.endsWith(".py") or value.endsWith(".psm")
}

// Validation, as methods on the model it validates. `project.validate(diags)`
// rather than `umsProjectValidate(project, diags)`: the same call after the
// checker's rewrite, and the receiver stops being an argument that happens to be
// first.
impl UmsProjectModel {

    private fn validationError(self, inout diagnostics: Vec<UmsDiagnostic>, span: UmsSpan,
                          code: String, message: String) {
        umsDiagnosticAdd(diagnostics, code, self.manifestPath,
                         span.line, span.col, span.len, message)
    }

    // A project-relative file a declaration names, which has to exist before a
    // build is worth starting. An absolute path is taken as written: a response
    // file or a system header directory can legitimately live outside the project.
    private fn requireFile(self, inout diagnostics: Vec<UmsDiagnostic>, value: String,
                           line: Int, col: Int, len: Int, code: String, what: String) {
        let mut path = value.clone()
        if (umsAbsolutePath(value) == false) { path = joinPath(self.root, value) }
        if (fileExists(path) == false) {
            umsDiagnosticAdd(diagnostics, code, self.manifestPath, line, col, len,
                             what.concat(" does not exist: ", value))
        }
    }

    internal fn validate(self, inout diagnostics: Vec<UmsDiagnostic>) {
        if (self.metadata.name.length == 0) {
            self.validationError(diagnostics, self.metadata.blockSpan, "UMS2301", "project.name is required")
        } else if (umsValidName(self.metadata.name) == false) {
            self.validationError(diagnostics, self.metadata.nameSpan, "UMS2302",
                               "project.name may contain only letters, digits, '.', '_' and '-'")
        }

        if (self.metadata.version.length == 0) {
            self.validationError(diagnostics, self.metadata.blockSpan, "UMS2303", "project.version is required")
        } else if (umsValidSemver(self.metadata.version) == false) {
            self.validationError(diagnostics, self.metadata.versionSpan, "UMS2304",
                               "project.version must be a semantic version, such as 1.2.0 or 1.0.0-beta.1")
        }

        if (self.metadata.prismioVersion.length == 0) {
            self.validationError(diagnostics, self.metadata.blockSpan, "UMS2305", "project.prismio is required")
        } else if (umsValidNumericVersion(self.metadata.prismioVersion, 0,
                       self.metadata.prismioVersion.length, 2, 3) == false) {
            self.validationError(diagnostics, self.metadata.prismioSpan, "UMS2306",
                               "project.prismio must be MAJOR.MINOR or MAJOR.MINOR.PATCH, such as 0.1")
        }


        if (self.metadata.descriptionDeclared) {
            let description = self.metadata.description.trim()
            if (description.length == 0) {
                self.validationError(diagnostics, self.metadata.descriptionSpan, "UMS2316",
                                   "project.description cannot be empty")
            }
        }

        if (self.metadata.licenseDeclared and
            umsValidLicenseExpression(self.metadata.license) == false) {
            self.validationError(diagnostics, self.metadata.licenseSpan, "UMS2317",
                               "project.license must be a non-empty SPDX expression")
        }
        if (self.metadata.licenseFileDeclared) {
            if (self.metadata.licenseFile.length == 0 or
                umsAbsolutePath(self.metadata.licenseFile)) {
                self.validationError(diagnostics, self.metadata.licenseFileSpan, "UMS2318",
                                   "project.licenseFile must be a non-empty project-relative path")
            } else {
                let licensePath = joinPath(self.root, self.metadata.licenseFile)
                if (fileExists(licensePath) == false) {
                    self.validationError(diagnostics, self.metadata.licenseFileSpan, "UMS2319",
                        "project.licenseFile does not exist: ".concat(self.metadata.licenseFile))
                }
            }
        }
        if (self.metadata.licenseDeclared and self.metadata.licenseFileDeclared) {
            self.validationError(diagnostics, self.metadata.licenseFileSpan, "UMS2320",
                               "project.license and project.licenseFile are mutually exclusive")
        }

        if (self.metadata.authorsDeclared and self.metadata.authors.length == 0) {
            self.validationError(diagnostics, self.metadata.authorsSpan, "UMS2321",
                               "project.authors must contain at least one author")
        }
        let mut authorIndex = 0
        while (authorIndex < self.metadata.authors.length) {
            let author = self.metadata.authors[authorIndex].trim()
            if (author.length == 0) {
                self.validationError(diagnostics, self.metadata.authorsSpan, "UMS2322",
                                   "project.authors cannot contain an empty author")
            }
            authorIndex = authorIndex + 1
        }

        if (self.targets.length == 0) {
            self.validationError(diagnostics, self.metadata.blockSpan, "UMS2307",
                               "at least one build target is required")
        }

        let mut targetIndex = 0
        while (targetIndex < self.targets.length) {
            let target = self.targets[targetIndex]
            if (umsValidName(target.name) == false) {
                umsDiagnosticAdd(diagnostics, "UMS2308", self.manifestPath,
                    target.line, target.col, target.len,
                    "invalid target name '".concat(target.name, "'"))
            }
            if (target.entry.length == 0) {
                umsDiagnosticAdd(diagnostics, "UMS2309", self.manifestPath,
                    target.line, target.col, target.len,
                    "target '".concat(target.name, "' requires an entry source"))
            } else {
                let sourcePath = joinPath(self.root, target.entry)
                if (fileExists(sourcePath) == false) {
                    umsDiagnosticAdd(diagnostics, "UMS2310", self.manifestPath,
                        target.line, target.col, target.len,
                        "target '".concat(target.name, "' entry does not exist: ", target.entry))
                }
            }
            if (target.kind == UmsTargetKind.LIBRARY) {
                umsDiagnosticAdd(diagnostics, "UMS2313", self.manifestPath,
                    target.line, target.col, target.len,
                    "library targets are modeled but artifact emission is not implemented yet")
            }
            let mut linkIndex = 0
            while (linkIndex < target.links.length) {
                let input = target.links[linkIndex]
                if (input.value.length == 0) {
                    umsDiagnosticAdd(diagnostics, "UMS2314", self.manifestPath,
                        input.line, input.col, input.len,
                        "link inputs cannot be empty")
                } else if (input.kind == UmsLinkKind.RESPONSE_FILE) {
                    self.requireFile(diagnostics, input.value, input.line, input.col, input.len,
                                     "UMS2326", "link responseFile")
                }
                linkIndex = linkIndex + 1
            }
            for nativeIndex in 0..<target.natives.length {
                let input = target.natives[nativeIndex]
                if (input.value.length == 0) {
                    umsDiagnosticAdd(diagnostics, "UMS2314", self.manifestPath,
                        input.line, input.col, input.len,
                        "native inputs cannot be empty")
                } else if (input.kind == UmsNativeKind.SOURCE) {
                    // C or C++: clang picks the language from the extension. The
                    // driver links no C++ runtime of its own, so a target with C++
                    // sources names it in `link` -- the compiler's does, through
                    // third_party/llvm-link.rsp (`-lc++`) for runtime/llvm_bridge.cpp.
                    let isC = input.value.endsWith(".c")
                    let isCpp = input.value.endsWith(".cpp") or input.value.endsWith(".cc")
                        or input.value.endsWith(".cxx")
                    if (isC == false and isCpp == false) {
                        umsDiagnosticAdd(diagnostics, "UMS2324", self.manifestPath,
                            input.line, input.col, input.len,
                            "native source '".concat(input.value, "' is not a C or C++ file (.c, .cpp, .cc, .cxx)"))
                    } else {
                        self.requireFile(diagnostics, input.value, input.line, input.col,
                                         input.len, "UMS2324", "native source")
                    }
                } else if (input.kind == UmsNativeKind.INCLUDE) {
                    if (directoryExists(joinPath(self.root, input.value)) == false) {
                        umsDiagnosticAdd(diagnostics, "UMS2325", self.manifestPath,
                            input.line, input.col, input.len,
                            "native include directory does not exist: ".concat(input.value))
                    }
                } else if (input.kind == UmsNativeKind.RESPONSE_FILE) {
                    self.requireFile(diagnostics, input.value, input.line, input.col, input.len,
                                     "UMS2326", "native responseFile")
                }
            }
            targetIndex = targetIndex + 1
        }

        let mut dependencyIndex = 0
        while (dependencyIndex < self.dependencies.length) {
            let dependency = self.dependencies[dependencyIndex]
            if (umsValidName(dependency.name) == false) {
                umsDiagnosticAdd(diagnostics, "UMS2311", self.manifestPath,
                    dependency.line, dependency.col, dependency.len,
                    "invalid dependency name '".concat(dependency.name, "'"))
            }
            if (dependency.constraint.length == 0) {
                umsDiagnosticAdd(diagnostics, "UMS2312", self.manifestPath,
                    dependency.line, dependency.col, dependency.len,
                    "dependency '".concat(dependency.name, "' has an empty version constraint"))
            }
            dependencyIndex = dependencyIndex + 1
        }

        let mut commandIndex = 0
        while (commandIndex < self.commands.length) {
            let command = self.commands[commandIndex]
            if (umsValidName(command.name) == false) {
                umsDiagnosticAdd(diagnostics, "UMS2601", self.manifestPath,
                    command.line, command.col, command.len,
                    "invalid command name '".concat(command.name, "'"))
            }
            if (command.steps.length == 0) {
                umsDiagnosticAdd(diagnostics, "UMS2602", self.manifestPath,
                    command.line, command.col, command.len,
                    "command '".concat(command.name, "' declares no steps"))
            }
            let mut stepIndex = 0
            while (stepIndex < command.steps.length) {
                let step = command.steps[stepIndex]
                if (step.kind == UmsCommandStepKind.UNKNOWN) {
                    // Lowering already reported this one; a second diagnostic
                    // about its subject would name a mistake that is not there.
                    stepIndex = stepIndex + 1
                    continue
                }
                if (step.kind == UmsCommandStepKind.SHELL) {
                    if (step.subject.length == 0) {
                        umsDiagnosticAdd(diagnostics, "UMS2605", self.manifestPath,
                            step.line, step.col, step.len,
                            "a shell step needs a program to run")
                    }
                } else {
                    let referenced = umsTargetFind(self.targets, step.subject)
                    if (referenced >= 0) {
                        if (step.kind == UmsCommandStepKind.RUN and
                            self.targets[referenced].kind != UmsTargetKind.EXECUTABLE) {
                            umsDiagnosticAdd(diagnostics, "UMS2604", self.manifestPath,
                                step.line, step.col, step.len,
                                "run needs an executable target, and '".concat(step.subject,
                                                                               "' is not one"))
                        }
                    } else if (step.kind == UmsCommandStepKind.BUILD) {
                        umsDiagnosticAdd(diagnostics, "UMS2603", self.manifestPath,
                            step.line, step.col, step.len,
                            "no target named '".concat(step.subject,
                                                       "' is declared in this project"))
                    } else if (umsRunnableScript(step.subject) == false) {
                        umsDiagnosticAdd(diagnostics, "UMS2606", self.manifestPath,
                            step.line, step.col, step.len,
                            "run names no declared target, and '".concat(step.subject,
                                                                         "' is not a .py or .psm file; use shell for anything else"))
                    } else if (fileExists(joinPath(self.root, step.subject)) == false) {
                        umsDiagnosticAdd(diagnostics, "UMS2607", self.manifestPath,
                            step.line, step.col, step.len,
                            "run cannot find '".concat(step.subject, "' under the project root"))
                    }
                }
                stepIndex = stepIndex + 1
            }
            commandIndex = commandIndex + 1
        }
    }
}
