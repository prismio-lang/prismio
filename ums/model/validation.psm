import std.io
import ums.model.project
import ums.model.diagnostic

extern fn str_char_at(value: String, index: Int) -> Char
extern fn str_concat(left: String, right: String) -> String
extern fn file_exists(path: String borrow) -> Int
extern fn join_path(directory: String borrow, child: String borrow) -> String produce(free)

fn umsValidName(value: String) -> Bool {
    if (__builtin_string_len(value) == 0) { return false }
    let mut i = 0
    while (i < __builtin_string_len(value)) {
        let current = str_char_at(value, i)
        if (umsIsAlnum(current) == false and current != '-' and current != '_' and current != '.') {
            return false
        }
        i = i + 1
    }
    return true
}

fn umsValidVersion(value: String, minimumComponents: Int) -> Bool {
    let mut components = 1
    let mut componentDigits = 0
    let mut i = 0
    while (i < __builtin_string_len(value)) {
        let current = str_char_at(value, i)
        if (umsIsDigit(current)) {
            componentDigits = componentDigits + 1
        } else if (current == '.' and componentDigits > 0) {
            components = components + 1
            componentDigits = 0
        } else {
            return false
        }
        i = i + 1
    }
    return componentDigits > 0 and components >= minimumComponents
}

fn umsValidationError(project: UmsProjectModel, diagnostics: List<UmsDiagnostic>,
                      code: String, message: String) {
    umsDiagnosticAdd(diagnostics, code, project.manifestPath, 0, 0, 0, message)
}

fn umsProjectValidate(project: UmsProjectModel, diagnostics: List<UmsDiagnostic>) {
    if (__builtin_string_len(project.metadata.name) == 0) {
        umsValidationError(project, diagnostics, "UMS2301", "project.name is required")
    } else if (umsValidName(project.metadata.name) == false) {
        umsValidationError(project, diagnostics, "UMS2302",
                           "project.name may contain only letters, digits, '.', '_' and '-'")
    }

    if (__builtin_string_len(project.metadata.version) == 0) {
        umsValidationError(project, diagnostics, "UMS2303", "project.version is required")
    } else if (umsValidVersion(project.metadata.version, 3) == false) {
        umsValidationError(project, diagnostics, "UMS2304",
                           "project.version must use semantic version form")
    }

    if (__builtin_string_len(project.metadata.prismioVersion) == 0) {
        umsValidationError(project, diagnostics, "UMS2305", "project.prismio is required")
    } else if (umsValidVersion(project.metadata.prismioVersion, 2) == false) {
        umsValidationError(project, diagnostics, "UMS2306",
                           "project.prismio must contain at least major and minor versions")
    }

    if (list_len(project.targets) == 0) {
        umsValidationError(project, diagnostics, "UMS2307",
                           "at least one build target is required")
    }

    let mut targetIndex = 0
    while (targetIndex < list_len(project.targets)) {
        let target = list_get(project.targets, targetIndex)
        if (umsValidName(target.name) == false) {
            umsDiagnosticAdd(diagnostics, "UMS2308", project.manifestPath,
                target.line, target.col, target.len,
                str_concat(str_concat("invalid target name '", target.name), "'"))
        }
        if (__builtin_string_len(target.entry) == 0) {
            umsDiagnosticAdd(diagnostics, "UMS2309", project.manifestPath,
                target.line, target.col, target.len,
                str_concat(str_concat("target '", target.name), "' requires an entry source"))
        } else {
            let sourcePath = join_path(project.root, target.entry)
            if (file_exists(sourcePath) == 0) {
                umsDiagnosticAdd(diagnostics, "UMS2310", project.manifestPath,
                    target.line, target.col, target.len,
                    str_concat(str_concat(str_concat("target '", target.name),
                               "' entry does not exist: "), target.entry))
            }
        }
        if (target.kind == UmsTargetKind.LIBRARY) {
            umsDiagnosticAdd(diagnostics, "UMS2313", project.manifestPath,
                target.line, target.col, target.len,
                "library targets are modeled but artifact emission is not implemented yet")
        }
        targetIndex = targetIndex + 1
    }

    let mut dependencyIndex = 0
    while (dependencyIndex < list_len(project.dependencies)) {
        let dependency = list_get(project.dependencies, dependencyIndex)
        if (umsValidName(dependency.name) == false) {
            umsDiagnosticAdd(diagnostics, "UMS2311", project.manifestPath,
                dependency.line, dependency.col, dependency.len,
                str_concat(str_concat("invalid dependency name '", dependency.name), "'"))
        }
        if (__builtin_string_len(dependency.constraint) == 0) {
            umsDiagnosticAdd(diagnostics, "UMS2312", project.manifestPath,
                dependency.line, dependency.col, dependency.len,
                str_concat(str_concat("dependency '", dependency.name),
                           "' has an empty version constraint"))
        }
        dependencyIndex = dependencyIndex + 1
    }
}
