import std.io
import ums.model.project
import ums.model.diagnostic
import ums.commands.command
import ums.targets.target
import ums.dependency.dependency
import ums.parser.ast
import std.string


private fn umsSpanOf(statement: UmsAstStatement) -> UmsSpan {
    return UmsSpan { line: statement.line, col: statement.col, len: statement.len }
}

// Lowering an AST document into the model, as methods on the model being built.
// Every one of these took `project` as its first parameter; an `impl` block is a
// naming construct, so this is the same code with the receiver named as one.
impl UmsProjectModel {

    private fn lowerError(self, inout diagnostics: Vec<UmsDiagnostic>,
                     statement: UmsAstStatement, code: String, message: String) {
        umsDiagnosticAdd(diagnostics, code, self.manifestPath,
                         statement.line, statement.col, statement.len, message)
    }

    private fn lowerString(self, inout diagnostics: Vec<UmsDiagnostic>,
                      statement: UmsAstStatement, description: String) -> Bool {
        if (statement.value.kind == UmsAstValueKind.STRING) { return true }
        self.lowerError(diagnostics, statement, "UMS2001",
                      description.concat(" must be a string literal"))
        return false
    }

    private fn lowerAuthors(self, inout diagnostics: Vec<UmsDiagnostic>,
                       statement: UmsAstStatement) {
        if (statement.value.kind != UmsAstValueKind.ARRAY) {
            self.lowerError(diagnostics, statement, "UMS2011",
                          "project.authors must be an array")
            return
        }
        let mut i = 0
        while (i < statement.arrayValues.length) {
            let author = statement.arrayValues[i]
            if (author.kind != UmsAstValueKind.STRING) {
                umsDiagnosticAdd(diagnostics, "UMS2012", self.manifestPath,
                                 author.line, author.col, author.len,
                                 "every project.authors item must be a string literal")
            } else {
                self.metadata.authors.push(author.text.clone())
            }
            i = i + 1
        }
    }

    private fn lowerMetadata(self, document: UmsAstDocument,
                        block: UmsAstStatement,
                        inout diagnostics: Vec<UmsDiagnostic>) {
        let mut i = 0
        while (i < block.children.length) {
            let property = document.statements[block.children[i]]
            if (property.kind != UmsAstStatementKind.ASSIGNMENT) {
                self.lowerError(diagnostics, property, "UMS2003",
                              "project metadata contains properties, not nested DSL calls")
            } else if (property.name.equals("name")) {
                if (self.lowerString(diagnostics, property, "project.name")) {
                    if (__builtin_string_len(self.metadata.name) > 0) {
                        self.lowerError(diagnostics, property, "UMS2002",
                                      "project.name is declared more than once")
                    } else {
                        self.metadata.name = property.value.text.clone()
                        self.metadata.nameSpan = umsSpanOf(property)
                    }
                }
            } else if (property.name.equals("version")) {
                if (self.lowerString(diagnostics, property, "project.version")) {
                    if (__builtin_string_len(self.metadata.version) > 0) {
                        self.lowerError(diagnostics, property, "UMS2002",
                                      "project.version is declared more than once")
                    } else {
                        self.metadata.version = property.value.text.clone()
                        self.metadata.versionSpan = umsSpanOf(property)
                    }
                }
            } else if (property.name.equals("prismio")) {
                if (self.lowerString(diagnostics, property, "project.prismio")) {
                    if (__builtin_string_len(self.metadata.prismioVersion) > 0) {
                        self.lowerError(diagnostics, property, "UMS2002",
                                      "project.prismio is declared more than once")
                    } else {
                        self.metadata.prismioVersion = property.value.text.clone()
                        self.metadata.prismioSpan = umsSpanOf(property)
                    }
                }
            } else if (property.name.equals("description")) {
                if (self.metadata.descriptionDeclared) {
                    self.lowerError(diagnostics, property, "UMS2002",
                                  "project.description is declared more than once")
                } else {
                    self.metadata.descriptionDeclared = true
                    self.metadata.descriptionSpan = umsSpanOf(property)
                    if (self.lowerString(diagnostics, property, "project.description")) {
                        self.metadata.description = property.value.text.clone()
                    }
                }
            } else if (property.name.equals("license")) {
                if (self.metadata.licenseDeclared) {
                    self.lowerError(diagnostics, property, "UMS2002",
                                  "project.license is declared more than once")
                } else {
                    self.metadata.licenseDeclared = true
                    self.metadata.licenseSpan = umsSpanOf(property)
                    if (self.lowerString(diagnostics, property, "project.license")) {
                        self.metadata.license = property.value.text.clone()
                    }
                }
            } else if (property.name.equals("licenseFile")) {
                if (self.metadata.licenseFileDeclared) {
                    self.lowerError(diagnostics, property, "UMS2002",
                                  "project.licenseFile is declared more than once")
                } else {
                    self.metadata.licenseFileDeclared = true
                    self.metadata.licenseFileSpan = umsSpanOf(property)
                    if (self.lowerString(diagnostics, property, "project.licenseFile")) {
                        self.metadata.licenseFile = property.value.text.clone()
                    }
                }
            } else if (property.name.equals("authors")) {
                if (self.metadata.authorsDeclared) {
                    self.lowerError(diagnostics, property, "UMS2002",
                                  "project.authors is declared more than once")
                } else {
                    self.metadata.authorsDeclared = true
                    self.metadata.authorsSpan = umsSpanOf(property)
                    self.lowerAuthors(diagnostics, property)
                }
            } else {
                self.lowerError(diagnostics, property, "UMS2004",
                    "unknown project property '".concat(property.name, "'"))
            }
            i = i + 1
        }
    }

    private fn lowerToolchain(self, document: UmsAstDocument,
                         block: UmsAstStatement,
                         inout diagnostics: Vec<UmsDiagnostic>) {
        let mut i = 0
        while (i < block.children.length) {
            let property = document.statements[block.children[i]]
            if (property.kind != UmsAstStatementKind.ASSIGNMENT or
                property.name.equals("host") == false) {
                self.lowerError(diagnostics, property, "UMS2401",
                    "toolchain contains only the optional 'host' property")
            } else if (self.lowerString(diagnostics, property, "toolchain.host")) {
                if (__builtin_string_len(self.toolchain.host) > 0) {
                    self.lowerError(diagnostics, property, "UMS2402",
                                  "toolchain.host is declared more than once")
                } else if (__builtin_string_len(property.value.text) == 0) {
                    self.lowerError(diagnostics, property, "UMS2404",
                                  "toolchain.host cannot be empty")
                } else {
                    self.toolchain.host = property.value.text.clone()
                }
            }
            i = i + 1
        }
    }

    private fn lowerLinkBlock(self, document: UmsAstDocument,
                         block: UmsAstStatement,
                         target: UmsTarget,
                         inout diagnostics: Vec<UmsDiagnostic>) {
        if (block.arguments.length != 0) {
            self.lowerError(diagnostics, block, "UMS2107",
                          "link takes no arguments")
            return
        }

        let mut i = 0
        while (i < block.children.length) {
            let declaration = document.statements[block.children[i]]
            let mut kind = UmsLinkKind.UNKNOWN
            if (declaration.name.equals("library")) { kind = UmsLinkKind.LIBRARY }
            else if (declaration.name.equals("search")) { kind = UmsLinkKind.SEARCH }
            else if (declaration.name.equals("file")) { kind = UmsLinkKind.FILE }
            else if (declaration.name.equals("framework")) { kind = UmsLinkKind.FRAMEWORK }
            else if (declaration.name.equals("responseFile")) { kind = UmsLinkKind.RESPONSE_FILE }
            else if (declaration.name.equals("script")) { kind = UmsLinkKind.SCRIPT }
            else if (declaration.name.equals("arg")) { kind = UmsLinkKind.ARG }

            if (declaration.kind != UmsAstStatementKind.CALL or
                declaration.hasBlock or kind == UmsLinkKind.UNKNOWN) {
                self.lowerError(diagnostics, declaration, "UMS2108",
                    "unknown link declaration '".concat(declaration.name,
                                                        "'; expected library, search, file, framework, responseFile, script or arg"))
            } else if (declaration.arguments.length != 1 or
                       declaration.arguments[0].kind != UmsAstValueKind.STRING) {
                self.lowerError(diagnostics, declaration, "UMS2109",
                    declaration.name.concat(" requires exactly one string argument"))
            } else {
                let value = declaration.arguments[0]
                target.links.push(umsLinkInput(kind, value.text,
                          declaration.line, declaration.col, declaration.len))
            }
            i = i + 1
        }
    }

    // `native { source(...) include(...) define(...) flag(...) responseFile(...) }`.
    // Each call takes one or more strings, so a list of sources can be one call or
    // one per line; the order of every argument is kept, because the order of
    // flags and of objects on a link line is meaningful.
    private fn lowerNative(self, document: UmsAstDocument,
                                block: UmsAstStatement,
                                target: UmsTarget,
                                inout diagnostics: Vec<UmsDiagnostic>) {
        if (block.arguments.length != 0) {
            self.lowerError(diagnostics, block, "UMS2111",
                          "native takes no arguments")
            return
        }
        for i in 0..<block.children.length {
            let declaration = document.statements[block.children[i]]
            let mut kind = UmsNativeKind.UNKNOWN
            if (declaration.name.equals("source")) { kind = UmsNativeKind.SOURCE }
            else if (declaration.name.equals("include")) { kind = UmsNativeKind.INCLUDE }
            else if (declaration.name.equals("define")) { kind = UmsNativeKind.DEFINE }
            else if (declaration.name.equals("flag")) { kind = UmsNativeKind.FLAG }
            else if (declaration.name.equals("responseFile")) { kind = UmsNativeKind.RESPONSE_FILE }

            if (declaration.kind != UmsAstStatementKind.CALL or
                declaration.hasBlock or kind == UmsNativeKind.UNKNOWN) {
                self.lowerError(diagnostics, declaration, "UMS2112",
                    "unknown native declaration '".concat(declaration.name,
                                                          "'; expected source, include, define, flag or responseFile"))
            } else if (declaration.arguments.length == 0) {
                self.lowerError(diagnostics, declaration, "UMS2113",
                    declaration.name.concat(" requires at least one string argument"))
            } else {
                for j in 0..<declaration.arguments.length {
                    let value = declaration.arguments[j]
                    if (value.kind != UmsAstValueKind.STRING) {
                        umsDiagnosticAdd(diagnostics, "UMS2113", self.manifestPath,
                                         value.line, value.col, value.len,
                                         declaration.name.concat(" takes strings"))
                    } else {
                        target.natives.push(umsNativeInput(kind, value.text,
                                  value.line, value.col, value.len))
                    }
                }
            }
        }
    }

    private fn lowerBody(self, document: UmsAstDocument,
                    call: UmsAstStatement,
                    target: UmsTarget,
                    inout diagnostics: Vec<UmsDiagnostic>) -> String {
        let mut entry = ""
        let mut linkBlocks = 0
        let mut nativeBlocks = 0
        let mut runtimeDeclared = false
        let mut exportDeclared = false
        let mut declared = ""
        let mut i = 0
        while (i < call.children.length) {
            let property = document.statements[call.children[i]]
            if (property.kind == UmsAstStatementKind.CALL and
                property.hasBlock and property.name.equals("link")) {
                linkBlocks = linkBlocks + 1
                if (linkBlocks > 1) {
                    self.lowerError(diagnostics, property, "UMS2110",
                                  "target link is declared more than once")
                } else {
                    self.lowerLinkBlock(document, property, target, diagnostics)
                }
            } else if (property.kind == UmsAstStatementKind.CALL and
                       property.hasBlock and property.name.equals("native")) {
                nativeBlocks = nativeBlocks + 1
                if (nativeBlocks > 1) {
                    self.lowerError(diagnostics, property, "UMS2110",
                                  "target native is declared more than once")
                } else {
                    self.lowerNative(document, property, target, diagnostics)
                }
            } else if (property.kind == UmsAstStatementKind.ASSIGNMENT and
                       property.name.equals("runtime")) {
                if (runtimeDeclared) {
                    self.lowerError(diagnostics, property, "UMS2102",
                                  "target runtime is declared more than once")
                } else if (self.lowerString(diagnostics, property, "target runtime")) {
                    runtimeDeclared = true
                    if (property.value.text.equals("installed") or property.value.text.equals("none")) {
                        target.runtime = property.value.text.clone()
                    } else {
                        self.lowerError(diagnostics, property, "UMS2114",
                            "target runtime is \"installed\" or \"none\", not \"".concat(
                                property.value.text, "\""))
                    }
                }
            } else if (property.kind == UmsAstStatementKind.ASSIGNMENT and
                       property.name.equals("exportDynamic")) {
                if (exportDeclared) {
                    self.lowerError(diagnostics, property, "UMS2102",
                                  "target exportDynamic is declared more than once")
                } else if (property.value.kind != UmsAstValueKind.BOOLEAN) {
                    self.lowerError(diagnostics, property, "UMS2115",
                                  "target exportDynamic must be true or false")
                } else {
                    exportDeclared = true
                    target.exportDynamic = property.value.text.equals("true")
                }
            } else if (property.kind == UmsAstStatementKind.ASSIGNMENT and
                       (property.name.equals("freestanding") or property.name.equals("noRedZone"))) {
                // Booleans, each declared once. `declared` is the set of freestanding
                // properties seen, so a repeat is one error and not a silent override.
                if (declared.contains("|".concat(property.name, "|"))) {
                    self.lowerError(diagnostics, property, "UMS2102",
                                  "target ".concat(property.name, " is declared more than once"))
                } else if (property.value.kind != UmsAstValueKind.BOOLEAN) {
                    self.lowerError(diagnostics, property, "UMS2115",
                                  "target ".concat(property.name, " must be true or false"))
                } else {
                    declared = declared.concat("|", property.name, "|")
                    if (property.name.equals("freestanding")) {
                        target.freestanding = property.value.text.equals("true")
                    } else {
                        target.noRedZone = property.value.text.equals("true")
                    }
                }
            } else if (property.kind == UmsAstStatementKind.ASSIGNMENT and
                       (property.name.equals("triple") or property.name.equals("features")
                        or property.name.equals("codeModel"))) {
                if (declared.contains("|".concat(property.name, "|"))) {
                    self.lowerError(diagnostics, property, "UMS2102",
                                  "target ".concat(property.name, " is declared more than once"))
                } else if (self.lowerString(diagnostics, property, "target ".concat(property.name))) {
                    declared = declared.concat("|", property.name, "|")
                    if (property.name.equals("triple")) {
                        target.triple = property.value.text.clone()
                    } else if (property.name.equals("features")) {
                        target.features = property.value.text.clone()
                    } else if (property.value.text.equals("small") or property.value.text.equals("kernel")
                               or property.value.text.equals("medium") or property.value.text.equals("large")) {
                        target.codeModel = property.value.text.clone()
                    } else {
                        self.lowerError(diagnostics, property, "UMS2116",
                            "target codeModel is small, kernel, medium or large, not \"".concat(
                                property.value.text, "\""))
                    }
                }
            } else if (property.kind != UmsAstStatementKind.ASSIGNMENT or
                       property.name.equals("entry") == false) {
                self.lowerError(diagnostics, property, "UMS2101",
                    "unknown target property '".concat(property.name,
                                                       "'; expected entry, runtime, exportDynamic, freestanding, triple, features, codeModel, noRedZone, native or link"))
            } else if (self.lowerString(diagnostics, property, "target entry")) {
                if (__builtin_string_len(entry) > 0) {
                    self.lowerError(diagnostics, property, "UMS2102",
                                  "target entry is declared more than once")
                } else {
                    entry = property.value.text.clone()
                }
            }
            i = i + 1
        }
        return entry
    }

    private fn lowerTarget(self, document: UmsAstDocument,
                      call: UmsAstStatement,
                      inout diagnostics: Vec<UmsDiagnostic>) {
        let mut kind = UmsTargetKind.UNKNOWN
        if (call.name.equals("executable")) { kind = UmsTargetKind.EXECUTABLE }
        else if (call.name.equals("library")) { kind = UmsTargetKind.LIBRARY }
        // A test target is an ordinary program that exits 0 when it passes.
        // Prismio has no test framework and this deliberately does not invent
        // one: the exit status is the whole protocol, which is what a language
        // with no assertion library can actually promise.
        else if (call.name.equals("test")) { kind = UmsTargetKind.TEST }
        else {
            self.lowerError(diagnostics, call, "UMS2103",
                "unknown target kind '".concat(call.name, "'"))
            return
        }

        if (call.arguments.length != 1) {
            self.lowerError(diagnostics, call, "UMS2104",
                          call.name.concat(" requires exactly one string name"))
            return
        }
        let argument = call.arguments[0]
        if (argument.kind != UmsAstValueKind.STRING) {
            self.lowerError(diagnostics, call, "UMS2104",
                          call.name.concat(" requires exactly one string name"))
            return
        }
        let targetName = argument.text.clone()
        if (umsTargetFind(self.targets, targetName) >= 0) {
            self.lowerError(diagnostics, call, "UMS2105",
                "target '".concat(targetName, "' is declared more than once"))
            return
        }
        let target = umsTarget(kind, targetName, "",
                               call.line, call.col, call.len)
        target.entry = self.lowerBody(document, call, target, diagnostics)
        self.targets.push(target)
    }

    private fn lowerTargets(self, document: UmsAstDocument,
                       block: UmsAstStatement,
                       inout diagnostics: Vec<UmsDiagnostic>) {
        let mut i = 0
        while (i < block.children.length) {
            let call = document.statements[block.children[i]]
            if (call.kind != UmsAstStatementKind.CALL) {
                self.lowerError(diagnostics, call, "UMS2106",
                              "targets contains executable(...), library(...) or test(...) declarations")
            } else {
                self.lowerTarget(document, call, diagnostics)
            }
            i = i + 1
        }
    }

    // Everything after the program: string literals, plus the bare word `args`
    // standing for what the user typed after the command name. The marker keeps
    // its position in the list, so a command can put forwarded arguments in the
    // middle of a fixed argument list rather than only at the end.
    private fn lowerStepArguments(self, call: UmsAstStatement, step: UmsCommandStep,
                             inout diagnostics: Vec<UmsDiagnostic>) {
        let mut i = 1
        while (i < call.arguments.length) {
            let argument = call.arguments[i]
            if (argument.kind == UmsAstValueKind.STRING) {
                step.arguments.push(umsCommandArgument(false, argument.text,
                          argument.line, argument.col, argument.len))
            } else if (argument.kind == UmsAstValueKind.IDENTIFIER and
                       argument.text.equals("args")) {
                step.arguments.push(umsCommandArgument(true, "",
                          argument.line, argument.col, argument.len))
            } else {
                umsDiagnosticAdd(diagnostics, "UMS2508", self.manifestPath,
                                 argument.line, argument.col, argument.len,
                                 "a step argument is a string literal or the bare word `args`")
            }
            i = i + 1
        }
    }

    // A rejected step is still pushed, as UNKNOWN. Validation skips that kind
    // because lowering has already reported it, and the push is what stops a
    // command whose only step was rejected from *also* being reported as
    // declaring no steps -- one mistake, two errors, two things to go and fix.
    private fn lowerCommandStep(self, call: UmsAstStatement, command: UmsCommand,
                           inout diagnostics: Vec<UmsDiagnostic>) {
        let mut kind = UmsCommandStepKind.UNKNOWN
        if (call.name.equals("build")) { kind = UmsCommandStepKind.BUILD }
        else if (call.name.equals("run")) { kind = UmsCommandStepKind.RUN }
        else if (call.name.equals("shell")) { kind = UmsCommandStepKind.SHELL }

        if (call.kind != UmsAstStatementKind.CALL or call.hasBlock or
            kind == UmsCommandStepKind.UNKNOWN) {
            self.lowerError(diagnostics, call, "UMS2504",
                "unknown command step '".concat(call.name, "'; expected build, run or shell"))
            kind = UmsCommandStepKind.UNKNOWN
        } else if (call.arguments.length == 0 or
                   call.arguments[0].kind != UmsAstValueKind.STRING) {
            self.lowerError(diagnostics, call, "UMS2505",
                call.name.concat(" requires a string as its first argument"))
            kind = UmsCommandStepKind.UNKNOWN
        } else if (kind == UmsCommandStepKind.BUILD and call.arguments.length != 1) {
            self.lowerError(diagnostics, call, "UMS2506",
                          "build takes exactly one target name")
            kind = UmsCommandStepKind.UNKNOWN
        }

        if (kind == UmsCommandStepKind.UNKNOWN) {
            command.steps.push(umsCommandStep(kind, call.name,
                      call.line, call.col, call.len))
            return
        }

        let subject = call.arguments[0]
        let step = umsCommandStep(kind, subject.text, call.line, call.col, call.len)
        if (kind != UmsCommandStepKind.BUILD) {
            self.lowerStepArguments(call, step, diagnostics)
        }
        command.steps.push(step)
    }

    private fn lowerCommand(self, document: UmsAstDocument,
                       call: UmsAstStatement,
                       inout diagnostics: Vec<UmsDiagnostic>) {
        if (call.name.equals("command") == false or call.hasBlock == false) {
            self.lowerError(diagnostics, call, "UMS2501",
                "unknown commands declaration '".concat(call.name,
                                                        "'; expected command(\"name\") { ... }"))
            return
        }
        if (call.arguments.length != 1) {
            self.lowerError(diagnostics, call, "UMS2502",
                          "command requires exactly one string name")
            return
        }
        let argument = call.arguments[0]
        if (argument.kind != UmsAstValueKind.STRING) {
            self.lowerError(diagnostics, call, "UMS2502",
                          "command requires exactly one string name")
            return
        }
        let commandName = argument.text.clone()
        if (umsCommandFind(self.commands, commandName) >= 0) {
            self.lowerError(diagnostics, call, "UMS2503",
                "command '".concat(commandName, "' is declared more than once"))
            return
        }

        let command = umsCommand(commandName, call.line, call.col, call.len)
        let mut descriptions = 0
        let mut i = 0
        while (i < call.children.length) {
            let child = document.statements[call.children[i]]
            if (child.kind != UmsAstStatementKind.ASSIGNMENT) {
                self.lowerCommandStep(child, command, diagnostics)
            } else if (child.name.equals("description") == false) {
                self.lowerError(diagnostics, child, "UMS2509",
                    "unknown command property '".concat(child.name, "'; expected 'description'"))
            } else if (self.lowerString(diagnostics, child, "command description")) {
                descriptions = descriptions + 1
                if (descriptions > 1) {
                    self.lowerError(diagnostics, child, "UMS2507",
                                  "command description is declared more than once")
                } else {
                    command.description = child.value.text.clone()
                }
            }
            i = i + 1
        }
        self.commands.push(command)
    }

    private fn lowerCommands(self, document: UmsAstDocument,
                        block: UmsAstStatement,
                        inout diagnostics: Vec<UmsDiagnostic>) {
        let mut i = 0
        while (i < block.children.length) {
            let call = document.statements[block.children[i]]
            if (call.kind != UmsAstStatementKind.CALL) {
                self.lowerError(diagnostics, call, "UMS2501",
                              "commands contains command(...) declarations")
            } else {
                self.lowerCommand(document, call, diagnostics)
            }
            i = i + 1
        }
    }
}

impl UmsProjectModel {

    // `profiles { debug { debugInfo = false } release { overflowChecks = true } }`.
    // Every block is checked; only the one naming the profile being built changes
    // anything, since a build has exactly one profile.
    private fn lowerProfiles(self, document: UmsAstDocument,
                             block: UmsAstStatement,
                             inout diagnostics: Vec<UmsDiagnostic>) {
        let mut seenDebug = false
        let mut seenRelease = false
        for i in 0..<block.children.length {
            let profile = document.statements[block.children[i]]
            let isDebug = profile.name.equals("debug")
            let isRelease = profile.name.equals("release")
            if (profile.kind != UmsAstStatementKind.CALL or profile.hasBlock == false or
                profile.arguments.length != 0 or (isDebug == false and isRelease == false)) {
                self.lowerError(diagnostics, profile, "UMS2701",
                    "profiles holds debug { ... } and release { ... }, not '".concat(profile.name, "'"))
                continue
            }
            if ((isDebug and seenDebug) or (isRelease and seenRelease)) {
                self.lowerError(diagnostics, profile, "UMS2702",
                    "profile '".concat(profile.name, "' is declared more than once"))
                continue
            }
            if (isDebug) { seenDebug = true } else { seenRelease = true }
            let selected = profile.name.equals(self.build.profile)
            for j in 0..<profile.children.length {
                let setting = document.statements[profile.children[j]]
                let known = setting.name.equals("debugInfo") or setting.name.equals("overflowChecks")
                if (setting.kind != UmsAstStatementKind.ASSIGNMENT or known == false) {
                    self.lowerError(diagnostics, setting, "UMS2703",
                        "unknown profile setting '".concat(setting.name,
                                                           "'; expected debugInfo or overflowChecks"))
                } else if (setting.value.kind != UmsAstValueKind.BOOLEAN) {
                    self.lowerError(diagnostics, setting, "UMS2704",
                        "profile setting '".concat(setting.name, "' must be true or false"))
                } else if (selected) {
                    let on = setting.value.text.equals("true")
                    if (setting.name.equals("debugInfo")) {
                        self.build.debugInfo = on
                    } else {
                        self.build.overflowChecks = on
                    }
                }
            }
        }
    }
}

private fn umsDependencyScope(name: String) -> UmsDependencyScope {
    if (name.equals("implementation")) {
        return UmsDependencyScope.IMPLEMENTATION
    }
    if (name.equals("api")) { return UmsDependencyScope.API }
    if (name.equals("testImplementation")) {
        return UmsDependencyScope.TEST_IMPLEMENTATION
    }
    return UmsDependencyScope.UNKNOWN
}

impl UmsProjectModel {

    private fn lowerDependencies(self, document: UmsAstDocument,
                            block: UmsAstStatement,
                            inout diagnostics: Vec<UmsDiagnostic>) {
        let mut i = 0
        while (i < block.children.length) {
            let call = document.statements[block.children[i]]
            let scope = umsDependencyScope(call.name)
            if (call.kind != UmsAstStatementKind.CALL or scope == UmsDependencyScope.UNKNOWN) {
                self.lowerError(diagnostics, call, "UMS2201",
                    "unknown dependency declaration '".concat(call.name, "'"))
            } else if (call.arguments.length < 2 or call.arguments.length > 3) {
                // Two arguments is a registry dependency; a third is the local path
                // it resolves to instead. Positional rather than named, because the
                // DSL's calls are positional and a `path =` form would be new grammar
                // for one argument.
                self.lowerError(diagnostics, call, "UMS2202",
                              call.name.concat(" requires package name and version constraint strings, and an optional local path"))
            } else {
                let name = call.arguments[0]
                let constraint = call.arguments[1]
                let mut declaredPath = "".clone()
                let mut pathOk = true
                if (call.arguments.length == 3) {
                    let third = call.arguments[2]
                    if (third.kind != UmsAstValueKind.STRING) {
                        pathOk = false
                    } else {
                        declaredPath = third.text.clone()
                    }
                }
                if (name.kind != UmsAstValueKind.STRING or
                    constraint.kind != UmsAstValueKind.STRING or pathOk == false) {
                    self.lowerError(diagnostics, call, "UMS2202",
                                  call.name.concat(" requires package name and version constraint strings, and an optional local path"))
                } else if (umsDependencyFind(self.dependencies, scope, name.text) >= 0) {
                    self.lowerError(diagnostics, call, "UMS2203",
                        "dependency '".concat(name.text,
                                              "' is declared more than once in this scope"))
                } else {
                    self.dependencies.push(UmsDependency {
                        scope: scope,
                        name: name.text.clone(),
                        constraint: constraint.text.clone(),
                        path: declaredPath,
                        resolved: "".clone(),
                        line: call.line,
                        col: call.col,
                        len: call.len
                    })
                }
            }
            i = i + 1
        }
    }
}

internal fn umsLowerDocument(document: UmsAstDocument, root: String, manifestPath: String,
                    profile: String, inout diagnostics: Vec<UmsDiagnostic>) -> UmsProjectModel {
    let project = umsProjectModel(root, manifestPath, profile)
    let mut projectBlocks = 0
    let mut toolchainBlocks = 0
    let mut targetBlocks = 0
    let mut commandBlocks = 0
    let mut dependencyBlocks = 0
    let mut profileBlocks = 0
    let mut i = 0

    while (i < document.roots.length) {
        let block = document.statements[document.roots[i]]
        if (block.kind != UmsAstStatementKind.CALL or block.hasBlock == false or
            block.arguments.length != 0) {
            project.lowerError(diagnostics, block, "UMS2005",
                          "top-level elements must be named blocks")
        } else if (block.name.equals("project")) {
            projectBlocks = projectBlocks + 1
            if (projectBlocks == 1) {
                project.metadata.blockSpan = umsSpanOf(block)
                project.lowerMetadata(document, block, diagnostics)
            } else {
                project.lowerError(diagnostics, block, "UMS2007",
                                   "build.ums may contain only one project block")
            }
        } else if (block.name.equals("toolchain")) {
            toolchainBlocks = toolchainBlocks + 1
            if (i != 0) {
                project.lowerError(diagnostics, block, "UMS2403",
                    "toolchain must be the first build.ums block")
            }
            if (toolchainBlocks == 1) {
                project.lowerToolchain(document, block, diagnostics)
            } else {
                project.lowerError(diagnostics, block, "UMS2010",
                                   "build.ums may contain only one toolchain block")
            }
        } else if (block.name.equals("targets")) {
            targetBlocks = targetBlocks + 1
            if (targetBlocks == 1) {
                project.lowerTargets(document, block, diagnostics)
            } else {
                project.lowerError(diagnostics, block, "UMS2008",
                                   "build.ums may contain only one targets block")
            }
        } else if (block.name.equals("commands")) {
            commandBlocks = commandBlocks + 1
            if (commandBlocks == 1) {
                project.lowerCommands(document, block, diagnostics)
            } else {
                project.lowerError(diagnostics, block, "UMS2013",
                                   "build.ums may contain only one commands block")
            }
        } else if (block.name.equals("dependencies")) {
            dependencyBlocks = dependencyBlocks + 1
            if (dependencyBlocks == 1) {
                project.lowerDependencies(document, block, diagnostics)
            } else {
                project.lowerError(diagnostics, block, "UMS2009",
                                   "build.ums may contain only one dependencies block")
            }
        } else if (block.name.equals("profiles")) {
            profileBlocks = profileBlocks + 1
            if (profileBlocks == 1) {
                project.lowerProfiles(document, block, diagnostics)
            } else {
                project.lowerError(diagnostics, block, "UMS2014",
                                   "build.ums may contain only one profiles block")
            }
        } else {
            project.lowerError(diagnostics, block, "UMS2006",
                "unknown top-level block '".concat(block.name, "'"))
        }
        i = i + 1
    }

    return project
}
