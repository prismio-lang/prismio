import std.string
enum UmsTargetKind {
    UNKNOWN,
    EXECUTABLE,
    LIBRARY
}


struct UmsTarget {
    kind: UmsTargetKind,
    name: String,
    entry: String,
    sourcePath: String,
    outputPath: String,
    line: Int,
    col: Int,
    len: Int
}

fn umsTarget(kind: UmsTargetKind, name: String, entry: String,
             line: Int, col: Int, len: Int) -> UmsTarget {
    return UmsTarget {
        kind: kind,
        name: strClone(name),
        entry: strClone(entry),
        sourcePath: strClone(""),
        outputPath: strClone(""),
        line: line,
        col: col,
        len: len
    }
}

fn umsTargetFind(targets: List<UmsTarget>, name: String) -> Int {
    let mut i = 0
    while (i < list_len(targets)) {
        if (strEquals(list_get(targets, i).name, name)) { return i }
        i = i + 1
    }
    return -1
}
