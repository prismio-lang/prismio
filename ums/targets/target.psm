import std.string
// Appended, never inserted: the tag is the variant's position, so reordering
// these changes the value every compiled comparison expects -- the rule
// std/option.psm states for `Option`.
enum UmsTargetKind {
    UNKNOWN,
    EXECUTABLE,
    LIBRARY,
    TEST
}

// A target's artifact shape and the native things it links are separate axes.
// `executable("prismio")` is still an executable; linking Prismio's own backend
// does not turn it into a fourth artifact kind. Components name toolchain-owned
// bundles with transitive requirements, while the other forms map directly to
// ordinary native linker inputs.
enum UmsLinkKind {
    UNKNOWN,
    LIBRARY,
    SEARCH,
    FILE,
    FRAMEWORK,
    COMPONENT
}

struct UmsLinkInput {
    kind: UmsLinkKind,
    value: String,
    line: Int,
    col: Int,
    len: Int
}


struct UmsTarget {
    kind: UmsTargetKind,
    name: String,
    entry: String,
    sourcePath: String,
    outputPath: String,
    links: List<UmsLinkInput>,
    line: Int,
    col: Int,
    len: Int
}

fn umsTarget(kind: UmsTargetKind, name: String, entry: String,
             line: Int, col: Int, len: Int) -> UmsTarget {
    return UmsTarget {
        kind: kind,
        name: strClone(name),
        entry: strClone(entry),
        sourcePath: strClone(""),
        outputPath: strClone(""),
        links: list_new(),
        line: line,
        col: col,
        len: len
    }
}

fn umsLinkInput(kind: UmsLinkKind, value: String,
                line: Int, col: Int, len: Int) -> UmsLinkInput {
    return UmsLinkInput {
        kind: kind,
        value: strClone(value),
        line: line,
        col: col,
        len: len
    }
}

fn umsTargetHasComponent(target: UmsTarget, name: String) -> Bool {
    let mut i = 0
    while (i < list_len(target.links)) {
        let input = list_get(target.links, i)
        if (input.kind == UmsLinkKind.COMPONENT and strEquals(input.value, name)) {
            return true
        }
        i = i + 1
    }
    return false
}

fn umsTargetFind(targets: List<UmsTarget>, name: String) -> Int {
    let mut i = 0
    while (i < list_len(targets)) {
        if (strEquals(list_get(targets, i).name, name)) { return i }
        i = i + 1
    }
    return -1
}
