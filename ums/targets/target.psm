import std.string

extern fn host_is_windows() -> Int

// Appended, never inserted: the tag is the variant's position, so reordering
// these changes the value every compiled comparison expects -- the rule
// std/option.psm states for `Option`.
enum UmsTargetKind {
    UNKNOWN,
    EXECUTABLE,
    LIBRARY,
    TEST
}

// A target's artifact shape and the native things it links are separate axes:
// an executable that links C of its own is still an executable. Every form maps
// directly to an ordinary linker input; a response file is a file of them, which
// is how a manifest links a library whose flags another tool computed (LLVM's,
// written by tools/setup_llvm.py).
enum UmsLinkKind {
    UNKNOWN,
    LIBRARY,
    SEARCH,
    FILE,
    FRAMEWORK,
    RESPONSE_FILE,
    // `script("kernel.ld")`: a linker script, passed as `-T <path>` with the path
    // resolved against the manifest. `arg("-z")`: one linker argument as written.
    // Both appended, for the reason the comment above gives.
    SCRIPT,
    ARG
}

// What a target's `native { ... }` block declares: C sources to compile with the
// toolchain's clang and link into the executable, and the flags they compile
// with. Nothing about a source is inferred -- the manifest names the include
// directories, the defines and any flag file a source needs.
enum UmsNativeKind {
    UNKNOWN,
    SOURCE,
    INCLUDE,
    DEFINE,
    FLAG,
    RESPONSE_FILE
}

struct UmsNativeInput {
    kind: UmsNativeKind,
    value: String,
    line: Int,
    col: Int,
    len: Int
}

struct UmsLinkInput {
    kind: UmsLinkKind,
    value: String,
    line: Int,
    col: Int,
    len: Int
}


// `runtime` is "installed" -- the Prismio runtime bitcode the toolchain ships,
// merged into the program -- or "none", for a program whose native sources
// provide every runtime symbol themselves (a Prismio compiler, built from the
// runtime in its own checkout). `exportDynamic` makes the executable's symbols
// visible to code it loads while running, such as a JIT-compiled module.
struct UmsTarget {
    kind: UmsTargetKind,
    name: String,
    entry: String,
    sourcePath: String,
    outputPath: String,
    runtime: String,
    exportDynamic: Bool,
    // A program with no operating system under it (docs/FREESTANDING_PLAN.md): the
    // installed runtime is not linked, no C library or startup files are, and
    // `triple` names the machine. `features`, `codeModel` and `noRedZone` are what a
    // kernel asks of code generation; the empty string leaves each at the target's
    // default.
    freestanding: Bool,
    triple: String,
    features: String,
    codeModel: String,
    noRedZone: Bool,
    links: Vec<UmsLinkInput>,
    natives: Vec<UmsNativeInput>,
    line: Int,
    col: Int,
    len: Int
}

public fn umsTarget(kind: UmsTargetKind, name: String, entry: String,
             line: Int, col: Int, len: Int) -> UmsTarget {
    return UmsTarget {
        kind: kind,
        name: name.clone(),
        entry: entry.clone(),
        sourcePath: "".clone(),
        outputPath: "".clone(),
        runtime: "installed".clone(),
        exportDynamic: false,
        freestanding: false,
        triple: "".clone(),
        features: "".clone(),
        codeModel: "".clone(),
        noRedZone: false,
        links: [],
        natives: [],
        line: line,
        col: col,
        len: len
    }
}

public fn umsLinkInput(kind: UmsLinkKind, value: String,
                line: Int, col: Int, len: Int) -> UmsLinkInput {
    return UmsLinkInput {
        kind: kind,
        value: value.clone(),
        line: line,
        col: col,
        len: len
    }
}

public fn umsNativeInput(kind: UmsNativeKind, value: String,
                  line: Int, col: Int, len: Int) -> UmsNativeInput {
    return UmsNativeInput {
        kind: kind,
        value: value.clone(),
        line: line,
        col: col,
        len: len
    }
}

public fn umsTargetFind(targets: Vec<UmsTarget>, name: String) -> Int {
    let mut i = 0
    while (i < targets.length) {
        if (targets[i].name.equals(name)) { return i }
        i = i + 1
    }
    return -1
}

// The file a target or `toolchain.host` names, as this host runs it. A manifest
// spells an executable without `.exe` so that one `build.ums` serves every
// platform, but Windows cannot start the bare name: cmd.exe resolves an
// extension-less command only by trying PATHEXT, so every build command that
// named such a host failed with "not recognized", after `prismio build` had
// already reported the host promoted. The single-file driver has always
// appended the suffix (compiler_default_exe_path); this is the same rule.
public fn umsExecutablePath(path: String) -> String {
    if (host_is_windows() == 1) { return path.concat(".exe") }
    return path.clone()
}
