import std.string
// Appended, never inserted: the tag is the variant's position, so reordering
// these changes the value every compiled comparison expects -- the rule
// std/option.psm states for `Option`.
enum UmsTargetKind {
    UNKNOWN,
    EXECUTABLE,
    LIBRARY,
    TEST,
    // A self-hosted compiler executable. It uses the same Prismio frontend as
    // an executable target, then links backend.a and LLVM through the bootstrap
    // build path. Appended so existing target-kind ordinals remain stable.
    COMPILER
}


struct UmsTarget {
    kind: UmsTargetKind,
    name: String,
    entry: String,
    sourcePath: String,
    outputPath: String,
    line: Int,
    col: Int,
    len: Int
}

fn umsTarget(kind: UmsTargetKind, name: String, entry: String,
             line: Int, col: Int, len: Int) -> UmsTarget {
    return UmsTarget {
        kind: kind,
        name: strClone(name),
        entry: strClone(entry),
        sourcePath: strClone(""),
        outputPath: strClone(""),
        line: line,
        col: col,
        len: len
    }
}

fn umsTargetFind(targets: List<UmsTarget>, name: String) -> Int {
    let mut i = 0
    while (i < list_len(targets)) {
        if (strEquals(list_get(targets, i).name, name)) { return i }
        i = i + 1
    }
    return -1
}
