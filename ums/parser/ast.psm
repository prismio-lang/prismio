import std.string

enum UmsAstValueKind {
    UNKNOWN,
    STRING,
    INTEGER,
    BOOLEAN,
    IDENTIFIER,
    ARRAY
}

enum UmsAstStatementKind {
    UNKNOWN,
    ASSIGNMENT,
    CALL
}

struct UmsAstValue {
    public kind: UmsAstValueKind,
    public text: String,
    public line: Int,
    public col: Int,
    public len: Int
}

public struct UmsAstStatement {
    public kind: UmsAstStatementKind,
    public name: String,
    public value: UmsAstValue,
    public arguments: Vec<UmsAstValue>,
    // Flat scalar values for an assignment such as `authors = ["A", "B"]`.
    // Kept on the statement rather than recursively inside UmsAstValue: a flat
    // list is the manifest feature UMS needs, and the non-recursive shape keeps
    // value representation as cheap as call arguments.
    public arrayValues: Vec<UmsAstValue>,
    // Indices into UmsAstDocument.statements. Keeping syntax edges as indices
    // avoids a recursive nominal type, so a manifest AST never needs runtime
    // reference counting merely because blocks can nest.
    public children: Vec<Int>,
    public hasBlock: Bool,
    public start: Int,
    public blockOpen: Int,
    public blockClose: Int,
    public line: Int,
    public col: Int,
    public len: Int
}

public struct UmsAstDocument {
    public statements: Vec<UmsAstStatement>,
    public roots: Vec<Int>
}

private fn umsAstEmptyValue() -> UmsAstValue {
    return UmsAstValue {
        kind: UmsAstValueKind.UNKNOWN,
        text: "".clone(),
        line: 0,
        col: 0,
        len: 0
    }
}

internal fn umsAstStatement(kind: UmsAstStatementKind, name: String,
                   start: Int, line: Int, col: Int, len: Int) -> UmsAstStatement {
    return UmsAstStatement {
        kind: kind,
        name: name.clone(),
        value: umsAstEmptyValue(),
        arguments: [],
        arrayValues: [],
        children: [],
        hasBlock: false,
        start: start,
        blockOpen: -1,
        blockClose: -1,
        line: line,
        col: col,
        len: len
    }
}
