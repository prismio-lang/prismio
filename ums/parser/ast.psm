import std.string

enum UmsAstValueKind {
    UNKNOWN,
    STRING,
    INTEGER,
    BOOLEAN,
    IDENTIFIER,
    ARRAY
}

enum UmsAstStatementKind {
    UNKNOWN,
    ASSIGNMENT,
    CALL
}

struct UmsAstValue {
    kind: UmsAstValueKind,
    text: String,
    line: Int,
    col: Int,
    len: Int
}

struct UmsAstStatement {
    kind: UmsAstStatementKind,
    name: String,
    value: UmsAstValue,
    arguments: List<UmsAstValue>,
    // Flat scalar values for an assignment such as `authors = ["A", "B"]`.
    // Kept on the statement rather than recursively inside UmsAstValue: a flat
    // list is the manifest feature UMS needs, and the non-recursive shape keeps
    // value representation as cheap as call arguments.
    arrayValues: List<UmsAstValue>,
    // Indices into UmsAstDocument.statements. Keeping syntax edges as indices
    // avoids a recursive nominal type, so a manifest AST never needs runtime
    // reference counting merely because blocks can nest.
    children: List<Int>,
    hasBlock: Bool,
    start: Int,
    blockOpen: Int,
    blockClose: Int,
    line: Int,
    col: Int,
    len: Int
}

struct UmsAstDocument {
    statements: List<UmsAstStatement>,
    roots: List<Int>
}

private fn umsAstEmptyValue() -> UmsAstValue {
    return UmsAstValue {
        kind: UmsAstValueKind.UNKNOWN,
        text: strClone(""),
        line: 0,
        col: 0,
        len: 0
    }
}

internal fn umsAstStatement(kind: UmsAstStatementKind, name: String,
                   start: Int, line: Int, col: Int, len: Int) -> UmsAstStatement {
    return UmsAstStatement {
        kind: kind,
        name: strClone(name),
        value: umsAstEmptyValue(),
        arguments: list_new(),
        arrayValues: list_new(),
        children: list_new(),
        hasBlock: false,
        start: start,
        blockOpen: -1,
        blockClose: -1,
        line: line,
        col: col,
        len: len
    }
}
