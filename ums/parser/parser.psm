import std.io
import ums.parser.ast
import ums.parser.token
import ums.model.diagnostic
import std.string


struct UmsParser {
    tokens: Vec<UmsToken>,
    diagnostics: Vec<UmsDiagnostic>,
    path: String,
    current: Int
}

// The parser's own operations, as methods, for the reason the lexer's are: an
// `impl` block is a naming construct, so `parser.at(kind)` and
// `parser.at(kind)` are the same call after the checker's rewrite.
// Verified by the emitted code -- the mnemonic diff across this change is 0
// changed functions, and the only difference in the binary is the symbol names.
//
// A method and a field may share a name: `self.current` is the token index and
// `self.current()` is the token it selects. `src/parse/parser.psm` has carried
// exactly that pair since impl blocks landed.
impl UmsParser {

    private fn current(self) -> UmsToken {
        return self.tokens[self.current]
    }

    private fn at(self, kind: UmsTokenKind) -> Bool {
        return self.current().kind == kind
    }

    private fn advance(self) -> UmsToken {
        let token = self.current()
        if (token.kind != UmsTokenKind.EOF) { self.current = self.current + 1 }
        return token
    }

    private fn take(self, kind: UmsTokenKind) -> Bool {
        if (self.at(kind) == false) { return false }
        self.advance()
        return true
    }

    private fn error(self, token: UmsToken, code: String, message: String) {
        umsDiagnosticAdd(self.diagnostics, code, self.path,
                         token.line, token.col, token.len, message)
    }

    private fn expected(self, expected: String) {
        let token = self.current()
        self.error(token, "UMS1101",
            "expected ".concat(expected, ", found ", umsTokenKindName(token.kind)))
    }

    private fn parseValue(self) -> UmsAstValue {
        let token = self.current()
        let mut kind = UmsAstValueKind.UNKNOWN
        if (token.kind == UmsTokenKind.STRING) { kind = UmsAstValueKind.STRING }
        else if (token.kind == UmsTokenKind.INTEGER) { kind = UmsAstValueKind.INTEGER }
        else if (token.kind == UmsTokenKind.BOOLEAN) { kind = UmsAstValueKind.BOOLEAN }
        else if (token.kind == UmsTokenKind.IDENTIFIER) { kind = UmsAstValueKind.IDENTIFIER }
        else {
            self.expected("a value")
        }
        if (token.kind != UmsTokenKind.EOF) { self.advance() }
        return UmsAstValue {
            kind: kind,
            text: token.value.clone(),
            line: token.line,
            col: token.col,
            len: token.len
        }
    }

    private fn parseArguments(self, statement: UmsAstStatement) {
        if (self.take(UmsTokenKind.RIGHT_PAREN)) { return }
        loop {
            statement.arguments.push(self.parseValue())
            if (self.take(UmsTokenKind.RIGHT_PAREN)) { break }
            if (self.take(UmsTokenKind.COMMA) == false) {
                self.expected("',' or ')'")
                while (self.at(UmsTokenKind.RIGHT_PAREN) == false and
                       self.at(UmsTokenKind.LEFT_BRACE) == false and
                       self.at(UmsTokenKind.EOF) == false) {
                    self.advance()
                }
                self.take(UmsTokenKind.RIGHT_PAREN)
                break
            }
        }
    }

    private fn parseArray(self, statement: UmsAstStatement) {
        let opening = self.advance()
        statement.value = UmsAstValue {
            kind: UmsAstValueKind.ARRAY,
            text: "".clone(),
            line: opening.line,
            col: opening.col,
            len: opening.len
        }
        if (self.take(UmsTokenKind.RIGHT_BRACKET)) { return }

        loop {
            statement.arrayValues.push(self.parseValue())
            if (self.take(UmsTokenKind.RIGHT_BRACKET)) { break }
            if (self.take(UmsTokenKind.COMMA) == false) {
                self.expected("',' or ']'")
                while (self.at(UmsTokenKind.RIGHT_BRACKET) == false and
                       self.at(UmsTokenKind.SEMICOLON) == false and
                       self.at(UmsTokenKind.EOF) == false) {
                    self.advance()
                }
                self.take(UmsTokenKind.RIGHT_BRACKET)
                break
            }
            // A final comma makes one-item-per-line metadata edits stable.
            if (self.take(UmsTokenKind.RIGHT_BRACKET)) { break }
        }
    }

    // The token after the current one; the EOF token at the end keeps it in range
    // for any current token that is not itself EOF.
    private fn next(self) -> UmsToken {
        return self.tokens[self.current + 1]
    }

    // `const NAME = value`, the keyword already taken. A flat array is a value
    // here as it is in an assignment.
    private fn parseConstant(self, document: UmsAstDocument, keyword: UmsToken) -> Int {
        let name = self.advance()
        self.advance()
        let statement = umsAstStatement(UmsAstStatementKind.CONSTANT, name.value,
                                        keyword.offset, keyword.line, keyword.col,
                                        name.offset + name.len - keyword.offset)
        if (self.at(UmsTokenKind.LEFT_BRACKET)) {
            self.parseArray(statement)
        } else {
            statement.value = self.parseValue()
        }
        self.take(UmsTokenKind.SEMICOLON)
        let index = document.statements.length
        document.statements.push(statement)
        return index
    }

    // `enum Name { A, B = "b" }`, the keyword already taken. A variant is a name,
    // optionally `= value`; variants are separated by commas or newlines.
    private fn parseEnum(self, document: UmsAstDocument, keyword: UmsToken) -> Int {
        let name = self.advance()
        let opening = self.advance()
        let statement = umsAstStatement(UmsAstStatementKind.ENUM, name.value,
                                        keyword.offset, keyword.line, keyword.col,
                                        name.offset + name.len - keyword.offset)
        statement.hasBlock = true
        statement.blockOpen = opening.offset
        while (self.at(UmsTokenKind.RIGHT_BRACE) == false and
               self.at(UmsTokenKind.EOF) == false) {
            if (self.take(UmsTokenKind.COMMA) or self.take(UmsTokenKind.SEMICOLON)) {
                continue
            }
            if (self.at(UmsTokenKind.IDENTIFIER) == false) {
                self.expected("an enum variant")
                self.advance()
                continue
            }
            let variant = self.advance()
            let entry = umsAstStatement(UmsAstStatementKind.ASSIGNMENT, variant.value,
                                        variant.offset, variant.line, variant.col, variant.len)
            if (self.take(UmsTokenKind.EQUAL)) {
                entry.value = self.parseValue()
            }
            statement.children.push(document.statements.length)
            document.statements.push(entry)
        }
        if (self.at(UmsTokenKind.RIGHT_BRACE)) {
            statement.blockClose = self.advance().offset
        } else {
            self.expected("'}'")
        }
        self.take(UmsTokenKind.SEMICOLON)
        let index = document.statements.length
        document.statements.push(statement)
        return index
    }

    private fn parseStatement(self, document: UmsAstDocument) -> Int {
        let token = self.current()
        if (token.kind != UmsTokenKind.IDENTIFIER) {
            self.expected("a property or DSL block")
            self.advance()
            return -1
        }

        let name = self.advance()
        if (name.value.equals("const") and self.at(UmsTokenKind.IDENTIFIER) and
            self.next().kind == UmsTokenKind.EQUAL) {
            return self.parseConstant(document, name)
        }
        if (name.value.equals("enum") and self.at(UmsTokenKind.IDENTIFIER) and
            self.next().kind == UmsTokenKind.LEFT_BRACE) {
            return self.parseEnum(document, name)
        }
        if (self.take(UmsTokenKind.EQUAL)) {
            let statement = umsAstStatement(UmsAstStatementKind.ASSIGNMENT, name.value,
                                            name.offset, name.line, name.col, name.len)
            if (self.at(UmsTokenKind.LEFT_BRACKET)) {
                self.parseArray(statement)
            } else {
                statement.value = self.parseValue()
            }
            self.take(UmsTokenKind.SEMICOLON)
            let index = document.statements.length
            document.statements.push(statement)
            return index
        }

        let statement = umsAstStatement(UmsAstStatementKind.CALL, name.value,
                                        name.offset, name.line, name.col, name.len)
        if (self.take(UmsTokenKind.LEFT_PAREN)) {
            self.parseArguments(statement)
        }

        if (self.at(UmsTokenKind.LEFT_BRACE)) {
            let opening = self.advance()
            statement.hasBlock = true
            statement.blockOpen = opening.offset
            while (self.at(UmsTokenKind.RIGHT_BRACE) == false and
                   self.at(UmsTokenKind.EOF) == false) {
                if (self.take(UmsTokenKind.SEMICOLON) == false) {
                    let child = self.parseStatement(document)
                    if (child >= 0) {
                        statement.children.push(child)
                    }
                }
            }
            if (self.at(UmsTokenKind.RIGHT_BRACE)) {
                let closing = self.advance()
                statement.blockClose = closing.offset
            } else {
                self.expected("'}'")
            }
        } else if (statement.arguments.length == 0) {
            self.error(name, "UMS1102",
                "DSL element '".concat(name.value, "' requires arguments or a block"))
        }

        self.take(UmsTokenKind.SEMICOLON)
        let index = document.statements.length
        document.statements.push(statement)
        return index
    }
}

public fn umsParse(tokens: Vec<UmsToken>, path: String,
            diagnostics: Vec<UmsDiagnostic>) -> UmsAstDocument {
    let parser = UmsParser {
        tokens: tokens,
        diagnostics: diagnostics,
        path: path,
        current: 0
    }
    let document = UmsAstDocument { statements: [], roots: [] }

    while (parser.at(UmsTokenKind.EOF) == false) {
        if (parser.take(UmsTokenKind.SEMICOLON) == false) {
            let statement = parser.parseStatement(document)
            if (statement >= 0) {
                document.roots.push(statement)
            }
        }
    }
    return document
}
