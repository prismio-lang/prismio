import std.string

enum UmsTokenKind {
    UNKNOWN,
    IDENTIFIER,
    STRING,
    INTEGER,
    BOOLEAN,
    EQUAL,
    LEFT_BRACE,
    RIGHT_BRACE,
    LEFT_PAREN,
    RIGHT_PAREN,
    LEFT_BRACKET,
    RIGHT_BRACKET,
    COMMA,
    SEMICOLON,
    EOF
}


struct UmsToken {
    internal kind: UmsTokenKind,
    internal value: String,
    internal offset: Int,
    internal line: Int,
    internal col: Int,
    internal len: Int
}

internal fn umsToken(kind: UmsTokenKind, value: String, offset: Int,
                     line: Int, col: Int, len: Int) -> UmsToken {
    return UmsToken {
        kind: kind,
        value: value.clone(),
        offset: offset,
        line: line,
        col: col,
        len: len
    }
}

internal fn umsTokenKindName(kind: UmsTokenKind) -> String {
    match (kind) {
        UmsTokenKind.IDENTIFIER => { return "identifier" }
        UmsTokenKind.STRING => { return "string" }
        UmsTokenKind.INTEGER => { return "integer" }
        UmsTokenKind.BOOLEAN => { return "boolean" }
        UmsTokenKind.EQUAL => { return "'='" }
    }
    if (kind == UmsTokenKind.LEFT_BRACE) { return "'{'" }
    match (kind) {
        UmsTokenKind.RIGHT_BRACE => { return "'}'" }
        UmsTokenKind.LEFT_PAREN => { return "'('" }
        UmsTokenKind.RIGHT_PAREN => { return "')'" }
        UmsTokenKind.LEFT_BRACKET => { return "'['" }
        UmsTokenKind.RIGHT_BRACKET => { return "']'" }
        UmsTokenKind.COMMA => { return "','" }
        UmsTokenKind.SEMICOLON => { return "';'" }
        UmsTokenKind.EOF => { return "end of file" }
    }
    return "token"
}
