import std.string

enum UmsTokenKind {
    UNKNOWN,
    IDENTIFIER,
    STRING,
    INTEGER,
    BOOLEAN,
    EQUAL,
    LEFT_BRACE,
    RIGHT_BRACE,
    LEFT_PAREN,
    RIGHT_PAREN,
    COMMA,
    SEMICOLON,
    EOF
}


struct UmsToken {
    kind: UmsTokenKind,
    value: String,
    offset: Int,
    line: Int,
    col: Int,
    len: Int
}

internal fn umsToken(kind: UmsTokenKind, value: String, offset: Int,
                     line: Int, col: Int, len: Int) -> UmsToken {
    return UmsToken {
        kind: kind,
        value: strClone(value),
        offset: offset,
        line: line,
        col: col,
        len: len
    }
}

internal fn umsTokenKindName(kind: UmsTokenKind) -> String {
    if (kind == UmsTokenKind.IDENTIFIER) { return "identifier" }
    if (kind == UmsTokenKind.STRING) { return "string" }
    if (kind == UmsTokenKind.INTEGER) { return "integer" }
    if (kind == UmsTokenKind.BOOLEAN) { return "boolean" }
    if (kind == UmsTokenKind.EQUAL) { return "'='" }
    if (kind == UmsTokenKind.LEFT_BRACE) { return "'{'" }
    if (kind == UmsTokenKind.RIGHT_BRACE) { return "'}'" }
    if (kind == UmsTokenKind.LEFT_PAREN) { return "'('" }
    if (kind == UmsTokenKind.RIGHT_PAREN) { return "')'" }
    if (kind == UmsTokenKind.COMMA) { return "','" }
    if (kind == UmsTokenKind.SEMICOLON) { return "';'" }
    if (kind == UmsTokenKind.EOF) { return "end of file" }
    return "token"
}
