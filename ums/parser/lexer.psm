import std.io
import ums.parser.token
import ums.model.diagnostic
import std.string


struct UmsLexer {
    source: String,
    path: String,
    pos: Int,
    line: Int,
    col: Int,
    length: Int,
    tokens: List<UmsToken>,
    diagnostics: List<UmsDiagnostic>
}

fn umsIsDigit(value: Char) -> Bool {
    return value >= '0' and value <= '9'
}

private fn umsIsAlpha(value: Char) -> Bool {
    return (value >= 'a' and value <= 'z') or
           (value >= 'A' and value <= 'Z') or value == '_'
}

fn umsIsAlnum(value: Char) -> Bool {
    return umsIsAlpha(value) or umsIsDigit(value)
}

// The lexer's own operations, as methods. Every one of these took `lexer` as an
// explicit first parameter until 2026-08-30; an `impl` block is a naming
// construct -- `x.f(a)` is the call `f(x, a)` after the checker's rewrite -- so
// this is the same code under the name the call sites already implied.
//
// `private` because nothing outside this file drives a lexer: `umsLex` below is
// the whole of the surface, and the visibility says so rather than leaving ten
// more names in the program's.
impl UmsLexer {

    private fn current(self) -> Char {
        if (self.pos >= self.length) { return '\0' }
        return strCharAt(self.source, self.pos)
    }

    private fn peek(self, distance: Int) -> Char {
        let at = self.pos + distance
        if (at < 0 or at >= self.length) { return '\0' }
        return strCharAt(self.source, at)
    }

    private fn advance(self) {
        if (self.current() == '\n') {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
        self.pos = self.pos + 1
    }

    private fn slice(self, start: Int, length: Int) -> String {
        let mut result = ""
        let mut i = 0
        while (i < length) {
            result = strConcat(result, strFromChar(strCharAt(self.source, start + i)))
            i = i + 1
        }
        return result
    }

    private fn addToken(self, kind: UmsTokenKind, value: String,
                   start: Int, line: Int, col: Int) {
        list_push(self.tokens, umsToken(kind, value, start, line, col, self.pos - start))
    }

    private fn error(self, code: String, line: Int, col: Int,
                     len: Int, message: String) {
        umsDiagnosticAdd(self.diagnostics, code, self.path, line, col, len, message)
    }

    private fn skipSpace(self) {
        loop {
            let current = self.current()
            if (current == ' ' or current == '\t' or current == '\r' or current == '\n') {
                self.advance()
            } else if (current == '#' or (current == '/' and self.peek(1) == '/')) {
                while (self.current() != '\n' and self.current() != '\0') {
                    self.advance()
                }
            } else {
                break
            }
        }
    }

    private fn lexIdentifier(self) {
        let start = self.pos
        let line = self.line
        let col = self.col
        while (umsIsAlnum(self.current()) or self.current() == '-') {
            self.advance()
        }
        let value = self.slice(start, self.pos - start)
        let mut kind = UmsTokenKind.IDENTIFIER
        if (strEquals(value, "true") or strEquals(value, "false")) {
            kind = UmsTokenKind.BOOLEAN
        }
        self.addToken(kind, value, start, line, col)
    }

    private fn lexInteger(self) {
        let start = self.pos
        let line = self.line
        let col = self.col
        while (umsIsDigit(self.current())) { self.advance() }
        self.addToken(UmsTokenKind.INTEGER,
                    self.slice(start, self.pos - start), start, line, col)
    }

    private fn lexString(self) {
        let start = self.pos
        let line = self.line
        let col = self.col
        let mut value = ""
        let mut terminated = false
        self.advance()

        while (self.current() != '\0' and self.current() != '\n') {
            let mut current = self.current()
            if (current == '"') {
                self.advance()
                terminated = true
                break
            }
            if (current == '\\') {
                self.advance()
                let escaped = self.current()
                if (escaped == 'n') { current = '\n' }
                else if (escaped == 'r') { current = '\r' }
                else if (escaped == 't') { current = '\t' }
                else if (escaped == '\\') { current = '\\' }
                else if (escaped == '"') { current = '"' }
                else {
                    self.error("UMS1003", self.line, self.col - 1, 2,
                                  strConcat("unsupported escape sequence \\", strFromChar(escaped)))
                    current = escaped
                }
            }
            value = strConcat(value, strFromChar(current))
            self.advance()
        }

        if (terminated == false) {
            self.error("UMS1002", line, col, self.pos - start,
                          "unterminated string literal")
        }
        self.addToken(UmsTokenKind.STRING, value, start, line, col)
    }
}

fn umsLex(source: String, path: String,
          diagnostics: List<UmsDiagnostic>) -> List<UmsToken> {
    let lexer = UmsLexer {
        source: source,
        path: path,
        pos: 0,
        line: 1,
        col: 1,
        length: __builtin_string_len(source),
        tokens: list_new(),
        diagnostics: diagnostics
    }

    while (lexer.current() != '\0') {
        lexer.skipSpace()
        if (lexer.current() == '\0') { break }

        let current = lexer.current()
        if (umsIsAlpha(current)) {
            lexer.lexIdentifier()
        } else if (umsIsDigit(current)) {
            lexer.lexInteger()
        } else if (current == '"') {
            lexer.lexString()
        } else {
            let start = lexer.pos
            let line = lexer.line
            let col = lexer.col
            let mut kind = UmsTokenKind.UNKNOWN
            if (current == '=') { kind = UmsTokenKind.EQUAL }
            else if (current == '{') { kind = UmsTokenKind.LEFT_BRACE }
            else if (current == '}') { kind = UmsTokenKind.RIGHT_BRACE }
            else if (current == '(') { kind = UmsTokenKind.LEFT_PAREN }
            else if (current == ')') { kind = UmsTokenKind.RIGHT_PAREN }
            else if (current == '[') { kind = UmsTokenKind.LEFT_BRACKET }
            else if (current == ']') { kind = UmsTokenKind.RIGHT_BRACKET }
            else if (current == ',') { kind = UmsTokenKind.COMMA }
            else if (current == ';') { kind = UmsTokenKind.SEMICOLON }

            lexer.advance()
            if (kind == UmsTokenKind.UNKNOWN) {
                lexer.error("UMS1004", line, col, 1,
                              strConcat("unexpected character ", strFromChar(current)))
            } else {
                lexer.addToken(kind, strFromChar(current), start, line, col)
            }
        }
    }

    list_push(lexer.tokens,
              umsToken(UmsTokenKind.EOF, "", lexer.pos, lexer.line, lexer.col, 0))
    return lexer.tokens
}
