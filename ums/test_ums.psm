import std.io
import ums.ums
// `ums.ums` is a composition root, and an import of it no longer carries what
// *it* imports -- v0.1 3.5 stops a module's dependencies leaking into its
// importers. The two modules whose names this test actually calls are named
// here, which is the whole of the rule: what a file uses, a file imports.
import ums.model.workspace
import ums.model.diagnostic
import ums.model.manifest_writer
import ums.targets.target
import ums.model.validation
import ums.model.project
import std.string
import std.fs
import std.vec


fn umsTestFail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let workspace = umsLoadProject("ums/tests/fixtures/valid", "debug")
    if (workspace.valid == false) {
        umsDiagnosticsPrint(workspace.diagnostics)
        return umsTestFail("valid fixture should load")
    }
    if (workspace.project.metadata.name.equals("http") == false) {
        return umsTestFail("project name should be lowered")
    }
    if (workspace.project.metadata.version.equals("1.0.0") == false) {
        return umsTestFail("project version should be lowered")
    }

    let packageMetadata = umsLoadText(
        "project { name = \"http\" version = \"1.0.0\" prismio = \"1.0\" description = \"HTTP client library\" license = \"MIT\" authors = [\"Saksham Jaiswal\", \"Prismio Contributors\",] } targets { executable(\"http\") { entry = \"src/main.psm\" } }",
        "memory:package-metadata", "ums/tests/fixtures/valid", "debug")
    if (packageMetadata.valid == false or
        packageMetadata.project.metadata.description.equals("HTTP client library") == false or
        packageMetadata.project.metadata.license.equals("MIT") == false or
        packageMetadata.project.metadata.authors.length != 2 or
        packageMetadata.project.metadata.authors[0].equals("Saksham Jaiswal") == false) {
        return umsTestFail("optional package metadata and string arrays should lower")
    }

    let licenseFileMetadata = umsLoadText(
        "project { name = \"http\" version = \"1.0.0\" prismio = \"1.0\" licenseFile = \"../../../../LICENSE\" } targets { executable(\"http\") { entry = \"src/main.psm\" } }",
        "memory:license-file", "ums/tests/fixtures/valid", "debug")
    if (licenseFileMetadata.valid == false or
        licenseFileMetadata.project.metadata.licenseFile.equals("../../../../LICENSE") == false) {
        return umsTestFail("a project-relative license file should lower and validate")
    }

    let invalidMetadata = umsLoadText(
        "project { name = \"http\" version = \"1.0.0\" prismio = \"1.0\" description = \"\" license = \"MIT\" licenseFile = \"../../../../LICENSE\" authors = [] } targets { executable(\"http\") { entry = \"src/main.psm\" } }",
        "memory:invalid-metadata", "ums/tests/fixtures/valid", "debug")
    if (invalidMetadata.valid or invalidMetadata.diagnostics.length < 3) {
        return umsTestFail("empty and mutually exclusive package metadata should be rejected")
    }

    let invalidAuthorType = umsLoadText(
        "project { name = \"http\" version = \"1.0.0\" prismio = \"1.0\" authors = [\"Saksham\", 7] } targets { executable(\"http\") { entry = \"src/main.psm\" } }",
        "memory:invalid-author-type", "ums/tests/fixtures/valid", "debug")
    if (invalidAuthorType.valid) {
        return umsTestFail("author arrays must contain only strings")
    }
    if (workspace.targetCount() != 1) {
        return umsTestFail("one target should be planned")
    }
    let target = workspace.target(0)
    if (target.kind != UmsTargetKind.EXECUTABLE) {
        return umsTestFail("target kind should be executable")
    }
    if (target.entry.equals("src/main.psm") == false) {
        return umsTestFail("target entry should be preserved")
    }
    if (workspace.project.dependencies.length != 1) {
        return umsTestFail("one dependency should be modeled")
    }

    let multi = umsLoadText(
        "# multiple artifacts\nproject { name = \"multi\" version = \"1.0.0\" prismio = \"1.0\" } targets { executable(\"one\") { entry = \"src/main.psm\" } executable(\"two\") { entry = \"src/main.psm\" } }",
        "memory:multi", "ums/tests/fixtures/valid", "release")
    if (multi.valid == false or multi.targetCount() != 2) {
        return umsTestFail("multiple executable targets should produce one plan each")
    }

    // Native code is declared, never implied: the sources, include directories,
    // defines, flags and response files a target compiles, in the order written,
    // plus whether it brings its own runtime and exports its symbols. Paths are
    // checked against the root this manifest is loaded from -- the repository,
    // whose runtime/ holds real sources.
    let nativeProject = umsLoadText(
        "toolchain { host = \".prismio/build/debug/prismio\" } project { name = \"prismio\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"prismio\") { entry = \"src/main.psm\" runtime = \"none\" exportDynamic = true native { source(\"runtime/lang_runtime.c\", \"runtime/program_support.c\") include(\"runtime\") define(\"A=1\") flag(\"-Wall\") } link { search(\"native\") library(\"sqlite3\") file(\"native/libextra.a\") framework(\"Security\") } } }",
        "memory:native", ".", "debug")
    let nativeTarget = nativeProject.target(0)
    if (nativeProject.valid == false or nativeProject.targetCount() != 1 or
        nativeTarget.kind != UmsTargetKind.EXECUTABLE or
        nativeTarget.links.length != 4 or
        nativeTarget.natives.length != 5 or
        nativeTarget.natives[1].kind != UmsNativeKind.SOURCE or
        nativeTarget.natives[1].value.equals("runtime/program_support.c") == false or
        nativeTarget.natives[4].kind != UmsNativeKind.FLAG or
        nativeTarget.runtime.equals("none") == false or
        nativeTarget.exportDynamic == false or
        nativeProject.project.toolchain.host.equals(".prismio/build/debug/prismio") == false) {
        umsDiagnosticsPrint(nativeProject.diagnostics)
        return umsTestFail("an executable should preserve its native sources, flags and link inputs in order")
    }

    // A target with no operating system under it: `freestanding`, the machine it is
    // for, what code generation is told, and a linker script and a bare argument in
    // `link`. Each is kept as written, and the target stays a plain executable.
    let kernelProject = umsLoadText(
        "project { name = \"k\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"k\") { entry = \"tests/freestanding/kernel_pure_aarch64.psm\" freestanding = true triple = \"aarch64-unknown-none-elf\" features = \"-neon,-fp-armv8\" codeModel = \"small\" noRedZone = true native { source(\"runtime/freestanding/panic.c\") flag(\"-mgeneral-regs-only\") } link { script(\"tests/freestanding/link_aarch64_pure.ld\") arg(\"-z\") arg(\"noexecstack\") } } }",
        "memory:kernel", ".", "debug")
    let kernelTarget = kernelProject.target(0)
    if (kernelProject.valid == false or kernelProject.targetCount() != 1 or
        kernelTarget.kind != UmsTargetKind.EXECUTABLE or
        kernelTarget.freestanding == false or
        kernelTarget.triple.equals("aarch64-unknown-none-elf") == false or
        kernelTarget.features.equals("-neon,-fp-armv8") == false or
        kernelTarget.codeModel.equals("small") == false or
        kernelTarget.noRedZone == false or
        kernelTarget.links.length != 3 or
        kernelTarget.links[0].kind != UmsLinkKind.SCRIPT or
        kernelTarget.links[1].kind != UmsLinkKind.ARG or
        kernelTarget.links[2].value.equals("noexecstack") == false) {
        umsDiagnosticsPrint(kernelProject.diagnostics)
        return umsTestFail("a freestanding target should keep its triple, code generation settings and linker inputs")
    }
    let hostTarget = nativeTarget
    if (hostTarget.freestanding or hostTarget.triple.equals("") == false or hostTarget.noRedZone) {
        return umsTestFail("a target that declares nothing freestanding should declare nothing freestanding")
    }
    let badModel = umsLoadText(
        "project { name = \"k\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"k\") { entry = \"src/main.psm\" codeModel = \"huge\" } }",
        "memory:bad-model", ".", "debug")
    if (badModel.valid) {
        return umsTestFail("an unknown code model should be rejected")
    }

    let lateToolchain = umsLoadText(
        "project { name = \"prismio\" version = \"0.1.0\" prismio = \"0.1\" } toolchain { host = \".prismio/build/debug/prismio\" } targets { executable(\"prismio\") { entry = \"src/main.psm\" } }",
        "memory:late-toolchain", ".", "debug")
    if (lateToolchain.valid) {
        return umsTestFail("toolchain must be the stable first manifest block")
    }

    // Any host path is accepted -- a sub-project may name its parent's host --
    // and only a host under the project's own `.prismio/` is one `clean` removes.
    let hostOutside = umsLoadText(
        "toolchain { host = \"bin/prismio\" } project { name = \"p\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"p\") { entry = \"src/main.psm\" } }",
        "memory:host-outside", ".", "debug")
    let hostEscapes = umsLoadText(
        "toolchain { host = \".prismio/../../x\" } project { name = \"p\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"p\") { entry = \"src/main.psm\" } }",
        "memory:host-escapes", ".", "debug")
    if (hostOutside.valid == false or hostEscapes.valid == false) {
        return umsTestFail("toolchain.host outside .prismio/ should be accepted")
    }
    if (umsHostIsProjectBuildOutput(".prismio/build/debug/prismio") == false or
        umsHostIsProjectBuildOutput("../.prismio/build/debug/prismio") or
        umsHostIsProjectBuildOutput(".prismio/../../x") or
        umsHostIsProjectBuildOutput("/opt/prismio/bin/prismio") or
        umsHostIsProjectBuildOutput("bin/prismio")) {
        return umsTestFail("only a host under the project's own .prismio/ is its build output")
    }

    let badNative = umsLoadText(
        "project { name = \"p\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"p\") { entry = \"src/main.psm\" runtime = \"maybe\" native { source(\"x.cpp\", \"runtime/absent.c\") include(\"no-such-dir\") responseFile(\"no.rsp\") } } }",
        "memory:bad-native", ".", "debug")
    if (badNative.valid or badNative.diagnostics.length != 5) {
        umsDiagnosticsPrint(badNative.diagnostics)
        return umsTestFail("a bad runtime, a non-C source and missing native paths should each be reported once")
    }

    // Profiles: debug starts with -g and overflow checks, release with neither,
    // and only the block for the profile being built changes anything.
    let profileSource = "project { name = \"p\" version = \"0.1.0\" prismio = \"0.1\" } profiles { debug { debugInfo = false } release { overflowChecks = true } } targets { executable(\"p\") { entry = \"src/main.psm\" } }"
    let debugProfile = umsLoadText(profileSource, "memory:profile-debug", ".", "debug")
    let releaseProfile = umsLoadText(profileSource, "memory:profile-release", ".", "release")
    if (debugProfile.valid == false or releaseProfile.valid == false or
        debugProfile.project.build.debugInfo or
        debugProfile.project.build.overflowChecks == false or
        releaseProfile.project.build.debugInfo or
        releaseProfile.project.build.overflowChecks == false) {
        return umsTestFail("a profiles block should override the selected profile's defaults only")
    }

    // SemVer 2.0: pre-release and build metadata are valid, leading zeros and a
    // fourth component are not.
    let prerelease = umsLoadText(
        "project { name = \"p\" version = \"1.0.0-beta.1+build.5\" prismio = \"0.1\" } targets { executable(\"p\") { entry = \"src/main.psm\" } }",
        "memory:prerelease", "ums/tests/fixtures/valid", "debug")
    let leadingZero = umsLoadText(
        "project { name = \"p\" version = \"01.2.3\" prismio = \"0.1\" } targets { executable(\"p\") { entry = \"src/main.psm\" } }",
        "memory:leading-zero", "ums/tests/fixtures/valid", "debug")
    let fourParts = umsLoadText(
        "project { name = \"p\" version = \"1.2.3.4\" prismio = \"0.1\" } targets { executable(\"p\") { entry = \"src/main.psm\" } }",
        "memory:four-parts", "ums/tests/fixtures/valid", "debug")
    if (prerelease.valid == false or leadingZero.valid or fourParts.valid) {
        return umsTestFail("project.version should follow SemVer 2.0")
    }

    // A name becomes a file under .prismio/build/<profile>/, so `.` and `..` are
    // directories and a leading `-` is a flag.
    if (umsValidName("..") or umsValidName(".") or umsValidName("-x") or
        umsValidName("app-1.2") == false) {
        return umsTestFail("names should start with a letter, a digit or `_`")
    }

    let legacyCompiler = umsLoadText(
        "project { name = \"prismio\" version = \"0.1.0\" prismio = \"0.1\" } targets { compiler { entry = \"src/main.psm\" } }",
        "memory:legacy-compiler", ".", "debug")
    if (legacyCompiler.valid) {
        return umsTestFail("compiler must not return as an artifact kind")
    }

    // `component(...)` named a bundle built into the toolchain. There is none:
    // a target declares its own native code.
    let component = umsLoadText(
        "project { name = \"app\" version = \"0.1.0\" prismio = \"0.1\" } targets { executable(\"app\") { entry = \"src/main.psm\" link { component(\"prismio.backend\") } } }",
        "memory:component", ".", "debug")
    if (component.valid) {
        return umsTestFail("link declarations name ordinary linker inputs, not toolchain components")
    }

    let invalid = umsLoadText(
        "project { name = \"broken\" } targets { executable(\"broken\") {} }",
        "memory:invalid", "ums/tests/fixtures/valid", "debug")
    if (invalid.valid or invalid.diagnostics.length < 3) {
        return umsTestFail("invalid manifest should collect useful diagnostics")
    }

    // v0.1 3.7 -- resolution and the lockfile.
    //
    // The `valid` fixture declares `implementation("json", "1.2.0")` with no path,
    // which is a *registry* dependency. There is no registry, so resolving it must
    // fail -- and must still produce a lockfile row recording the attempt.
    let mut registryDiagnostics = umsDiagnostics()
    let registryResolutions = workspace.project.resolveDependencies(registryDiagnostics)
    if (registryResolutions.length != 1) {
        return umsTestFail("one dependency should resolve to one resolution")
    }
    if (registryResolutions[0].ok) {
        return umsTestFail("a registry dependency must not resolve without a registry")
    }
    if (registryDiagnostics.length != 1) {
        return umsTestFail("an unresolvable dependency should report exactly one diagnostic")
    }
    let registryLock = workspace.project.lockfileContents(registryResolutions)
    if (registryLock.contains("registry") == false) {
        return umsTestFail("the lockfile should record the source as registry")
    }
    if (registryLock.contains("json") == false) {
        return umsTestFail("the lockfile should name the dependency it could not resolve")
    }

    // A path dependency naming a directory that exists resolves, and one naming a
    // directory that does not must fail rather than create it.
    let good = umsLoadText(
        "project { name = \"p\" version = \"1.0.0\" prismio = \"1.0\" } targets { executable(\"p\") { entry = \"src/main.psm\" } } dependencies { implementation(\"dep\", \"1.0.0\", \"../localdep\") }",
        "memory:good", "ums/tests/fixtures/valid", "debug")
    if (good.valid == false) { return umsTestFail("a path dependency should lower") }
    let mut goodDiagnostics = umsDiagnostics()
    let goodResolutions = good.project.resolveDependencies(goodDiagnostics)
    if (goodDiagnostics.length != 0) {
        return umsTestFail("an existing path dependency should report nothing")
    }
    if (goodResolutions[0].ok == false) {
        return umsTestFail("an existing path dependency should resolve")
    }

    let bad = umsLoadText(
        "project { name = \"p\" version = \"1.0.0\" prismio = \"1.0\" } targets { executable(\"p\") { entry = \"src/main.psm\" } } dependencies { implementation(\"dep\", \"1.0.0\", \"../nowhere\") }",
        "memory:bad", "ums/tests/fixtures/valid", "debug")
    let mut badDiagnostics = umsDiagnostics()
    let badResolutions = bad.project.resolveDependencies(badDiagnostics)
    if (badDiagnostics.length != 1) {
        return umsTestFail("a missing path dependency should report one diagnostic")
    }
    if (badResolutions[0].ok) {
        return umsTestFail("a missing path dependency must not resolve")
    }
    // The directory must not have been brought into existence by asking about it.
    if (directoryExists("ums/tests/fixtures/nowhere")) {
        return umsTestFail("resolving a missing path dependency created the directory")
    }

    // The manifest writer is a source edit, not a serializer. This CRLF fixture
    // is deliberately formatted and commented: equality of the complete answer
    // proves that only the new declaration changed.
    let commentedSource = "# keep this heading\r\nproject { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" }\r\ntargets { executable(\"app\") { entry = \"src/main.psm\" } }\r\ndependencies {\r\n    # keep this dependency comment\r\n    implementation(\"json\", \"1.2.0\")\r\n}\r\n"
    let commentedExpected = "# keep this heading\r\nproject { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" }\r\ntargets { executable(\"app\") { entry = \"src/main.psm\" } }\r\ndependencies {\r\n    # keep this dependency comment\r\n    implementation(\"json\", \"1.2.0\")\r\n    api(\"http\", \"^2.0\")\r\n}\r\n"
    let mut commentedDiagnostics = umsDiagnostics()
    let commentedEdit = umsManifestAddDependency(
        commentedSource, "memory:commented", UmsDependencyScope.API,
        "http", "^2.0", "", commentedDiagnostics)
    if (commentedEdit.changed == false or commentedDiagnostics.length != 0) {
        return umsTestFail("a valid commented manifest should accept an edit")
    }
    if (commentedEdit.text.equals(commentedExpected) == false) {
        return umsTestFail("the writer changed formatting or comments around an existing block")
    }

    // Without a dependency block, one is appended after a blank line. Values
    // are escaped through the same five-escape vocabulary the lexer decodes.
    let noDependencies = "project { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" }\n\ntargets { executable(\"app\") { entry = \"src/main.psm\" } }\n# keep the tail\n"
    let appendedExpected = "project { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" }\n\ntargets { executable(\"app\") { entry = \"src/main.psm\" } }\n# keep the tail\n\ndependencies {\n    testImplementation(\"local\", \"^1.0\\tbeta\", \"..\\\\localdep\")\n}\n"
    let mut appendedDiagnostics = umsDiagnostics()
    let appendedEdit = umsManifestAddDependency(
        noDependencies, "memory:appended", UmsDependencyScope.TEST_IMPLEMENTATION,
        "local", "^1.0\tbeta", "..\\localdep", appendedDiagnostics)
    if (appendedEdit.changed == false or appendedDiagnostics.length != 0) {
        return umsTestFail("a valid manifest without dependencies should accept an edit")
    }
    if (appendedEdit.text.equals(appendedExpected) == false) {
        return umsTestFail("the writer did not append and escape a dependency block exactly")
    }
    let appendedWorkspace = umsLoadText(
        appendedEdit.text, "memory:appended-result", "ums/tests/fixtures/valid", "debug")
    if (appendedWorkspace.valid == false or
        appendedWorkspace.project.dependencies.length != 1) {
        return umsTestFail("the appended manifest should parse and lower again")
    }
    let appendedDependency = appendedWorkspace.project.dependencies[0]
    if (appendedDependency.constraint.equals("^1.0\tbeta") == false or
        appendedDependency.path.equals("..\\localdep") == false) {
        return umsTestFail("written dependency strings should round-trip through the lexer")
    }

    // Inline manifests stay inline. A semicolon is the smallest unambiguous
    // separator between the declaration already there and the one being added.
    let inlineSource = "project { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" } targets { executable(\"app\") { entry = \"src/main.psm\" } } dependencies { implementation(\"json\", \"1\") }"
    let inlineExpected = "project { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" } targets { executable(\"app\") { entry = \"src/main.psm\" } } dependencies { implementation(\"json\", \"1\"); api(\"net\", \"2\") }"
    let mut inlineDiagnostics = umsDiagnostics()
    let inlineEdit = umsManifestAddDependency(
        inlineSource, "memory:inline", UmsDependencyScope.API,
        "net", "2", "", inlineDiagnostics)
    if (inlineEdit.changed == false or inlineDiagnostics.length != 0 or
        inlineEdit.text.equals(inlineExpected) == false) {
        return umsTestFail("an inline dependency block should receive one inline declaration")
    }

    // A refused edit returns the original source. This is the property a future
    // CLI command relies on before it opens build.ums for writing.
    let mut duplicateDiagnostics = umsDiagnostics()
    let duplicateEdit = umsManifestAddDependency(
        inlineSource, "memory:duplicate", UmsDependencyScope.IMPLEMENTATION,
        "json", "2", "", duplicateDiagnostics)
    if (duplicateEdit.changed or duplicateDiagnostics.length != 1 or
        duplicateEdit.text.equals(inlineSource) == false) {
        return umsTestFail("a duplicate dependency should refuse the edit without changing source")
    }

    let malformedSource = "dependencies {"
    let mut malformedDiagnostics = umsDiagnostics()
    let malformedEdit = umsManifestAddDependency(
        malformedSource, "memory:malformed", UmsDependencyScope.IMPLEMENTATION,
        "json", "1", "", malformedDiagnostics)
    if (malformedEdit.changed or malformedDiagnostics.length == 0 or
        malformedEdit.text.equals(malformedSource) == false) {
        return umsTestFail("a malformed manifest should refuse the edit without changing source")
    }

    // Commands. The base declares both an executable and a test target, because
    // two of the rules below are about which kind a step may name.
    let commandBase = "project { name = \"app\" version = \"1.0.0\" prismio = \"1.0\" } targets { executable(\"app\") { entry = \"src/main.psm\" } test(\"probe\") { entry = \"src/main.psm\" } } "

    let commandsWorkspace = umsLoadText(
        commandBase.concat("commands { command(\"ship\") { description = \"build then package\" build(\"app\") shell(\"tools/pack.sh\", \"--out\", args, \"--tail\") } }"),
        "memory:commands", "ums/tests/fixtures/valid", "debug")
    if (commandsWorkspace.valid == false) {
        umsDiagnosticsPrint(commandsWorkspace.diagnostics)
        return umsTestFail("a commands block should lower and validate")
    }
    if (commandsWorkspace.commandCount() != 1 or
        commandsWorkspace.findCommand("ship") != 0 or
        commandsWorkspace.findCommand("absent") >= 0) {
        return umsTestFail("a declared command should be found by name and only by its own")
    }

    let ship = commandsWorkspace.command(0)
    if (ship.description.equals("build then package") == false or
        ship.steps.length != 2) {
        return umsTestFail("a command should keep its description and every step")
    }
    if (ship.steps[0].kind != UmsCommandStepKind.BUILD or
        ship.steps[0].subject.equals("app") == false or
        ship.steps[1].kind != UmsCommandStepKind.SHELL or
        ship.steps[1].subject.equals("tools/pack.sh") == false) {
        return umsTestFail("steps should keep their kind, subject and declaration order")
    }

    // The marker is a member of the argument list rather than a flag, so that a
    // manifest can put forwarded arguments *between* two fixed ones.
    let packArguments = ship.steps[1].arguments
    if (packArguments.length != 3 or
        packArguments[0].forwarded or
        packArguments[1].forwarded == false or
        packArguments[2].forwarded or
        packArguments[0].text.equals("--out") == false) {
        return umsTestFail("`args` should keep its position among shell arguments")
    }

    let duplicateCommand = umsLoadText(
        commandBase.concat("commands { command(\"a\") { shell(\"x\") } command(\"a\") { shell(\"y\") } }"),
        "memory:duplicate-command", "ums/tests/fixtures/valid", "debug")
    if (duplicateCommand.valid) {
        return umsTestFail("a command name declared twice should be rejected")
    }

    let unknownStepTarget = umsLoadText(
        commandBase.concat("commands { command(\"a\") { build(\"nope\") } }"),
        "memory:unknown-step-target", "ums/tests/fixtures/valid", "debug")
    if (unknownStepTarget.valid) {
        return umsTestFail("a step naming no declared target should be rejected")
    }

    let runNeedsExecutable = umsLoadText(
        commandBase.concat("commands { command(\"a\") { run(\"probe\") } }"),
        "memory:run-needs-executable", "ums/tests/fixtures/valid", "debug")
    if (runNeedsExecutable.valid) {
        return umsTestFail("a run step should refuse a target it cannot execute")
    }

    // One mistake, one diagnostic. The rejected step is still recorded, so the
    // command is not *also* reported as declaring none.
    let rejectedStep = umsLoadText(
        commandBase.concat("commands { command(\"a\") { deploy(\"x\") } }"),
        "memory:rejected-step", "ums/tests/fixtures/valid", "debug")
    if (rejectedStep.valid or rejectedStep.diagnostics.length != 1) {
        return umsTestFail("a rejected step should report once, not twice")
    }

    // `run` resolves its subject rather than offering a step kind per launcher.
    // A .psm in the fixture stands in for a project's own tool; it takes
    // arguments exactly as a shell step does, which `build` deliberately does not.
    let runScript = umsLoadText(
        commandBase.concat("commands { command(\"tool\") { run(\"src/main.psm\", \"--once\", args) } }"),
        "memory:run-script", "ums/tests/fixtures/valid", "debug")
    if (runScript.valid == false) {
        umsDiagnosticsPrint(runScript.diagnostics)
        return umsTestFail("run should accept a .psm under the project root")
    }
    let toolStep = runScript.command(0).steps[0]
    if (toolStep.kind != UmsCommandStepKind.RUN or
        toolStep.arguments.length != 2 or
        toolStep.arguments[1].forwarded == false) {
        return umsTestFail("a run step should carry its arguments and the args marker")
    }

    let runUnknownKind = umsLoadText(
        commandBase.concat("commands { command(\"a\") { run(\"tools/thing.sh\") } }"),
        "memory:run-unknown-kind", "ums/tests/fixtures/valid", "debug")
    if (runUnknownKind.valid or runUnknownKind.diagnostics.length != 1) {
        return umsTestFail("run should refuse a subject it cannot start")
    }

    let runMissingScript = umsLoadText(
        commandBase.concat("commands { command(\"a\") { run(\"src/absent.py\") } }"),
        "memory:run-missing-script", "ums/tests/fixtures/valid", "debug")
    if (runMissingScript.valid or runMissingScript.diagnostics.length != 1) {
        return umsTestFail("run should refuse a script that is not there")
    }

    let emptyCommand = umsLoadText(
        commandBase.concat("commands { command(\"a\") { description = \"nothing\" } }"),
        "memory:empty-command", "ums/tests/fixtures/valid", "debug")
    if (emptyCommand.valid or emptyCommand.diagnostics.length != 1) {
        return umsTestFail("a command with no steps should be rejected once")
    }

    println("PASS: UMS parser, models, validation, planning, resolution, lockfile and writer")
    return 0
}
