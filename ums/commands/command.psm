import std.string

// Appended, never inserted: the tag is the variant's position, so reordering
// these changes the value every compiled comparison expects -- the rule
// std/core/option.psm states for `Option`.
public enum UmsCommandStepKind {
    UNKNOWN,
    BUILD,
    RUN,
    SHELL
}

// A shell argument is either a literal from the manifest or the marker that
// splices in whatever the user typed after the command name. Position is part of
// the meaning -- `shell("git", "commit", args)` and `shell("git", args, "commit")`
// are different commands -- so the marker is a member of the argument list rather
// than a flag on the step.
struct UmsCommandArgument {
    public forwarded: Bool,
    // The bare word `output` in a target's `after` step: the file that was just built.
    public output: Bool,
    public text: String,
    line: Int,
    col: Int,
    len: Int
}

// A step is one action in declaration order. `subject` is the target name for
// BUILD and RUN and the program for SHELL, because all three are a name plus an
// optional argument list and a second field would be empty in two of the three.
public struct UmsCommandStep {
    public kind: UmsCommandStepKind,
    public subject: String,
    public arguments: Vec<UmsCommandArgument>,
    public line: Int,
    public col: Int,
    public len: Int
}

public struct UmsCommand {
    public name: String,
    public description: String,
    public steps: Vec<UmsCommandStep>,
    public line: Int,
    public col: Int,
    public len: Int
}

public fn umsCommand(name: String, line: Int, col: Int, len: Int) -> UmsCommand {
    return UmsCommand {
        name: name.clone(),
        description: "".clone(),
        steps: [],
        line: line,
        col: col,
        len: len
    }
}

public fn umsCommandStep(kind: UmsCommandStepKind, subject: String,
                  line: Int, col: Int, len: Int) -> UmsCommandStep {
    return UmsCommandStep {
        kind: kind,
        subject: subject.clone(),
        arguments: [],
        line: line,
        col: col,
        len: len
    }
}

public fn umsCommandArgument(forwarded: Bool, text: String,
                      line: Int, col: Int, len: Int) -> UmsCommandArgument {
    return UmsCommandArgument {
        forwarded: forwarded,
        output: false,
        text: text.clone(),
        line: line,
        col: col,
        len: len
    }
}

public fn umsOutputArgument(line: Int, col: Int, len: Int) -> UmsCommandArgument {
    return UmsCommandArgument {
        forwarded: false,
        output: true,
        text: "".clone(),
        line: line,
        col: col,
        len: len
    }
}

// A copy with its own strings and arguments.
public fn umsCommandStepCopy(step: UmsCommandStep) -> UmsCommandStep {
    let copy = umsCommandStep(step.kind, step.subject, step.line, step.col, step.len)
    for argument in step.arguments {
        if (argument.output) {
            copy.arguments.push(umsOutputArgument(argument.line, argument.col, argument.len))
        } else {
            copy.arguments.push(umsCommandArgument(argument.forwarded, argument.text,
                      argument.line, argument.col, argument.len))
        }
    }
    return copy
}

public fn umsCommandFind(commands: Vec<UmsCommand>, name: String) -> Int {
    let mut i = 0
    while (i < commands.length) {
        if (commands[i].name.equals(name)) { return i }
        i = i + 1
    }
    return -1
}
