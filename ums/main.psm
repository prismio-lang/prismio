extern fn cli_arg_count() -> Int
extern fn cli_arg(index: Int) -> String
extern fn read_file(path: String) -> String
extern fn file_exists(path: String) -> Int
extern fn str_equals(s1: String, s2: String) -> Int
extern fn str_length(s: String) -> Int
extern fn str_index_of(haystack: String, needle: String) -> Int
extern fn str_substring(s: String, start: Int, length: Int) -> String
extern fn str_char_at(s: String, index: Int) -> Char
extern fn str_concat(s1: String, s2: String) -> String
extern fn execute_command(command: String) -> Int
extern fn executable_directory() -> String
extern fn join_path(directory: String, filename: String) -> String
extern fn command_quote_arg(arg: String) -> String

fn find_char_from(text: String, target: Char, start: Int) -> Int {
    let i = start
    let len = str_length(text)

    while (i < len) {
        if (str_char_at(text, i) == target) {
            return i
        }
        i = i + 1
    }

    return 0 - 1
}

fn read_call_value(content: String, name: String, fallback: String) -> String {
    let start = str_index_of(content, name)
    if (start < 0) {
        return fallback
    }

    let open_quote = find_char_from(content, '"', start + str_length(name))
    if (open_quote < 0) {
        return fallback
    }

    let close_quote = find_char_from(content, '"', open_quote + 1)
    if (close_quote < 0) {
        return fallback
    }

    return str_substring(content, open_quote + 1, close_quote - open_quote - 1)
}

fn default_prismio_path() -> String {
    let local_prismio = join_path(executable_directory(), "prismio.exe")
    if (file_exists(local_prismio) == 1) {
        return local_prismio
    }
    return "prismio"
}

fn prismio_path(content: String) -> String {
    return read_call_value(content, "prismio", default_prismio_path())
}

fn source_path(content: String) -> String {
    return read_call_value(content, "source", "src/main.psm")
}

fn output_path(content: String) -> String {
    return read_call_value(content, "output", "build/app.exe")
}

fn run_args(content: String) -> String {
    return read_call_value(content, "args", "")
}

fn build_command(content: String) -> String {
    let cmd = command_quote_arg(prismio_path(content))
    cmd = str_concat(cmd, " build ")
    cmd = str_concat(cmd, command_quote_arg(source_path(content)))
    cmd = str_concat(cmd, " -o ")
    cmd = str_concat(cmd, command_quote_arg(output_path(content)))
    return cmd
}

fn executable_command(content: String) -> String {
    let cmd = command_quote_arg(output_path(content))
    let args = run_args(content)

    if (str_equals(args, "") == 0) {
        cmd = str_concat(cmd, " ")
        cmd = str_concat(cmd, args)
    }

    return cmd
}

fn load_config() -> String {
    if (file_exists("build.ums") == 0) {
        println("ERROR: build.ums not found")
        return ""
    }

    return read_file("build.ums")
}

fn run_build(content: String) -> Int {
    let cmd = build_command(content)
    print("UMS build: ")
    println(cmd)
    return execute_command(cmd)
}

fn run_project(content: String) -> Int {
    let build_result = run_build(content)
    if (build_result != 0) {
        return build_result
    }

    let cmd = executable_command(content)
    print("UMS run: ")
    println(cmd)
    return execute_command(cmd)
}

fn print_usage() {
    println("Usage:")
    println("  ums build")
    println("  ums run")
}

fn main() -> Int {
    if (cli_arg_count() <= 1) {
        print_usage()
        return 1
    }

    let content = load_config()
    if (str_equals(content, "") == 1) {
        return 1
    }

    let command = cli_arg(1)
    if (str_equals(command, "build") == 1) {
        return run_build(content)
    }

    if (str_equals(command, "run") == 1) {
        return run_project(content)
    }

    print("ERROR: unknown UMS command ")
    println(command)
    print_usage()
    return 1
}
