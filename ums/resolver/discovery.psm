import ums.model.diagnostic
import std.string
import std.fs


public fn umsDiscoverManifest(startDirectory: String,
                       inout diagnostics: Vec<UmsDiagnostic>) -> String {
    let mut directory = startDirectory
    if (directory.length == 0 or directory.equals(".")) {
        directory = currentDirectory()
    }

    loop {
        let candidate = joinPath(directory, "build.ums")
        if (fileExists(candidate)) { return candidate }

        let parent = directoryOf(directory)
        if (parent.equals(directory) or parent.equals(".")) {
            break
        }
        directory = parent
    }

    umsDiagnosticAdd(diagnostics, "UMS0002", startDirectory, 0, 0, 0,
                     "no build.ums found at or above this directory")
    return ""
}
