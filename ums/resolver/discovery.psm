import ums.model.diagnostic
import std.string

extern fn current_directory() -> String produce(free)
extern fn get_directory(path: String borrow) -> String produce(free)
extern fn join_path(directory: String borrow, child: String borrow) -> String produce(free)
extern fn file_exists(path: String borrow) -> Int

fn umsDiscoverManifest(startDirectory: String,
                       diagnostics: List<UmsDiagnostic>) -> String {
    let mut directory = startDirectory
    if (__builtin_string_len(directory) == 0 or strEquals(directory, ".")) {
        directory = current_directory()
    }

    loop {
        let candidate = join_path(directory, "build.ums")
        if (file_exists(candidate) == 1) { return candidate }

        let parent = get_directory(directory)
        if (strEquals(parent, directory) or strEquals(parent, ".")) {
            break
        }
        directory = parent
    }

    umsDiagnosticAdd(diagnostics, "UMS0002", startDirectory, 0, 0, 0,
                     "no build.ums found at or above this directory")
    return ""
}
