// v0.1 3.7 -- dependency resolution and the lockfile.
//
// The section's own framing: "a manifest, a lockfile, a local path dependency,
// and a registry-shaped fetch that need not have a registry behind it yet. **The
// structure is the deliverable**; the network is not." This file is that
// structure, and nothing in it opens a socket.
//
// A dependency is resolved in one of two ways, and which one is decided by
// whether the manifest gave it a path:
//
//   implementation("json", "1.2.0", "../json")   -- a *path* dependency
//   implementation("json", "1.2.0")              -- a *registry* dependency
//
// The path form resolves against the manifest's directory and either names a real
// directory or is an error. The registry form is modelled, validated and written
// to the lockfile exactly like the path form, and then fails at the fetch, which
// is the one step with nothing behind it. That split is deliberate: when a
// registry does exist, the only thing that changes is umsFetchRegistry, and the
// model, the lockfile and every diagnostic around it are already in place.

import std.string
import std.io
import std.fs
import std.list
import ums.dependency.dependency
import ums.model.project
import ums.model.diagnostic

// Where a resolved dependency's sources live, relative to nothing -- it is an
// absolute-or-manifest-relative path the compiler can add to its import search.
//
// `ok` is separate from `resolved` being non-empty because a registry dependency
// that failed to fetch still records what it *would* have been, and the lockfile
// prints that. A field that meant both would lose the difference.
struct UmsResolution {
    name: String,
    scope: String,
    constraint: String,
    source: String,
    resolved: String,
    ok: Bool
}

// The lockfile's own version, bumped when its shape changes rather than when a
// dependency does. A reader that does not recognise it should refuse the file
// instead of guessing at the columns.
private fn umsLockfileVersion() -> String {
    return strClone("1")
}

// Dependency resolution and the lockfile, as methods on the project they belong
// to. The three that stay public are the surface `src/main.psm` drives:
// `project.resolveDependencies(diags)` and `project.writeLockfile(resolutions)`.
impl UmsProjectModel {

    private fn lockfilePath(self) -> String {
        let stateDir = joinPath(self.root, self.build.stateDirectory)
        return joinPath(stateDir, "prismio.lock")
    }

    // A path dependency resolves against the directory holding `build.ums`, not
    // against the process's working directory. Those differ whenever `prismio build`
    // is run from a descendant, which the discovery walk explicitly supports -- so
    // resolving against the cwd would make the same manifest mean different things
    // depending on where it was invoked.
    private fn resolvePath(self, dependency: UmsDependency,
                              diagnostics: List<UmsDiagnostic>) -> UmsResolution {
        let candidate = joinPath(self.root, dependency.path)
        let exists = directoryExists(candidate)

        if (exists == false) {
            umsDiagnosticAdd(diagnostics, "UMS2210", self.manifestPath,
                dependency.line, dependency.col, dependency.len,
                "path dependency '".concat(dependency.name,
                                           "' does not name a directory: ",
                                           candidate))
            return UmsResolution {
                name: strClone(dependency.name),
                scope: umsDependencyScopeName(dependency.scope),
                constraint: strClone(dependency.constraint),
                source: strClone("path"),
                resolved: strClone(candidate),
                ok: false
            }
        }

        return UmsResolution {
            name: strClone(dependency.name),
            scope: umsDependencyScopeName(dependency.scope),
            constraint: strClone(dependency.constraint),
            source: strClone("path"),
            resolved: strClone(candidate),
            ok: true
        }
    }

    // The registry-shaped half. It has the shape of a fetch and performs none: the
    // point is that everything around it -- the model, the constraint, the lockfile
    // row, the diagnostic -- is already correct, so standing a registry up later
    // touches this function and nothing else.
    private fn fetchRegistry(self, dependency: UmsDependency,
                                diagnostics: List<UmsDiagnostic>) -> UmsResolution {
        umsDiagnosticAdd(diagnostics, "UMS2211", self.manifestPath,
            dependency.line, dependency.col, dependency.len,
            "no registry is configured, so '".concat(dependency.name,
                                                     "' cannot be fetched; give it a local path as a third argument: ",
                                                     "implementation(\"",
                                                     dependency.name,
                                                     "\", \"...\", \"../path\")"))
        return UmsResolution {
            name: strClone(dependency.name),
            scope: umsDependencyScopeName(dependency.scope),
            constraint: strClone(dependency.constraint),
            source: strClone("registry"),
            resolved: strClone(""),
            ok: false
        }
    }

    // Resolves every declared dependency, in manifest order, and answers the list.
    // Order is the manifest's rather than sorted, so the lockfile reads against the
    // file that produced it.
         fn resolveDependencies(self, diagnostics: List<UmsDiagnostic>) -> List<UmsResolution> {
        let resolutions: List<UmsResolution> = list_new()
        let mut i = 0
        while (i < list_len(self.dependencies)) {
            let dependency = list_get(self.dependencies, i)
            if (dependency.isPath()) {
                list_push(resolutions, self.resolvePath(dependency, diagnostics))
            } else {
                list_push(resolutions, self.fetchRegistry(dependency, diagnostics))
            }
            i = i + 1
        }
        return resolutions
    }

    // One row per dependency: scope, name, constraint, where it came from, and what
    // it resolved to. Tab-separated with a header, because the file exists to be
    // diffed in review -- a format that reorders or reflows on write produces a diff
    // nobody can read, which is how a lockfile stops being checked.
         fn lockfileContents(self, resolutions: List<UmsResolution>) -> String {
        let mut out = "# prismio lockfile v".concat(umsLockfileVersion(), "\n# generated from ")
        out = out.concat(self.manifestPath)
        out = out.concat("\n# scope\tname\tconstraint\tsource\tresolved\n")

        let mut i = 0
        while (i < list_len(resolutions)) {
            let r = list_get(resolutions, i)
            let mut row = r.scope.concat("\t")
            row = row.concat(r.name, "\t")
            row = row.concat(r.constraint, "\t")
            row = row.concat(r.source, "\t")
            // An unresolved dependency is written as "-" rather than omitted, so the
            // row count matches the manifest and a failed fetch is visible in the
            // diff instead of absent from it.
            if (r.ok) {
                row = row.concat(r.resolved)
            } else {
                row = row.concat("-")
            }
            out = out.concat(row, "\n")
            i = i + 1
        }
        return out
    }

    // Writes the lockfile beside the build state, creating `.prismio/` if needed.
    // Answers false only when the write itself failed; an unresolved dependency is
    // recorded rather than suppressed, because the file has to describe the attempt.
         fn writeLockfile(self, resolutions: List<UmsResolution>) -> Bool {
        let stateDir = joinPath(self.root, self.build.stateDirectory)
        if (makeDirectory(stateDir) == false) { return false }
        return writeFile(self.lockfilePath(), self.lockfileContents(resolutions))
    }
}
