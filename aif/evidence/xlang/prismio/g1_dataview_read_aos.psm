// M4.3b paired read microbenchmark -- ordinary inline AoS control.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> Int

struct ReadParticle {
    px: Float,
    py: Float,
    pz: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    r: Float,
    g: Float,
    b: Float,
    a: Float,
    life: Float,
    size: Float
}

fn readParticle(f: Float) -> ReadParticle {
    return ReadParticle {
        px: f, py: f, pz: f,
        vx: 1.0, vy: 2.0, vz: 3.0,
        r: 1.0, g: 0.5, b: 0.25, a: 1.0,
        life: f + 100.0, size: 2.0
    }
}

fn buildReadRows(count: Int) -> List<ReadParticle> {
    let mut rows: List<ReadParticle> = list_new_with_capacity(count)
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(rows, readParticle(f))
        i = i + 1
        f = f + 1.0
    }
    return rows
}

fn sumLife(rows: List<ReadParticle>) -> Float {
    let n = list_len(rows)
    let mut total = 0.0
    let mut i = 0
    while (i < n) {
        let row = list_get(rows, i)
        total = total + row.life
        i = i + 1
    }
    return total
}

fn main() -> Int {
    // The 19.2 MiB AoS working set is intentionally larger than private cache;
    // the paired SoA scan reads only the 1.6 MiB `life` column.
    let rounds = 400
    let rows = buildReadRows(200000)
    let mut samples: List<Int> = list_new_with_capacity(rounds)
    let mut prep = 0
    while (prep < rounds) {
        list_push(samples, 0)
        prep = prep + 1
    }

    let mut checksum = 0.0
    let mut frame = 0
    while (frame < rounds) {
        let t0 = clock_gettime_nsec_np(4)
        checksum = checksum + sumLife(rows)
        let t1 = clock_gettime_nsec_np(4)
        list_set(samples, frame, t1 - t0)
        frame = frame + 1
    }

    print("checksum ")
    println(checksum)
    let mut i = 0
    while (i < rounds) {
        print("frame_ns ")
        println(list_get(samples, i))
        i = i + 1
    }
    return 0
}
