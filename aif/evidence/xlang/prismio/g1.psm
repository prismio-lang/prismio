// G1 particles -- cross-language benchmark port.
//
// The workload functions below are verbatim from aif/corpus/g1_particles.psm.
// Only main() differs: it runs FRAMES frames instead of 60 and records a
// nanosecond sample per frame.
//
// The sample buffer is a List<Int> grown to its final length *before* the
// measured loop, so list_set inside the loop reallocates nothing and the frame
// times carry no allocation of the harness's own.
//
// v0.1 §4: written in the language as it now is. The workload calls take method
// syntax -- `ps.integrate(dt)` -- and the helpers are `private`, since nothing
// outside this file calls them. Neither changes what is measured: a method call
// *is* the free call `integrate(ps, dt)` after the checker's rewrite, and `private`
// is a resolution-time check. The proof is that the emitted __TEXT,__text is
// byte-identical to the pre-rewrite program, and the checksums below are unchanged.
//
// An `impl` block is not available for these: the receiver is `List<Particle>`, and
// a generic `impl` is rejected with "write the methods as generic free functions",
// which is what these are.
//
// clock_gettime_nsec_np(4) is CLOCK_MONOTONIC_RAW. It is declared here rather
// than added to the runtime because this session is not permitted a compiler
// change, and an extern declaration is a language feature, not one.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> I64

struct Particle {
    px: Float,
    py: Float,
    pz: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    r: Float,
    g: Float,
    b: Float,
    a: Float,
    life: Float,
    size: Float
}

private fn spawn_particle(f: Float) -> Particle {
    return Particle {
        px: f,
        py: f,
        pz: 0.0,
        vx: 1.0,
        vy: 2.0,
        vz: 0.0,
        r: 1.0,
        g: 1.0,
        b: 1.0,
        a: 1.0,
        life: 100.0,
        size: 1.0
    }
}

private fn build_system(count: Int) -> List<Particle> {
    let mut ps: List<Particle> = list_new()
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(ps, spawn_particle(f))
        f = f + 1.0
        i = i + 1
    }
    return ps
}

// Touches 6 of 12 fields: position and velocity only.
private fn integrate(ps: List<Particle>, dt: Float) {
    let n = list_len(ps)
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        p.px = p.px + p.vx * dt
        p.py = p.py + p.vy * dt
        p.pz = p.pz + p.vz * dt
        i = i + 1
    }
}

// Touches 2 of 12 fields. The strongest SoA case in the corpus.
private fn fade(ps: List<Particle>, dt: Float) {
    let n = list_len(ps)
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        p.life = p.life - dt
        p.a = p.life * 0.01
        i = i + 1
    }
}

// Reads 1 of 12 fields to produce a scalar -- the pure-streaming case.
private fn count_alive(ps: List<Particle>) -> Int {
    let n = list_len(ps)
    let mut alive = 0
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        if (p.life > 0.0) {
            alive = alive + 1
        }
        i = i + 1
    }
    return alive
}

// A digest of the integration, not of the fade: `alive` alone would be the same
// number whether or not any position was ever updated.
private fn count_beyond(ps: List<Particle>, limit: Float) -> Int {
    let n = list_len(ps)
    let mut beyond = 0
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        if (p.px > limit) {
            beyond = beyond + 1
        }
        i = i + 1
    }
    return beyond
}

fn main() -> Int {
    let frames = 6000
    let ps = build_system(2000)
    let dt = 0.016

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut frame = 0
    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)
        ps.integrate(dt)
        ps.fade(dt)
        let t1 = clock_gettime_nsec_np(4)
        list_set(samples, frame, (t1 - t0) as Int)
        frame = frame + 1
    }

    print("checksum alive ")
    println(ps.count_alive())
    print("checksum beyond ")
    println(ps.count_beyond(1000.5))

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
