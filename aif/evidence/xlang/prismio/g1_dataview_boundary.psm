// M4.3a conversion microbenchmark.
//
// Each sample converts 2,000 twelve-float rows AoS -> twelve real columns ->
// AoS. It deliberately performs no field work between the boundaries: the
// measured time is the price M4.3b's column-local traversal must earn back.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> Int

struct Particle {
    px: Float,
    py: Float,
    pz: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    r: Float,
    g: Float,
    b: Float,
    a: Float,
    life: Float,
    size: Float
}

fn particle(f: Float) -> Particle {
    return Particle {
        px: f, py: f, pz: f,
        vx: 1.0, vy: 2.0, vz: 3.0,
        r: 1.0, g: 0.5, b: 0.25, a: 1.0,
        life: 100.0, size: 2.0
    }
}

fn buildRows(count: Int) -> List<Particle> {
    let mut rows: List<Particle> = list_new_with_capacity(count)
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(rows, particle(f))
        i = i + 1
        f = f + 1.0
    }
    return rows
}

fn roundTrip(sink rows: List<Particle>) -> List<Particle> {
    let columns: DataView<Particle> = soa(rows)
    return aos(columns)
}

fn main() -> Int {
    let rowCount = 2000
    let rounds = 400
    let mut rows = buildRows(rowCount)

    let mut samples: List<Int> = list_new_with_capacity(rounds)
    let mut prep = 0
    while (prep < rounds) {
        list_push(samples, 0)
        prep = prep + 1
    }

    let mut frame = 0
    while (frame < rounds) {
        let t0 = clock_gettime_nsec_np(4)
        rows = roundTrip(rows)
        let t1 = clock_gettime_nsec_np(4)
        list_set(samples, frame, t1 - t0)
        frame = frame + 1
    }

    print("checksum rows ")
    println(list_len(rows))
    let mut i = 0
    while (i < rounds) {
        print("frame_ns ")
        println(list_get(samples, i))
        i = i + 1
    }
    return 0
}
