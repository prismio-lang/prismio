// G3 scene graph -- cross-language benchmark port.
//
// Workload functions verbatim from aif/corpus/g3_scene_graph.psm; only main()
// differs. The hierarchy is built once and the per-frame work is the transform
// propagation over it, so this program allocates nothing per frame -- it
// measures how a retained tree is *traversed*, not how it is allocated.

extern fn clock_gettime_nsec_np(clk: Int) -> Int

struct Transform {
    px: Float,
    py: Float,
    pz: Float,
    sx: Float,
    sy: Float,
    sz: Float
}

struct Bounds {
    min_x: Float,
    min_y: Float,
    min_z: Float,
    max_x: Float,
    max_y: Float,
    max_z: Float
}

struct Node {
    local: Transform,
    world: Transform,
    bounds: Bounds,
    parent: Int,
    first_child: Int,
    next_sibling: Int,
    dirty: Bool
}

fn identity_transform() -> Transform {
    return Transform { px: 0.0, py: 0.0, pz: 0.0, sx: 1.0, sy: 1.0, sz: 1.0 }
}

fn unit_bounds() -> Bounds {
    return Bounds {
        min_x: 0.0, min_y: 0.0, min_z: 0.0,
        max_x: 1.0, max_y: 1.0, max_z: 1.0
    }
}

fn make_node(parent: Int, ox: Float) -> Node {
    let mut t = identity_transform()
    t.px = ox
    return Node {
        local: t,
        world: identity_transform(),
        bounds: unit_bounds(),
        parent: parent,
        first_child: 0 - 1,
        next_sibling: 0 - 1,
        dirty: true
    }
}

// Links `child` under `parent` by walking the sibling chain. Pure index work --
// no reference is created, so nothing here can raise an aliasing fact.
fn link_child(nodes: List<Node>, parent_idx: Int, child_idx: Int) {
    let p = list_get(nodes, parent_idx)
    if (p.first_child < 0) {
        p.first_child = child_idx
    } else {
        let mut sib = p.first_child
        let mut scanning = true
        while (scanning) {
            let s = list_get(nodes, sib)
            if (s.next_sibling < 0) {
                s.next_sibling = child_idx
                scanning = false
            } else {
                sib = s.next_sibling
            }
        }
    }
}

fn build_hierarchy(breadth: Int, depth: Int) -> List<Node> {
    let mut nodes: List<Node> = list_new()
    list_push(nodes, make_node(0 - 1, 0.0))

    let mut level = 0
    let mut level_start = 0
    let mut level_count = 1

    while (level < depth) {
        let next_start = list_len(nodes)
        let mut parent_off = 0
        while (parent_off < level_count) {
            let parent_idx = level_start + parent_off
            let mut b = 0
            let mut ox = 0.0
            while (b < breadth) {
                let child_idx = list_len(nodes)
                list_push(nodes, make_node(parent_idx, ox))
                link_child(nodes, parent_idx, child_idx)
                ox = ox + 1.0
                b = b + 1
            }
            parent_off = parent_off + 1
        }
        level_start = next_start
        level_count = list_len(nodes) - next_start
        level = level + 1
    }
    return nodes
}

// Depth-first world-transform propagation over the index hierarchy.
fn propagate(nodes: List<Node>, idx: Int, ox: Float, oy: Float, oz: Float) -> Int {
    let n = list_get(nodes, idx)
    n.world.px = n.local.px + ox
    n.world.py = n.local.py + oy
    n.world.pz = n.local.pz + oz
    n.dirty = false

    let wx = n.world.px
    let wy = n.world.py
    let wz = n.world.pz

    let mut visited = 1
    let mut c = n.first_child
    while (c >= 0) {
        visited = visited + propagate(nodes, c, wx, wy, wz)
        let cn = list_get(nodes, c)
        c = cn.next_sibling
    }
    return visited
}

// Reads 6 of 19 scalar fields -- the hot/cold split case for the layout model.
fn count_visible(nodes: List<Node>, limit: Float) -> Int {
    let total = list_len(nodes)
    let mut visible = 0
    let mut i = 0
    while (i < total) {
        let n = list_get(nodes, i)
        if (n.world.px < limit and n.world.py < limit and n.world.pz < limit) {
            visible = visible + 1
        }
        i = i + 1
    }
    return visible
}

fn main() -> Int {
    let frames = 10000
    let nodes = build_hierarchy(4, 5)

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut visited = 0
    let mut visible = 0
    let mut frame = 0
    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)
        visited = propagate(nodes, 0, 0.0, 0.0, 0.0)
        visible = count_visible(nodes, 1000.0)
        let t1 = clock_gettime_nsec_np(4)
        list_set(samples, frame, t1 - t0)
        frame = frame + 1
    }

    print("checksum nodes ")
    println_int(list_len(nodes))
    print("checksum visited ")
    println_int(visited)
    print("checksum visible ")
    println_int(visible)

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println_int(list_get(samples, j))
        j = j + 1
    }
    return 0
}
