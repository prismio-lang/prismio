// G2 frame loop -- Prismio with the `region` annotation. The tuned cell.
//
// Identical to g2.psm except that the frame body is wrapped in `region frame`.
// This is the escape hatch the language offers when inference does not reach the
// answer on its own: most code stays untouched, and the hot scope gets one word.
//
// G2 is the right program to test it on. Its corpus header says "This is the T1
// case in its purest form... If these allocations do not land T1, the escape
// analysis is wrong" -- and they land T2. So this measures whether a programmer
// who reads that manifest and reaches for the annotation can fix it by hand.
//
// arena_objects() reports how many allocations the arena actually served, which
// is the only way to tell an arena pointer from a malloc pointer: the values are
// identical. It is printed as a checksum so the answer cannot be inferred from
// timing alone.

extern fn clock_gettime_nsec_np(clk: Int) -> Int
extern fn arena_objects() -> Int
extern fn arena_regions() -> Int

struct DrawCmd {
    mesh_id: Int,
    material_id: Int,
    depth: Float,
    visible: Bool
}

struct Renderable {
    mesh_id: Int,
    material_id: Int,
    x: Float,
    y: Float,
    z: Float,
    radius: Float
}

struct Stats {
    submitted: Int,
    culled: Int
}

fn build_scene(count: Int) -> List<Renderable> {
    let mut scene: List<Renderable> = list_new()
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(scene, Renderable {
            mesh_id: i,
            material_id: i,
            x: f,
            y: f,
            z: f,
            radius: 1.0
        })
        f = f + 1.0
        i = i + 1
    }
    return scene
}

fn cull(scene: List<Renderable>, near: Float, far: Float) -> List<DrawCmd> {
    let mut cmds: List<DrawCmd> = list_new()
    let n = list_len(scene)
    let mut i = 0
    while (i < n) {
        let r = list_get(scene, i)
        if (r.z >= near and r.z <= far) {
            list_push(cmds, DrawCmd {
                mesh_id: r.mesh_id,
                material_id: r.material_id,
                depth: r.z,
                visible: true
            })
        }
        i = i + 1
    }
    return cmds
}

fn submit(cmds: List<DrawCmd>) -> Int {
    let n = list_len(cmds)
    let mut drawn = 0
    let mut i = 0
    while (i < n) {
        let c = list_get(cmds, i)
        if (c.visible) {
            drawn = drawn + 1
        }
        i = i + 1
    }
    return drawn
}

fn main() -> Int {
    let frames = 20000
    let scene = build_scene(1000)

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut totals = Stats { submitted: 0, culled: 0 }
    let mut frame = 0

    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)
        // The one difference from g2.psm. The region handle is dynamically
        // scoped, so allocations inside cull() -- a callee -- are in scope too.
        region frame_arena {
            let cmds = cull(scene, 0.0, 500.0)
            let drawn = submit(cmds)
            totals.submitted = totals.submitted + drawn
            totals.culled = totals.culled + (1000 - drawn)
        }
        let t1 = clock_gettime_nsec_np(4)
        list_set(samples, frame, t1 - t0)
        frame = frame + 1
    }

    print("checksum submitted ")
    println(totals.submitted)
    print("checksum culled ")
    println(totals.culled)
    print("arena_objects ")
    println(arena_objects())
    print("arena_regions ")
    println(arena_regions())

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
