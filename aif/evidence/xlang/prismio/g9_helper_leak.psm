// G9 helper-leak diagnostic -- **this program leaks on purpose.**
//
// It is g9.psm with the band built by a helper instead of at the spawn site.
// That one change moves every spawn argument from **T0/stack** to
// **T2/owned/Transferred**, and nothing drops it: `--verify` reports
// **80 allocated of 107 leaked** at 20 frames, four per frame, one per spawn.
//
// **Why**: the site is then inside `band()`, so `aif_con_return` has already put
// its escape at Caller by the time INFERENCE 4.1's E-SPAWN-J looks at it, and
// `raise_escape` only raises -- it cannot bottom a Caller value back at the
// spawning scope. The value is heap-allocated, the task owns it by
// T-SPAWN-MOVE, and no owner is ever emitted. `prismio_task_release` exists in
// the runtime and **is never called by codegen**, so the task handle leaks too;
// that one is plain `calloc` and therefore invisible to `--verify`.
//
// **Not in `bench.PROGRAMS`, and it must not be** -- the same rule
// `g8_tree_rebuild.psm` is held to. It is the reproduction for the TODO item,
// kept because the difference between it and `g9.psm` is the measurement.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> I64

struct Band {
    seed: Int,
    steps: Int
}

// One band. Serial by construction: `s` carries across the iteration, so the
// loop cannot be split, reassociated or vectorised in any of the three
// languages, and the only parallelism available is between bands.
fn band(frame: Int, index: Int, steps: Int) -> Band {
    return Band { seed: frame * 7919 + index * 104729 + 1, steps: steps }
}

fn simulate(b: Band) -> Int {
    let mut s = b.seed
    let mut acc = 0
    let mut i = 0
    while (i < b.steps) {
        s = s * 1103515245 + 12345
        acc = acc + ((s / 65536) & 32767)
        i = i + 1
    }
    return acc
}

fn main() -> Int {
    let frames = 20
    let steps = 24000

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut total = 0
    let mut last = 0
    let mut frame = 0
    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)

        let w0 = spawn simulate(band(frame, 0, steps))
        let w1 = spawn simulate(band(frame, 1, steps))
        let w2 = spawn simulate(band(frame, 2, steps))
        let w3 = spawn simulate(band(frame, 3, steps))

        let r0 = join w0
        let r1 = join w1
        let r2 = join w2
        let r3 = join w3

        let t1 = clock_gettime_nsec_np(4)

        last = r0 + r1 + r2 + r3
        total = total + last
        list_set(samples, frame, (t1 - t0) as Int)
        frame = frame + 1
    }

    print("checksum total ")
    println(total)
    print("checksum last ")
    println(last)

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
