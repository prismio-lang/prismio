// G2 frame loop -- hand-tuned Prismio.
//
// The same tuning tuned Rust applies (rust/g2_tuned.rs): the command buffer is
// allocated **once**, outside the frame loop, and refilled in place. Rust spells
// that `cmds.clear()` into a `Vec` with inline elements; Prismio's `List` holds
// pointers, so clearing and re-pushing would still allocate one DrawCmd per
// element per frame. The equivalent here is to pre-fill the buffer once and
// *mutate* the elements, which is what takes the frame loop to zero allocations.
//
// Workload semantics are unchanged: same scene, same cull predicate, same
// checksums as g2.psm.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> Int

struct DrawCmd {
    mesh_id: Int,
    material_id: Int,
    depth: Float,
    visible: Bool
}

struct Renderable {
    mesh_id: Int,
    material_id: Int,
    x: Float,
    y: Float,
    z: Float,
    radius: Float
}

struct Stats {
    submitted: Int,
    culled: Int
}

fn build_scene(count: Int) -> List<Renderable> {
    let mut scene: List<Renderable> = list_new_with_capacity(count)
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(scene, Renderable {
            mesh_id: i,
            material_id: i,
            x: f,
            y: f,
            z: f,
            radius: 1.0
        })
        f = f + 1.0
        i = i + 1
    }
    return scene
}

// The buffer, allocated once. Capacity is the worst case -- every renderable
// passes the cull -- so the frame loop can never need to grow it.
fn make_buffer(count: Int) -> List<DrawCmd> {
    let mut cmds: List<DrawCmd> = list_new_with_capacity(count)
    let mut i = 0
    while (i < count) {
        list_push(cmds, DrawCmd {
            mesh_id: 0,
            material_id: 0,
            depth: 0.0,
            visible: false
        })
        i = i + 1
    }
    return cmds
}

// Fills `cmds` in place and answers how many entries are live. Allocates
// nothing: the DrawCmd objects already exist and are overwritten.
fn cull_into(cmds: List<DrawCmd>, scene: List<Renderable>, near: Float, far: Float) -> Int {
    let n = list_len(scene)
    let mut live = 0
    let mut i = 0
    while (i < n) {
        let r = list_get(scene, i)
        if (r.z >= near and r.z <= far) {
            let c = list_get(cmds, live)
            c.mesh_id = r.mesh_id
            c.material_id = r.material_id
            c.depth = r.z
            c.visible = true
            live = live + 1
        }
        i = i + 1
    }
    return live
}

fn submit(cmds: List<DrawCmd>, live: Int) -> Int {
    let mut drawn = 0
    let mut i = 0
    while (i < live) {
        let c = list_get(cmds, i)
        if (c.visible) {
            drawn = drawn + 1
        }
        i = i + 1
    }
    return drawn
}

fn main() -> Int {
    let frames = 20000
    let scene = build_scene(1000)
    let cmds = make_buffer(1000)

    let mut samples: List<Int> = list_new_with_capacity(frames)
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut totals = Stats { submitted: 0, culled: 0 }
    let mut frame = 0

    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)
        let live = cull_into(cmds, scene, 0.0, 500.0)
        let drawn = submit(cmds, live)
        let t1 = clock_gettime_nsec_np(4)
        totals.submitted = totals.submitted + drawn
        totals.culled = totals.culled + (1000 - drawn)
        list_set(samples, frame, t1 - t0)
        frame = frame + 1
    }

    print("checksum submitted ")
    println(totals.submitted)
    print("checksum culled ")
    println(totals.culled)

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
