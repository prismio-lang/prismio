// G6 engine + gameplay -- cross-language benchmark port.
//
// Workload functions verbatim from aif/corpus/g6_game.psm, importing
// g6_engine.psm unchanged, so the module boundary the corpus program exists to
// test is still here. Only main() differs.
//
// The scenario is the corpus scenario: two squads of 400, 100 ticks. It is run
// SCENARIOS times over a fresh world each time, because combat kills the blue
// squad within ~15 ticks and a single long run would decay into a steady state
// that allocates nothing.
//
// A frame is one *tick*, not one scenario. World construction between scenarios
// is real work and is counted in wall time and in the allocation totals, but it
// is deliberately kept out of the frame samples: it is 1 event per 100 ticks and
// would land squarely on p99, describing the rebuild rather than the frame.

import g6_engine

extern fn clock_gettime_nsec_np(clk: Int) -> Int

// Per-member gameplay state. Holds an engine handle plus data the engine knows
// nothing about.
struct Member {
    actor: Int,
    role: Int,
    kills: Int
}

// A gameplay-owned aggregate holding engine handles. Owns no engine storage.
struct Squad {
    members: List<Member>,
    team: Int,
    morale: Int,
    rally_x: Float,
    rally_y: Float
}

// Transient, rebuilt every tick, dead by the next.
struct Order {
    target: Int,
    dx: Float,
    dy: Float,
    priority: Int
}

fn make_squad(team: Int, rx: Float, ry: Float) -> Squad {
    let m: List<Member> = list_new()
    return Squad {
        members: m,
        team: team,
        morale: 100,
        rally_x: rx,
        rally_y: ry
    }
}

// Gameplay creates entities through the engine and keeps only handles.
fn recruit(w: World, s: Squad, count: Int) {
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        let h = world_spawn(w, s.rally_x + f, s.rally_y + f, s.team)
        list_push(s.members, Member { actor: h, role: 0, kills: 0 })
        f = f + 2.0
        i = i + 1
    }
}

// Per-tick transient allocation: build an order list, consume it, discard it.
// Nothing here outlives the tick.
fn plan_orders(w: World, s: Squad) -> List<Order> {
    let mut orders: List<Order> = list_new()
    let n = list_len(s.members)
    let mut i = 0
    while (i < n) {
        let mem = list_get(s.members, i)
        let h = mem.actor
        let a = world_actor(w, h)
        if (a.alive) {
            let t = world_transform(w, h)
            let dx = s.rally_x - t.x
            let dy = s.rally_y - t.y
            let mut pri = 1
            if (a.health < 50) {
                pri = 3
            }
            list_push(orders, Order { target: h, dx: dx, dy: dy, priority: pri })
        }
        i = i + 1
    }
    return orders
}

fn apply_orders(w: World, orders: List<Order>, speed: Float) -> Int {
    let n = list_len(orders)
    let mut applied = 0
    let mut i = 0
    while (i < n) {
        let o = list_get(orders, i)
        world_set_velocity(w, o.target, o.dx * speed, o.dy * speed)
        applied = applied + 1
        i = i + 1
    }
    return applied
}

fn resolve_combat(w: World, a: Squad, b: Squad) -> Int {
    let na = list_len(a.members)
    let nb = list_len(b.members)
    let mut kills = 0
    let mut i = 0
    while (i < na and i < nb) {
        let am = list_get(a.members, i)
        let bm = list_get(b.members, i)
        let att = world_actor(w, am.actor)
        if (att.alive) {
            if (world_damage(w, bm.actor, 7)) {
                am.kills = am.kills + 1
                kills = kills + 1
            }
        }
        i = i + 1
    }
    if (kills > 0) {
        b.morale = b.morale - kills
    }
    return kills
}

fn main() -> Int {
    let scenarios = 300
    let ticks = 100
    let frames = scenarios * ticks

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let dt = 0.016
    let mut total_alive = 0
    let mut total_orders = 0
    let mut total_kills = 0
    let mut slot = 0

    let mut run = 0
    while (run < scenarios) {
        let w = world_create()
        let red = make_squad(0, 0.0, 0.0)
        let blue = make_squad(1, 100.0, 100.0)
        recruit(w, red, 400)
        recruit(w, blue, 400)

        let mut tick = 0
        while (tick < ticks) {
            let t0 = clock_gettime_nsec_np(4)
            let red_orders = plan_orders(w, red)
            let blue_orders = plan_orders(w, blue)
            let applied_r = apply_orders(w, red_orders, 1.0)
            let applied_b = apply_orders(w, blue_orders, 1.0)
            world_step(w, dt)
            let kills = resolve_combat(w, red, blue)
            let t1 = clock_gettime_nsec_np(4)

            total_orders = total_orders + applied_r + applied_b
            total_kills = total_kills + kills
            list_set(samples, slot, t1 - t0)
            slot = slot + 1
            tick = tick + 1
        }
        total_alive = total_alive + world_count_alive(w)
        run = run + 1
    }

    print("checksum alive ")
    println(total_alive)
    print("checksum orders ")
    println(total_orders)
    print("checksum kills ")
    println(total_kills)

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
