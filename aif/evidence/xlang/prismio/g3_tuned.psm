// G3 scene graph -- hand-tuned Prismio.
//
// The same tuning hand-tuned Rust applies (rust/g3_tuned.rs), and it is available
// here for the same reason: **the tree is built once and never changes shape, so
// the depth-first visit order is a constant.** It is computed once into `order`,
// and each frame becomes a flat pass over that array of indices. A node's parent
// always precedes it in that order, so reading the parent's already-updated world
// transform is exactly what the recursion was doing.
//
// What that removes is the recursion, the sibling-chain pointer walk, and a call
// per node per frame -- 1365 calls x 10000 frames. The arithmetic is the same
// arithmetic on the same values in the same order, which is why the checksums are
// identical to g3.psm and not merely close.
//
// `dfs_order` is still the recursion, run once outside the timed region. Writing
// it iteratively would need a stack, and the runtime has no `list_pop`; the
// recursion it replaces is the one that costs, not the one that builds the order.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> I64

struct Transform {
    px: Float,
    py: Float,
    pz: Float,
    sx: Float,
    sy: Float,
    sz: Float
}

struct Bounds {
    min_x: Float,
    min_y: Float,
    min_z: Float,
    max_x: Float,
    max_y: Float,
    max_z: Float
}

struct Node {
    local: Transform,
    world: Transform,
    bounds: Bounds,
    parent: Int,
    first_child: Int,
    next_sibling: Int,
    dirty: Bool
}

fn identity_transform() -> Transform {
    return Transform { px: 0.0, py: 0.0, pz: 0.0, sx: 1.0, sy: 1.0, sz: 1.0 }
}

fn unit_bounds() -> Bounds {
    return Bounds {
        min_x: 0.0, min_y: 0.0, min_z: 0.0,
        max_x: 1.0, max_y: 1.0, max_z: 1.0
    }
}

fn make_node(parent: Int, ox: Float) -> Node {
    let mut t = identity_transform()
    t.px = ox
    return Node {
        local: t,
        world: identity_transform(),
        bounds: unit_bounds(),
        parent: parent,
        first_child: 0 - 1,
        next_sibling: 0 - 1,
        dirty: true
    }
}

fn link_child(nodes: List<Node>, parent_idx: Int, child_idx: Int) {
    let p = list_get(nodes, parent_idx)
    if (p.first_child < 0) {
        p.first_child = child_idx
    } else {
        let mut sib = p.first_child
        let mut scanning = true
        while (scanning) {
            let s = list_get(nodes, sib)
            if (s.next_sibling < 0) {
                s.next_sibling = child_idx
                scanning = false
            } else {
                sib = s.next_sibling
            }
        }
    }
}

fn build_hierarchy(breadth: Int, depth: Int) -> List<Node> {
    let mut nodes: List<Node> = list_new()
    list_push(nodes, make_node(0 - 1, 0.0))

    let mut level = 0
    let mut level_start = 0
    let mut level_count = 1

    while (level < depth) {
        let next_start = list_len(nodes)
        let mut parent_off = 0
        while (parent_off < level_count) {
            let parent_idx = level_start + parent_off
            let mut b = 0
            let mut ox = 0.0
            while (b < breadth) {
                let child_idx = list_len(nodes)
                list_push(nodes, make_node(parent_idx, ox))
                link_child(nodes, parent_idx, child_idx)
                ox = ox + 1.0
                b = b + 1
            }
            parent_off = parent_off + 1
        }
        level_start = next_start
        level_count = list_len(nodes) - next_start
        level = level + 1
    }
    return nodes
}

// The visit order the recursion in g3.psm produces, flattened. Run once.
fn dfs_order(nodes: List<Node>, idx: Int, order: List<Int>) {
    list_push(order, idx)
    let n = list_get(nodes, idx)
    let mut c = n.first_child
    while (c >= 0) {
        dfs_order(nodes, c, order)
        let cn = list_get(nodes, c)
        c = cn.next_sibling
    }
}

// The frame. A parent precedes its children in `order`, so `world` is already
// the updated one by the time a child reads it -- the invariant that makes the
// flattening exact rather than approximate.
fn propagate_flat(nodes: List<Node>, order: List<Int>) -> Int {
    let count = list_len(order)
    let mut k = 0
    while (k < count) {
        let n = list_get(nodes, list_get(order, k))
        let mut ox = 0.0
        let mut oy = 0.0
        let mut oz = 0.0
        if (n.parent >= 0) {
            let p = list_get(nodes, n.parent)
            ox = p.world.px
            oy = p.world.py
            oz = p.world.pz
        }
        n.world.px = n.local.px + ox
        n.world.py = n.local.py + oy
        n.world.pz = n.local.pz + oz
        n.dirty = false
        k = k + 1
    }
    return count
}

fn count_visible(nodes: List<Node>, limit: Float) -> Int {
    let total = list_len(nodes)
    let mut visible = 0
    let mut i = 0
    while (i < total) {
        let n = list_get(nodes, i)
        if (n.world.px < limit and n.world.py < limit and n.world.pz < limit) {
            visible = visible + 1
        }
        i = i + 1
    }
    return visible
}

fn main() -> Int {
    let frames = 10000
    let nodes = build_hierarchy(4, 5)

    let mut order: List<Int> = list_new_with_capacity(list_len(nodes))
    dfs_order(nodes, 0, order)

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut visited = 0
    let mut visible = 0
    let mut frame = 0
    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)
        visited = propagate_flat(nodes, order)
        visible = count_visible(nodes, 1000.0)
        let t1 = clock_gettime_nsec_np(4)
        list_set(samples, frame, (t1 - t0) as Int)
        frame = frame + 1
    }

    print("checksum nodes ")
    println(list_len(nodes))
    print("checksum visited ")
    println(visited)
    print("checksum visible ")
    println(visible)

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
