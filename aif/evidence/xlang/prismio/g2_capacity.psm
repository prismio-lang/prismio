// G2 frame loop -- Prismio with `list_new_with_capacity`. The tuned cell.
//
// Identical to g2.psm except that `cull` pre-sizes its command list to the
// scene's length instead of growing it from 4 by doubling. Nothing else changes:
// same allocations, same checksums, same tiers.
//
// The measurement it exists for. `cull` builds a fresh ~501-element list every
// frame for 20 000 frames, and each one paid seven reallocations and 508 pointer
// copies. This is the second half of the g2 gap -- the first is the 10.02M
// individually-malloc'd DrawCmd records, which no library call can remove.
//
// Unlike `region` (g2_region.psm), this is a library call and not an annotation:
// the argument is a value rather than a fact the analysis must trust, and a wrong
// hint costs a reallocation rather than correctness.

extern fn clock_gettime_nsec_np(clk: Int) -> Int

struct DrawCmd {
    mesh_id: Int,
    material_id: Int,
    depth: Float,
    visible: Bool
}

struct Renderable {
    mesh_id: Int,
    material_id: Int,
    x: Float,
    y: Float,
    z: Float,
    radius: Float
}

struct Stats {
    submitted: Int,
    culled: Int
}

fn build_scene(count: Int) -> List<Renderable> {
    let mut scene: List<Renderable> = list_new()
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(scene, Renderable {
            mesh_id: i,
            material_id: i,
            x: f,
            y: f,
            z: f,
            radius: 1.0
        })
        f = f + 1.0
        i = i + 1
    }
    return scene
}

// Allocates a fresh command list every call. Returns it, so it escapes to the
// caller -- but only as far as the caller's frame scope.
fn cull(scene: List<Renderable>, near: Float, far: Float) -> List<DrawCmd> {
    // The one difference from g2.psm. At most one command per scene entry, so
    // the exact count is knowable without a second pass.
    let mut cmds: List<DrawCmd> = list_new_with_capacity(list_len(scene))
    let n = list_len(scene)
    let mut i = 0
    while (i < n) {
        let r = list_get(scene, i)
        if (r.z >= near and r.z <= far) {
            list_push(cmds, DrawCmd {
                mesh_id: r.mesh_id,
                material_id: r.material_id,
                depth: r.z,
                visible: true
            })
        }
        i = i + 1
    }
    return cmds
}

// Consumes the batch without retaining anything from it. A borrow, in FFI terms.
fn submit(cmds: List<DrawCmd>) -> Int {
    let n = list_len(cmds)
    let mut drawn = 0
    let mut i = 0
    while (i < n) {
        let c = list_get(cmds, i)
        if (c.visible) {
            drawn = drawn + 1
        }
        i = i + 1
    }
    return drawn
}

fn main() -> Int {
    let frames = 20000
    let scene = build_scene(1000)

    let mut samples: List<Int> = list_new()
    let mut g = 0
    while (g < frames) {
        list_push(samples, 0)
        g = g + 1
    }

    let mut totals = Stats { submitted: 0, culled: 0 }
    let mut frame = 0

    while (frame < frames) {
        let t0 = clock_gettime_nsec_np(4)
        // Everything below this line is transient: allocated this frame,
        // dead by the next. The whole body is one implicit region.
        let cmds = cull(scene, 0.0, 500.0)
        let drawn = submit(cmds)
        let t1 = clock_gettime_nsec_np(4)
        totals.submitted = totals.submitted + drawn
        totals.culled = totals.culled + (1000 - drawn)
        list_set(samples, frame, t1 - t0)
        frame = frame + 1
    }

    print("checksum submitted ")
    println(totals.submitted)
    print("checksum culled ")
    println(totals.culled)

    let mut j = 0
    while (j < frames) {
        print("frame_ns ")
        println(list_get(samples, j))
        j = j + 1
    }
    return 0
}
