import std.io
import std.string

extern fn clock_gettime_nsec_np(clk: Int) -> I64

fn run(reps: Int) -> Int {
    let mut sum = 0
    let mut k = 0
    while (k < reps) {
        let s = strFromInt(k * 1103515245)
        sum = sum + (__builtin_string_byte_at(s, 0) as Int) + strLength(s)
        k = k + 1
    }
    return sum
}

fn main() -> Int {
    if (run(2000) < 0) { return 1 }
    let t0 = clock_gettime_nsec_np(4)
    let sum = run(2000000)
    let t1 = clock_gettime_nsec_np(4)
    print("checksum=")
    println(strFromInt(sum))
    print("elapsed_ns=")
    println(t1 - t0)
    return 0
}
