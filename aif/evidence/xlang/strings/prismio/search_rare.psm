import std.io
import std.string

extern fn clock_gettime_nsec_np(clk: Int) -> I64

fn run(hay: String, needle: String, n: Int, reps: Int) -> Int {
    let mut sum = 0
    let mut k = 0
    while (k < reps) {
        __builtin_string_put_byte(hay, k % n, (97 + (k % 10)) as Char)
        __builtin_string_put_byte(needle, 0, (98 + (k % 5)) as Char)
        sum = sum + strIndexOf(hay, needle)
        k = k + 1
    }
    return sum
}

fn main() -> Int {
    let hay = strRepeat("abcdefghij", 4000)
    let needle = strRepeat("a", 4)
    __builtin_string_put_byte(needle, 1, 'j')
    __builtin_string_put_byte(needle, 2, 'i')
    let n = strLength(hay)
    if (run(hay, needle, n, 1000) > 0) { return 1 }
    let t0 = clock_gettime_nsec_np(4)
    let sum = run(hay, needle, n, 200000)
    let t1 = clock_gettime_nsec_np(4)
    print("checksum=")
    println(strFromInt(sum))
    print("elapsed_ns=")
    println(t1 - t0)
    return 0
}
