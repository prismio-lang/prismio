import std.io
import std.string

extern fn clock_gettime_nsec_np(clk: Int) -> I64

fn run(a: String, b: String, n: Int, reps: Int) -> Int {
    let mut sum = 0
    let mut k = 0
    while (k < reps) {
        let at = k % n
        __builtin_string_put_byte(a, at, (97 + (k % 26)) as Char)
        let joined = strConcat(a, b)
        sum = sum + (__builtin_string_byte_at(joined, at) as Int)
        sum = sum + (__builtin_string_byte_at(joined, n + at) as Int)
        k = k + 1
    }
    return sum
}

fn main() -> Int {
    let a = strRepeat("abcdefghij", 2000)
    let b = strRepeat("klmnopqrst", 2000)
    let n = strLength(a)
    if (run(a, b, n, 2000) < 0) { return 1 }
    let t0 = clock_gettime_nsec_np(4)
    let sum = run(a, b, n, 400000)
    let t1 = clock_gettime_nsec_np(4)
    print("checksum=")
    println(strFromInt(sum))
    print("elapsed_ns=")
    println(t1 - t0)
    return 0
}
