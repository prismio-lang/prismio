+
+private fn irIVStepChain(head: Ptr, name: String) -> String {
+    let mut p = head
+    while (nodeExists(p)) {
+        let n = ptr_to_node(p)
+        let one = irIVStepText(node_to_ptr(n), name)
+        if (one.equals("") == false) { return one }
+        p = n.next
