+    if (irRangeMatchChain(n.child1, iv, bodyPtr) == false) { return false }
+    if (irRangeMatchChain(n.child2, iv, bodyPtr) == false) { return false }
+    return irRangeMatchChain(n.child3, iv, bodyPtr)
+}
+
+private fn irRangeMatchChain(head: Ptr, iv: String, bodyPtr: Ptr) -> Bool {
+    let mut p = head
+    while (nodeExists(p)) {
+        let n = ptr_to_node(p)
+        if (irRangeMatchAll(node_to_ptr(n), iv, bodyPtr) == false) { return false }
+        p = n.next
+    }
+    return true
+}
+
+// 1 for a bare `iv`, 2 for `iv + E`, 3 for `iv - E`, 0 for anything else.
+private fn irIndexOffsetSign(idx: ASTNode, iv: String, bodyPtr: Ptr) -> Int {
+    if (idx.kind == NodeKind.IDENTIFIER_EXPR) {
+        if (idx.s1.equals(iv)) { return 1 }
+        return 0
+    }
+    if (idx.kind != NodeKind.BINARY_EXPR) { return 0 }
+    if (nodeIsNull(idx.child1) or nodeIsNull(idx.child2)) { return 0 }
+    let lhs = ptr_to_node(idx.child1)
+    if (lhs.kind != NodeKind.IDENTIFIER_EXPR) { return 0 }
+    if (lhs.s1.equals(iv) == false) { return 0 }
+    if (irIsInvariantTerm(ptr_to_node(idx.child2), iv, bodyPtr) == false) { return 0 }
+    if (idx.s1.equals("+")) { return 2 }
+    if (idx.s1.equals("-")) { return 3 }
+    return 0
+}
