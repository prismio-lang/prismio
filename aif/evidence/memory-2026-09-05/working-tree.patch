+    // seen at an access is not bracketed by the condition and that update alone.
+    if (irCountAssigns(bodyPtr, iv) != 1) { return false }
+    if (irIVStepText(bodyPtr, iv).equals("")) { return false }
+    if (irIVUpdateIsLast(bodyPtr, iv) == false) { return false }
+
