+// whole point is to express an index *relative* to it.
+private fn irIsInvariantTerm(n: ASTNode, iv: String, bodyPtr: Ptr) -> Bool {
+    if (n.kind == NodeKind.LITERAL_EXPR) { return n.i1 == TokenType.NUMBER_LITERAL }
+    if (n.kind != NodeKind.IDENTIFIER_EXPR) { return false }
+    if (n.s1.equals(iv)) { return false }
+    return chainAssignsName(bodyPtr, n.s1) == false
