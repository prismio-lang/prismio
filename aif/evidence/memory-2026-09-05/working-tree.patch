+            if (rhs.kind != NodeKind.BINARY_EXPR) { return "" }
+            if (rhs.s1.equals("+") == false and rhs.s1.equals("-") == false) { return "" }
+            if (nodeIsNull(rhs.child1) or nodeIsNull(rhs.child2)) { return "" }
+            let lhs = ptr_to_node(rhs.child1)
+            let amount = ptr_to_node(rhs.child2)
+            if (lhs.kind != NodeKind.IDENTIFIER_EXPR) { return "" }
+            if (lhs.s1.equals(name) == false) { return "" }
+            if (amount.kind != NodeKind.LITERAL_EXPR) { return "" }
+            if (amount.i1 != TokenType.NUMBER_LITERAL) { return "" }
