+// Fold `0 <= lowest index && highest index < len` for one read into the slot.
+private fn irEmitOneRangeGuard(n: ASTNode, iv: String, bodyPtr: Ptr,
+                               lo: String, hi: String, slot: String) {
+    let listNode = ptr_to_node(n.child2)
+    let idx = ptr_to_node(listNode.next)
+    let sign = irIndexOffsetSign(idx, iv, bodyPtr)
+    let mut low = strClone(lo)
+    let mut high = strClone(hi)
+    if (sign != 1) {
+        let off = ir_get_temp_name(
+            ir_sext("i32", generateExpression(ptr_to_node(idx.child2)), "i64"))
+        let offAgain = strClone(off)
+        if (sign == 2) {
+            low = ir_get_temp_name(ir_add("i64", low, off))
+            high = ir_get_temp_name(ir_add("i64", high, offAgain))
+        } else {
+            low = ir_get_temp_name(ir_sub("i64", low, off))
+            high = ir_get_temp_name(ir_sub("i64", high, offAgain))
+        }
+    }
+    ir_call_begin()
+    ir_call_arg("ptr", generateExpression(listNode))
+    let len = ir_get_temp_name(ir_call_end("i32", "list_len"))
+    let len64 = ir_get_temp_name(ir_sext("i32", len, "i64"))
+    let lowOk = ir_get_temp_name(ir_icmp_sge("i64", low, "0"))
+    let highOk = ir_get_temp_name(ir_icmp_slt("i64", high, len64))
+    let both = ir_get_temp_name(ir_and("i1", lowOk, highOk))
+    let prev = ir_get_temp_name(ir_load("i1", slot))
+    ir_store("i1", ir_get_temp_name(ir_and("i1", prev, both)), slot)
+}
+
+private fn irEmitRangeGuards(nodePtr: Ptr, iv: String, bodyPtr: Ptr,
+                             lo: String, hi: String, slot: String) {
+    if (nodeIsNull(nodePtr)) { return }
+    let n = ptr_to_node(nodePtr)
+    if (n.kind == NodeKind.CALL_EXPR) {
+        let mut fname = ""
+        if (nodeExists(n.child1)) { fname = ptr_to_node(n.child1).s1 }
+        if (flatGetStride(n, fname) > 0 or flatSetScalarStride(n, fname) > 0) {
+            irEmitOneRangeGuard(n, iv, bodyPtr, lo, hi, slot)
