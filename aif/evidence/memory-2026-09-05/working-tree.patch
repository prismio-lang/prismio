+}
+
+private fn irEmitRangeChain(head: Ptr, iv: String, bodyPtr: Ptr,
+                            lo: String, hi: String, slot: String) {
+    let mut p = head
+    while (nodeExists(p)) {
+        let n = ptr_to_node(p)
+        irEmitRangeGuards(node_to_ptr(n), iv, bodyPtr, lo, hi, slot)
+        p = n.next
+    }
+}
