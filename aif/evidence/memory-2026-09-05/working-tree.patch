+// Whether the loop's sole update of `iv` is the body's last statement.
+//
+// **This is what makes the range exact rather than useless.** With the update
+// last, every access sees the value the condition just admitted, so the range is
+// [bound, init]. Widening by a step to allow the update anywhere instead costs a
+// bound of `weight - 1` on knapsack's `at - weight` read, whose lower conjunct
+// `>= 0` is then false at run time -- a guard that never fires, measured at
+// 1.29x for the versioning it still pays for.
+private fn irIVUpdateIsLast(bodyPtr: Ptr, iv: String) -> Bool {
+    if (nodeIsNull(bodyPtr)) { return false }
+    let body = ptr_to_node(bodyPtr)
+    let mut p = body.child1
+    if (nodeExists(p) == false) { return false }
+    let mut last = p
+    while (nodeExists(p)) {
+        last = p
+        p = ptr_to_node(p).next
+    }
+    let n = ptr_to_node(last)
+    if (n.kind != NodeKind.ASSIGNMENT_STATEMENT) { return false }
+    if (nodeIsNull(n.child1)) { return false }
+    let target = ptr_to_node(n.child1)
+    if (target.kind != NodeKind.IDENTIFIER_EXPR) { return false }
+    return target.s1.equals(iv)
+}
+
+// Whether every guarded read in this loop indexes affinely off `iv`: `iv`,
+// `iv - E` or `iv + E` for an E the loop cannot change. All-or-nothing, like the
+// representation guard above -- one read this cannot place leaves the whole loop
+// checked, because the guard is a single `i1` and a partially true one is worse
+// than none.
+private fn irRangeMatchAll(nodePtr: Ptr, iv: String, bodyPtr: Ptr) -> Bool {
+    if (nodeIsNull(nodePtr)) { return true }
+    let n = ptr_to_node(nodePtr)
+    if (n.kind == NodeKind.CALL_EXPR) {
+        let mut fname = ""
+        if (nodeExists(n.child1)) { fname = ptr_to_node(n.child1).s1 }
+        if (flatGetStride(n, fname) > 0 or flatSetScalarStride(n, fname) > 0) {
+            let listNode = ptr_to_node(n.child2)
+            if (nodeIsNull(listNode.next)) { return false }
+            if (irIndexOffsetSign(ptr_to_node(listNode.next), iv, bodyPtr) == 0) {
+                return false
+            }
+            // **The length is read once, in the preheader, so the receiver has
+            // to still name the same list at every access.** The representation
+            // guard tolerates a re-bound receiver -- it would only pick the
+            // wrong arm -- but a stale length here is an out-of-bounds store.
+            // A plain name the body never assigns is the only shape admitted;
+            // `w.items` is declined because an assignment through a field is not
+            // what irCountAssigns looks at.
+            if (listNode.kind != NodeKind.IDENTIFIER_EXPR) { return false }
+            if (chainAssignsName(bodyPtr, listNode.s1)) { return false }
+        }
