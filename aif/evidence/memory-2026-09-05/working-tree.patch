+// HotSpot's loop predication, with the versioned slow loop standing in for
+// deoptimisation. Folds "every index this loop forms is in range" into the same
+// preheader `i1` the representation guard uses, so the true version can drop the
+// per-access bounds check -- and dropping it is what makes the element load
+// unconditional, which is the only reason LICM could not hoist `data`. The false
+// version is unchanged, so `list_get` stays total: nothing here can make an
+// out-of-range read do anything other than what it does today.
+//
+// Everything is computed in i64 so the widening cannot wrap a 32-bit `Int`.
+private fn generateLoopRangeGuards(condPtr: Ptr, bodyPtr: Ptr, slot: String) -> Bool {
+    if (nodeIsNull(condPtr) or nodeIsNull(bodyPtr)) { return false }
+    let cond = ptr_to_node(condPtr)
+    if (cond.kind != NodeKind.BINARY_EXPR) { return false }
+    let mut decreasing = false
+    if (cond.s1.equals(">=") or cond.s1.equals(">")) {
+        decreasing = true
+    } else if (cond.s1.equals("<=") == false and cond.s1.equals("<") == false) {
+        return false
+    }
+    if (nodeIsNull(cond.child1) or nodeIsNull(cond.child2)) { return false }
+    let ivNode = ptr_to_node(cond.child1)
+    if (ivNode.kind != NodeKind.IDENTIFIER_EXPR) { return false }
+    let iv = ivNode.s1
