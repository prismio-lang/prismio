+// How many times the body assigns `name`.
+private fn irCountAssigns(nodePtr: Ptr, name: String) -> Int {
+    if (nodeIsNull(nodePtr)) { return 0 }
+    let n = ptr_to_node(nodePtr)
+    let mut found = 0
+    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
+        let target = ptr_to_node(n.child1)
+        if (target.kind == NodeKind.IDENTIFIER_EXPR and target.s1.equals(name)) {
+            found = 1
+        }
+    }
+    return found + irCountAssignsChain(n.child1, name)
+                 + irCountAssignsChain(n.child2, name)
+                 + irCountAssignsChain(n.child3, name)
+}
+
+private fn irCountAssignsChain(head: Ptr, name: String) -> Int {
+    let mut total = 0
+    let mut p = head
+    while (nodeExists(p)) {
+        let n = ptr_to_node(p)
+        total = total + irCountAssigns(node_to_ptr(n), name)
+        p = n.next
+    }
+    return total
+}
