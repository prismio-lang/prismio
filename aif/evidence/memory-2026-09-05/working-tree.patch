+    // range needs no symbolic start: it is the variable itself, read here.
+    let init = ir_get_temp_name(ir_sext("i32", generateExpression(ivNode), "i64"))
+    let bound = ir_get_temp_name(ir_sext("i32", generateExpression(boundNode), "i64"))
+
+    // The update is the body's last statement, so every access sees a value the
+    // condition admitted: exactly [bound, init] going down, [init, bound] going
+    // up. `>` and `<` are covered by using the bound itself, which is one step
+    // stricter than the true extreme and so can only decline, never admit.
+    let mut lo = ""
+    let mut hi = ""
+    if (decreasing) {
+        lo = strClone(bound)
+        hi = strClone(init)
+    } else {
+        lo = strClone(init)
+        hi = strClone(bound)
+    }
+    irEmitRangeGuards(bodyPtr, iv, bodyPtr, lo, hi, slot)
+    return true
+}
