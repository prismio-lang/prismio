// A long view returned from a function that constructs its own backing buffer.
import std.io
import std.string

fn makeView() -> String {
    let owner = strRepeat("abcdefgh", 8)
    return strSubstring(owner, 1, 20)
}

fn main() -> Int {
    let view = makeView()
    if (view.equals("bcdefghabcdefghabcde") == false) { return 1 }
    if (strLength(view) != 20) { return 1 }
    println("PASS: returned view")
    return 0
}
