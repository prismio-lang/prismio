// Three iterations under ordinary wrapping Int arithmetic. The negative
// indices must take list_get's total fallback and contribute zero.
import std.io

fn main() -> Int {
    let values: List<Int> = list_new_with_capacity(4)
    list_push(values, 1)
    list_push(values, 2)
    list_push(values, 3)
    list_push(values, 4)
    let mut at = 1
    let mut total = 0
    while (at < 3) {
        total = total + list_get(values, at)
        at = at + 2147483647
    }
    println(total)
    if (total != 2) { return 1 }
    return 0
}
