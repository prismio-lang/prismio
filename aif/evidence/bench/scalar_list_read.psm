// Scalar-inline storage read discriminator.
//
// The timed region performs exactly 20,000,000 sequential list_get calls. The
// population pass is outside it so this measures the read lowering rather than
// growth or list_push_inline_scalar. Keep the checksum live: without it an
// optimiser is entitled to delete the loop this file exists to measure.

import std.io
extern fn clock_gettime_nsec_np(clk: Int) -> I64

fn main() -> Int {
    let count = 20000000
    let values: List<Int> = list_new_with_capacity(count)
    let mut i = 0
    while (i < count) {
        list_push(values, (i % 251) - 125)
        i = i + 1
    }

    let t0 = clock_gettime_nsec_np(4)
    let mut checksum = 0
    i = 0
    while (i < list_len(values)) {
        checksum = checksum + list_get(values, i)
        i = i + 1
    }
    let t1 = clock_gettime_nsec_np(4)

    print("checksum ")
    println(checksum)
    print("elapsed_ns ")
    println((t1 - t0) as Int)
    return 0
}
