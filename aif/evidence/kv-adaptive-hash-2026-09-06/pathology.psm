import common
import std.map

fn run(label: String, stride: Int, n: Int) {
    let t0 = benchNow()
    let m: Map<Int, Int> = mapNew<Int, Int>()
    let mut i = 0
    while (i < n) {
        mapSet(m, i * stride, i)
        i = i + 1
    }
    let mut acc = 0
    let mut k = 0
    while (k < n) {
        acc = acc + mapGetOr(m, k * stride, 0 - 1)
        k = k + 1
    }
    let t1 = benchNow()
    benchPrint(label)
    benchPrint(" sum=")
    benchPrintln(acc)
    benchPrint("    us=")
    benchPrintln(((t1 - t0) / 1000) as Int)
}

fn main() -> Int {
    let n = 40000
    run("dense        ", 1, n)
    run("stride 64    ", 64, n)
    run("stride 65536 ", 65536, n)
    run("stride 65537 ", 65537, n)
    run("stride 131072", 131072, n)
    return 0
}
