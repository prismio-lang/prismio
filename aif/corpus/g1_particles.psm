// G1 -- particle system. The X3 shape: a wide component, update loops that
// touch a narrow slice of it.
//
// This is the layout discriminator. `integrate` touches 6 of 12 fields and
// `fade` touches 2 of 12, so an AoS layout streams the whole 12-field record
// for both while SoA streams only what is read. It is also the allocation shape
// a particle system actually has: one bulk container, filled once, updated every
// frame, never individually freed.

struct Particle {
    px: Float,
    py: Float,
    pz: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    r: Float,
    g: Float,
    b: Float,
    a: Float,
    life: Float,
    size: Float
}

fn spawn_particle(f: Float) -> Particle {
    return Particle {
        px: f,
        py: f,
        pz: 0.0,
        vx: 1.0,
        vy: 2.0,
        vz: 0.0,
        r: 1.0,
        g: 1.0,
        b: 1.0,
        a: 1.0,
        life: 100.0,
        size: 1.0
    }
}

fn build_system(count: Int) -> List<Particle> {
    let mut ps: List<Particle> = list_new()
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        list_push(ps, spawn_particle(f))
        f = f + 1.0
        i = i + 1
    }
    return ps
}

// Touches 6 of 12 fields: position and velocity only.
fn integrate(ps: List<Particle>, dt: Float) {
    let n = list_len(ps)
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        p.px = p.px + p.vx * dt
        p.py = p.py + p.vy * dt
        p.pz = p.pz + p.vz * dt
        i = i + 1
    }
}

// Touches 2 of 12 fields. The strongest SoA case in the corpus.
fn fade(ps: List<Particle>, dt: Float) {
    let n = list_len(ps)
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        p.life = p.life - dt
        p.a = p.life * 0.01
        i = i + 1
    }
}

// Reads 1 of 12 fields to produce a scalar -- the pure-streaming case.
fn count_alive(ps: List<Particle>) -> Int {
    let n = list_len(ps)
    let mut alive = 0
    let mut i = 0
    while (i < n) {
        let p = list_get(ps, i)
        if (p.life > 0.0) {
            alive = alive + 1
        }
        i = i + 1
    }
    return alive
}

fn main() -> Int {
    let ps = build_system(2000)
    let dt = 0.016

    let mut frame = 0
    while (frame < 60) {
        integrate(ps, dt)
        fade(ps, dt)
        frame = frame + 1
    }

    let alive = count_alive(ps)
    print("alive: ")
    println_int(alive)
    return 0
}
