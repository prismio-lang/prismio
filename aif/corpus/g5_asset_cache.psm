// G5 -- engine-layer asset system with real sharing.
//
// This is the program written specifically to exercise T3. Engine data is the
// place shared ownership actually lives: 2000 entities referencing 20 meshes and
// 12 materials, none of which any entity owns. RESULTS-L0 6 flagged that the
// rest of the corpus is single-ownership and therefore never tests the
// reference-counted path at all.
//
// It is written the way engines are actually written: assets live in a cache,
// and entities reference them by *handle* -- an index -- not by pointer. That is
// not a workaround for what today's Prismio can express. It is the standard
// solution, for the same reasons AIF requires handles (SPEC 11 item 5):
// relocatable, serialisable, stable across streaming and eviction, and
// cache-friendly.
//
// The manual `ref_count` field on each asset is the point of the program. It is
// what an engine programmer writes by hand today, and it is exactly the
// bookkeeping AIF's T3 tier is supposed to make unnecessary.

import std.io
struct Mesh {
    vertex_count: Int,
    index_count: Int,
    bounds_radius: Float,
    lod_levels: Int,
    ref_count: Int,
    resident: Bool
}

struct Material {
    shader_id: Int,
    base_r: Float,
    base_g: Float,
    base_b: Float,
    roughness: Float,
    metallic: Float,
    texture: Int,
    ref_count: Int
}

struct Texture {
    width: Int,
    height: Int,
    format: Int,
    mip_levels: Int,
    bytes: Int,
    ref_count: Int,
    resident: Bool
}

struct AssetCache {
    meshes: Vec<Mesh>,
    materials: Vec<Material>,
    textures: Vec<Texture>,
    resident_bytes: Int,
    budget_bytes: Int
}

// Entities hold handles, not references. Many-to-one by construction.
struct Entity {
    mesh: Int,
    material: Int,
    x: Float,
    y: Float,
    z: Float,
    visible: Bool
}

struct Scene {
    entities: Vec<Entity>,
    cache: AssetCache,
    draw_calls: Int,
    batches: Int
}

fn make_cache(budget: Int) -> AssetCache {
    let m: Vec<Mesh> = []
    let mt: Vec<Material> = []
    let tx: Vec<Texture> = []
    return AssetCache {
        meshes: m,
        materials: mt,
        textures: tx,
        resident_bytes: 0,
        budget_bytes: budget
    }
}

fn load_texture(cache: AssetCache, w: Int, h: Int) -> Int {
    let handle = cache.textures.length
    let bytes = w * h * 4
    cache.textures.push(Texture {
        width: w,
        height: h,
        format: 1,
        mip_levels: 8,
        bytes: bytes,
        ref_count: 0,
        resident: true
    })
    cache.resident_bytes = cache.resident_bytes + bytes
    return handle
}

fn load_material(cache: AssetCache, shader: Int, tex: Int, rough: Float) -> Int {
    let handle = cache.materials.length
    cache.materials.push(Material {
        shader_id: shader,
        base_r: 1.0,
        base_g: 1.0,
        base_b: 1.0,
        roughness: rough,
        metallic: 0.0,
        texture: tex,
        ref_count: 0
    })
    return handle
}

fn load_mesh(cache: AssetCache, verts: Int) -> Int {
    let handle = cache.meshes.length
    let bytes = verts * 32
    cache.meshes.push(Mesh {
        vertex_count: verts,
        index_count: verts * 3,
        bounds_radius: 1.0,
        lod_levels: 4,
        ref_count: 0,
        resident: true
    })
    cache.resident_bytes = cache.resident_bytes + bytes
    return handle
}

// Manual reference counting -- the bookkeeping AIF's T3 exists to delete.
fn acquire(cache: AssetCache, mesh_h: Int, mat_h: Int) {
    let m = cache.meshes[mesh_h]
    m.ref_count = m.ref_count + 1
    let mt = cache.materials[mat_h]
    mt.ref_count = mt.ref_count + 1
    let t = cache.textures[mt.texture]
    t.ref_count = t.ref_count + 1
}

fn release(cache: AssetCache, mesh_h: Int, mat_h: Int) {
    let m = cache.meshes[mesh_h]
    m.ref_count = m.ref_count - 1
    if (m.ref_count <= 0) {
        m.resident = false
    }
    let mt = cache.materials[mat_h]
    mt.ref_count = mt.ref_count - 1
    let t = cache.textures[mt.texture]
    t.ref_count = t.ref_count - 1
    if (t.ref_count <= 0) {
        t.resident = false
    }
}

fn build_assets(cache: AssetCache) {
    let mut i = 0
    while (i < 8) {
        load_texture(cache, 512, 512)
        i = i + 1
    }
    let mut j = 0
    while (j < 12) {
        load_material(cache, j, j - (j / 8) * 8, 0.5)
        j = j + 1
    }
    let mut k = 0
    while (k < 20) {
        load_mesh(cache, 1000 + k * 100)
        k = k + 1
    }
}

// 2000 entities over 20 meshes and 12 materials: every asset is referenced by
// roughly 100 entities. This is the sharing the tier model has to account for.
fn populate(scene: Scene, count: Int) {
    let mut i = 0
    let mut f = 0.0
    while (i < count) {
        let mesh_h = i - (i / 20) * 20
        let mat_h = i - (i / 12) * 12
        scene.entities.push(Entity {
            mesh: mesh_h,
            material: mat_h,
            x: f,
            y: f,
            z: f,
            visible: true
        })
        acquire(scene.cache, mesh_h, mat_h)
        f = f + 1.0
        i = i + 1
    }
}

// Batched draw submission: group by material, resolve handles once per batch.
// This is the access pattern that decides whether Material wants AoS or SoA --
// it reads 2 of 8 fields, over a small array, many times per frame.
fn render_batched(scene: Scene) -> Int {
    let n = scene.entities.length
    let mat_count = scene.cache.materials.length
    let mut submitted = 0
    let mut batches = 0

    let mut m = 0
    while (m < mat_count) {
        let mat = scene.cache.materials[m]
        let mut batch_size = 0
        let mut i = 0
        while (i < n) {
            let e = scene.entities[i]
            if (e.visible and e.material == m) {
                let mesh = scene.cache.meshes[e.mesh]
                if (mesh.resident) {
                    submitted = submitted + 1
                    batch_size = batch_size + 1
                }
            }
            i = i + 1
        }
        if (batch_size > 0) {
            batches = batches + 1
        }
        m = m + 1
    }

    scene.draw_calls = submitted
    scene.batches = batches
    return submitted
}

// Eviction pass: streams out anything nothing references. The lifecycle a real
// cache has, and the one manual refcounting exists to drive.
fn evict_unused(cache: AssetCache) -> Int {
    let mut evicted = 0
    let n = cache.textures.length
    let mut i = 0
    while (i < n) {
        let t = cache.textures[i]
        if (t.ref_count <= 0 and t.resident) {
            t.resident = false
            cache.resident_bytes = cache.resident_bytes - t.bytes
            evicted = evicted + 1
        }
        i = i + 1
    }
    return evicted
}

fn main() -> Int {
    let cache = make_cache(64 * 1024 * 1024)
    build_assets(cache)

    let ents: Vec<Entity> = []
    let scene = Scene {
        entities: ents,
        cache: cache,
        draw_calls: 0,
        batches: 0
    }

    populate(scene, 2000)

    let mut frame = 0
    let mut total = 0
    while (frame < 30) {
        total = total + render_batched(scene)
        frame = frame + 1
    }

    let mut i = 0
    while (i < 500) {
        let e = scene.entities[i]
        release(scene.cache, e.mesh, e.material)
        e.visible = false
        i = i + 1
    }
    let evicted = evict_unused(scene.cache)

    print("entities: ")
    println(scene.entities.length)
    print("submitted: ")
    println(total)
    print("batches: ")
    println(scene.batches)
    print("evicted: ")
    println(evicted)
    return 0
}
