// A program may define a name the standard library also defines.
//
// **This used to be a duplicate definition, not an overload.** A method is a
// free function whose first parameter is the receiver, so `impl Char { fn
// isDigit(self) }` in std.string declares `isDigit(Char)` globally -- and a
// program with its own `isDigit(Char)` did not compile. The symbol is qualified
// by the declaring module now when it would otherwise collide, and overload
// resolution prefers the caller's own world.
//
// The other half of the rule is what this fixture mostly checks: the operators
// still mean the library's functions. `+` lowers to `concat`, and a program that
// defines `concat(String, String)` must not thereby redefine `+`.

import std.io
import std.string

fn isDigit(c: Char) -> Bool {
    return c == '7'
}

fn trim(s: String) -> String {
    return "TRIMMED"
}

fn concat(a: String, b: String) -> String {
    return "MINE"
}

fn compare(a: String, b: String) -> Int {
    return 42
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    // The program's own definitions, by their own names.
    if (isDigit('7') == false) { return fail("the program's isDigit") }
    if (isDigit('3')) { return fail("the program's isDigit, not the library's") }
    if (trim("  x  ").equals("TRIMMED") == false) { return fail("the program's trim") }
    if (concat("a", "b").equals("MINE") == false) { return fail("the program's concat") }
    if (compare("a", "b") != 42) { return fail("the program's compare") }

    // The library's, by its prefixed spelling, which is what the prefix is for.
    if (strTrim("  x  ").equals("x") == false) { return fail("the library's strTrim") }

    // **The operators are bound to the library.** Each of these lowers to one of
    // the five functions this program has shadowed.
    if (("a" + "b").equals("ab") == false) { return fail("`+` is the library's concat") }
    if (("abc"[1..3]).equals("bc") == false) { return fail("a slice is the library's") }
    if ("abc"[0] != 'a') { return fail("an index is the library's charAt") }
    if (("abc" == "abc") == false) { return fail("`==` is the library's equality") }
    if ("a" < "b" == false) { return fail("`<` is the library's compare") }

    // `for c in s` lowers to strLength, which is shadowable in principle and
    // bound the same way.
    let letters = "abcd"
    let mut seen = 0
    for c in letters {
        seen = seen + 1
    }
    if (seen != 4) { return fail("`for ... in` is the library's strLength") }

    println("test_138 ok")
    return 0
}
