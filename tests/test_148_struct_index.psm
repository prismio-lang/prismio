// `x[i]` on a struct is `at(x, i)`.
//
// The same rewrite String has had since v0.1 3.6, where `s[i]` becomes
// `charAt(s, i)`, generalised to any type that declares `at`. It is what lets a
// type expose an indexed view of something that is not a collection --
// `process.args[0]` reads `argv` through two externs and builds no list -- and it
// costs one branch in `semaExpr`'s INDEX_EXPR arm.
//
// What is pinned here: the rewrite reaches an ordinary `impl` method, picks the
// right overload when two types both declare `at`, composes with the property
// rewrite and with a field read on the way in, and does not disturb the four
// built-in indexable kinds.

import std.io
import std.string

struct Squares {
    scale: Int
}

struct Letters {
}

// A struct whose only reason to exist is to be reached through a field, as
// `process.args` is.
struct Holder {
    letters: Letters
}

let held: Holder

impl Squares {
    fn at(self, index: Int) -> Int { return self.scale * index * index }
    fn count(self) -> Int { return 4 }
}

impl Letters {
    fn at(self, index: Int) -> String { return "abcdef".slice(index, index + 1) }
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let squares = Squares { scale: 2 }
    if (squares[3] != 18) { return fail("x[i] did not reach `at`") }
    if (squares[0] != 0) { return fail("x[0] did not reach `at`") }

    // The index is an expression, evaluated once, and the result composes.
    let mut i = 0
    let mut total = 0
    while (i < squares.count) {
        total = total + squares[i + 0]
        i = i + 1
    }
    if (total != 28) { return fail("indexing in a loop: ".concat(total.toString())) }

    // A second `at`, answering a different type. Overload resolution picks by
    // the receiver, so the two cannot be confused.
    if (held.letters[0].equals("a") == false) { return fail("`at` through a field") }
    if (held.letters[4].equals("e") == false) { return fail("`at` through a field, later index") }

    // The built-in indexable kinds are untouched by the new arm.
    let xs: List<Int> = list_new()
    list_push(xs, 10)
    list_push(xs, 20)
    if (xs[1] != 20) { return fail("List indexing") }
    if ("abc"[1] != 'b') { return fail("String indexing") }

    println("PASS")
    return 0
}
