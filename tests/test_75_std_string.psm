// Native std.string conformance tests. Boundary expectations are written
// explicitly, and optimized substring search is checked against the small
// straightforward implementation below. This test deliberately has no foreign
// string declarations: importing and exercising std.string must stay on the
// supported Prismio surface.

import std.io
import std.string

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn searchFixture(seed: Int, length: Int) -> String {
    let out = str_with_capacity(length)
    let mut i = 0
    while (i < length) {
        // A deterministic non-periodic lowercase fixture. Keeping the alphabet
        // small still gives the candidate filters enough collisions to test.
        let code = (seed * 13 + i * 17 + i * i * 3) % 23
        __builtin_string_put_byte(out, i, (97 + code) as Char)
        i = i + 1
    }
    return out
}

// Intentionally simple O(n*m) reference for checking the optimized packed-pair
// and Two-Way implementation. It shares only the representation byte reads,
// not any search policy or control flow with std.string.
fn referenceIndexOf(haystack: String, needle: String) -> Int {
    let hayLength = __builtin_string_len(haystack)
    let needleLength = __builtin_string_len(needle)
    if (needleLength == 0) { return 0 }
    if (needleLength > hayLength) { return 0 - 1 }

    let mut at = 0
    while (at <= hayLength - needleLength) {
        let mut offset = 0
        while (offset < needleLength and
               __builtin_string_byte_at(haystack, at + offset) ==
               __builtin_string_byte_at(needle, offset)) {
            offset = offset + 1
        }
        if (offset == needleLength) { return at }
        at = at + 1
    }
    return 0 - 1
}

fn main() -> Int {
    let nativeConcat = "left".concat("right")
    if (nativeConcat.equals("leftright") == false) {
        return fail("concat should append both inputs")
    }
    let nativeEmptyConcat = "".concat("")
    if (nativeEmptyConcat.equals("") == false) {
        return fail("concat should accept two empty inputs")
    }

    if ("abc".charAt(1) != 'b') {
        return fail("charAt should read an in-range byte")
    }
    if ("abc".charAt(3) != '\0') {
        return fail("charAt should return NUL out of range")
    }
    if ("same".equals("same") == false) {
        return fail("strEquals should accept equal input")
    }
    if ("same".equals("some")) {
        return fail("strEquals should reject unequal input")
    }
    if ("abc".compare("abd") >= 0) {
        return fail("compare should order differing bytes")
    }
    if ("abc".compare("abcd") >= 0) {
        return fail("compare should order a prefix before the longer string")
    }

    let nativeSlice = strSubstring("abcdef", 2, 3)
    if (nativeSlice.equals("cde") == false) {
        return fail("strSubstring should copy the requested range")
    }
    drop(nativeSlice)
    let nativeClampedSlice = strSubstring("abcdef", 4, 99)
    if (nativeClampedSlice.equals("ef") == false) {
        return fail("strSubstring should clamp at the end")
    }
    drop(nativeClampedSlice)
    let nativeMissingSlice = strSubstring("abcdef", 99, 2)
    if (nativeMissingSlice.equals("") == false) {
        return fail("strSubstring should be empty when start is out of range")
    }
    drop(nativeMissingSlice)

    let nativeChar = strFromChar('Q')
    if (nativeChar.equals("Q") == false) {
        return fail("strFromChar should produce one byte")
    }
    let nativeNulChar = strFromChar('\0')
    if (__builtin_string_len(nativeNulChar) != 0) {
        return fail("strFromChar should map NUL to the empty string")
    }
    let nativeClone = strClone("copy")
    if (nativeClone.equals("copy") == false) {
        return fail("strClone should return an equal fresh string")
    }
    let nativeEmpty = strEmpty()
    if (nativeEmpty.equals("") == false) {
        return fail("strEmpty should return an owned empty string")
    }

    let trimmedPadded = strTrim("  x  ")
    if (trimmedPadded.equals("x") == false) {
        return fail("strTrim should remove padding")
    }
    let trimmedEmpty = strTrim("")
    if (trimmedEmpty.equals("") == false) {
        return fail("strTrim should accept empty input")
    }
    let trimmedWhitespace = strTrim("   ")
    if (trimmedWhitespace.equals("") == false) {
        return fail("strTrim should empty all-whitespace input")
    }
    let trimmedPlain = strTrim("none")
    if (trimmedPlain.equals("none") == false) {
        return fail("strTrim should preserve unpadded input")
    }

    let replacedFirst = strReplaceFirst("a-b-c", "-", "+")
    if (replacedFirst.equals("a+b-c") == false) {
        return fail("strReplaceFirst should replace only the first match")
    }
    let replacedMissing = strReplaceFirst("hello", "z", "Z")
    if (replacedMissing.equals("hello") == false) {
        return fail("strReplaceFirst should preserve input when the pattern is absent")
    }

    if (strIndexOf("hello world", "world") != 6) {
        return fail("strIndexOf should find a suffix")
    }
    if (strIndexOf("hello", "xyz") != 0 - 1) {
        return fail("strIndexOf should return -1 on a miss")
    }
    if (strIndexOf("aaa", "aa") != 0) {
        return fail("strIndexOf should return the first overlapping match")
    }
    // Both predictive bytes occur at every four-byte candidate, but the third
    // byte rejects each one. This drives the packed-pair effectiveness check
    // into its Two-Way fallback instead of only testing the fast no-candidate
    // path.
    let denseCandidates = strRepeat("jzxe", 80)
    if (strIndexOf(denseCandidates, "jzde") != 0 - 1) {
        return fail("strIndexOf should reject dense false candidates")
    }
    // Needles above the packed-pair cutoff always use Two-Way. Cover aperiodic
    // and short-period needles, both hit and miss.
    let longHaystack = "prefix-0123456789abcdefghijklmnopqrstuv-WXYZ-suffix"
    let longNeedle = "0123456789abcdefghijklmnopqrstuv-WXYZ"
    if (strIndexOf(longHaystack, longNeedle) != 7) {
        return fail("strIndexOf should find a long aperiodic needle")
    }
    let periodicHaystack = strRepeat("ab", 96)
    let periodicNeedle = "abababababababababababababababababababab"
    if (strIndexOf(periodicHaystack, periodicNeedle) != 0) {
        return fail("strIndexOf should find a long periodic needle")
    }
    let longMiss = "abababababababababababababababababababac"
    if (strIndexOf(periodicHaystack, longMiss) != 0 - 1) {
        return fail("strIndexOf should reject a long periodic miss")
    }
    // Sweep both sides of the 32-byte cutoff. Even cases slice a guaranteed
    // match from the haystack; odd cases use independently generated needles.
    let mut searchCase = 1
    while (searchCase <= 256) {
        let hayLength = 40 + searchCase % 97
        let mut needleLength = 2 + searchCase % 65
        if (needleLength > hayLength) { needleLength = hayLength }
        let generatedHaystack = searchFixture(searchCase, hayLength)
        if (searchCase % 2 == 0) {
            let start = (searchCase * 7) % (hayLength - needleLength + 1)
            let generatedNeedle = strSubstring(generatedHaystack, start, needleLength)
            if (strIndexOf(generatedHaystack, generatedNeedle) !=
                referenceIndexOf(generatedHaystack, generatedNeedle)) {
                return fail("strIndexOf disagrees on a generated match")
            }
            drop(generatedNeedle)
        } else {
            let generatedNeedle = searchFixture(searchCase + 333, needleLength)
            if (strIndexOf(generatedHaystack, generatedNeedle) !=
                referenceIndexOf(generatedHaystack, generatedNeedle)) {
                return fail("strIndexOf disagrees on a generated independent needle")
            }
            drop(generatedNeedle)
        }
        drop(generatedHaystack)
        searchCase = searchCase + 1
    }

    if (strContains("hello", "ell") == false) {
        return fail("strContains should find an interior match")
    }
    if (strStartsWith("hello", "he") == false) {
        return fail("strStartsWith should find a prefix")
    }
    if (strEndsWith("hello", "lo") == false) {
        return fail("strEndsWith should find a suffix")
    }
    if (strStartsWith("he", "hello")) {
        return fail("strStartsWith should reject an overlong prefix")
    }

    let formattedZero = strFromInt(0)
    if (formattedZero.equals("0") == false) {
        return fail("strFromInt should format zero")
    }
    let formattedNegative = strFromInt(-4321)
    if (formattedNegative.equals("-4321") == false) {
        return fail("strFromInt should format a negative number")
    }
    let formattedMax = strFromInt(2147483647)
    if (formattedMax.equals("2147483647") == false) {
        return fail("strFromInt should format the 32-bit maximum")
    }

    let parts = strSplit("a,bb,ccc", ',')
    if (list_len(parts) != 3) {
        return fail("strSplit should produce one part per separator, plus one")
    }
    if (list_get(parts, 2).equals("ccc") == false) {
        return fail("strSplit should keep the final part")
    }
    let rejoined = strJoin(parts, ",")
    if (rejoined.equals("a,bb,ccc") == false) {
        return fail("strJoin should invert strSplit on the same separator")
    }
    drop(parts)

    let words = strSplitWhitespace("  a  b  c ")
    if (list_len(words) != 3) {
        return fail("strSplitWhitespace should discard empty parts")
    }
    drop(words)

    let onSep = strSplitOn("a::b::c", "::")
    if (list_len(onSep) != 3) {
        return fail("strSplitOn should split on a multi-character separator")
    }
    drop(onSep)

    // Every occurrence, and without rescanning what the replacement inserted --
    // `a` -> `aa` terminates rather than looping.
    let replacedAll = strReplaceAll("a-b-c", "-", "+")
    if (replacedAll.equals("a+b+c") == false) {
        return fail("strReplaceAll should replace every occurrence")
    }
    let replacementGrowth = strReplaceAll("aa", "a", "aa")
    if (replacementGrowth.equals("aaaa") == false) {
        return fail("strReplaceAll should not rescan its own replacement")
    }

    let parsedPositive = strParseInt("123")
    match (parsedPositive) {
        Option<Int>.Some(v) => {
            if (v != 123) { return fail("strParseInt should parse a positive integer") }
        }
        Option<Int>.None => { return fail("strParseInt should accept \"123\"") }
    }
    drop(parsedPositive)
    let parsedNegative = strParseInt("-7")
    match (parsedNegative) {
        Option<Int>.Some(v) => {
            if (v != 0 - 7) { return fail("strParseInt should parse a negative integer") }
        }
        Option<Int>.None => { return fail("strParseInt should accept \"-7\"") }
    }
    drop(parsedNegative)
    // Parsing must distinguish malformed input from the valid integer zero.
    let parsedGarbage = strParseInt("12x")
    match (parsedGarbage) {
        Option<Int>.Some(v) => { return fail("strParseInt should reject trailing garbage") }
        Option<Int>.None => { }
    }
    drop(parsedGarbage)
    let parsedEmpty = strParseInt("")
    match (parsedEmpty) {
        Option<Int>.Some(v) => { return fail("strParseInt should reject the empty string") }
        Option<Int>.None => { }
    }
    drop(parsedEmpty)

    let repeated = strRepeat("ab", 3)
    if (repeated.equals("ababab") == false) {
        return fail("strRepeat should concatenate n copies")
    }
    let repeatedEmpty = strRepeat("ab", 0)
    if (repeatedEmpty.equals("") == false) {
        return fail("strRepeat should produce an empty string for a count of zero")
    }
    let reversed = strReverse("abcd")
    if (reversed.equals("dcba") == false) {
        return fail("strReverse should reverse the bytes")
    }
    let upper = strToUpper("aBc1")
    if (upper.equals("ABC1") == false) {
        return fail("strToUpper should upcase letters and leave other bytes alone")
    }
    let lower = strToLower("AbC1")
    if (lower.equals("abc1") == false) {
        return fail("strToLower should downcase letters and leave other bytes alone")
    }
    let paddedStart = strPadStart("7", 3, '0')
    if (paddedStart.equals("007") == false) {
        return fail("strPadStart should pad on the left to the requested width")
    }
    let paddedEnd = strPadEnd("7", 3, '.')
    if (paddedEnd.equals("7..") == false) {
        return fail("strPadEnd should pad on the right to the requested width")
    }
    let unchangedPad = strPadStart("long", 2, '0')
    if (unchangedPad.equals("long") == false) {
        return fail("strPadStart should not truncate a string wider than the target")
    }
    if (strCountOf("abcabc", "abc") != 2) {
        return fail("strCountOf should count non-overlapping occurrences")
    }
    if (strLastIndexOf("abcabc", "abc") != 3) {
        return fail("strLastIndexOf should find the rightmost occurrence")
    }

    println("std.string tests passed")
    return 0
}
