// `T?` and Result<T, E> from std.option -- REQUIREMENTS 14.
//
// `Result` is a generic enum with payloads, so it exercises both features at once:
// the instantiation has to happen before the desugaring, and the shadow the
// `match` reads has to be the *instantiated* enum rather than the template. The
// optional half is `unwrapOr` for a number and for a String, and `??`.

import std.io
import std.option
import std.string


fn half(n: Int) -> Result<Int, String> {
    if (n % 2 != 0) { return Result<Int, String>.Err("odd") }
    return Result<Int, String>.Ok(n / 2)
}

// A function generic over the payload, so `T` must be solvable from `T?`.
fn orZero(o: Int?) -> Int {
    return o.unwrapOr(0)
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let some: Int? = 7
    let absent: Int? = none

    if (some.unwrapOr(0) != 7) { return fail("a value carries itself") }
    if (absent.unwrapOr(42) != 42) { return fail("none falls back") }
    if (some == none) { return fail("a value is not none") }
    if (absent != none) { return fail("none is none") }
    if (orZero(5) != 5) { return fail("an optional through a second function") }
    if ((absent ?? 3) != 3 or (some ?? 3) != 7) { return fail("?? on a number") }

    // Two instantiations of one template, with different payload types.
    let text: String? = "here"
    if (text.unwrapOr("missing").equals("here") == false) { return fail("String?") }
    if ((text ?? "missing").equals("here") == false) { return fail("?? on a String") }

    if (half(10).unwrapOr(0) != 5) { return fail("Ok carries its value") }
    if (half(7).isOk) { return fail("odd input is an error") }
    if (half(7).unwrapOr(99) != 99) { return fail("Err falls back") }
    if (resultOr(half(10), 0) != 5) { return fail("Ok carries its value") }
    if (resultIsOk(half(7))) { return fail("odd input is an error") }
    if (resultOr(half(7), 99) != 99) { return fail("Err falls back") }
    if (resultErrOr(half(7), "none").equals("odd") == false) { return fail("Err payload") }
    if (resultErrOr(half(8), "none").equals("none") == false) { return fail("Ok has no error") }

    println("PASS: optional and result")
    return 0
}
