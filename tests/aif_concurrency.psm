// Fixture for the AIF thread-affinity regression test (test_runner.py,
// run_aif_concurrency_test), and for the concurrent arm of
// tools/aif_differential.py.
//
// Not named test_*.psm, for the same reason aif_tiers.psm is not: `prismio aif`
// stops before codegen, so this is never built or run. The expectations are
// asserted in tests/test_runner.py -- editing this file means editing those.
//
// Every function here exists to make exactly one rule of INFERENCE 4.3 fire.
// All of it is new coverage: the `T` domain was vacuous until REQUIREMENTS 15,
// so before the task model there was no program at all that could tell a
// correct thread module from an absent one.
//
// Read top to bottom, the file is the evidence for SPEC 11 item 10's claim --
// isolation concurrency, no shared mutable heap, no atomic counts on the common
// path. The ordinary shapes stay region-bound and non-atomic; the two functions
// that reach CrossThread both had to work at it, and *how* they had to work at
// it is the result. One detaches a task so nothing joins it; the other launders
// a value through a second container so that no binding names it twice. Neither
// is a thing a program does by accident, and that is the point.
//
// **T-SPAWN-SHARE is not here.** It lives in aif_concurrency_shared.psm, and
// the split is forced rather than tidy: the `@elem` key is one per container
// *base* type (INFERENCE 3.1's object-insensitivity), and `List<Report>` and
// `List<Parcel>` share the base type `List`. So a single cross-container push
// anywhere in this file would mark every pushed site in it as multiply held,
// drag `transferred_is_not_atomic` to Shared, and land it at CrossThread --
// where it would then pass while asserting the opposite of what it is for.
// test_48's header measures the same cliff for the same reason.

import std.io
struct Job {
    lo: Int,
    hi: Int
}

struct Report {
    label: String,
    total: Int
}

extern fn str_concat(s1: String, s2: String) -> String
extern fn str_length(s: String) -> Int
extern fn cli_arg(index: Int) -> String

// A static root, in the only form this language has one: an FFI callee that
// keeps what it is given. `retain` is FFI 5's contract for exactly that, and
// AIF reads it as E = Global -- which is what T-STATIC needs a premise for. A
// `let mut` global cannot serve here because a global needs a constant
// initialiser, so a struct can never be one.
extern fn register_forever(r: Report retain)

fn work(j: Job) -> Int {
    return j.hi - j.lo
}

fn summarise(r: Report) -> Int {
    return r.total + str_length(r.label)
}

fn tally_reports(rs: List<Report>) -> Int {
    return 1
}

// E-SPAWN-J. The task is joined before the scope exits, so the argument never
// leaves the region it was allocated in and the thread domain costs it nothing.
//
// INFERENCE 4.1 calls this the place structured concurrency pays, and this
// function is the whole payment: `unjoined_is_cross_thread` below allocates the
// same shape and lands four tiers up, and the only difference between them is
// the join.
fn joined_stays_local() -> Int {
    let j = Job { lo: 0, hi: 10 }
    let t = spawn work(j)
    return join t
}

// T-SPAWN-MOVE, and the assertion this whole session exists to protect.
//
// The Report is moved into the task through the list that holds it, so exactly
// one thread can reach it at a time and the spawn is itself the synchronisation
// edge. Transferred, **not** CrossThread -- which is what keeps the count
// non-atomic. A change that lands this at CrossThread has broken SPEC 11
// item 10 whether or not anything else in the suite fails.
fn transferred_is_not_atomic() -> Int {
    let rs: List<Report> = list_new()
    list_push(rs, Report { label: "batch", total: 7 })
    let t = spawn tally_reports(rs)
    return join t
}

// No task at all. Present because a fixture made only of concurrent functions
// could not tell "the T rules fire correctly" from "the T rules fire on
// everything", and the second is the failure mode that would still look green.
fn no_task_at_all() -> Int {
    let j = Job { lo: 3, hi: 9 }
    return work(j)
}

// T-STATIC. The Report is retained by an FFI callee, so E = Global, and this
// program creates tasks -- so INFERENCE 4.3 assumes every task can reach it.
//
// Blunt on purpose, and worth stating what the bluntness is doing here: under
// isolation a value cannot become shared merely by being passed around, so the
// static root is what the CrossThread residue is *made of*. This function is
// small because there is nothing else to it.
fn static_root_is_cross_thread() -> Int {
    let r = Report { label: "global", total: 1 }
    register_forever(r)
    let j = Job { lo: 0, hi: 1 }
    let t = spawn work(j)
    return join t
}

// E-SPAWN with no join on every path, which forces Global -- and Global in a
// program with tasks is T-STATIC's premise reached a second way.
//
// The early `return` is the whole fixture. Take it out and the join analysis
// proves the task is awaited, escape stays region-bound, and this function
// drops to T1. Two rules arriving at the same tier from opposite directions is
// worth pinning, because it is the case where being wrong about the join is
// expensive rather than merely imprecise.
fn unjoined_is_cross_thread() -> Int {
    let r = Report { label: "detached", total: 3 }
    let t = spawn summarise(r)
    if (str_length(cli_arg(1)) > 0) {
        return 0
    }
    return join t
}

// ---------------------------------------------------------------------------
// E-SPAWN-J, the shapes that are not a straight run from spawn to join.
//
// These exist because the first implementation of the join analysis was a
// forward scan whose early-exit helper walked the *rest of the block* rather
// than the statement it was handed -- and every one of these blocks ends in
// `return join t`, so it always found an exit and always answered "not joined".
// The measured cost was T0 with no count at all becoming **T4a with an atomic
// one**, on four of five ordinary shapes. One inert `let x = 1` between a spawn
// and its join was enough.
//
// Nothing above caught it. `joined_stays_local` joins on the statement
// immediately after the spawn, which is the single shape the broken scan got
// right, and the differential agreed with the oracle throughout because no
// fixture on either side had a statement in between. That is a check that could
// not fail, and these are what make it able to.

fn one_statement_between() -> Int {
    let j = Job { lo: 0, hi: 10 }
    let t = spawn work(j)
    let x = 1
    return join t + x
}

// A loop between the two. `while` may run zero times, so it is never itself a
// join -- the point is only that control passes through it and out the bottom.
fn loop_between_spawn_and_join() -> Int {
    let j = Job { lo: 0, hi: 10 }
    let t = spawn work(j)
    let mut i = 0
    while (i < 4) { i = i + 1 }
    return join t
}

// A `break` inside that loop. Absorbed by the loop it belongs to, so it cannot
// leave this block and must not be read as an early exit -- the distinction the
// old helper had no parameter to express.
fn break_is_absorbed_by_its_loop() -> Int {
    let j = Job { lo: 0, hi: 10 }
    let t = spawn work(j)
    let mut i = 0
    while (i < 4) {
        i = i + 1
        if (i == 2) { break }
    }
    return join t
}

// Joined on both sides of a branch rather than after it. This is the case that
// needs "every path", not "some path": neither join is at the top level of the
// block, and the analysis has to prove the pair covers every way out.
fn join_on_both_paths() -> Int {
    let j = Job { lo: 0, hi: 10 }
    let t = spawn work(j)
    if (str_length(cli_arg(1)) > 0) {
        return join t
    }
    return join t
}

// The counterpart, and the reason `unjoined_is_cross_thread` is not enough on
// its own: an arm that leaves *without* joining still has to force Global even
// though a join is plainly visible further down. Getting this wrong is a
// use-after-free rather than a lost tier, so it is asserted next to the cases
// that made the analysis more permissive.
fn one_path_escapes_unjoined() -> Int {
    let j = Job { lo: 0, hi: 10 }
    let t = spawn work(j)
    if (str_length(cli_arg(1)) > 0) {
        return 0
    }
    return join t
}

fn main() -> Int {
    let a = joined_stays_local()
    let b = transferred_is_not_atomic()
    let c = no_task_at_all()
    let d = static_root_is_cross_thread()
    let f = unjoined_is_cross_thread()
    let g = one_statement_between()
    let h = loop_between_spawn_and_join()
    let i = break_is_absorbed_by_its_loop()
    let k = join_on_both_paths()
    let m = one_path_escapes_unjoined()
    return a + b + c + d + f + g + h + i + k + m
}
