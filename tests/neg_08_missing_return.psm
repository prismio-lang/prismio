// expect-error: must return String on every path
// A value-returning function must return on every path.
//
// This used to compile. For an Int the compiler silently emitted `ret i32 0`;
// for anything pointer-shaped it emitted `ret ptr 0`, which is not even valid
// IR, so the failure surfaced as a backend error about generated code rather
// than as the source-level mistake.

import std.io
fn pick(x: Int) -> String {
    if (x > 0) {
        return "positive"
    }
    // falls off the end
}

fn main() -> Int {
    println(pick(1))
    return 0
}
