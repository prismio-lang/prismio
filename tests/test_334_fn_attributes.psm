// `inline(always)`, `inline(never)`, `noinline`, `hot` and `noreturn` before `fn`
// (src/parse/modifiers.psm). They move code and promise things, never change what a
// program computes, so this checks that every placement parses and computes what it
// would unmarked -- run_fn_attributes_test reads the IR for the attributes.
//
// All are contextual: a local, a parameter and a function may be named after any of
// them, and none is a marker because none is in a run of words ending in `fn`.

import std.io
import std.vec

inline(always) fn square(x: Int) -> Int { return x * x }

private inline(always) fn addOne(x: Int) -> Int { return x + 1 }

inline(never) fn plusTwo(x: Int) -> Int { return x + 2 }

noinline fn plusThree(x: Int) -> Int { return x + 3 }

hot fn sumTo(n: Int) -> Int {
    let mut total = 0
    for i in 0..<n { total = total + addOne(i) }
    return total
}

// A generic function: every marker has to survive monomorphisation.
inline(always) fn firstOr<T>(values: Vec<T>, fallback: T) -> T {
    if (values.length == 0) { return fallback }
    return values[0]
}

noinline fn lastOr<T>(values: Vec<T>, fallback: T) -> T {
    if (values.length == 0) { return fallback }
    return values[values.length - 1]
}

// Markers combine in any order, and with `export`.
export hot inline(always) fn combined(x: Int) -> Int { return x - 1 }

hot noinline fn hotAndNotInlined(x: Int) -> Int { return x - 2 }

// `noreturn`: control never comes back, so the code after a call is dead and a
// function that ends in one needs no `return`.
noreturn fn die(code: Int) {
    println("dying")
    exit(code)
}

cold noreturn fn dieSlowly(code: Int) -> Int {
    exit(code)
}

fn checked(x: Int) -> Int {
    if (x < 0) { die(9) }
    return x
}

fn pick(x: Int) -> Int {
    if (x > 0) {
        return 1
    } else {
        die(3)
    }
}

fn endsInNoreturn(x: Int) -> Int {
    if (x > 0) { return x }
    dieSlowly(4)
}

// Words used as ordinary names.
fn hot(hot: Int) -> Int { return hot + 10 }
fn noinline(noinline: Int) -> Int { return noinline + 20 }
fn noreturn(noreturn: Int) -> Int { return noreturn + 30 }
fn plain(x: Int) -> Int { return x + 100 }

struct Counter { value: Int }

impl Counter {
    inline(always) fn bumped(self) -> Int { return self.value + 1 }
    private inline(never) fn doubled(self) -> Int { return self.value * 2 }
    fn quadrupled(self) -> Int { return self.doubled() * 2 }
    hot fn tripled(self) -> Int { return self.value * 3 }
    noinline fn reset(self) -> Int { return 0 }
    cold noreturn fn abort(self) { exit(self.value) }
    fn failIfNegative(self) -> Int {
        if (self.value < 0) { self.abort() }
        return self.value
    }
    // Ends in a call to a `noreturn` method: no `return` needed after it.
    fn mustBePositive(self) -> Int {
        if (self.value > 0) { return self.value }
        self.abort()
    }
}

fn main() -> Int {
    let hot = 1
    let noreturn = 2
    let counter = Counter { value: 4 }
    if (square(4) != 16) { return 1 }
    if (plusTwo(1) != 3 or plusThree(1) != 4) { return 2 }
    if (sumTo(4) != 10) { return 3 }
    let empty: Vec<Int> = []
    let two: Vec<Int> = [9, 8]
    if (firstOr(empty, 7) != 7 or firstOr(two, 7) != 9) { return 4 }
    if (lastOr(empty, 7) != 7 or lastOr(two, 7) != 8) { return 5 }
    if (combined(1) != 0 or hotAndNotInlined(5) != 3) { return 6 }
    if (checked(5) != 5 or pick(1) != 1 or endsInNoreturn(6) != 6) { return 7 }
    if (counter.bumped() != 5 or counter.quadrupled() != 16 or counter.tripled() != 12) { return 8 }
    if (counter.reset() != 0 or counter.failIfNegative() != 4 or counter.mustBePositive() != 4) { return 9 }
    if (hot(hot) != 11 or noinline(1) != 21 or noreturn(noreturn) != 32 or plain(1) != 101) { return 10 }
    println("ok")
    return 0
}
