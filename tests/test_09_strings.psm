import std.io
import std.string

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let hello = "Hello"
    let world = "World"
    let phrase = hello.concat(", ", world)

    if (__builtin_string_len(hello) != 5) {
        return fail("string length should count characters")
    }

    if (hello.equals("Hello") == false) {
        return fail("identical string literals should compare equal")
    }

    if (hello.equals(world)) {
        return fail("different string literals should not compare equal")
    }

    if (phrase.equals("Hello, World") == false) {
        return fail("string concatenation should preserve order")
    }

    println("PASS: strings")
    return 0
}
