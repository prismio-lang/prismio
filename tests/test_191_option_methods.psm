// Option's and Result's methods.
//
// 1. `isSome`/`isNone` and `isOk`/`isErr` are properties, declared on a generic
//    type -- which is what semaPropertyRewrite had to learn to find.
// 2. `unwrapOr` answers what `optionOr`/`resultOr` do, with a scalar payload and
//    an owned String one, from a local and from a call, with a literal and an
//    owned fallback. The ledger is checked by the suite's `ownership_probes`.
// 3. `expect`, `okOr`, `ok` and `err`, with String payloads -- the shapes that
//    released a literal or freed a payload twice until 2026-09-25.
// 4. `expect` on nothing panics with its message: this binary starts itself
//    with an argument and checks the child's status and stderr.

import std.io
import std.option
import std.process
import std.string
import std.vec

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn findLiteral(key: String) -> Option<String> {
    if (key.equals("name")) { return Option<String>.Some("a literal payload, past twelve bytes") }
    return Option<String>.None
}

fn findOwned(key: String) -> Option<String> {
    if (key.equals("name")) { return Option<String>.Some("an owned payload, ".concat(key)) }
    return Option<String>.None
}

fn parse(text: String) -> Result<Int, String> {
    if (text.equals("7")) { return Result<Int, String>.Ok(7) }
    return Result<Int, String>.Err("not a seven: ".concat(text))
}

fn main() -> Int {
    if (process.args.count > 1) {
        let missing = Option<Int>.None
        println(missing.expect("the child's value was missing"))
        return 0
    }

    let mut bad = 0

    let some = Option<Int>.Some(5)
    let nothing = Option<Int>.None
    if (some.isSome == false or some.isNone) { bad = bad + fail("isSome on Some") }
    if (nothing.isSome or nothing.isNone == false) { bad = bad + fail("isNone on None") }

    let three = Option<Int>.Some(3)
    if (three.unwrapOr(9) != 3) { bad = bad + fail("unwrapOr on Some") }
    let empty = Option<Int>.None
    if (empty.unwrapOr(9) != 9) { bad = bad + fail("unwrapOr on None") }

    let literal = findLiteral("name")
    if (literal.unwrapOr("fallback").equals("a literal payload, past twelve bytes") == false) {
        bad = bad + fail("unwrapOr on a literal payload")
    }
    let noLiteral = findLiteral("other")
    if (noLiteral.unwrapOr("fallback").equals("fallback") == false) {
        bad = bad + fail("unwrapOr to a literal fallback")
    }
    let owned = findOwned("name")
    if (owned.unwrapOr("fallback").equals("an owned payload, name") == false) {
        bad = bad + fail("unwrapOr on an owned payload")
    }
    let noOwned = findOwned("other")
    if (noOwned.unwrapOr("an owned ".concat("fallback")).equals("an owned fallback") == false) {
        bad = bad + fail("unwrapOr to an owned fallback")
    }

    let good = parse("7")
    if (good.isOk == false or good.isErr) { bad = bad + fail("isOk") }
    let failed = parse("x")
    if (failed.isErr == false or failed.isOk) { bad = bad + fail("isErr") }
    let goodValue = parse("7")
    if (goodValue.unwrapOr(0) != 7) { bad = bad + fail("Result.unwrapOr on Ok") }
    let badValue = parse("x")
    if (badValue.unwrapOr(0) != 0) { bad = bad + fail("Result.unwrapOr on Err") }

    let four = Option<Int>.Some(4)
    if (four.expect("four") != 4) { bad = bad + fail("expect on Some") }
    let named = findOwned("name")
    if (named.expect("named").equals("an owned payload, name") == false) {
        bad = bad + fail("expect with an owned String payload")
    }
    let literalAgain = findLiteral("name")
    if (literalAgain.expect("literal").equals("a literal payload, past twelve bytes") == false) {
        bad = bad + fail("expect with a literal payload")
    }
    let sevenAgain = parse("7")
    if (sevenAgain.expect("seven") != 7) { bad = bad + fail("Result.expect on Ok") }

    let absent = findOwned("other")
    let asResult = absent.okOr("absent")
    if (asResult.isErr == false) { bad = bad + fail("okOr on None") }
    let present = findOwned("name")
    let okResult = present.okOr("absent")
    if (okResult.unwrapOr("").equals("an owned payload, name") == false) {
        bad = bad + fail("okOr on Some")
    }

    let okPart = parse("7")
    let okAsOption = okPart.ok()
    if (okAsOption.unwrapOr(0) != 7) { bad = bad + fail("ok() on Ok") }
    let errPart = parse("x")
    let errAsOption = errPart.err()
    if (errAsOption.unwrapOr("").equals("not a seven: x") == false) {
        bad = bad + fail("err() on Err")
    }
    let noErr = parse("7")
    let noErrOption = noErr.err()
    if (noErrOption.isSome) { bad = bad + fail("err() on Ok") }

    let child = Process()
    child.program = process.args[0]
    child.arguments = ["expect-none"]
    child.stderr = StreamMode.Pipe
    let running = child.spawn()
    let said = running.stderr.readAll()
    let status = running.wait()
    if (status != 101) { bad = bad + fail("expect on None exited ".concat(status.toString())) }
    if (said.contains("the child's value was missing") == false) {
        bad = bad + fail("expect's message: ".concat(said))
    }

    if (bad != 0) { return 1 }
    println("PASS: Option and Result methods")
    return 0
}
