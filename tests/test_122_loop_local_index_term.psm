// expect-trap: body-assigned => index -1 is out of range for a Vec of length 8
// expect-trap: body-local => index -1 is out of range for a Vec of length 8
// expect-trap: invariant-term => index -1 is out of range for a Vec of length 8
// expect-trap: invariant-term-step-2 => index -1 is out of range for a Vec of length 8
// A loop-body-local `let` used inside an index expression.
//
// The range guard evaluates every loop-invariant term in the **preheader**, and
// a binding declared inside the body does not exist there yet. Treating one as
// invariant emits a load from a local the backend has never seen, which fails as
// `internal backend error: load from unknown local` rather than as a wrong
// answer -- so this file is a compile-time regression test first and a value
// test second.
//
// The hole was that invariance rejected names the body *assigns* but not names
// it *declares*. Both forms appear below, and so does the case that must still
// qualify: a term bound outside the loop.

import std.io
import std.process

fn check(label: String, got: Int, want: Int) -> Int {
    if (got != want) {
        println(label)
        return 1
    }
    return 0
}

fn filled(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        xs.push(i)
        i = i + 1
    }
    return xs
}

// `step` is declared inside the body. It is not invariant, and the loop must not
// be range-guarded on it.
fn localDecl(n: Int) -> Int {
    let xs = filled(n)
    let mut acc = 0
    let mut at = n - 1
    while (at >= 0) {
        let step = 1
        acc = acc + xs[at - step]
        at = at - 1
    }
    return acc
}

// `step` is declared outside but assigned inside: the case that was already
// handled, kept so both halves of the predicate stay covered.
fn assignedInBody(n: Int) -> Int {
    let xs = filled(n)
    let mut acc = 0
    let mut step = 1
    let mut at = n - 1
    while (at >= 0) {
        acc = acc + xs[at - step]
        step = 1
        at = at - 1
    }
    return acc
}

// Bound outside and never touched: this one must still qualify, so the fix is a
// correction rather than a blanket refusal.
fn trulyInvariant(n: Int, step: Int) -> Int {
    let xs = filled(n)
    let mut acc = 0
    let mut at = n - 1
    while (at >= 0) {
        acc = acc + xs[at - step]
        at = at - 1
    }
    return acc
}

// An arm whose index leaves the list runs only when its case is named: it must stop the
// program there (docs/MEMORY_SAFETY_PLAN.md section 2), where a proved copy taken for it
// would read past the list and run on. The harness runs one case per `expect-trap` line.
fn trapCase(name: String) -> Bool {
    return process.args.count > 1 and process.args[1].equals(name)
}

fn main() -> Int {
    let mut bad = 0
    // xs is [0..7]; reading at-1 for at in 7..0 reads 6+5+4+3+2+1+0 and then index -1
    // at at=0, which stops the program.
    if (trapCase("body-local")) { return (localDecl(8)) as Int }
    if (trapCase("body-assigned")) { return (assignedInBody(8)) as Int }
    if (trapCase("invariant-term")) { return (trulyInvariant(8, 1)) as Int }
    if (trapCase("invariant-term-step-2")) { return (trulyInvariant(8, 2)) as Int }

    if (bad != 0) { return 1 }
    println("PASS: loop-local index terms")
    return 0
}
