// E1: one preheader guard for every push the loop performs.
//
// `cap - len >= trip_count * pushes_per_iteration` proved once makes every push
// in the body a store and a length bump. The guard is an *upper bound* on the
// pushes -- a `continue`, a `break` or a push under an `if` performs fewer, never
// more -- so the arms below are the ways that bound can be wrong: a list with
// exactly enough room, one with too little, one where the loop pushes fewer times
// than it syntactically could, and two receivers with different counts.
//
// A capacity miss is not an error: the loop takes the arm it takes today, where
// `list_push` stamps, grows and reallocates as it always has.

import std.io

fn digest(xs: Vec<Int>) -> Int {
    let mut acc = 0
    let mut i = 0
    let n = xs.length
    while (i < n) {
        acc = (acc * 31 + xs[i]) % 1000000007
        i = i + 1
    }
    return acc
}

// Exactly enough room: the guard holds.
fn fillExact(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        xs.push(i * 3)
        i = i + 1
    }
    return xs
}

// No room at all: the guard fails and the loop grows the list as before.
fn fillGrowing(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = []
    let mut i = 0
    while (i < n) {
        xs.push(i * 3)
        i = i + 1
    }
    return xs
}

// One short: the guard fails on the last element it would have needed.
fn fillOneShort(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n - 1)
    let mut i = 0
    while (i < n) {
        xs.push(i * 3)
        i = i + 1
    }
    return xs
}

// Two pushes a turn into one list: the guard needs twice the trip count.
fn fillTwice(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(2 * n)
    let mut i = 0
    while (i < n) {
        xs.push(i)
        xs.push(0 - i)
        i = i + 1
    }
    return xs
}

// Fewer pushes than the static count: the bound is an upper bound, and the guard
// must not be read as a promise that the list ends up full.
fn fillSparse(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        if (i % 3 == 0) { xs.push(i) }
        i = i + 1
    }
    return xs
}

// Two receivers, different counts, and a read of a third list in the same loop.
fn fillPair(n: Int) -> Int {
    let src = fillExact(n)
    let mut a: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut b: Vec<Int> = Vec<Int>.withCapacity(2 * n)
    let mut i = 0
    while (i < n) {
        a.push(src[i])
        b.push(i)
        b.push(i + 1)
        i = i + 1
    }
    return (digest(a) * 7 + digest(b)) % 1000000007
}

// The loop stops early: fewer pushes than the guard allowed for.
fn fillBreak(n: Int, stop: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        if (i >= stop) { break }
        xs.push(i * 3)
        i = i + 1
    }
    return xs
}

fn check(label: String, got: Int, want: Int) -> Int {
    if (got != want) {
        print(label)
        print(" got ")
        print(got)
        print(" want ")
        println(want)
        return 1
    }
    return 0
}

fn main() -> Int {
    let mut bad = 0
    let n = 64

    // Every filling strategy must produce the same list.
    let want = digest(fillGrowing(n))
    bad = bad + check("FAIL: exact capacity", digest(fillExact(n)), want)
    bad = bad + check("FAIL: one short", digest(fillOneShort(n)), want)
    bad = bad + check("FAIL: exact length", fillExact(n).length, n)
    bad = bad + check("FAIL: one short length", fillOneShort(n).length, n)

    // Two a turn.
    let twice = fillTwice(n)
    bad = bad + check("FAIL: twice length", twice.length, 2 * n)
    bad = bad + check("FAIL: twice head", twice[0], 0)
    bad = bad + check("FAIL: twice second", twice[2], 1)
    bad = bad + check("FAIL: twice negative", twice[3], 0 - 1)

    // Fewer than the bound allowed.
    let sparse = fillSparse(n)
    bad = bad + check("FAIL: sparse length", sparse.length, 22)
    bad = bad + check("FAIL: sparse head", sparse[0], 0)
    bad = bad + check("FAIL: sparse last", sparse[21], 63)

    // Two receivers and a read in the same loop.
    bad = bad + check("FAIL: pair", fillPair(n), fillPair(n))
    bad = bad + check("FAIL: pair is not zero", (fillPair(n) == 0) as Int, 0)

    // Early exit.
    let cut = fillBreak(n, 10)
    bad = bad + check("FAIL: break length", cut.length, 10)
    bad = bad + check("FAIL: break last", cut[9], 27)
    bad = bad + check("FAIL: break past end", cut[10], 0)

    if (bad != 0) { return 1 }
    println("PASS: push predication")
    return 0
}
