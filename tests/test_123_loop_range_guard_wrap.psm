// expect-trap: wrap-up => index -2147483648 is out of range for a Vec of length 4
// expect-trap: wrap-down => index -2147483632 is out of range for a Vec of length 16
// expect-trap: run-away-down => index -1 is out of range for a Vec of length 4
// expect-trap: run-away-up => index 4 is out of range for a Vec of length 4
// expect-trap: stride-two-past-end => index 4 is out of range for a Vec of length 4
// The loop range guard's monotonicity precondition.
//
// generateLoopRangeGuards proves "every index this loop forms is in [lo, hi]"
// from the loop condition and a single update. That reasoning is arithmetic on
// unbounded integers; the loop runs on a wrapping 32-bit `Int`. Two ways the
// two disagree, both of which used to emit an unchecked GEP off a value the
// range never contained:
//
//   - the update wraps -- `at = at + 2147483647` under `while (at < 3)` reaches
//     -2147483648 with the condition still true (SIGSEGV, exit -11);
//   - the update runs the wrong way -- `at = at - 1` under `while (at < 3)`
//     never approaches the bound, so the loop indexes off arbitrarily far
//     values. This one did not crash: it read adjacent heap and returned
//     plausible answers, which is why it survived.
//
// An index out of range stops the program, so every arm below has one right answer
// whether the guard fires or declines: the program stops at the first wrapped index.
// What the arms are for is that the *wrong* answer is a memory read, which never stops.

import std.io
import std.process

fn filled(n: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        xs.push(i + 1)
        i = i + 1
    }
    return xs
}

// Increasing, and the step wraps past Int on the first update.
fn wrapUp() -> Int {
    let xs = filled(4)
    let mut at = 1
    let mut acc = 0
    while (at < 3) {
        acc = acc + xs[at]
        at = at + 2147483647
    }
    return acc
}

// Decreasing, and the step wraps past the other end. The invariant offset is
// what lets the range look valid -- indices 11 through 15 of a 16-element list
// -- while the induction variable itself is far outside it.
fn wrapDown(shift: Int) -> Int {
    let xs = filled(16)
    let stop = 0 - 10
    let mut at = 0 - 5
    let mut acc = 0
    while (at > stop) {
        acc = acc + xs[at - shift]
        at = at - 2147483647
    }
    return acc
}

// Increasing condition, decreasing update: the induction variable leaves the
// range downwards and the condition never stops it.
fn runAwayDown(stop: Int) -> Int {
    let xs = filled(4)
    let mut at = 1
    let mut acc = 0
    while (at < 3) {
        acc = acc + xs[at]
        if (at < stop) { break }
        at = at - 1
    }
    return acc
}

// Decreasing condition, increasing update: the same, upwards.
fn runAwayUp(stop: Int) -> Int {
    let xs = filled(4)
    let mut at = 2
    let mut acc = 0
    while (at >= 0) {
        acc = acc + xs[at]
        if (at > stop) { break }
        at = at + 1
    }
    return acc
}

// A step the guard must still serve: monotone, in range, and not 1. `at < 4`
// admits 3, not 4, so a guard that used the bound itself declined this loop
// over a 4-element list -- which is the shape most loops in the language have.
fn strideTwo(limit: Int) -> Int {
    let xs = filled(4)
    let mut at = 0
    let mut acc = 0
    while (at < limit) {
        acc = acc + xs[at]
        at = at + 2
    }
    return acc
}

fn check(label: String, got: Int, want: Int) -> Int {
    if (got != want) {
        println(label)
        return 1
    }
    return 0
}

// An arm whose index leaves the list runs only when its case is named: it must stop the
// program there (docs/MEMORY_SAFETY_PLAN.md section 2), where a proved copy taken for it
// would read past the list and run on. The harness runs one case per `expect-trap` line.
fn trapCase(name: String) -> Bool {
    return process.args.count > 1 and process.args[1].equals(name)
}

fn main() -> Int {
    let mut bad = 0

    // 1, then -2147483648, which stops the program.
    if (trapCase("wrap-up")) { return (wrapUp()) as Int }

    // Only the first index, 15, is in range; the rest wrap out of it.
    if (trapCase("wrap-down")) { return (wrapDown(0 - 20)) as Int }

    // 2 and 1 from the list, then zeros down to the break.
    if (trapCase("run-away-down")) { return (runAwayDown(0 - 8)) as Int }

    // 3 and 4 from the list, then zeros up to the break.
    if (trapCase("run-away-up")) { return (runAwayUp(8)) as Int }

    // xs[0] + xs[2], and the same past the end.
    bad = bad + check("FAIL: strideTwo in range", strideTwo(4), 4)
    if (trapCase("stride-two-past-end")) { return (strideTwo(9)) as Int }

    if (bad != 0) { return 1 }
    println("PASS: loop range guard monotonicity")
    return 0
}
