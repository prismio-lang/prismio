import std.io

fn fill(inout xs: Vec<Int>, start: Int, end: Int) {
    let mut i = start
    while (i < end) {
        xs.push((i * 7 - 13) % 997)
        i = i + 1
    }
}

fn inclusiveFill(inout xs: Vec<Int>, end: Int) {
    let mut i = 0
    while (i <= end) {
        xs.push(i)
        i = i + 1
    }
}

// Compile-only: the induction variable wraps, so this function intentionally
// has no finite trip count. Its push must never use a finite capacity promise.
fn wrappingInclusiveFill(inout xs: Vec<Int>, start: Int) {
    let mut i = start
    while (i <= 2147483647) {
        xs.push(i)
        i = i + 1
    }
}

fn nearLimitFill(inout xs: Vec<Int>) {
    let mut i = 2147483583
    while (i <= 2147483646) {
        xs.push(i)
        i = i + 1
    }
}

fn interruptedFill(inout xs: Vec<Int>, n: Int) {
    let mut i = 0
    while (i < n) {
        if (i == 70) { break }
        xs.push(i)
        i = i + 1
    }
}

fn observedValue(xs: Vec<Int>) -> Int { return xs.length }

fn observedFill(inout xs: Vec<Int>, n: Int) {
    let mut i = 0
    while (i < n) {
        xs.push(observedValue(xs))
        i = i + 1
    }
}

fn checkFill(n: Int) -> Int {
    let mut xs: Vec<Int> = []
    fill(xs, 3, n + 3)
    if (xs.length != n) { return 1 }
    let mut k = 0
    while (k < n) {
        if (xs[k] != ((k + 3) * 7 - 13) % 997) { return 2 }
        k = k + 1
    }
    // A populated list must keep its contents when the same fill helper is
    // called again and growth occurs during the append.
    fill(xs, 0, 129)
    if (xs.length != n + 129) { return 3 }
    k = 0
    while (k < 129) {
        if (xs[n + k] != (k * 7 - 13) % 997) { return 4 }
        k = k + 1
    }
    if (xs[-1] != 0 or xs[n + 129] != 0) { return 5 }
    xs[-1] = 900
    xs[n + 129] = 900
    if (xs.length != n + 129) { return 6 }
    return 0
}

struct FillPair { x: Int, y: Int }
struct FillRow { pair: FillPair, life: Int, weight: Float }

fn structFill(n: Int) -> Int {
    let mut rows: Vec<FillRow> = Vec<FillRow>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        rows.push(FillRow {
            pair: FillPair { x: i, y: -i }, life: i + 9, weight: 2.0
        })
        i = i + 1
    }
    i = 0
    while (i < n) {
        let r = rows[i]
        if (r.pair.x != i or r.pair.y != -i or r.life != i + 9) { return 7 }
        r.life = r.life - 1
        r.weight = r.weight + 3.0
        if (rows.length != n or r.life != i + 8 or r.weight != 5.0) { return 8 }
        i = i + 1
    }
    return 0
}

fn queueGrowth(n: Int) -> Int {
    let mut queue: Vec<Int> = []
    queue.push(0)
    let mut head = 0
    while (head < queue.length) {
        let node = queue[head]
        if (node != head) { return 9 }
        if (node < n) { queue.push(node + 1) }
        head = head + 1
    }
    if (head != n + 1) { return 10 }
    return 0
}

// Bool elements are bytes in the block: stored as `i8` and read as "not zero".
// An `i1` store is not a byte store to LLVM, and kept the fill from becoming a
// memset (runtime/llvm-api-backend.c, element_memory_type).
fn boolFill(n: Int) -> Int {
    let mut marks: Vec<Bool> = Vec<Bool>.withCapacity(n + 1)
    let mut i = 0
    while (i <= n) {
        marks.push(true)
        i = i + 1
    }
    let mut k = 0
    while (k <= n) {
        if (k % 3 == 0) { marks.set(k, false) }
        k = k + 1
    }
    let mut count = 0
    k = 0
    while (k <= n) {
        if (marks[k]) { count = count + 1 }
        k = k + 1
    }
    return count
}

fn main() -> Int {
    if (checkFill(0) != 0 or checkFill(1) != 0 or checkFill(63) != 0
            or checkFill(64) != 0 or checkFill(65) != 0 or checkFill(127) != 0
            or checkFill(128) != 0 or checkFill(129) != 0 or checkFill(4096) != 0) {
        return 11
    }
    let mut empty: Vec<Int> = []
    fill(empty, 90, -1)
    inclusiveFill(empty, -1)
    if (empty.length != 0) { return 12 }
    inclusiveFill(empty, 128)
    if (empty.length != 129 or empty[128] != 128) { return 13 }
    let mut stopped: Vec<Int> = []
    interruptedFill(stopped, 200)
    if (stopped.length != 70 or stopped[69] != 69) { return 14 }
    let mut observed: Vec<Int> = []
    observedFill(observed, 129)
    if (observed.length != 129 or observed[128] != 128) { return 15 }
    if (structFill(129) != 0 or queueGrowth(4096) != 0) { return 16 }
    let mut limit: Vec<Int> = []
    nearLimitFill(limit)
    if (limit.length != 64 or limit[0] != 2147483583
            or limit[63] != 2147483646) { return 17 }
    if (boolFill(300) != 200 or boolFill(0) != 0 or boolFill(4096) != 2731) { return 18 }
    println("PASS: counted fill, struct regions, and growing queue")
    return 0
}
