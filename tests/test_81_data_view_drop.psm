// A DataView that is not materialised back to rows is still owned and must
// release every column when its scope exits.

struct Cell {
    x: Int,
    y: Float
}

fn main() -> Int {
    let mut rows: Vec<Cell> = []
    rows.push(Cell { x: 1, y: 2.0 })
    let view: DataView<Cell> = soa(rows)
    if (view.length != 1) { return 1 }
    return 0
}
