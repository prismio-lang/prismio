// A match binder moved into an optional. `errOf` returns a `String?` of its own
// holding the Result's payload; both the Result's release and the optional's
// freed it. The second half returns that optional out of the function whose local
// owns the Result: freeing the local at its scope exit would leave the optional
// pointing at freed memory, which `--verify` cannot see and the printed text does.
// Run by `ownership_probes`.

import std.io
import std.option
import std.string

fn parse(text: String) -> Result<Int, String> {
    if (text.equals("7")) { return Result<Int, String>.Ok(7) }
    return Result<Int, String>.Err("not a seven: ".concat(text))
}

fn errOf(r: Result<Int, String>) -> String? {
    match (r) {
        Result.Ok(v) => { return none }
        Result.Err(e) => { return e }
    }
}

fn errFromParse(text: String) -> String? {
    let owned = parse(text)
    return errOf(owned)
}

fn main() -> Int {
    let h = parse("x")
    let i = errOf(h)
    println(i != none)

    let j = errFromParse("y")
    println(j ?? "none")
    return 0
}
