// expect-error: unknown identifier `inner`
// A binding declared inside a block must not be visible after it.
//
// This used to compile and print 42: the symbol table was flat and cleared only
// once per function, so `inner` outlived the block that declared it.

fn main() -> Int {
    if (true) {
        let inner = 42
        println_int(inner)
    }
    println_int(inner)
    return 0
}
