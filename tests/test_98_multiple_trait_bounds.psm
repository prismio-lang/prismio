// Multiple bounds are all available inside one generic body and all checked at
// its instantiation. The second call reverses the declaration order so neither
// bound can pass merely because the compiler checks the first one.

import std.io

trait Scored {
    fn score(self) -> Int
}

trait Enabled {
    fn enabled(self) -> Bool
}

impl Scored for Int {
    fn score(self) -> Int { return self * 2 }
}

impl Enabled for Int {
    fn enabled(self) -> Bool { return self > 0 }
}

struct Gate<T: Scored + Enabled> {
    value: T
}

fn activeScore<T: Scored + Enabled>(value: T) -> Int {
    if (enabled(value)) { return score(value) }
    return 0
}

fn checkedScore<T: Enabled + Scored>(value: T) -> Int {
    if (enabled(value)) { return score(value) + 1 }
    return 0
}

fn main() -> Int {
    if (activeScore(7) != 14) { return 1 }
    if (activeScore(0) != 0) { return 2 }
    if (checkedScore(7) != 15) { return 3 }
    let gate = Gate<Int> { value: 9 }
    if (activeScore(gate.value) != 18) { return 4 }
    println("test_98 ok")
    return 0
}
