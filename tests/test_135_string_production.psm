// The parts of std.string a program cannot ship without, and the two readings of
// a String that make them possible.
//
// **Byte or character is the whole subject here.** `length`, `charAt` and
// `substring` are byte-indexed, which is right for a scanner and wrong for user
// text; the scalar functions are the second reading. Every assertion below that
// mentions a width is really asking which of the two answered.

import std.io
import std.string
import std.option
import std.display

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    // -- Float text ---------------------------------------------------------
    //
    // `Float` was the one type that could be printed and parsed but never
    // converted. The text is the shortest form with at most fifteen significant
    // digits (DBL_DIG): every literal comes back as written, and the binary
    // noise past that -- `0.1 + 0.2` is 0.30000000000000004 -- is not printed.
    if ((0.1).toString().equals("0.1") == false) { return fail("strFromFloat(0.1)") }
    if ((100.0).toString().equals("100") == false) { return fail("a round value is not exponential") }
    if ((0.1 + 0.2).toString().equals("0.3") == false) { return fail("0.1 + 0.2 prints as 0.3") }
    if ((1.0 / 3.0).toString().equals("0.333333333333333") == false) {
        return fail("a third stops at fifteen digits")
    }
    if (123456789.0.toString().equals("123456789") == false) { return fail("nine digits stay whole") }
    if (1.0e21.toString().equals("1e+21") == false) { return fail("a large value stays exponential") }
    if ((1.0 / 3.0).toString(2).equals("0.33") == false) { return fail("fixed decimals") }
    if (show(2.5).equals("2.5") == false) { return fail("Display for Float") }
    if ((2.5).toString().equals("2.5") == false) { return fail("Float.toString") }

    // Anything written with fifteen digits or fewer reads back as the same double.
    let fifteen = 0.123456789012345
    let back = optionOr(fifteen.toString().parseFloat(), 0.0)
    if (back != fifteen) { return fail("fifteen digits round-trip through the text") }
    let huge = optionOr(1.0e21.toString().parseFloat(), 0.0)
    if (huge != 1.0e21) { return fail("an exponent round-trips") }
    // Thirteen digits overflowed the old parser's 32-bit mantissa.
    if (optionOr("1234567890123".parseFloat(), 0.0) != 1234567890123.0) {
        return fail("a long mantissa parses")
    }
    if (optionIsNone("1.5kg".parseFloat()) == false) { return fail("trailing text is not a number") }
    if (optionIsNone(" 1.5".parseFloat()) == false) { return fail("leading space is not a number") }

    // -- UTF-8 --------------------------------------------------------------
    let accented = "héllo wörld"
    if (accented.length != 13) { return fail("length is bytes") }
    if (accented.scalarCount != 11) { return fail("scalarCount is characters") }
    if (accented.isValidUtf8 == false) { return fail("valid UTF-8") }
    if (accented.isAscii) { return fail("not ASCII") }
    if ("plain".isAscii == false) { return fail("ASCII") }

    // Reversing bytes would put half of an `é` where a character belongs.
    if (accented.reverse().equals("dlröw olléh") == false) { return fail("reverse moves characters") }
    if (accented.reverse().isValidUtf8 == false) { return fail("reverse leaves valid UTF-8") }
    if ("abc".reverse().equals("cba") == false) { return fail("reverse on ASCII") }

    if (accented.scalarAt(1) != 233) { return fail("é is U+00E9") }
    if (accented.scalarWidthAt(1) != 2) { return fail("é is two bytes") }
    if (accented.isCharBoundary(1) == false) { return fail("byte 1 begins a character") }
    if (accented.isCharBoundary(2)) { return fail("byte 2 is inside one") }
    if (accented.scalarSubstring(1, 4).equals("éllo") == false) { return fail("scalarSubstring") }

    if (strFromScalar(233).equals("é") == false) { return fail("encode two bytes") }
    if (strFromScalar(128169).length != 4) { return fail("encode four bytes") }
    if (strFromScalar(233).scalarAt(0) != 233) { return fail("encode and decode agree") }
    // A surrogate is not a scalar and encodes as U+FFFD rather than as bytes no
    // reader could take.
    if (strFromScalar(55296).scalarAt(0) != 65533) { return fail("a surrogate is refused") }

    let marks = accented.scalars()
    if (marks.length != 11) { return fail("scalars decodes every character") }
    if (marks[1] != 233) { return fail("scalars keeps order") }

    // A width is characters, so a padded column lines up whatever alphabet it is
    // in. Counted in bytes, this string is two short.
    if (accented.padStart(13, '.').scalarCount != 13) { return fail("padStart counts characters") }
    if (accented.padEnd(13, '.').scalarCount != 13) { return fail("padEnd counts characters") }
    if ("ab".padCenter(6, '-').equals("--ab--") == false) { return fail("padCenter") }

    // -- Parsing, with the range checked ------------------------------------
    if (optionOr("42".parseInt(), 0) != 42) { return fail("parseInt") }
    if (optionOr("-42".parseInt(), 0) != 0 - 42) { return fail("parseInt negative") }
    if (optionIsNone("99999999999".parseInt()) == false) { return fail("overflow is None") }
    if (optionIsNone("2147483648".parseInt()) == false) { return fail("Int max + 1 is None") }
    if (optionOr("2147483647".parseInt(), 0) != 2147483647) { return fail("Int max parses") }
    // `-2147483648` is folded into the literal by the parser, so it fits `Int`.
    // `0 - 2147483648` does not and is a diagnostic: the operand alone is out of
    // range, exactly as it is in Rust.
    if (optionOr("-2147483648".parseInt(), 0) != -2147483648) { return fail("Int min parses") }
    if (optionIsNone("banana".parseInt()) == false) { return fail("text is not a number") }
    if (optionIsNone("".parseInt()) == false) { return fail("empty is not a number") }

    let biggest = optionOr("18446744073709551615".parseU64(), 0 as U64)
    if (biggest != 18446744073709551615) { return fail("U64 max parses") }
    if (optionIsNone("18446744073709551616".parseU64()) == false) { return fail("U64 max + 1 is None") }
    if (optionIsNone("-1".parseU64()) == false) { return fail("unsigned has no negative") }

    // min + max == -1 exactly, in two's complement. Spelled with casts because a
    // bare `0 - 1` is an `Int` and this comparison is between I64s.
    let smallest = optionOr("-9223372036854775808".parseI64(), 0 as I64)
    let largest = optionOr("9223372036854775807".parseI64(), 0 as I64)
    if (smallest + largest != (0 as I64) - (1 as I64)) { return fail("I64 min parses") }
    if (optionIsNone("9223372036854775808".parseI64()) == false) { return fail("I64 max + 1 is None") }

    if (optionOr("ff".parseInt(16), 0) != 255) { return fail("hex") }
    if (optionOr("FF".parseInt(16), 0) != 255) { return fail("hex is case-insensitive") }
    if (optionOr("1010".parseInt(2), 0) != 10) { return fail("binary") }
    if (optionIsNone("12".parseInt(99)) == false) { return fail("a radix out of range is None") }
    if (optionIsNone("2".parseInt(2)) == false) { return fail("a digit the radix has no room for") }

    // -- Radix formatting ---------------------------------------------------
    if ((255 as U64).toHex().equals("ff") == false) { return fail("strHex") }
    if ((5 as U64).toBinary().equals("101") == false) { return fail("strBinary") }
    if ((8 as U64).toOctal().equals("10") == false) { return fail("strOctal") }
    if ((0 - 255).toString(16).equals("-ff") == false) { return fail("a negative in hex") }
    if (optionOr((123456).toString(36).parseInt(36), 0) != 123456) {
        return fail("radix round-trips")
    }
    if ((255 as U64).toHex().equals("ff") == false) { return fail("U64.toHex") }

    println("test_135 ok")
    return 0
}
