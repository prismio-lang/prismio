// M4.1 -- first-class, handle-based List slices.
//
// This fixture deliberately crosses every representation boundary the feature
// has: scalar, String, inline struct, a Slice field, a generic function, a
// returned view, a nested view, overlapping mutation, and List growth after the
// view was formed. Keeping the final case correct is the reason a Slice stores
// the List handle instead of an interior pointer.

import std.io
import std.string

struct Point {
    x: Int,
    y: Int
}

struct Window {
    view: Slice<Point>
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn middle(points: Vec<Point>) -> Slice<Point> {
    return points[1..<4]
}

fn first<T>(items: Slice<T>) -> T {
    return items[0]
}

fn pointSum(items: Slice<Point>) -> Int {
    let mut total = 0
    let mut i = 0
    while (i < items.length) {
        let point = items[i]
        total = total + point.x + point.y
        i = i + 1
    }
    return total
}

fn main() -> Int {
    let mut points: Vec<Point> = []
    points.push(Point { x: 0, y: 10 })
    points.push(Point { x: 1, y: 11 })
    points.push(Point { x: 2, y: 12 })
    points.push(Point { x: 3, y: 13 })

    let view = middle(points)
    let nested = view[1..<3]
    let window = Window { view: nested }
    if (view.length != 3 or window.view.length != 2) {
        return fail("slice lengths")
    }
    if (first(window.view).x != 2) {
        return fail("generic Slice<T> parameter")
    }

    // The next push grows the inline element block from capacity 4 to 8. A raw
    // interior pointer would now be dangling; resolving through the handle must
    // still find points[1..4].
    points.push(Point { x: 4, y: 14 })
    points.push(Point { x: 5, y: 15 })
    if (pointSum(view) != 42) {
        return fail("view did not survive List growth")
    }

    // Overlapping mutable views are legal. Both writes resolve the current List
    // block, and the second sees the first's update through the overlap.
    let mut left = points[1..<4]
    let right = points[2..<5]
    left[1] = Point { x: 20, y: 2 }
    if (right[0].x != 20 or points[2].y != 2) {
        return fail("overlapping mutable views")
    }

    let mut nums: Vec<Int> = []
    nums.push(7)
    nums.push(8)
    nums.push(9)
    let mut numView = nums[1..<3]
    numView[0] = 80
    if (numView[0] != 80 or nums[1] != 80) {
        return fail("scalar slice read/write")
    }

    let mut words: Vec<String> = []
    words.push("zero")
    words.push("one")
    words.push("two")
    let mut wordView = words[1..<3]
    if (wordView[1].equals("two") == false) {
        return fail("String slice read")
    }
    // A String slot holds the pair itself, so a write through the slice takes
    // the pair entry point rather than the boxed one.
    wordView[0] = "uno"
    if (words[1].equals("uno") == false) {
        return fail("String slice write")
    }

    // A struct holding a String is not flat, so its list stays boxed: the one
    // slice read left on `list_slice_get` now that String elements are pairs.
    let mut tags: Vec<Tagged> = []
    let mut t = 0
    while (t < 3) {
        tags.push(Tagged { name: t.toString(), rank: t })
        t = t + 1
    }
    let tagView = tags[1..<3]
    if (tagView[1].rank != 2) {
        return fail("boxed slice read")
    }

    println("PASS: slices")
    return 0
}

struct Tagged {
    name: String,
    rank: Int
}
