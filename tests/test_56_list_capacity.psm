// `list_new_with_capacity(n)` -- Vec::with_capacity's equivalent.
//
// A library call, not an annotation: the argument is a value rather than a fact
// the analysis has to trust, and a wrong hint costs memory or a reallocation and
// never correctness. That is what keeps it outside SPEC 5's budget of four.
//
// Worth 0.926x on aif/evidence/xlang/prismio/g2.psm, whose `cull` builds a fresh
// ~501-element list every frame for 20 000 frames and paid seven reallocations
// and 508 pointer copies each time.
//
// What this fixture asserts, and each one is a way the feature could be wrong
// while still looking as though it worked:
//
//   1. A pre-sized list behaves exactly as a `list_new()` one -- same length,
//      same elements, same order.
//   2. It grows correctly *past* its hint. The hint is not a bound, and a
//      capacity that stopped accepting pushes would pass any test that only
//      filled it to n.
//   3. A zero or negative hint is clamped, not honoured. `list_new_with_capacity(0)`
//      is what a computed count produces when it comes out empty, and a
//      zero-length block would make the first push double 0 to 0 forever --
//      an infinite loop or a heap overwrite, depending on the allocator.
//   4. The elements are still owned and released by the container. A second
//      constructor that did not stamp the element disposition would leak every
//      element of every pre-sized list, which no value assertion here can see;
//      run under --verify, the leak count is the detector.
//
// The values are asserted by the program itself, so a miscompile is an exit code
// rather than a number nobody reads.

import std.io
extern fn print(s: String)
extern fn println(s: String)

struct Item {
    id: Int,
    weight: Int
}

fn fail(what: String) -> Int {
    print("FAIL ")
    println(what)
    return 1
}

// 1. Same observable behaviour as list_new(), at the hinted size.
fn exact_fit() -> Int {
    let mut xs: List<Item> = list_new_with_capacity(8)
    let mut i = 0
    while (i < 8) {
        list_push(xs, Item { id: i, weight: i * 3 })
        i = i + 1
    }
    if (list_len(xs) != 8) { return fail("exact_fit length") }
    let mut sum = 0
    let mut j = 0
    while (j < 8) {
        sum = sum + list_get(xs, j).weight
        j = j + 1
    }
    // 0+3+6+...+21
    if (sum != 84) { return fail("exact_fit sum") }
    return 0
}

// 2. The hint is not a bound. 200 pushes into a list hinted at 8 must still
//    arrive in order -- this is the assertion a "capacity means limit"
//    implementation fails and a "capacity means initial size" one passes.
fn grows_past_the_hint() -> Int {
    let mut xs: List<Item> = list_new_with_capacity(8)
    let mut i = 0
    while (i < 200) {
        list_push(xs, Item { id: i, weight: i })
        i = i + 1
    }
    if (list_len(xs) != 200) { return fail("grows_past_the_hint length") }
    if (list_get(xs, 0).id != 0) { return fail("grows_past_the_hint first") }
    if (list_get(xs, 199).id != 199) { return fail("grows_past_the_hint last") }
    // Order across every reallocation boundary, not just the ends.
    let mut k = 0
    while (k < 200) {
        if (list_get(xs, k).id != k) { return fail("grows_past_the_hint order") }
        k = k + 1
    }
    return 0
}

// 3. A non-positive hint is clamped. Without the clamp the first push doubles a
//    capacity of 0 to 0 and never makes room.
fn zero_hint_is_clamped() -> Int {
    let mut xs: List<Item> = list_new_with_capacity(0)
    let mut i = 0
    while (i < 10) {
        list_push(xs, Item { id: i, weight: i })
        i = i + 1
    }
    if (list_len(xs) != 10) { return fail("zero_hint length") }
    if (list_get(xs, 9).id != 9) { return fail("zero_hint last") }

    let mut ys: List<Item> = list_new_with_capacity(0 - 5)
    list_push(ys, Item { id: 42, weight: 1 })
    if (list_get(ys, 0).id != 42) { return fail("negative_hint") }
    return 0
}

// 4. A computed hint, which is the shape the g2 measurement is about: the caller
//    knows the count only at run time.
fn computed_hint(n: Int) -> List<Item> {
    let mut xs: List<Item> = list_new_with_capacity(n)
    let mut i = 0
    while (i < n) {
        list_push(xs, Item { id: i, weight: n - i })
        i = i + 1
    }
    return xs
}

fn main() -> Int {
    let mut bad = 0
    bad = bad + exact_fit()
    bad = bad + grows_past_the_hint()
    bad = bad + zero_hint_is_clamped()

    let built = computed_hint(37)
    if (list_len(built) != 37) { bad = bad + fail("computed_hint length") }
    if (list_get(built, 36).weight != 1) { bad = bad + fail("computed_hint tail") }

    if (bad != 0) { return 1 }
    println("test_56 ok")
    return 0
}
