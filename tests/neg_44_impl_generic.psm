// Trait arguments are checked against the declaration's parameter arity.
// expect-error: takes trait parameters <>
struct Box<T> {
    value: T
}

trait Readable {
    fn get(self) -> Int
}

impl Readable<Int> for Box<Int> {
    fn get(self) -> Int { return 0 }
}

fn main() -> Int {
    return 0
}
