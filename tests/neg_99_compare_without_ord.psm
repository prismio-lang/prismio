// expect-error: cannot compare struct values directly
// A struct with no `Ord` implementation has no meaning for `<`, so the operator
// is refused and the note says what would give it one.
struct Point { x: Int }

fn main() -> Int {
    let a = Point { x: 1 }
    let b = Point { x: 2 }
    if (a < b) { return 1 }
    return 0
}
