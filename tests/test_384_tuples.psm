// Tuples: `(Int, String)`, `(1, "a")`, `t.0`, `let (a, b) = t`. A tuple is a generic struct with numbered
// fields (std/tuple.psm) and the parser writes the spellings that mean it (parse/tuples.psm), so what is
// asserted here is that it behaves as that struct does -- and that the file never imported std.tuple.
//
//   return and bind    `-> (Int, Int)`, `let (q, r) = f()`, `let t = f()` then `t.0`
//   places             a tuple in a struct field, a Vec, a parameter and a `sink` parameter; `t.0 = 7`
//   nesting            `((1, 2), 3)` taken apart as `let ((a, b), c)`; a struct pattern inside a tuple
//   owned elements     a `String` and a `Vec` returned in a tuple, built in a loop, `--verify`: 0 leaked
//   traits             Copy (what a `Vec` of tuples needs), and Eq element by element: `.eq` and `==`

import std.io
import std.string
import std.vec

struct Edge { ends: (Int, Int), label: (String, Int) }
struct Point { x: Int, y: Int }

fn divmod(a: Int, b: Int) -> (Int, Int) { return (a / b, a % b) }

fn swap(p: (Int, Int)) -> (Int, Int) { return (p.1, p.0) }

fn named(i: Int) -> (String, Vec<String>, Int) {
    let tags: Vec<String> = ["a", "b"]
    return ("n".concat(i.toString()), tags, i)
}

fn take(sink t: (String, Int)) -> Int { return t.1 }

fn fail(what: String) -> Int {
    println("FAIL: ".concat(what))
    return 1
}

fn main() -> Int {
    let mut bad = 0

    let (q, r) = divmod(17, 5)
    if (q != 3 or r != 2) { bad = bad + fail("return and destructure") }
    let t = divmod(9, 4)
    if (t.0 != 2 or t.1 != 1) { bad = bad + fail("element access") }

    let e = Edge { ends: (1, 2), label: ("e", 5) }
    let (a, b) = swap(e.ends)
    if (a != 2 or b != 1 or take(e.label) != 5) { bad = bad + fail("tuples as fields and arguments") }
    let mut m = (1, 2)
    m.0 = 7
    if (m.0 != 7 or m.1 != 2) { bad = bad + fail("assigning an element") }

    let pairs: Vec<(Int, Int)> = [(1, 2), (3, 4)]
    let mut sum = 0
    for p in pairs { sum = sum + p.0 * p.1 }
    if (sum != 14) { bad = bad + fail("a Vec of tuples") }

    let ((x, y), z) = ((1, 2), 3)
    if (x + y + z != 6) { bad = bad + fail("nested tuples") }
    let nested = ((1, 2), 3)
    if (nested.0.1 != 2 or (nested.0).0 != 1 or nested.1 != 3) { bad = bad + fail("t.0.1") }
    let (Point { x: px, y: py }, k) = (Point { x: 4, y: 5 }, 1)
    if (px + py + k != 10) { bad = bad + fail("a struct pattern inside a tuple") }

    let same = (1, "a")
    if (same != (1, "a") or (1, 2) == (1, 3) or same.eq((1, "b"))) { bad = bad + fail("Eq, and == through it") }

    let mut total = 0
    for i in 0..<20 {
        let (name, tags, count) = named(i)
        total = total + name.length + tags.length + count
        let whole = named(i)
        total = total + whole.0.length + whole.2
    }
    if (total != 520) { bad = bad + fail("owned elements") }

    if (bad != 0) { return 1 }
    println("PASS: tuples")
    return 0
}
