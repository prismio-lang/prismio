// expect-error: a `step` must be positive
// expect-error: a range gives one value per iteration, but this loop names two
// expect-error: `for ... in` needs a String, Vec, Slice, array, Map, or a type implementing `Iterator`, found Int
// A literal step of zero or less is refused -- a range counts up. `(a, b)` is for
// a collection, and an Int is not one.
fn main() -> Int {
    let mut total = 0
    for i in 0..<10 step 0 { total += i }
    for i in 0..<10 step -2 { total += i }
    for (a, b) in 0..<3 { total += a }
    let count = 5
    for x in count { total += 1 }
    return total
}
