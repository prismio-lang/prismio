// v0.1 3.2 -- `impl` blocks, and the parser gap that made them half-useful.
//
// An `impl` block is a naming construct over the method call rewrite: `x.f(a)`
// is already `f(x, a)`, so a method is a free function whose first parameter is
// the receiver and an `impl` block is somewhere to write one without repeating
// the type. What this asserts is that the lowering is exactly that -- the same
// function, reachable both ways, overloadable across types, and callable on a
// literal.

import std.io
import std.string
import std.option

struct Point {
    x: Int,
    y: Int
}

impl Point {
    fn shifted(self, dx: Int, dy: Int) -> Point {
        return Point { x: self.x + dx, y: self.y + dy }
    }

    fn sum(self) -> Int {
        return self.x + self.y
    }

    // A method with no receiver at all. `impl` is a naming construct, so an
    // associated function is just a function that happens to be written inside
    // one -- there is nothing for it to be except a free function.
    fn origin() -> Point {
        return Point { x: 0, y: 0 }
    }
}

impl String {
    fn trimmed(self) -> String {
        return strTrim(self)
    }

    fn size(self) -> Int {
        return strLength(self)
    }
}

// The same method name on a second type. This is the case that decides whether
// `impl` is a naming construct over overloading or a dispatch mechanism of its
// own: two `size` methods must resolve by argument type like any other overload.
impl Point {
    fn size(self) -> Int {
        return 2
    }
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let p = Point { x: 1, y: 2 }

    // Method syntax and the free-function spelling are the same function.
    if (p.sum() != 3) { return fail("p.sum()") }
    if (sum(p) != 3) { return fail("sum(p) -- a method is a free function") }

    // Arguments after the receiver, and chaining.
    let q = p.shifted(10, 20)
    if (q.x != 11 or q.y != 22) { return fail("shifted") }
    if (p.shifted(1, 1).sum() != 5) { return fail("chained method call") }

    // An associated function, called by name.
    if (origin().sum() != 0) { return fail("origin()") }

    // Overload resolution across two `impl` blocks.
    if (p.size() != 2) { return fail("Point.size") }
    if ("abcd".size() != 4) { return fail("String.size on a literal") }

    // v0.1 3.6. A postfix `.` directly on a literal used to be a parse error,
    // which made `impl String` unusable for exactly the expressions it exists
    // for. The receiver no longer has to be a name.
    if (strEquals("  hi  ".trimmed(), "hi") == false) { return fail("literal receiver") }

    // The same gap in its other two spellings.
    if ((p.shifted(1, 1)).sum() != 5) { return fail("parenthesised receiver") }
    if ([1, 2, 3][1] != 2) { return fail("index on an array literal") }

    // v0.1 3.2's `Update`: the standard library's own method surface. These are
    // wrappers over `str*`, so what is asserted is that the wrapper is the same
    // function -- not that `strTrim` still works, which test_75 covers.
    if (strEquals("  pad  ".trim(), "pad") == false) { return fail("String.trim") }
    if ("prismio".startsWith("pris") == false) { return fail("String.startsWith") }
    if ("prismio".indexOf("mio") != 4) { return fail("String.indexOf") }
    if (strEquals("a-b".replaceAll("-", "+"), "a+b") == false) { return fail("String.replaceAll") }
    // Bound rather than nested. An owned temporary passed straight into a call
    // is not released -- the same leak `list_len(strSplit(...))` has had all
    // along, and unrelated to `impl`; binding it keeps this fixture clean under
    // `--verify` so a future leak here means something.
    let parts = "a,b,c".split(',')
    if (list_len(parts) != 3) { return fail("String.split") }
    if (optionOr("42".parseInt(), 0) != 42) { return fail("String.parseInt") }
    // Bound for the same reason, and this one is worth naming: the intermediate
    // of a *chain* is an owned temporary passed straight into the next call, and
    // TODO.md's "argument-position release is withheld when the enclosing call
    // returns a pointer" is exactly that shape. Chaining is the idiom `impl`
    // blocks exist for, so that open item is now on the main road rather than a
    // side street -- but it predates this change and the leak is byte-for-byte
    // the one `strReverse(strToUpper("ab"))` already had.
    let upper = "ab".toUpper()
    if (strEquals(upper.reverse(), "BA") == false) { return fail("chained String methods") }

    println("test_86 ok")
    return 0
}
