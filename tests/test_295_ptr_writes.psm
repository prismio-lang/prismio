// `Ptr<mut T>` written through, docs/PTR_PLAN.md stage 3. The stores go through typed
// pointers and are checked from outside them, with raw loads of the same bytes, so what is
// proved is where each store lands and how wide it is: a field is written where it lies, a
// nested struct's field through the parent, a scalar by `store`, and a pointer field with
// a `Ptr<mut T>` that loses its `mut` on the way in.
//
//   Packet (repr(C), 24 bytes)         Header (repr(C), 12 bytes)
//   +0  header: Header ----------->      +0  magic:  U32
//   +12 tag: U8                          +4  length: U32
//   +16 next: Ptr<Packet>?               +8  flags:  U16
import std.raw

repr(C) struct Header {
    magic: U32,
    length: U32,
    flags: U16,
}

repr(C) struct Packet {
    header: Header,
    tag: U8,
    next: Ptr<Packet>?,
}

extern fn calloc(count: Usize, size: Usize) -> Ptr<mut Packet>
extern fn malloc(size: Usize) -> Ptr<mut Int>
extern fn free(block: Ptr)

fn init(p: Ptr<mut Header>) {
    p.magic = 0x5052534D
    p.length = 12
    p.flags = 513
}

fn bump(p: Ptr<mut Header>) {
    p.length = p.length + 1
    p.flags = p.flags + 1
}

fn put(n: Ptr<mut Int>, value: Int) { n.store(value) }

fn fail(code: Int) -> Int { return code }

fn main() -> Int {
    let packet = calloc(1, 24)
    let base = addressOf(packet)

    // Zeroed memory: the pointer field is absent, so `T?` reads as none.
    if packet.next != none { return fail(1) }

    init(packet.header)
    if volatileLoadU32(base) != 0x5052534D { return fail(2) }
    if volatileLoadU32(base + 4) != 12 { return fail(3) }
    if volatileLoadU16(base + 8) != 513 { return fail(4) }

    // A field read and written in one statement: the write sees the read.
    bump(packet.header)
    if volatileLoadU32(base + 4) != 13 { return fail(5) }
    if volatileLoadU16(base + 8) != 514 { return fail(6) }

    // A scalar field of the parent, and a field two levels in.
    packet.tag = 7
    if volatileLoadU8(base + 12) != 7 { return fail(7) }
    packet.header.magic = 99
    if volatileLoadU32(base) != 99 { return fail(8) }

    // A store is exactly the field's width: the neighbours are untouched.
    if volatileLoadU32(base + 4) != 13 { return fail(9) }

    // A pointer field takes a pointer, and `mut` is dropped on the way in.
    packet.next = packet
    if packet.next == none { return fail(10) }

    let n = malloc(4)
    put(n, 40)
    if n + 2 != 42 { return fail(11) }
    n.store(n + 5)
    if n.load() != 45 { return fail(12) }
    if volatileLoadU32(addressOf(n)) != 45 { return fail(13) }

    free(n)
    free(packet)
    return 0
}
