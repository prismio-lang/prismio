// Ownership and boundary regression for the pure-Prismio std.string producers.
// Every allocation is bound so `--verify` must finish with a clean ledger.

import std.string

fn main() -> Int {
    if ("abc".charAt(1) != 'b') { return 1 }
    if ("abc".charAt(9) != '\0') { return 2 }
    if ("same".equals("same") == false) { return 3 }
    if ("same".equals("some")) { return 4 }
    if ("abc".compare("abd") >= 0) { return 5 }
    if ("abc".compare("ab") <= 0) { return 6 }

    let empty = "".clone()
    if (empty.length != 0) { return 7 }
    let cloned = "copy".clone()
    if (cloned.equals("copy") == false) { return 8 }
    let one = 'Q'.toString()
    if (one.equals("Q") == false) { return 9 }
    let nul = '\0'.toString()
    if (nul.length != 0) { return 25 }
    let joined = "left".concat("right")
    if (joined.equals("leftright") == false) { return 10 }

    let slice = "abcdef".substring(2, 3)
    if (slice.equals("cde") == false) { return 11 }
    let clamped = "abcdef".substring(4, 99)
    if (clamped.equals("ef") == false) { return 12 }
    let missing = "abcdef".substring(99, 2)
    if (missing.length != 0) { return 13 }
    let negative = "abcdef".substring(2, 0 - 1)
    if (negative.length != 0) { return 14 }

    let trimmed = "  text  ".trim()
    if (trimmed.equals("text") == false) { return 15 }
    let padded = "7".padStart(3, '0')
    if (padded.equals("007") == false) { return 16 }
    let unchanged = "wide".padEnd(2, '.')
    if (unchanged.equals("wide") == false) { return 17 }
    let first = "a-b-c".replaceFirst("-", "+")
    if (first.equals("a+b-c") == false) { return 18 }
    let all = "a-b-c".replaceAll("-", "++")
    if (all.equals("a++b++c") == false) { return 19 }

    let parts = "a,bb,ccc".split(',')
    if (parts.length != 3) { return 20 }
    if (parts[1].equals("bb") == false) { return 21 }
    let rejoined = parts.join(",")
    if (rejoined.equals("a,bb,ccc") == false) { return 22 }

    let onSep = "a::b::c".splitOn("::")
    if (onSep.length != 3) { return 23 }
    let words = "  one  two ".splitWhitespace()
    if (words.length != 2) { return 24 }

    return 0
}
