import std.io
fn max(a: Int, b: Int) -> Int {
    if (a > b) {
        return a
    } else {
        return b
    }
}

fn test_nested_if(x: Int) -> Int {
    if (x > 10) {
        if (x > 20) {
            return 2
        } else {
            return 1
        }
    } else {
        return 0
    }
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    if (max(5, 10) != 10) {
        return fail("max should choose the larger right-hand value")
    }

    if (max(12, 3) != 12) {
        return fail("max should choose the larger left-hand value")
    }

    if (test_nested_if(5) != 0) {
        return fail("nested if should return 0 for low values")
    }

    if (test_nested_if(15) != 1) {
        return fail("nested if should return 1 for mid values")
    }

    if (test_nested_if(25) != 2) {
        return fail("nested if should return 2 for high values")
    }

    println("PASS: if and else")
    return 0
}
