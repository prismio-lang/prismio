// `std.unicode`: what a reader sees, as against what a String stores.
//
// Three counts, all of them right for different questions -- `"é"` typed as `e`
// and a combining acute is 3 bytes, 2 scalars and 1 grapheme -- plus the two
// normal forms, which are what makes the two spellings of that string comparable
// at all.
//
// The range tables are generated from the Unicode database
// (`tools/generate_unicode_tables.py`), so the values asserted here are the
// standard's, not a guess about it.

import std.io
import std.string
import std.unicode
import std.unicode_tables

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    // -- Display width -------------------------------------------------------
    if (scalarWidth(97) != 1) { return fail("ASCII is one column") }
    if (scalarWidth(26085) != 2) { return fail("a CJK ideograph is two") }
    if (scalarWidth(769) != 0) { return fail("a combining mark is none") }
    if (scalarWidth(9) != 0) { return fail("a control character is none") }

    if ("abc".displayWidth != 3) { return fail("width of ASCII") }
    if ("日本".displayWidth != 4) { return fail("width of CJK") }
    if ("日本".length != 6) { return fail("bytes of CJK") }
    if ("日本".scalarCount != 2) { return fail("scalars of CJK") }

    // A letter and its combining mark occupy the letter's column.
    let decomposed = "é"
    if (decomposed.length != 3) { return fail("bytes of a decomposed é") }
    if (decomposed.scalarCount != 2) { return fail("scalars of a decomposed é") }
    if (decomposed.displayWidth != 1) { return fail("width of a decomposed é") }
    if (decomposed.graphemeCount != 1) { return fail("graphemes of a decomposed é") }

    // -- Grapheme clusters ---------------------------------------------------
    if ("abc".graphemeCount != 3) { return fail("ASCII graphemes") }
    // A flag is a pair of regional indicators, and one character to a reader.
    if ("🇯🇵".scalarCount != 2) { return fail("scalars in a flag") }
    if ("🇯🇵".graphemeCount != 1) { return fail("a flag is one grapheme") }
    // Two flags are two, which is what the pairing rule is for.
    if ("🇯🇵🇫🇷".graphemeCount != 2) { return fail("two flags are two graphemes") }
    // A ZWJ sequence is one however many scalars it names.
    if ("👨‍👩‍👧".graphemeCount != 1) { return fail("a ZWJ family is one grapheme") }
    if ("👍🏽".graphemeCount != 1) { return fail("a skin tone joins its emoji") }
    // Hangul jamo compose into a syllable.
    if ("각".graphemeCount != 1) { return fail("Hangul jamo are one grapheme") }

    let parts = "a🇯🇵b".graphemes()
    if (parts.length != 3) { return fail("graphemes splits into clusters") }

    // -- Columns, not characters ---------------------------------------------
    if ("日本".padEndDisplay(8, '.').equals("日本....") == false) {
        return fail("padding to a column count")
    }
    if ("日本語です".truncateToWidth(4).equals("日本") == false) {
        return fail("truncating to a column count")
    }
    // Never mid-character, whatever the budget.
    if ("日本語".truncateToWidth(3).equals("日") == false) {
        return fail("an odd budget cuts at a boundary")
    }

    // -- Normalization -------------------------------------------------------
    let composed = "é"
    if ((composed == decomposed)) { return fail("the two spellings differ as bytes") }
    if (composed.equalsNormalized(decomposed) == false) {
        return fail("and are the same text")
    }
    if (decomposed.normalizeNfc().equals(composed) == false) { return fail("NFD to NFC") }
    if (composed.normalizeNfd().equals(decomposed) == false) { return fail("NFC to NFD") }

    // Idempotent, which is what makes it a normal *form*. Bound for reading, not
    // for the ledger: an owned result passed straight into another call is
    // released after it (developers.prismio.org/runtime/supported-surface), so
    // the nested spelling is equally clean under `--verify`.
    let once = decomposed.normalizeNfc()
    let twice = once.normalizeNfc()
    if (twice.equals(composed) == false) { return fail("NFC is idempotent") }

    // Canonical ordering: two marks in either order normalize alike.
    let dotAboveFirst = "q̣̇"
    let dotBelowFirst = "q̣̇"
    let orderedA = dotAboveFirst.normalizeNfd()
    let orderedB = dotBelowFirst.normalizeNfd()
    if (orderedA.equals(orderedB) == false) { return fail("marks are canonically ordered") }

    // Hangul composes by arithmetic rather than from a table.
    if ("각".normalizeNfc().equals("각") == false) { return fail("Hangul composes") }
    if ("각".normalizeNfd().scalarCount != 3) { return fail("Hangul decomposes") }

    // A singleton decomposition is excluded from composition: the Angstrom sign
    // normalizes to A-with-ring and does not come back.
    if ("Å".normalizeNfc().equals("Å") == false) { return fail("a singleton is excluded") }

    // Canonical, not compatibility: NFC must leave `ﬁ` alone.
    if ("ﬁ".normalizeNfc().equals("ﬁ") == false) { return fail("NFC is not NFKC") }

    // -- The pinned database -------------------------------------------------
    if (unicodeVersion().equals("18.0.0") == false) { return fail("tables are Unicode 18.0.0") }

    // An unassigned scalar is one column. The tables once came from a Python
    // whose database called every unassigned code point Fullwidth.
    if (scalarWidth(888) != 1) { return fail("unassigned U+0378 is one column") }
    // SOFT HYPHEN is a format character that terminals draw.
    if (scalarWidth(173) != 1) { return fail("U+00AD is one column") }
    // A syllable typed as conjoining jamo is its leading consonant's two columns.
    if ("\u{1100}\u{1161}\u{11A8}".displayWidth != 2) { return fail("jamo take two columns") }

    // An emoji sequence is one picture, two columns, however many scalars.
    if ("👨‍👩‍👧".displayWidth != 2) { return fail("a ZWJ family is two columns") }
    if ("👍🏽".displayWidth != 2) { return fail("a skin-toned emoji is two columns") }
    if ("\u{A9}\u{FE0F}".displayWidth != 2) { return fail("VS16 makes an emoji two columns") }
    if ("\u{A9}".displayWidth != 1) { return fail("text presentation stays one column") }

    // -- UAX #29, the rules the old subset did not have ------------------------
    if ("\r\n".graphemeCount != 1) { return fail("GB3: CR LF is one grapheme") }
    if ("\n\u{301}".graphemeCount != 2) { return fail("GB4: nothing extends a control") }
    // GB11 joins only a pictograph to a pictograph: a ZWJ between letters does not.
    if ("a\u{200D}b".graphemeCount != 2) { return fail("GB11: ZWJ joins pictographs only") }
    // GB9b: ARABIC NUMBER SIGN is Prepend, and joins what follows it.
    if ("\u{600}1".graphemeCount != 1) { return fail("GB9b: Prepend joins forward") }
    // GB9c: KA, VIRAMA, SSA is one conjunct.
    if ("\u{915}\u{94D}\u{937}".graphemeCount != 1) { return fail("GB9c: a conjunct is one grapheme") }
    // GB9a: a spacing mark continues its cluster.
    if ("\u{915}\u{93F}".graphemeCount != 1) { return fail("GB9a: SpacingMark joins") }

    println("test_137 ok")
    return 0
}
