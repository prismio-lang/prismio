// `Result.Ok(5)` and `Result.Err("x")` each name one of a generic enum's two type
// parameters, so the other is taken from the context: an annotation, an
// assignment's target, a return type, a struct field, or the parameter an
// argument is passed to. neg_185 is the one with no context at all.
import std.io
import std.option

enum Outcome<T, E> {
    Good(T),
    Bad(E)
}

struct Slot {
    held: Result<Int, String>
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn failed() -> Result<Int, String> { return Result.Err("a return type") }

fn orZero(r: Result<Int, String>) -> Int {
    match (r) {
        Result.Ok(x) => { return x }
        Result.Err(e) => { return 0 }
    }
}

fn main() -> Int {
    let e: Result<Int, String> = Result.Err("an annotation")
    if (e.isOk) { return fail("an annotation") }

    let mut f: Result<Int, String> = Result.Ok(3)
    f = Result.Err("an assignment")
    if (f.isOk) { return fail("an assignment") }

    if (failed().isOk) { return fail("a return type") }

    let slot = Slot { held: Result.Err("a struct field") }
    if (slot.held.isOk) { return fail("a struct field") }

    if (orZero(Result.Err("an argument")) + orZero(Result.Ok(5)) != 5) { return fail("an argument") }

    let r: Outcome<Int, String> = Outcome.Good(4)
    match (r) {
        Outcome.Good(x) => { if (x != 4) { return fail("a payload that names one parameter of two") } }
        Outcome.Bad(m) => { return fail("the wrong variant") }
    }

    println("test_175 ok")
    return 0
}
