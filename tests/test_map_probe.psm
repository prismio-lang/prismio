// Collision chains must survive wraparound, growth and overwrite without
// changing insertion order. A negative constant hash is a valid Key impl.
import std.io
import std.map
import std.key
import std.copy
import std.option

public struct CollidingKey { id: Int }

impl Key for CollidingKey {
    fn hash(self) -> Int { return -1 }
    fn eq(self, other: Self) -> Bool { return self.id == other.id }
}

impl Copy for CollidingKey {
    fn copyOf(self) -> Self { return CollidingKey { id: self.id } }
}

fn main() -> Int {
    let m = mapNew<CollidingKey, Int>()
    let mut i = 0
    while (i < 257) {
        if (m.set(CollidingKey { id: i }, i * 7) != none) { return 1 }
        if (m.count != i + 1) { return 2 }
        // Probe through the whole chain, including just after each growth.
        if (m.contains(CollidingKey { id: -1 })) { return 3 }
        let mut j = 0
        while (j <= i) {
            if (m.getOr(CollidingKey { id: j }, -1) != j * 7) { return 4 }
            j = j + 1
        }
        i = i + 1
    }
    let mut k = 256
    while (k >= 0) {
        if (m.set(CollidingKey { id: k }, -k) == none) { return 5 }
        k = k - 1
    }
    if (m.count != 257) { return 6 }
    let mut at = 0
    while (at < m.count) {
        let key = m.keyAt(at)
        if (key.id != at or m.valueAt(at) != -at) { return 7 }
        if (m.keyAt(at).id != at) { return 8 }
        at = at + 1
    }
    if ((m.get(CollidingKey { id: 0 }) == none)) { return 9 }
    if ((m.get(CollidingKey { id: 999 }) != none)) { return 10 }

    // Owned long String keys must remain valid across repeated rehashes.
    let names = mapNew<String, Int>()
    let mut n = 0
    while (n < 300) {
        let key = "a-long-owned-map-key-".concat(n.toString())
        names.set(key, n)
        n = n + 1
    }
    let mut q = 0
    while (q < 300) {
        let key = "a-long-owned-map-key-".concat(q.toString())
        if (names.getOr(key, -1) != q) { return 11 }
        if (names.set(key, q + 1) == none) { return 12 }
        if (names.valueAt(q) != q + 1) { return 13 }
        q = q + 1
    }
    if (names.count != 300) { return 14 }
    println("PASS: map probe, growth, order and owned keys")
    return 0
}
