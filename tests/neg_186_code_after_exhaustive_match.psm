// expect-error: unreachable code: control cannot continue past the previous statement
import std.option

fn orZero(r: Result<Int, String>) -> Int {
    match (r) {
        Result.Ok(x) => { return x }
        Result.Err(e) => { return 0 }
    }
    return -1
}

fn main() -> Int { return orZero(Result<Int, String>.Err("none")) }
