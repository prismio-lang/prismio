// An assignment re-initialises a binding it moved out of.
//
// `acc = f(acc)` is the functional-update idiom, and before M2.1c it could not be
// written at all. Move state is tracked per name over the AST in source order, so
// a move inside a loop body is seen once and executes on every iteration -- which
// is why `drop(b)` in a loop is an error and must stay one (neg_10). An
// assignment whose target *is* the binding it moved from is the exception: the
// store puts a fresh value in the slot before the next iteration reads it.
//
// Two things were wrong and both are fixed here:
//   * the move was reported as one that repeats, so the loop form was rejected;
//   * the name stayed moved-from afterwards, so every later use was "use of moved
//     value" -- which rejected the straight-line form too.
//
// **This fixture is discriminating by construction**: it does not compile on the
// generation before M2.1c, so a regression is a build failure rather than a
// wrong number. `neg_10_move_in_loop.psm` guards the other direction and must
// keep failing -- `drop(b)` in a loop is still a move that repeats.

import std.io
import std.string

enum Tree { Leaf, Node(Tree, Int, Tree) }

fn build(depth: Int, seed: Int) -> Tree {
    if (depth == 0) { return Tree.Leaf }
    return Tree.Node(build(depth - 1, seed * 2), seed, build(depth - 1, seed * 2 + 1))
}

fn mapAdd(sink t: Tree, k: Int) -> Tree {
    match (t) {
        Tree.Leaf => { return Tree.Leaf }
        Tree.Node(l, v, r) => { return Tree.Node(mapAdd(l, k), v + k, mapAdd(r, k)) }
    }
    return Tree.Leaf
}

fn sum(t: Tree) -> Int {
    match (t) {
        Tree.Leaf => { return 0 }
        Tree.Node(l, v, r) => { return sum(l) + v + sum(r) }
    }
    return 0
}

// The same workload written the way the language accepted before M2.1c, so the
// loop below has something to be checked against rather than a constant.
fn passes(sink t: Tree, n: Int) -> Tree {
    if (n == 0) { return t }
    return passes(mapAdd(t, 1), n - 1)
}

fn consumeStr(sink s: String) -> Int {
    return __builtin_string_len(s)
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let mut failures = 0

    // The loop form, and the straight-line use after it that the stale
    // moved-from state used to reject.
    let mut acc = build(4, 1)
    let mut i = 0
    while (i < 3) {
        acc = mapAdd(acc, 1)
        i = i + 1
    }
    let looped = sum(acc)

    // The same three passes as recursion, which is what the language allowed
    // before. Agreement is the assertion: a re-initialisation that lost or
    // duplicated an iteration would show up here and not in the compile.
    let viaRec = passes(build(4, 1), 3)
    if (looped != sum(viaRec)) { failures = failures + fail("loop and recursion disagree") }

    // A binding moved into a `sink` and then reused. Nothing to do with loops --
    // this is the half that made the *straight-line* form fail too.
    let mut s = strConcat("ab", "cd")
    let mut total = consumeStr(s)
    s = strConcat("ef", "gh")
    total = total + consumeStr(s)
    if (total != 8) { failures = failures + fail("sink then rebind") }

    // Re-initialised in a loop, read after it.
    let mut acc2 = strConcat("x", "y")
    let mut j = 0
    while (j < 4) {
        acc2 = strConcat(acc2, "z")
        j = j + 1
    }
    if (__builtin_string_len(acc2) != 6) { failures = failures + fail("string accumulator after loop") }

    if (failures == 0) { println("reinit assignment ok") }
    return failures
}
