// Escape sequences in string literals.
//
// Char literals decoded escapes from the start, but string literals kept the raw
// text: "a\nb" was the four characters a, backslash, n, b, and the backslash
// survived all the way into the emitted program. There was no way to put a
// newline, a tab or a quote inside a string at all -- only println() could
// produce a line break.
//
// The scanner also stops at the first unescaped quote only, so \" no longer ends
// the literal early.

import std.io
import std.string

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    // \n decodes to one character, not two
    let nl = "a\nb"
    if (__builtin_string_len(nl) != 3) {
        return fail("\\n should decode to a single character")
    }
    if (strCharAt(nl, 1) != '\n') {
        return fail("\\n decoded to the wrong character")
    }

    // \t
    let tab = "a\tb"
    if (__builtin_string_len(tab) != 3) {
        return fail("\\t should decode to a single character")
    }
    if (strCharAt(tab, 1) != '\t') {
        return fail("\\t decoded to the wrong character")
    }

    // \\ collapses to one backslash
    let back = "a\\b"
    if (__builtin_string_len(back) != 3) {
        return fail("\\\\ should decode to a single backslash")
    }
    if (strCharAt(back, 1) != '\\') {
        return fail("\\\\ decoded to the wrong character")
    }

    // \" does not terminate the literal
    let quoted = "say \"hi\""
    if (__builtin_string_len(quoted) != 8) {
        return fail("escaped quotes should not end the literal")
    }
    if (strCharAt(quoted, 4) != '"') {
        return fail("\\\" decoded to the wrong character")
    }

    // \r and \'
    if (strCharAt("x\ry", 1) != '\r') {
        return fail("\\r decoded to the wrong character")
    }
    if (strCharAt("x\'y", 1) != '\'') {
        return fail("\\' decoded to the wrong character")
    }

    // a windows-style path round-trips
    let path = "C:\\dir\\file.txt"
    if (strEquals(path, "C:\\dir\\file.txt") == false) {
        return fail("path with escaped backslashes did not round-trip")
    }
    if (__builtin_string_len(path) != 15) {
        return fail("path length after decoding is wrong")
    }

    // strings with no escapes still work (the fast path)
    let plain = "no escapes here"
    if (__builtin_string_len(plain) != 15) {
        return fail("plain string length changed")
    }

    // an empty string is still empty
    if (__builtin_string_len("") != 0) {
        return fail("empty string should stay empty")
    }

    // escapes reach the output: this prints two lines and a tab
    print("escaped output:\n\tindented\n")

    println("PASS: string escapes")
    return 0
}
