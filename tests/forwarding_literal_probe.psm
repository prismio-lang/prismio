// A value returned through a forwarding call may be a literal the caller passed.
// `wrap` returns `o ?? d`, which is `d` for `none`. Its return resolves to the
// sites of every String stored in any `String?` -- std's `stripPrefix` result
// among them -- so it looked owned, and the caller freed "fallback", which is
// .rodata. Run by `ownership_probes` under `--verify`.

import std.io
import std.option
import std.string

fn findLiteral(key: String) -> String? {
    if (key.equals("name")) { return "abc" }
    return none
}

fn wrap(o: String?, d: String) -> String { return o ?? d }

fn main() -> Int {
    let lost = findLiteral("other")
    println(wrap(lost, "fallback"))
    return 0
}
