// A flat element copied from one slot of its own list to another.
//
// A flat struct lives in the list's block, so `list_get` answers an address
// inside it, and `list_set_inline` released the source it had just copied from
// -- an interior pointer, which aborted in `free`. `list_release_source` now
// refuses an address inside the list's own block.
//
// Its own fixture rather than a section of test_144, because a list's
// representation is decided for the whole program: inside test_144 this same
// statement found the list boxed, where the interior case never arises.

import std.io

struct Pt {
    x: Int,
    y: Int
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let mut copies: Vec<Pt> = []
    copies.push(Pt { x: 1, y: 10 })
    copies.push(Pt { x: 2, y: 20 })
    copies.push(Pt { x: 3, y: 30 })
    copies[0] = copies[2]
    if (copies[0].x != 3 or copies[0].y != 30
            or copies[1].x != 2 or copies[2].y != 30) {
        return fail("a flat element copied within its own list")
    }
    println("PASS")
    return 0
}
