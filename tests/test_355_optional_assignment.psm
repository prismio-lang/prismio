// Assigning a value that is not a literal to a scalar optional.
//
// `found = 5` was wrapped into a present `Int?` and `found = n` was not: the check accepted it
// and the store wrote the bare value, so the optional read back as 0 or as `none`. The loop
// that remembers the last match is the usual shape, and std.json's `member` was the first
// thing to meet it.
//
// Every place a value can be stored: a local, a field, an element, and the result of a call;
// and `none` and an optional on the right, which are not wrapped again.

import std.io
import std.option
import std.vec

struct Slot { value: Int?, wide: I64? }

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn lastMatch(items: Vec<Int>, wanted: Int) -> Int? {
    let mut found: Int? = none
    for i in 0..<items.length {
        if (items[i] == wanted) { found = i }
    }
    return found
}

fn twice(n: Int) -> Int { return n * 2 }

fn main() -> Int {
    let mut bad = 0

    let n = 7
    let mut local: Int? = none
    local = n
    if (local.unwrapOr(0 - 1) != 7) { bad = bad + fail("a local variable into a local optional") }
    local = n + 1
    if (local.unwrapOr(0 - 1) != 8) { bad = bad + fail("an expression into a local optional") }
    local = twice(n)
    if (local.unwrapOr(0 - 1) != 14) { bad = bad + fail("a call result into a local optional") }

    let items: Vec<Int> = [4, 9, 4, 9]
    if (lastMatch(items, 4).unwrapOr(0 - 1) != 2) { bad = bad + fail("the last match in a loop") }
    if (lastMatch(items, 5) != none) { bad = bad + fail("no match stays none") }

    let slot = Slot { value: none, wide: none }
    slot.value = n
    if (slot.value.unwrapOr(0 - 1) != 7) { bad = bad + fail("a field") }
    let big: I64 = 5000000000
    slot.wide = big
    if (slot.wide.unwrapOr(0) != 5000000000) { bad = bad + fail("a wide field") }

    let mut row: Vec<Int?> = [none, none]
    row[1] = n
    if (row[1].unwrapOr(0 - 1) != 7 or row[0] != none) { bad = bad + fail("an element") }

    let other: Int? = 3
    local = other
    if (local.unwrapOr(0 - 1) != 3) { bad = bad + fail("an optional into an optional") }
    local = none
    if (local != none) { bad = bad + fail("none into an optional") }

    if (bad > 0) { return 1 }
    println("PASS: values stored into scalar optionals are wrapped")
    return 0
}
