// Atomics on a typed pointer, PTR_PLAN (removed; git history) stage 5: the integer the pointer points at,
// read and changed in one indivisible step, with the ordering written at the call. Values are
// checked here, and the orderings by the `typed_pointer_ir` harness test over
// tests/ptr_access_ir_probe.psm. A read-modify-write answers what was there before.
import std.raw

extern fn malloc(size: Usize) -> Ptr<mut Int>
extern fn free(block: Ptr)

fn fail(code: Int) -> Int { return code }

fn main() -> Int {
    let n = malloc(4)
    n.atomicStore(10, AtomicOrder.Release)
    if n.atomicLoad(AtomicOrder.Acquire) != 10 { return fail(1) }
    if n.atomicAdd(5, AtomicOrder.AcqRel) != 10 { return fail(2) }
    if n.atomicLoad(AtomicOrder.SeqCst) != 15 { return fail(3) }
    if n.atomicSub(3, AtomicOrder.Relaxed) != 15 { return fail(4) }
    if n.atomicSwap(100, AtomicOrder.SeqCst) != 12 { return fail(5) }
    if n.atomicAnd(0x0F, AtomicOrder.SeqCst) != 100 { return fail(6) }
    if n.atomicLoad(AtomicOrder.Relaxed) != 4 { return fail(7) }
    if n.atomicOr(0x30, AtomicOrder.SeqCst) != 4 { return fail(8) }
    if n.atomicXor(0x01, AtomicOrder.SeqCst) != 0x34 { return fail(9) }
    if n.load() != 0x35 { return fail(10) }

    // Compare-exchange answers what it found: the store happened when that is `expected`.
    if n.atomicCompareExchange(0x35, 7, AtomicOrder.AcqRel) != 0x35 { return fail(11) }
    if n.load() != 7 { return fail(12) }
    if n.atomicCompareExchange(0x35, 9, AtomicOrder.AcqRel) != 7 { return fail(13) }
    if n.load() != 7 { return fail(14) }

    // Fixed-width pointees: a byte and a 64-bit word.
    let bytes = Ptr<mut U8>.cast(n)
    if bytes.atomicAdd(1, AtomicOrder.SeqCst) != 7 { return fail(15) }
    if n.load() != 8 { return fail(16) }
    // malloc's block is aligned for any type; a `cast` from `Ptr<mut Int>` would promise 8
    // bytes of alignment from 4, so it is the caller's word.
    let wide = Ptr<mut U64>.castUnchecked(malloc(8))
    wide.atomicStore(1, AtomicOrder.SeqCst)
    if wide.atomicAdd(2, AtomicOrder.SeqCst) != 1 { return fail(17) }
    if wide.atomicLoad(AtomicOrder.SeqCst) != 3 { return fail(18) }

    free(n)
    return 0
}
