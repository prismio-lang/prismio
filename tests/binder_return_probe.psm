// A value unwrapped and returned on its own may be a literal the optional holds.
// `payloadOr` returns `expect(o)`, whose value set is every site ever stored into
// a `String?`, so it looked owned; the optional in hand holds a literal, and the
// caller freed it. Run by `ownership_probes` under `--verify`.

import std.io
import std.option
import std.string

fn findLiteral(key: String) -> String? {
    if (key.equals("name")) { return "a literal payload, past twelve bytes" }
    return none
}

fn payloadOr(o: String?) -> String {
    if (o == none) { return "".concat("") }
    return expect(o)
}

fn main() -> Int {
    let a = findLiteral("name")
    println(payloadOr(a))
    return 0
}
