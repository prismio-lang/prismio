import std.io
fn count_to(limit: Int) -> Int {
    let mut i = 0
    let mut sum = 0
    loop {
        if (i >= limit) {
            break
        }
        i = i + 1
        sum = sum + i
    }
    return sum
}

fn skip_evens() -> Int {
    let mut i = 0
    let mut odd_sum = 0
    while (i < 10) {
        i = i + 1
        if (i % 2 == 0) {
            continue
        }
        odd_sum = odd_sum + i
    }
    return odd_sum
}

fn nested() -> Int {
    let mut total = 0
    let mut a = 0
    while (a < 3) {
        let mut b = 0
        loop {
            if (b >= 3) {
                break
            }
            total = total + 1
            b = b + 1
        }
        a = a + 1
    }
    return total
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    if (count_to(5) != 15) {
        return fail("loop+break should sum 1..5 = 15")
    }
    if (skip_evens() != 25) {
        return fail("while+continue should sum odds = 25")
    }
    if (nested() != 9) {
        return fail("nested while+loop should count to 9")
    }
    println("PASS: loop/break/continue")
    return 0
}
