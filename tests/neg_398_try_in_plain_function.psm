// expect-error: the function must return a `Result`
import std.option
import std.string
// `?` on a `Result` hands the error out of the function, so the function has to be able to carry it.
fn parse(s: String) -> Result<Int, String> { return Result.Ok(1) }

fn main() -> Int {
    let n = parse("a")?
    return n
}
