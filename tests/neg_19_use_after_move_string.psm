// expect-error: use of moved value
// Strings are affine as of AIF Level 4, so binding one to a second name transfers
// ownership -- and the scope exit frees it exactly once, through the new name.
import std.io
import std.string

fn main() -> Int {
    let a = strConcat("ab", "cd")
    let b = a
    return __builtin_string_len(a)
}
