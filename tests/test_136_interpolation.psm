// `"${...}"` and the literal forms that arrived with it.
//
// Interpolation is a lexer mode and a parser rewrite: by the time sema sees one
// it is a `concat` call over `show(...)` of each value, so what this fixture has
// to pin down is the shape of that rewrite -- which parts survive, in what
// order, and that the values are converted through `Display` rather than by
// anything that only knows the builtins.

import std.io
import std.string
import std.display
import std.option

struct Point { x: Int, y: Int }

impl Display for Point {
    fn show(self) -> String {
        return "(".concat(strFromInt(self.x), ", ", strFromInt(self.y), ")")
    }
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let name = "world"
    let count = 42

    if (("hello, ${name}!" == "hello, world!") == false) { return fail("a value between text") }
    if (("${name}" == "world") == false) { return fail("a value alone") }
    if (("${name}${name}" == "worldworld") == false) { return fail("two values, no text between") }
    if (("no values here" == "no values here") == false) { return fail("a plain literal still lexes") }
    if (("" == "") == false) { return fail("the empty literal") }

    // Any expression, not just a name.
    if (("${count + 1}" == "43") == false) { return fail("an expression") }
    if (("${strFromInt(count)}" == "42") == false) { return fail("a call") }

    // Every builtin `Display` covers, and a user type through the same trait.
    if (("${count}" == "42") == false) { return fail("Int") }
    if (("${count > 40}" == "true") == false) { return fail("Bool") }
    if (("${'x'}" == "x") == false) { return fail("Char") }
    if (("${1.0 / 3.0}" == "0.3333333333333333") == false) { return fail("Float") }
    if (("${Point { x: 1, y: 2 }}" == "(1, 2)") == false) { return fail("a user type via Display") }

    // A struct literal's braces are counted, so the `}` that ends the
    // interpolation is the one at depth zero.
    let p = Point { x: 3, y: 4 }
    if (("at ${p} now" == "at (3, 4) now") == false) { return fail("braces inside the value") }

    // `\$` is how a literal `${` is written now that `${` means something. The
    // right side is built rather than written, because writing it would be the
    // very interpolation this is checking does not happen.
    let literalForm = "$".concat("{x}")
    if (("\${x}" == literalForm) == false) { return fail("an escaped interpolation") }

    // Past the largest `concat` overload, so the parts are joined in groups.
    let many = "a${1}b${2}c${3}d${4}e${5}f${6}g${7}h${8}i"
    if ((many == "a1b2c3d4e5f6g7h8i") == false) { return fail("more parts than concat takes") }

    // -- Literal forms -------------------------------------------------------
    if (0xFF != 255) { return fail("hex") }
    if (0xff != 255) { return fail("hex is case-insensitive") }
    if (0XDEADBEEF as I64 != 3735928559 as I64) { return fail("a wide hex literal") }
    if (0o755 != 493) { return fail("octal") }
    if (0b1010 != 10) { return fail("binary") }
    // C's rule -- a leading zero means octal -- is deliberately not repeated.
    if (010 != 10) { return fail("a leading zero is not octal") }
    if (-0xFF != 0 - 255) { return fail("a negative radix literal") }
    let mask: U64 = 0xFFFFFFFFFFFFFFFF
    if (mask != 18446744073709551615) { return fail("a 64-bit mask") }

    if (1e9 != 1000000000.0) { return fail("an exponent with no dot") }
    if (1.5e-3 != 0.0015) { return fail("a negative exponent") }
    if (strFromFloat(6.022e23).equals("6.022e+23") == false) { return fail("a large exponent") }

    println("test_136 ok")
    return 0
}
