fn checkU8() -> Int {
    let zero = seen() as U8
    let one = zero + 1
    let n = seen()
    if ((100 as U8) / (one * 7) != 14 or (100 as U8) % (one * 7) != 2) { return fail("U8 100 / 7") }
    if (one << (n + 8) != one) { return fail("U8 shift by the width") }
    if (one << (n + 11) != (8 as U8)) { return fail("U8 shift past the width") }
    if (one << (n - 1) != one << 7) { return fail("U8 shift by -1") }
    if (one << (n - 8) != one) { return fail("U8 shift by minus the width") }
    if ((8 as U8) >> (n + 11) != one) { return fail("U8 right shift past the width") }
    if ((one << 7) >> (n - 1) != one) { return fail("U8 right shift by -1") }
    if (one << ((n + 9) as I64) != (2 as U8)) { return fail("U8 shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as U8)) { return fail("U8 shift by a U8") }
    return 0
}

