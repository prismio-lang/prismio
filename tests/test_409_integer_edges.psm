fn checkInt128() -> Int {
    let zero = seen() as Int<128>
    let one = zero + 1
    let n = seen()
    let minusOne = zero - 1
    let mut smallest = one << 127
    if (smallest / minusOne != smallest) { return fail("Int<128> MIN / -1") }
    if (smallest % minusOne != zero) { return fail("Int<128> MIN % -1") }
    if (smallest / -1 != smallest or smallest % -1 != zero) { return fail("Int<128> MIN / written -1") }
    if ((7 as Int<128>) / minusOne != zero - 7 or (7 as Int<128>) % minusOne != zero) { return fail("Int<128> 7 / -1") }
    if ((zero - 7) / (one + 1) != zero - 3 or (zero - 7) % (one + 1) != zero - 1) { return fail("Int<128> -7 / 2") }
    smallest /= minusOne
    if (smallest != one << 127) { return fail("Int<128> /=") }
    if ((100 as Int<128>) / (one * 7) != 14 or (100 as Int<128>) % (one * 7) != 2) { return fail("Int<128> 100 / 7") }
    if (one << (n + 128) != one) { return fail("Int<128> shift by the width") }
    if (one << (n + 131) != (8 as Int<128>)) { return fail("Int<128> shift past the width") }
    if (one << (n - 1) != one << 127) { return fail("Int<128> shift by -1") }
    if (one << (n - 128) != one) { return fail("Int<128> shift by minus the width") }
    if ((8 as Int<128>) >> (n + 131) != one) { return fail("Int<128> right shift past the width") }
    if ((one << 127) >> (n - 1) != minusOne) { return fail("Int<128> right shift by -1") }
    if (one << ((n + 129) as I64) != (2 as Int<128>)) { return fail("Int<128> shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as Int<128>)) { return fail("Int<128> shift by a U8") }
    return 0
}

fn checkInt24() -> Int {
    let zero = seen() as Int<24>
    let one = zero + 1
    let n = seen()
