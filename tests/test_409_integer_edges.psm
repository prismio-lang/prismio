fn checkUInt128() -> Int {
    let zero = seen() as UInt<128>
    let one = zero + 1
    let n = seen()
    if ((100 as UInt<128>) / (one * 7) != 14 or (100 as UInt<128>) % (one * 7) != 2) { return fail("UInt<128> 100 / 7") }
    if (one << (n + 128) != one) { return fail("UInt<128> shift by the width") }
    if (one << (n + 131) != (8 as UInt<128>)) { return fail("UInt<128> shift past the width") }
    if (one << (n - 1) != one << 127) { return fail("UInt<128> shift by -1") }
    if (one << (n - 128) != one) { return fail("UInt<128> shift by minus the width") }
    if ((8 as UInt<128>) >> (n + 131) != one) { return fail("UInt<128> right shift past the width") }
    if ((one << 127) >> (n - 1) != one) { return fail("UInt<128> right shift by -1") }
    if (one << ((n + 129) as I64) != (2 as UInt<128>)) { return fail("UInt<128> shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as UInt<128>)) { return fail("UInt<128> shift by a U8") }
    return 0
}

fn checkUInt12() -> Int {
    let zero = seen() as UInt<12>
    let one = zero + 1
    let n = seen()
    if ((100 as UInt<12>) / (one * 7) != 14 or (100 as UInt<12>) % (one * 7) != 2) { return fail("UInt<12> 100 / 7") }
    if (one << (n + 12) != one) { return fail("UInt<12> shift by the width") }
    if (one << (n + 15) != (8 as UInt<12>)) { return fail("UInt<12> shift past the width") }
    if (one << (n - 1) != one << 11) { return fail("UInt<12> shift by -1") }
    if (one << (n - 12) != one) { return fail("UInt<12> shift by minus the width") }
    if ((8 as UInt<12>) >> (n + 15) != one) { return fail("UInt<12> right shift past the width") }
    if ((one << 11) >> (n - 1) != one) { return fail("UInt<12> right shift by -1") }
    if (one << ((n + 13) as I64) != (2 as UInt<12>)) { return fail("UInt<12> shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as UInt<12>)) { return fail("UInt<12> shift by a U8") }
    return 0
}

// A U8 amount of 255 on an Int is 31, and an I8 of -1 is too.
fn checkAmounts() -> Int {
    let n = seen()
    if ((1 as Int) << ((n + 255) as U8) != (1 as Int) << 31) { return fail("U8 255") }
    if ((1 as Int) << ((n - 1) as I8) != (1 as Int) << 31) { return fail("I8 -1") }
    // 2^32 + 1: reduced before it is cut to the shifted value's width.
    if (1 << ((n as I64) + 4294967297) != 2) { return fail("I64 amount above 2^32") }
    if ((1 as Int<24>) << ((n as I64) + 4294967297) != (1 as Int<24>) << 17) { return fail("I64 amount, odd width") }
    let letter = 'A'
    if (letter << (n + 8) != letter) { return fail("Char shift") }
    return 0
}

// Written amounts that are in range for an I64 only: in the I32 copy they are masked.
fn forty<T>(value: T) -> T { return value << 40 }

fn checkGeneric() -> Int {
    let n = seen()
    if (forty((n as I64) + 1) != 1099511627776) { return fail("generic I64") }
    if (forty(n + 1) != 256) { return fail("generic Int") }
    return 0
}

fn main() -> Int {
    if (checkI8() != 0) { return 1 }
    if (checkI16() != 0) { return 1 }
    if (checkInt() != 0) { return 1 }
    if (checkI64() != 0) { return 1 }
    if (checkInt128() != 0) { return 1 }
    if (checkInt24() != 0) { return 1 }
    if (checkU8() != 0) { return 1 }
    if (checkU16() != 0) { return 1 }
    if (checkU32() != 0) { return 1 }
    if (checkU64() != 0) { return 1 }
    if (checkUInt128() != 0) { return 1 }
    if (checkUInt12() != 0) { return 1 }
    if (checkAmounts() != 0) { return 1 }
    if (checkGeneric() != 0) { return 1 }
    println("ok")
    return 0
}
