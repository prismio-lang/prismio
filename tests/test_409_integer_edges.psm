    if (smallest / -1 != smallest or smallest % -1 != zero) { return fail("I64 MIN / written -1") }
    if ((7 as I64) / minusOne != zero - 7 or (7 as I64) % minusOne != zero) { return fail("I64 7 / -1") }
    if ((zero - 7) / (one + 1) != zero - 3 or (zero - 7) % (one + 1) != zero - 1) { return fail("I64 -7 / 2") }
    smallest /= minusOne
    if (smallest != one << 63) { return fail("I64 /=") }
    if ((100 as I64) / (one * 7) != 14 or (100 as I64) % (one * 7) != 2) { return fail("I64 100 / 7") }
    if (one << (n + 64) != one) { return fail("I64 shift by the width") }
    if (one << (n + 67) != (8 as I64)) { return fail("I64 shift past the width") }
    if (one << (n - 1) != one << 63) { return fail("I64 shift by -1") }
