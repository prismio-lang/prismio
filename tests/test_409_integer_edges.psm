// Integer edge cases, every width: the smallest value divided by -1 wraps to itself and
// leaves no remainder, and a shift is by the amount modulo the width, a negative amount
// counting down from it. Each case is run on values the compiler cannot see through
// (`seen` reads the argument count, 0 here) and in the written form. A zero divisor is
// test_410; the written forms the compiler refuses are neg_437 to neg_439.

import std.io
import std.process

fn seen() -> Int { return process.args.count - 1 }

fn fail(message: String) -> Int {
    println("FAIL", message)
    return 1
}

fn checkI8() -> Int {
    let zero = seen() as I8
    let one = zero + 1
    let n = seen()
    let minusOne = zero - 1
    let mut smallest = one << 7
    if (smallest / minusOne != smallest) { return fail("I8 MIN / -1") }
    if (smallest % minusOne != zero) { return fail("I8 MIN % -1") }
    if (smallest / -1 != smallest or smallest % -1 != zero) { return fail("I8 MIN / written -1") }
    if ((7 as I8) / minusOne != zero - 7 or (7 as I8) % minusOne != zero) { return fail("I8 7 / -1") }
    if ((zero - 7) / (one + 1) != zero - 3 or (zero - 7) % (one + 1) != zero - 1) { return fail("I8 -7 / 2") }
    smallest /= minusOne
    if (smallest != one << 7) { return fail("I8 /=") }
    if ((100 as I8) / (one * 7) != 14 or (100 as I8) % (one * 7) != 2) { return fail("I8 100 / 7") }
    if (one << (n + 8) != one) { return fail("I8 shift by the width") }
    if (one << (n + 11) != (8 as I8)) { return fail("I8 shift past the width") }
    if (one << (n - 1) != one << 7) { return fail("I8 shift by -1") }
    if (one << (n - 8) != one) { return fail("I8 shift by minus the width") }
    if ((8 as I8) >> (n + 11) != one) { return fail("I8 right shift past the width") }
    if ((one << 7) >> (n - 1) != minusOne) { return fail("I8 right shift by -1") }
    if (one << ((n + 9) as I64) != (2 as I8)) { return fail("I8 shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as I8)) { return fail("I8 shift by a U8") }
    return 0
}

fn checkI16() -> Int {
    let zero = seen() as I16
    let one = zero + 1
    let n = seen()
    let minusOne = zero - 1
    let mut smallest = one << 15
    if (smallest / minusOne != smallest) { return fail("I16 MIN / -1") }
    if (smallest % minusOne != zero) { return fail("I16 MIN % -1") }
    if (smallest / -1 != smallest or smallest % -1 != zero) { return fail("I16 MIN / written -1") }
    if ((7 as I16) / minusOne != zero - 7 or (7 as I16) % minusOne != zero) { return fail("I16 7 / -1") }
    if ((zero - 7) / (one + 1) != zero - 3 or (zero - 7) % (one + 1) != zero - 1) { return fail("I16 -7 / 2") }
    smallest /= minusOne
    if (smallest != one << 15) { return fail("I16 /=") }
    if ((100 as I16) / (one * 7) != 14 or (100 as I16) % (one * 7) != 2) { return fail("I16 100 / 7") }
    if (one << (n + 16) != one) { return fail("I16 shift by the width") }
    if (one << (n + 19) != (8 as I16)) { return fail("I16 shift past the width") }
    if (one << (n - 1) != one << 15) { return fail("I16 shift by -1") }
    if (one << (n - 16) != one) { return fail("I16 shift by minus the width") }
    if ((8 as I16) >> (n + 19) != one) { return fail("I16 right shift past the width") }
    if ((one << 15) >> (n - 1) != minusOne) { return fail("I16 right shift by -1") }
    if (one << ((n + 17) as I64) != (2 as I16)) { return fail("I16 shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as I16)) { return fail("I16 shift by a U8") }
    return 0
}

fn checkInt() -> Int {
    let zero = seen() as Int
    let one = zero + 1
    let n = seen()
    let minusOne = zero - 1
    let mut smallest = one << 31
    if (smallest / minusOne != smallest) { return fail("Int MIN / -1") }
    if (smallest % minusOne != zero) { return fail("Int MIN % -1") }
    if (smallest / -1 != smallest or smallest % -1 != zero) { return fail("Int MIN / written -1") }
    if ((7 as Int) / minusOne != zero - 7 or (7 as Int) % minusOne != zero) { return fail("Int 7 / -1") }
    if ((zero - 7) / (one + 1) != zero - 3 or (zero - 7) % (one + 1) != zero - 1) { return fail("Int -7 / 2") }
    smallest /= minusOne
    if (smallest != one << 31) { return fail("Int /=") }
    if ((100 as Int) / (one * 7) != 14 or (100 as Int) % (one * 7) != 2) { return fail("Int 100 / 7") }
    if (one << (n + 32) != one) { return fail("Int shift by the width") }
    if (one << (n + 35) != (8 as Int)) { return fail("Int shift past the width") }
    if (one << (n - 1) != one << 31) { return fail("Int shift by -1") }
    if (one << (n - 32) != one) { return fail("Int shift by minus the width") }
    if ((8 as Int) >> (n + 35) != one) { return fail("Int right shift past the width") }
    if ((one << 31) >> (n - 1) != minusOne) { return fail("Int right shift by -1") }
    if (one << ((n + 33) as I64) != (2 as Int)) { return fail("Int shift by an I64") }
    if (one << ((n + 3) as U8) != (8 as Int)) { return fail("Int shift by a U8") }
    return 0
}

fn checkI64() -> Int {
