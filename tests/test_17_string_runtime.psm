import std.io
import std.string
import std.option

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let text = "Hello, World!"

    if (__builtin_string_len(text) != 13) {
        return fail("string length builtin should read the native length")
    }

    if (strSubstring(text, 0, 5).equals("Hello") == false) {
        return fail("str_substring should extract the requested slice")
    }

    if (text.charAt(7) != 'W') {
        return fail("str_char_at should read the requested character")
    }

    if (strContains(text, "World") == false) {
        return fail("str_contains should find an included substring")
    }

    if (strStartsWith(text, "Hello") == false) {
        return fail("str_starts_with should match prefixes")
    }

    if (strIndexOf(text, "World") != 7) {
        return fail("str_index_of should return the substring offset")
    }

    if ("Hello, ".concat("World").equals("Hello, World") == false) {
        return fail("str_concat should join strings")
    }

    if (strFromInt(42).equals("42") == false) {
        return fail("int_to_str should format integers")
    }

    if (optionOr(strParseInt("123"), 0) != 123) {
        return fail("str_to_int should parse decimal integers")
    }

    println("PASS: string runtime")
    return 0
}
