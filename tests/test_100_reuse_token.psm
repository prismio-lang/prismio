// M2.1b: a consuming same-tag rebuild reuses a one-owner constructor, while a
// value shared through containers keeps the ordinary allocate path.
//
// The second half is semantic, not an IR-count proxy. `shared` is reached
// through two live lists, so mutating its block in mapAdd would change `before`
// from 1 to 11. The fresh result must change and the shared source must not.

import std.io
extern fn exit(status: Int)

enum Tree { Leaf, Node(Tree, Int, Tree) }

fn mapAdd(sink t: Tree, k: Int) -> Tree {
    match (t) {
        Tree.Leaf => { return Tree.Leaf }
        Tree.Node(l, v, r) => {
            return Tree.Node(mapAdd(l, k), v + k, mapAdd(r, k))
        }
    }
    return Tree.Leaf
}

fn rootValue(t: Tree) -> Int {
    match (t) {
        Tree.Leaf => { return 0 }
        Tree.Node(l, v, r) => { return v }
    }
    return 0
}

fn main() -> Int {
    let a: List<Tree> = list_new()
    let b: List<Tree> = list_new()
    list_push(a, Tree.Node(Tree.Leaf, 1, Tree.Leaf))
    list_push(b, list_get(a, 0))

    let changed = mapAdd(list_get(a, 0), 10)
    let before = rootValue(list_get(b, 0))
    let after = rootValue(changed)
    if (before != 1 or after != 11) {
        println("FAIL: shared rebuild was mutated in place")
        return 1
    }
    println("reuse token ok")
    // This fixture deliberately constructs a value owned by two containers, a
    // shape whose T3 teardown is covered by test_48. Exit after the observable
    // fallback assertion so that this test isolates reuse rather than repeating
    // that fixture's ownership accounting through a deliberately consumed view.
    exit(0)
    return 0
}
