// A `match` whose every pattern is a constant lowers to one LLVM `switch`
// (generateSwitchMatch); anything else keeps the compare chain. These are the
// places the two could disagree:
//
//   - a value two arms share goes to the *first*, as the chain takes it -- the
//     switch declines the second case rather than letting LLVM reject it;
//   - negated literals, a U8 above 127 and an I64 beyond Int all become cases
//     at the scrutinee's own width;
//   - an enum with every variant named has no wildcard, and falls to the end;
//   - `break` and `continue` inside an arm leave the loop, not the match;
//   - a pattern that is not a constant (a name) keeps the chain, in order.
import std.io

enum Dir { North, East, South, West }

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn classify(x: Int) -> Int {
    match (x) {
        -5 => { return 1 }
        0 => { return 2 }
        7 => { return 3 }
        7 => { return 99 }
        2147483647 => { return 4 }
        _ => { return 0 }
    }
    return -1
}

fn wide(v: I64) -> Int {
    match (v) {
        5000000000 => { return 1 }
        -1 => { return 2 }
        _ => { return 0 }
    }
    return -1
}

fn byte(b: U8) -> Int {
    match (b) {
        200 => { return 1 }
        255 => { return 2 }
        _ => { return 0 }
    }
    return -1
}

fn turn(d: Dir) -> Dir {
    let mut next = Dir.North
    match (d) {
        Dir.North => { next = Dir.East }
        Dir.East => { next = Dir.South }
        Dir.South => { next = Dir.West }
        Dir.West => { next = Dir.North }
    }
    return next
}

fn loopArms(n: Int) -> Int {
    let mut sum = 0
    let mut i = 0
    while (i < n) {
        i = i + 1
        match (i % 4) {
            0 => { continue }
            3 => {
                if (i > 10) { break }
                sum = sum + 100
            }
            _ => { sum = sum + i }
        }
        sum = sum + 1
    }
    return sum
}

fn nested(a: Int, b: Int) -> Int {
    match (a) {
        1 => {
            match (b) {
                1 => { return 11 }
                2 => { return 12 }
                _ => { return 10 }
            }
        }
        2 => { return 20 }
        _ => { return 0 }
    }
    return -1
}

fn byName(x: Int, k: Int) -> Int {
    match (x) {
        k => { return 1 }
        3 => { return 2 }
        _ => { return 0 }
    }
    return -1
}

fn main() -> Int {
    let mut failures = 0
    if (classify(-5) != 1) { failures = failures + fail("-5") }
    if (classify(0) != 2) { failures = failures + fail("0") }
    if (classify(7) != 3) { failures = failures + fail("7 takes the first arm") }
    if (classify(2147483647) != 4) { failures = failures + fail("Int.max") }
    if (classify(8) != 0) { failures = failures + fail("wildcard") }
    if (wide(5000000000 as I64) != 1 or wide(-1 as I64) != 2 or wide(705032704 as I64) != 0) {
        failures = failures + fail("I64 is not truncated to Int")
    }
    if (byte(200 as U8) != 1 or byte(255 as U8) != 2 or byte(72 as U8) != 0) { failures = failures + fail("U8") }
    let mut d = Dir.North
    let mut t = 0
    while (t < 5) {
        d = turn(d)
        t = t + 1
    }
    if (d != Dir.East) { failures = failures + fail("enum without a wildcard") }
    if (loopArms(20) != 241) { failures = failures + fail("break and continue in an arm") }
    if (nested(1, 2) != 12 or nested(1, 9) != 10 or nested(2, 1) != 20 or nested(3, 3) != 0) {
        failures = failures + fail("nested")
    }
    if (byName(4, 4) != 1 or byName(3, 4) != 2 or byName(3, 3) != 1) { failures = failures + fail("by name") }
    if (failures == 0) { println("ok") }
    return failures
}
