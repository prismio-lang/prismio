// MEM-006: `while (k < n) { list_set(dst, k, list_get(src, k)); k = k + 1 }`, and
// `for k in a..<n { dst[k] = src[k] }`, are lowered to one `llvm.memcpy` under a
// preheader guard. Two names for one list fail the guard and run the loop.
//
// The guard has to carry every precondition the loop satisfied implicitly, and
// each arm below is one of them. `list_get` and `list_set` are total, so a bound
// past either length is not an error -- reading past `src` yields 0 and writing
// past `dst` does nothing -- and a block transfer that ignored the lengths would
// turn both into memory it does not own.
//
// The induction variable is live after the loop, so the transfer has to leave it
// where the loop would have: at the bound.

import std.io

fn filled(n: Int, base: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        xs.push(base + i)
        i = i + 1
    }
    return xs
}

fn digest(xs: Vec<Int>) -> Int {
    let mut acc = 0
    let mut i = 0
    let n = xs.length
    while (i < n) {
        acc = (acc * 31 + xs[i]) % 1000000007
        i = i + 1
    }
    return acc
}

// The shape the lowering serves.
fn copyAll(inout dst: Vec<Int>, src: Vec<Int>, n: Int) -> Int {
    let mut k = 0
    while (k < n) {
        dst[k] = src[k]
        k = k + 1
    }
    return k
}

// The same, from a non-zero start.
fn copyFrom(inout dst: Vec<Int>, src: Vec<Int>, start: Int, n: Int) -> Int {
    let mut k = start
    while (k < n) {
        dst[k] = src[k]
        k = k + 1
    }
    return k
}

// The range `for` spellings of the two above. A `for` whose start is past its end
// counts down, which is not a block move, so `copyFromFor(j, i2, 20, 16)` runs
// the loop: 20, 19, 18, 17, every one of them past both lengths.
fn copyAllFor(inout dst: Vec<Int>, src: Vec<Int>, n: Int) {
    for k in 0..<n {
        dst[k] = src[k]
    }
}

fn copyFromFor(inout dst: Vec<Int>, src: Vec<Int>, start: Int, n: Int) {
    for k in start..<n {
        dst[k] = src[k]
    }
}

// The benchmark's shape, with the source changed between rounds: only the last
// round's copy is dead-store-free, and a transfer deleted as a repeat of the one
// before it would leave the first round's values behind.
fn copyRounds(inout dst: Vec<Int>, inout src: Vec<Int>, n: Int) -> Int {
    let mut seen = 0
    for round in 0..<3 {
        for k in 0..<n {
            dst[k] = src[k]
        }
        seen = seen + dst[0]
        src[0] = src[0] + 10 + round
    }
    return seen
}

fn copyBytes(inout dst: Vec<Bool>, src: Vec<Bool>, n: Int) {
    for k in 0..<n {
        dst[k] = src[k]
    }
}

fn copyFloats(inout dst: Vec<Float>, src: Vec<Float>, n: Int) {
    for k in 0..<n {
        dst[k] = src[k]
    }
}

fn check(label: String, got: Int, want: Int) -> Int {
    if (got != want) {
        print(label)
        print(" got ")
        print(got)
        print(" want ")
        println(want)
        return 1
    }
    return 0
}

fn main() -> Int {
    let mut bad = 0

    // Whole buffer, both lengths equal: the transfer runs.
    let a = filled(64, 100)
    let mut b = filled(64, 0)
    bad = bad + check("FAIL: copyAll returns the bound", copyAll(b, a, 64), 64)
    bad = bad + check("FAIL: copyAll content", digest(b), digest(a))

    // The bound is past the destination. `list_set` does nothing past the end,
    // so the first 8 move and the rest are dropped.
    let c = filled(32, 200)
    let mut d = filled(8, 0)
    bad = bad + check("FAIL: short dst returns the bound", copyAll(d, c, 32), 32)
    bad = bad + check("FAIL: short dst length", d.length, 8)
    bad = bad + check("FAIL: short dst content", digest(d), digest(filled(8, 200)))

    // The bound is past the source. `list_get` yields 0 there, so the tail of
    // the destination is zeroed rather than left alone.
    let e = filled(8, 300)
    let mut f = filled(32, 7)
    bad = bad + check("FAIL: short src returns the bound", copyAll(f, e, 32), 32)
    bad = bad + check("FAIL: short src head", f[0], 300)
    bad = bad + check("FAIL: short src boundary", f[7], 307)
    bad = bad + check("FAIL: short src tail", f[8], 0)
    bad = bad + check("FAIL: short src end", f[31], 0)

    // A non-zero start leaves everything below it alone.
    let g = filled(16, 400)
    let mut h = filled(16, 0)
    bad = bad + check("FAIL: copyFrom returns the bound", copyFrom(h, g, 4, 16), 16)
    bad = bad + check("FAIL: copyFrom below start", h[3], 3)
    bad = bad + check("FAIL: copyFrom at start", h[4], 404)
    bad = bad + check("FAIL: copyFrom end", h[15], 415)

    // Start past the bound: no iteration, and the variable still lands there.
    let i2 = filled(16, 500)
    let mut j = filled(16, 0)
    bad = bad + check("FAIL: empty range returns the start", copyFrom(j, i2, 20, 16), 20)
    bad = bad + check("FAIL: empty range content", digest(j), digest(filled(16, 0)))

    // Same list on both sides: every element copies onto itself.
    let mut k2 = filled(16, 600)
    bad = bad + check("FAIL: aliased returns the bound", copyAll(k2, k2, 16), 16)
    bad = bad + check("FAIL: aliased content", digest(k2), digest(filled(16, 600)))

    // Nothing to move.
    let l = filled(0, 0)
    let mut m = filled(0, 0)
    bad = bad + check("FAIL: empty lists", copyAll(m, l, 0), 0)

    // A negative bound is not a range at all.
    let o = filled(8, 700)
    let mut p = filled(8, 0)
    bad = bad + check("FAIL: negative bound", copyAll(p, o, 0 - 5), 0)
    bad = bad + check("FAIL: negative bound content", digest(p), digest(filled(8, 0)))

    // The same arms through the range `for`.
    let fa = filled(64, 100)
    let mut fb = filled(64, 0)
    copyAllFor(fb, fa, 64)
    bad = bad + check("FAIL: for copyAll content", digest(fb), digest(fa))

    let fc = filled(32, 200)
    let mut fd = filled(8, 0)
    copyAllFor(fd, fc, 32)
    bad = bad + check("FAIL: for short dst length", fd.length, 8)
    bad = bad + check("FAIL: for short dst content", digest(fd), digest(filled(8, 200)))

    let fe = filled(8, 300)
    let mut ff = filled(32, 7)
    copyAllFor(ff, fe, 32)
    bad = bad + check("FAIL: for short src boundary", ff[7], 307)
    bad = bad + check("FAIL: for short src tail", ff[8], 0)

    let fg = filled(16, 400)
    let mut fh = filled(16, 0)
    copyFromFor(fh, fg, 4, 16)
    bad = bad + check("FAIL: for copyFrom below start", fh[3], 3)
    bad = bad + check("FAIL: for copyFrom at start", fh[4], 404)
    bad = bad + check("FAIL: for copyFrom end", fh[15], 415)

    let fi = filled(16, 500)
    let mut fj = filled(16, 0)
    copyFromFor(fj, fi, 20, 16)
    bad = bad + check("FAIL: for descending range content", digest(fj), digest(filled(16, 0)))

    let mut fk = filled(16, 600)
    copyAllFor(fk, fk, 16)
    bad = bad + check("FAIL: for aliased content", digest(fk), digest(filled(16, 600)))

    let fl = filled(0, 0)
    let mut fm = filled(0, 0)
    copyAllFor(fm, fl, 0)
    bad = bad + check("FAIL: for empty lists", fm.length, 0)

    let fo = filled(8, 700)
    let mut fp = filled(8, 0)
    // `0..<-5` counts down from 0, so only element 0 is ever in range.
    copyAllFor(fp, fo, 0 - 5)
    bad = bad + check("FAIL: for negative bound head", fp[0], 700)
    bad = bad + check("FAIL: for negative bound rest", fp[1], 1)

    let mut rs = filled(4, 1)
    let mut rd = filled(4, 0)
    bad = bad + check("FAIL: rounds see each copy", copyRounds(rd, rs, 4), 1 + 11 + 22)
    bad = bad + check("FAIL: rounds keep the last copy", rd[0], 22)
    bad = bad + check("FAIL: rounds source", rs[0], 34)

    let mut bs = Vec<Bool>.filled(9, false)
    bs[3] = true
    bs[8] = true
    let mut bd = Vec<Bool>.filled(9, true)
    copyBytes(bd, bs, 9)
    bad = bad + check("FAIL: bytes copied", (bd[3] as Int) + (bd[8] as Int) * 2 + (bd[0] as Int) * 4, 3)

    let mut xs = Vec<Float>.filled(5, 1.5)
    xs[4] = 2.25
    let mut xd = Vec<Float>.filled(5, 0.0)
    copyFloats(xd, xs, 5)
    bad = bad + check("FAIL: floats copied", (xd[0] * 4.0 + xd[4] * 4.0) as Int, 15)

    if (bad != 0) { return 1 }
    println("PASS: whole buffer copy")
    return 0
}
