// expect-error: `replace` requires an unobserved local Vec

struct Named {
    label: String,
    value: Int
}

fn main() -> Int {
    let mut items: Vec<Named> = []
    items.push(Named { label: "first", value: 3 })
    let old = items[0]
    let n = old.value
    items.replace(0, Named { label: "second", value: 7 })
    return n
}
