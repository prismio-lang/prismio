import std.io
struct Item {
    value: Int
}

fn fail(message: String) -> Int {
    print("FAIL: ")
    println(message)
    return 1
}

fn main() -> Int {
    let mut items: Vec<Item> = []
    items.push(Item { value: 10 })
    items.push(Item { value: 20 })
    items.push(Item { value: 30 })

    if (items.length != 3) {
        return fail("list should hold three items")
    }

    // iterate and sum
    let mut sum = 0
    let mut i = 0
    while (i < items.length) {
        let it = items[i]
        sum = sum + it.value
        i = i + 1
    }
    if (sum != 60) {
        return fail("sum of pushed values should be 60")
    }

    // random access returns the right element type
    let second = items[1]
    if (second.value != 20) {
        return fail("indexed get should return the second item")
    }

    println("PASS: list")
    return 0
}
