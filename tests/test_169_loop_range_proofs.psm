// expect-trap: for-copy-down-past-the-end => index 12 is out of range for a Vec of length 8
// expect-trap: for-copy-down-before-the-start => index -1 is out of range for a Vec of length 8
// expect-trap: let-shadow => index 100 is out of range for a Vec of length 8
// expect-trap: let-shadow-past-the-end => index 100 is out of range for a Vec of length 8
// expect-trap: binder-shadow-past-the-end => index 9 is out of range for a Vec of length 8
// expect-trap: nested-bump-past-the-end => index 8 is out of range for a Vec of length 8
// expect-trap: nested-grow => index 8 is out of range for a Vec of length 8
// expect-trap: nested-grow-past-the-end => index 43 is out of range for a Vec of length 40
// expect-trap: merge-short-scratch => index 6 is out of range for a Vec of length 6
// expect-trap: merge-past-the-end => index 10 is out of range for a Vec of length 10
// expect-trap: sieve-wrapping-step => index -2147483645 is out of range for a Vec of length 41
// expect-trap: square-negative-start => index -5 is out of range for a Vec of length 50
// expect-trap: square-wrapping-step => index 2147483647 is out of range for a Vec of length 50
// expect-trap: square-below-short => index 5 is out of range for a Vec of length 5
// expect-trap: shifted-wrapping-start => index 2147483646 is out of range for a Vec of length 8
// expect-trap: reverse-past-the-end => index 11 is out of range for a Vec of length 8
// expect-trap: reverse-before-the-start => index -3 is out of range for a Vec of length 8
// expect-trap: for-copy-offset-target => index 8 is out of range for a Vec of length 8
// expect-trap: for-copy-past-the-end => index 8 is out of range for a Vec of length 8
// expect-trap: for-step-past-the-end => index 14 is out of range for a Vec of length 10
// expect-trap: for-step-down-past-the-end => index 20 is out of range for a Vec of length 10
// expect-trap: for-step-down-to-int-min => index -999999995 is out of range for a Vec of length 10
// expect-trap: for-down-past-the-end => index 12 is out of range for a Vec of length 10
// expect-trap: for-down-negative-weight => index 11 is out of range for a Vec of length 10
// expect-trap: for-down-counting-up => index -3 is out of range for a Vec of length 10
// expect-trap: for-down-literal-past-the-end => index 9 is out of range for a Vec of length 5
// expect-trap: divided-negative => index -2 is out of range for a Vec of length 8
// expect-trap: divided-past-the-end => index 8 is out of range for a Vec of length 8
// expect-trap: masked-past-the-end => index 14 is out of range for a Vec of length 8
// expect-trap: masked-negative-mask => index 14 is out of range for a Vec of length 8
// expect-trap: bisect-past-the-end => index 18 is out of range for a Vec of length 16
// expect-trap: bisect-wrapping-span => index -2147483648 is out of range for a Vec of length 16
// expect-trap: bisect-wrapping-bound => index 1073741823 is out of range for a Vec of length 16
// expect-trap: bisect-sum-past-the-end => index 18 is out of range for a Vec of length 16
// expect-trap: bisect-sum-wrapping => index -348 is out of range for a Vec of length 16
// Loop range proofs (src/ir/ranges.psm), and the property they must never break.
//
// A loop whose indices the analysis can bound runs a copy with no bounds checks,
// behind a preheader guard that holds the facts the proof rests on. An index outside
// the list stops the program (docs/MEMORY_SAFETY_PLAN.md section 2), so every shape
// below runs once with inputs the guard admits, which must give the right number, and
// -- one case per run, named by its argument -- with inputs that make one of its facts
// false, which must stop at the first index out of range rather than read past it.
// The expected values come from a model of the language: `Int` wraps at 32 bits.
//
// Each shape is one the analysis handles and the previous one did not: several
// counters moving under branches, a relation that bounds a counter the condition
// never mentions, a step that is a variable, an access inside the condition, two
// counters closing on each other, and `for` loops. The adversarial halves aim at
// the soundness conditions: a start or step that makes a counter wrap, a list
// shorter than the relation needs, a `let` or a match binder shadowing a name the
// analysis tracks, and a counter a nested loop moves.

import std.io
import std.process

enum Slot { Empty, At(Int) }

fn ascending(n: Int, from: Int) -> Vec<Int> {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut i = 0
    while (i < n) {
        xs.push(from + i)
        i = i + 1
    }
    return xs
}

fn weighted(xs: Vec<Int>) -> Int {
    let mut acc = 0
    let mut k = 0
    while (k < xs.length) {  // range: 1/1
        acc = acc + (k + 1) * xs[k]
        k = k + 1
    }
    return acc
}

// Three counters, two of them moving under a branch; `out` is bounded only by
// `out - left - right` not changing on any path.
fn merge(scratchLen: Int, low: Int, mid: Int, high: Int) -> Int {
    let mut values: Vec<Int> = Vec<Int>.withCapacity(10)
    values.push(5)
    values.push(1)
    values.push(9)
    values.push(3)
    values.push(7)
    values.push(2)
    values.push(8)
    values.push(6)
    values.push(4)
    values.push(0)
    let mut scratch: Vec<Int> = Vec<Int>.withCapacity(scratchLen)
    let mut z = 0
    while (z < scratchLen) {
        scratch.push(0)
        z = z + 1
    }
    let mut left = low
    let mut right = mid
    let mut out = low
    while (left < mid and right < high) {  // range: 6/6
        if (values[left] <= values[right]) {
            scratch[out] = values[left]
            left = left + 1
        } else {
            scratch[out] = values[right]
            right = right + 1
        }
        out = out + 1
    }
    while (left < mid) {  // range: 2/2
        scratch[out] = values[left]
        left = left + 1
        out = out + 1
    }
    while (right < high) {  // range: 2/2
        scratch[out] = values[right]
        right = right + 1
        out = out + 1
    }
    return weighted(scratch)
}

// A step that is a variable, as a sieve strides. A huge step wraps the counter
// negative with the condition still true; `cap` ends the loop.
fn sieveStep(n: Int, start: Int, step: Int, cap: Int) -> Int {
    let mut marks: Vec<Int> = Vec<Int>.withCapacity(n + 1)
    let mut i = 0
    while (i <= n) {
        marks.push(1)
        i = i + 1
    }
    let mut m = start
    let mut count = 0
    while (m <= n) {  // range: 1/1
        marks[m] = 0
        m = m + step
        count = count + 1
        if (count > cap) { break }
    }
    let mut total = 0
    let mut k = 0
    while (k <= n) {  // range: 1/1
        total = total + marks[k]
        k = k + 1
    }
    return total * 1000 + count
}

// A sieve's outer bound, `x * x <= bound`. The square is `Int` arithmetic, so past
// 46340 it wraps negative with the condition still true and the loop runs on: a
// bound above 46339^2, or a step that jumps the edge from below it. A start below
// zero reads before the list.
fn squareBound(n: Int, start: Int, step: Int, bound: Int, cap: Int) -> Int {
    let xs = ascending(n, 1)
    let mut x = start
    let mut c = 0
    let mut acc = 0
    while (x * x <= bound and c < cap) {  // range: 1/1
        acc = acc + xs[x] * (c + 1)
        x = x + step
        c = c + 1
    }
    return acc + x
}

// The strict, mirrored form, over a list exactly long enough for isqrt(limit - 1).
fn squareBelow(n: Int, limit: Int) -> Int {
    let xs = ascending(n, 1)
    let mut x = 0
    let mut acc = 0
    while (limit > x * x) {  // range: 1/1
        acc = acc + xs[x] * x
        x = x + 1
    }
    return acc
}

// `at + 3 < n` bounds `at` by n - 4 only while the sum does not wrap. Started
// near the top of `Int` it does, the condition is true, and every read is past
// the end.
fn shifted(n: Int, start: Int) -> Int {
    let xs = ascending(n, 1)
    let mut acc = 0
    let mut at = start
    let mut count = 0
    while (at + 3 < n) {  // range: 1/1
        acc = acc + xs[at]
        at = at + 1
        count = count + 1
        if (count > 6) { break }
    }
    return acc * 100 + count
}

// Reads inside the condition, each bounded by the conjunct before it.
fn matchLength(pos: Int, ref: Int, n: Int) -> Int {
    let mut data: Vec<Int> = Vec<Int>.withCapacity(10)
    data.push(1)
    data.push(2)
    data.push(3)
    data.push(1)
    data.push(2)
    data.push(3)
    data.push(1)
    data.push(2)
    data.push(9)
    data.push(9)
    let mut m = 0
    while (pos + m < n and data[pos + m] == data[ref + m] and m < 255) {  // range: 2/2
        m = m + 1
    }
    return m
}

// Two counters closing on each other: `i < j` bounds each by the other's start.
fn reverse(n: Int, i0: Int, j0: Int) -> Int {
    let mut xs: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut k = 0
    while (k < n) {
        xs.push(k * 3)
        k = k + 1
    }
    let mut i = i0
    let mut j = j0
    while (i < j) {  // range: 4/4
        let a = xs[i]
        let b = xs[j]
        xs[i] = b
        xs[j] = a
        i = i + 1
        j = j - 1
    }
    return weighted(xs)
}

// A `for` variable, and a second cursor moving in step with it.
fn forCopy(n: Int, a: Int, b: Int, dst0: Int) -> Int {
    let src = ascending(n, 5)
    let mut dst: Vec<Int> = Vec<Int>.withCapacity(n)
    let mut z = 0
    while (z < n) {
        dst.push(0)
        z = z + 1
    }
    let mut j = dst0
    for i in a..<b {  // range: 1/2 2/2
        dst[j] = src[i]
        j = j + 1
    }
    return weighted(dst)
}

fn forStep(n: Int, a: Int, b: Int, step: Int) -> Int {
    let xs = ascending(n, 1)
    let mut acc = 0
    for i in a..b step step {  // range: 1/1 1/1
        acc = acc + xs[i] * (i + 2)
    }
    return acc
}

// Counting down, the range's end is the variable's low bound and its start the
// high one. A knapsack row reads behind the element it writes, so `at - w` is
// what the low end has to keep inside the list.
fn forDown(n: Int, cap: Int, w: Int, v: Int) -> Int {
    let mut best = ascending(n, 1)
    for at in cap..w {  // range: 3/3 3/3
        best[at] = best[at] + best[at - w] + v
    }
    return weighted(best)
}

// A literal range that counts down is one copy, and an excluded end is the low
// end plus one.
fn forDownLiteral(n: Int) -> Int {
    let xs = ascending(n, 1)
    let mut acc = 0
    for i in 9..<2 {  // range: 1/1
        acc = acc * 3 + xs[i]
    }
    return acc
}

// Division and remainder see the index the loop computed, and a remainder takes
// the dividend's sign.
fn divided(n: Int, a: Int, b: Int) -> Int {
    let xs = ascending(n, 1)
    let mut acc = 0
    let mut i = a
    while (i < b) {  // range: 2/2
        acc = acc + xs[i / 2] * 7 + xs[i % 3]
        i = i + 1
    }
    return acc
}

// `x & m` is in [0, m] for any x -- but only while m is not negative.
fn masked(n: Int, m: Int, a: Int, b: Int) -> Int {
    let xs = ascending(n, 2)
    let mut acc = 0
    let mut i = a
    while (i < b) {  // range: 1/1
        acc = acc + xs[(i * 7) & m]
        i = i + 1
    }
    return acc
}

// A `let` in the body shadows an outer name for the rest of the body only.
fn letShadow(n: Int) -> Int {
    let xs = ascending(8, 1)
    let k = 100
    let mut acc = 0
    let mut i = 0
    while (i < n) {  // range: 1/2
        acc = acc + xs[k]
        let k = i + 1
        acc = acc + xs[k] * 10
        i = i + 1
    }
    return acc
}

// A match binder shadows the loop's counter inside its arm and nowhere else, so
// `xs[i]` in the arm is indexed by the payload, which nothing bounds.
fn binderShadow(n: Int, at: Int) -> Int {
    let xs = ascending(8, 1)
    let s = Slot.At(at)
    let mut acc = 0
    let mut i = 0
    while (i < n) {  // range: 0/1
        match (s) {
            Slot.At(i) => { acc = acc + xs[i] }
            Slot.Empty => { acc = acc + 1000 }
        }
        i = i + 1
    }
    return acc
}

// The counter a nested loop moves bounds nothing in the outer one.
fn nestedBump(n: Int) -> Int {
    let xs = ascending(8, 1)
    let mut acc = 0
    let mut i = 0
    while (i < n) {  // range: 0/1
        acc = acc + xs[i]
        let mut r = 0
        while (r < 2) {
            i = i + 1
            r = r + 1
        }
    }
    return acc
}

// A bisection (ir/relations.psm). Neither bound moves by a fixed step; what keeps
// `mid` in the list is `L0 <= low <= mid <= high <= H0`, a chain of differences.
// The twins start past either end, and far enough apart that `high - low`, or
// `high + 1`, wraps: the proved copy's facts are false there, so the checked copy
// must run and give the wrapping answer.
fn bisect(n: Int, low0: Int, high0: Int, needle: Int) -> Int {
    let xs = ascending(n, 0)
    let mut low = low0
    let mut high = high0
    let mut steps = 0
    let mut at = 0 - 1
    while (low <= high) {  // range: 1/1
        let mid = low + (high - low) / 2
        let value = xs[mid]
        steps = steps + 1
        if (steps > 40) { break }
        if (value == needle) {
            at = mid
            low = high + 1
        } else if (value < needle) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return at * 100 + steps
}

// The same search through `(low + high) / 2`, whose sum wraps first.
fn bisectSum(n: Int, low0: Int, high0: Int, needle: Int) -> Int {
    let xs = ascending(n, 0)
    let mut low = low0
    let mut high = high0
    let mut steps = 0
    let mut at = 0 - 1
    while (low <= high) {  // range: 1/1
        let mid = (low + high) / 2
        let value = xs[mid]
        steps = steps + 1
        if (steps > 40) { break }
        if (value == needle) {
            at = mid
            low = high + 1
        } else if (value < needle) {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return at * 100 + steps
}

// A midpoint of two bounds nothing orders: with `high` below `low` it lands
// below both, and the difference-bound tier must not place it between them.
fn unordered(n: Int, low0: Int, high0: Int, limit: Int) -> Int {
    let xs = ascending(n, 1)
    let mut low = low0
    let high = high0
    let mut acc = 0
    let mut steps = 0
    while (low < limit) {  // range: 1/1
        let mid = low + (high - low) / 2
        acc = acc + xs[mid]
        low = low + 1
        steps = steps + 1
        if (steps > 20) { break }
    }
    return acc
}

// A nested loop that moves `high` leaves nothing known of it at the next head.
fn nestedGrow(n: Int, high0: Int) -> Int {
    let xs = ascending(n, 1)
    let mut low = 0
    let mut high = high0
    let mut acc = 0
    let mut steps = 0
    while (low <= high) {  // range: 0/1
        let mid = low + (high - low) / 2
        acc = acc + xs[mid]
        let mut r = 0
        while (r < 1) {
            high = high + 5
            r = r + 1
        }
        low = mid + 1
        steps = steps + 1
        if (steps > 12) { break }
    }
    return acc
}

fn check(label: String, got: Int, want: Int) -> Int {
    if (got != want) {
        println(label)
        return 1
    }
    return 0
}

// An arm whose index leaves the list runs only when its case is named: it must stop the
// program there (docs/MEMORY_SAFETY_PLAN.md section 2), where a proved copy taken for it
// would read past the list and run on. The harness runs one case per `expect-trap` line.
fn trapCase(name: String) -> Bool {
    return process.args.count > 1 and process.args[1].equals(name)
}

fn main() -> Int {
    let mut bad = 0

    bad = bad + check("FAIL: merge in range", merge(10, 0, 5, 10), 270)
    if (trapCase("merge-short-scratch")) { return (merge(6, 0, 5, 10)) as Int }
    if (trapCase("merge-past-the-end")) { return (merge(10, 3, 5, 14)) as Int }

    bad = bad + check("FAIL: sieve in range", sieveStep(40, 4, 2, 100), 22019)
    bad = bad + check("FAIL: sieve huge step", sieveStep(40, 4, 2147483600, 5), 40001)
    if (trapCase("sieve-wrapping-step")) { return (sieveStep(40, 4, 2147483647, 5)) as Int }
    bad = bad + check("FAIL: sieve start past n", sieveStep(40, 2147483600, 30, 5), 41000)

    bad = bad + check("FAIL: square in range", squareBound(50, 0, 1, 40, 1000), 147)
    if (trapCase("square-negative-start")) { return (squareBound(50, 0 - 5, 1, 30, 1000)) as Int }
    bad = bad + check("FAIL: square past the edge", squareBound(50000, 46000, 1, 2147483000, 2000), 225434488)
    bad = bad + check("FAIL: square step", squareBound(50, 0, 3, 40, 1000), 39)
    bad = bad + check("FAIL: square step jumps the edge", squareBound(50000, 46330, 3, 2147390000, 100), 235018080)
    if (trapCase("square-wrapping-step")) { return (squareBound(50, 0, 2147483647, 40, 5)) as Int }
    bad = bad + check("FAIL: square below", squareBelow(8, 50), 168)
    if (trapCase("square-below-short")) { return (squareBelow(5, 50)) as Int }
    bad = bad + check("FAIL: square below negative", squareBelow(8, 0 - 7), 0)

    bad = bad + check("FAIL: shifted in range", shifted(8, 0), 1505)
    if (trapCase("shifted-wrapping-start")) { return (shifted(8, 2147483646)) as Int }

    bad = bad + check("FAIL: match length", matchLength(3, 0, 10), 5)
    bad = bad + check("FAIL: match length short", matchLength(6, 0, 10), 2)
    bad = bad + check("FAIL: match length past the end", matchLength(3, 0, 20), 5)

    bad = bad + check("FAIL: reverse in range", reverse(8, 0, 7), 252)
    if (trapCase("reverse-past-the-end")) { return (reverse(8, 0, 11)) as Int }
    if (trapCase("reverse-before-the-start")) { return (reverse(8, 0 - 3, 4)) as Int }

    bad = bad + check("FAIL: for copy", forCopy(8, 0, 8, 0), 348)
    bad = bad + check("FAIL: for copy offset source", forCopy(8, 2, 8, 0), 217)
    if (trapCase("for-copy-offset-target")) { return (forCopy(8, 0, 8, 3)) as Int }
    if (trapCase("for-copy-past-the-end")) { return (forCopy(8, 0, 12, 0)) as Int }

    bad = bad + check("FAIL: for step", forStep(10, 0, 9, 3), 188)
    bad = bad + check("FAIL: for step one", forStep(10, 0, 9, 1), 440)
    if (trapCase("for-step-past-the-end")) { return (forStep(10, 4, 20, 5)) as Int }

    bad = bad + check("FAIL: for copy down", forCopy(8, 7, 0, 0), 224)
    if (trapCase("for-copy-down-past-the-end")) { return (forCopy(8, 12, 3, 0)) as Int }
    if (trapCase("for-copy-down-before-the-start")) { return (forCopy(8, 7, 0 - 3, 0)) as Int }

    bad = bad + check("FAIL: for step down", forStep(10, 9, 0, 3), 188)
    if (trapCase("for-step-down-past-the-end")) { return (forStep(10, 20, 4, 5)) as Int }
    if (trapCase("for-step-down-to-int-min")) { return (forStep(10, 5, 0 - 2147483647, 1000000000)) as Int }

    bad = bad + check("FAIL: for down", forDown(10, 9, 3, 1), 658)
    if (trapCase("for-down-past-the-end")) { return (forDown(10, 12, 3, 1)) as Int }
    if (trapCase("for-down-negative-weight")) { return (forDown(10, 9, 0 - 2, 1)) as Int }
    bad = bad + check("FAIL: for down one step", forDown(10, 3, 3, 1), 393)
    if (trapCase("for-down-counting-up")) { return (forDown(10, 2, 5, 1)) as Int }
    bad = bad + check("FAIL: for down literal", forDownLiteral(10), 10387)
    if (trapCase("for-down-literal-past-the-end")) { return (forDownLiteral(5)) as Int }

    bad = bad + check("FAIL: divided", divided(8, 0, 10), 229)
    if (trapCase("divided-negative")) { return (divided(8, 0 - 5, 6)) as Int }
    if (trapCase("divided-past-the-end")) { return (divided(8, 0, 20)) as Int }

    bad = bad + check("FAIL: masked", masked(8, 7, 0, 20), 114)
    if (trapCase("masked-past-the-end")) { return (masked(8, 15, 0, 20)) as Int }
    if (trapCase("masked-negative-mask")) { return (masked(8, 0 - 1, 0, 5)) as Int }

    if (trapCase("let-shadow")) { return (letShadow(5)) as Int }
    if (trapCase("let-shadow-past-the-end")) { return (letShadow(8)) as Int }
    bad = bad + check("FAIL: binder shadow", binderShadow(5, 2), 15)
    if (trapCase("binder-shadow-past-the-end")) { return (binderShadow(5, 9)) as Int }
    bad = bad + check("FAIL: nested bump", nestedBump(8), 16)
    if (trapCase("nested-bump-past-the-end")) { return (nestedBump(11)) as Int }

    bad = bad + check("FAIL: bisect found", bisect(16, 0, 15, 11), 1102)
    bad = bad + check("FAIL: bisect found low", bisect(16, 0, 15, 4), 404)
    bad = bad + check("FAIL: bisect missing", bisect(16, 0, 15, 99), 0 - 95)
    if (trapCase("bisect-past-the-end")) { return (bisect(16, 0, 20, 18)) as Int }
    bad = bad + check("FAIL: bisect before the start", bisect(16, 0 - 3, 15, 1), 102)
    if (trapCase("bisect-wrapping-span")) { return (bisect(16, 0 - 2147483600, 2147483600, 5)) as Int }
    if (trapCase("bisect-wrapping-bound")) { return (bisect(16, 0, 2147483647, 0)) as Int }
    bad = bad + check("FAIL: bisect sum found", bisectSum(16, 0, 15, 11), 1102)
    if (trapCase("bisect-sum-past-the-end")) { return (bisectSum(16, 0, 20, 18)) as Int }
    if (trapCase("bisect-sum-wrapping")) { return (bisectSum(16, 2147483000, 2147483600, 5)) as Int }
    bad = bad + check("FAIL: bisect sum before the start", bisectSum(16, 0 - 5, 15, 0), 2)
    bad = bad + check("FAIL: unordered midpoint", unordered(8, 0, 7, 8), 48)
    bad = bad + check("FAIL: unordered midpoint below", unordered(8, 6, 0, 8), 9)
    if (trapCase("nested-grow")) { return (nestedGrow(8, 7)) as Int }
    if (trapCase("nested-grow-past-the-end")) { return (nestedGrow(40, 7)) as Int }

    if (bad != 0) { return 1 }
    println("PASS: loop range proofs")
    return 0
}
