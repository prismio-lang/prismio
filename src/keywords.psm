extern fn str_equals(s1: String, s2: String) -> Int

fn is_keyword(s: String) -> Bool {
    // import
    if (str_equals(s, "import") == 1) { return true }
    
    // conditionals
    if (str_equals(s, "match") == 1) { return true }
    if (str_equals(s, "if") == 1) { return true }
    if (str_equals(s, "else") == 1) { return true }
    if (str_equals(s, "and") == 1) { return true }
    if (str_equals(s, "or") == 1) { return true }
    
    // boolean
    if (str_equals(s, "true") == 1) { return true }
    if (str_equals(s, "false") == 1) { return true }
    
    // flowControl
    if (str_equals(s, "break") == 1) { return true }
    if (str_equals(s, "continue") == 1) { return true }
    if (str_equals(s, "return") == 1) { return true }
    if (str_equals(s, "throw") == 1) { return true }
    
    // loops
    if (str_equals(s, "while") == 1) { return true }
    if (str_equals(s, "loop") == 1) { return true }
    if (str_equals(s, "for") == 1) { return true }
    if (str_equals(s, "in") == 1) { return true }
    
    // declarations
    if (str_equals(s, "let") == 1) { return true }
    if (str_equals(s, "struct") == 1) { return true }
    if (str_equals(s, "impl") == 1) { return true }
    if (str_equals(s, "enum") == 1) { return true }
    if (str_equals(s, "trait") == 1) { return true }
    if (str_equals(s, "fn") == 1) { return true }
    if (str_equals(s, "extern") == 1) { return true }
    
    // property
    if (str_equals(s, "mut") == 1) { return true }

    // conversions
    if (str_equals(s, "as") == 1) { return true }

    // parameter conventions (ownership / borrows)
    if (str_equals(s, "inout") == 1) { return true }
    if (str_equals(s, "sink") == 1) { return true }

    // memory model. SPEC 5.2: pins an arena at this scope. Unlike the FFI
    // contract names, which are contextual, this one opens a statement and so
    // has to be a real keyword.
    if (str_equals(s, "region") == 1) { return true }

    // REQUIREMENTS 4. The absent reference. A real keyword rather than a
    // contextual name, unlike `unique` and `pin`: those are annotations, and
    // SPEC 5 requires that deleting one leave a working program. `none` is a
    // *value* -- deleting it leaves a hole -- so the obligation does not apply
    // and a keyword is the honest spelling.
    if (str_equals(s, "none") == 1) { return true }

    return false
}

fn is_boolean(s: String) -> Bool {
    if (str_equals(s, "true") == 1) { return true }
    if (str_equals(s, "false") == 1) { return true }
    return false
}
