// The builtins and runtime calls the interpreter models: what std reaches the compiler
// and the runtime through for strings, `Vec`s, scalars, the console, failures and the
// argument vector. A call of anything else makes the program ineligible, by that name.
// Each answers as codegen and runtime/lang_runtime.c do, failure messages included.

import std.collections.vec
import std.string
import std.io
import std.core.key
import ast.nodes
import common.target
import common.source_files
import common.float_builtins
import pir.types
import pir.graph
import pir.builder
import pir.interp_types
import pir.interp_heap
import pir.interp_ops
import pir.interp

public enum PirBuiltin {
    LIST_NEW, LIST_NEW_WITH_CAPACITY, LIST_NEW_FILLED, LIST_SWAP, LIST_TRUNCATE, LIST_REMOVE_AT,
    LIST_INSERT, LIST_RESERVE, LIST_SHRINK, LIST_CAPACITY, SLICE_LEN, DROP,
    STR_WITH_CAPACITY, STRING_LEN, BYTE_AT, PUT_BYTE, STRING_EQ, STRING_COMPARE, STRING_HASH,
    STRING_RANGE, STRING_CONCAT, FROM_INT, CSTRING_AT,
    CONSOLE_WRITE, ERRNO, ERRNO_INTR, FIND_BYTE, FIND_BYTE_PAIR, FIND_NEEDLE,
    PANIC, UNREACHABLE_CODE, ASSERT, EXIT, ASSUME, STEP_CHECK, TARGET_OS, TARGET_ARCH, TARGET_ENV,
    FLOAT_BITS, FLOAT_FROM_BITS, COUNT_ONES, LEADING_ZEROS, TRAILING_ZEROS, ROTATE_LEFT,
    ROTATE_RIGHT, SWAP_BYTES, MINIMUM, MAXIMUM, ABSOLUTE, RANGE_COUNT, RANGE_AT, INDEX_INT
}

// The ids of the `__builtin_f64_*` family start here, by their table's position.
private fn pirFloatBase() -> Int { return 1000 }

private fn pirBuiltinName(builtin: String) -> Int {
    if (builtin.equals("list_new")) { return PirBuiltin.LIST_NEW as Int }
    if (builtin.equals("list_new_with_capacity")) { return PirBuiltin.LIST_NEW_WITH_CAPACITY as Int }
    if (builtin.equals("list_new_filled")) { return PirBuiltin.LIST_NEW_FILLED as Int }
    if (builtin.equals("list_swap")) { return PirBuiltin.LIST_SWAP as Int }
    if (builtin.equals("list_truncate")) { return PirBuiltin.LIST_TRUNCATE as Int }
    if (builtin.equals("list_remove_at")) { return PirBuiltin.LIST_REMOVE_AT as Int }
    if (builtin.equals("list_insert")) { return PirBuiltin.LIST_INSERT as Int }
    if (builtin.equals("list_reserve")) { return PirBuiltin.LIST_RESERVE as Int }
    if (builtin.equals("list_shrink_to_fit")) { return PirBuiltin.LIST_SHRINK as Int }
    if (builtin.equals("list_capacity")) { return PirBuiltin.LIST_CAPACITY as Int }
    if (builtin.equals("slice_len")) { return PirBuiltin.SLICE_LEN as Int }
    if (builtin.equals("drop")) { return PirBuiltin.DROP as Int }
    if (builtin.equals("str_with_capacity")) { return PirBuiltin.STR_WITH_CAPACITY as Int }
    if (builtin.equals("__builtin_string_len")) { return PirBuiltin.STRING_LEN as Int }
    if (builtin.equals("__builtin_string_byte_at")) { return PirBuiltin.BYTE_AT as Int }
    if (builtin.equals("__builtin_string_put_byte")) { return PirBuiltin.PUT_BYTE as Int }
    if (builtin.equals("__builtin_string_eq")) { return PirBuiltin.STRING_EQ as Int }
    if (builtin.equals("__builtin_string_compare")) { return PirBuiltin.STRING_COMPARE as Int }
    if (builtin.equals("__builtin_string_hash")) { return PirBuiltin.STRING_HASH as Int }
    if (builtin.equals("__builtin_string_inline") or builtin.equals("__builtin_string_view")) {
        return PirBuiltin.STRING_RANGE as Int
    }
    if (builtin.startsWith("__builtin_string_concat_inline")) { return PirBuiltin.STRING_CONCAT as Int }
    if (builtin.equals("__builtin_string_from_int")) { return PirBuiltin.FROM_INT as Int }
    if (builtin.equals("__builtin_cstring_at")) { return PirBuiltin.CSTRING_AT as Int }
    if (builtin.equals("__builtin_console_write")) { return PirBuiltin.CONSOLE_WRITE as Int }
    if (builtin.equals("__builtin_errno")) { return PirBuiltin.ERRNO as Int }
    if (builtin.equals("__builtin_errno_intr")) { return PirBuiltin.ERRNO_INTR as Int }
    if (builtin.equals("str_find_byte")) { return PirBuiltin.FIND_BYTE as Int }
    if (builtin.equals("str_find_byte_pair")) { return PirBuiltin.FIND_BYTE_PAIR as Int }
    if (builtin.equals("str_find_needle")) { return PirBuiltin.FIND_NEEDLE as Int }
    if (builtin.equals("__builtin_panic")) { return PirBuiltin.PANIC as Int }
    if (builtin.equals("__builtin_unreachable")) { return PirBuiltin.UNREACHABLE_CODE as Int }
    if (builtin.equals("__builtin_assert")) { return PirBuiltin.ASSERT as Int }
    if (builtin.equals("__builtin_exit") or builtin.equals("exit")) { return PirBuiltin.EXIT as Int }
    if (builtin.equals("__builtin_assume")) { return PirBuiltin.ASSUME as Int }
    if (builtin.equals("prismio_step_check")) { return PirBuiltin.STEP_CHECK as Int }
    if (builtin.equals("__builtin_target_os")) { return PirBuiltin.TARGET_OS as Int }
    if (builtin.equals("__builtin_target_arch")) { return PirBuiltin.TARGET_ARCH as Int }
    if (builtin.equals("__builtin_target_env")) { return PirBuiltin.TARGET_ENV as Int }
    if (builtin.equals("__builtin_float_bits")) { return PirBuiltin.FLOAT_BITS as Int }
    if (builtin.equals("__builtin_float_from_bits")) { return PirBuiltin.FLOAT_FROM_BITS as Int }
    if (builtin.equals("__builtin_count_ones")) { return PirBuiltin.COUNT_ONES as Int }
    if (builtin.equals("__builtin_leading_zeros")) { return PirBuiltin.LEADING_ZEROS as Int }
    if (builtin.equals("__builtin_trailing_zeros")) { return PirBuiltin.TRAILING_ZEROS as Int }
    if (builtin.equals("__builtin_rotate_left")) { return PirBuiltin.ROTATE_LEFT as Int }
    if (builtin.equals("__builtin_rotate_right")) { return PirBuiltin.ROTATE_RIGHT as Int }
    if (builtin.equals("__builtin_swap_bytes")) { return PirBuiltin.SWAP_BYTES as Int }
    if (builtin.equals("__builtin_min")) { return PirBuiltin.MINIMUM as Int }
    if (builtin.equals("__builtin_max")) { return PirBuiltin.MAXIMUM as Int }
    if (builtin.equals("__builtin_abs")) { return PirBuiltin.ABSOLUTE as Int }
    if (builtin.equals("__builtin_range_count")) { return PirBuiltin.RANGE_COUNT as Int }
    if (builtin.equals("__builtin_range_at")) { return PirBuiltin.RANGE_AT as Int }
    if (builtin.equals("__builtin_index_int")) { return PirBuiltin.INDEX_INT as Int }
    return -1
}

// The id `pirRunBuiltin` takes for a call of `name`, or -1 when it is not modelled.
public fn pirBuiltinId(name: String) -> Int {
    if (floatBuiltinArity(name) > 0) {
        let prefix = floatBuiltinPrefix()
        let op = name.substring(prefix.length, name.length - prefix.length)
        let mut i = 0
        while (floatBuiltinOp(i).equals("") == false) {
            if (floatBuiltinOp(i).equals(op)) { return pirFloatBase() + i }
            i = i + 1
        }
        return -1
    }
    return pirBuiltinName(name)
}

// `kind: message`, then where, and status 101 (prismio_fail_at).
internal fn pirPanic(m: PirMachine, f: PirFunc, node: Int, kind: String, message: String) {
    let at = ptr_to_node(f.nodeAst[node])
    let mut text = kind.clone()
    if (message.length > 0) { text = text.concat(": ", message) }
    pirFail(m, 101, text.concat("\n  --> ", diag_file_path(at.file), ":", at.line.toString(), ":", at.col.toString()))
}

private fn pirCountOnes(value: U64) -> Int {
    let mut rest = value
    let mut count = 0
    while (rest != (0 as U64)) {
        rest = rest & (rest - (1 as U64))
        count = count + 1
    }
    return count
}

private fn pirBitCount(builtin: PirBuiltin, word: I64, bits: Int) -> Int {
    let value = (word & pirMask(bits)) as U64
    if (builtin == PirBuiltin.COUNT_ONES) { return pirCountOnes(value) }
    let mut count = 0
    while (count < bits) {
        let mut at = count
        if (builtin == PirBuiltin.LEADING_ZEROS) { at = bits - 1 - count }
        if ((value >> (at as U64)) & (1 as U64) != (0 as U64)) { return count }
        count = count + 1
    }
    return count
}

private fn pirRotate(word: I64, distance: I64, bits: Int, left: Bool) -> I64 {
    let value = (word & pirMask(bits)) as U64
    let mut by = (distance & ((bits - 1) as I64)) as Int
    if (left == false and by != 0) { by = bits - by }
    if (by == 0) { return value as I64 }
    return (((value << (by as U64)) | (value >> ((bits - by) as U64))) as I64) & pirMask(bits)
}

private fn pirSwapBytes(word: I64, bits: Int) -> I64 {
    let value = (word & pirMask(bits)) as U64
    let mut out = 0 as U64
    for i in 0..<(bits / 8) {
        out = (out << (8 as U64)) | ((value >> ((i * 8) as U64)) & (255 as U64))
    }
    return out as I64
}

// Where `needle` first starts in `text[from..<length]`, or -1.
private fn pirFind(heap: PirHeap, text: I64, from: Int, length: Int, needle: I64, needleLength: Int) -> Int {
    let mut at = from
    while (at <= length - needleLength) {
        let mut i = 0
        while (i < needleLength and pirStringByte(heap, text, at + i) == pirStringByte(heap, needle, i)) { i = i + 1 }
        if (i == needleLength) { return at }
        at = at + 1
    }
    return -1
}

private fn pirWrite(m: PirMachine, heap: PirHeap, fd: Int, text: I64, count: Int) {
    let range = pirStringRange(heap, text, 0, count, -1)
    let native = pirStringText(heap, range)
    if (fd == 1) {
        print(native)
    } else if (fd == 2) {
        eprint(native)
    } else {
        pirStop(m, "write to descriptor ".concat(fd.toString()))
    }
}

// Runs builtin `id` for call `node` of `f`, whose registers start at `base`.
public fn pirRunBuiltin(program: PirProgram, shapes: PirShapes, heap: PirHeap, m: PirMachine, f: PirFunc, base: Int, node: Int, site: Int, id: Int) {
    let count = f.opCount[node]
    let mut a = 0 as I64
    let mut b = 0 as I64
    let mut c = 0 as I64
    if (count > 0) { a = m.regs[base + pirOperandAt(f, node, 0)] }
    if (count > 1) { b = m.regs[base + pirOperandAt(f, node, 1)] }
    if (count > 2) { c = m.regs[base + pirOperandAt(f, node, 2)] }
    for i in 0..<count { pirPinCheck(heap, m.pins[base + pirOperandAt(f, node, i)], site) }

    let mut result = -1
    let mut resultType = -1
    if (f.resCount[node] > 0 and f.valFrom[pirResultAt(f, node, 0)] < 0) {
        result = pirResultAt(f, node, 0)
        resultType = f.valType[result]
    }
    let mut value = 0 as I64

    if (id >= pirFloatBase()) {
        value = pirFloatLibrary(id - pirFloatBase(), a, b, c)
    } else if (id <= PirBuiltin.DROP as Int) {
        value = pirListBuiltin(program, shapes, heap, m, f, base, node, site, id, a, b, c)
    } else if (id <= PirBuiltin.CSTRING_AT as Int) {
        value = pirStringBuiltin(heap, m, f, base, node, site, id, a, b, c)
    } else if (id == PirBuiltin.CONSOLE_WRITE as Int) {
        pirWrite(m, heap, a as Int, b, c as Int)
        value = c
    } else if (id == PirBuiltin.ERRNO as Int) {
        value = 0 as I64
    } else if (id == PirBuiltin.ERRNO_INTR as Int) {
        // EINTR; the console write above never fails with it.
        value = 4 as I64
    } else if (id == PirBuiltin.FIND_BYTE as Int) {
        value = -1 as I64
        let from = b as Int
        // `strchr`: the terminator is findable.
        let length = pirStringLength(heap, a)
        if (from >= 0) {
            for i in from..length {
                if (i <= length and pirStringByte(heap, a, i) == (c as Int)) {
                    value = i as I64
                    break
                }
            }
        }
    } else if (id == PirBuiltin.FIND_BYTE_PAIR as Int) {
        value = -1 as I64
        let from = b as Int
        let last = c as Int
        let offset1 = m.regs[base + pirOperandAt(f, node, 3)] as Int
        let byte1 = m.regs[base + pirOperandAt(f, node, 4)] as Int
        let offset2 = m.regs[base + pirOperandAt(f, node, 5)] as Int
        let byte2 = m.regs[base + pirOperandAt(f, node, 6)] as Int
        let mut at = from
        while (from >= 0 and offset1 >= 0 and offset2 >= 0 and at <= last) {
            if (pirStringByte(heap, a, at + offset1) == byte1 and pirStringByte(heap, a, at + offset2) == byte2) {
                value = at as I64
                break
            }
            at = at + 1
        }
    } else if (id == PirBuiltin.FIND_NEEDLE as Int) {
        // The runtime may answer "give up at i" instead; the exact answer is within its
        // contract.
        let needle = m.regs[base + pirOperandAt(f, node, 3)]
        let needleLength = m.regs[base + pirOperandAt(f, node, 4)] as Int
        value = -1 as I64
        if (b >= (0 as I64) and needleLength >= 2 and needleLength <= 32) {
            value = pirFind(heap, a, b as Int, c as Int, needle, needleLength) as I64
        }
    } else if (id == PirBuiltin.PANIC as Int or id == PirBuiltin.UNREACHABLE_CODE as Int) {
        let mut message = "".clone()
        if (count > 0 and a != (0 as I64)) { message = pirStringText(heap, a) }
        let mut kind = "panic"
        if (id == PirBuiltin.UNREACHABLE_CODE as Int) { kind = "panic: entered unreachable code" }
        pirPanic(m, f, node, kind, message)
    } else if (id == PirBuiltin.ASSERT as Int) {
        if (a == (0 as I64)) {
            let at = ptr_to_node(f.nodeAst[node])
            let mut message = "".clone()
            if (count > 1) { message = pirStringText(heap, b) }
            if (message.length == 0) { message = diag_source_line(at.file, at.line) }
            pirPanic(m, f, node, "assertion failed", message)
        }
    } else if (id == PirBuiltin.EXIT as Int) {
        pirExitProgram(m, a as Int)
    } else if (id == PirBuiltin.STEP_CHECK as Int) {
        if (a <= (0 as I64)) {
            let at = ptr_to_node(f.nodeAst[node])
            pirFail(m, 1, "runtime error: a `step` must be positive, found ".concat(a.toString(), " at ",
                diag_file_path(at.file), ":", at.line.toString()))
        }
    } else if (id == PirBuiltin.TARGET_OS as Int) {
        value = targetOsCode() as I64
    } else if (id == PirBuiltin.TARGET_ARCH as Int) {
        value = targetArchCode() as I64
    } else if (id == PirBuiltin.TARGET_ENV as Int) {
        value = targetEnvCode() as I64
    } else if (id == PirBuiltin.FLOAT_BITS as Int or id == PirBuiltin.FLOAT_FROM_BITS as Int) {
        value = a
    } else if (id != PirBuiltin.ASSUME as Int) {
        value = pirNumberBuiltin(shapes, f, node, id, resultType, a, b, c, m, base)
    }

    if (result >= 0 and m.halted == false) {
        m.regs[base + result] = value
        m.pins[base + result] = 0
        // A view of a String still reads its bytes; a copy of one does not.
        if (id == PirBuiltin.STRING_RANGE as Int and f.nodeName[node].equals("__builtin_string_view")) {
            m.pins[base + result] = m.pins[base + pirOperandAt(f, node, 0)]
        }
    }
    pirHandBack(m, f, base, node)
}

private fn pirNumberBuiltin(shapes: PirShapes, f: PirFunc, node: Int, id: Int, resultType: Int, a: I64, b: I64, c: I64, m: PirMachine, base: Int) -> I64 {
    let operandType = f.valType[pirOperandAt(f, node, 0)]
    let bits = shapes.bits[operandType]
    let signed = shapes.signed[operandType]
    if (id == PirBuiltin.COUNT_ONES as Int) { return pirBitCount(PirBuiltin.COUNT_ONES, a, bits) as I64 }
    if (id == PirBuiltin.LEADING_ZEROS as Int) { return pirBitCount(PirBuiltin.LEADING_ZEROS, a, bits) as I64 }
    if (id == PirBuiltin.TRAILING_ZEROS as Int) { return pirBitCount(PirBuiltin.TRAILING_ZEROS, a, bits) as I64 }
    if (id == PirBuiltin.ROTATE_LEFT as Int) { return pirNormalize(pirRotate(a, b, bits, true), bits, signed) }
    if (id == PirBuiltin.ROTATE_RIGHT as Int) { return pirNormalize(pirRotate(a, b, bits, false), bits, signed) }
    if (id == PirBuiltin.SWAP_BYTES as Int) { return pirNormalize(pirSwapBytes(a, bits), bits, signed) }
    if (id == PirBuiltin.MINIMUM as Int) {
        if (a < b) { return a }
        return b
    }
    if (id == PirBuiltin.MAXIMUM as Int) {
        if (a > b) { return a }
        return b
    }
    if (id == PirBuiltin.ABSOLUTE as Int) {
        if (a < (0 as I64)) { return pirNormalize((0 as I64) - a, 32, true) }
        return a
    }
    if (id == PirBuiltin.INDEX_INT as Int) {
        let high = 2147483647 as I64
        if (signed == false) {
            if ((a as U64) > (high as U64)) { return high }
            return a
        }
        if (a > high) { return high }
        if (a < (0 as I64) - high - (1 as I64)) { return (0 as I64) - high - (1 as I64) }
        return a
    }
    // `__builtin_range_count(lo, hi, step, included)` and `_at(lo, k, step, down)`, in
    // 64 unsigned bits (src/ir/range_values.psm).
    let fourth = m.regs[base + pirOperandAt(f, node, 3)]
    if (id == PirBuiltin.RANGE_COUNT as Int) {
        let mut ascending = a <= b
        if (signed == false) { ascending = (a as U64) <= (b as U64) }
        let mut span = (b - a) as U64
        if (ascending == false) { span = (a - b) as U64 }
        let step = (c & pirMask(32)) as U64
        if (step == (0 as U64)) { return 0 as I64 }
        let whole = span / step
        if (fourth != (0 as I64)) { return (whole + (1 as U64)) as I64 }
        if (span % step != (0 as U64)) { return (whole + (1 as U64)) as I64 }
        return whole as I64
    }
    let distance = (b & pirMask(32)) * (c & pirMask(32))
    let mut at = a + distance
    if (fourth != (0 as I64)) { at = a - distance }
    return pirNormalize(at, shapes.bits[resultType], shapes.signed[resultType])
}

private fn pirStringBuiltin(heap: PirHeap, m: PirMachine, f: PirFunc, base: Int, node: Int, site: Int, id: Int, a: I64, b: I64, c: I64) -> I64 {
    if (id == PirBuiltin.STR_WITH_CAPACITY as Int) {
        let out = pirObjectNew(heap, PirObjectKind.STRING, -1, site)
        let length = a as Int
        if (length < 0 or length > 268435456) {
            pirStop(m, "string of ".concat(length.toString(), " bytes"))
            return out
        }
        for i in 0..<length { heap.objects[out as Int].bytes.push(0 as U8) }
        return out
    }
    if (id == PirBuiltin.STRING_LEN as Int) { return pirStringLength(heap, a) as I64 }
    // A Char is held unsigned.
    if (id == PirBuiltin.BYTE_AT as Int) { return pirStringByte(heap, a, b as Int) as I64 }
    if (id == PirBuiltin.PUT_BYTE as Int) {
        let at = b as Int
        if (at >= 0 and at < pirStringLength(heap, a)) {
            heap.objects[a as Int].bytes[at] = (c & (255 as I64)) as U8
        } else if (at != pirStringLength(heap, a)) {
            pirStop(m, "write outside a string")
        }
        return 0 as I64
    }
    if (id == PirBuiltin.STRING_EQ as Int) { return pirBool(pirStringEquals(heap, a, b)) }
    if (id == PirBuiltin.STRING_COMPARE as Int) {
        let left = pirStringText(heap, a)
        let right = pirStringText(heap, b)
        return left.compare(right) as I64
    }
    if (id == PirBuiltin.STRING_HASH as Int) {
        let text = pirStringText(heap, a)
        return text.hash() as I64
    }
    if (id == PirBuiltin.STRING_RANGE as Int) { return pirStringRange(heap, a, b as Int, c as Int, site) }
    if (id == PirBuiltin.STRING_CONCAT as Int) {
        let out = pirObjectNew(heap, PirObjectKind.STRING, -1, site)
        for i in 0..<f.opCount[node] {
            let part = m.regs[base + pirOperandAt(f, node, i)]
            pirStringAppend(heap, out, part, 0, pirStringLength(heap, part))
        }
        return out
    }
    if (id == PirBuiltin.FROM_INT as Int) {
        return pirStringNew(heap, (a as Int).toString(), site)
    }
    // CSTRING_AT: the program's argument vector, which holds its own path and no more.
    if (b == (0 as I64)) { return pirStringNew(heap, m.argv0, site) }
    pirStop(m, "argument ".concat(b.toString()))
    return 0 as I64
}

public fn pirStringEquals(heap: PirHeap, a: I64, b: I64) -> Bool {
    if (a == (0 as I64) or b == (0 as I64)) { return a == b }
    let length = pirStringLength(heap, a)
    if (length != pirStringLength(heap, b)) { return false }
    for i in 0..<length {
        if (pirStringByte(heap, a, i) != pirStringByte(heap, b, i)) { return false }
    }
    return true
}

private fn pirListBuiltin(program: PirProgram, shapes: PirShapes, heap: PirHeap, m: PirMachine, f: PirFunc, base: Int, node: Int, site: Int, id: Int, a: I64, b: I64, c: I64) -> I64 {
    if (id == PirBuiltin.DROP as Int) { return 0 as I64 }
    if (id == PirBuiltin.LIST_NEW as Int or id == PirBuiltin.LIST_NEW_WITH_CAPACITY as Int
            or id == PirBuiltin.LIST_NEW_FILLED as Int) {
        let type = f.valType[pirResultAt(f, node, 0)]
        let list = pirObjectNew(heap, PirObjectKind.VEC, type, site)
        if (id == PirBuiltin.LIST_NEW as Int) { return list }
        let wanted = a as Int
        if (id == PirBuiltin.LIST_NEW_FILLED as Int and wanted < 0) {
            pirFail(m, 1, "runtime error: Vec.filled count must not be negative, found ".concat(wanted.toString()))
            return list
        }
        let mut capacity = 4
        if (wanted > 0) { capacity = wanted }
        heap.objects[list as Int].capacity = capacity
        if (id == PirBuiltin.LIST_NEW_FILLED as Int) {
            if (wanted > 100000000) {
                pirStop(m, "Vec of ".concat(wanted.toString(), " elements"))
                return list
            }
            for i in 0..<wanted { heap.objects[list as Int].slots.push(b) }
        }
        return list
    }
    if (id == PirBuiltin.SLICE_LEN as Int) { return heap.objects[a as Int].slots[2] }

    let list = a as Int
    if (a == (0 as I64)) {
        pirStop(m, "null Vec")
        return 0 as I64
    }
    let length = heap.objects[list].slots.length
    if (id == PirBuiltin.LIST_CAPACITY as Int) { return heap.objects[list].capacity as I64 }
    if (id == PirBuiltin.LIST_SWAP as Int) {
        let i = b as Int
        let j = c as Int
        if (i < 0 or i >= length) {
            pirIndexFail(m, "a Vec", i, length)
        } else if (j < 0 or j >= length) {
            pirIndexFail(m, "a Vec", j, length)
        } else {
            let held = heap.objects[list].slots[i]
            heap.objects[list].slots[i] = heap.objects[list].slots[j]
            heap.objects[list].slots[j] = held
            pirBumpContents(heap, list)
        }
    } else if (id == PirBuiltin.LIST_TRUNCATE as Int) {
        let mut keep = b as Int
        if (keep < 0) { keep = 0 }
        if (keep < length) {
            heap.objects[list].slots.truncate(keep)
            pirBumpContents(heap, list)
        }
    } else if (id == PirBuiltin.LIST_REMOVE_AT as Int) {
        let at = b as Int
        if (at < 0 or at >= length) {
            pirFail(m, 1, "runtime error: removeAt index ".concat(at.toString(), " is out of range for length ", length.toString()))
        } else {
            for i in at..<(length - 1) { heap.objects[list].slots[i] = heap.objects[list].slots[i + 1] }
            heap.objects[list].slots.truncate(length - 1)
            pirBumpContents(heap, list)
        }
    } else if (id == PirBuiltin.LIST_INSERT as Int) {
        let at = b as Int
        if (at < 0 or at > length) {
            pirFail(m, 1, "runtime error: insert index ".concat(at.toString(), " is out of range for length ", length.toString()))
        } else {
            let element = program.types.child[heap.objects[list].type]
            let stored = pirStored(program, shapes, heap, element, c, site)
            pirGrow(heap, list)
            heap.objects[list].slots.push(stored)
            let mut i = length
            while (i > at) {
                heap.objects[list].slots[i] = heap.objects[list].slots[i - 1]
                i = i - 1
            }
            heap.objects[list].slots[at] = stored
            pirBumpContents(heap, list)
        }
    } else if (id == PirBuiltin.LIST_RESERVE as Int) {
        let wanted = b as Int
        if (wanted > heap.objects[list].capacity) {
            heap.objects[list].capacity = wanted
            pirBumpContents(heap, list)
        }
    } else if (id == PirBuiltin.LIST_SHRINK as Int) {
        if (heap.objects[list].capacity > length) {
            heap.objects[list].capacity = length
            pirBumpContents(heap, list)
        }
    }
    return 0 as I64
}
