// What `--emit-pir`, `--pir-coverage` and `--pir-run` ask for: build PIR for a checked
// module, verify it, and report on it or interpret it. Nothing here runs without one of
// those flags, and nothing it does reaches the AST, the analysis or the emitted program.

import std.collections.vec
import std.collections.map
import std.string
import std.io
import std.fs
import ast.nodes
import common.diagnostics
import common.diag_codes
import pir.graph
import pir.builder
import pir.summaries
import pir.leaks
import pir.verify
import pir.dump
import pir.interp

// `emit` is "" for no dump, "-" for standard output, and otherwise the file to write.
// False when the dump could not be written or the verifier found something, with the
// diagnostics already raised.
public fn pirRun(module: ASTNode, sourcePath: String, emit: String, coverage: Bool, overflowChecks: Bool) -> Bool {
    let program = pirBuildProgram(module, overflowChecks)
    return pirReportProgram(program, sourcePath, emit, coverage)
}

// `--pir-run`: what `pirRun` does and then, if the verifier accepted it, the program run by
// the interpreter. Answers the status to exit with.
public fn pirRunInterpreted(module: ASTNode, sourcePath: String, emit: String, coverage: Bool, overflowChecks: Bool, argv0: String) -> Int {
    let program = pirBuildProgram(module, overflowChecks)
    if (pirReportProgram(program, sourcePath, emit, coverage) == false) { return 1 }
    return pirInterpret(program, module, argv0)
}

private fn pirReportProgram(program: PirProgram, sourcePath: String, emit: String, coverage: Bool) -> Bool {
    let report = pirVerifyProgram(program)

    let mut written = true
    if (emit.equals("-")) {
        print(pirDumpProgram(program))
    } else if (emit.equals("") == false) {
        written = writeFile(emit, pirDumpProgram(program))
        if (written == false) {
            diag_error_code(DIAG_DRIVER_PIR_UNWRITABLE, "cannot write PIR to ".concat(diagQuote(emit)))
        }
    }
    if (coverage) {
        pirPrintCoverage(program, report, sourcePath)
        pirPrintLeaks(pirEstimateLeaks(program))
    }

    for finding in report.findings {
        diag_error_code(DIAG_DRIVER_PIR_REJECTED, "PIR verification failed (a compiler bug): ".concat(finding))
    }
    return written and report.findings.length == 0
}

private fn pirRatio(covered: Int, total: Int) -> String {
    return covered.toString().concat("/", total.toString())
}

private fn pirPrintLeaks(leaks: PirLeaks) {
    println("  allocations ".concat(leaks.allocations.toString(),
        ", PIR would drop ", leaks.dropped.toString(),
        ": released today ", leaks.released.toString(),
        ", not released today ", leaks.unreleased.toString(),
        " (program ", leaks.unreleasedOwn.toString(), ")",
        "; displaced values nothing consumes ", leaks.displaced.toString()))
    for i in 0..<leaks.examples.length {
        if (i == 40) { break }
        println("    unreleased ".concat(leaks.examples[i]))
    }
}

private fn pirPrintCoverage(program: PirProgram, report: PirReport, sourcePath: String) {
    let mut ownCovered = 0
    let mut libraryCovered = 0
    let mut ownRefused = 0
    let mut libraryRefused = 0
    let mut nodes = 0
    let mut values = 0
    for i in 0..<program.funcs.length {
        let library = program.funcs[i].library
        if (program.funcs[i].refusal.equals("") == false) {
            if (library) {
                libraryRefused = libraryRefused + 1
            } else {
                ownRefused = ownRefused + 1
            }
            continue
        }
        if (library) {
            libraryCovered = libraryCovered + 1
        } else {
            ownCovered = ownCovered + 1
        }
        nodes = nodes + program.funcs[i].op.length
        values = values + program.funcs[i].valDef.length
    }

    println("pir coverage: ".concat(sourcePath))
    println("  functions ".concat(pirRatio(ownCovered + libraryCovered, program.funcs.length), " covered (program ",
        pirRatio(ownCovered, ownCovered + ownRefused), ", library ",
        pirRatio(libraryCovered, libraryCovered + libraryRefused), ")"))
    println("  nodes ".concat(nodes.toString(), ", values ", values.toString(),
        ", types ", program.types.kind.length.toString()))
    println("  verifier findings ".concat(report.findings.length.toString()))
    println("  A1 (reported, not enforced): owned values ".concat(report.owned.toString(),
        ", no consumer ", report.unconsumed.toString(),
        ", one ", report.consumedOnce.toString(),
        ", more ", report.consumedMore.toString(),
        "; read after consume ", report.readAfterConsume.toString()))
    println("  A4 carried values also consumed ".concat(report.carriedConsumed.toString(),
        "; own ?w values ", report.witnessed.toString()))
    pirPrintRefusals(program)
}

// The refusal reasons, most frequent first and then by name, each with the first
// function that met it.
private fn pirPrintRefusals(program: PirProgram) {
    let mut reasons: Vec<String> = []
    let mut counts: Vec<Int> = []
    let mut own: Vec<Int> = []
    let mut first: Vec<Int> = []
    let seen = HashMap<String, Int>()
    for i in 0..<program.funcs.length {
        if (program.funcs[i].refusal.equals("")) { continue }
        let mut at = seen.getOr(program.funcs[i].refusal.clone(), -1)
        if (at < 0) {
            at = reasons.length
            seen.insert(program.funcs[i].refusal.clone(), at)
            reasons.push(program.funcs[i].refusal.clone())
            counts.push(0)
            own.push(0)
            first.push(i)
        }
        counts[at] = counts[at] + 1
        if (program.funcs[i].library == false) { own[at] = own[at] + 1 }
    }
    if (reasons.length == 0) { return }
    println("  refused (reason, functions, of which program; first met in):")
    let mut printed: Vec<Bool> = Vec<Bool>.filled(reasons.length, false)
    repeat(reasons.length) {
        let mut best = -1
        for i in 0..<reasons.length {
            if (printed[i]) { continue }
            if (best < 0 or counts[i] > counts[best]
                    or (counts[i] == counts[best] and reasons[i].compare(reasons[best]) < 0)) {
                best = i
            }
        }
        printed[best] = true
        println("    ".concat(reasons[best], "\t", counts[best].toString(), "\t", own[best].toString(),
            "\t", program.funcs[first[best]].name))
    }
}
