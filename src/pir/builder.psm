// The PIR builder (docs/PIR_PLAN.md §20, stage P0): a checked function's AST to PIR-H.
// What it does not cover yet: closures called as values, trait objects, tasks and
// `async`, and `region` and `scope` blocks.
// This module owns the function: its scope, signature and statements. Expressions,
// stores, branches and loops are in their own modules.
//
// A function that uses something not covered is refused with the reason it first met,
// and its graph is not used: a partial function would verify and mean something other
// than its source.
//
// Ownership is sema's answer, not a second analysis. A type is owned where sema made it
// move-only; a use consumes where sema marked the move (IDENTIFIER_EXPR.i3) or the
// callee takes its argument; a parameter, a field read, an element read and a global
// read are views, and so is a call result that may view something (pir.summaries).

import std.collections.vec
import std.collections.map
import std.string
import ast.nodes
import ast.types
import ast.fn_attrs
import common.source_files
import pir.types
import pir.graph
import pir.state
import pir.expr
import pir.memory
import pir.branch
import pir.loops

public struct PirProgram {
    public types: PirTypes,
    // Every function with a body, in module order; a refused one says why.
    public funcs: Vec<PirFunc>,
    internal sources: Vec<Ptr>,
    // Declarations by the symbol a resolved call names, and structs by name.
    internal declNodes: Vec<Ptr>,
    internal declBySymbol: HashMap<String, Int>,
    internal structByName: HashMap<String, Int>,
    // 1: a module-level global. 2: a function or extern name.
    internal topNames: HashMap<String, Int>,
    // The functions whose result may view something they were passed or can reach.
    internal viewResults: HashMap<String, Int>,
    internal overflowChecks: Bool
}

// What one exit out of a loop carries, kept until the loop is complete: the locals and
// the state as they stood.
internal struct PirExitSnapshot {
    internal node: Int,
    // The loop region it targets, and whether it leaves the loop or continues it.
    internal target: Int,
    internal leaves: Bool,
    internal values: Vec<Int>,
    internal live: Vec<Bool>,
    // Into `PirScope.snapshots`.
    internal state: Int
}

// The state of the one function being built: where it is, and which value each local
// in scope has. A local that was moved, or declared without a value, is not live.
internal struct PirScope {
    internal names: Vec<String>,
    internal values: Vec<Int>,
    internal declared: Vec<Int>,
    internal live: Vec<Bool>,
    // Indices of the `inout` parameters, whose final values leave through the return port.
    internal inouts: Vec<Int>,
    internal reg: Int,
    // The current region has its terminating exit.
    internal done: Bool,
    // Why the function is not covered; "" while it is.
    internal refusal: String,
    internal state: PirState,
    // The states kept at the ends of arms and at loop exits, until their join is built.
    internal snapshots: Vec<PirState>,

    // The enclosing loops, outermost first: label, region, how many locals existed when
    // it was entered, and for a range loop the hidden counter and `more` locals.
    internal loopLabels: Vec<String>,
    internal loopRegions: Vec<Int>,
    internal loopMarks: Vec<Int>,
    internal loopCounters: Vec<Int>,
    internal loopMores: Vec<Int>,
    internal loopStmts: Vec<Ptr>,
    internal pending: Vec<PirExitSnapshot>,

    // What an earlier attempt learned a loop has to carry, and whether this attempt
    // learned something new and must be followed by another.
    internal loopCount: Int,
    internal hints: HashMap<String, Int>,
    internal retry: Bool
}

public fn pirProgramNew(module: ASTNode, overflowChecks: Bool) -> PirProgram {
    let program = PirProgram {
        types: pirTypesNew(),
        funcs: [],
        sources: [],
        declNodes: [],
        declBySymbol: HashMap<String, Int>(),
        structByName: HashMap<String, Int>(),
        topNames: HashMap<String, Int>(),
        viewResults: HashMap<String, Int>(),
        overflowChecks: overflowChecks
    }
    pirIndexModule(program, module)

    // Generic templates are parked off this chain, so every function on it is concrete.
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.FUNCTION and nodeExists(stmt.child2)) { program.sources.push(p) }
        p = stmt.next
    }
    return program
}

internal fn pirSymbolOf(decl: ASTNode) -> String {
    if (decl.s2.equals("")) { return decl.s1.clone() }
    return decl.s2.clone()
}

private fn pirIndexModule(program: PirProgram, module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        match (stmt.kind) {
            NodeKind.FUNCTION => { pirIndexCallable(program, stmt) }
            NodeKind.EXTERN_FUNCTION => { pirIndexCallable(program, stmt) }
            NodeKind.STRUCT_DECL => {
                program.structByName.insert(stmt.s1.clone(), program.declNodes.length)
                program.declNodes.push(p)
            }
            // A global may share its name with a function; a name read as a value is
            // then the global, so it replaces the mark.
            NodeKind.VARIABLE_DECL => { program.topNames.set(stmt.s1.clone(), 1) }
            NodeKind.EXTERN_VARIABLE => { program.topNames.set(stmt.s1.clone(), 1) }
            _ => { }
        }
        p = stmt.next
    }
}

private fn pirIndexCallable(program: PirProgram, decl: ASTNode) {
    program.declBySymbol.insert(pirSymbolOf(decl), program.declNodes.length)
    program.declNodes.push(node_to_ptr(decl))
    program.topNames.insert(decl.s1.clone(), 2)
}

// The declared type of a struct's field, or -1.
internal fn pirFieldType(program: PirProgram, structName: String, field: String) -> Int {
    let index = program.structByName.getOr(structName.clone(), -1)
    if (index < 0) { return -1 }
    let decl = ptr_to_node(program.declNodes[index])
    let mut p = decl.child1
    while (nodeExists(p)) {
        let member = ptr_to_node(p)
        if (member.kind == NodeKind.STRUCT_FIELD and member.s1.equals(field) and nodeExists(member.child1)) {
            let found = pirTypeIntern(program.types, nodeGetType(ptr_to_node(member.child1)))
            if (pirTypeIsValid(program.types, found)) { return found }
            return -1
        }
        p = member.next
    }
    return -1
}

// Function `index`, built until what its loops carry no longer changes.
public fn pirBuildFunction(program: PirProgram, index: Int) -> PirFunc {
    let mut hints = HashMap<String, Int>()
    // The places earlier attempts met, so that an attempt numbers them alike and a loop's
    // head can name one the body only reaches later.
    let mut kinds: Vec<PirPlaceKind> = []
    let mut types: Vec<Int> = []
    let mut names: Vec<String> = []
    // Each attempt can only add hints, and there are finitely many to add.
    let mut attempts = 0
    loop {
        let func = ptr_to_node(program.sources[index])
        let f = pirFuncNew(pirSymbolOf(func), func.file, func.line, fileFromLibraryRoot(func.file))
        let s = pirScopeNew()
        pirRegionNew(f, PirRegionKind.FN, -1, -1)
        for i in 0..<kinds.length { pirPlaceIntern(f, kinds[i], types[i], names[i]) }

        pirBuildSignature(program, f, s, func)
        if (pirOk(s)) { pirBuildBody(program, f, s, hints, func) }

        attempts = attempts + 1
        if (s.retry and pirOk(s)) {
            if (attempts < 64) {
                for i in kinds.length..<f.placeKind.length {
                    kinds.push(f.placeKind[i])
                    types.push(f.placeType[i])
                    names.push(f.placeName[i].clone())
                }
                continue
            }
            pirRefuse(s, "loop state did not settle")
        }
        f.refusal = s.refusal.clone()
        return f
    }
}

private fn pirBuildBody(program: PirProgram, f: PirFunc, s: PirScope, hints: HashMap<String, Int>, func: ASTNode) {
    // The hints outlive the attempt, so the scope only borrows them through a copy.
    for key in hints.keys() { s.hints.insert(key.clone(), 1) }
    pirBlock(program, f, s, ptr_to_node(func.child2))
    // Control reaching the closing brace of a function with a result is a path sema has
    // already refused, so only a `Void` function returns here; the verifier says so if not.
    if (pirOk(s) and s.done == false) { pirExitReturn(program, f, s, -1, func) }
    for key in s.hints.keys() { hints.insert(key.clone(), 1) }
}

private fn pirScopeNew() -> PirScope {
    return PirScope {
        names: [],
        values: [],
        declared: [],
        live: [],
        inouts: [],
        reg: 0,
        done: false,
        refusal: "".clone(),
        state: pirStateEntry(),
        snapshots: [],
        loopLabels: [],
        loopRegions: [],
        loopMarks: [],
        loopCounters: [],
        loopMores: [],
        loopStmts: [],
        pending: [],
        loopCount: 0,
        hints: HashMap<String, Int>(),
        retry: false
    }
}

private fn pirBuildSignature(program: PirProgram, f: PirFunc, s: PirScope, func: ASTNode) {
    if (nodeIsAsync(func)) {
        pirRefuse(s, "async fn")
        return
    }

    let mut resultType = -1
    if (func.s1.equals("main")) {
        resultType = pirTypeIntern(program.types, typeInt())
    } else if (nodeExists(func.child3)) {
        let annotation = ptr_to_node(func.child3)
        resultType = pirTypeIntern(program.types, nodeGetType(annotation))
        if (pirTypeIsValid(program.types, resultType) == false) {
            pirRefuse(s, "untyped return")
            return
        }
        if (program.types.kind[resultType] == PirTypeKind.VOID) { resultType = -1 }
    }
    if (resultType >= 0) {
        f.hasResult = true
        f.returnTypes.push(resultType)
        if (program.types.moveOnly[resultType]) { f.returnMode = PirMode.OWN }
    }

    let mut p = func.child1
    while (nodeExists(p)) {
        let param = ptr_to_node(p)
        let paramType = pirTypeIntern(program.types, nodeGetType(param))
        if (pirTypeIsValid(program.types, paramType) == false) {
            pirRefuse(s, "untyped parameter")
            return
        }
        let isInout = param.s2.equals("inout")
        let mut mode = PirMode.COPY
        if (program.types.moveOnly[paramType]) {
            mode = PirMode.VIEW
            // A `sink` parameter is the callee's to end; an `inout` one is taken and
            // given back (A8).
            if (isInout or param.s2.equals("sink")) { mode = PirMode.OWN }
        }
        let value = pirPortNew(f, 0, paramType, mode, param.s1)
        if (isInout) {
            s.inouts.push(s.names.length)
            f.returnTypes.push(paramType)
        }
        pirDeclare(s, param.s1, value, paramType, true)
        p = param.next
    }
}

// Keeps the state in force, answering where.
internal fn pirSnapshot(s: PirScope) -> Int {
    s.snapshots.push(pirStateCopy(s.state))
    return s.snapshots.length - 1
}

internal fn pirRefuse(s: PirScope, reason: String) {
    if (s.refusal.equals("")) { s.refusal = reason.clone() }
}

internal fn pirOk(s: PirScope) -> Bool { return s.refusal.equals("") }

internal fn pirDeclare(s: PirScope, name: String, value: Int, declared: Int, live: Bool) {
    s.names.push(name.clone())
    s.values.push(value)
    s.declared.push(declared)
    s.live.push(live)
}

internal fn pirScopeTruncate(s: PirScope, mark: Int) {
    s.names.truncate(mark)
    s.values.truncate(mark)
    s.declared.truncate(mark)
    s.live.truncate(mark)
}

// The innermost local called `name`, or -1.
internal fn pirLookup(s: PirScope, name: String) -> Int {
    let mut i = s.names.length - 1
    while (i >= 0) {
        if (s.names[i].equals(name)) { return i }
        i = i - 1
    }
    return -1
}

// The mode of a new value of `valueType`: owned where the type is.
internal fn pirFreshMode(program: PirProgram, valueType: Int) -> PirMode {
    if (program.types.moveOnly[valueType]) { return PirMode.OWN }
    return PirMode.COPY
}

// The mode of a read out of memory: a view where the type is owned.
internal fn pirReadMode(program: PirProgram, valueType: Int) -> PirMode {
    if (program.types.moveOnly[valueType]) { return PirMode.VIEW }
    return PirMode.COPY
}

// An operand that ends an owned value consumes it; any other use only borrows.
internal fn pirConsumingUse(f: PirFunc, value: Int) -> PirUse {
    if (f.valMode[value] == PirMode.OWN) { return PirUse.CONSUME }
    return PirUse.BORROW
}

internal fn pirNodeType(program: PirProgram, s: PirScope, node: ASTNode) -> Int {
    let id = pirTypeIntern(program.types, nodeGetType(node))
    if (pirTypeIsValid(program.types, id) == false) { pirRefuse(s, "untyped expression") }
    return id
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

// The statements of a block, in a scope of their own. Nothing after an exit is built.
internal fn pirBlock(program: PirProgram, f: PirFunc, s: PirScope, block: ASTNode) {
    let mark = s.names.length
    let mut p = block.child1
    while (nodeExists(p) and s.done == false and pirOk(s)) {
        let stmt = ptr_to_node(p)
        pirStatement(program, f, s, stmt)
        p = stmt.next
    }
    pirScopeTruncate(s, mark)
}

internal fn pirStatement(program: PirProgram, f: PirFunc, s: PirScope, stmt: ASTNode) {
    match (stmt.kind) {
        NodeKind.VARIABLE_DECL => { pirLet(program, f, s, stmt) }
        NodeKind.ASSIGNMENT_STATEMENT => { pirAssign(program, f, s, stmt) }
        NodeKind.EXPRESSION_STATEMENT => {
            let expr = ptr_to_node(stmt.child1)
            pirExpr(program, f, s, expr)
            if (pirOk(s) and pirCallDiverges(program, expr)) { pirExitPlain(f, s, PirPort.FAIL, expr) }
        }
        NodeKind.RETURN_STATEMENT => {
            let mut value = -1
            if (nodeExists(stmt.child1)) { value = pirExpr(program, f, s, ptr_to_node(stmt.child1)) }
            if (pirOk(s)) { pirExitReturn(program, f, s, value, stmt) }
        }
        NodeKind.IF_STATEMENT => { pirIf(program, f, s, stmt) }
        NodeKind.MATCH_STATEMENT => { pirMatch(program, f, s, stmt) }
        NodeKind.BLOCK => { pirBlock(program, f, s, stmt) }
        NodeKind.WHILE_STATEMENT => { pirWhile(program, f, s, stmt) }
        NodeKind.FOR_STATEMENT => { pirFor(program, f, s, stmt) }
        NodeKind.LOOP_STATEMENT => { pirLoopForever(program, f, s, stmt) }
        NodeKind.BREAK_STATEMENT => { pirJump(program, f, s, stmt, true) }
        NodeKind.CONTINUE_STATEMENT => { pirJump(program, f, s, stmt, false) }
        NodeKind.REGION_STATEMENT => {
            if (stmt.i3 == 1) {
                pirRefuse(s, "task scope")
            } else {
                pirRefuse(s, "region")
            }
        }
        _ => { pirRefuse(s, "unsupported statement") }
    }
}

private fn pirLet(program: PirProgram, f: PirFunc, s: PirScope, stmt: ASTNode) {
    let declared = pirTypeIntern(program.types, nodeGetType(stmt))
    if (pirTypeIsValid(program.types, declared) == false) {
        pirRefuse(s, "untyped declaration")
        return
    }
    if (nodeIsNull(stmt.child2)) {
        // An array declared without a value is zero-filled storage; anything else has
        // no value until it is assigned.
        if (program.types.kind[declared] == PirTypeKind.ARRAY) {
            let zero = pirNodeNew(f, PirOp.ARRAY_ZERO, "", stmt)
            pirAppend(f, s.reg, zero)
            let value = pirResult(f, zero, declared, pirFreshMode(program, declared), "")
            pirDeclare(s, stmt.s1, value, declared, true)
            return
        }
        pirDeclare(s, stmt.s1, -1, declared, false)
        return
    }
    // Built before the name is declared, so `let x = x + 1` reads the outer `x`.
    let source = ptr_to_node(stmt.child2)
    let mut value = pirExpr(program, f, s, source)
    if (pirOk(s) == false) { return }
    if (value < 0) {
        pirRefuse(s, "operand with no value")
        return
    }
    value = pirBind(program, f, s, value, declared, source)
    if (f.valBinding[value].equals("")) { f.valBinding[value] = stmt.s1.clone() }
    pirDeclare(s, stmt.s1, value, declared, true)
}

// `value` as it enters a binding of type `declared`: an array whose elements own
// nothing is copied, and a reference becomes its optional where one is wanted.
private fn pirBind(program: PirProgram, f: PirFunc, s: PirScope, value: Int, declared: Int, source: ASTNode) -> Int {
    if (pirArrayCopies(program.types, declared) and source.kind != NodeKind.ARRAY_LITERAL_EXPR) {
        let copy = pirNodeNew(f, PirOp.COPY, "", source)
        pirOperand(f, copy, value, PirUse.BORROW)
        pirAppend(f, s.reg, copy)
        pirStateRead(f, s.state, copy, pirElementsPlace(program, f, f.valType[value]))
        return pirResult(f, copy, declared, pirFreshMode(program, declared), "")
    }
    return pirCoerce(program, f, s, value, declared, source)
}

private fn pirAssign(program: PirProgram, f: PirFunc, s: PirScope, stmt: ASTNode) {
    let target = ptr_to_node(stmt.child1)
    let source = ptr_to_node(stmt.child2)
    if (target.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        pirFieldStore(program, f, s, target, source)
        return
    }
    if (target.kind == NodeKind.INDEX_EXPR) {
        pirIndexStore(program, f, s, target, source)
        return
    }
    if (target.kind != NodeKind.IDENTIFIER_EXPR) {
        pirRefuse(s, "store")
        return
    }
    let local = pirLookup(s, target.s1)
    if (local < 0) {
        pirGlobalStore(program, f, s, target, source)
        return
    }
    let mut value = pirExpr(program, f, s, source)
    if (pirOk(s) == false) { return }
    if (value < 0) {
        pirRefuse(s, "operand with no value")
        return
    }
    value = pirBind(program, f, s, value, s.declared[local], source)
    s.values[local] = value
    s.live[local] = true
}

// ---------------------------------------------------------------------------
// Exits that leave the function, or only the region
// ---------------------------------------------------------------------------

internal fn pirExitNode(f: PirFunc, port: PirPort, target: Int, at: ASTNode) -> Int {
    let exit = pirNodeNew(f, PirOp.EXIT, "", at)
    f.nodePort[exit] = port as Int
    f.nodeTarget[exit] = target
    return exit
}

// An exit that carries nothing: `exit fail` and `exit unreachable`.
internal fn pirExitPlain(f: PirFunc, s: PirScope, port: PirPort, at: ASTNode) {
    let exit = pirExitNode(f, port, 0, at)
    pirAppend(f, s.reg, exit)
    s.done = true
}

internal fn pirExitReturn(program: PirProgram, f: PirFunc, s: PirScope, value: Int, at: ASTNode) {
    let mut result = -1
    if (f.hasResult and value >= 0) { result = pirCoerce(program, f, s, value, f.returnTypes[0], at) }
    for local in s.inouts {
        if (s.live[local] == false) {
            pirRefuse(s, "inout parameter with no value")
            return
        }
    }
    let exit = pirExitNode(f, PirPort.RETURN, 0, at)
    if (result >= 0) { pirOperand(f, exit, result, pirConsumingUse(f, result)) }
    for local in s.inouts {
        let current = s.values[local]
        // The same object cannot leave twice; after the result it is a second name.
        let mut use = pirConsumingUse(f, current)
        if (current == result) { use = PirUse.BORROW }
        pirOperand(f, exit, current, use)
    }
    pirAppend(f, s.reg, exit)
    s.done = true
}
