// PIR's node set (docs/PIR_PLAN.md §3-§7, §16.1): one function as flat columns indexed
// by Int ids -- nodes, values, regions -- and the only code that appends to them.
//
// Ids are handed out in builder order, which is source order. Effects are on a region's
// spine, a linked list so that a later pass can insert a drop between two entries; pure
// nodes have no region and are hash-consed per function.

import std.collections.vec
import std.collections.map
import std.string
import ast.nodes

public enum PirOp {
    CONST,
    ENUM_CONST,
    UNARY,
    BINARY,
    CAST,
    // A value passed into a slot of its optional type: `T` as `T?`.
    WRAP,
    // `lo..hi` arithmetic of a range loop: `down`, `enter`, `more`, `step`.
    RANGE,
    // Whether an optional holds a value, and the value it holds.
    IS_SOME,
    UNWRAP,
    // A checked unwrap: it fails the program when there is nothing to unwrap.
    EXPECT,
    // Reads of memory: a field, an element, a container's length, a global.
    FIELD,
    ELEM,
    LENGTH,
    GLOBAL,
    // Writes. Each hands back what it displaced, where that is owned.
    FIELD_SET,
    ELEM_SET,
    PUSH,
    GLOBAL_SET,
    // New objects.
    STRUCT,
    ARRAY,
    ARRAY_ZERO,
    COPY,
    SLICE,
    CALL,
    BRANCH,
    LOOP,
    EXIT
}

public enum PirMode { COPY, OWN, VIEW }

// What a node does with an operand. A consume ends an owned value (A1); an inout
// takes it and, for a local, gives the written value back as a result (A8).
public enum PirUse { BORROW, CONSUME, INOUT }

public enum PirRegionKind { FN, BRANCH, ARM, LOOP }

// The port an exit names: the function's return, a branch's merge, a loop's next
// iteration or its end, or no port at all.
public enum PirPort { RETURN, MERGE, NEXT, BREAK, FAIL, UNREACHABLE }

// A part of memory with its own chain of versions (§6.1). Without a heap model the
// object is the static type: every `Bag.items` is one place, which is always sound.
public enum PirPlaceKind { WORLD, FIELD, ELEMENTS, HEADER, GLOBAL }

// Bits of a node's flags.
public const PIR_MAY_TRAP = 1
// A call whose result may view what it was passed: every borrowed argument stays pinned.
public const PIR_UNKNOWN_BASE = 2

public struct PirFunc {
    public name: String,
    public file: Int,
    public line: Int,
    // From the standard library, rather than the program being built.
    public library: Bool,
    // Why the function is not covered; "" when it is, and then the graph is complete.
    public refusal: String,
    // The Prismio functions this one calls, by symbol: whose summaries it was built on.
    public callees: Vec<String>,

    // Nodes. `region` is -1 for a pure node. Operands are contiguous; results are too,
    // but a branch's are appended once both arms are built.
    public op: Vec<PirOp>,
    public nodeFlags: Vec<Int>,
    public nodeRegion: Vec<Int>,
    public nodeNext: Vec<Int>,
    public nodeName: Vec<String>,
    public opStart: Vec<Int>,
    public opCount: Vec<Int>,
    public resStart: Vec<Int>,
    public resCount: Vec<Int>,
    // An exit's target region, or a branch or loop node's own region; -1 otherwise.
    public nodeTarget: Vec<Int>,
    // The exit port (PirPort as Int) of an EXIT; -1 otherwise.
    public nodePort: Vec<Int>,
    public nodeLine: Vec<Int>,
    public nodeCol: Vec<Int>,
    // The AST node a PIR node came from: the key a plan side table will use. Opaque here.
    public nodeAst: Vec<Ptr>,
    // The allocation site (§8.1). Filled by the heap model, not in P0.
    public nodeSite: Vec<Int>,

    public operands: Vec<Int>,
    public operandUse: Vec<PirUse>,
    public results: Vec<Int>,

    // State accesses, contiguous per node: the place, the version read or replaced
    // (-1 for a version a branch or loop defines), and the version defined (-1 for a
    // read, and for a version a clobber ends).
    public accStart: Vec<Int>,
    public accCount: Vec<Int>,
    public accPlace: Vec<Int>,
    public accIn: Vec<Int>,
    public accOut: Vec<Int>,

    // Values. `def` is -1 for a region's input port; `region` is -1 for a pure value.
    public valDef: Vec<Int>,
    public valRegion: Vec<Int>,
    public valType: Vec<Int>,
    public valMode: Vec<PirMode>,
    public valName: Vec<String>,
    // The `let` the value first initialised, "" if none.
    public valBinding: Vec<String>,
    // `own ?w` (§7.5): owned on some paths and a view on others.
    public valWitness: Vec<Bool>,
    // For a call's extra result, the operand (an `inout` argument) it hands back; -1 otherwise.
    public valFrom: Vec<Int>,
    // The storage class (§7.1). Filled by AIF over PIR, not in P0.
    public valStorage: Vec<Int>,

    // Regions. Region 0 is the function. `node` is the node that owns a BRANCH, ARM
    // or LOOP region. An arm's label says which case it is.
    public regKind: Vec<PirRegionKind>,
    public regParent: Vec<Int>,
    public regNode: Vec<Int>,
    public regHead: Vec<Int>,
    public regTail: Vec<Int>,
    public regPortStart: Vec<Int>,
    public regPortCount: Vec<Int>,
    public regLabel: Vec<String>,
    // The text of the value an arm's case compares the selector against, where the label
    // is not itself that value (a payload variant's tag); "" otherwise.
    public regValue: Vec<String>,
    public ports: Vec<Int>,

    // The return port: the result, if any, then each `inout` parameter's final value.
    public returnTypes: Vec<Int>,
    public returnMode: PirMode,
    public hasResult: Bool,

    // Places and state versions (§6). Place 0 is `world`, version 0 its entry state.
    public placeKind: Vec<PirPlaceKind>,
    // The object type of a FIELD, the element type of ELEMENTS and HEADER, else -1.
    public placeType: Vec<Int>,
    public placeName: Vec<String>,
    public verPlace: Vec<Int>,
    // The node that defines a version (-1 on entry) and the one it replaced (-1 for a
    // version defined by a branch or a loop, or on entry).
    public verDef: Vec<Int>,
    public verPrev: Vec<Int>,

    // The interning tables of the pure graph and of places.
    cons: HashMap<String, Int>,
    placeIds: HashMap<String, Int>
}

public fn pirFuncNew(name: String, file: Int, line: Int, library: Bool) -> PirFunc {
    let f = PirFunc {
        name: name.clone(),
        file: file,
        line: line,
        library: library,
        refusal: "".clone(),
        callees: [],
        op: [], nodeFlags: [], nodeRegion: [], nodeNext: [], nodeName: [],
        opStart: [], opCount: [], resStart: [], resCount: [],
        nodeTarget: [], nodePort: [], nodeLine: [], nodeCol: [], nodeAst: [], nodeSite: [],
        operands: [], operandUse: [], results: [],
        accStart: [], accCount: [], accPlace: [], accIn: [], accOut: [],
        valDef: [], valRegion: [], valType: [], valMode: [], valName: [], valBinding: [], valWitness: [], valFrom: [], valStorage: [],
        regKind: [], regParent: [], regNode: [], regHead: [], regTail: [],
        regPortStart: [], regPortCount: [], regLabel: [], regValue: [], ports: [],
        returnTypes: [], returnMode: PirMode.COPY, hasResult: false,
        placeKind: [], placeType: [], placeName: [], verPlace: [], verDef: [], verPrev: [],
        cons: HashMap<String, Int>(),
        placeIds: HashMap<String, Int>()
    }
    pirPlaceIntern(f, PirPlaceKind.WORLD, -1, "world")
    pirVersionNew(f, 0, -1, -1)
    return f
}

public fn pirPlaceIntern(f: PirFunc, kind: PirPlaceKind, placeType: Int, name: String) -> Int {
    let key = (kind as Int).toString().concat(":", placeType.toString(), ":", name)
    let found = f.placeIds.getOr(key, -1)
    if (found >= 0) { return found }
    let id = f.placeKind.length
    f.placeKind.push(kind)
    f.placeType.push(placeType)
    f.placeName.push(name.clone())
    f.placeIds.insert(key, id)
    return id
}

public fn pirVersionNew(f: PirFunc, place: Int, def: Int, prev: Int) -> Int {
    let id = f.verPlace.length
    f.verPlace.push(place)
    f.verDef.push(def)
    f.verPrev.push(prev)
    return id
}

// One access of `node`. A node's accesses are added together, with no other node's between.
public fn pirAccess(f: PirFunc, node: Int, place: Int, before: Int, after: Int) {
    if (f.accCount[node] == 0) { f.accStart[node] = f.accPlace.length }
    f.accPlace.push(place)
    f.accIn.push(before)
    f.accOut.push(after)
    f.accCount[node] = f.accCount[node] + 1
}

public fn pirRegionNew(f: PirFunc, kind: PirRegionKind, parent: Int, node: Int) -> Int {
    let id = f.regKind.length
    f.regKind.push(kind)
    f.regParent.push(parent)
    f.regNode.push(node)
    f.regHead.push(-1)
    f.regTail.push(-1)
    f.regPortStart.push(f.ports.length)
    f.regPortCount.push(0)
    f.regLabel.push("")
    f.regValue.push("")
    return id
}

// A node with no operands and no results yet, off the spine. Operands are added with
// pirOperand before any other node is created.
public fn pirNodeNew(f: PirFunc, op: PirOp, name: String, ast: ASTNode) -> Int {
    let id = f.op.length
    f.op.push(op)
    f.nodeFlags.push(0)
    f.nodeRegion.push(-1)
    f.nodeNext.push(-1)
    f.nodeName.push(name.clone())
    f.opStart.push(f.operands.length)
    f.opCount.push(0)
    f.resStart.push(f.results.length)
    f.resCount.push(0)
    f.nodeTarget.push(-1)
    f.nodePort.push(-1)
    f.nodeLine.push(ast.line)
    f.nodeCol.push(ast.col)
    f.nodeAst.push(node_to_ptr(ast))
    f.nodeSite.push(-1)
    f.accStart.push(0)
    f.accCount.push(0)
    return id
}

// A node's operands are added together too, though an exit's may wait until the
// region it leaves is complete.
public fn pirOperand(f: PirFunc, node: Int, value: Int, use: PirUse) {
    if (f.opCount[node] == 0) { f.opStart[node] = f.operands.length }
    f.operands.push(value)
    f.operandUse.push(use)
    f.opCount[node] = f.opCount[node] + 1
}

public fn pirAppend(f: PirFunc, reg: Int, node: Int) {
    f.nodeRegion[node] = reg
    let tail = f.regTail[reg]
    if (tail < 0) {
        f.regHead[reg] = node
    } else {
        f.nodeNext[tail] = node
    }
    f.regTail[reg] = node
}

private fn pirValueNew(f: PirFunc, def: Int, reg: Int, valueType: Int, mode: PirMode, name: String) -> Int {
    let id = f.valDef.length
    f.valDef.push(def)
    f.valRegion.push(reg)
    f.valType.push(valueType)
    f.valMode.push(mode)
    f.valName.push(name.clone())
    f.valBinding.push("")
    f.valWitness.push(false)
    f.valFrom.push(-1)
    f.valStorage.push(-1)
    return id
}

// A result of `node`, in the region the node is on (-1 while it is floating).
public fn pirResult(f: PirFunc, node: Int, valueType: Int, mode: PirMode, name: String) -> Int {
    if (f.resCount[node] == 0) { f.resStart[node] = f.results.length }
    let id = pirValueNew(f, node, f.nodeRegion[node], valueType, mode, name)
    f.results.push(id)
    f.resCount[node] = f.resCount[node] + 1
    return id
}

// An input port of `region`. A region's ports are added before the next region's.
public fn pirPortNew(f: PirFunc, reg: Int, valueType: Int, mode: PirMode, name: String) -> Int {
    if (f.regPortCount[reg] == 0) { f.regPortStart[reg] = f.ports.length }
    let id = pirValueNew(f, -1, reg, valueType, mode, name)
    f.ports.push(id)
    f.regPortCount[reg] = f.regPortCount[reg] + 1
    return id
}

// The value of a pure node: one node per (op, name, operands, type). Every operand must
// be a copy value, which is what makes sharing one node between uses sound.
//
// `anchor` is -1, or the region a node that may trap sits in. Such a node is shared only
// within that region, and scheduling never lifts it above it (§5).
public fn pirPure(f: PirFunc, op: PirOp, name: String, operands: Vec<Int>, valueType: Int, anchor: Int, ast: ASTNode) -> Int {
    let mut key = (op as Int).toString().concat(":", valueType.toString(), ":", operands.length.toString())
    for operand in operands { key = key.concat(",", operand.toString()) }
    key = key.concat(":", anchor.toString(), ":", name)
    let found = f.cons.getOr(key, -1)
    if (found >= 0) { return found }

    let node = pirNodeNew(f, op, name, ast)
    for operand in operands { pirOperand(f, node, operand, PirUse.BORROW) }
    if (anchor >= 0) {
        f.nodeFlags[node] = PIR_MAY_TRAP
        f.nodeTarget[node] = anchor
    }
    let value = pirResult(f, node, valueType, PirMode.COPY, "")
    f.cons.insert(key, value)
    return value
}

public fn pirOperandAt(f: PirFunc, node: Int, index: Int) -> Int {
    return f.operands[f.opStart[node] + index]
}

public fn pirResultAt(f: PirFunc, node: Int, index: Int) -> Int {
    return f.results[f.resStart[node] + index]
}

public fn pirPortAt(f: PirFunc, reg: Int, index: Int) -> Int {
    return f.ports[f.regPortStart[reg] + index]
}

public fn pirModeText(mode: PirMode) -> String {
    if (mode == PirMode.OWN) { return "own" }
    if (mode == PirMode.VIEW) { return "view" }
    return "copy"
}
