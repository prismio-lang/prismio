extern fn read_file(path: String) -> String
extern fn get_directory(path: String) -> String
extern fn join_path(directory: String, filename: String) -> String
extern fn file_exists(path: String) -> Int
extern fn executable_directory() -> String produce(free)
// Newline-separated module names in a directory, sorted. Mallocs the buffer
// and hands it over; backs `import pkg.*`.
extern fn list_modules(directory: String) -> String produce(free)
extern fn cli_arg_count() -> Int
// argv, which the C runtime owns and outlives every use of it. Not an
// allocation, and freeing one would be a free of memory this program never got.
extern fn cli_arg(index: Int) -> String alias
// Both malloc and hand the buffer over: compiler_default_exe_path sprintfs into
// a fresh block, compiler_temp_ir_path goes through compiler_temp_path which
// does the same. The caller owns them.
extern fn compiler_default_exe_path(sourcePath: String) -> String produce(free)
extern fn compiler_temp_ir_path(sourcePath: String) -> String produce(free)
extern fn compiler_build_executable(irFile: String, exeFile: String) -> Int
// SPEC 7.3. Tells the build to compile the runtime with its own allocator
// pointed at the verify shims, so the strings and lists it allocates are in the
// same accounting as everything ir_alloc_object handed out.
extern fn compiler_set_verify_mode(on: Int)
// `-g`. Two things the driver does differently once the module carries debug
// info: the object step drops to -O0, and on Darwin a .dSYM is written before
// the object -- which is where Mach-O keeps the DWARF -- is deleted.
extern fn compiler_set_debug_info(on: Int)
// `--sysroot`. Where *this machine* keeps the SDK for the target -- not a
// property of the triple, which is why it is not in the target record: two hosts
// building the same target legitimately pass different paths, and an SDK the
// compiler picked for itself is the kind of helpful guess that ends in a link
// error someone spends an afternoon on.
extern fn compiler_set_sysroot(path: String borrow)
extern fn compiler_bootstrap_executable(irFile: String, exeFile: String) -> Int
extern fn compiler_run_executable(exeFile: String) -> Int
extern fn ir_jit_run_main(programName: String) -> Int
// LAYOUT 3.2. Runs a workload driver with no argv and a wall-clock bound, so W2's
// "times out" is a case that can actually occur rather than a clause nothing
// implements.
extern fn compiler_run_workload(exeFile: String, timeoutSeconds: Int) -> Int
// Same ".prismio-<stem>-<suffix>" convention as compiler_temp_ir_path, and the
// same malloc'd result.
extern fn compiler_temp_path_for(sourcePath: String, suffix: String) -> String produce(free)
// The same, with the pid in the name. For a temporary that must not be shared
// between two compiles of one source -- RESULTS-layout 7, where sharing three of
// them made the IR differential report a false difference under any concurrent
// load. `compiler_publish_file` is how the one artifact that *is* supposed to
// have a predictable name gets there afterwards.
extern fn compiler_temp_private_path(sourcePath: String, suffix: String) -> String produce(free)
extern fn compiler_publish_file(fromPath: String, toPath: String) -> Int
// Forces the driver's link to compile the runtime rather than take an installed
// runtime.lib, which may predate rt_profile_*. See the note at g_workload_mode.
extern fn compiler_set_workload_mode(on: Int)
// Every path through both mallocs, including the failure paths, which allocate a
// one-byte empty string rather than returning a literal. That is the same
// invariant Level 4 had to give str_substring and str_trim -- anything declared
// to return String returns something a release can take -- and it is what makes
// `produce` true here rather than nearly true.
extern fn compiler_runtime_source_hash() -> String produce(free)
extern fn compiler_installed_runtime_hash() -> String produce(free)
extern fn delete_file(path: String) -> Int

// The writer half of the filesystem surface, for `init`. Both return 0 for
// success, which is the C convention here and the opposite of `file_exists`;
// std/fs.psm normalises that for applications, and this file cannot import it
// because the two would declare the same symbols twice.
extern fn write_file(path: String borrow, content: String borrow) -> Int
extern fn make_directory(path: String borrow) -> Int
extern fn current_directory() -> String produce(free)
// A `static char buf[32]` the next call overwrites.
extern fn ir_llvm_version() -> String alias

// Bumped per release. The LLVM major version is part of the identity: a given
// Prismio targets one LLVM major, and the C API is not stable across them.
let PRISMIO_VERSION = "0.1.0"

// The last statement appended to the module being merged. Reset with the module
// in resolveImports(); see appendStatement() for why it is a cache rather than
// the list's only tail.
// Zero-initialized rather than assigned: a global cannot be initialized by a
// call, and a zero-filled pointer is NULL, which is the empty cache this wants.
let mut mergeTailPtr: Ptr

// Two same-named top-level declarations of the same kind are duplicates, with one
// exception: FUNCTION. Overloading means several `fn` nodes legitimately share a
// name (tests/test_29_overloads.psm), and a genuinely duplicated overload has to
// survive the merge so sema can reject it (tests/neg_06_duplicate_overload.psm).
//
// EXTERN_FUNCTION is deliberately *not* exempt. Modules each declare the externs
// they use, so `str_equals` is declared by both utils.psm and keywords.psm, and
// `exit` by both parser.psm and sema.psm; merging both copies makes sema report a
// spurious "duplicate function overload". Keeping the first is correct.
//
// This does not disturb the forward-declaration idiom in ir.psm/parser.psm/
// sema.psm, where an `extern fn` declares a function the same file also defines:
// that pairs an EXTERN_FUNCTION with a FUNCTION, so the kind check above already
// treats them as distinct (and generateModule skips the `declare` when a real
// `define` exists).

private fn sameTopLevelName(a: ASTNode, b: ASTNode) -> Bool {
    if (a.kind != b.kind) { return false }
    if (strEquals(a.s1, b.s1) == false) { return false }
    if (a.kind == NodeKind.FUNCTION) {
        return false
    }
    return true
}

// Asks the declaration index, which appendStatement() keeps current as it
// merges, rather than rescanning everything merged so far. The scan was
// quadratic in the number of declarations and ran before sema -- this compiler's
// own source merges about 1 500 of them.
private fn hasNamedTopLevel(module: ASTNode, stmt: ASTNode) -> Bool {
    if (isNamedTopLevel(stmt) == false) {
        return false
    }

    let count = ir_decl_count(stmt.s1)
    let mut i = 0
    while (i < count) {
        let scan = ptr_to_node(ir_decl_at(stmt.s1, i))
        if (sameTopLevelName(scan, stmt)) {
            return true
        }
        i = i + 1
    }

    return false
}

private fn parseSource(content: String, file: Int) -> ASTNode {
    let lex = createLexer(content, file)
    let headToken = lexAllTokens(lex)
    let p = parserCreate(headToken)
    return parseModule(p)
}

private fn appendStatement(module: ASTNode, stmt: ASTNode) {
    if (hasNamedTopLevel(module, stmt)) {
        return
    }

    if (nodeIsNull(module.child1)) {
        module.child1 = node_to_ptr(stmt)
        mergeTailPtr = node_to_ptr(stmt)
        indexTopLevel(stmt)
        return
    }

    // Walking to the end per statement made merging quadratic. The cached tail
    // is a shortcut, not a second source of truth: when it is empty -- a module
    // that was appended to by something other than this function -- the walk it
    // replaced still runs, once, and the cache picks up from there.
    if (nodeIsNull(mergeTailPtr)) {
        mergeTailPtr = module.child1
        let mut searching = true
        while (searching) {
            let scan = ptr_to_node(mergeTailPtr)
            if (nodeIsNull(scan.next)) {
                searching = false
            } else {
                mergeTailPtr = scan.next
            }
        }
    }

    let tail = ptr_to_node(mergeTailPtr)
    tail.next = node_to_ptr(stmt)
    mergeTailPtr = node_to_ptr(stmt)
    indexTopLevel(stmt)
}

// A dotted module name is a directory path: `ir.expr` becomes `ir/expr`.
//
// '/' is emitted unconditionally because the frontend has no way to ask what the
// host's separator is; join_path normalises the joined result.
private fn moduleRelativePath(moduleName: String) -> String {
    let mut relative = ""
    let mut i = 0
    let length = __builtin_string_len(moduleName)
    while (i < length) {
        let c = strCharAt(moduleName, i)
        if (c == '.') {
            relative = strConcat(relative, "/")
        } else {
            relative = strConcat(relative, strFromChar(c))
        }
        i = i + 1
    }
    return relative
}

// Everything an import names is resolved against the directory of the file being
// compiled, not against the importing module -- so a module path means the same
// thing written anywhere in the tree. The `.` case exists because there is
// nothing to join to.
private fn resolveUnder(baseDir: String, relative: String) -> String {
    if (strEquals(baseDir, ".")) {
        return relative
    }
    return join_path(baseDir, relative)
}

// Compiler subsystems normally live below src/, which is also the source root.
// UMS is deliberately different: it is a first-class toolchain subsystem beside
// src/, not compiler implementation. Reserving the `ums` import root lets the
// self-hosted CLI consume that subsystem without a mirror, symlink, or C bridge.
// The rule is narrow on purpose so ordinary user module resolution remains
// relative to the entry source exactly as before.


private fn importBaseDir(baseDir: String, moduleName: String) -> String {
    if (strEquals(moduleName, "ums") or strStartsWith(moduleName, "ums.")) {
        return get_directory(baseDir)
    }
    return baseDir
}

private fn joinImportPath(baseDir: String, moduleName: String) -> String {
    return resolveUnder(importBaseDir(baseDir, moduleName),
                        strConcat(moduleRelativePath(moduleName), ".psm"))
}

private fn joinImportDir(baseDir: String, packageName: String) -> String {
    return resolveUnder(importBaseDir(baseDir, packageName), moduleRelativePath(packageName))
}

// Memo key for an already-resolved module. Paths are wrapped in "|" so that a
// substring search can never match a partial path (e.g. "src\ir.psm" must not be
// found inside "src\dir.psm").
private fn importMemoKey(importPath: String) -> String {
    return strConcat(strConcat("|", importPath), "|")
}

// Resolves one named module into `merged`, unless it has already been resolved.
//
// Resolving each path once is what keeps a diamond-shaped import graph correct:
// src/main.psm reaches common/text.psm through five distinct paths, and without
// this every one of that module's functions and extern declarations would be
// merged five times, emitting duplicate LLVM `define`/`declare` lines that llc
// rejects outright ("invalid redefinition of function"). Marking a path before
// recursing into it also makes an import cycle terminate instead of recursing
// forever.
//
// `site` is the import that asked, and is only used to place the diagnostic.
private fn mergeNamedModule(merged: ASTNode, site: ASTNode, moduleName: String,
                      baseDir: String, visited: String) -> String {
    let importPath = resolveImportPath(baseDir, moduleName)

    // v0.1 3.5, selective imports. `import std.string.strTrim` names a *name*
    // and not a module, and nothing but resolution can tell the two apart --
    // `std.string` could equally hold a `strTrim.psm`, and then the same text
    // means the module. So the full path is tried first and this is the
    // fallback, which is where Kotlin settles the same ambiguity and for the
    // same reason: a grammar cannot see the filesystem.
    //
    // The record goes in before the memo check below, not after. A module is
    // merged once however many files import it, so a second file selecting from
    // an already-merged module would otherwise take everything.
    if (file_exists(importPath) == 0) {
        let cut = strLastIndexOf(moduleName, ".")
        if (cut > 0) {
            let parent = strSubstring(moduleName, 0, cut)
            if (file_exists(resolveImportPath(baseDir, parent)) == 1) {
                ir_select_record(site.file, parent,
                    strSubstring(moduleName, cut + 1,
                                 __builtin_string_len(moduleName) - cut - 1))
                return mergeNamedModule(merged, site, parent, baseDir, visited)
            }
        }
    }

    let key = importMemoKey(importPath)
    if (strContains(visited, key)) {
        return visited
    }

    let seen = strConcat(visited, key)

    let content = read_file(importPath)
    if (strEquals(content, "") and file_exists(importPath) == 0) {
        diag_error_at_code("P1001", site.file, site.line, site.col, site.len,
            strConcat(strConcat("cannot read imported module ", diagQuote(moduleName)),
                       strConcat(": no such file ", importPath)))
        diag_finish()
        exit(1)
    }

    // Registered before parsing so every token from this file carries an id that
    // resolves back to its text, long after the merge has erased which module a
    // declaration came from.
    let file = diag_add_file(importPath, content)
    // ...and the name it was reached by, which the id alone cannot recover: the
    // installed layout stores `std/string.psm` at `stdlib/string.psm`, so a
    // qualifier derived from the path would differ between a checkout and an
    // install. Every module arrives here with its logical path already built --
    // mergePackageImport composes `pkg.leaf` before calling -- so this one line
    // covers named and package imports both.
    diag_set_file_module(file, moduleName)
    return mergeModuleImports(merged, parseSource(content, file), baseDir, seen)
}

// `import pkg.*` -- every module directly inside `pkg`, in the order
// list_modules sorted them.
//
// Non-recursive, like Kotlin's: a nested package is a separate import. A
// directory with no modules in it is an error rather than a no-op, because the
// only ways to reach it are a typo in the package name and a package that has
// been emptied, and both are worth hearing about.
private fn mergePackageImport(merged: ASTNode, site: ASTNode, baseDir: String,
                        visited: String) -> String {
    let dirPath = joinImportDir(baseDir, site.s1)
    let listing = list_modules(dirPath)

    if (strEquals(listing, "")) {
        diag_error_at_code("P1002", site.file, site.line, site.col, site.len,
            strConcat(strConcat("package ", diagQuote(site.s1)),
                       strConcat(" contains no modules: ", dirPath)))
        diag_finish()
        exit(1)
    }

    let mut seen = visited
    let mut name = ""
    let mut i = 0
    let length = __builtin_string_len(listing)

    while (i < length) {
        let c = strCharAt(listing, i)
        if (c == '\n') {
            let qualified = strConcat(strConcat(site.s1, "."), name)
            seen = mergeNamedModule(merged, site, qualified, baseDir, seen)
            name = ""
        } else {
            name = strConcat(name, strFromChar(c))
        }
        i = i + 1
    }

    let last = strConcat(strConcat(site.s1, "."), name)
    return mergeNamedModule(merged, site, last, baseDir, seen)
}

// Walks `module`, appending its non-import declarations into the shared `merged`
// accumulator and resolving each import it carries. `visited` threads the set of
// already-resolved paths through the recursion and is returned so sibling
// imports see what earlier ones resolved.
private fn mergeModuleImports(merged: ASTNode, module: ASTNode, baseDir: String, visited: String) -> String {
    let mut seen = visited

    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        let nextStmt = stmt.next
        stmt.next = ptr_null()

        if (stmt.kind == NodeKind.IMPORT_STATEMENT) {
            if (stmt.i1 == 1) {
                seen = mergePackageImport(merged, stmt, baseDir, seen)
            } else {
                seen = mergeNamedModule(merged, stmt, stmt.s1, baseDir, seen)
            }
        } else {
            appendStatement(merged, stmt)
        }

        stmtPtr = nextStmt
    }

    return seen
}

// Finds a standard module in a source checkout or an installed toolchain.
// Standard modules are compiler-owned rather than relative to an application's
// entry file, so a local `std/` directory cannot replace the shipped
// definitions.
//
// `leaf` is the file name, because the installed layout flattens the package:
// `std/map.psm` in a checkout is `stdlib/map.psm` once installed.
private fn standardModulePath(baseDir: String, leaf: String) -> String {
    let besideEntry = join_path(baseDir, strConcat("std/", leaf))
    if (file_exists(besideEntry) == 1) { return besideEntry }

    let inSourceTree = join_path(get_directory(baseDir), strConcat("std/", leaf))
    if (file_exists(inSourceTree) == 1) { return inSourceTree }

    let toolchainRoot = get_directory(executable_directory())

    let installed = join_path(toolchainRoot, strConcat("stdlib/", leaf))
    if (file_exists(installed) == 1) { return installed }

    let besideBuild = join_path(toolchainRoot, strConcat("std/", leaf))
    if (file_exists(besideBuild) == 1) { return besideBuild }

    return ""
}

// Where `import std.map` reads from.
//
// An ordinary import is relative to the source root, and that is right for an
// application's own modules. It is wrong for `std.*`: those are shipped with the
// compiler, and a program that imports one is not asking for a file that happens
// to sit next to it. Resolved relative to the entry first all the same, so a
// checkout of the compiler compiles against its own `std/` rather than an
// installed copy.
//
// Each branch rebuilds the path rather than binding it once. Strings are affine,
// so a binding tested with file_exists and then returned is named twice; a fresh
// temporary per use is a str_concat and avoids the question.
private fn resolveImportPath(baseDir: String, moduleName: String) -> String {
    if (file_exists(joinImportPath(baseDir, moduleName)) == 1) {
        return joinImportPath(baseDir, moduleName)
    }
    if (strStartsWith(moduleName, "std.") == false) {
        return joinImportPath(baseDir, moduleName)
    }
    let leaf = strConcat(strSubstring(moduleName, 4, __builtin_string_len(moduleName) - 4), ".psm")
    if (strEquals(standardModulePath(baseDir, leaf), "")) {
        return joinImportPath(baseDir, moduleName)
    }
    return standardModulePath(baseDir, strConcat(strSubstring(moduleName, 4, __builtin_string_len(moduleName) - 4), ".psm"))
}

// The entry file is marked resolved before the walk begins, so that a package
// import naming the package it lives in cannot pull it in a second time and
// duplicate every function it defines.
private fn resolveImports(module: ASTNode, baseDir: String, entryPath: String) -> ASTNode {
    let merged = createNode(NodeKind.MODULE)
    // The index and the tail cache describe `merged`, so both start empty with
    // it. analyzeModule and generateModule rebuild the index from the finished
    // module; this fill is the merge's own, and it is the same one walk.
    ir_reset_decl_index()
    // Selections are recorded by the merge below and read by sema, so this is
    // the one point where the previous run's are gone and this run's are not
    // yet made.
    ir_reset_selections()
    mergeTailPtr = ptr_null()
    // No prelude. `std.io` is an ordinary import, so a program that names no I/O
    // carries none -- which is what lets a target with no stdout link at all.
    mergeModuleImports(merged, module, baseDir, importMemoKey(entryPath))

    // Generic declarations come out of the chain here, at the end of the merge
    // rather than at the start of sema, so that every consumer of a resolved
    // module sees the same thing: a chain of concrete declarations, plus
    // whatever instantiation later appends to it.
    monoCollectTemplates(merged)

    // After the templates are out of the way, so that a *generic* payload enum
    // is desugared once per instantiation rather than once as a template whose
    // payload types are still type parameters.
    enumDesugarModule(merged)
    return merged
}

private fn printUsage() {
    println("Usage:")
    println("")
    println("Project commands -- these read build.ums, found at or above the")
    println("working directory, and write to .prismio/build/<profile>/:")
    println("  prismio init [name]              start a project here, or in a new directory")
    println("  prismio build [--release]        build every target")
    println("  prismio run [--release]          build, then run the executable target")
    println("  prismio test [--release]         build and run every test target")
    println("  prismio clean [--release]        remove this profile's build output")
    println("")
    println("Single-file commands -- these name a source and need no manifest:")
    println("  prismio build [source.psm] [-o output.exe] [-g] [--verify]")
    println("                [--overflow-checks] [--target <triple>] [--sysroot <sdk>]")
    println("  prismio run <source.psm> [-o output.exe] [-g] [--verify] [--jit]")
    println("                [--overflow-checks]")
    println("  prismio check <source.psm> [--diagnostic-format=json]")
    println("  prismio bootstrap [source.psm] [-o output.exe] [-g]")
    println("  prismio runtime-hash")
    println("  prismio dump-ast <source.psm>")
    println("  prismio aif <source.psm> [--summary] [--layout] [--copyable-collections] [--theta-fields] [--budget=N]")
    println("                            [--target <triple>]")
    println("  prismio aif <source.psm> --why=<symbol>   why one record has the tier it has")
    println("  prismio build|aif <source.psm> --force-layout=<Type>:<hot>   emit a named layout candidate")
    println("")
    println("-g emits DWARF: line tables, functions, scopes, locals and struct")
    println("   layouts, so the program can be run under lldb or gdb. It also drops")
    println("   the object step to -O0, because a variable folded into a register is")
    println("   a variable a debugger cannot show you. Distinct from --debug, which")
    println("   is the analysis level and says nothing about debug info.")
    println("")
    println("--target takes an LLVM target triple -- x86_64-apple-macos,")
    println("   aarch64-linux-android, x86_64-pc-windows-msvc,")
    println("   x86_64-unknown-linux-gnu, wasm32-unknown-unknown. LLVM validates")
    println("   it and answers with the pointer width and data layout, so there")
    println("   is no list of supported targets to fall out of date. --sysroot")
    println("   points clang at that target's SDK, and a cross build links")
    println("   runtime-<triple> rather than the host's runtime.")
    println("")
    println("build/run link against the installed Prismio runtime only.")
    println("A project command is the same command with no source named: `prismio build`")
    println("builds the project, `prismio build main.psm` builds one file.")
    println("bootstrap builds the compiler itself from the repository sources,")
    println("linking the compiler backend and the LLVM C API it calls.")
}

// LAYOUT 8's forced candidate: `--force-layout=<Type>:<hot>`.
//
// Accepted by `build` as well as `aif`, and that is the point rather than a
// convenience -- 8 selects by *measuring*, so the flag has to be able to produce a
// binary, not just a manifest describing one. `aif` takes it so the report and the
// executable can be made to agree.
//
// The value names a layout by hot-field count because that is what `--layout`
// prints (`split 8/12`), so the cut a reader picks off the table is the cut they
// can ask for. Forcing the full field count is "no split", which is a candidate
// like any other and is how a split type is measured against its own baseline.
//
// Returns false on a malformed value, and the caller turns that into an error
// rather than a warning: a mistyped force that carried on would measure the argmin
// twice and report it as two candidates.
private fn parseForceLayout(flag: String) -> Bool {
    let value = strSubstring(flag, 15, __builtin_string_len(flag) - 15)
    let colon = strIndexOf(value, ":")
    if (colon < 1) { return false }
    let typeName = strSubstring(value, 0, colon)
    let hotText = strSubstring(value, colon + 1, __builtin_string_len(value) - colon - 1)
    if (strEquals(hotText, "")) { return false }
    // str_to_int answers 0 for a non-numeric string, which is also the value a
    // hot count can never legally take -- field 0 is pinned hot, so every real
    // candidate keeps at least one field. One check covers both.
    let hot = optionOr(strParseInt(hotText), 0)
    if (hot < 1) { return false }
    aif_layout_force(typeName, hot)
    return true
}

// Every force has to match a candidate, and a force that matched nothing is the
// one failure this flag can have that looks like success -- the build would emit
// the argmin and the measurement would compare a layout against itself. So it is
// a warning per unmatched force, named, rather than a silent fallback.
//
// A warning rather than an error because the same flag is legitimately passed to a
// whole corpus by a search script, where most programs do not declare the type
// being forced. The check that matters is that *nothing* matched silently.
private fn reportForcedLayouts() {
    let mut i = 0
    while (i < aif_layout_forced_count()) {
        if (aif_layout_force_applied(i) == 0) {
            diag_warning_code("P1003", strConcat(strConcat(strConcat(
                "--force-layout did not apply: no candidate of ",
                diagQuote(aif_layout_forced_type(i))),
                strConcat(" keeps ", strFromInt(aif_layout_forced_hot(i)))),
                " fields hot (see `aif --layout` for the candidates)"))
        }
        i = i + 1
    }
}

// The installed runtime library carries the hash of the sources it was built from.
// When both that and a source tree are present they must agree, otherwise the
// program being compiled would silently link a runtime that no longer matches the
// code in front of you. Content hashes rather than timestamps, so a fresh checkout
// or a file copy does not read as a change.
private fn checkRuntimeFreshness() {
    let installed = compiler_installed_runtime_hash()
    if (strEquals(installed, "")) {
        return
    }

    let current = compiler_runtime_source_hash()
    if (strEquals(current, "")) {
        return
    }

    if (strEquals(installed, current)) {
        return
    }

    diag_error_code("P1004", "the installed Prismio runtime library is stale")
    print("  runtime library was built from sources hashing ")
    println(installed)
    print("  the runtime sources on disk now hash ")
    println(current)
    println("  Re-package the toolchain (tools/package.sh, or tools/package.ps1 on Windows)")
    println("  so lib/ matches runtime/, or move away from the source tree to use the")
    println("  installed runtime as-is.")
    exit(1)
}

// Front half of compileSource -- lex, parse, resolve imports, type check -- and
// nothing after it. The commands that analyse rather than build all need exactly
// this and none of them may proceed past a diagnostic, so it is one function
// rather than a flag threaded through compileSource: the build path keeps no
// branch that only an analysis command takes.
//
// Failure is signalled through the diagnostic count rather than through the
// returned node, because "no AST" and "an AST with errors in it" are different
// states and only one of them has anything to return. Callers check
// diag_error_count() > 0; diag_finish() prints but does not reset, so the count
// is still there to read.
//
// This function is where `ptr_is_null` came from. The obvious version returned a
// node pointer and used "" as the sentinel, which is the idiom the rest of the
// compiler uses -- and it silently reported every successful parse as a failure,
// because a punned pointer compares as a string and an ASTNode begins with its
// `kind`, of which MODULE is 0. See ast.psm.
private fn analyzedModule(path: String) -> ASTNode {
    let content = read_file(path)
    if (strEquals(content, "") and file_exists(path) == 0) {
        diag_error_code("P1005", strConcat("cannot read ", path))
        return createNode(NodeKind.MODULE)
    }

    let rootFile = diag_add_file(path, content)
    let lex = createLexer(content, rootFile)
    let headToken = lexAllTokens(lex)
    let p = parserCreate(headToken)
    let astRoot = parseModule(p)

    let baseDir = get_directory(path)
    let mergedAst = resolveImports(astRoot, baseDir, path)

    // Parsing recovers, so errors may already be waiting here. Type checking a
    // module with a declaration missing produces cascades, not information.
    if (diag_error_count() > 0) {
        diag_finish()
        return mergedAst
    }

    analyzeModule(mergedAst)

    if (diag_error_count() > 0) {
        diag_finish()
    }

    return mergedAst
}

// Emits the post-sema AST as JSON. Sema has to have run: the dump carries each
// node's resolved type, and without it the `ty` field would be empty on every
// node.
private fn dumpAstCommand(path: String) -> Int {
    let merged = analyzedModule(path)
    if (diag_error_count() > 0) {
        return 1
    }

    dumpAstJson(merged, path, PRISMIO_VERSION)
    return 0
}

// The IDE-facing compile boundary: the complete frontend, with no AIF, IR,
// native toolchain or output file. A successful JSON run still emits a summary,
// which gives a long-lived client an explicit signal to clear stale diagnostics.
private fn checkCommand(path: String) -> Int {
    analyzedModule(path)
    diag_finish()
    if (diag_error_count() > 0) {
        return 1
    }
    return 0
}

// Runs the AIF memory model over the module and reports (aif/spec/SPEC.md 6).
// Produces no IR and touches no codegen, so it cannot change what `build`
// generates -- which is the point at this stage: the tier distribution becomes
// measurable before any of it is risked on the self-host.
private fn aifCommand(path: String, summary: Bool, ownedCollections: Bool, thetaFields: Bool,
               budget: Int, why: String, layout: Bool) -> Int {
    let merged = analyzedModule(path)
    if (diag_error_count() > 0) {
        return 1
    }

    // **The manifest has to describe the build, and that means running the
    // workload here too.** This is the same trap the `owned_collections` default
    // fell into: `prismio aif` analysed one language and `prismio build` compiled
    // another, both were true, and two sessions of notes were written off the
    // wrong number. A declared workload changes the `layout` column, so reporting
    // the static profile while the build measures one would put this command back
    // in exactly that position.
    //
    // The cost is real and is the honest price: `prismio aif` on a program with a
    // workload compiles and runs that workload, so it is as slow as a build. The
    // alternative is a fast command that describes a binary nobody builds.
    let profilePath = runWorkloadProfile(merged, path, false)

    // `--why` explains one record instead of printing the manifest. It runs the
    // same inference -- the derivation is a by-product of the solve, not a
    // second pass -- so the answer describes the build a plain run would give.
    // That last clause was false while ownedCollections defaulted to off: the
    // derivation explained a tier from a model the build does not use, and
    // A-COPY was the answer to every "why is this T3" the compiler could ask.
    if (strEquals(why, "") == false) {
        let converged = aifRunProfiled(merged, ownedCollections, thetaFields, budget,
                                        profilePath)
        discardWorkloadProfile(profilePath)
        return 1 - aifExplain(why, converged)
    }

    aifAnalyzeProfiled(merged, path, PRISMIO_VERSION, ownedCollections, summary,
                        thetaFields, budget, profilePath, layout)
    discardWorkloadProfile(profilePath)
    reportForcedLayouts()
    return 0
}

// ---------------------------------------------------------------------------
// LAYOUT 3.2 -- the workload runner
//
// Builds a second, instrumented program from the same module, runs it, and
// returns the path of the profile it wrote. Returns "" for every failure, which
// is W2: "SHALL cause a fallback to the static profile and a warning. It SHALL
// NOT fail the build."
//
// **There is no path out of this function that returns non-zero**, and that is
// the clause implemented rather than described. Every step below is checked and
// every check warns and returns "". The one thing that would violate it is a
// diagnostic *error*, so this raises none -- `diag_warning` throughout.
//
// The instrumented build deliberately reuses the ordinary pipeline rather than a
// special one: same aifRun, same generateModule, same compiler_build_executable.
// LAYOUT 3.2 requires the workload to run "under a baseline layout (AoS, source
// field order, no packing)", which is what a run with no profile loaded already
// produces -- so the baseline is the absence of an input rather than a second
// code path that has to be kept in step with the first.
private fn runWorkloadProfile(module: ASTNode, sourcePath: String, verifyMode: Bool) -> String {
    let count = moduleWorkloadCount(module)
    if (count == 0) { return "" }

    // LAYOUT 3.1 permits several workloads, merged by summation. One runner
    // handles one; the sum of several needs a merge step this does not have, so
    // the honest thing is to run the first and say so rather than silently
    // measure one and present it as all of them.
    if (count > 1) {
        diag_warning_code("P1006", "this module declares more than one workload; only the first is measured (profiles are not merged yet)")
    }

    let wl = findWorkload(module)

    // RESULTS-layout 7. All three were predictable paths, which made them shared
    // state between two compiles of the same source: the driver executable one
    // process ran could be the one another process had just overwritten, and a
    // build that read someone else's profile.txt chose a different field order
    // with no warning and no fallback -- so the IR differential, which is this
    // project's definition of a behaviour-preserving change, reported a false
    // difference whenever anything else was compiling.
    //
    // Nothing here wants to be predictable except the profile, and only as an
    // *artifact* (LAYOUT 2.2, checked in beside the manifest). So the build
    // writes and reads its own copy and publishes that one afterwards.
    let driverIr = compiler_temp_private_path(sourcePath, "workload.ll")
    let driverExe = compiler_temp_private_path(sourcePath, "workload.exe")
    let profilePath = compiler_temp_private_path(sourcePath, "profile.txt")
    let publishedProfile = compiler_temp_path_for(sourcePath, "profile.txt")

    // A stale profile from a previous build would be loaded as this build's if
    // the run below failed to write one -- the failure would then look like a
    // success, which is the one way W2's fallback can go wrong silently. Now
    // that the path carries the pid a leftover is someone else's rather than
    // this build's, which is a stronger reason to delete it rather than a
    // weaker one: it cannot be ours, so it can only mislead.
    delete_file(profilePath)

    ir_reset()
    // A verify build swaps the allocator names; the driver must not inherit that,
    // or its counters measure a program with different allocation behaviour from
    // the one being built.
    compiler_set_verify_mode(0)
    compiler_set_workload_mode(1)

    // The instrumented pass runs the analysis over a module whose `main` is the
    // driver, so the workload's own allocations are tiered like any other code.
    // The layout search runs too and is *ignored*: its input is the static
    // estimate, and its output is overwritten by the real pass. Suppressing it
    // would be a second code path for no gain.
    aifRun(module, true, false, AIF_DEFAULT_ROUNDS)

    irSetProfileMode(true, profilePath)
    generateModule(module)
    irSetProfileMode(false, "")

    // **Every exit below goes through endWorkloadPass, and it has to.** This
    // function leaves three pieces of global state behind it -- the workload
    // build mode, the verify mode it cleared, and a struct registry the driver's
    // generateModule filled -- and W2 means most of its exits are failures. An
    // early `return ""` that skipped the restore would hand the real build a
    // registry that already has every struct in it, and generateStructDecl
    // returns early on an already-registered struct: the shipped program would
    // lose its type bodies because a *workload* failed to link.
    //
    // The language has no `defer`, so the discipline is one helper and a rule:
    // nothing in this function returns without calling it.
    let mut failure = ""
    if (ir_write_file(driverIr) != 0) {
        failure = "could not write the workload driver's IR; using the static profile"
    }

    if (strEquals(failure, "")) {
        if (compiler_build_executable(driverIr, driverExe) != 0) {
            // The driver's IR is deliberately *kept* when it fails to build, and
            // named in the warning. A workload that will not compile is a compiler
            // bug far more often than a user one -- the driver is generated code --
            // and deleting the only artifact that shows why would leave nothing to
            // read but a linker's opinion of a file that no longer exists.
            failure = strConcat(strConcat("the workload failed to build; using the static profile (driver IR kept at ",
                                             driverIr), ")")
        } else {
            delete_file(driverIr)

            // 60 seconds. A build-time budget has to be short enough that a
            // runaway workload is an inconvenience rather than a hung CI job, and
            // long enough that instrumentation -- a call per field access -- does
            // not time out a workload that would finish. `repeat` is the knob for
            // the second half.
            let ran = compiler_run_workload(driverExe, 60)
            delete_file(driverExe)
            if (ran != 0) {
                failure = "the workload exited with a failure status or timed out; using the static profile"
            } else if (file_exists(profilePath) == 0) {
                failure = "the workload ran but wrote no profile; using the static profile"
            }
        }
    }

    endWorkloadPass(verifyMode)

    if (strEquals(failure, "") == false) {
        diag_warning_code("P1007", failure)
        return ""
    }

    // Published, not moved: this build still reads its own copy. Best-effort --
    // a profile that cannot be copied is an artifact nobody gets, not a build
    // that fails, which is the same W2 posture as everything else here.
    compiler_publish_file(profilePath, publishedProfile)
    return profilePath
}

// The private half of the profile (RESULTS-layout 7). The published copy is the
// durable artifact; this one exists only so the read cannot race, and it carries
// this process's pid -- so no later build will ever clean it up and every
// consumer of the path runWorkloadProfile returns has to.
private fn discardWorkloadProfile(profilePath: String) {
    if (strEquals(profilePath, "") == false) {
        delete_file(profilePath)
    }
}

// Restores everything runWorkloadProfile disturbed. Called on every path out of
// it, success or failure.
//
// `ir_reset` is the load-bearing one: the driver's generateModule filled the
// struct registry and named every string global, and the real build's
// generateModule would then skip the structs it thinks it has already emitted.
private fn endWorkloadPass(verifyMode: Bool) {
    ir_reset()
    compiler_set_workload_mode(0)
    if (verifyMode) {
        compiler_set_verify_mode(1)
    }
}

private fn compileSource(path: String, outputFile: String, runAfterBuild: Bool, bootstrapMode: Bool,
                  verifyMode: Bool, debugMode: Bool, debugInfo: Bool, optimized: Bool,
                  jitMode: Bool) -> Int {
    let mut outFile = ""
    let mut emitIrOnly = false

    // Bootstrap deliberately skips this: it never consults the installed libraries
    // at all, so their freshness cannot affect the result.
    if (bootstrapMode == false) {
        checkRuntimeFreshness()
    }

    if (strEndsWith(outputFile, ".ll")) {
        outFile = outputFile
        emitIrOnly = true
    } else {
        outFile = compiler_temp_ir_path(path)
    }

    let content = read_file(path)
    if (strEquals(content, "") and file_exists(path) == 0) {
        diag_error_code("P1008", strConcat("cannot read ", path))
        if (bootstrapMode) {
            println("  bootstrap compiles the Prismio compiler from a source checkout.")
            println("  Run it from the repository root, or give the source path explicitly:")
            println("      prismio bootstrap path/to/src/main.psm")
        }
        return 1
    }

    let rootFile = diag_add_file(path, content)
    let lex = createLexer(content, rootFile)
    let headToken = lexAllTokens(lex)
    let p = parserCreate(headToken)
    let astRoot = parseModule(p)

    let baseDir = get_directory(path)
    let mergedAst = resolveImports(astRoot, baseDir, path)

    // Parsing recovers, so errors may already be waiting here. Type checking a
    // module with a declaration missing produces cascades, not information.
    if (diag_error_count() > 0) {
        diag_finish()
        return 1
    }

    analyzeModule(mergedAst)

    // Sema reports every error it finds rather than stopping at the first, so the
    // decision to give up belongs here rather than inside the checker.
    if (diag_error_count() > 0) {
        diag_finish()
        return 1
    }

    // AIF, between sema and codegen. It reports nothing here and writes nothing
    // back to the AST; codegen queries it per allocation site through
    // aif_tier_at. `prismio aif` runs the same engine and prints the manifest.
    //
    // It cannot fail the build. SPEC 1: inference failure degrades performance
    // and never correctness, and a value it says nothing about is allocated the
    // way it always was.
    // `true` for owned collections is AIF Level 4: types.psm made String and List
    // move-only, so the copy rule no longer applies to them and the analysis has
    // to agree with the language. This is the switch that gives the 184 T1 string
    // sites a free point -- with it off, site_is_move_only admits structs only and
    // aif_frees_at_scope_node declines every one of them.
    // SPEC 7.2's level, as a budget. `debug` is zero rounds: the same engine
    // runs, builds the same graph and records the same pins, but nothing is
    // proved, so widening puts every value at its top tier -- heap, no drop, no
    // arena, no count, no collector. That is the zero-analysis mode SPEC 7.1
    // requires, and running the engine rather than skipping it is what keeps
    // 7.2's "a level SHALL NOT change which programs compile" true: a refuted
    // `pin` is still diagnosed.
    let mut aif_rounds = AIF_DEFAULT_ROUNDS
    if (debugMode) { aif_rounds = 0 }

    // LAYOUT 3. If the program declares a workload, measure it before the real
    // analysis runs, and hand the measured profile to the layout search in place
    // of the static estimate.
    //
    // **Everything about the ordering here is W2 and W4.**
    //
    // W2 -- "a workload that fails to build, fails to run, times out, or exceeds
    // the budget SHALL cause a fallback to the static profile and a warning; it
    // SHALL NOT fail the build." So this returns a path or "", nothing else. It
    // cannot raise a diagnostic error, and `diag_error_count()` is deliberately
    // not consulted after it: a build that got this far has a program that
    // compiles, and the workload is an optimisation input.
    //
    // W4 -- "two builds with different profiles SHALL produce behaviourally
    // identical programs." The profile reaches codegen through exactly one
    // channel, aif_layout_select's field counts, and a layout is not observable.
    // Nothing below reads the profile for any other purpose, and irProfileMode is
    // false for the whole of the real build.
    //
    // Deliberately skipped in bootstrap mode. The compiler declares no workload,
    // so this would be dead code there -- but it would also mean the bootstrap
    // path could run a program at build time, and bootstrap's whole contract is
    // that it builds from the checkout and does nothing else.
    let mut profilePath = ""
    if (bootstrapMode == false and debugMode == false) {
        profilePath = runWorkloadProfile(mergedAst, path, verifyMode)
    }

    let aifConverged = aifRunProfiled(mergedAst, true, false, aif_rounds, profilePath)
    discardWorkloadProfile(profilePath)

    // The one thing AIF can fail a build for, and SPEC 5.4.1 is explicit that it
    // is not a violation of SPEC 1: a pin a *converged* analysis refutes is a
    // false assertion about the program, not an inference failure. An unproven
    // one warns and is ignored.
    // REQUIREMENTS 19's gate joins it, and for the same reason: a budget the
    // converged estimate exceeds is a false assertion about one's own program,
    // which SPEC 5.4.1 separates from an inference failure.
    if (aifReportPins() + aifReportBudgets(aifConverged) > 0) {
        diag_finish()
        return 1
    }

    // SPEC 5.2. Warns rather than fails, so it goes after the gate above: an
    // inert `region` is a pessimisation, not a false assertion about a value.
    aifReportInertRegions()

    // After the analysis, because `applied` is set by the selection it reports on.
    // A workload build runs the engine twice and this reads the second, real pass
    // -- which is the one whose layout ships.
    reportForcedLayouts()

    ir_reset()

    // SPEC 7.3's verify mode is a name swap through the allocator seam and
    // nothing else -- codegen is identical to a release build. The shims live in
    // runtime/lang_runtime.c and check that every object is released exactly
    // once, poisoning it on the way out so a read that should not have happened
    // returns a pattern instead of plausible data.
    if (verifyMode) {
        ir_set_alloc_function("aif_verify_alloc")
        ir_set_free_function("aif_verify_release")
        // The other half of the swap. Strings and lists are affine as of Level 4
        // and are allocated inside the runtime, past this seam -- without this
        // every string a program drops reports as a release of something that was
        // never live.
        compiler_set_verify_mode(1)
    }

    // Before generateModule, because the first thing it does after starting the
    // module is open the compile unit.
    //
    // `optimized` is passed through to DW_AT_APPLE_optimized rather than assumed
    // false: -g drops the object step to -O0, but an explicit `-O2 -g` still runs
    // the IR pipeline, and a debugger uses that bit to warn the reader that a
    // variable may have been folded away. Claiming otherwise is exactly the kind
    // of small lie ir/debug.psm exists to prevent.
    if (debugInfo) {
        irSetDebugInfo(true, strConcat("prismio ", PRISMIO_VERSION), path, optimized)
        compiler_set_debug_info(1)
    }

    generateModule(mergedAst)

    // Before `ir_write_file`, and that is the whole point: `--jit` writes no IR,
    // spawns no clang and links nothing. The module generated above is the one
    // that runs, so what executes is what a `build` of the same source would
    // have produced.
    if (jitMode) {
        // Reported exactly as the non-JIT `run` reports it, and deliberately:
        // `--jit` is a way of running the same program, so a caller must not be
        // able to tell which path ran from the exit status or the diagnostic.
        // That is also what makes the two comparable in run_jit_test.
        let status = ir_jit_run_main(path)
        if (status != 0) {
            diag_error_code("P1009", strConcat(path, " exited with a failure status"))
            return 1
        }
        return 0
    }

    if (ir_write_file(outFile) != 0) {
        diag_error_code("P1010", strConcat("cannot write LLVM IR to ", outFile))
        return 1
    }

    if (emitIrOnly) {
        print("Wrote LLVM IR: ")
        println(outFile)
        return 0
    }

    let mut buildFailed = 0
    if (bootstrapMode) {
        buildFailed = compiler_bootstrap_executable(outFile, outputFile)
    } else {
        buildFailed = compiler_build_executable(outFile, outputFile)
    }

    if (buildFailed != 0) {
        delete_file(outFile)
        diag_error_code("P1011", "the native build step failed (llc/clang); see the output above")
        return 1
    }

    delete_file(outFile)

    print("Built ")
    println(outputFile)

    if (runAfterBuild) {
        if (compiler_run_executable(outputFile) != 0) {
            diag_error_code("P1012", strConcat(outputFile, " exited with a failure status"))
            return 1
        }
    }

    return 0
}

// Project mode is deliberately a thin adapter. UMS discovers, parses, validates
// and plans the project; the compiler keeps the one responsibility it already
// owns: compiling each planned Prismio entry source. Future run/test/clean
// commands should call the same UMS model instead of growing parallel CLI logic.
// The last component of a path, with either separator. `""` when there is none.
private fn pathLeaf(path: String) -> String {
    let mut cut = strLastIndexOfChar(path, '/')
    let back = strLastIndexOfChar(path, '\\')
    if (back > cut) { cut = back }
    if (cut < 0) { return strClone(path) }
    return strSubstring(path, cut + 1, __builtin_string_len(path) - cut - 1)
}

// `prismio init [name]` -- a project in the current directory, or in a new one.
//
// One command rather than Cargo's `new` plus `init`: the only difference between
// them is whether a directory is created first, and that is what the optional
// argument says. It leaves the word `new` free, which matters because `new`
// means *project* everywhere else and would be a trap on anything else.
//
// **Nothing is written if anything would be overwritten.** The manifest is
// checked for first, and its presence ends the command -- re-running `init` in a
// project is a mistake, not a request to reset it.
private fn initUmsProject(nameArg: String) -> Int {
    let mut root = "."
    let mut name = ""
    if (strEquals(nameArg, "")) {
        name = pathLeaf(current_directory())
    } else {
        root = strClone(nameArg)
        name = strClone(nameArg)
    }

    // Rejected by UMS's own rule rather than a copy of it, so a name this writes
    // is a name the validator accepts -- the scaffold cannot be born invalid.
    if (umsValidName(name) == false) {
        diag_error_code("P1013", strConcat(strConcat("cannot use ", diagQuote(name)), " as a project name"))
        diag_note("a name may hold letters, digits, `-`, `_` and `.`")
        diag_note("run `prismio init <name>` to choose one")
        return 1
    }

    let manifestPath = join_path(root, "build.ums")
    if (file_exists(manifestPath) == 1) {
        diag_error_code("P1014", strConcat(manifestPath, " already exists"))
        return 1
    }

    if (make_directory(join_path(root, "src")) != 0) {
        diag_error_code("P1015", strConcat("could not create ", join_path(root, "src")))
        return 1
    }

    let manifest = strConcat("project {\n    name = \"", name)
    let manifestBody = strConcat(manifest,
        strConcat("\"\n    version = \"0.1.0\"\n    prismio = \"",
        strConcat(PRISMIO_VERSION,
        strConcat("\"\n}\n\ntargets {\n    executable(\"", name))))
    let manifestText = strConcat(manifestBody, "\") {\n        entry = \"src/main.psm\"\n    }\n}\n")
    if (write_file(manifestPath, manifestText) != 0) {
        diag_error_code("P1016", strConcat("could not write ", manifestPath))
        return 1
    }

    let entryPath = join_path(join_path(root, "src"), "main.psm")
    if (file_exists(entryPath) == 0) {
        if (write_file(entryPath,
                "import std.io\n\nfn main() -> Int {\n    println(\"Hello, Prismio!\")\n    return 0\n}\n") != 0) {
            diag_error_code("P1017", strConcat("could not write ", entryPath))
            return 1
        }
    }

    // `.prismio/` is build output, and a project that commits it ships one
    // machine's binaries. Written only when absent, so an existing ignore file
    // is never rewritten from under its author.
    let ignorePath = join_path(root, ".gitignore")
    if (file_exists(ignorePath) == 0) {
        if (write_file(ignorePath, ".prismio/\n") != 0) {
            diag_error_code("P1018", strConcat("could not write ", ignorePath))
            return 1
        }
    }

    print("created ")
    println(name)
    print("  ")
    println(manifestPath)
    print("  ")
    println(entryPath)
    print("  ")
    println(ignorePath)
    println("")
    if (strEquals(nameArg, "")) {
        println("build it with `prismio run`")
    } else {
        print("build it with `cd ")
        print(nameArg)
        println(" && prismio run`")
    }
    return 0
}

// `prismio test` -- build every `test(...)` target and run it.
//
// **A test passes when it exits 0.** That is the entire protocol, and it is
// deliberate: Prismio has no assertion library and no test attribute, so
// inventing a richer contract here would be a promise the language cannot keep.
// It is also what `tests/test_runner.py` already does for the compiler's own
// suite, so a project's tests and the compiler's are checked the same way.
//
// Every test is built before any is run, and every test runs even after one
// fails -- a run that stops at the first failure tells you about one test when
// you asked about all of them.
private fn testUmsProject(profile: String) -> Int {
    let workspace = umsLoadProject(".", profile)
    if (workspace.valid == false) {
        umsDiagnosticsPrint(workspace.diagnostics)
        return 1
    }

    let mut total = 0
    let mut index = 0
    while (index < workspace.targetCount()) {
        let target = workspace.target(index)
        if (target.kind == UmsTargetKind.TEST) {
            if (compileSource(target.sourcePath, target.outputPath,
                              false, false, false, false, false, false, false) != 0) {
                return 1
            }
            total = total + 1
        }
        index = index + 1
    }

    if (total == 0) {
        println("no test targets declared")
        diag_note("add `test(\"name\") { entry = \"tests/name.psm\" }` to build.ums")
        return 0
    }

    print("running ")
    print(total)
    println(" test(s)")

    let mut passed = 0
    let mut failed = 0
    index = 0
    while (index < workspace.targetCount()) {
        let target = workspace.target(index)
        if (target.kind == UmsTargetKind.TEST) {
            if (compiler_run_executable(target.outputPath) == 0) {
                print("  ok    ")
                println(target.name)
                passed = passed + 1
            } else {
                print("  FAIL  ")
                println(target.name)
                failed = failed + 1
            }
        }
        index = index + 1
    }

    print(passed)
    print(" passed, ")
    print(failed)
    println(" failed")
    if (failed > 0) { return 1 }
    return 0
}

// The profile a project command was asked for. `--release` is the only one with
// a spelling of its own; anything else is a flag this command does not take, and
// is reported as that rather than taken for a source path.
private fn projectProfile(startIndex: Int) -> String {
    let mut profile = "debug"
    let mut i = startIndex
    while (i < cli_arg_count()) {
        let flag = cli_arg(i)
        if (strEquals(flag, "--release")) {
            profile = "release"
        } else if (strEquals(flag, "--debug-profile")) {
            profile = "debug"
        } else {
            diag_error_code("P1019", strConcat("unknown argument ", diagQuote(flag)))
            diag_note("a project command takes `--release`; name a source file to build one file")
            return ""
        }
        i = i + 1
    }
    return profile
}

// Remove what this profile's build wrote.
//
// Deletes each planned target's output rather than the profile directory,
// because the compiler has no recursive delete and `delete_file` is the whole
// primitive. That is not a shortcut today: a planned target's output is the only
// thing a project build writes under the profile root, so this is complete. It
// stops being complete the moment a build emits an intermediate there, and the
// fix then is a directory primitive rather than a longer list here.
//
// The lockfile is deliberately left alone. It records what was resolved, not
// what was built, and `cargo clean` does not remove `Cargo.lock` either.
private fn cleanUmsProject(profile: String) -> Int {
    let workspace = umsLoadProject(".", profile)
    if (workspace.valid == false) {
        umsDiagnosticsPrint(workspace.diagnostics)
        return 1
    }

    let mut removed = 0
    let mut index = 0
    while (index < workspace.targetCount()) {
        let target = workspace.target(index)
        if (file_exists(target.outputPath) == 1) {
            if (delete_file(target.outputPath) == 0) {
                removed = removed + 1
            } else {
                diag_error_code("P1020", strConcat("could not remove ", target.outputPath))
                return 1
            }
        }
        index = index + 1
    }

    print("removed ")
    print(removed)
    print(" artifact(s) from ")
    println(profile)
    return 0
}

private fn buildUmsProject(profile: String, runAfterBuild: Bool) -> Int {
    let workspace = umsLoadProject(".", profile)
    if (workspace.valid == false) {
        umsDiagnosticsPrint(workspace.diagnostics)
        return 1
    }

    // v0.1 3.7. Dependencies are resolved and recorded before a single target is
    // compiled, because a build that half-succeeds and then reports an unresolved
    // dependency has already written artifacts against a tree it could not
    // describe.
    //
    // The lockfile is written **before** the failure check, not after it. A failed
    // resolve is exactly the case a reader wants the file for -- it records what
    // was asked for and that it did not resolve, which is the difference between
    // "the lockfile is stale" and "the fetch has nothing behind it".
    let resolveDiagnostics = umsDiagnostics()
    let resolutions = workspace.project.resolveDependencies(resolveDiagnostics)
    if (workspace.project.writeLockfile(resolutions) == false) {
        println("error: could not write the lockfile")
        return 1
    }
    if (list_len(resolveDiagnostics) > 0) {
        umsDiagnosticsPrint(resolveDiagnostics)
        return 1
    }

    let mut index = 0
    let mut executables = 0
    let mut firstExecutable = 0
    while (index < workspace.targetCount()) {
        let target = workspace.target(index)
        // A test target is not built here, for the reason `cargo build` does not
        // build tests: the ordinary build is the one a developer runs constantly,
        // and paying for the test programs every time is a cost with no reader.
        // `prismio test` builds them.
        if (target.kind == UmsTargetKind.TEST) {
            index = index + 1
            continue
        }
        let compilerTarget = target.kind == UmsTargetKind.COMPILER
        if (compileSource(target.sourcePath, target.outputPath,
                          false, compilerTarget, false, false, false, false, false) != 0) {
            return 1
        }
        if (target.kind == UmsTargetKind.EXECUTABLE or compilerTarget) {
            if (executables == 0) { firstExecutable = index }
            executables = executables + 1
        }
        index = index + 1
    }

    if (runAfterBuild == false) { return 0 }

    // Every target is built before anything is run, so `run` on a project whose
    // library target does not compile fails rather than running a stale binary
    // that happens to be next to it.
    if (executables == 0) {
        diag_error_code("P1021", "this project declares no executable target to run")
        diag_note("add `executable(\"name\") { entry = \"src/main.psm\" }` to build.ums")
        return 1
    }
    if (executables > 1) {
        diag_error_code("P1022", "this project declares more than one executable target")
        diag_note("running a chosen target needs a name argument, which `run` does not take yet")
        return 1
    }

    let target = workspace.target(firstExecutable)
    if (compiler_run_executable(target.outputPath) != 0) {
        diag_error_code("P1023", strConcat(target.outputPath, " exited with a failure status"))
        return 1
    }
    return 0
}

fn main() -> Int {
    let mut path = ""
    let mut outputFile = ""
    let mut command = ""
    let mut runAfterBuild = false
    let mut bootstrapMode = false
    let mut verifyMode = false
    let mut jitMode = false
    let mut debugMode = false
    let mut argIndex = 0

    if (cli_arg_count() <= 1) {
        printUsage()
        return 1
    }

    let first = cli_arg(1)

    if (strEquals(first, "--help") or strEquals(first, "-h")) {
        printUsage()
        return 0
    }

    // Reports the LLVM actually loaded rather than the one built against, so a
    // version mismatch is visible without having to provoke it.
    if (strEquals(first, "--version") or strEquals(first, "-V")) {
        print("prismio ")
        println(PRISMIO_VERSION)
        print("llvm ")
        println(ir_llvm_version())

        // **Which toolchain is this, and which standard library will it use.**
        // Not decoration: a compiler developer has several generations in
        // `build/` and no installed binary is the one they mean, and `std` is
        // resolved by search rather than by configuration -- so "what am I
        // compiling against" had no answer short of reading source. `rustc -vV`
        // and `go env` print exactly this, for exactly this reason.
        //
        // The stdlib line reports the path that *would* be used from here, so it
        // answers for the working directory rather than in the abstract. An
        // empty answer is printed as such rather than omitted: no standard
        // library found is the single most useful thing this can tell you.
        print("compiler ")
        println(executable_directory())
        let stdRoot = standardModulePath(".", "string.psm")
        print("stdlib ")
        if (strEquals(stdRoot, "")) {
            println("(none found)")
        } else {
            println(get_directory(stdRoot))
        }
        return 0
    }

    // Reports the hash of the runtime sources on disk. tools/package.ps1 records it
    // beside the packaged libraries so later builds can detect drift, and it keeps
    // that hash defined in exactly one place -- here, in C -- rather than
    // reimplemented in the packaging script.
    if (strEquals(first, "runtime-hash")) {
        let sourceHash = compiler_runtime_source_hash()
        if (strEquals(sourceHash, "")) {
            diag_error_code("P1024", "cannot find the Prismio runtime sources to hash")
            return 1
        }
        println(sourceHash)
        return 0
    }

    if (strEquals(first, "check")) {
        if (cli_arg_count() <= 2) {
            diag_error_code("P1025", "missing source file")
            printUsage()
            return 1
        }

        let mut checkArg = 3
        while (checkArg < cli_arg_count()) {
            let option = cli_arg(checkArg)
            if (strEquals(option, "--diagnostic-format=json")) {
                diag_set_json_mode(1)
            } else {
                diag_error_code("P1026", strConcat("unknown argument ", diagQuote(option)))
                printUsage()
                return 1
            }
            checkArg = checkArg + 1
        }

        return checkCommand(cli_arg(2))
    }

    // Emits the post-sema AST as JSON on stdout and stops. Produces no IR and
    // touches no codegen, so it cannot affect what `build` generates. Exists for
    // the AIF memory-model work, which analyses the real AST out-of-process.
    if (strEquals(first, "dump-ast")) {
        if (cli_arg_count() <= 2) {
            diag_error_code("P1027", "missing source file")
            printUsage()
            return 1
        }
        return dumpAstCommand(cli_arg(2))
    }

    // The memory model. `--summary` prints the tier distribution in the form
    // aif/prototype/aif.py prints it, so the two can be compared directly --
    // that comparison is the only real defence against a transfer function that
    // is subtly wrong and yields a silently wrong tier rather than a crash.
    if (strEquals(first, "aif")) {
        if (cli_arg_count() <= 2) {
            diag_error_code("P1028", "missing source file")
            printUsage()
            return 1
        }

        let mut aifSummary = false
        // The manifest has to describe the build, and the build analyses with
        // collections owned -- aifRun(mergedAst, true, ..) in compileSource.
        // This defaulted to false until 2026-08-08, so `prismio aif` reported a
        // pre-Level-4 language: strings copyable, A-COPY firing on any string
        // site with two holders, and 82 T3 records over src/main.psm that the
        // binary it purported to describe does not contain. Two sessions of
        // handoff notes were written off that number.
        let mut aifOwned = true
        let mut aifThetaFields = false
        let mut aifWhy = ""
        let mut aifLayout = false
        let mut aifBudgetArg = AIF_DEFAULT_ROUNDS
        let mut aifArg = 3
        while (aifArg < cli_arg_count()) {
            let flag = cli_arg(aifArg)
            if (strEquals(flag, "--summary")) {
                aifSummary = true
            } else if (strEquals(flag, "--layout")) {
                // LAYOUT 7.2's argmin and 8's ranked top-k. Acted on since
                // 2026-08-17: the `emitted` column says which candidate the binary
                // actually contains, which is what makes the table checkable
                // rather than a ranking nobody can tie to an object.
                aifLayout = true
            } else if (strStartsWith(flag, "--force-layout=")) {
                if (parseForceLayout(flag) == false) {
                    diag_error_code("P1029", "--force-layout= takes <Type>:<hot-field-count>, e.g. Particle:8")
                    return 1
                }
            } else if (strStartsWith(flag, "--why=")) {
                // SPEC 6.3's minimal cause for one record. The symbol is the one
                // the manifest prints, so it can be copied straight out of a
                // diff -- which is where a reader will have found it.
                aifWhy = strSubstring(flag, 6, __builtin_string_len(flag) - 6)
            } else if (strStartsWith(flag, "--budget=")) {
                // INFERENCE 5.3's truncation path is unreachable at the default
                // of 200 rounds, and an unreachable path is where a bug lives
                // undisturbed. This makes it reachable, which is what
                // tests/test_43 uses to check that widening only ever raises.
                aifBudgetArg = optionOr(strParseInt(strSubstring(flag, 9, __builtin_string_len(flag) - 9)), 0)
                if (aifBudgetArg < 1) {
                    diag_error_code("P1030", "--budget= must be at least 1 round")
                    return 1
                }
            } else if (strEquals(flag, "--theta-fields")) {
                // Approximate Theta_stack by field count instead of bytes, the
                // way aif/prototype/aif.py must because a JSON dump carries no
                // layout. tools/aif_differential.py passes this so the two are
                // compared on their inference rather than on a threshold only
                // one of them can evaluate.
                aifThetaFields = true
            } else if (strEquals(flag, "--owned-collections")) {
                // The default since Level 4 made String and List move-only.
                // Accepted so existing scripts keep working, and because saying
                // so explicitly costs nothing.
                aifOwned = true
            } else if (strEquals(flag, "--copyable-collections")) {
                // The pre-Level-4 language, where only structs were move-only.
                // Kept because it is the differential's second arm, not because
                // anything still compiles that way -- `prismio build` always
                // analyses with collections owned (see aifRun below).
                aifOwned = false
            } else if (strEquals(flag, "--target")) {
                // The layout model is target-dependent -- a String field, a
                // reference edge, an `Isize`, a `[T]` and a `List<T>` are all one
                // pointer, and a pointer is four bytes on wasm32. Without this
                // the model could only ever be inspected for the host, while
                // `prismio build --target` compiled against a different one.
                if (aifArg + 1 >= cli_arg_count()) {
                    diag_error_code("P1031", "`--target` requires an LLVM target triple (e.g. wasm32-unknown-unknown)")
                    return 1
                }
                if (targetSelect(cli_arg(aifArg + 1)) == false) {
                    diag_error_code("P1032", strConcat("unknown target triple ", diagQuote(cli_arg(aifArg + 1))))
                    return 1
                }
                aifArg = aifArg + 1
            } else {
                diag_error_code("P1033", strConcat("unknown argument ", diagQuote(flag)))
                printUsage()
                return 1
            }
            aifArg = aifArg + 1
        }

        return aifCommand(cli_arg(2), aifSummary, aifOwned, aifThetaFields, aifBudgetArg,
                           aifWhy, aifLayout)
    }

    // Compiler development. The command itself selects the build mode -- there is no
    // flag and no environment variable -- so a single binary can build user programs
    // against the installed runtime and still bootstrap against repository sources.
    if (strEquals(first, "bootstrap")) {
        command = "bootstrap"
        bootstrapMode = true
        runAfterBuild = false
        path = "src/main.psm"
        argIndex = 2

        if (cli_arg_count() > 2) {
            let candidate = cli_arg(2)
            // Every flag `bootstrap` accepts has to be named here too, or it
            // is taken for the source path and the build silently compiles a
            // file called `-g`.
            if (strEquals(candidate, "-o") == false and strEquals(candidate, "-g") == false) {
                path = candidate
                argIndex = 3
            }
        }

        outputFile = compiler_default_exe_path(path)

        let mut bootstrapDebugInfo = false

        while (argIndex < cli_arg_count()) {
            let barg = cli_arg(argIndex)
            if (strEquals(barg, "-o")) {
                if (argIndex + 1 >= cli_arg_count()) {
                    diag_error_code("P1034", "`-o` requires an output path")
                    return 1
                }
                outputFile = cli_arg(argIndex + 1)
                argIndex = argIndex + 2
            } else if (strEquals(barg, "-g")) {
                // The compiler is the largest Prismio program there is, and it
                // was the one program that could not be stepped through.
                bootstrapDebugInfo = true
                argIndex = argIndex + 1
            } else {
                diag_error_code("P1035", strConcat("unknown argument ", diagQuote(barg)))
                printUsage()
                return 1
            }
        }

        return compileSource(path, outputFile, runAfterBuild, bootstrapMode, false, false,
                              bootstrapDebugInfo, false, false)
    }

    // `build`, `run` and `clean` are each two commands wearing one name: with a
    // source they act on that file, and with none they act on the project
    // `build.ums` describes. What tells them apart is whether the next argument
    // names a source, and a leading `-` is a flag rather than a path -- which is
    // what lets `prismio build --release` be the project build it reads as.
    let projectMode = cli_arg_count() <= 2 or strStartsWith(cli_arg(2), "-")

    if (strEquals(first, "init")) {
        if (cli_arg_count() > 3) {
            diag_error_code("P1036", "`init` takes at most one name")
            return 1
        }
        if (cli_arg_count() == 3) { return initUmsProject(cli_arg(2)) }
        return initUmsProject("")
    }

    if (strEquals(first, "test")) {
        let profile = projectProfile(2)
        if (strEquals(profile, "")) { return 1 }
        return testUmsProject(profile)
    }

    if (strEquals(first, "clean")) {
        if (projectMode == false) {
            diag_error_code("P1037", "`clean` acts on the project and takes no source file")
            return 1
        }
        let profile = projectProfile(2)
        if (strEquals(profile, "")) { return 1 }
        return cleanUmsProject(profile)
    }

    if (strEquals(first, "build") or strEquals(first, "run")) {
        if (projectMode) {
            let profile = projectProfile(2)
            if (strEquals(profile, "")) { return 1 }
            return buildUmsProject(profile, strEquals(first, "run"))
        }

        // `cli_arg(1)` again rather than naming `first` twice: `cli_arg` is
        // declared `alias`, so a second call is a second borrow of `argv`, where
        // a second *name* would be a move (CODE_STYLE, affine strings).
        command = cli_arg(1)
        runAfterBuild = strEquals(first, "run")
        argIndex = 3
        path = cli_arg(2)
        if (strEquals(path, "run") or strEquals(path, "build")) {
            diag_error_code("P1038", "use either `build` or `run`, not both")
            return 1
        }
    } else if (strEndsWith(first, ".psm")) {
        // `prismio foo.psm` has always meant `prismio build foo.psm`, and still
        // does. Narrowed to a path-shaped argument, because the unnarrowed
        // version is what turned every mistyped command into a file that could
        // not be read: `prismio test` reported `cannot read test`, sending the
        // reader to the filesystem when the answer was the command name.
        command = "build"
        runAfterBuild = false
        path = first
        argIndex = 2
    } else {
        // `first` is moved into `path` by the branch above, so the name is read
        // again from argv rather than reused here.
        diag_error_code("P1039", strConcat("unknown command ", diagQuote(cli_arg(1))))
        diag_note("commands: init, build, run, test, clean, check, aif, dump-ast, bootstrap, runtime-hash")
        return 1
    }

    outputFile = compiler_default_exe_path(path)

    let mut debugInfo = false
    let mut optimized = false

    while (argIndex < cli_arg_count()) {
        let mut arg = cli_arg(argIndex)

        if (strEquals(arg, "-o")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1040", "`-o` requires an output path")
                return 1
            }
            outputFile = cli_arg(argIndex + 1)
            argIndex = argIndex + 2
        } else if (strStartsWith(arg, "-O") and __builtin_string_len(arg) == 3) {
            // -O0..-O3. Runs LLVM's standard pipeline over the module before it
            // is written; without it the output keeps a load/store per binding.
            let level = optionOr(strParseInt(strSubstring(arg, 2, 1)), 0)
            if (level < 0 or level > 3) {
                diag_error_code("P1041", strConcat("unknown optimization level ", diagQuote(arg)))
                return 1
            }
            ir_set_opt_level(level)
            optimized = level > 0
            argIndex = argIndex + 1
        } else if (strEquals(arg, "--target")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1042", "`--target` requires an LLVM target triple (e.g. x86_64-apple-macos)")
                return 1
            }
            // The triple is validated by LLVM rather than checked against a list
            // here: a list would be a second copy of what LLVM knows, and the
            // failure mode of a stale entry is a miscompile.
            if (targetSelect(cli_arg(argIndex + 1)) == false) {
                diag_error_code("P1043", strConcat("unknown target triple ", diagQuote(cli_arg(argIndex + 1))))
                return 1
            }
            // A contradiction rather than a combination: the JIT emits code for
            // *this* process, so a named target could only ever be ignored.
            // Silently running host code for someone who asked for wasm32 is the
            // worst of the three available behaviours.
            if (jitMode) {
                diag_error_code("P1044", "`--jit` and `--target` cannot be combined")
                diag_note("the JIT runs the module in this process, so it can only ever target the host")
                return 1
            }
            argIndex = argIndex + 2
        } else if (strEquals(arg, "--sysroot")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1045", "`--sysroot` requires a path to the target's SDK")
                return 1
            }
            compiler_set_sysroot(cli_arg(argIndex + 1))
            argIndex = argIndex + 2
        } else if (strEquals(arg, "--verify")) {
            // SPEC 7.3. Slower and heavier by design: the mode exists to be run
            // by CI, not by users.
            verifyMode = true
            argIndex = argIndex + 1
        } else if (strEquals(arg, "--overflow-checks")) {
            // RFC 0560's model: check in debug, wrap in release. `Int` is signed
            // 32-bit and wraps -- decided by measurement, RESULTS-int-width.md --
            // and this is what makes the wrap a diagnostic rather than a silence.
            //
            // **Off by default and it can never be otherwise.** A checked
            // operation is 5.4x-6.0x the plain one, not because the check is
            // expensive but because a branch per operation defeats vectorization
            // outright. Rust ties this to `debug-assertions`; Prismio has no
            // profile concept yet, so it is an explicit flag and the default is
            // the release answer.
            //
            // Set on the backend rather than threaded through codegen, because
            // every arithmetic site reads it and none of them decides it.
            ir_set_overflow_checks(1)
            argIndex = argIndex + 1
        } else if (strEquals(arg, "--jit")) {
            // `run` without the clang compile and the link. Off by default and
            // scoped to `run`, so codegen and every emission path are untouched:
            // this adds a way of executing the module, not a way of producing
            // one. See ir_jit_run_main in runtime/llvm-api-backend.c.
            if (strEquals(command, "run") == false) {
                diag_error_code("P1046", "`--jit` is only meaningful with `prismio run`")
                diag_note("`build` produces an object; there is nothing to run in this process")
                return 1
            }
            if (ir_target_is_explicit() == 1) {
                diag_error_code("P1047", "`--jit` and `--target` cannot be combined")
                diag_note("the JIT runs the module in this process, so it can only ever target the host")
                return 1
            }
            jitMode = true
            argIndex = argIndex + 1
        } else if (strEquals(arg, "-g")) {
            // Source-level debug info, and nothing else -- not an analysis level
            // and not an optimisation setting at the Prismio end. Named `-g`
            // because that is what every compiler in the world spells it; the
            // neighbouring `--debug` is SPEC 7.1's zero-analysis level and the
            // collision of names is unfortunate and not worth renaming a
            // released flag over.
            debugInfo = true
            argIndex = argIndex + 1
        } else if (strEquals(arg, "--debug")) {
            // SPEC 7.1/7.2's zero-analysis level. `max` is deliberately not
            // offered: with today's engine it would be byte-identical to
            // `release` -- the bounds it raises are never reached and there is no
            // monomorphization cap to raise -- and a flag whose settings cannot
            // be told apart is a check that cannot fail.
            debugMode = true
            argIndex = argIndex + 1
        } else if (strStartsWith(arg, "--force-layout=")) {
            // LAYOUT 8 selects the measured winner, so the flag has to reach the
            // path that produces something to measure.
            if (parseForceLayout(arg) == false) {
                diag_error_code("P1048", "--force-layout= takes <Type>:<hot-field-count>, e.g. Particle:8")
                return 1
            }
            argIndex = argIndex + 1
        } else {
            if (strEquals(arg, "build") or strEquals(arg, "run")) {
                diag_error_code("P1049", "use either `build` or `run`, not both")
                return 1
            }

            if (strEquals(command, "build") and argIndex == 2) {
                // Re-read rather than `outputFile = arg`: that moves `arg`, and
                // move state is per name for the whole body, so the `else` below
                // would report a use of a moved value on a path that never ran.
                outputFile = cli_arg(argIndex)
                argIndex = argIndex + 1
            } else {
                diag_error_code("P1050", strConcat("unknown argument ", diagQuote(arg)))
                printUsage()
                return 1
            }
        }
    }

    return compileSource(path, outputFile, runAfterBuild, bootstrapMode, verifyMode, debugMode,
                          debugInfo, optimized, jitMode)
}
