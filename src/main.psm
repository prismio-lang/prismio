// argv, which the C runtime owns and outlives every use of it. Not an
// allocation, and freeing one would be a free of memory this program never got.
extern fn cli_arg(index: Int) -> String alias
extern fn cli_arg_count() -> Int
// Both malloc and hand the buffer over: compiler_default_exe_path sprintfs into
// a fresh block, compiler_temp_ir_path goes through compiler_temp_path which
// does the same. The caller owns them.
extern fn compiler_default_exe_path(sourcePath: String) -> String produce(free)
// Every path through both mallocs, including the failure paths, which allocate a
// one-byte empty string rather than returning a literal. That is the same
// invariant Level 4 had to give str_substring and str_trim -- anything declared
// to return String returns something a release can take -- and it is what makes
// `produce` true here rather than nearly true.
extern fn compiler_runtime_source_hash() -> String produce(free)
// `--sysroot`. Where *this machine* keeps the SDK for the target -- not a
// property of the triple, which is why it is not in the target record: two hosts
// building the same target legitimately pass different paths, and an SDK the
// compiler picked for itself is the kind of helpful guess that ends in a link
// error someone spends an afternoon on.
extern fn compiler_set_sysroot(path: String borrow)
extern fn executable_directory() -> String produce(free)
extern fn get_directory(path: String) -> String
// A `static char buf[32]` the next call overwrites.
extern fn ir_llvm_version() -> String alias

extern fn ir_llvm_version() -> String alias

// Bumped per release. The LLVM major version is part of the identity: a given
// Prismio targets one LLVM major, and the C API is not stable across them.
let PRISMIO_VERSION = "0.1.0"

private fn printUsage() {
    println("Usage:")
    println("")
    println("Project commands -- these read build.ums, found at or above the")
    println("working directory, and write to .prismio/build/<profile>/:")
    println("  prismio init [name]              start a project here, or in a new directory")
    println("  prismio build [--release]        build every target")
    println("  prismio run [--release]          build, then run the executable target")
    println("  prismio test [--release]         build and run every test target")
    println("  prismio clean [--release]        remove this profile's build output")
    println("  prismio <name> [args...]         run a command the manifest declares")
    println("")
    println("Single-file commands -- these name a source and need no manifest:")
    println("  prismio build [source.psm] [-o output.exe] [-g] [--verify]")
    println("                [--overflow-checks] [--target <triple>] [--sysroot <sdk>]")
    println("  prismio run <source.psm> [-o output.exe] [-g] [--verify] [--jit]")
    println("                [--overflow-checks]")
    println("  prismio check <source.psm> [--diagnostic-format=json]")
    println("  prismio bootstrap [source.psm] [-o output.exe] [-g]")
    println("  prismio runtime-hash")
    println("  prismio dump-ast <source.psm>")
    println("  prismio aif <source.psm> [--manifest] [--summary] [--layout] [--copyable-collections] [--theta-fields] [--budget=N]")
    println("                            [--target <triple>]")
    println("  prismio aif <source.psm> --why=<ID|symbol>   explain one allocation decision")
    println("  prismio build|aif <source.psm> --force-layout=<Type>:<hot>   emit a named layout candidate")
    println("")
    println("-g emits DWARF: line tables, functions, scopes, locals and struct")
    println("   layouts, so the program can be run under lldb or gdb. It also drops")
    println("   the object step to -O0, because a variable folded into a register is")
    println("   a variable a debugger cannot show you. Distinct from --debug, which")
    println("   is the analysis level and says nothing about debug info.")
    println("")
    println("--target takes an LLVM target triple -- x86_64-apple-macos,")
    println("   aarch64-linux-android, x86_64-pc-windows-msvc,")
    println("   x86_64-unknown-linux-gnu, wasm32-unknown-unknown. LLVM validates")
    println("   it and answers with the pointer width and data layout, so there")
    println("   is no list of supported targets to fall out of date. --sysroot")
    println("   points clang at that target's SDK, and a cross build links")
    println("   runtime-<triple> rather than the host's runtime.")
    println("")
    println("build/run link against the installed Prismio runtime only.")
    println("A project command is the same command with no source named: `prismio build`")
    println("builds the project, `prismio build main.psm` builds one file.")
    println("bootstrap builds the compiler itself from the repository sources,")
    println("linking the compiler backend and the LLVM C API it calls.")
}

// LAYOUT 8's forced candidate: `--force-layout=<Type>:<hot>`.
//
// Accepted by `build` as well as `aif`, and that is the point rather than a
// convenience -- 8 selects by *measuring*, so the flag has to be able to produce a
// binary, not just a manifest describing one. `aif` takes it so the report and the
// executable can be made to agree.
//
// The value names a layout by hot-field count because that is what `--layout`
// prints (`split 8/12`), so the cut a reader picks off the table is the cut they
// can ask for. Forcing the full field count is "no split", which is a candidate
// like any other and is how a split type is measured against its own baseline.
//
// Returns false on a malformed value, and the caller turns that into an error
// rather than a warning: a mistyped force that carried on would measure the argmin
// twice and report it as two candidates.
private fn parseForceLayout(flag: String) -> Bool {
    let value = strSubstring(flag, 15, __builtin_string_len(flag) - 15)
    let colon = strIndexOf(value, ":")
    if (colon < 1) { return false }
    let typeName = strSubstring(value, 0, colon)
    let hotText = strSubstring(value, colon + 1, __builtin_string_len(value) - colon - 1)
    if (hotText.equals("")) { return false }
    // str_to_int answers 0 for a non-numeric string, which is also the value a
    // hot count can never legally take -- field 0 is pinned hot, so every real
    // candidate keeps at least one field. One check covers both.
    let hot = optionOr(strParseInt(hotText), 0)
    if (hot < 1) { return false }
    aif_layout_force(typeName, hot)
    return true
}

// Every force has to match a candidate, and a force that matched nothing is the
// one failure this flag can have that looks like success -- the build would emit
// the argmin and the measurement would compare a layout against itself. So it is
// a warning per unmatched force, named, rather than a silent fallback.
//
// A warning rather than an error because the same flag is legitimately passed to a
// whole corpus by a search script, where most programs do not declare the type
// being forced. The check that matters is that *nothing* matched silently.

// Reports the LLVM actually loaded rather than the one built against, so a
// version mismatch is visible without having to provoke it.
private fn cliVersion() -> Int {
    print("prismio ")
    println(PRISMIO_VERSION)
    print("llvm ")
    println(ir_llvm_version())

    // **Which toolchain is this, and which standard library will it use.**
    // Not decoration: a compiler developer has several generations in
    // `build/` and no installed binary is the one they mean, and `std` is
    // resolved by search rather than by configuration -- so "what am I
    // compiling against" had no answer short of reading source. `rustc -vV`
    // and `go env` print exactly this, for exactly this reason.
    //
    // The stdlib line reports the path that *would* be used from here, so it
    // answers for the working directory rather than in the abstract. An
    // empty answer is printed as such rather than omitted: no standard
    // library found is the single most useful thing this can tell you.
    print("compiler ")
    println(executable_directory())
    let stdRoot = standardModulePath(".", "string.psm")
    print("stdlib ")
    if (stdRoot.equals("")) {
        println("(none found)")
    } else {
        println(get_directory(stdRoot))
    }
    return 0
}

// The hash of the runtime sources on disk. tools/package.sh records it beside
// the packaged libraries so a later build can detect drift, which keeps the
// hash defined in exactly one place -- in C -- rather than reimplemented in the
// packaging script.
private fn cliRuntimeHash() -> Int {
    let sourceHash = compiler_runtime_source_hash()
    if (sourceHash.equals("")) {
        diag_error_code("P1024", "cannot find the Prismio runtime sources to hash")
        return 1
    }
    println(sourceHash)
    return 0
}

private fn cliCheck() -> Int {
    if (cli_arg_count() <= 2) {
        diag_error_code("P1025", "missing source file")
        printUsage()
        return 1
    }

    let mut checkArg = 3
    while (checkArg < cli_arg_count()) {
        let option = cli_arg(checkArg)
        if (option.equals("--diagnostic-format=json")) {
            diag_set_json_mode(1)
        } else {
            diag_error_code("P1026", strConcat("unknown argument ", diagQuote(option)))
            printUsage()
            return 1
        }
        checkArg = checkArg + 1
    }

    return checkCommand(cli_arg(2))
}

// Emits the post-sema AST as JSON on stdout and stops. Produces no IR and
// touches no codegen, so it cannot affect what `build` generates. Exists for
// the AIF memory-model work, which analyses the real AST out-of-process.
private fn cliDumpAst() -> Int {
    if (cli_arg_count() <= 2) {
        diag_error_code("P1027", "missing source file")
        printUsage()
        return 1
    }
    return dumpAstCommand(cli_arg(2))
}

// The memory model. `--summary` prints the tier distribution in the form
// aif/prototype/aif.py prints it, so the two can be compared directly -- that
// comparison is the only real defence against a transfer function that is
// subtly wrong and yields a silently wrong tier rather than a crash.
private fn cliAif() -> Int {
    if (cli_arg_count() <= 2) {
        diag_error_code("P1028", "missing source file")
        printUsage()
        return 1
    }

    let mut aifSummary = false
    // The manifest has to describe the build, and the build analyses with
    // collections owned -- aifRun(mergedAst, true, ..) in compileSource.
    // This defaulted to false until 2026-08-08, so `prismio aif` reported a
    // pre-Level-4 language: strings copyable, A-COPY firing on any string
    // site with two holders, and 82 T3 records over src/main.psm that the
    // binary it purported to describe does not contain. Two sessions of
    // handoff notes were written off that number.
    let mut aifOwned = true
    let mut aifThetaFields = false
    let mut aifWhy = ""
    let mut aifLayout = false
    let mut aifManifest = false
    let mut aifBudgetArg = AIF_DEFAULT_ROUNDS
    let mut aifArg = 3
    while (aifArg < cli_arg_count()) {
        let flag = cli_arg(aifArg)
        if (flag.equals("--summary")) {
            aifSummary = true
        } else if (flag.equals("--manifest")) {
            // The stable, compiler-facing form that `prismio aif` printed
            // before the interactive report became the default. CI and
            // manifest diffs opt into it explicitly.
            aifManifest = true
        } else if (flag.equals("--layout")) {
            // LAYOUT 7.2's argmin and 8's ranked top-k. Acted on since
            // 2026-08-17: the `emitted` column says which candidate the binary
            // actually contains, which is what makes the table checkable
            // rather than a ranking nobody can tie to an object.
            aifLayout = true
        } else if (strStartsWith(flag, "--force-layout=")) {
            if (parseForceLayout(flag) == false) {
                diag_error_code("P1029", "--force-layout= takes <Type>:<hot-field-count>, e.g. Particle:8")
                return 1
            }
        } else if (strStartsWith(flag, "--why=")) {
            // SPEC 6.3's minimal cause for one record. The symbol is the one
            // the manifest prints, so it can be copied straight out of a
            // diff -- which is where a reader will have found it.
            aifWhy = strSubstring(flag, 6, __builtin_string_len(flag) - 6)
        } else if (strStartsWith(flag, "--budget=")) {
            // INFERENCE 5.3's truncation path is unreachable at the default
            // of 200 rounds, and an unreachable path is where a bug lives
            // undisturbed. This makes it reachable, which is what
            // tests/test_43 uses to check that widening only ever raises.
            aifBudgetArg = optionOr(strParseInt(strSubstring(flag, 9, __builtin_string_len(flag) - 9)), 0)
            if (aifBudgetArg < 1) {
                diag_error_code("P1030", "--budget= must be at least 1 round")
                return 1
            }
        } else if (flag.equals("--theta-fields")) {
            // Approximate Theta_stack by field count instead of bytes, the
            // way aif/prototype/aif.py must because a JSON dump carries no
            // layout. tools/aif_differential.py passes this so the two are
            // compared on their inference rather than on a threshold only
            // one of them can evaluate.
            aifThetaFields = true
        } else if (flag.equals("--owned-collections")) {
            // The default since Level 4 made String and List move-only.
            // Accepted so existing scripts keep working, and because saying
            // so explicitly costs nothing.
            aifOwned = true
        } else if (flag.equals("--copyable-collections")) {
            // The pre-Level-4 language, where only structs were move-only.
            // Kept because it is the differential's second arm, not because
            // anything still compiles that way -- `prismio build` always
            // analyses with collections owned (see aifRun below).
            aifOwned = false
        } else if (flag.equals("--target")) {
            // The layout model is target-dependent -- a String field, a
            // reference edge, an `Isize`, a `[T]` and a `List<T>` are all one
            // pointer, and a pointer is four bytes on wasm32. Without this
            // the model could only ever be inspected for the host, while
            // `prismio build --target` compiled against a different one.
            if (aifArg + 1 >= cli_arg_count()) {
                diag_error_code("P1031", "`--target` requires an LLVM target triple (e.g. wasm32-unknown-unknown)")
                return 1
            }
            if (targetSelect(cli_arg(aifArg + 1)) == false) {
                diag_error_code("P1032", strConcat("unknown target triple ", diagQuote(cli_arg(aifArg + 1))))
                return 1
            }
            aifArg = aifArg + 1
        } else {
            diag_error_code("P1033", strConcat("unknown argument ", diagQuote(flag)))
            printUsage()
            return 1
        }
        aifArg = aifArg + 1
    }

    return aifCommand(cli_arg(2), aifSummary, aifOwned, aifThetaFields, aifBudgetArg,
                       aifWhy, aifLayout, aifManifest)
}

// Compiler development. The command itself selects the build mode -- there is
// no flag and no environment variable -- so one binary can build user programs
// against the installed runtime and still bootstrap against repository sources.
private fn cliBootstrap() -> Int {
    // The mode is fixed here rather than parsed: no flag turns it off, which is
    // what lets one binary build user programs against the installed runtime and
    // still bootstrap against repository sources.
    let mut path = "src/main.psm"
    let mut argIndex = 2

    if (cli_arg_count() > 2) {
        let candidate = cli_arg(2)
        // Every flag `bootstrap` accepts has to be named here too, or it
        // is taken for the source path and the build silently compiles a
        // file called `-g`.
        if (candidate.equals("-o") == false and candidate.equals("-g") == false) {
            path = candidate
            argIndex = 3
        }
    }

    let mut outputFile = compiler_default_exe_path(path)
    let mut bootstrapDebugInfo = false

    while (argIndex < cli_arg_count()) {
        let barg = cli_arg(argIndex)
        if (barg.equals("-o")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1034", "`-o` requires an output path")
                return 1
            }
            outputFile = cli_arg(argIndex + 1)
            argIndex = argIndex + 2
        } else if (barg.equals("-g")) {
            // The compiler is the largest Prismio program there is, and it
            // was the one program that could not be stepped through.
            bootstrapDebugInfo = true
            argIndex = argIndex + 1
        } else {
            diag_error_code("P1035", strConcat("unknown argument ", diagQuote(barg)))
            printUsage()
            return 1
        }
    }

    return compileSource(path, outputFile, false, true, false, false,
                          bootstrapDebugInfo, false, false)
}

fn main() -> Int {
    let mut path = ""
    let mut outputFile = ""
    let mut command = ""
    let mut runAfterBuild = false
    let mut bootstrapMode = false
    let mut verifyMode = false
    let mut jitMode = false
    let mut debugMode = false
    let mut argIndex = 0

    let hosted = dispatchToUmsHost()
    if (hosted >= 0) { return hosted }

    if (cli_arg_count() <= 1) {
        printUsage()
        return 1
    }

    let first = cli_arg(1)

    if (first.equals("--help") or first.equals("-h")) {
        printUsage()
        return 0
    }

    // Reports the LLVM actually loaded rather than the one built against, so a
    // version mismatch is visible without having to provoke it.
    if (first.equals("--version") or first.equals("-V")) { return cliVersion() }
    // Reports the hash of the runtime sources on disk. tools/package.ps1 records it
    // beside the packaged libraries so later builds can detect drift, and it keeps
    // that hash defined in exactly one place -- here, in C -- rather than
    // reimplemented in the packaging script.
    if (first.equals("runtime-hash")) { return cliRuntimeHash() }
    if (first.equals("check")) { return cliCheck() }
    // Emits the post-sema AST as JSON on stdout and stops. Produces no IR and
    // touches no codegen, so it cannot affect what `build` generates. Exists for
    // the AIF memory-model work, which analyses the real AST out-of-process.
    if (first.equals("dump-ast")) { return cliDumpAst() }
    // The memory model. `--summary` prints the tier distribution in the form
    // aif/prototype/aif.py prints it, so the two can be compared directly --
    // that comparison is the only real defence against a transfer function that
    // is subtly wrong and yields a silently wrong tier rather than a crash.
    if (first.equals("aif")) { return cliAif() }
    // Compiler development. The command itself selects the build mode -- there is no
    // flag and no environment variable -- so a single binary can build user programs
    // against the installed runtime and still bootstrap against repository sources.
    if (first.equals("bootstrap")) { return cliBootstrap() }
    // `build`, `run` and `clean` are each two commands wearing one name: with a
    // source they act on that file, and with none they act on the project
    // `build.ums` describes. What tells them apart is whether the next argument
    // names a source, and a leading `-` is a flag rather than a path -- which is
    // what lets `prismio build --release` be the project build it reads as.
    let projectMode = cli_arg_count() <= 2 or strStartsWith(cli_arg(2), "-")

    if (first.equals("init")) {
        if (cli_arg_count() > 3) {
            diag_error_code("P1036", "`init` takes at most one name")
            return 1
        }
        if (cli_arg_count() == 3) { return initUmsProject(cli_arg(2)) }
        return initUmsProject("")
    }

    if (first.equals("test")) {
        let profile = projectProfile(2)
        if (profile.equals("")) { return 1 }
        return testUmsProject(profile)
    }

    if (first.equals("clean")) {
        if (projectMode == false) {
            diag_error_code("P1037", "`clean` acts on the project and takes no source file")
            return 1
        }
        let profile = projectProfile(2)
        if (profile.equals("")) { return 1 }
        return cleanUmsProject(profile)
    }

    if (first.equals("build") or first.equals("run")) {
        if (projectMode) {
            let profile = projectProfile(2)
            if (profile.equals("")) { return 1 }
            return buildUmsProject(profile, first.equals("run"))
        }

        // `cli_arg(1)` again rather than naming `first` twice: `cli_arg` is
        // declared `alias`, so a second call is a second borrow of `argv`, where
        // a second *name* would be a move (CODE_STYLE, affine strings).
        command = cli_arg(1)
        runAfterBuild = first.equals("run")
        argIndex = 3
        path = cli_arg(2)
        if (path.equals("run") or path.equals("build")) {
            diag_error_code("P1038", "use either `build` or `run`, not both")
            return 1
        }
    } else if (strEndsWith(first, ".psm")) {
        // `prismio foo.psm` has always meant `prismio build foo.psm`, and still
        // does. Narrowed to a path-shaped argument, because the unnarrowed
        // version is what turned every mistyped command into a file that could
        // not be read: `prismio test` reported `cannot read test`, sending the
        // reader to the filesystem when the answer was the command name.
        command = "build"
        runAfterBuild = false
        path = first
        argIndex = 2
    } else {
        let projectCommand = runUmsProjectCommand(cli_arg(1), 2)
        if (projectCommand >= 0) { return projectCommand }

        // `first` is moved into `path` by the branch above, so the name is read
        // again from argv rather than reused here.
        diag_error_code("P1039", strConcat("unknown command ", diagQuote(cli_arg(1))))
        diag_note("commands: init, build, run, test, clean, check, aif, dump-ast, bootstrap, runtime-hash")
        listUmsProjectCommands()
        return 1
    }

    outputFile = compiler_default_exe_path(path)

    let mut debugInfo = false
    let mut optimized = false

    while (argIndex < cli_arg_count()) {
        let mut arg = cli_arg(argIndex)

        if (arg.equals("-o")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1040", "`-o` requires an output path")
                return 1
            }
            outputFile = cli_arg(argIndex + 1)
            argIndex = argIndex + 2
        } else if (strStartsWith(arg, "-O") and __builtin_string_len(arg) == 3) {
            // -O0..-O3. Runs LLVM's standard pipeline over the module before it
            // is written; without it the output keeps a load/store per binding.
            let level = optionOr(strParseInt(strSubstring(arg, 2, 1)), 0)
            if (level < 0 or level > 3) {
                diag_error_code("P1041", strConcat("unknown optimization level ", diagQuote(arg)))
                return 1
            }
            ir_set_opt_level(level)
            optimized = level > 0
            argIndex = argIndex + 1
        } else if (arg.equals("--target")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1042", "`--target` requires an LLVM target triple (e.g. x86_64-apple-macos)")
                return 1
            }
            // The triple is validated by LLVM rather than checked against a list
            // here: a list would be a second copy of what LLVM knows, and the
            // failure mode of a stale entry is a miscompile.
            if (targetSelect(cli_arg(argIndex + 1)) == false) {
                diag_error_code("P1043", strConcat("unknown target triple ", diagQuote(cli_arg(argIndex + 1))))
                return 1
            }
            // A contradiction rather than a combination: the JIT emits code for
            // *this* process, so a named target could only ever be ignored.
            // Silently running host code for someone who asked for wasm32 is the
            // worst of the three available behaviours.
            if (jitMode) {
                diag_error_code("P1044", "`--jit` and `--target` cannot be combined")
                diag_note("the JIT runs the module in this process, so it can only ever target the host")
                return 1
            }
            argIndex = argIndex + 2
        } else if (arg.equals("--sysroot")) {
            if (argIndex + 1 >= cli_arg_count()) {
                diag_error_code("P1045", "`--sysroot` requires a path to the target's SDK")
                return 1
            }
            compiler_set_sysroot(cli_arg(argIndex + 1))
            argIndex = argIndex + 2
        } else if (arg.equals("--verify")) {
            // SPEC 7.3. Slower and heavier by design: the mode exists to be run
            // by CI, not by users.
            verifyMode = true
            argIndex = argIndex + 1
        } else if (arg.equals("--overflow-checks")) {
            // RFC 0560's model: check in debug, wrap in release. `Int` is signed
            // 32-bit and wraps -- decided by measurement, RESULTS-int-width.md --
            // and this is what makes the wrap a diagnostic rather than a silence.
            //
            // **Off by default and it can never be otherwise.** A checked
            // operation is 5.4x-6.0x the plain one, not because the check is
            // expensive but because a branch per operation defeats vectorization
            // outright. Rust ties this to `debug-assertions`; Prismio has no
            // profile concept yet, so it is an explicit flag and the default is
            // the release answer.
            //
            // Set on the backend rather than threaded through codegen, because
            // every arithmetic site reads it and none of them decides it.
            ir_set_overflow_checks(1)
            argIndex = argIndex + 1
        } else if (arg.equals("--jit")) {
            // `run` without the clang compile and the link. Off by default and
            // scoped to `run`, so codegen and every emission path are untouched:
            // this adds a way of executing the module, not a way of producing
            // one. See ir_jit_run_main in runtime/llvm-api-backend.c.
            if (command.equals("run") == false) {
                diag_error_code("P1046", "`--jit` is only meaningful with `prismio run`")
                diag_note("`build` produces an object; there is nothing to run in this process")
                return 1
            }
            if (ir_target_is_explicit() == 1) {
                diag_error_code("P1047", "`--jit` and `--target` cannot be combined")
                diag_note("the JIT runs the module in this process, so it can only ever target the host")
                return 1
            }
            jitMode = true
            argIndex = argIndex + 1
        } else if (arg.equals("-g")) {
            // Source-level debug info, and nothing else -- not an analysis level
            // and not an optimisation setting at the Prismio end. Named `-g`
            // because that is what every compiler in the world spells it; the
            // neighbouring `--debug` is SPEC 7.1's zero-analysis level and the
            // collision of names is unfortunate and not worth renaming a
            // released flag over.
            debugInfo = true
            argIndex = argIndex + 1
        } else if (arg.equals("--debug")) {
            // SPEC 7.1/7.2's zero-analysis level. `max` is deliberately not
            // offered: with today's engine it would be byte-identical to
            // `release` -- the bounds it raises are never reached and there is no
            // monomorphization cap to raise -- and a flag whose settings cannot
            // be told apart is a check that cannot fail.
            debugMode = true
            argIndex = argIndex + 1
        } else if (strStartsWith(arg, "--force-layout=")) {
            // LAYOUT 8 selects the measured winner, so the flag has to reach the
            // path that produces something to measure.
            if (parseForceLayout(arg) == false) {
                diag_error_code("P1048", "--force-layout= takes <Type>:<hot-field-count>, e.g. Particle:8")
                return 1
            }
            argIndex = argIndex + 1
        } else {
            if (arg.equals("build") or arg.equals("run")) {
                diag_error_code("P1049", "use either `build` or `run`, not both")
                return 1
            }

            if (command.equals("build") and argIndex == 2) {
                // Re-read rather than `outputFile = arg`: that moves `arg`, and
                // move state is per name for the whole body, so the `else` below
                // would report a use of a moved value on a path that never ran.
                outputFile = cli_arg(argIndex)
                argIndex = argIndex + 1
            } else {
                diag_error_code("P1050", strConcat("unknown argument ", diagQuote(arg)))
                printUsage()
                return 1
            }
        }
    }

    return compileSource(path, outputFile, runAfterBuild, bootstrapMode, verifyMode, debugMode,
                          debugInfo, optimized, jitMode)
}
