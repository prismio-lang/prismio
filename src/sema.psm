import ast
import token
import types
import bridge
import diag

extern fn exit(code: Int)

// Forward declarations for recursive checking.
extern fn sema_expr(module: ASTNode, expr: ASTNode) -> TypeInfo
extern fn sema_statement(module: ASTNode, stmt: ASTNode, expected_return: TypeInfo)
extern fn sema_block(module: ASTNode, block: ASTNode, expected_return: TypeInfo)
extern fn sema_stmt_diverges(stmt: ASTNode) -> Bool
extern fn sema_block_diverges(block: ASTNode) -> Bool
extern fn sema_block_has_break(block: ASTNode) -> Bool

// --- structured control-flow analysis ---------------------------------------
//
// Prismio's control flow is fully structured -- no goto, no labeled break -- so
// "can control fall out of the bottom of this statement?" is answerable from the
// AST alone, without building a CFG. That is what definite-return and
// unreachable-code checking need.
//
// Both answers are deliberately conservative in the safe direction: when in
// doubt, report that control *can* fall through. That risks demanding a return
// the programmer knows is unreachable, which is an annoyance; the opposite
// error would let a function fall off its end, which is a miscompile.

fn sema_block_has_break(block: ASTNode) -> Bool {
    let mut stmt_ptr = block.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)

        if (stmt.kind == NodeKind.BREAK_STATEMENT) { return true }

        // Nested loops own their own breaks, but descending into them anyway
        // only makes this more conservative, never less.
        if (stmt.kind == NodeKind.IF_STATEMENT) {
            if (sema_block_has_break(ptr_to_node(stmt.child2))) { return true }
            if (str_equals(stmt.child3, "") == 0) {
                let else_node = ptr_to_node(stmt.child3)
                if (else_node.kind == NodeKind.IF_STATEMENT) {
                    if (sema_stmt_has_break_wrapper(else_node)) { return true }
                } else {
                    if (sema_block_has_break(else_node)) { return true }
                }
            }
        }
        if (stmt.kind == NodeKind.WHILE_STATEMENT or stmt.kind == NodeKind.LOOP_STATEMENT) {
            let mut body = ptr_to_node(stmt.child1)
            if (stmt.kind == NodeKind.WHILE_STATEMENT) { body = ptr_to_node(stmt.child2) }
            if (sema_block_has_break(body)) { return true }
        }
        if (stmt.kind == NodeKind.FOR_STATEMENT) {
            if (sema_block_has_break(ptr_to_node(stmt.child3))) { return true }
        }
        // A region is not a loop, so a `break` inside one belongs to the loop
        // enclosing it and has to be visible through the block.
        if (stmt.kind == NodeKind.REGION_STATEMENT) {
            if (sema_block_has_break(ptr_to_node(stmt.child1))) { return true }
        }
        if (stmt.kind == NodeKind.MATCH_STATEMENT) {
            let mut arm_ptr = stmt.child2
            while (str_equals(arm_ptr, "") == 0) {
                let arm = ptr_to_node(arm_ptr)
                if (sema_block_has_break(ptr_to_node(arm.child2))) { return true }
                arm_ptr = arm.next
            }
        }

        stmt_ptr = stmt.next
    }
    return false
}

// Wraps an else-if chain so the recursion above stays readable.
fn sema_stmt_has_break_wrapper(stmt: ASTNode) -> Bool {
    if (sema_block_has_break(ptr_to_node(stmt.child2))) { return true }
    if (str_equals(stmt.child3, "") == 0) {
        let else_node = ptr_to_node(stmt.child3)
        if (else_node.kind == NodeKind.IF_STATEMENT) {
            return sema_stmt_has_break_wrapper(else_node)
        }
        return sema_block_has_break(else_node)
    }
    return false
}

// True when control cannot continue past this statement.
fn sema_stmt_diverges(stmt: ASTNode) -> Bool {
    if (stmt.kind == NodeKind.RETURN_STATEMENT) { return true }
    if (stmt.kind == NodeKind.BREAK_STATEMENT) { return true }
    if (stmt.kind == NodeKind.CONTINUE_STATEMENT) { return true }

    if (stmt.kind == NodeKind.IF_STATEMENT) {
        // Only when there is an else and *both* sides diverge.
        if (str_equals(stmt.child3, "") == 1) { return false }
        let else_node = ptr_to_node(stmt.child3)
        let mut else_diverges = false
        if (else_node.kind == NodeKind.IF_STATEMENT) {
            else_diverges = sema_stmt_diverges(else_node)
        } else {
            else_diverges = sema_block_diverges(else_node)
        }
        return sema_block_diverges(ptr_to_node(stmt.child2)) and else_diverges
    }

    // A `loop` with no break never finishes. A `while` or `for` may run zero
    // times, so neither ever counts as diverging.
    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        return sema_block_has_break(ptr_to_node(stmt.child1)) == false
    }

    return false
}

fn sema_block_diverges(block: ASTNode) -> Bool {
    let mut stmt_ptr = block.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (sema_stmt_diverges(stmt)) { return true }
        stmt_ptr = stmt.next
    }
    return false
}

fn sema_fn_key(name: String) -> String {
    return str_concat("$fn$", name)
}

fn sema_mangle_type(t: TypeInfo) -> String {
    if (t.kind == TypeKind.VOID) { return "Void" }
    if (t.kind == TypeKind.INT) { return t.name }
    if (t.kind == TypeKind.FLOAT) { return "Float" }
    if (t.kind == TypeKind.BOOL) { return "Bool" }
    if (t.kind == TypeKind.CHAR) { return "Char" }
    if (t.kind == TypeKind.STRING) { return "String" }
    if (t.kind == TypeKind.PTR) { return "Ptr" }
    if (t.kind == TypeKind.STRUCT) { return str_concat("Struct_", t.name) }
    if (t.kind == TypeKind.ENUM) { return str_concat("Enum_", t.name) }
    if (t.kind == TypeKind.ARRAY) {
        if (str_equals(t.child, "") == 0) {
            return str_concat("Array_", sema_mangle_type(ptr_to_type(t.child)))
        }
        return "Array_Invalid"
    }
    if (t.kind == TypeKind.LIST) {
        if (str_equals(t.child, "") == 0) {
            return str_concat("List_", sema_mangle_type(ptr_to_type(t.child)))
        }
        return "List_Invalid"
    }
    return "Invalid"
}

fn sema_param_signature(module: ASTNode, param_ptr: String) -> String {
    let mut sig = ""
    let mut curr = param_ptr
    while (str_equals(curr, "") == 0) {
        let mut param = ptr_to_node(curr)
        let param_t = sema_annotation_type(module, ptr_to_node(param.child1))
        if (str_equals(sig, "") == 1) {
            sig = sema_mangle_type(param_t)
        } else {
            sig = str_concat(str_concat(sig, "_"), sema_mangle_type(param_t))
        }
        curr = param.next
    }
    if (str_equals(sig, "") == 1) { return "Void" }
    return sig
}

fn sema_function_symbol(module: ASTNode, fn_node: ASTNode) -> String {
    if (fn_node.kind == NodeKind.EXTERN_FUNCTION) {
        return fn_node.s1
    }
    if (str_equals(fn_node.s1, "main") == 1) {
        return "main"
    }
    return str_concat(str_concat(fn_node.s1, "__"), sema_param_signature(module, fn_node.child1))
}

// Compares the symbol cached on each node by sema_cache_function_symbols()
// rather than re-mangling. Mangling walks a function's parameter list and reads
// a type annotation per parameter, so doing it inside this loop -- which is
// itself called once per function -- made predeclaration cubic in the number of
// functions.
fn sema_function_symbol_count(module: ASTNode, symbol: String) -> Int {
    let mut count = 0
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            if (str_equals(stmt.s2, symbol) == 1) {
                count = count + 1
            }
        }
        stmt_ptr = stmt.next
    }
    return count
}

// Mangles every function's symbol once and stores it on the node, so the
// duplicate-detection passes can compare strings instead of recomputing.
fn sema_cache_function_symbols(module: ASTNode) {
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            stmt.s2 = sema_function_symbol(module, stmt)
        }
        stmt_ptr = stmt.next
    }
}

fn sema_overload_key(module: ASTNode, fn_node: ASTNode) -> String {
    return sema_fn_key(sema_function_symbol(module, fn_node))
}

fn sema_same_position(a: ASTNode, b: ASTNode) -> Bool {
    return a.file == b.file and a.line == b.line and a.col == b.col
}

// The earliest declaration whose mangled symbol is `symbol`. Used to point a
// duplicate-definition diagnostic at the definition it collides with.
fn sema_first_function_with_symbol(module: ASTNode, symbol: String) -> ASTNode {
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            if (str_equals(stmt.s2, symbol) == 1) {
                return stmt
            }
        }
        stmt_ptr = stmt.next
    }
    return create_node(NodeKind.MODULE)
}

// Sema reports and keeps going. Stopping at the first type error meant one
// diagnostic per run, so fixing a file was a sequence of edit-rebuild rounds --
// which is also why enforcing `mut` needed the check shipped as a warning first
// to collect all 75 violations at once. The decision to give up belongs to
// compile_source(), which checks diag_error_count() before running codegen.
//
// Continuing is only safe because every caller of a checking function treats an
// invalid type as "already reported" (see sema_expect_assignable) and because
// the sites that would otherwise walk a null child return early instead.
fn sema_error_at(node: ASTNode, message: String) {
    diag_error_at(node.file, node.line, node.col, node.len, message)
}

// For the few errors that belong to no particular node.
fn sema_error(message: String) {
    diag_error(message)
}

fn sema_type_error_at(node: ASTNode, context: String, expected: TypeInfo, actual: TypeInfo) {
    sema_error_at(node, str_concat(str_concat(context, ": expected "),
                  str_concat(type_display(expected), str_concat(", found ", type_display(actual)))))
}

// Both answer from the registry sema_register_named_types() fills before any
// checking runs, rather than by walking the module. The `module` parameter is
// kept so the many call sites read the same as before -- and because the
// registry is a cache of exactly what a walk of `module` would have found.
fn sema_has_struct(module: ASTNode, name: String) -> Bool {
    return ir_named_type_kind(name) == 1
}

fn sema_has_enum(module: ASTNode, name: String) -> Bool {
    return ir_named_type_kind(name) == 2
}

fn sema_register_named_types(module: ASTNode) {
    ir_reset_named_types()
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.STRUCT_DECL) { ir_declare_named_type(stmt.s1, 1) }
        if (stmt.kind == NodeKind.ENUM_DECL) { ir_declare_named_type(stmt.s1, 2) }
        stmt_ptr = stmt.next
    }
}

fn sema_annotation_type(module: ASTNode, tn: ASTNode) -> TypeInfo {
    if (tn.i1 == 1) {
        if (str_equals(tn.child1, "") == 0) {
            return type_array(sema_annotation_type(module, ptr_to_node(tn.child1)))
        }
        return type_array(type_invalid())
    }

    if (tn.i2 == 1) {
        if (str_equals(tn.child1, "") == 0) {
            return type_list(sema_annotation_type(module, ptr_to_node(tn.child1)))
        }
        return type_list(type_invalid())
    }

    if (str_equals(tn.s1, "Int") == 1) { return type_int() }
    if (str_equals(tn.s1, "Float") == 1) { return type_float() }
    if (str_equals(tn.s1, "Bool") == 1) { return type_bool() }
    if (str_equals(tn.s1, "String") == 1) { return type_string() }
    if (str_equals(tn.s1, "Char") == 1) { return type_char() }
    if (str_equals(tn.s1, "I8") == 1) { return type_i8() }
    if (str_equals(tn.s1, "I16") == 1) { return type_i16() }
    if (str_equals(tn.s1, "I64") == 1) { return type_i64() }
    if (str_equals(tn.s1, "Isize") == 1) { return type_isize() }
    if (str_equals(tn.s1, "U8") == 1) { return type_u8() }
    if (str_equals(tn.s1, "U16") == 1) { return type_u16() }
    if (str_equals(tn.s1, "U32") == 1) { return type_u32() }
    if (str_equals(tn.s1, "U64") == 1) { return type_u64() }
    if (str_equals(tn.s1, "Usize") == 1) { return type_usize() }
    if (str_equals(tn.s1, "") == 1) { return type_void() }
    if (sema_has_enum(module, tn.s1)) { return type_enum(tn.s1) }
    if (sema_has_struct(module, tn.s1)) { return type_struct(tn.s1) }

    sema_error_at(tn, str_concat("unknown type ", diag_quote(tn.s1)))
    return type_invalid()
}

fn sema_declared_return_type(module: ASTNode, ret_child: String) -> TypeInfo {
    if (str_equals(ret_child, "") == 0) {
        return sema_annotation_type(module, ptr_to_node(ret_child))
    }
    return type_void()
}

// Enum values are i32-backed (see type_enum in types.psm), and an enum variant
// expression such as `TokenType.EOF` types as plain Int (see MEMBER_ACCESS_EXPR in
// sema_expr). So an enum-typed binding compared against one of its own variants
// reads as Enum-vs-Int here, and the compiler's own AST does the mirror image:
// it stores kinds in plain Int fields (ASTNode.i1) and compares them to variants.
// Both directions are the intended, pervasive spelling, so treat Enum and Int as
// interchangeable. Only the default 32-bit `Int` qualifies — a sized integer such
// as I64 still has to match exactly.
fn sema_enum_matches_int(a: TypeInfo, b: TypeInfo) -> Bool {
    if (a.kind != TypeKind.ENUM) { return false }
    if (b.kind != TypeKind.INT) { return false }
    return str_equals(b.name, "Int") == 1
}

fn sema_types_match(expected: TypeInfo, actual: TypeInfo) -> Bool {
    if (type_equals(expected, actual)) { return true }
    if (sema_enum_matches_int(expected, actual)) { return true }
    if (sema_enum_matches_int(actual, expected)) { return true }
    return false
}

fn sema_expect_assignable(node: ASTNode, context: String, expected: TypeInfo, actual: TypeInfo) {
    // An invalid type is the *result* of an error already reported. Checking
    // against it would blame this expression for a mistake made somewhere else,
    // which is how one real error turns into a screenful of noise now that sema
    // no longer stops at the first.
    if (type_is_valid(expected) == false or type_is_valid(actual) == false) {
        return
    }
    if (sema_types_match(expected, actual) == false) {
        sema_type_error_at(node, context, expected, actual)
    }
}

fn sema_is_int_literal(e: ASTNode) -> Bool {
    return e.kind == NodeKind.LITERAL_EXPR and e.i1 == TokenType.NUMBER_LITERAL
}

// If `node` is a move-only value referenced by name, transfer ownership out of it:
// any later use of that binding becomes a "use of moved value" error.
fn sema_move_operand(node: ASTNode) {
    if (node.kind == NodeKind.IDENTIFIER_EXPR) {
        if (type_is_move_only(node_get_type(node))) {
            if (ir_is_borrowed(node.s1) == 1) {
                sema_error_at(node, str_concat("cannot move out of borrowed value ", diag_quote(node.s1)))
            }
            // Move state is tracked per name over the AST in source order, so a
            // move inside a loop body is seen once but executes on every
            // iteration. If the binding was created outside the loop, that is a
            // use-after-move -- and for drop(), a double free that crashes at
            // run time with nothing reported at compile time.
            if (ir_binding_predates_loop(node.s1) == 1) {
                sema_error_at(node, str_concat(diag_quote(node.s1), " is moved inside a loop, so the move would repeat on the next iteration"))
            }
            ir_mark_moved(node.s1)
        }
    }
}

// Type-check a value against an expected type, allowing a bare integer literal to
// take on any sized integer type (so `let x: U8 = 200` and `f(200)` type-check).
fn sema_check_value(module: ASTNode, val_node: ASTNode, expected: TypeInfo, context: String) -> TypeInfo {
    if (type_is_valid(expected) and expected.kind == TypeKind.INT and sema_is_int_literal(val_node)) {
        node_set_type(val_node, expected)
        return expected
    }

    // An array literal takes its element type from the annotation when there is
    // one, for the same reason a bare integer literal does above.
    //
    // Without this, `let x: [I64] = [1, 2]` was rejected: the elements are bare
    // integer literals, which infer as Int, so the literal typed as [Int] and
    // did not match the declared [I64] -- even though every element would have
    // coerced happily on its own had it been written `let y: I64 = 1`.
    if (type_is_valid(expected) and expected.kind == TypeKind.ARRAY
        and val_node.kind == NodeKind.ARRAY_LITERAL_EXPR
        and str_equals(expected.child, "") == 0) {
        let elem_expected = ptr_to_type(expected.child)
        let mut elem_ptr = val_node.child1
        while (str_equals(elem_ptr, "") == 0) {
            let elem = ptr_to_node(elem_ptr)
            sema_check_value(module, elem, elem_expected, context)
            elem_ptr = elem.next
        }
        node_set_type(val_node, expected)
        return expected
    }
    let actual = sema_expr(module, val_node)
    sema_expect_assignable(val_node, context, expected, actual)
    return actual
}

fn sema_find_function(module: ASTNode, name: String) -> ASTNode {
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if ((stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) and str_equals(stmt.s1, name) == 1) {
            return stmt
        }
        stmt_ptr = stmt.next
    }
    return create_node(NodeKind.MODULE)
}

fn sema_arg_matches_type(module: ASTNode, arg_node: ASTNode, expected: TypeInfo) -> Bool {
    if (type_is_valid(expected) and expected.kind == TypeKind.INT and sema_is_int_literal(arg_node)) {
        return true
    }
    let actual = sema_expr(module, arg_node)
    return sema_types_match(expected, actual)
}

fn sema_signature_matches_call(module: ASTNode, fn_node: ASTNode, arg_ptr: String) -> Bool {
    let mut arg = arg_ptr
    let mut param = fn_node.child1
    while (str_equals(arg, "") == 0 and str_equals(param, "") == 0) {
        let arg_node = ptr_to_node(arg)
        let param_node = ptr_to_node(param)
        let param_t = sema_annotation_type(module, ptr_to_node(param_node.child1))
        if (sema_arg_matches_type(module, arg_node, param_t) == false) {
            return false
        }
        arg = arg_node.next
        param = param_node.next
    }
    return str_equals(arg, "") == 1 and str_equals(param, "") == 1
}

// True when the module contains a real `fn` body for `name`, as opposed to only an
// `extern fn` declaration of it.
fn sema_has_function_definition(module: ASTNode, name: String) -> Bool {
    let mut scan_ptr = module.child1
    while (str_equals(scan_ptr, "") == 0) {
        let scan = ptr_to_node(scan_ptr)
        if (scan.kind == NodeKind.FUNCTION and str_equals(scan.s1, name) == 1) {
            return true
        }
        scan_ptr = scan.next
    }
    return false
}

// `call` is only ever used to place the diagnostic; resolution itself depends
// on nothing but the name and the argument types.
fn sema_find_function_overload(module: ASTNode, call: ASTNode, name: String, arg_ptr: String) -> ASTNode {
    // Track the winner as a pointer, not an ASTNode binding: `best = stmt` would
    // move the move-only struct out of `stmt`, and the loop still needs `stmt.next`.
    let mut best_ptr = ""
    let mut match_count = 0
    let mut name_seen = false

    // parser.psm, ir.psm and sema.psm all forward-declare their mutually recursive
    // functions with `extern fn` and then define them with `fn` in the same file.
    // Both nodes carry the same name and signature, so counting both would report
    // every such call as an ambiguous overload. Once a real definition exists the
    // extern is only its forward declaration, so skip it -- generate_module()
    // applies the same rule when deciding whether to emit a `declare`.
    let definition_exists = sema_has_function_definition(module, name)

    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        let mut is_candidate = stmt.kind == NodeKind.FUNCTION
        if (stmt.kind == NodeKind.EXTERN_FUNCTION and definition_exists == false) {
            is_candidate = true
        }
        if (is_candidate and str_equals(stmt.s1, name) == 1) {
            name_seen = true
            if (sema_signature_matches_call(module, stmt, arg_ptr)) {
                best_ptr = stmt_ptr
                match_count = match_count + 1
            }
        }
        stmt_ptr = stmt.next
    }

    // Each of these used to fall through to the next, which was harmless only
    // because sema_error exited. Now that it returns, an ambiguous call would
    // also be reported as having no matching overload and as being unknown.
    if (match_count > 1) {
        sema_error_at(call, str_concat(str_concat("ambiguous call to ", diag_quote(name)),
                                       ": more than one overload matches these arguments"))
        return ptr_to_node(best_ptr)
    }
    if (match_count == 1) {
        return ptr_to_node(best_ptr)
    }
    if (name_seen) {
        sema_error_at(call, str_concat(str_concat("no overload of ", diag_quote(name)),
                                       " accepts these argument types"))
        return create_node(NodeKind.MODULE)
    }
    sema_error_at(call, str_concat("unknown function ", diag_quote(name)))
    return create_node(NodeKind.MODULE)
}

fn sema_find_struct_field_type(module: ASTNode, at: ASTNode, struct_name: String, field_name: String) -> TypeInfo {
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.STRUCT_DECL and str_equals(stmt.s1, struct_name) == 1) {
            let mut field_ptr = stmt.child1
            while (str_equals(field_ptr, "") == 0) {
                let field = ptr_to_node(field_ptr)
                if (str_equals(field.s1, field_name) == 1) {
                    return sema_annotation_type(module, ptr_to_node(field.child1))
                }
                field_ptr = field.next
            }
        }
        stmt_ptr = stmt.next
    }

    sema_error_at(at, str_concat(str_concat("struct ", diag_quote(struct_name)),
                                 str_concat(" has no field ", diag_quote(field_name))))
    return type_invalid()
}

fn sema_enum_has_variant(module: ASTNode, enum_name: String, variant_name: String) -> Bool {
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.ENUM_DECL and str_equals(stmt.s1, enum_name) == 1) {
            let mut variant_ptr = stmt.child1
            while (str_equals(variant_ptr, "") == 0) {
                let variant = ptr_to_node(variant_ptr)
                if (str_equals(variant.s1, variant_name) == 1) {
                    return true
                }
                variant_ptr = variant.next
            }
        }
        stmt_ptr = stmt.next
    }
    return false
}

// Argument count for a builtin, counting the linked list of argument nodes.
fn sema_arg_count(arg_ptr: String) -> Int {
    let mut count = 0
    let mut curr = arg_ptr
    while (str_equals(curr, "") == 0) {
        count = count + 1
        curr = ptr_to_node(curr).next
    }
    return count
}

// Reports a builtin called with the wrong number of arguments, and answers
// whether the arity was right -- so the caller can stop before walking argument
// nodes that are not there. Every one of these checks used to report and then
// dereference the missing argument anyway, which only survived because
// sema_error exited the process.
fn sema_check_arity(call: ASTNode, name: String, arg_ptr: String, expected: Int) -> Bool {
    let actual = sema_arg_count(arg_ptr)
    if (actual == expected) { return true }

    let mut noun = " arguments, found "
    if (expected == 1) { noun = " argument, found " }
    sema_error_at(call, str_concat(str_concat(diag_quote(name), " expects "),
                  str_concat(int_to_str(expected), str_concat(noun, int_to_str(actual)))))
    return false
}

fn sema_builtin_call_type(name: String, arg_ptr: String) -> TypeInfo {
    if (str_equals(name, "print") == 1 or str_equals(name, "println") == 1) {
        return type_void()
    }
    if (str_equals(name, "print_int") == 1 or str_equals(name, "println_int") == 1) { return type_void() }
    if (str_equals(name, "print_float") == 1 or str_equals(name, "println_float") == 1) { return type_void() }
    if (str_equals(name, "print_bool") == 1 or str_equals(name, "println_bool") == 1) { return type_void() }
    if (str_equals(name, "print_char") == 1 or str_equals(name, "println_char") == 1) { return type_void() }
    if (str_equals(name, "drop") == 1) { return type_void() }

    if (str_equals(name, "list_new") == 1) { return type_list(type_invalid()) }
    if (str_equals(name, "list_len") == 1) { return type_int() }
    if (str_equals(name, "list_push") == 1) { return type_void() }
    if (str_equals(name, "list_set") == 1) { return type_void() }
    if (str_equals(name, "list_get") == 1) {
        if (str_equals(arg_ptr, "") == 0) {
            let lt = node_get_type(ptr_to_node(arg_ptr))
            if (lt.kind == TypeKind.LIST and str_equals(lt.child, "") == 0) {
                return ptr_to_type(lt.child)
            }
        }
        return type_invalid()
    }
    return type_invalid()
}

fn sema_list_element_type(lt: TypeInfo) -> TypeInfo {
    if (lt.kind == TypeKind.LIST and str_equals(lt.child, "") == 0) {
        return ptr_to_type(lt.child)
    }
    return type_invalid()
}

fn sema_check_builtin_call(module: ASTNode, call: ASTNode, name: String, arg_ptr: String) -> Bool {
    if (str_equals(name, "print") == 1 or str_equals(name, "println") == 1) {
        if (sema_check_arity(call, name, arg_ptr, 1) == false) { return true }
        sema_expr(module, ptr_to_node(arg_ptr))
        return true
    }

    // drop(x): deterministic, safe free. Consumes (moves) an owned value, so
    // use-after-drop and double-drop are caught by move tracking.
    if (str_equals(name, "drop") == 1) {
        if (sema_check_arity(call, name, arg_ptr, 1) == false) { return true }
        let mut arg = ptr_to_node(arg_ptr)
        let mut t = sema_expr(module, arg)
        if (type_is_move_only(t) == false) {
            sema_error_at(arg, str_concat("drop requires an owned (move-only) value, found ", type_display(t)))
            return true
        }
        sema_move_operand(arg)
        return true
    }

    if (str_equals(name, "list_new") == 1) {
        sema_check_arity(call, name, arg_ptr, 0)
        return true
    }
    if (str_equals(name, "list_len") == 1) {
        if (sema_check_arity(call, name, arg_ptr, 1) == false) { return true }
        let a0 = ptr_to_node(arg_ptr)
        let lt = sema_expr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            sema_error_at(a0, str_concat("list_len expects a List, found ", type_display(lt)))
        }
        return true
    }
    if (str_equals(name, "list_get") == 1) {
        if (sema_check_arity(call, name, arg_ptr, 2) == false) { return true }
        let a0 = ptr_to_node(arg_ptr)
        let lt = sema_expr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            sema_error_at(a0, str_concat("list_get expects a List, found ", type_display(lt)))
            return true
        }
        sema_check_value(module, ptr_to_node(a0.next), type_int(), "list_get index")
        return true
    }
    if (str_equals(name, "list_push") == 1) {
        if (sema_check_arity(call, name, arg_ptr, 2) == false) { return true }
        let a0 = ptr_to_node(arg_ptr)
        let lt = sema_expr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            sema_error_at(a0, str_concat("list_push expects a List, found ", type_display(lt)))
            return true
        }
        sema_check_value(module, ptr_to_node(a0.next), sema_list_element_type(lt), "list_push value")
        return true
    }
    if (str_equals(name, "list_set") == 1) {
        if (sema_check_arity(call, name, arg_ptr, 3) == false) { return true }
        let a0 = ptr_to_node(arg_ptr)
        let lt = sema_expr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            sema_error_at(a0, str_concat("list_set expects a List, found ", type_display(lt)))
            return true
        }
        let a1 = ptr_to_node(a0.next)
        sema_check_value(module, a1, type_int(), "list_set index")
        sema_check_value(module, ptr_to_node(a1.next), sema_list_element_type(lt), "list_set value")
        return true
    }

    let mut expected = type_invalid()
    if (str_equals(name, "print_int") == 1 or str_equals(name, "println_int") == 1) { expected = type_int() }
    if (str_equals(name, "print_float") == 1 or str_equals(name, "println_float") == 1) { expected = type_float() }
    if (str_equals(name, "print_bool") == 1 or str_equals(name, "println_bool") == 1) { expected = type_bool() }
    if (str_equals(name, "print_char") == 1 or str_equals(name, "println_char") == 1) { expected = type_char() }

    if (type_is_valid(expected)) {
        if (sema_check_arity(call, name, arg_ptr, 1) == false) { return true }
        let actual = sema_expr(module, ptr_to_node(arg_ptr))
        sema_expect_assignable(ptr_to_node(arg_ptr), str_concat(diag_quote(name), " argument"), expected, actual)
        return true
    }

    return false
}

fn sema_expr(module: ASTNode, expr: ASTNode) -> TypeInfo {
    if (node_has_type(expr)) {
        return node_get_type(expr)
    }

    if (expr.kind == NodeKind.LITERAL_EXPR) {
        let mut t = type_invalid()
        if (expr.i1 == TokenType.NUMBER_LITERAL) { t = type_int() }
        if (expr.i1 == TokenType.FLOAT_LITERAL) { t = type_float() }
        if (expr.i1 == TokenType.BOOL_LITERAL) { t = type_bool() }
        if (expr.i1 == TokenType.CHAR_LITERAL) { t = type_char() }
        if (expr.i1 == TokenType.STRING_LITERAL) { t = type_string() }
        node_set_type(expr, t)
        return t
    }

    if (expr.kind == NodeKind.IDENTIFIER_EXPR) {
        if (ir_has_var_type(expr.s1) == 0) {
            sema_error_at(expr, str_concat("unknown identifier ", diag_quote(expr.s1)))
            node_set_type(expr, type_invalid())
            return type_invalid()
        }
        if (ir_is_moved(expr.s1) == 1) {
            sema_error_at(expr, str_concat("use of moved value ", diag_quote(expr.s1)))
        }
        let mut t = type_from_sem_key(ir_get_var_type(expr.s1))
        node_set_type(expr, t)
        return t
    }

    // `expr as T`. Explicit conversion between scalar types -- the only way to
    // move between integer widths, or between integers and floats, at all.
    // Deliberately narrow: only conversions with an unambiguous meaning are
    // allowed, so a cast never quietly reinterprets memory.
    if (expr.kind == NodeKind.CAST_EXPR) {
        let source = ptr_to_node(expr.child1)
        let from_t = sema_expr(module, source)
        let to_t = sema_annotation_type(module, ptr_to_node(expr.child2))

        let from_scalar = from_t.kind == TypeKind.INT or from_t.kind == TypeKind.FLOAT
                          or from_t.kind == TypeKind.CHAR or from_t.kind == TypeKind.BOOL
                          or from_t.kind == TypeKind.ENUM
        // Bool is included here so the check below reports the specific reason
        // rather than falling into the generic "expected X, got Y".
        let to_scalar = to_t.kind == TypeKind.INT or to_t.kind == TypeKind.FLOAT
                        or to_t.kind == TypeKind.CHAR or to_t.kind == TypeKind.ENUM
                        or to_t.kind == TypeKind.BOOL

        // Bool converts out to a number but nothing converts *to* Bool: an
        // implicit "non-zero is true" rule is exactly the kind of silent
        // coercion this language avoids. Write `x != 0`.
        if (to_t.kind == TypeKind.BOOL) {
            sema_error_at(expr, "cannot cast to Bool; compare explicitly instead, as in `x != 0`")
            node_set_type(expr, to_t)
            return to_t
        }

        if (from_scalar == false or to_scalar == false) {
            sema_type_error_at(expr, "cast", to_t, from_t)
        }

        node_set_type(expr, to_t)
        return to_t
    }

    if (expr.kind == NodeKind.UNARY_EXPR) {
        let operand = ptr_to_node(expr.child1)
        let operand_t = sema_expr(module, operand)
        let uop = expr.s1

        if (str_equals(uop, "!") == 1) {
            sema_expect_assignable(operand, "operator `!`", type_bool(), operand_t)
            node_set_type(expr, type_bool())
            return type_bool()
        }

        if (str_equals(uop, "~") == 1) {
            if (operand_t.kind != TypeKind.INT and operand_t.kind != TypeKind.CHAR) {
                sema_error_at(operand, "unary `~` requires an integer operand")
            }
            node_set_type(expr, operand_t)
            return operand_t
        }

        if (str_equals(uop, "-") == 1) {
            if (type_is_numeric(operand_t) == false) {
                sema_error_at(operand, "unary `-` requires a numeric operand")
            }
            // Negating an unsigned value is almost always a mistake, and the
            // result is not representable in the operand's own type. Reject it
            // rather than silently wrapping.
            if (type_int_is_unsigned(operand_t)) {
                sema_error_at(operand, str_concat("cannot apply unary `-` to unsigned type ", type_display(operand_t)))
            }
            node_set_type(expr, operand_t)
            return operand_t
        }

        sema_error_at(expr, str_concat("unknown unary operator ", diag_quote(uop)))
        node_set_type(expr, type_invalid())
        return type_invalid()
    }

    if (expr.kind == NodeKind.BINARY_EXPR) {
        let left_node = ptr_to_node(expr.child1)
        let right_node = ptr_to_node(expr.child2)
        let mut left_t = sema_expr(module, left_node)
        let mut right_t = sema_expr(module, right_node)

        // Coerce a bare integer literal to the other operand's integer type so
        // mixing a sized int with a literal (e.g. `n <= 0`, `u / 7`) type-checks.
        if (left_t.kind == TypeKind.INT and right_t.kind == TypeKind.INT and type_equals(left_t, right_t) == false) {
            if (sema_is_int_literal(right_node)) {
                node_set_type(right_node, left_t)
                right_t = type_copy(left_t)
            } else if (sema_is_int_literal(left_node)) {
                node_set_type(left_node, right_t)
                left_t = type_copy(right_t)
            }
        }

        let op = expr.s1

        if (str_equals(op, "and") == 1 or str_equals(op, "or") == 1) {
            sema_expect_assignable(left_node, "boolean operator left operand", type_bool(), left_t)
            sema_expect_assignable(right_node, "boolean operator right operand", type_bool(), right_t)
            node_set_type(expr, type_bool())
            return type_bool()
        }

        if (str_equals(op, "+") == 1 or str_equals(op, "-") == 1 or str_equals(op, "*") == 1 or str_equals(op, "/") == 1) {
            if (type_is_numeric(left_t) == false) {
                sema_error_at(left_node, str_concat(str_concat("operator ", diag_quote(op)), " requires numeric operands"))
            }
            sema_expect_assignable(right_node, str_concat("operator ", diag_quote(op)), left_t, right_t)
            node_set_type(expr, left_t)
            return left_t
        }

        // Modulo follows the same rule as + - * /: the left operand drives the
        // result type, so it works on every sized integer type. Hardcoding
        // type_int() here rejected `u % 7` for any u that was not a plain Int,
        // even though codegen has always emitted the right urem/srem for it.
        // Still integer-only -- there is no frem in codegen.
        if (str_equals(op, "%") == 1) {
            if (left_t.kind != TypeKind.INT and left_t.kind != TypeKind.ENUM) {
                sema_error_at(left_node, "operator `%` requires integer operands")
            }
            sema_expect_assignable(right_node, "operator `%`", left_t, right_t)
            node_set_type(expr, left_t)
            return left_t
        }

        // Bitwise and/or/xor: integer-shaped operands of the same type.
        if (str_equals(op, "&") == 1 or str_equals(op, "|") == 1 or str_equals(op, "^") == 1) {
            if (left_t.kind != TypeKind.INT and left_t.kind != TypeKind.ENUM and left_t.kind != TypeKind.CHAR) {
                sema_error_at(left_node, str_concat(str_concat("bitwise operator ", diag_quote(op)), " requires integer operands"))
            }
            sema_expect_assignable(right_node, str_concat("operator ", diag_quote(op)), left_t, right_t)
            node_set_type(expr, left_t)
            return left_t
        }

        // Shifts. The result takes the left operand's type, and the shift amount
        // is an independent integer rather than something that has to match it.
        if (str_equals(op, "<<") == 1 or str_equals(op, ">>") == 1) {
            if (left_t.kind != TypeKind.INT and left_t.kind != TypeKind.CHAR) {
                sema_error_at(left_node, str_concat(str_concat("shift ", diag_quote(op)), " requires an integer left operand"))
            }
            if (right_t.kind != TypeKind.INT) {
                sema_error_at(right_node, str_concat(str_concat("the shift amount of ", diag_quote(op)), " must be an integer"))
            }
            node_set_type(expr, left_t)
            return left_t
        }

        if (str_equals(op, "==") == 1 or str_equals(op, "!=") == 1 or str_equals(op, "<") == 1 or str_equals(op, "<=") == 1 or str_equals(op, ">") == 1 or str_equals(op, ">=") == 1) {
            // String and struct values are pointers, so a comparison would
            // compare addresses and quietly answer "not equal" for two equal
            // strings. That was a silent wrong answer with no diagnostic -- and
            // the reason this compiler is written with str_equals(a, b) == 1
            // everywhere. Reject it and name the alternative.
            if (left_t.kind == TypeKind.STRING or right_t.kind == TypeKind.STRING) {
                sema_error_at(expr, "cannot compare String values directly; use `str_equals(a, b) == 1`")
                node_set_type(expr, type_bool())
                return type_bool()
            }
            if (left_t.kind == TypeKind.STRUCT or right_t.kind == TypeKind.STRUCT) {
                sema_error_at(expr, "cannot compare struct values directly; compare their fields")
                node_set_type(expr, type_bool())
                return type_bool()
            }

            sema_expect_assignable(right_node, str_concat("comparison ", diag_quote(op)), left_t, right_t)
            node_set_type(expr, type_bool())
            return type_bool()
        }

        sema_error_at(expr, str_concat("unknown operator ", diag_quote(op)))
        node_set_type(expr, type_invalid())
        return type_invalid()
    }

    if (expr.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(expr.child1)
        let name = callee.s1

        if (sema_check_builtin_call(module, expr, name, expr.child2)) {
            let builtin_t = sema_builtin_call_type(name, expr.child2)
            node_set_type(expr, builtin_t)
            return builtin_t
        }

        let fn_node = sema_find_function_overload(module, expr, name, expr.child2)

        let mut arg_ptr = expr.child2
        let mut param_ptr = fn_node.child1
        while (str_equals(arg_ptr, "") == 0 and str_equals(param_ptr, "") == 0) {
            let arg_node = ptr_to_node(arg_ptr)
            let param_node = ptr_to_node(param_ptr)
            let param_t = sema_annotation_type(module, ptr_to_node(param_node.child1))
            sema_check_value(module, arg_node, param_t, str_concat(diag_quote(name), " argument"))
            // Only `sink` parameters take ownership; `let`/`inout` borrow.
            if (str_equals(param_node.s2, "sink") == 1) {
                sema_move_operand(arg_node)
            }
            arg_ptr = arg_node.next
            param_ptr = param_node.next
        }

        let mut ret_t = type_void()
        if (fn_node.kind == NodeKind.FUNCTION) {
            ret_t = sema_declared_return_type(module, fn_node.child3)
            if (str_equals(name, "main") == 1) { ret_t = type_int() }
        } else {
            ret_t = sema_declared_return_type(module, fn_node.child2)
        }
        expr.s2 = sema_function_symbol(module, fn_node)
        node_set_type(expr, ret_t)
        return ret_t
    }

    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let object_node = ptr_to_node(expr.child1)
        if (object_node.kind == NodeKind.IDENTIFIER_EXPR and sema_enum_has_variant(module, object_node.s1, expr.s1)) {
            node_set_type(expr, type_int())
            return type_int()
        }

        let object_t = sema_expr(module, object_node)
        if (object_t.kind != TypeKind.STRUCT) {
            sema_error_at(object_node, str_concat("member access requires a struct value, found ", type_display(object_t)))
            node_set_type(expr, type_invalid())
            return type_invalid()
        }
        let field_t = sema_find_struct_field_type(module, expr, object_t.name, expr.s1)
        node_set_type(expr, field_t)
        return field_t
    }

    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let mut elem_ptr = expr.child1
        if (str_equals(elem_ptr, "") == 1) {
            let arr_t = type_array(type_invalid())
            node_set_type(expr, arr_t)
            return arr_t
        }

        let first_t = sema_expr(module, ptr_to_node(elem_ptr))
        elem_ptr = ptr_to_node(elem_ptr).next
        while (str_equals(elem_ptr, "") == 0) {
            let elem = ptr_to_node(elem_ptr)
            let elem_t = sema_expr(module, elem)
            sema_expect_assignable(elem, "array literal element", first_t, elem_t)
            elem_ptr = elem.next
        }

        let arr_t2 = type_array(first_t)
        node_set_type(expr, arr_t2)
        return arr_t2
    }

    if (expr.kind == NodeKind.INDEX_EXPR) {
        let array_t = sema_expr(module, ptr_to_node(expr.child1))
        let index_t = sema_expr(module, ptr_to_node(expr.child2))
        sema_expect_assignable(ptr_to_node(expr.child2), "array index", type_int(), index_t)
        if (array_t.kind != TypeKind.ARRAY) {
            sema_error_at(expr, str_concat("indexing requires an array, found ", type_display(array_t)))
            node_set_type(expr, type_invalid())
            return type_invalid()
        }
        let elem_t = ptr_to_type(array_t.child)
        node_set_type(expr, elem_t)
        return elem_t
    }

    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        if (sema_has_struct(module, expr.s1) == false) {
            sema_error_at(expr, str_concat("unknown struct ", diag_quote(expr.s1)))
            node_set_type(expr, type_invalid())
            return type_invalid()
        }
        let mut field_ptr = expr.child1
        while (str_equals(field_ptr, "") == 0) {
            let field = ptr_to_node(field_ptr)
            let mut expected = sema_find_struct_field_type(module, field, expr.s1, field.s1)
            sema_check_value(module, ptr_to_node(field.child1), expected, str_concat("struct field ", diag_quote(field.s1)))
            sema_move_operand(ptr_to_node(field.child1))
            field_ptr = field.next
        }
        let struct_t = type_struct(expr.s1)
        node_set_type(expr, struct_t)
        return struct_t
    }

    sema_error_at(expr, "unsupported expression")
    return type_invalid()
}

fn sema_statement(module: ASTNode, stmt: ASTNode, expected_return: TypeInfo) {
    if (stmt.kind == NodeKind.VARIABLE_DECL) {
        let mut var_t = type_invalid()
        let has_annotation = str_equals(stmt.child1, "") == 0
        let has_init = str_equals(stmt.child2, "") == 0

        if (has_annotation) {
            var_t = sema_annotation_type(module, ptr_to_node(stmt.child1))
        }
        if (has_init) {
            if (has_annotation) {
                sema_check_value(module, ptr_to_node(stmt.child2), var_t, str_concat("initializer for ", diag_quote(stmt.s1)))
            } else {
                var_t = sema_expr(module, ptr_to_node(stmt.child2))
            }
            sema_move_operand(ptr_to_node(stmt.child2))
        }
        // Only genuinely uninferrable declarations are reported. If there *was*
        // an annotation or an initializer, its own error has already been
        // reported and the invalid type is that error's shadow -- saying "cannot
        // infer" as well blames the declaration for a mistake in its right-hand
        // side.
        if (type_is_valid(var_t) == false) {
            if (has_annotation == false and has_init == false) {
                sema_error_at(stmt, str_concat(str_concat("cannot infer a type for ", diag_quote(stmt.s1)),
                                               "; add a type annotation or an initializer"))
            }
        }

        // This `let` binds a fresh value, so drop any moved-from state left over
        // from an earlier binding of the same name (see ir_unmark_moved).
        ir_unmark_moved(stmt.s1)
        ir_set_var_type(stmt.s1, type_sem_key(var_t))
        // i1 carries `mut` from the parser. Nothing read it before, so
        // "explicit mutability" was advertised and entirely unenforced.
        if (stmt.i1 == 1) {
            ir_mark_mutable(stmt.s1)
        }
        node_set_type(stmt, var_t)
    }

    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        let target = ptr_to_node(stmt.child1)

        // Only a direct rebinding is checked. Assigning through a struct field
        // is mutation of a heap object reached by pointer, which is a separate
        // question from whether the binding itself may be reseated.
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            if (ir_var_is_mutable(target.s1) == 0) {
                sema_error_at(target, str_concat(str_concat("cannot assign to ", diag_quote(target.s1)),
                                                 ", which is not declared `mut`"))
                diag_note("change its declaration to `let mut`")
            }
        }

        let target_t = sema_expr(module, target)
        let value_t = sema_expr(module, ptr_to_node(stmt.child2))
        sema_expect_assignable(ptr_to_node(stmt.child2), "assignment", target_t, value_t)
        sema_move_operand(ptr_to_node(stmt.child2))
    }

    if (stmt.kind == NodeKind.RETURN_STATEMENT) {
        if (str_equals(stmt.child1, "") == 0) {
            // Deliberately no sema_move_operand() here. Ownership does leave the
            // function, but move state is tracked per name for the whole function
            // body rather than per control-flow path, so marking the returned name
            // moved poisons it for every *other* path: a function with `return x`
            // in one branch and a use of `x` in another reports a bogus "use of
            // moved value" (parse_type_annotation in parser.psm does exactly this).
            // It also made `return expected` inside sema_check_value report "cannot
            // move out of borrowed value" for an ordinary borrowed parameter.
            // Nothing can use a value after it has been returned on the same path,
            // so skipping the mark loses no real diagnostic.
            sema_check_value(module, ptr_to_node(stmt.child1), expected_return, "return")

            // An array is a stack allocation (ir_array_alloca), so returning one
            // the function itself created hands back a pointer into a frame that
            // no longer exists. This compiled clean and appeared to work --
            // reading the dead frame usually still finds the values -- which is
            // the worst possible failure mode for it.
            //
            // Returning an array that came *in* as a borrowed parameter is fine:
            // the caller owns that storage and it outlives the call.
            if (expected_return.kind == TypeKind.ARRAY) {
                let returned = ptr_to_node(stmt.child1)
                let mut is_borrowed_param = false
                if (returned.kind == NodeKind.IDENTIFIER_EXPR) {
                    is_borrowed_param = ir_is_borrowed(returned.s1) == 1
                }
                if (is_borrowed_param == false) {
                    sema_error_at(returned, "cannot return an array created in this function; it lives on the stack frame that is about to be discarded")
                    diag_note("return an array that was passed in, or write into one the caller provides")
                }
            }
        } else {
            sema_expect_assignable(stmt, "return", expected_return, type_void())
        }
    }

    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) {
        if (str_equals(stmt.child1, "") == 0) {
            sema_expr(module, ptr_to_node(stmt.child1))
        }
    }

    if (stmt.kind == NodeKind.IF_STATEMENT) {
        let cond_t = sema_expr(module, ptr_to_node(stmt.child1))
        sema_expect_assignable(ptr_to_node(stmt.child1), "if condition", type_bool(), cond_t)
        sema_block(module, ptr_to_node(stmt.child2), expected_return)
        if (str_equals(stmt.child3, "") == 0) {
            let else_node = ptr_to_node(stmt.child3)
            if (else_node.kind == NodeKind.IF_STATEMENT) {
                sema_statement(module, else_node, expected_return)
            } else {
                sema_block(module, else_node, expected_return)
            }
        }
    }

    if (stmt.kind == NodeKind.WHILE_STATEMENT) {
        let cond_t2 = sema_expr(module, ptr_to_node(stmt.child1))
        sema_expect_assignable(ptr_to_node(stmt.child1), "while condition", type_bool(), cond_t2)
        ir_loop_barrier_push()
        sema_block(module, ptr_to_node(stmt.child2), expected_return)
        ir_loop_barrier_pop()
    }

    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        ir_loop_barrier_push()
        sema_block(module, ptr_to_node(stmt.child1), expected_return)
        ir_loop_barrier_pop()
    }

    // A region is an ordinary block as far as checking goes. It says nothing
    // about types or ownership -- SPEC 5.2 makes it a placement pin, and the
    // escape fact it would assert is one the analysis already has.
    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        sema_block(module, ptr_to_node(stmt.child1), expected_return)
    }

    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        let start_t = sema_expr(module, ptr_to_node(stmt.child1))
        sema_expect_assignable(ptr_to_node(stmt.child1), "for range start", type_int(), start_t)
        let end_t = sema_expr(module, ptr_to_node(stmt.child2))
        sema_expect_assignable(ptr_to_node(stmt.child2), "for range end", type_int(), end_t)
        // The loop variable belongs to the loop, not to the enclosing block.
        ir_scope_push()
        ir_set_var_type(stmt.s1, type_sem_key(type_int()))
        ir_loop_barrier_push()
        sema_block(module, ptr_to_node(stmt.child3), expected_return)
        ir_loop_barrier_pop()
        ir_scope_pop()
    }

    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        let scrut_t = sema_expr(module, ptr_to_node(stmt.child1))
        if (scrut_t.kind != TypeKind.INT and scrut_t.kind != TypeKind.ENUM) {
            sema_error_at(ptr_to_node(stmt.child1), str_concat("match scrutinee must be an integer or enum value, found ", type_display(scrut_t)))
        }
        let mut pat_expected = type_copy(scrut_t)
        if (scrut_t.kind == TypeKind.ENUM) { pat_expected = type_int() }
        let mut arm_ptr = stmt.child2
        while (str_equals(arm_ptr, "") == 0) {
            let arm = ptr_to_node(arm_ptr)
            if (str_equals(arm.s1, "_") == 0) {
                sema_check_value(module, ptr_to_node(arm.child1), pat_expected, "match pattern")
            }
            sema_block(module, ptr_to_node(arm.child2), expected_return)
            arm_ptr = arm.next
        }
    }
}

// A block is a scope: anything declared inside it stops being visible at the
// closing brace, and a `let` that repeats an outer name shadows it for the rest
// of the block rather than overwriting it.
fn sema_block(module: ASTNode, block: ASTNode, expected_return: TypeInfo) {
    ir_scope_push()

    let mut stmt_ptr = block.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        sema_statement(module, stmt, expected_return)

        // Anything after a statement control cannot continue past is dead. It
        // used to be emitted anyway, producing instructions after a terminator
        // -- invalid IR that surfaced as a confusing backend error rather than
        // as the source-level mistake it is.
        if (sema_stmt_diverges(stmt) and str_equals(stmt.next, "") == 0) {
            sema_error_at(ptr_to_node(stmt.next), "unreachable code: control cannot continue past the previous statement")
        }

        stmt_ptr = stmt.next
    }

    ir_scope_pop()
}

fn sema_predeclare_function(module: ASTNode, fn_node: ASTNode) {
    let mut ret_t = type_void()
    if (fn_node.kind == NodeKind.FUNCTION) {
        ret_t = sema_declared_return_type(module, fn_node.child3)
        if (str_equals(fn_node.s1, "main") == 1) { ret_t = type_int() }
    } else {
        ret_t = sema_declared_return_type(module, fn_node.child2)
    }
    // Already mangled and cached by sema_cache_function_symbols().
    let symbol = fn_node.s2
    let overload_key = sema_fn_key(symbol)

    // Reported against the *later* definition only, with a note pointing at the
    // one it collides with. Counting instead meant a single clash produced two
    // identical errors, neither of which said where the other definition was.
    if (sema_function_symbol_count(module, symbol) > 1) {
        let first = sema_first_function_with_symbol(module, symbol)
        // Identity by source position, not by pointer: node_to_ptr() puns a
        // pointer into a String, and str_equals is strcmp -- it would compare
        // the bytes of the two nodes rather than their addresses. Two
        // declarations cannot begin at the same file, line and column, so this
        // is exact.
        if (sema_same_position(first, fn_node) == false) {
            sema_error_at(fn_node, str_concat(str_concat("duplicate definition of ", diag_quote(fn_node.s1)),
                                              " with the same parameter types"))
            diag_note_at(first.file, first.line, first.col, first.len, "the first definition is here")
        }
    }
    ir_set_var_type(overload_key, type_sem_key(ret_t))
}

fn sema_predeclare_global(module: ASTNode, var_node: ASTNode) {
    let mut var_t = type_invalid()
    if (str_equals(var_node.child1, "") == 0) {
        var_t = sema_annotation_type(module, ptr_to_node(var_node.child1))
    }
    if (str_equals(var_node.child2, "") == 0) {
        if (type_is_valid(var_t)) {
            sema_check_value(module, ptr_to_node(var_node.child2), var_t, str_concat("initializer for global ", diag_quote(var_node.s1)))
        } else {
            var_t = sema_expr(module, ptr_to_node(var_node.child2))
        }

        // A global is emitted as an LLVM global with a static initializer, and
        // there is no pass that runs code before main. This was caught in
        // codegen, which meant it was reported without a span, after every other
        // check had passed, and only for whichever global came first.
        //
        // `-5` is fine: the parser folds a leading minus into the literal itself
        // (see parse_unary), so negative constants are still LITERAL_EXPR.
        let init = ptr_to_node(var_node.child2)
        if (init.kind != NodeKind.LITERAL_EXPR) {
            sema_error_at(init, str_concat(str_concat("global ", diag_quote(var_node.s1)),
                                           " needs a constant initializer"))
            diag_note("nothing runs before main, so a global cannot be initialized by an expression; move the computation into a function")
        }
    }
    if (type_is_valid(var_t) == false) {
        if (str_equals(var_node.child1, "") == 1 and str_equals(var_node.child2, "") == 1) {
            sema_error_at(var_node, str_concat(str_concat("cannot infer a type for global ", diag_quote(var_node.s1)),
                                               "; add a type annotation or an initializer"))
        }
    }
    ir_register_global_name(var_node.s1)
    ir_set_global_var_type(var_node.s1, type_sem_key(var_t))
    if (var_node.i1 == 1) {
        ir_mark_mutable(var_node.s1)
    }
    node_set_type(var_node, var_t)
}

fn sema_function(module: ASTNode, fn_node: ASTNode) {
    ir_clear_local_var_types()
    ir_clear_moved()
    ir_clear_borrowed()

    // Parameters live in a scope of their own, outside the body block, so the
    // body may shadow a parameter name without clobbering it.
    ir_scope_push()

    let mut expected_return = sema_declared_return_type(module, fn_node.child3)
    if (str_equals(fn_node.s1, "main") == 1) { expected_return = type_int() }

    let mut param_ptr = fn_node.child1
    while (str_equals(param_ptr, "") == 0) {
        let mut param = ptr_to_node(param_ptr)
        let param_t = sema_annotation_type(module, ptr_to_node(param.child1))
        if (str_equals(param.s2, "inout") == 1 and type_is_move_only(param_t) == false) {
            sema_error_at(param, str_concat(str_concat("inout parameter ", diag_quote(param.s1)), " must be a struct (reference) type"))
        }
        // let/inout params are non-owning borrows; sink params own their value.
        if (str_equals(param.s2, "sink") == 0) {
            ir_mark_borrowed(param.s1)
        }
        ir_set_var_type(param.s1, type_sem_key(param_t))
        node_set_type(param, param_t)
        param_ptr = param.next
    }

    if (str_equals(fn_node.child2, "") == 0) {
        let mut body = ptr_to_node(fn_node.child2)
        sema_block(module, body, expected_return)

        // Every path out of a value-returning function must return. Falling off
        // the end used to emit `ret <type> 0`, which silently returned zero for
        // an Int and produced invalid IR (`ret ptr 0`) for anything pointer-
        // shaped.
        if (expected_return.kind != TypeKind.VOID) {
            if (sema_block_diverges(body) == false) {
                sema_error_at(fn_node, str_concat(str_concat("function ", diag_quote(fn_node.s1)),
                              str_concat(str_concat(" must return ", type_display(expected_return)),
                                         " on every path, but control can reach its closing brace")))
            }
        }
    }

    ir_scope_pop()
}

// FFI ownership contracts (aif/spec/FFI.md 5), checked where they are written.
//
// FFI 1 is blunt about why this matters: an `extern` contract describes opaque
// foreign code and cannot be verified, so **the FFI boundary is the one place in
// AIF where being wrong is unsafe rather than slow.** Nothing downstream can
// catch a `retain_in(9)` on a two-argument function or an `alias` on a
// parameter; the analysis would read a contract that means nothing and quietly
// apply a default instead. So the declaration is the only place these can be
// rejected, and they are rejected here rather than warned about.
fn sema_contract_name(encoded: String) -> String {
    let at = str_index_of(encoded, ":")
    if (at < 0) {
        return encoded
    }
    return str_substring(encoded, 0, at)
}

fn sema_contract_argument(encoded: String) -> String {
    let at = str_index_of(encoded, ":")
    if (at < 0) {
        return ""
    }
    return str_substring(encoded, at + 1, str_length(encoded) - at - 1)
}

fn sema_is_parameter_contract(name: String) -> Bool {
    if (str_equals(name, "borrow") == 1) { return true }
    if (str_equals(name, "retain") == 1) { return true }
    if (str_equals(name, "retain_in") == 1) { return true }
    if (str_equals(name, "consume") == 1) { return true }
    if (str_equals(name, "out") == 1) { return true }
    return false
}

fn sema_check_extern_contracts(ext_node: ASTNode) {
    // Counted first: `retain_in(k)` names another parameter by index, so the
    // arity has to be known before any of them can be checked.
    let mut arity = 0
    let mut count_ptr = ext_node.child1
    while (str_equals(count_ptr, "") == 0) {
        let param = ptr_to_node(count_ptr)
        if (param.kind == NodeKind.FUNCTION_PARAMETER) {
            arity = arity + 1
        }
        count_ptr = param.next
    }

    let mut index = 0
    let mut param_ptr = ext_node.child1
    while (str_equals(param_ptr, "") == 0) {
        let param = ptr_to_node(param_ptr)
        if (param.kind == NodeKind.FUNCTION_PARAMETER and str_equals(param.child1, "") == 0) {
            let annotation = ptr_to_node(param.child1)
            let encoded = annotation.s2

            if (str_equals(encoded, "") == 0) {
                let name = sema_contract_name(encoded)

                if (sema_is_parameter_contract(name) == false) {
                    diag_error_at(param.file, param.line, param.col, str_length(param.s1),
                        str_concat(str_concat(diag_quote(name),
                                   " is a return contract and cannot appear on parameter "),
                                   diag_quote(param.s1)))
                    diag_note("parameters take `borrow`, `retain`, `retain_in(k)`, `consume` or `out`")
                } else if (str_equals(name, "retain_in") == 1) {
                    let target = str_to_int(sema_contract_argument(encoded))
                    if (target < 0 or target >= arity) {
                        diag_error_at(param.file, param.line, param.col, str_length(param.s1),
                            str_concat(str_concat("`retain_in` names argument ",
                                       sema_contract_argument(encoded)),
                                       str_concat(", but this function takes ", int_to_str(arity))))
                        diag_note("the index is zero-based and names the container this argument is stored into")
                    } else if (target == index) {
                        diag_error_at(param.file, param.line, param.col, str_length(param.s1),
                            str_concat(str_concat("`retain_in` on ", diag_quote(param.s1)),
                                       " names itself"))
                        diag_note("it names the *other* argument this one is stored into; a value cannot contain itself")
                    }
                }
            }
            index = index + 1
        }
        param_ptr = param.next
    }

    if (str_equals(ext_node.child2, "") == 0) {
        let ret = ptr_to_node(ext_node.child2)
        if (str_equals(ret.s2, "") == 0) {
            let name = sema_contract_name(ret.s2)
            if (str_equals(name, "alias") == 0 and str_equals(name, "produce") == 0) {
                diag_error_at(ext_node.file, ext_node.line, ext_node.col, str_length(ext_node.s1),
                    str_concat(diag_quote(name),
                               " is a parameter contract and cannot appear on a return type"))
                diag_note("returns take `alias` or `produce(free_fn)`")
            } else if (str_equals(name, "produce") == 1) {
                if (str_equals(sema_contract_argument(ret.s2), "") == 1) {
                    diag_error_at(ext_node.file, ext_node.line, ext_node.col, str_length(ext_node.s1),
                        "`produce` requires the name of the function that releases the value")
                    diag_note("FFI 5.2: calling `free` on something from a custom allocator is the bug this prevents")
                }
            }
        }
    }
}

fn analyze_module(module: ASTNode) {
    ir_clear_var_types()
    ir_reset_globals()

    // Both of these must run before anything is checked. The first lets a type
    // annotation be resolved without walking the module; the second mangles each
    // function's symbol once instead of once per comparison. Together they take
    // predeclaration from cubic to quadratic in the number of declarations.
    sema_register_named_types(module)
    sema_cache_function_symbols(module)

    let mut fn_ptr = module.child1
    while (str_equals(fn_ptr, "") == 0) {
        let stmt = ptr_to_node(fn_ptr)
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            sema_predeclare_function(module, stmt)
        }
        if (stmt.kind == NodeKind.EXTERN_FUNCTION) {
            sema_check_extern_contracts(stmt)
        }
        fn_ptr = stmt.next
    }

    let mut global_ptr = module.child1
    while (str_equals(global_ptr, "") == 0) {
        let stmt2 = ptr_to_node(global_ptr)
        if (stmt2.kind == NodeKind.VARIABLE_DECL) {
            sema_predeclare_global(module, stmt2)
        }
        global_ptr = stmt2.next
    }

    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt3 = ptr_to_node(stmt_ptr)
        if (stmt3.kind == NodeKind.FUNCTION) {
            sema_function(module, stmt3)
        }
        stmt_ptr = stmt3.next
    }
}
