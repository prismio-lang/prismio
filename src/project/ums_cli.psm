// The project verbs: `init`, and `build`, `run`, `test` and `clean` with no
// source named -- the commands that act on the project `build.ums` describes.
//
// UMS owns what a manifest means; this file owns what the CLI does with it.
// Routing a command to a project's own compiler is project/host.psm, and running
// a command the manifest declares is project/commands.psm.

import std.io
import common.diagnostics
import std.string
import std.option
import std.process
import driver.compile
import ums.ums
import ums.model.workspace
import ums.model.diagnostic
import ums.model.validation
import ums.targets.target
import ums.dependency.resolve
import common.target
import project.host
import project.commands
import std.fs

public extern fn compiler_default_exe_path(sourcePath: String) -> String produce(free)
public extern fn compiler_is_current_executable(path: String borrow) -> Int
public extern fn compiler_is_hosted() -> Int
// A target's linker and native-compile inputs, recorded one at a time and
// cleared by compiler_link_reset. Paths reach this boundary already resolved
// against the manifest root; the C driver quotes every argument before it builds
// a command.
public extern fn compiler_link_file(path: String borrow) -> Int
public extern fn compiler_link_framework(name: String borrow) -> Int
public extern fn compiler_link_library(name: String borrow) -> Int
public extern fn compiler_link_reset()
public extern fn compiler_link_response_file(path: String borrow) -> Int
public extern fn compiler_link_search(path: String borrow) -> Int
public extern fn compiler_native_define(definition: String borrow) -> Int
public extern fn compiler_native_flag(flag: String borrow) -> Int
public extern fn compiler_native_include(directory: String borrow) -> Int
public extern fn compiler_native_response_file(path: String borrow) -> Int
public extern fn compiler_native_source(path: String borrow) -> Int
public extern fn compiler_set_export_dynamic(on: Int)
public extern fn compiler_set_installed_runtime(on: Int)
public extern fn compiler_link_flag(flag: String borrow) -> Int
public extern fn compiler_set_freestanding(on: Int)
public extern fn ir_set_freestanding(on: Int)
public extern fn ir_set_no_red_zone(on: Int)
public extern fn ir_set_target_features(features: String borrow) -> Int
public extern fn ir_set_code_model(name: String borrow) -> Int
// Everything under a directory except the running executable; see
// runtime/build_driver.c.
public extern fn compiler_remove_tree(path: String borrow) -> Int
public extern fn host_is_windows() -> Int
// `file_exists` opens the path, and opening a directory fails on Windows, so a
// directory is asked about with this one: `clean` reported "nothing to remove"
// for a profile directory that was there.
// The writer half of the filesystem surface, for `init`. Both return 0 for
// success, which is the C convention here and the opposite of `file_exists`;
// std/fs.psm normalises that for applications, and this file cannot import it
// because the two would declare the same symbols twice.

public fn pathLeaf(path: String) -> String {
    let mut cut = path.lastIndexOf('/')
    let back = path.lastIndexOf('\\')
    if (back > cut) { cut = back }
    if (cut < 0) { return path.clone() }
    return path.substring(cut + 1, __builtin_string_len(path) - cut - 1)
}

// `prismio init [name]` -- a project in the current directory, or in a new one.
//
// One command rather than Cargo's `new` plus `init`: the only difference between
// them is whether a directory is created first, and that is what the optional
// argument says. It leaves the word `new` free, which matters because `new`
// means *project* everywhere else and would be a trap on anything else.
//
// **Nothing is written if anything would be overwritten.** The manifest is
// checked for first, and its presence ends the command -- re-running `init` in a
// project is a mistake, not a request to reset it.
public fn initUmsProject(nameArg: String) -> Int {
    let mut root = "."
    let mut name = ""
    if (nameArg.equals("")) {
        name = pathLeaf(currentDirectory())
    } else {
        root = nameArg.clone()
        name = nameArg.clone()
    }

    // Rejected by UMS's own rule rather than a copy of it, so a name this writes
    // is a name the validator accepts -- the scaffold cannot be born invalid.
    if (umsValidName(name) == false) {
        diag_error_code("P1013", "cannot use ".concat(diagQuote(name), " as a project name"))
        diag_note("a name starts with a letter, a digit or `_`, and may hold those plus `-` and `.`")
        diag_note("run `prismio init <name>` to choose one")
        return 1
    }

    let manifestPath = joinPath(root, "build.ums")
    if (fileExists(manifestPath)) {
        diag_error_code("P1014", manifestPath.concat(" already exists"))
        return 1
    }

    if (makeDirectory(joinPath(root, "src")) == false) {
        diag_error_code("P1015", "could not create ".concat(joinPath(root, "src")))
        return 1
    }

    let manifest = "project {\n    name = \"".concat(name)
    let manifestBody = manifest.concat("\"\n    version = \"0.1.0\"\n    prismio = \"",
                                       PRISMIO_VERSION,
                                       "\"\n}\n\ntargets {\n    executable(\"",
                                       name)
    let manifestText = manifestBody.concat("\") {\n        entry = \"src/main.psm\"\n    }\n}\n")
    if (writeFile(manifestPath, manifestText) == false) {
        diag_error_code("P1016", "could not write ".concat(manifestPath))
        return 1
    }

    let entryPath = joinPath(joinPath(root, "src"), "main.psm")
    if (fileExists(entryPath) == false) {
        if (writeFile(entryPath,
                "import std.io\n\nfn main() -> Int {\n    println(\"Hello, Prismio!\")\n    return 0\n}\n") == false) {
            diag_error_code("P1017", "could not write ".concat(entryPath))
            return 1
        }
    }

    // `.prismio/` is build output, and a project that commits it ships one
    // machine's binaries. Written only when absent, so an existing ignore file
    // is never rewritten from under its author.
    let ignorePath = joinPath(root, ".gitignore")
    if (fileExists(ignorePath) == false) {
        if (writeFile(ignorePath, ".prismio/\n") == false) {
            diag_error_code("P1018", "could not write ".concat(ignorePath))
            return 1
        }
    }

    diag_styled("ok", "created ")
    diag_styled("heading", name)
    println("")
    print("  ")
    diag_styled("dim", manifestPath)
    println("")
    print("  ")
    diag_styled("dim", entryPath)
    println("")
    print("  ")
    diag_styled("dim", ignorePath)
    println("")
    println("")
    print("build it with `")
    if (nameArg.equals("")) {
        diag_styled("command", "prismio run")
    } else {
        diag_styled("command", "cd ".concat(nameArg, " && prismio run"))
    }
    println("`")
    return 0
}

public fn umsNativePath(root: String, value: String) -> String {
    let length = __builtin_string_len(value)
    if (length > 0 and (value.charAt(0) == '/' or
        value.charAt(0) == '\\')) {
        return value.clone()
    }
    if (length > 1 and value.charAt(1) == ':') {
        return value.clone()
    }
    return joinPath(root, value)
}

// Hands one target's native inputs to the driver: what it links, the C it
// compiles, whether it merges the installed runtime and whether it exports its
// symbols. Cleared first, because a project may build several executables in
// one compiler process and native inputs belong to exactly the target that
// declared them. Every path is resolved against the manifest's directory.
private fn configureUmsTargetLink(root: String, target: UmsTarget) -> Int {
    compiler_link_reset()
    let mut failed = 0
    for i in 0..<target.links.length {
        let input = target.links[i]
        match (input.kind) {
            UmsLinkKind.LIBRARY => {
                failed = failed + compiler_link_library(input.value)
            }
            UmsLinkKind.SEARCH => {
                failed = failed + compiler_link_search(umsNativePath(root, input.value))
            }
            UmsLinkKind.FILE => {
                failed = failed + compiler_link_file(umsNativePath(root, input.value))
            }
            UmsLinkKind.FRAMEWORK => {
                failed = failed + compiler_link_framework(input.value)
            }
            UmsLinkKind.RESPONSE_FILE => {
                failed = failed + compiler_link_response_file(umsNativePath(root, input.value))
            }
            UmsLinkKind.SCRIPT => {
                failed = failed + compiler_link_flag("-T")
                failed = failed + compiler_link_flag(umsNativePath(root, input.value))
            }
            UmsLinkKind.ARG => {
                failed = failed + compiler_link_flag(input.value)
            }
        }
    }
    for i in 0..<target.natives.length {
        let input = target.natives[i]
        match (input.kind) {
            UmsNativeKind.SOURCE => {
                failed = failed + compiler_native_source(umsNativePath(root, input.value))
            }
            UmsNativeKind.INCLUDE => {
                failed = failed + compiler_native_include(umsNativePath(root, input.value))
            }
            UmsNativeKind.DEFINE => {
                failed = failed + compiler_native_define(input.value)
            }
            UmsNativeKind.FLAG => {
                failed = failed + compiler_native_flag(input.value)
            }
            UmsNativeKind.RESPONSE_FILE => {
                failed = failed + compiler_native_response_file(umsNativePath(root, input.value))
            }
        }
    }
    if (target.runtime.equals("none")) {
        compiler_set_installed_runtime(0)
    }
    if (target.exportDynamic) {
        compiler_set_export_dynamic(1)
    }
    // Everything a bare-metal target changes is set here and cleared the same way for
    // the next one: a project may build a kernel and a host tool in one process, and
    // the triple, the feature string and the red zone belong to the target that
    // declared them. A target with no triple is the host.
    compiler_set_freestanding(0)
    ir_set_freestanding(0)
    ir_set_no_red_zone(0)
    ir_set_target_features("")
    ir_set_code_model("default")
    targetSelect("")
    if (target.triple.equals("") == false) {
        if (targetSelect(target.triple) == false) {
            diag_error_code("P1097", "unknown target triple ".concat(diagQuote(target.triple)))
            return 1
        }
    }
    if (target.freestanding) {
        compiler_set_freestanding(1)
        ir_set_freestanding(1)
    }
    if (target.noRedZone) { ir_set_no_red_zone(1) }
    if (target.features.equals("") == false) {
        failed = failed + ir_set_target_features(target.features)
    }
    if (target.codeModel.equals("") == false) {
        failed = failed + ir_set_code_model(target.codeModel)
    }
    if (failed != 0) {
        diag_error_code("P1058", "could not prepare native linker inputs")
        return 1
    }
    return 0
}

// How the selected profile builds: the manifest's `profiles` block applied over
// the defaults -- `debug` with `-g` and overflow checks, `release` with neither.
public fn umsProfileOptions(workspace: UmsWorkspace) -> CompileOptions {
    let options = compileOptions()
    options.debugInfo = workspace.project.build.debugInfo
    options.overflowChecks = workspace.project.build.overflowChecks
    return options
}

// Builds one declared target the way every project command builds it.
//
// A target whose output is the configured `toolchain.host` is the compiler
// running this command, or the one the launcher runs next, so it is staged and
// promoted rather than written over (project/host.psm).
public fn buildUmsTarget(workspace: UmsWorkspace, target: UmsTarget) -> Int {
    if (configureUmsTargetLink(workspace.project.root, target) != 0) {
        return 1
    }
    let options = umsProfileOptions(workspace)
    options.installedRuntime = target.runtime.equals("none") == false
    if (isUmsHostTarget(workspace, target)) {
        return buildUmsHostTarget(workspace, target, options)
    }
    return compileSource(target.sourcePath, target.outputPath, options)
}

// What a project verb was asked for, once its arguments are read: the profile,
// the targets named, and where the program's own arguments start (after `--`,
// for `run`; -1 when there are none).
struct ProjectRequest {
    valid: Bool,
    profile: String,
    names: Vec<String>,
    programArgumentsFrom: Int
}

// `--release`, target names, and for `run` a `--` after which everything is the
// program's. Anything else starting with `-` is a flag this command does not
// take, and is reported as that rather than taken for a name.
public fn projectRequest(startIndex: Int, verb: String) -> ProjectRequest {
    let request = ProjectRequest {
        valid: true,
        profile: "debug".clone(),
        names: [],
        programArgumentsFrom: -1
    }
    for i in startIndex..<process.args.count {
        if (request.programArgumentsFrom >= 0) { break }
        let argument = process.args[i]
        if (argument.equals("--release")) {
            request.profile = "release".clone()
        } else if (argument.equals("--")) {
            if (verb.equals("run") == false) {
                diag_error_code("P1084", "`--` passes arguments to the program `run` starts, and `".concat(
                                         verb, "` starts none"))
                request.valid = false
                return request
            }
            request.programArgumentsFrom = i + 1
        } else if (argument.startsWith("-")) {
            diag_error_code("P1019", "unknown argument ".concat(diagQuote(argument)))
            if (verb.equals("run")) {
                diag_note("arguments for the program go after `--`: `prismio run -- ".concat(argument, "`"))
            } else {
                diag_note("a project command takes `--release` and target names")
            }
            request.valid = false
            return request
        } else if (verb.equals("clean")) {
            diag_error_code("P1085", "`clean` acts on the whole profile and takes no target")
            request.valid = false
            return request
        } else if (verb.equals("run") and request.names.length > 0) {
            diag_error_code("P1087", "`run` runs one target, and was given two")
            diag_note("arguments for the program go after `--`: `prismio run ".concat(
                      request.names[0], " -- ", argument, "`"))
            request.valid = false
            return request
        } else {
            request.names.push(argument.clone())
        }
    }
    return request
}

// Whether `prismio = "X.Y"` asks for a newer compiler than this one. Compared
// component by component; a missing patch reads as 0.
private fn prismioRequirementMet(required: String) -> Bool {
    let wanted = required.split(".")
    let have = PRISMIO_VERSION.split(".")
    for i in 0..<3 {
        let mut want = 0
        let mut got = 0
        if (i < wanted.length) { want = wanted[i].parseInt().unwrapOr(0) }
        if (i < have.length) { got = have[i].parseInt().unwrapOr(0) }
        if (want > got) { return false }
        if (want < got) { return true }
    }
    return true
}

// The checks a loaded, valid manifest still has to pass before this compiler
// acts on it: the names only the CLI knows are reserved, and the version of
// Prismio the project says it needs. Each prints its own diagnostic.
public fn umsProjectUsable(workspace: UmsWorkspace) -> Bool {
    if (workspace.valid == false) {
        umsDiagnosticsPrint(workspace.diagnostics)
        return false
    }
    if (rejectReservedCommandNames(workspace) != 0) { return false }
    let required = workspace.project.metadata.prismioVersion
    if (prismioRequirementMet(required) == false) {
        diag_error_code("P1078", "this project needs Prismio ".concat(required,
                                 ", and this compiler is ", PRISMIO_VERSION))
        diag_note("install a newer Prismio, or lower `prismio` in build.ums if the project does not need it")
        return false
    }
    return true
}

// The index of the target called `name`, having said so when there is none.
private fn requireTarget(workspace: UmsWorkspace, name: String) -> Int {
    let index = umsTargetFind(workspace.project.targets, name)
    if (index >= 0) { return index }
    diag_error_code("P1080", "this project declares no target named ".concat(diagQuote(name)))
    let mut names = ""
    for i in 0..<workspace.targetCount() {
        if (i > 0) { names = names.concat(", ") }
        names = names.concat(workspace.target(i).name)
    }
    diag_note("declared targets: ".concat(names))
    return -1
}

// A resolved path dependency is recorded in the lockfile and is not yet on the
// import search, so a manifest that declares one would otherwise build as if it
// worked -- until the first import of it failed with nothing pointing here.
private fn warnUnusedDependencies(workspace: UmsWorkspace) {
    if (workspace.project.dependencies.length == 0) { return }
    diag_warning_code("P1081", "dependencies are resolved and locked, but Prismio 0.1 does not import from them yet")
    diag_note("vendor the source beneath your entry module and import it by its dotted path")
}

// `prismio build [target...]` and `prismio run [target] [-- args...]`.
public fn buildUmsProject(request: ProjectRequest, runAfterBuild: Bool) -> Int {
    if (request.valid == false) { return 1 }
    let workspace = umsLoadProject(".", request.profile)
    if (umsProjectUsable(workspace) == false) { return 1 }

    // v0.1 3.7. Dependencies are resolved and recorded before a single target is
    // compiled, because a build that half-succeeds and then reports an unresolved
    // dependency has already written artifacts against a tree it could not
    // describe.
    //
    // The lockfile is written **before** the failure check, not after it. A failed
    // resolve is exactly the case a reader wants the file for -- it records what
    // was asked for and that it did not resolve, which is the difference between
    // "the lockfile is stale" and "the fetch has nothing behind it".
    let mut resolveDiagnostics = umsDiagnostics()
    let resolutions = workspace.project.resolveDependencies(resolveDiagnostics)
    if (workspace.project.writeLockfile(resolutions) == false) {
        diag_error_code("P1082", "could not write prismio.lock")
        return 1
    }
    if (resolveDiagnostics.length > 0) {
        umsDiagnosticsPrint(resolveDiagnostics)
        return 1
    }
    warnUnusedDependencies(workspace)

    // The targets this build is for: the ones named, or every target except the
    // tests, for the reason `cargo build` does not build tests -- the ordinary
    // build is the one a developer runs constantly, and paying for the test
    // programs every time is a cost with no reader. `prismio test` builds them.
    let mut selected: Vec<Int> = []
    if (request.names.length > 0) {
        for i in 0..<request.names.length {
            let index = requireTarget(workspace, request.names[i])
            if (index < 0) { return 1 }
            selected.push(index)
        }
    } else {
        for i in 0..<workspace.targetCount() {
            if (workspace.target(i).kind != UmsTargetKind.TEST) { selected.push(i) }
        }
    }

    let mut executables = 0
    let mut firstExecutable = 0
    for i in 0..<selected.length {
        let target = workspace.target(selected[i])
        if (buildUmsTarget(workspace, target) != 0) { return 1 }
        if (target.kind == UmsTargetKind.EXECUTABLE) {
            if (executables == 0) { firstExecutable = selected[i] }
            executables = executables + 1
        }
    }

    if (runAfterBuild == false) { return 0 }

    // Every target is built before anything is run, so `run` on a project whose
    // library target does not compile fails rather than running a stale binary
    // that happens to be next to it.
    if (executables == 0) {
        if (request.names.length > 0) {
            diag_error_code("P1086", diagQuote(request.names[0]).concat(" is not an executable target"))
        } else {
            diag_error_code("P1021", "this project declares no executable target to run")
            diag_note("add `executable(\"name\") { entry = \"src/main.psm\" }` to build.ums")
        }
        return 1
    }
    if (executables > 1) {
        diag_error_code("P1022", "this project declares more than one executable target")
        diag_note("name the one to run: `prismio run <target>`")
        return 1
    }

    // The program's own status is the command's, with nothing added: `run` is a
    // way of starting it, and a program that exits 3 has said what it meant to.
    let target = workspace.target(firstExecutable)
    if (request.programArgumentsFrom >= 0) {
        for i in request.programArgumentsFrom..<process.args.count {
            compiler_spawn_arg(process.args[i])
        }
    }
    let status = compiler_spawn_wait(target.outputPath, "")
    if (status < 0) {
        diag_error_code("P1023", "could not start ".concat(target.outputPath))
        return 1
    }
    return status
}

// `prismio test [name...]` -- build the test targets, then run them.
//
// **A test passes when it exits 0.** That is the entire protocol, and it is
// deliberate: Prismio has no assertion library and no test attribute, so
// inventing a richer contract here would be a promise the language cannot keep.
// It is also what `tests/test_runner.py` already does for the compiler's own
// suite, so a project's tests and the compiler's are checked the same way.
//
// Every test is built before any is run, and every test runs even after one
// fails -- a run that stops at the first failure tells you about one test when
// you asked about all of them. A test that does not build is a failed test, not
// the end of the run. Each runs from the project root, where the manifest's
// relative paths -- and a test's fixtures -- are.
public fn testUmsProject(request: ProjectRequest) -> Int {
    if (request.valid == false) { return 1 }
    let workspace = umsLoadProject(".", request.profile)
    if (umsProjectUsable(workspace) == false) { return 1 }

    let mut selected: Vec<Int> = []
    if (request.names.length > 0) {
        for i in 0..<request.names.length {
            let index = requireTarget(workspace, request.names[i])
            if (index < 0) { return 1 }
            if (workspace.target(index).kind != UmsTargetKind.TEST) {
                diag_error_code("P1088", diagQuote(request.names[i]).concat(" is not a test target"))
                return 1
            }
            selected.push(index)
        }
    } else {
        for i in 0..<workspace.targetCount() {
            if (workspace.target(i).kind == UmsTargetKind.TEST) { selected.push(i) }
        }
    }

    if (selected.length == 0) {
        println("no test targets declared")
        diag_note("add `test(\"name\") { entry = \"tests/name.psm\" }` to build.ums")
        return 0
    }

    let mut built: Vec<Bool> = []
    for i in 0..<selected.length {
        built.push(buildUmsTarget(workspace, workspace.target(selected[i])) == 0)
    }

    print("running ")
    print(selected.length)
    println(" test(s)")

    let mut passed = 0
    let mut failed = 0
    for i in 0..<selected.length {
        let target = workspace.target(selected[i])
        if (built[i] and compiler_spawn_wait(target.outputPath, workspace.project.root) == 0) {
            diag_styled("ok", "  ok    ")
            println(target.name)
            passed = passed + 1
        } else {
            diag_styled("fail", "  FAIL  ")
            print(target.name)
            if (built[i] == false) { print("  (did not build)") }
            println("")
            failed = failed + 1
        }
    }

    diag_styled("ok", passed.toString().concat(" passed"))
    print(", ")
    if (failed > 0) {
        diag_styled("fail", failed.toString().concat(" failed"))
    } else {
        print(failed)
        print(" failed")
    }
    println("")
    if (failed > 0) { return 1 }
    return 0
}

// Remove what this profile's build wrote: the whole profile directory, tools and
// all -- not a list of the planned targets, which is what it used to delete,
// leaving every `.psm` tool a command had built.
//
// When the project's own compiler lives in this profile, its runtime and
// standard library beside the profile directories go with it: they are the rest
// of that toolchain, and useless without it. A hosted `clean` is that compiler,
// so its binary stays for the launcher to delete once this process has exited.
//
// The lockfile is deliberately left alone. It records what was resolved, not
// what was built, and `cargo clean` does not remove `Cargo.lock` either.
public fn cleanUmsProject(profile: String) -> Int {
    let workspace = umsLoadProject(".", profile)
    if (umsProjectUsable(workspace) == false) { return 1 }

    let profileRoot = joinPath(workspace.plan.artifactRoot, profile)
    let mut removed: Vec<String> = []
    if (directoryExists(profileRoot)) {
        if (compiler_remove_tree(profileRoot) != 0) {
            diag_error_code("P1020", "could not remove everything under ".concat(profileRoot))
            return 1
        }
        removed.push(profileRoot.clone())
    }

    let host = workspace.project.toolchain.host
    if (__builtin_string_len(host) > 0 and
        directoryOf(umsHostExecutable(workspace.project.root, host)).equals(profileRoot)) {
        let toolchainLib = joinPath(workspace.plan.artifactRoot, "lib")
        let toolchainStd = joinPath(workspace.plan.artifactRoot, "stdlib")
        if (directoryExists(toolchainLib) and compiler_remove_tree(toolchainLib) == 0) {
            removed.push(toolchainLib)
        }
        if (directoryExists(toolchainStd) and compiler_remove_tree(toolchainStd) == 0) {
            removed.push(toolchainStd)
        }
    }

    if (removed.length == 0) {
        print("nothing to remove for ")
        println(profile)
        return 0
    }
    for i in 0..<removed.length {
        print("removed ")
        println(removed[i])
    }
    return 0
}
