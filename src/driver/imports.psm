// Import resolution: a module name to a merged declaration chain.
//
// Two questions, and the module exists to answer them: where a module name
// lives on disk, and whether it has already been merged. Getting the second
// wrong emits duplicate LLVM `define` lines that llc rejects a long way from
// the import that caused them -- mergeNamedModule says what a diamond-shaped
// import graph does without the memo.
//
// The surface is `resolveImports`, `libraryRoot` and `standardModulePath`. The other fifteen
// functions and the merge-tail cache are private to this file.

import symbols.declarations
import symbols.library
import std.io
import lexer.scanner
import lexer.token
import common.text
import ast.nodes
import ast.types
import parse.*
import ir.*
import sema.*
import driver.derived_impls
import ums.model.workspace
import common.diagnostics
import common.source_files
import std.string
import std.fs
import std.core.vec
import std.platform
import common.native
import common.diag_codes
import common.lang_items
import ast.lang_marks
import ast.module_header
import common.prelude_needs
import index.lowered

// The last statement appended to the module being merged. Reset with the module
// in resolveImports(); see appendStatement() for why it is a cache rather than
// the list's only tail.
// Zero-initialized rather than assigned: a global cannot be initialized by a
// call, and a zero-filled pointer is NULL, which is the empty cache this wants.
let mut mergeTailPtr: Ptr

// `check --overlay`: an editor's unsaved text for files of the program, any number of them.
// Wherever the merge reads an overlaid path -- as the entry or as a module some import
// reaches -- it reads that overlay's text file instead, so the file keeps its own path, its
// diagnostics name it, and an import cycle back to it is the file already merged rather
// than a second copy. Parallel columns; a zero-filled global `Vec` is not an empty one, hence
// `overlaysOpened`.
let mut overlayPaths: Vec<String>
let mut overlayFiles: Vec<String>
let mut overlayReads: Vec<Bool>
let mut overlaysOpened = false

private fn overlaysOpen() {
    if (overlaysOpened) { return }
    overlayPaths = []
    overlayFiles = []
    overlayReads = []
    overlaysOpened = true
}

// A path as read from the working directory, so one file named relatively on
// one side of a comparison and absolutely on the other is still one file.
// `./` is dropped; `..` is not resolved, and a path spelled with it is compared
// as written.
private fn absolutePath(path: String) -> String {
    let mut relative = path.clone()
    while (relative.startsWith("./") or relative.startsWith(".\\")) {
        relative = relative.substring(2, relative.length - 2)
    }
    if (relative.startsWith("/") or relative.startsWith("\\")) { return relative }
    if (relative.length > 1 and relative.charAt(1) == ':') { return relative }
    return joinPath(currentDirectory(), relative)
}

// The key an overlay is kept and found by. On Windows one file is spelled `C:\work\a.psm`, `c:/work/a.psm` and
// `C:/work/a.psm` (the compiler's own joins, an editor's URI, a manifest), so the overlay of one is the text of the
// others; elsewhere a backslash is a character of a name and the path is its own key.
private fn overlayKey(path: String) -> String {
    let absolute = absolutePath(path)
    if (platform.isWindows == false) { return absolute }
    let key = absolute.replaceAll("\\", "/")
    if (key.length > 1 and key.charAt(1) == ':') { return key.charAt(0).toUpper().toString().concat(key.slice(1, key.length)) }
    return key.clone()
}

// `check --module`: the name the entry file is known by when it is a module
// checked on its own -- `std.core.map` for std/core/map.psm -- which is what gives it its
// package's access to that package's internals. "" for a program.
let mut entryModuleName = ""

public fn setEntryModuleName(name: String) {
    entryModuleName = name.clone()
}

public fn entryModule() -> String {
    return entryModuleName.clone()
}

// `textFile` holds the text to read wherever the program reads `path`. Overlaying a path
// twice keeps the later text.
public fn addSourceOverlay(path: String, textFile: String) {
    overlaysOpen()
    let absolute = overlayKey(path)
    for i in 0..<overlayPaths.length {
        if (overlayPaths[i].equals(absolute)) {
            overlayFiles[i] = textFile.clone()
            overlayReads[i] = false
            return
        }
    }
    overlayPaths.push(absolute)
    overlayFiles.push(textFile.clone())
    overlayReads.push(false)
}

// Whether the program read the overlaid file at all: one it never imports was
// not checked, and the caller has to say so rather than report it clean.
public fn sourceOverlayRead(path: String) -> Bool {
    overlaysOpen()
    let absolute = overlayKey(path)
    for i in 0..<overlayPaths.length {
        if (overlayPaths[i].equals(absolute)) { return overlayReads[i] }
    }
    return false
}

public fn readSource(path: String) -> String {
    overlaysOpen()
    if (overlayPaths.length > 0) {
        let absolute = overlayKey(path)
        for i in 0..<overlayPaths.length {
            if (overlayPaths[i].equals(absolute)) {
                overlayReads[i] = true
                return readFile(overlayFiles[i])
            }
        }
    }
    return readFile(path)
}

// Two same-named top-level declarations of the same kind are duplicates, with one
// exception: FUNCTION. Overloading means several `fn` nodes legitimately share a
// name (tests/test_29_overloads.psm), and a genuinely duplicated overload has to
// survive the merge so sema can reject it (tests/neg_06_duplicate_overload.psm).
//
// EXTERN_FUNCTION is deliberately *not* exempt. Modules each declare the externs
// they use, so `str_equals` is declared by both utils.psm and keywords.psm, and
// `exit` by both parser.psm and sema.psm; merging both copies makes sema report a
// spurious "duplicate function overload". Keeping the first is correct.
//
// This does not disturb the forward-declaration idiom in ir.psm/parser.psm/
// sema.psm, where an `extern fn` declares a function the same file also defines:
// that pairs an EXTERN_FUNCTION with a FUNCTION, so the kind check above already
// treats them as distinct (and generateModule skips the `declare` when a real
// `define` exists).

// EXTERN_VARIABLE is exempt too, for a reason of its own: `mut` belongs to
// each declaration rather than to the symbol. One module may only read `optind`
// while another assigns it, and keeping whichever merged first would decide
// that for both. Sema checks that the declarations agree on the type.
private fn sameTopLevelName(a: ASTNode, b: ASTNode) -> Bool {
    if (a.kind != b.kind) { return false }
    if (a.s1.equals(b.s1) == false) { return false }
    if (a.kind == NodeKind.FUNCTION or a.kind == NodeKind.EXTERN_VARIABLE) {
        return false
    }
    // Two externs of one name are one declaration when their parameters are written alike
    // (every module that uses `exit` declares it), and two overloads when they are not: C has
    // one symbol, and a kernel header's `foo(int)` and `foo(const char *)` are both callable.
    if (a.kind == NodeKind.EXTERN_FUNCTION) {
        return externSignature(a).equals(externSignature(b))
    }
    return true
}

// The parameters of an `extern fn` as written: each one's type name, its flags and its
// ownership word, so `put(a: Int)` and `put(a: String borrow)` differ and two copies of
// `exit(code: Int)` do not.
private fn externSignature(fnNode: ASTNode) -> String {
    let mut out = ""
    let mut p = fnNode.child1
    while (nodeExists(p)) {
        let param = ptr_to_node(p)
        let mut written = ""
        if (nodeExists(param.child1)) {
            let annotation = ptr_to_node(param.child1)
            written = annotation.s1.concat("/", annotation.i1.toString(), "/", annotation.i2.toString(),
                                           "/", annotation.i3.toString())
        }
        out = out.concat(written, ":", param.s2, ",")
        p = param.next
    }
    return out
}

// Asks the declaration index, which appendStatement() keeps current as it
// merges, rather than rescanning everything merged so far. The scan was
// quadratic in the number of declarations and ran before sema -- this compiler's
// own source merges about 1 500 of them.
private fn hasNamedTopLevel(module: ASTNode, stmt: ASTNode) -> Bool {
    if (isNamedTopLevel(stmt) == false) {
        return false
    }

    let count = ir_decl_count(stmt.s1)
    for i in 0..<count {
        let scan = ptr_to_node(ir_decl_at(stmt.s1, i))
        if (sameTopLevelName(scan, stmt)) {
            return true
        }
    }

    return false
}

internal fn parseSource(content: String, file: Int) -> ASTNode {
    let lex = Lexer.create(content, file)
    let headToken = lex.allTokens()
    let p = parserCreate(headToken)
    return parseModule(p)
}

internal fn appendStatement(module: ASTNode, stmt: ASTNode) {
    if (isExternDecl(stmt)) {
        ir_extern_decl_record(stmt.file, stmt.s1, stmt.i2)
    }
    if (hasNamedTopLevel(module, stmt)) {
        return
    }

    if (nodeIsNull(module.child1)) {
        module.child1 = node_to_ptr(stmt)
        mergeTailPtr = node_to_ptr(stmt)
        indexTopLevel(stmt)
        return
    }

    // Walking to the end per statement made merging quadratic. The cached tail
    // is a shortcut, not a second source of truth: when it is empty -- a module
    // that was appended to by something other than this function -- the walk it
    // replaced still runs, once, and the cache picks up from there.
    if (nodeIsNull(mergeTailPtr)) {
        mergeTailPtr = module.child1
        let mut searching = true
        while (searching) {
            let scan = ptr_to_node(mergeTailPtr)
            if (nodeIsNull(scan.next)) {
                searching = false
            } else {
                mergeTailPtr = scan.next
            }
        }
    }

    let tail = ptr_to_node(mergeTailPtr)
    tail.next = node_to_ptr(stmt)
    mergeTailPtr = node_to_ptr(stmt)
    indexTopLevel(stmt)
}

// A dotted module name is a directory path: `ir.expr` becomes `ir/expr`.
//
// '/' is emitted unconditionally because the frontend has no way to ask what the
// host's separator is; join_path normalises the joined result.
private fn moduleRelativePath(moduleName: String) -> String {
    let mut relative = ""
    let length = moduleName.length
    for i in 0..<length {
        let c = moduleName.charAt(i)
        if (c == '.') {
            relative = relative.concat("/")
        } else {
            relative = relative.concat(c.toString())
        }
    }
    return relative
}

// Everything an import names is resolved against the directory of the file being
// compiled, not against the importing module -- so a module path means the same
// thing written anywhere in the tree. The `.` case exists because there is
// nothing to join to.
private fn resolveUnder(baseDir: String, relative: String) -> String {
    if (baseDir.equals(".")) {
        return relative
    }
    return joinPath(baseDir, relative)
}

// Compiler subsystems normally live below src/, which is also the source root.
// UMS and the language server are deliberately different: first-class toolchain
// subsystems beside src/, not compiler implementation. Reserving the `ums` and `lsp`
// import roots lets the self-hosted CLI consume them without a mirror, symlink, or C
// bridge. The rule is narrow on purpose so ordinary user module resolution remains
// relative to the entry source exactly as before.
private fn isReservedRoot(moduleName: String) -> Bool {
    return moduleName.equals("ums") or moduleName.startsWith("ums.")
        or moduleName.equals("lsp") or moduleName.startsWith("lsp.")
}

private fn importBaseDir(baseDir: String, moduleName: String) -> String {
    if (isReservedRoot(moduleName)) {
        return directoryOf(baseDir)
    }
    return baseDir
}

private fn joinImportPath(baseDir: String, moduleName: String) -> String {
    return resolveUnder(importBaseDir(baseDir, moduleName),
                        moduleRelativePath(moduleName).concat(".psm"))
}

private fn joinImportDir(baseDir: String, packageName: String) -> String {
    return resolveUnder(importBaseDir(baseDir, packageName), moduleRelativePath(packageName))
}

// Memo key for an already-resolved module. Paths are wrapped in "|" so that a
// substring search can never match a partial path (e.g. "src\ir.psm" must not be
// found inside "src\dir.psm").
private fn importMemoKey(importPath: String) -> String {
    return "|".concat(importPath, "|")
}

// Resolves one named module into `merged`, unless it has already been resolved.
//
// Resolving each path once is what keeps a diamond-shaped import graph correct:
// src/main.psm reaches common/text.psm through five distinct paths, and without
// this every one of that module's functions and extern declarations would be
// merged five times, emitting duplicate LLVM `define`/`declare` lines that llc
// rejects outright ("invalid redefinition of function"). Marking a path before
// recursing into it also makes an import cycle terminate instead of recursing
// forever.
//
// `site` is the import that asked, and is only used to place the diagnostic.
private fn mergeNamedModule(merged: ASTNode, site: ASTNode, moduleName: String,
                      baseDir: String, visited: String) -> String {
    if (moduleName.equals("build")) {
        return mergeBuildModule(merged, site, baseDir, visited)
    }
    if (refuseSealedModule(site, moduleName)) { return visited }
    let importPath = resolveImportPath(baseDir, moduleName)

    // v0.1 3.5, selective imports. `import std.string.strTrim` names a *name*
    // and not a module, and nothing but resolution can tell the two apart --
    // `std.string` could equally hold a `strTrim.psm`, and then the same text
    // means the module. So the full path is tried first and this is the
    // fallback, which is where Kotlin settles the same ambiguity and for the
    // same reason: a grammar cannot see the filesystem.
    //
    // The record goes in before the memo check below, not after. A module is
    // merged once however many files import it, so a second file selecting from
    // an already-merged module would otherwise take everything.
    if (fileExists(importPath) == false) {
        // A directory with no file of its name is its modules: `import std.io` reads `std/io/*`
        // when there is no `std/io.psm`, exactly as `import std.io.*` does. A file and a
        // directory of one name coexist, and then the name means the file alone.
        let directory = resolvePackageDirectory(baseDir, moduleName)
        if (listModules(directory).length > 0) {
            return mergePackageDirectory(merged, site, moduleName, directory, baseDir, visited)
        }
        let cut = moduleName.lastIndexOf(".")
        if (cut > 0) {
            let parent = moduleName.substring(0, cut)
            let selected = moduleName.substring(cut + 1, moduleName.length - cut - 1)
            if (parent.equals("build") or fileExists(resolveImportPath(baseDir, parent))) {
                ir_import_record(site.file, parent)
                ir_select_record(site.file, parent, selected)
                return mergeNamedModule(merged, site, parent, baseDir, visited)
            }
            let members = listModules(resolvePackageDirectory(baseDir, parent))
            if (members.length > 0) {
                return mergePackageSelection(merged, site, parent, members, selected, baseDir, visited)
            }
        }
    }

    let key = importMemoKey(importPath)
    if (visited.contains(key)) {
        checkRecordedTier(site, moduleName, key)
        return visited
    }

    let seen = visited.concat(key)

    let mut content = ""
    if (importPath.endsWith(".plib")) {
        // A freestanding program for a triple the library was not packaged for compiles the module
        // from the source the PLIB carries, with the program, as a source library does.
        if (compiler_is_freestanding() == 1 and compiler_plib_covers_target(importPath, moduleName) == 0) {
            content = compiler_plib_interface(importPath, moduleName)
        } else {
            content = compiler_plib_import(importPath, moduleName)
        }
        if (content.equals("")) {
            // Its own code, not P1001's. A `.plib` that will not open is a
            // broken *installation* and the note below says to reinstall; a
            // P1001 next to it is a source file the program named and does not
            // have, which the programmer fixes in their own tree. One code for
            // both sent every "reinstall Prismio" reader looking for a typo in
            // an import they wrote correctly.
            diag_error_at_code(DIAG_DRIVER_STANDARD_LIBRARY_MODULE_INVALID, site.file, site.line, site.col, site.len,
                "compiled standard-library module ".concat(diagQuote(moduleName),
                    " is missing, incompatible, or corrupted: ", compiler_plib_error()))
            diag_note("reinstall Prismio and try again")
            diag_note_dropped_everything()
            return seen
        }
    } else {
        content = readSource(importPath)
    }
    if (content.equals("") and fileExists(importPath) == false) {
        diag_error_at_code(DIAG_DRIVER_IMPORT_UNREADABLE, site.file, site.line, site.col, site.len,
            "cannot read imported module ".concat(diagQuote(moduleName),
                                                  ": no such file ",
                                                  importPath))
        diag_note_dropped_everything()
        return seen
    }

    // Registered before parsing so every token from this file carries an id that
    // resolves back to its text, long after the merge has erased which module a
    // declaration came from.
    let file = diag_add_file(importPath, content)
    if (file < 0) {
        diag_error_at_code(DIAG_DRIVER_TOO_MANY_SOURCE_FILES, site.file, site.line, site.col, site.len,
            "this program reads more than ".concat(DIAG_MAX_FILES.toString(),
                " source files; ", diagQuote(moduleName), " was not read"))
        diag_note_dropped_everything()
        return seen
    }
    // ...and the name it was reached by, which the id alone cannot recover: the
    // installed layout stores `std/string.psm` as `stdlib/string.plib`, so a
    // qualifier derived from the path would differ between a checkout and an
    // install. Every module arrives here with its logical path already built --
    // mergePackageImport composes `pkg.leaf` before calling -- so this one line
    // covers named and package imports both.
    diag_set_file_module(file, moduleName)
    if (resolvedFromLibrary(moduleName, importPath)) { markFileFromLibraryRoot(file) }
    let parsed = parseSource(content, file)
    importTierRecord(key, file)
    if (refuseImportTier(site, moduleName, diag_file_header(file), fileFromLibraryRoot(file))) { return seen }
    return mergeModuleImports(merged, parsed, baseDir, seen)
}

// `import build`: the values in build.ums, as a module that is never a file.
//
// `build` is a reserved root, like `ums` and `lsp`, and a project module of that
// name is refused rather than shadowed: two meanings for one import is how a
// version number ends up wrong in a release. The manifest is found from the
// directory of the file being compiled, upward, as every project verb finds it.
// The text is parsed like any module's, under the manifest's path, so a program
// reads `BUILD_VERSION` as it reads any other global; ums/model/build_module.psm
// says which.
private fn mergeBuildModule(merged: ASTNode, site: ASTNode, baseDir: String,
                      visited: String) -> String {
    let key = importMemoKey("<build>")
    if (visited.contains(key)) { return visited }
    let seen = visited.concat(key)

    if (fileExists(joinImportPath(baseDir, "build")) or
        listModules(joinImportDir(baseDir, "build")).length > 0) {
        diag_error_at_code(DIAG_DRIVER_BUILD_MODULE_RESERVED, site.file, site.line, site.col, site.len,
            "`build` is reserved for the values in build.ums, and this project has a module of that name")
        diag_note("rename that module: `import build` always means the manifest")
        diag_note_dropped_everything()
        return seen
    }

    let loaded = umsLoadBuildModule(absolutePath(baseDir))
    if (loaded.problem.length > 0) {
        diag_error_at_code(DIAG_DRIVER_BUILD_MODULE_INVALID, site.file, site.line, site.col, site.len,
            "`import build` needs a valid build.ums: ".concat(loaded.problem))
        diag_note_dropped_everything()
        return seen
    }

    let file = diag_add_file(joinPath(directoryOf(loaded.manifestPath), "<build>"), loaded.source)
    if (file < 0) {
        diag_error_at_code(DIAG_DRIVER_BUILD_MODULE_TOO_MANY_FILES, site.file, site.line, site.col, site.len,
            "this program reads more than ".concat(DIAG_MAX_FILES.toString(),
                " source files; `build` was not read"))
        diag_note_dropped_everything()
        return seen
    }
    diag_set_file_module(file, "build")
    return mergeModuleImports(merged, parseSource(loaded.source, file), baseDir, seen)
}

// `import pkg.*` -- every module directly inside `pkg`, in the order
// listModules sorted them.
//
// Non-recursive, like Kotlin's: a nested package is a separate import. A
// directory with no modules in it is an error rather than a no-op, because the
// only ways to reach it are a typo in the package name and a package that has
// been emptied, and both are worth hearing about.
private fn mergePackageImport(merged: ASTNode, site: ASTNode, baseDir: String,
                        visited: String) -> String {
    return mergePackageDirectory(merged, site, site.s1, resolvePackageDirectory(baseDir, site.s1),
                                 baseDir, visited)
}

// The modules of one package directory, each merged as the import of its own qualified name.
// `packageName` is what the program wrote: `import std.io` when no `std/io.psm` exists and
// `std/io/` does is this too, since a directory with no file of its name *is* its modules.
private fn mergePackageDirectory(merged: ASTNode, site: ASTNode, packageName: String, dirPath: String,
                        baseDir: String, visited: String) -> String {
    let modules = listModules(dirPath)

    if (modules.length == 0) {
        diag_error_at_code(DIAG_DRIVER_PACKAGE_HAS_NO_MODULES, site.file, site.line, site.col, site.len,
            "package ".concat(diagQuote(packageName), " contains no modules: ", dirPath))
        diag_note_dropped_everything()
        return visited
    }

    let mut seen = visited
    for name in modules {
        let qualified = packageName.concat(".", name)
        ir_import_record(site.file, qualified)
        seen = mergeNamedModule(merged, site, qualified, baseDir, seen)
    }
    return seen
}

// `import std.io.println` where `std.io` is a package: the name is selected from every module of
// the package, since the program cannot know which of them declares it. A module that does not
// declare it contributes nothing, and a name no module declares fails where it is used.
private fn mergePackageSelection(merged: ASTNode, site: ASTNode, packageName: String, members: Vec<String>,
                        selected: String, baseDir: String, visited: String) -> String {
    let mut seen = visited
    for name in members {
        let qualified = packageName.concat(".", name)
        ir_import_record(site.file, qualified)
        ir_select_record(site.file, qualified, selected)
        seen = mergeNamedModule(merged, site, qualified, baseDir, seen)
    }
    return seen
}

// Walks `module`, appending its non-import declarations into the shared `merged`
// accumulator and resolving each import it carries. `visited` threads the set of
// already-resolved paths through the recursion and is returned so sibling
// imports see what earlier ones resolved.
// `import std.io as io`, checked once here because this is the only place that
// knows whether the path names a module at all.
//
// Two shapes are rejected rather than accepted and ignored. A **duplicate** alias
// in one file would otherwise resolve to whichever import the merge happened to
// reach first, which is a rule nobody can read off the source. A **selective**
// import -- `import std.string.strTrim`, whose path is a function inside a module
// -- would bind the alias to something that is not a module, and every later
// `trim.f(x)` would report "no module `trim`" pointing at the call rather than at
// the import that could not work.
private fn recordImportAlias(stmt: ASTNode, baseDir: String) {
    if (stmt.s2.equals("")) { return }

    let existing = ir_import_alias_target(stmt.file, stmt.s2)
    if (existing.equals("") == false) {
        diag_error_at_code(DIAG_DRIVER_IMPORT_ALIAS_TAKEN, stmt.file, stmt.line, stmt.col, stmt.len,
            "the name ".concat(diagQuote(stmt.s2), " is already bound to ",
                               diagQuote(existing), " in this file"))
        diag_note("one `as` name per file: give this import a different one")
        return
    }

    if (stmt.s1.equals("build") == false and
        fileExists(resolveImportPath(baseDir, stmt.s1)) == false) {
        diag_error_at_code(DIAG_DRIVER_IMPORT_ALIAS_NOT_A_MODULE, stmt.file, stmt.line, stmt.col, stmt.len,
            "`as` names a module, and ".concat(diagQuote(stmt.s1), " is not one"))
        diag_note("a selective import names one declaration inside a module; drop the `as`, or alias the module it comes from")
        return
    }

    // An alias that is *itself* a module name in this project makes every
    // `name.f(x)` ambiguous, and the alias would win silently -- leaving the real
    // module unreachable by its own name and reporting the mismatch at the call,
    // which is the one place the cause is not.
    //
    // Tested against the tree rather than against what this file imports, so the
    // answer does not depend on which import the merge reached first. Rejecting a
    // name the file could have imported and did not is the conservative half of
    // that trade, and the fix is to pick another name.
    if (fileExists(resolveImportPath(baseDir, stmt.s2))) {
        diag_error_at_code(DIAG_DRIVER_IMPORT_ALIAS_IS_A_MODULE, stmt.file, stmt.line, stmt.col, stmt.len,
            diagQuote(stmt.s2).concat(" is already the name of a module, so it cannot also be an alias"))
        diag_note("`".concat(stmt.s2, ".f(x)` would have two meanings here; choose a name no module in this project has"))
        return
    }

    ir_import_alias_record(stmt.file, stmt.s2, stmt.s1)
}

// What each module read says in its header, and whether it is the library's, by memo key, so that a
// module imported again is checked without being read again.
let mut importTierKeys: Vec<String>
let mut importTierHeaders: Vec<Int>
let mut importTierLibrary: Vec<Bool>

private fn importTiersReset() {
    importTierKeys = []
    importTierHeaders = []
    importTierLibrary = []
}

private fn importTierRecord(key: String, file: Int) {
    importTierKeys.push(key.clone())
    importTierHeaders.push(diag_file_header(file))
    importTierLibrary.push(fileFromLibraryRoot(file))
}

private fn checkRecordedTier(site: ASTNode, moduleName: String, key: String) {
    for i in 0..<importTierKeys.length {
        if (importTierKeys[i].equals(key)) {
            let ignored = refuseImportTier(site, moduleName, importTierHeaders[i], importTierLibrary[i])
            return
        }
    }
}

// A module's header says what it needs (ast/module_header.psm), and the claim is checked at every
// import: a module may import only modules that need no more than it does. A `--freestanding`
// program has no C library and no operating system, so a library module that needs one is refused
// at the import -- left to fail later it was a page of undefined symbols from the linker -- and one
// that needs the runtime's allocator brings the freestanding runtime into the link.
//
// Answers whether it refused. The module is then not merged, so the rest of the program is still
// read and its own errors still reported.
private fn refuseImportTier(site: ASTNode, moduleName: String, flags: Int, fromLibrary: Bool) -> Bool {
    let tier = headerTier(flags)
    let importerTier = headerTier(diag_file_header(site.file))
    if (importerTier < 2 and tier > importerTier) {
        diag_error_at_code(DIAG_DRIVER_MODULE_TIER, site.file, site.line, site.col, site.len,
            "this module is `".concat(headerTierWords(importerTier), "`, so it cannot import ",
                diagQuote(moduleName), ", which is ", headerTierWords(tier)))
        diag_note_dropped_everything()
        return true
    }
    if (compiler_is_freestanding() != 1 or fromLibrary == false) { return false }
    if (tier == 2) {
        diag_error_at_code(DIAG_DRIVER_FREESTANDING_IMPORT_REFUSED, site.file, site.line, site.col, site.len,
            diagQuote(moduleName).concat(" cannot be imported by a `--freestanding` program"))
        diag_note("a library module without a `module freestanding` header needs an operating system or a C library")
        diag_note_dropped_everything()
        return true
    }
    if (tier == 1) { compiler_use_freestanding_runtime() }
    return false
}

// An entry of `import {a, b} from dir` names a file, never a declaration
// (parseImportGroup marks it with `i2`). Refused here because only resolution
// can see the difference: `import {Option} from std.core.option` would otherwise
// reach mergeNamedModule's selective-import fallback and quietly select a name.
// An entry that names nothing at all falls through to P1001's "no such file".
// Answers whether it refused, like refuseImportTier.
private fn refuseGroupDeclaration(stmt: ASTNode, baseDir: String) -> Bool {
    if (stmt.i2 != 1) { return false }
    if (fileExists(resolveImportPath(baseDir, stmt.s1))) { return false }
    let cut = stmt.s1.lastIndexOf(".")
    let directory = stmt.s1.substring(0, cut)
    if (fileExists(resolveImportPath(baseDir, directory)) == false) { return false }
    diag_error_at_code(DIAG_DRIVER_IMPORT_GROUP_NAMES_DECLARATION, stmt.file, stmt.line, stmt.col, stmt.len,
        "an import group names modules, and ".concat(diagQuote(stmt.s1), " is a declaration inside ",
                                                     diagQuote(directory)))
    diag_note("select a declaration with its own import: `import ".concat(stmt.s1, "`"))
    diag_note_dropped_everything()
    return true
}

// The module paths the library had before 0.3, each followed by where it is now. An import of an old
// path reads the new one and warns. Temporary: the table goes in the release after.
private fn renamedModules() -> String {
    return "|std.input std.io.input|std.poll std.io.poll|std.display std.fmt.display|".concat(
        "std.number_text std.fmt.number|std.json std.encoding.json|std.option std.core.option|",
        "std.tuple std.core.tuple|std.eq std.core.eq|std.ord std.core.ord|std.iter std.core.iter|",
        "std.copy std.core.copy|std.default std.core.default|std.key std.core.key|std.vec std.core.vec|",
        "std.map std.core.map|std.raw std.sys.raw|std.asm std.sys.asm|std.port std.sys.port|",
        "std.syscall std.sys.syscall|std.errno std.sys.errno|")
}

// Where `moduleName`, or the module a selective import names a declaration of, is now; "" when it
// has not moved.
private fn renamedModule(moduleName: String) -> String {
    if (moduleName.startsWith("std.") == false) { return "".clone() }
    let table = renamedModules()
    let mut old = moduleName.clone()
    let mut rest = "".clone()
    loop {
        let at = table.indexOf("|".concat(old, " "))
        if (at >= 0) {
            let start = at + old.length + 2
            let end = table.indexOf("|", start)
            return table.substring(start, end - start).concat(rest)
        }
        let cut = old.lastIndexOf(".")
        if (cut <= 3) { return "".clone() }
        rest = old.substring(cut, old.length - cut).concat(rest)
        old = old.substring(0, cut)
    }
}

// An import of a path the library had before: read as the path it has now, with a warning.
private fn followRename(stmt: ASTNode) {
    let now = renamedModule(stmt.s1)
    if (now.equals("")) { return }
    diag_warning_at_code(DIAG_DRIVER_MODULE_RENAMED, stmt.file, stmt.line, stmt.col, stmt.len,
        diagQuote(stmt.s1).concat(" is now ", diagQuote(now)))
    diag_note("the old path is removed in the next release")
    stmt.s1 = now
}

// A module whose path has a segment that begins with `_` is sealed: only modules under that
// segment's parent may import it (`std._unicode.case` from `std.*`, `app.net._wire.frame` from
// `app.net.*`). The rule reads off the path, as Go's `internal/` does, so the import site shows
// which side of the boundary it is on.
//
// Answers whether it refused, like refuseImportTier.
private fn refuseSealedModule(site: ASTNode, moduleName: String) -> Bool {
    let importer = importerModule(site.file)
    let segments = moduleName.split(".")
    let mut parent = "".clone()
    for i in 0..<segments.length {
        if (segments[i].startsWith("_") and moduleIsUnder(importer, parent) == false) {
            diag_error_at_code(DIAG_DRIVER_MODULE_SEALED, site.file, site.line, site.col, site.len,
                diagQuote(moduleName).concat(" is sealed inside ", diagQuote(parent)))
            diag_note("a module whose path has a segment that begins with `_` can be imported only from the modules under that segment's parent")
            diag_note_dropped_everything()
            return true
        }
        if (i > 0) { parent = parent.concat(".") }
        parent = parent.concat(segments[i])
    }
    return false
}

// The module a file is known by: the name it was reached as, or the one `check --module` gave
// the entry. "" for a program's own entry file, which sits at the root of its tree.
private fn importerModule(file: Int) -> String {
    let module = diag_file_module(file)
    if (module.equals("") and entryModuleName.equals("") == false) { return entryModuleName.clone() }
    return module.clone()
}

// Whether `module` is `parent` or a module below it. Everything is under the root, "".
private fn moduleIsUnder(module: String, parent: String) -> Bool {
    if (parent.equals("")) { return true }
    return module.equals(parent) or module.startsWith(parent.concat("."))
}

// An import the parser wrote for a library item (a tuple brings in the module that declares the tuple
// types) names `$lang.<id>`; the library says which module that is. False after reporting that it says none.
private fn resolveLangImport(stmt: ASTNode) -> Bool {
    if (stmt.s1.startsWith("$lang.") == false) { return true }
    let id = stmt.s1.substring(6, stmt.s1.length - 6)
    let module = libraryLangModule(id)
    if (module.equals("")) {
        diag_error_at_code(DIAG_DRIVER_LANG_IMPORT_MISSING, stmt.file, stmt.line, stmt.col, stmt.len,
            "the standard library declares no `lang(\"".concat(id, "\")` item, which this needs"))
        diag_note_dropped_everything()
        return false
    }
    stmt.s1 = module
    return true
}

private fn mergeModuleImports(merged: ASTNode, module: ASTNode, baseDir: String, visited: String) -> String {
    let mut seen = visited

    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        let nextStmt = stmt.next
        stmt.next = ptr_null()

        if (stmt.kind == NodeKind.IMPORT_STATEMENT and resolveLangImport(stmt) == false) {
            // Reported; nothing to merge.
        } else if (stmt.kind == NodeKind.IMPORT_STATEMENT) {
            followRename(stmt)
            if (stmt.i1 == 1) {
                seen = mergePackageImport(merged, stmt, baseDir, seen)
            } else if (refuseGroupDeclaration(stmt, baseDir) == false) {
                ir_import_record(stmt.file, stmt.s1)
                recordImportAlias(stmt, baseDir)
                seen = mergeNamedModule(merged, stmt, stmt.s1, baseDir, seen)
            }
        } else {
            appendStatement(merged, stmt)
        }

        stmtPtr = nextStmt
    }

    return seen
}

// The library that ships with the running compiler: the `stdlib/` beside it, found as its runtime
// bitcode is -- one level up (an install, and a project's `.prismio/build/`, keep `bin/` or a profile
// directory beside `stdlib/`), else in the compiler's own directory (a bare generation, whose
// directory holds a source copy). It holds `.plib`s, or source that is compiled with the program.
// There is no setting that points anywhere else: a different library is a different compiler. "" when
// there is none.
public fn libraryRoot() -> String {
    let beside = executableDirectory()
    let installed = joinPath(directoryOf(beside), "stdlib")
    if (directoryExists(installed)) { return installed }
    let local = joinPath(beside, "stdlib")
    if (directoryExists(local)) { return local }
    return "".clone()
}

// Where a module checked or emitted on its own (`--module std.core.map` on `std/core/map.psm`) finds its
// siblings: its own tree, the directory above the entry's module path. A library module is edited
// where its source is, so its imports must see that source and not the copy beside the compiler.
let mut entryTreeDirectory = ""
let mut entryTreeName = ""

private fn setEntryTree(entryPath: String) {
    entryTreeDirectory = "".clone()
    entryTreeName = "".clone()
    let module = entryModule()
    if (module.equals("")) { return }
    let relative = moduleRelativePath(module).concat(".psm")
    let path = entryPath.replace("\\", "/")
    let mut root = "".clone()
    if (path.equals(relative)) {
        root = ".".clone()
    } else if (path.endsWith("/".concat(relative))) {
        root = path.substring(0, path.length - relative.length - 1)
    } else {
        return
    }
    entryTreeDirectory = root.clone()
    let dot = module.indexOf(".")
    if (dot < 0) { entryTreeName = module.clone() }
    else { entryTreeName = module.substring(0, dot) }
}

// The file, or directory, of `moduleName` in the entry's own tree; "" when the name is not in it.
private fn entryTreePath(moduleName: String, directory: Bool) -> String {
    if (entryTreeName.equals("")) { return "".clone() }
    if (moduleName.equals(entryTreeName) == false and moduleName.startsWith(entryTreeName.concat(".")) == false) {
        return "".clone()
    }
    let mut path = joinPath(entryTreeDirectory, moduleRelativePath(moduleName))
    if (directory == false) { path = path.concat(".psm") }
    if (standardExists(path, directory)) { return path }
    return "".clone()
}

// The library's file for a standard module, or "". `leaf` is the module's path under `std/` with
// its `.psm` suffix, and a nested module keeps its directories: `std.a.b` is `a/b.psm` in a source
// tree and `stdlib/a/b.plib` once packaged, so a logical name and a path agree.
public fn standardModulePath(leaf: String) -> String {
    return standardPath(leaf.substring(0, leaf.length - 4), false)
}

// What `import std.<relative>` reads: the library's compiled `.plib`, else its source -- or, when
// `directory`, the directory of that name. `relative` is "" for `std` itself.
private fn standardPath(relative: String, directory: Bool) -> String {
    let mut moduleName = "std".clone()
    if (relative.equals("") == false) {
        moduleName = moduleName.concat(".", relative.replace("/", "."))
    }
    let own = entryTreePath(moduleName, directory)
    if (own.equals("") == false) { return own }

    let library = libraryRoot()
    if (library.equals("")) { return "".clone() }
    if (directory) {
        let found = standardCandidate(library, relative, "")
        if (standardExists(found, true)) { return found }
        return "".clone()
    }
    let packaged = standardCandidate(library, relative, ".plib")
    if (standardExists(packaged, false)) { return packaged }
    let source = standardCandidate(library, relative, ".psm")
    if (standardExists(source, false)) { return source }
    return "".clone()
}

// `<library>/<relative><suffix>`, or the library directory itself for `std`.
private fn standardCandidate(library: String, relative: String, suffix: String) -> String {
    if (relative.equals("")) { return library.clone() }
    return joinPath(library, relative.concat(suffix))
}

private fn standardExists(path: String, directory: Bool) -> Bool {
    if (directory) { return directoryExists(path) }
    return fileExists(path)
}

// The directory a package import reads: the library's for `std`, the project's beside the entry
// otherwise.
private fn resolvePackageDirectory(baseDir: String, packageName: String) -> String {
    let local = joinImportDir(baseDir, packageName)
    if (packageName.equals("std") == false and packageName.startsWith("std.") == false) {
        let own = entryTreePath(packageName, true)
        if (own.equals("") == false) { return own }
        return local
    }
    let mut relative = "".clone()
    if (packageName.equals("std") == false) {
        relative = moduleRelativePath(packageName.substring(4, packageName.length - 4))
    }
    let library = standardPath(relative, true)
    if (library.equals("")) { return local }
    return library
}

// Where `import std.core.map` reads from.
//
// An ordinary import is relative to the source root, and that is right for an
// application's own modules. `std.*` is the library that ships with the compiler, so a
// program's own `std/` directory never answers for it.
//
// Each branch rebuilds the path rather than binding it once. Strings are affine,
// so a binding tested with file_exists and then returned is named twice; a fresh
// temporary per use is a str_concat and avoids the question.
private fn resolveImportPath(baseDir: String, moduleName: String) -> String {
    if (moduleName.startsWith("std.")) {
        let library = libraryModulePath(moduleName)
        if (library.equals("") == false) { return library }
        return joinImportPath(baseDir, moduleName)
    }
    let own = entryTreePath(moduleName, false)
    if (own.equals("") == false) { return own }
    return joinImportPath(baseDir, moduleName)
}

// The library's file for `std.<path>`, or "" when the name is not under `std` or the library has no such
// module. The one place the name of the library's root is spelled, and a file read from there is the
// library's (fileFromLibraryRoot).
private fn libraryModulePath(moduleName: String) -> String {
    if (moduleName.startsWith("std.") == false) { return "".clone() }
    let leaf = moduleRelativePath(moduleName.substring(4, moduleName.length - 4)).concat(".psm")
    return standardModulePath(leaf)
}

// Whether `importPath`, which `moduleName` resolved to, is the library's file for it. A file of the same
// name that resolved some other way is not the library's.
private fn resolvedFromLibrary(moduleName: String, importPath: String) -> Bool {
    let library = libraryModulePath(moduleName)
    if (library.equals("")) { return false }
    return absolutePath(library).equals(absolutePath(importPath))
}

// The lazy prelude (`--prelude`): a name a program file looks up that neither the program nor a
// module the file imports declares, and a prelude module does, is imported for that file -- the
// module is merged, and the file takes it as if it had written the import. A program that looks up no
// such name merges nothing. A function or a type of the program's own wins; its own method does not,
// since a method answers only for its receiver.
private fn mergePrelude(merged: ASTNode, baseDir: String, visited: String) -> String {
    let mut seen = visited
    if (preludeNeedCount() == 0) { return seen }
    let ownTypes = programTypeNames(merged)
    for need in 0..<preludeNeedCount() {
        let name = preludeNeedName(need)
        if (name.startsWith("lang:")) {
            if (name.equals("lang:vec_of") and preludeVecWritten() == false) { continue }
            let module = libraryLangModule(name.substring(5, name.length - 5))
            if (module.equals("") == false) {
                seen = importPreludeModule(merged, need, module, ownTypes, baseDir, seen)
            }
            continue
        }
        if (preludeCompilerMember(name)) { continue }
        let candidates = libraryPreludeModulesDeclaring(name)
        if (candidates.length == 0 or preludeNameFound(name, preludeNeedFile(need))) { continue }
        for module in candidates {
            seen = importPreludeModule(merged, need, module, ownTypes, baseDir, seen)
        }
    }
    return seen
}

// Whether `name` is already answered for `file`: by a declaration of the program's own, a method
// excepted, or by one in a module the file imports.
private fn preludeNameFound(name: String, file: Int) -> Bool {
    for i in 0..<ir_decl_count(name) {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (fileFromLibraryRoot(decl.file) == false) {
            if (isMethodDeclaration(decl) == false) { return true }
        } else if (ir_file_imports_module(file, diag_file_module(decl.file)) != 0) {
            return true
        }
    }
    return false
}

// A member the compiler builds itself -- `v.push`, a channel's `send`, a pointer's `load` -- needs no
// module, so it asks the prelude for none.
private fn preludeCompilerMember(name: String) -> Bool {
    // `withCapacity` and `filled` are asked of the type, `Vec<T>.withCapacity(n)`.
    if (name.equals("withCapacity") or name.equals("filled")) { return true }
    let heads: Vec<String> = ["Vec", "Slice", "DataView", "Channel", "Ptr", "PtrScalar"]
    for head in heads {
        for lowered in ixLoweredNames(head) {
            if (lowered.equals(name)) { return true }
        }
    }
    return false
}

private fn isMethodDeclaration(decl: ASTNode) -> Bool {
    if (decl.kind != NodeKind.FUNCTION or nodeIsNull(decl.child1)) { return false }
    return ptr_to_node(decl.child1).s1.equals("self")
}

private fn importPreludeModule(merged: ASTNode, need: Int, module: String, ownTypes: Vec<String>,
                         baseDir: String, visited: String) -> String {
    let file = preludeNeedFile(need)
    if (ir_file_imports_module(file, module) != 0 or preludeTypeTaken(module, ownTypes)) { return visited }
    // The import the file did not write, at the name that asked for it.
    let site = createNode(NodeKind.IMPORT_STATEMENT)
    site.s1 = module.clone()
    site.file = file
    site.line = preludeNeedLine(need)
    site.col = preludeNeedCol(need)
    site.len = 1
    ir_import_record(file, module)
    return mergeNamedModule(merged, site, module, baseDir, visited)
}

// The types and traits the program itself declares.
private fn programTypeNames(merged: ASTNode) -> Vec<String> {
    let mut names: Vec<String> = []
    let mut at = merged.child1
    while (nodeExists(at)) {
        let decl = ptr_to_node(at)
        if ((decl.kind == NodeKind.STRUCT_DECL or decl.kind == NodeKind.ENUM_DECL
                or decl.kind == NodeKind.TRAIT_DECL) and fileFromLibraryRoot(decl.file) == false) {
            names.push(decl.s1.clone())
        }
        at = decl.next
    }
    return names
}

// Whether the program declares a type or a trait under a name importing `module` would bring in. The
// merge keeps one declaration per type name, so the module is then left to an import the program
// writes.
private fn preludeTypeTaken(module: String, ownTypes: Vec<String>) -> Bool {
    if (ownTypes.length == 0) { return false }
    for name in libraryTypesImportedWith(module) {
        for own in ownTypes {
            if (own.equals(name)) { return true }
        }
    }
    return false
}

// A name the parser wrote for a library item that the merged library does not declare: `?` needs the
// result type, a tuple needs its struct.
private fn reportMissingLangReference(missing: Ptr) {
    if (nodeIsNull(missing)) { return }
    let node = ptr_to_node(missing)
    let id = node.s1.substring(6, node.s1.length - 6)
    let module = libraryLangModule(id)
    let mut needs = "a standard library module that this program has not imported".clone()
    if (module.equals("") == false) { needs = "`import ".concat(module, "`") }
    diag_error_at_code(DIAG_DRIVER_LANG_REFERENCE_MISSING, node.file, node.line, node.col, node.len,
        "this syntax needs ".concat(needs))
    if (module.equals("") == false) { diag_note_add_import(module, "add `import ".concat(module, "`")) }
    diag_note_dropped_everything()
}

// The entry file is marked resolved before the walk begins, so that a package
// import naming the package it lives in cannot pull it in a second time and
// duplicate every function it defines.
public fn resolveImports(module: ASTNode, baseDir: String, entryPath: String) -> ASTNode {
    let merged = createNode(NodeKind.MODULE)
    // The index and the tail cache describe `merged`, so both start empty with
    // it. analyzeModule and generateModule rebuild the index from the finished
    // module; this fill is the merge's own, and it is the same one walk.
    ir_reset_decl_index()
    // The checker's lookup index (sema/decl_index.psm) describes the finished chain, so it is off while this one is made.
    declIndexDisable()
    // Selections are recorded by the merge below and read by sema, so this is
    // the one point where the previous run's are gone and this run's are not
    // yet made.
    ir_reset_selections()
    ir_reset_imports()
    ir_reset_import_aliases()
    ir_reset_extern_decls()
    mergeTailPtr = ptr_null()
    setEntryTree(entryPath)
    importTiersReset()
    importTierRecord(importMemoKey(entryPath), module.file)
    // Read for lang items the syntax needs, and for names that turn out to be unknown
    // (sema/symbols.psm). A `--freestanding` program is offered no imports: most of the library is
    // refused to it at the import.
    libraryUseDirectory(standardPath("", true), compiler_is_freestanding() != 1)
    // `std.io` is an ordinary import, so a program that names no I/O carries none -- which is what
    // lets a target with no stdout link at all. The lazy prelude (`--prelude`) covers the modules the
    // language itself reaches for, and only the ones a name asks for.
    let seen = mergeModuleImports(merged, module, baseDir, importMemoKey(entryPath))
    mergePrelude(merged, baseDir, seen)
    reportMissingLangReference(langResolveReferences())

    // Before the templates are collected, and after the merge: a default may be
    // inherited from a trait declared in another module, and a default expanded
    // on a generic impl has to be collected as a template like any other.
    deriveEnumImpls(merged)
    monoExpandDefaultMethods(merged)

    // Before the templates are collected: a generic enum is numbered once, on
    // the template, and every instantiation copies the numbers.
    enumAssignDiscriminants(merged)

    // Generic declarations come out of the chain here, at the end of the merge
    // rather than at the start of sema, so that every consumer of a resolved
    // module sees the same thing: a chain of concrete declarations, plus
    // whatever instantiation later appends to it.
    monoCollectTemplates(merged)

    // After the templates are out of the way, so that a *generic* payload enum
    // is desugared once per instantiation rather than once as a template whose
    // payload types are still type parameters.
    enumDesugarModule(merged)
    declIndexEnable()
    return merged
}
