// Import resolution: a module name to a merged declaration chain.
//
// Two questions, and the module exists to answer them: where a module name
// lives on disk, and whether it has already been merged. Getting the second
// wrong emits duplicate LLVM `define` lines that llc rejects a long way from
// the import that caused them -- mergeNamedModule says what a diamond-shaped
// import graph does without the memo.
//
// The surface is `resolveImports` and `standardModulePath`. The other fifteen
// functions and the merge-tail cache are private to this file.

import std.io
import lexer.scanner
import lexer.token
import common.text
import ast.nodes
import ast.types
import parse.*
import ir.*
import sema.*
import common.diagnostics
import std.string

// Declared here as well as in the modules that share them: the merge keeps the
// first EXTERN_FUNCTION of a given name and drops the rest, which is what lets
// each module name the externs it actually uses.
public extern fn read_file(path: String) -> String
public extern fn get_directory(path: String) -> String
public extern fn join_path(directory: String, filename: String) -> String
public extern fn file_exists(path: String) -> Int
public extern fn list_modules(directory: String) -> String produce(free)
public extern fn compiler_plib_interface(path: String borrow, module: String borrow) -> String produce(free)
public extern fn compiler_plib_error() -> String produce(free)
public extern fn executable_directory() -> String produce(free)
extern fn current_directory() -> String produce(free)

// The last statement appended to the module being merged. Reset with the module
// in resolveImports(); see appendStatement() for why it is a cache rather than
// the list's only tail.
// Zero-initialized rather than assigned: a global cannot be initialized by a
// call, and a zero-filled pointer is NULL, which is the empty cache this wants.
let mut mergeTailPtr: Ptr

// `check --overlay`: an editor's unsaved text for one file of the program.
// Wherever the merge reads `overlayPath` -- as the entry or as a module some
// import reaches -- it reads `overlayContents` instead, so the file keeps its
// own path, its diagnostics name it, and an import cycle back to it is the file
// already merged rather than a second copy.
let mut overlayPath = ""
let mut overlayContents = ""
let mut overlayRead = false

// A path as read from the working directory, so one file named relatively on
// one side of a comparison and absolutely on the other is still one file.
// `./` is dropped; `..` is not resolved, and a path spelled with it is compared
// as written.
private fn absolutePath(path: String) -> String {
    let mut relative = path.clone()
    while (relative.startsWith("./") or relative.startsWith(".\\")) {
        relative = relative.substring(2, __builtin_string_len(relative) - 2)
    }
    if (relative.startsWith("/") or relative.startsWith("\\")) { return relative }
    if (__builtin_string_len(relative) > 1 and relative.charAt(1) == ':') { return relative }
    return join_path(current_directory(), relative)
}

// `check --module`: the name the entry file is known by when it is a module
// checked on its own -- `std.map` for std/map.psm -- which is what gives it its
// package's access to that package's internals. "" for a program.
let mut entryModuleName = ""

public fn setEntryModuleName(name: String) {
    entryModuleName = name.clone()
}

public fn entryModule() -> String {
    return entryModuleName.clone()
}

public fn setSourceOverlay(path: String, contents: String) {
    overlayPath = absolutePath(path)
    overlayContents = contents.clone()
    overlayRead = false
}

// Whether the program read the overlaid file at all: one it never imports was
// not checked, and the caller has to say so rather than report it clean.
public fn sourceOverlayRead() -> Bool {
    return overlayRead
}

public fn readSource(path: String) -> String {
    if (overlayPath.equals("") == false and absolutePath(path).equals(overlayPath)) {
        overlayRead = true
        return read_file(overlayContents)
    }
    return read_file(path)
}

// Two same-named top-level declarations of the same kind are duplicates, with one
// exception: FUNCTION. Overloading means several `fn` nodes legitimately share a
// name (tests/test_29_overloads.psm), and a genuinely duplicated overload has to
// survive the merge so sema can reject it (tests/neg_06_duplicate_overload.psm).
//
// EXTERN_FUNCTION is deliberately *not* exempt. Modules each declare the externs
// they use, so `str_equals` is declared by both utils.psm and keywords.psm, and
// `exit` by both parser.psm and sema.psm; merging both copies makes sema report a
// spurious "duplicate function overload". Keeping the first is correct.
//
// This does not disturb the forward-declaration idiom in ir.psm/parser.psm/
// sema.psm, where an `extern fn` declares a function the same file also defines:
// that pairs an EXTERN_FUNCTION with a FUNCTION, so the kind check above already
// treats them as distinct (and generateModule skips the `declare` when a real
// `define` exists).

// EXTERN_VARIABLE is exempt too, for a reason of its own: `mut` belongs to
// each declaration rather than to the symbol. One module may only read `optind`
// while another assigns it, and keeping whichever merged first would decide
// that for both. Sema checks that the declarations agree on the type.
private fn sameTopLevelName(a: ASTNode, b: ASTNode) -> Bool {
    if (a.kind != b.kind) { return false }
    if (a.s1.equals(b.s1) == false) { return false }
    if (a.kind == NodeKind.FUNCTION or a.kind == NodeKind.EXTERN_VARIABLE) {
        return false
    }
    return true
}

// Asks the declaration index, which appendStatement() keeps current as it
// merges, rather than rescanning everything merged so far. The scan was
// quadratic in the number of declarations and ran before sema -- this compiler's
// own source merges about 1 500 of them.
private fn hasNamedTopLevel(module: ASTNode, stmt: ASTNode) -> Bool {
    if (isNamedTopLevel(stmt) == false) {
        return false
    }

    let count = ir_decl_count(stmt.s1)
    for i in 0..<count {
        let scan = ptr_to_node(ir_decl_at(stmt.s1, i))
        if (sameTopLevelName(scan, stmt)) {
            return true
        }
    }

    return false
}

private fn parseSource(content: String, file: Int) -> ASTNode {
    let lex = createLexer(content, file)
    let headToken = lexAllTokens(lex)
    let p = parserCreate(headToken)
    return parseModule(p)
}

private fn appendStatement(module: ASTNode, stmt: ASTNode) {
    if (isExternDecl(stmt)) {
        ir_extern_decl_record(stmt.file, stmt.s1, stmt.i2)
    }
    if (hasNamedTopLevel(module, stmt)) {
        return
    }

    if (nodeIsNull(module.child1)) {
        module.child1 = node_to_ptr(stmt)
        mergeTailPtr = node_to_ptr(stmt)
        indexTopLevel(stmt)
        return
    }

    // Walking to the end per statement made merging quadratic. The cached tail
    // is a shortcut, not a second source of truth: when it is empty -- a module
    // that was appended to by something other than this function -- the walk it
    // replaced still runs, once, and the cache picks up from there.
    if (nodeIsNull(mergeTailPtr)) {
        mergeTailPtr = module.child1
        let mut searching = true
        while (searching) {
            let scan = ptr_to_node(mergeTailPtr)
            if (nodeIsNull(scan.next)) {
                searching = false
            } else {
                mergeTailPtr = scan.next
            }
        }
    }

    let tail = ptr_to_node(mergeTailPtr)
    tail.next = node_to_ptr(stmt)
    mergeTailPtr = node_to_ptr(stmt)
    indexTopLevel(stmt)
}

// A dotted module name is a directory path: `ir.expr` becomes `ir/expr`.
//
// '/' is emitted unconditionally because the frontend has no way to ask what the
// host's separator is; join_path normalises the joined result.
private fn moduleRelativePath(moduleName: String) -> String {
    let mut relative = ""
    let length = __builtin_string_len(moduleName)
    for i in 0..<length {
        let c = moduleName.charAt(i)
        if (c == '.') {
            relative = relative.concat("/")
        } else {
            relative = relative.concat(c.toString())
        }
    }
    return relative
}

// Everything an import names is resolved against the directory of the file being
// compiled, not against the importing module -- so a module path means the same
// thing written anywhere in the tree. The `.` case exists because there is
// nothing to join to.
private fn resolveUnder(baseDir: String, relative: String) -> String {
    if (baseDir.equals(".")) {
        return relative
    }
    return join_path(baseDir, relative)
}

// Compiler subsystems normally live below src/, which is also the source root.
// UMS is deliberately different: it is a first-class toolchain subsystem beside
// src/, not compiler implementation. Reserving the `ums` import root lets the
// self-hosted CLI consume that subsystem without a mirror, symlink, or C bridge.
// The rule is narrow on purpose so ordinary user module resolution remains
// relative to the entry source exactly as before.


private fn importBaseDir(baseDir: String, moduleName: String) -> String {
    if (moduleName.equals("ums") or moduleName.startsWith("ums.")) {
        return get_directory(baseDir)
    }
    return baseDir
}

private fn joinImportPath(baseDir: String, moduleName: String) -> String {
    return resolveUnder(importBaseDir(baseDir, moduleName),
                        moduleRelativePath(moduleName).concat(".psm"))
}

private fn joinImportDir(baseDir: String, packageName: String) -> String {
    return resolveUnder(importBaseDir(baseDir, packageName), moduleRelativePath(packageName))
}

// Memo key for an already-resolved module. Paths are wrapped in "|" so that a
// substring search can never match a partial path (e.g. "src\ir.psm" must not be
// found inside "src\dir.psm").
private fn importMemoKey(importPath: String) -> String {
    return "|".concat(importPath, "|")
}

// Resolves one named module into `merged`, unless it has already been resolved.
//
// Resolving each path once is what keeps a diamond-shaped import graph correct:
// src/main.psm reaches common/text.psm through five distinct paths, and without
// this every one of that module's functions and extern declarations would be
// merged five times, emitting duplicate LLVM `define`/`declare` lines that llc
// rejects outright ("invalid redefinition of function"). Marking a path before
// recursing into it also makes an import cycle terminate instead of recursing
// forever.
//
// `site` is the import that asked, and is only used to place the diagnostic.
private fn mergeNamedModule(merged: ASTNode, site: ASTNode, moduleName: String,
                      baseDir: String, visited: String) -> String {
    let importPath = resolveImportPath(baseDir, moduleName)

    // v0.1 3.5, selective imports. `import std.string.strTrim` names a *name*
    // and not a module, and nothing but resolution can tell the two apart --
    // `std.string` could equally hold a `strTrim.psm`, and then the same text
    // means the module. So the full path is tried first and this is the
    // fallback, which is where Kotlin settles the same ambiguity and for the
    // same reason: a grammar cannot see the filesystem.
    //
    // The record goes in before the memo check below, not after. A module is
    // merged once however many files import it, so a second file selecting from
    // an already-merged module would otherwise take everything.
    if (file_exists(importPath) == 0) {
        let cut = moduleName.lastIndexOf(".")
        if (cut > 0) {
            let parent = moduleName.substring(0, cut)
            if (file_exists(resolveImportPath(baseDir, parent)) == 1) {
                ir_import_record(site.file, parent)
                ir_select_record(site.file, parent,
                    moduleName.substring(cut + 1, __builtin_string_len(moduleName) - cut - 1))
                return mergeNamedModule(merged, site, parent, baseDir, visited)
            }
        }
    }

    let key = importMemoKey(importPath)
    if (visited.contains(key)) {
        return visited
    }

    let seen = visited.concat(key)

    let mut content = ""
    if (importPath.endsWith(".plib")) {
        content = compiler_plib_interface(importPath, moduleName)
        if (content.equals("")) {
            // Its own code, not P1001's. A `.plib` that will not open is a
            // broken *installation* and the note below says to reinstall; a
            // P1001 next to it is a source file the program named and does not
            // have, which the programmer fixes in their own tree. One code for
            // both sent every "reinstall Prismio" reader looking for a typo in
            // an import they wrote correctly.
            diag_error_at_code("P1068", site.file, site.line, site.col, site.len,
                "compiled standard-library module ".concat(diagQuote(moduleName),
                    " is missing, incompatible, or corrupted: ", compiler_plib_error()))
            diag_note("reinstall Prismio and try again")
            diag_finish()
            exit(1)
        }
    } else {
        content = readSource(importPath)
    }
    if (content.equals("") and file_exists(importPath) == 0) {
        diag_error_at_code("P1001", site.file, site.line, site.col, site.len,
            "cannot read imported module ".concat(diagQuote(moduleName),
                                                  ": no such file ",
                                                  importPath))
        diag_finish()
        exit(1)
    }

    // Registered before parsing so every token from this file carries an id that
    // resolves back to its text, long after the merge has erased which module a
    // declaration came from.
    let file = diag_add_file(importPath, content)
    // ...and the name it was reached by, which the id alone cannot recover: the
    // installed layout stores `std/string.psm` as `stdlib/string.plib`, so a
    // qualifier derived from the path would differ between a checkout and an
    // install. Every module arrives here with its logical path already built --
    // mergePackageImport composes `pkg.leaf` before calling -- so this one line
    // covers named and package imports both.
    diag_set_file_module(file, moduleName)
    return mergeModuleImports(merged, parseSource(content, file), baseDir, seen)
}

// `import pkg.*` -- every module directly inside `pkg`, in the order
// list_modules sorted them.
//
// Non-recursive, like Kotlin's: a nested package is a separate import. A
// directory with no modules in it is an error rather than a no-op, because the
// only ways to reach it are a typo in the package name and a package that has
// been emptied, and both are worth hearing about.
private fn mergePackageImport(merged: ASTNode, site: ASTNode, baseDir: String,
                        visited: String) -> String {
    let dirPath = joinImportDir(baseDir, site.s1)
    let listing = list_modules(dirPath)

    if (listing.equals("")) {
        diag_error_at_code("P1002", site.file, site.line, site.col, site.len,
            "package ".concat(diagQuote(site.s1), " contains no modules: ", dirPath))
        diag_finish()
        exit(1)
    }

    let mut seen = visited
    let mut name = ""
    let length = __builtin_string_len(listing)

    for i in 0..<length {
        let c = listing.charAt(i)
        if (c == '\n') {
            let qualified = site.s1.concat(".", name)
            ir_import_record(site.file, qualified)
            seen = mergeNamedModule(merged, site, qualified, baseDir, seen)
            name = ""
        } else {
            name = name.concat(c.toString())
        }
    }

    let last = site.s1.concat(".", name)
    ir_import_record(site.file, last)
    return mergeNamedModule(merged, site, last, baseDir, seen)
}

// Walks `module`, appending its non-import declarations into the shared `merged`
// accumulator and resolving each import it carries. `visited` threads the set of
// already-resolved paths through the recursion and is returned so sibling
// imports see what earlier ones resolved.
// `import std.io as io`, checked once here because this is the only place that
// knows whether the path names a module at all.
//
// Two shapes are rejected rather than accepted and ignored. A **duplicate** alias
// in one file would otherwise resolve to whichever import the merge happened to
// reach first, which is a rule nobody can read off the source. A **selective**
// import -- `import std.string.strTrim`, whose path is a function inside a module
// -- would bind the alias to something that is not a module, and every later
// `trim.f(x)` would report "no module `trim`" pointing at the call rather than at
// the import that could not work.
private fn recordImportAlias(stmt: ASTNode, baseDir: String) {
    if (stmt.s2.equals("")) { return }

    let existing = ir_import_alias_target(stmt.file, stmt.s2)
    if (existing.equals("") == false) {
        diag_error_at_code("P1069", stmt.file, stmt.line, stmt.col, stmt.len,
            "the name ".concat(diagQuote(stmt.s2), " is already bound to ",
                               diagQuote(existing), " in this file"))
        diag_note("one `as` name per file: give this import a different one")
        return
    }

    if (file_exists(resolveImportPath(baseDir, stmt.s1)) == 0) {
        diag_error_at_code("P1070", stmt.file, stmt.line, stmt.col, stmt.len,
            "`as` names a module, and ".concat(diagQuote(stmt.s1), " is not one"))
        diag_note("a selective import names one declaration inside a module; drop the `as`, or alias the module it comes from")
        return
    }

    // An alias that is *itself* a module name in this project makes every
    // `name.f(x)` ambiguous, and the alias would win silently -- leaving the real
    // module unreachable by its own name and reporting the mismatch at the call,
    // which is the one place the cause is not.
    //
    // Tested against the tree rather than against what this file imports, so the
    // answer does not depend on which import the merge reached first. Rejecting a
    // name the file could have imported and did not is the conservative half of
    // that trade, and the fix is to pick another name.
    if (file_exists(resolveImportPath(baseDir, stmt.s2)) == 1) {
        diag_error_at_code("P1071", stmt.file, stmt.line, stmt.col, stmt.len,
            diagQuote(stmt.s2).concat(" is already the name of a module, so it cannot also be an alias"))
        diag_note("`".concat(stmt.s2, ".f(x)` would have two meanings here; choose a name no module in this project has"))
        return
    }

    ir_import_alias_record(stmt.file, stmt.s2, stmt.s1)
}

// An entry of `import {a, b} from dir` names a file, never a declaration
// (parseImportGroup marks it with `i2`). Refused here because only resolution
// can see the difference: `import {Option} from std.option` would otherwise
// reach mergeNamedModule's selective-import fallback and quietly select a name.
// An entry that names nothing at all falls through to P1001's "no such file".
private fn refuseGroupDeclaration(stmt: ASTNode, baseDir: String) {
    if (stmt.i2 != 1) { return }
    if (file_exists(resolveImportPath(baseDir, stmt.s1)) == 1) { return }
    let cut = stmt.s1.lastIndexOf(".")
    let directory = stmt.s1.substring(0, cut)
    if (file_exists(resolveImportPath(baseDir, directory)) == 0) { return }
    diag_error_at_code("P1072", stmt.file, stmt.line, stmt.col, stmt.len,
        "an import group names modules, and ".concat(diagQuote(stmt.s1), " is a declaration inside ",
                                                     diagQuote(directory)))
    diag_note("select a declaration with its own import: `import ".concat(stmt.s1, "`"))
    diag_finish()
    exit(1)
}

private fn mergeModuleImports(merged: ASTNode, module: ASTNode, baseDir: String, visited: String) -> String {
    let mut seen = visited

    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        let nextStmt = stmt.next
        stmt.next = ptr_null()

        if (stmt.kind == NodeKind.IMPORT_STATEMENT) {
            if (stmt.i1 == 1) {
                seen = mergePackageImport(merged, stmt, baseDir, seen)
            } else {
                refuseGroupDeclaration(stmt, baseDir)
                ir_import_record(stmt.file, stmt.s1)
                recordImportAlias(stmt, baseDir)
                seen = mergeNamedModule(merged, stmt, stmt.s1, baseDir, seen)
            }
        } else {
            appendStatement(merged, stmt)
        }

        stmtPtr = nextStmt
    }

    return seen
}

// Finds a standard module in a source checkout or an installed toolchain. The
// order is the one developers.prismio.org/runtime/supported-surface documents:
// a `std/` in the entry's directory or any enclosing one
// wins over the toolchain's `stdlib/`, which is what makes a checkout of the
// compiler build against its own tree -- and means an application's own `std/`
// directory shadows the shipped one.
//
// **So a program inside the checkout never reads a `.plib`**, and a defect on
// that path is invisible to every fixture under `tests/`: `sort()` failed to
// link from every installed stdlib while the suite stayed green. The builds
// that do read one are `run_runtime_library_test` and run_ums_test's program
// outside the checkout.
//
// `leaf` is the file name, because the installed layout flattens the package:
// `std/map.psm` in a checkout is `stdlib/map.plib` once installed.
public fn standardModulePath(baseDir: String, leaf: String) -> String {
    let besideEntry = join_path(baseDir, "std/".concat(leaf))
    if (file_exists(besideEntry) == 1) { return besideEntry }

    // Then each enclosing directory, nearest first. One level was enough for as
    // long as everything that imported `std.*` sat directly under the checkout
    // root. `aif/corpus/` is two deep, and its programs stopped resolving
    // `std.io` when the project-local host became the compiler that builds them:
    // that host lives in `.prismio/build/debug/`, whose toolchain root carries
    // neither `stdlib/` nor `std/`, so neither branch below can answer either.
    //
    // Bounded rather than open: `get_directory` is a string operation whose
    // fixed points are "." and the filesystem root, so the stop condition is a
    // parent that equals its child, and the hop count is the backstop for a path
    // shape that never reaches one.
    let mut dir = get_directory(baseDir)
    repeat(64) {
        if (file_exists(join_path(dir, "std/".concat(leaf))) == 1) {
            return join_path(dir, "std/".concat(leaf))
        }
        let parent = get_directory(dir)
        if (parent.equals(dir)) { break }
        dir = parent
    }

    let toolchainRoot = get_directory(executable_directory())

    // Installed standard modules are compiled, module-level PLIB artifacts.
    // `leaf` still arrives as `string.psm` because checkout resolution uses the
    // source spelling; replace only that suffix for the installed lookup.
    let plibLeaf = leaf.substring(0, __builtin_string_len(leaf) - 4).concat(".plib")
    let packaged = join_path(toolchainRoot, "stdlib/".concat(plibLeaf))
    if (file_exists(packaged) == 1) { return packaged }

    let besideBuild = join_path(toolchainRoot, "std/".concat(leaf))
    if (file_exists(besideBuild) == 1) { return besideBuild }

    return ""
}

// Where `import std.map` reads from.
//
// An ordinary import is relative to the source root, and that is right for an
// application's own modules. It is wrong for `std.*`: those are shipped with the
// compiler, and a program that imports one is not asking for a file that happens
// to sit next to it. Resolved relative to the entry first all the same, so a
// checkout of the compiler compiles against its own `std/` rather than an
// installed copy.
//
// Each branch rebuilds the path rather than binding it once. Strings are affine,
// so a binding tested with file_exists and then returned is named twice; a fresh
// temporary per use is a str_concat and avoids the question.
private fn resolveImportPath(baseDir: String, moduleName: String) -> String {
    if (file_exists(joinImportPath(baseDir, moduleName)) == 1) {
        return joinImportPath(baseDir, moduleName)
    }
    if (moduleName.startsWith("std.") == false) {
        return joinImportPath(baseDir, moduleName)
    }
    let leaf = moduleName.substring(4, __builtin_string_len(moduleName) - 4).concat(".psm")
    if (standardModulePath(baseDir, leaf).equals("")) {
        return joinImportPath(baseDir, moduleName)
    }
    return standardModulePath(baseDir, moduleName.substring(4, __builtin_string_len(moduleName) - 4).concat(".psm"))
}

// The entry file is marked resolved before the walk begins, so that a package
// import naming the package it lives in cannot pull it in a second time and
// duplicate every function it defines.
public fn resolveImports(module: ASTNode, baseDir: String, entryPath: String) -> ASTNode {
    let merged = createNode(NodeKind.MODULE)
    // The index and the tail cache describe `merged`, so both start empty with
    // it. analyzeModule and generateModule rebuild the index from the finished
    // module; this fill is the merge's own, and it is the same one walk.
    ir_reset_decl_index()
    // Selections are recorded by the merge below and read by sema, so this is
    // the one point where the previous run's are gone and this run's are not
    // yet made.
    ir_reset_selections()
    ir_reset_imports()
    ir_reset_import_aliases()
    ir_reset_extern_decls()
    mergeTailPtr = ptr_null()
    // No prelude. `std.io` is an ordinary import, so a program that names no I/O
    // carries none -- which is what lets a target with no stdout link at all.
    mergeModuleImports(merged, module, baseDir, importMemoKey(entryPath))

    // Before the templates are collected, and after the merge: a default may be
    // inherited from a trait declared in another module, and a default expanded
    // on a generic impl has to be collected as a template like any other.
    monoExpandDefaultMethods(merged)

    // Generic declarations come out of the chain here, at the end of the merge
    // rather than at the start of sema, so that every consumer of a resolved
    // module sees the same thing: a chain of concrete declarations, plus
    // whatever instantiation later appends to it.
    monoCollectTemplates(merged)

    // After the templates are out of the way, so that a *generic* payload enum
    // is desugared once per instantiation rather than once as a template whose
    // payload types are still type parameters.
    enumDesugarModule(merged)
    return merged
}
