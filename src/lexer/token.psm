// The token vocabulary: what the scanner produces and what the parser matches on.
//
// The keyword set lives here too. It used to be its own module with a single
// consumer, which bought nothing -- a keyword is a token that happens to spell a
// reserved word, and the two answers belong beside the enum that names them.


import std.string
import std.vec

enum TokenType {
    STRING_LITERAL,
    CHAR_LITERAL,
    NUMBER_LITERAL,
    FLOAT_LITERAL,
    BOOL_LITERAL,

    IDENTIFIER,
    SEPARATOR,

    UNDERSCORE,

    ARITHMETIC_OPERATOR,
    RELATIONAL_OPERATOR,
    NEGATION,
    BITWISE_OR,
    ASSIGNMENT_OPERATOR,
    UNARY_OPERATOR,
    AMPERSAND,

    ARROW,
    FAT_ARROW,
    RANGE,

    KEYWORD,
    UNKNOWN,
    EOF,

    // String interpolation: `"total: ${count} items"`.
    //
    // **Three kinds rather than one, because the parser has to know where it
    // is.** A literal chunk and an embedded expression alternate, and the
    // expression's tokens are the real ones -- lexed from the source at their
    // own positions, so a mistake inside `${...}` underlines the source the
    // author wrote rather than a reconstruction of it. INTERP_BEGIN carries the
    // text before the first `${`, INTERP_PART the text between one `}` and the
    // next `${`, and INTERP_END the text after the last `}`. Any of the three
    // may carry the empty string.
    //
    // Added at the end of the enum on purpose: these are ordinals, and the
    // pinned seed and the IDE plugin both match on them by number.
    INTERP_BEGIN,
    INTERP_PART,
    INTERP_END
}

// `line`/`col` are 1-based and point at the token's first character; `len` is its
// width in source bytes, which is what a diagnostic underlines. `file` is an id
// into the registry in runtime/diagnostics.c -- an integer rather than a path
// because every token carries one and import resolution merges files from several
// directories into a single AST.
struct Token {
    type: TokenType,
    value: String,
    line: Int,
    col: Int,
    len: Int,
    file: Int,
    tokNext: Ptr // Pointer to next Token
}

// How a token kind reads inside a diagnostic. Deliberately coarser than the enum:
// a reader does not care that `<=` is RELATIONAL_OPERATOR rather than
// ARITHMETIC_OPERATOR, and kinds with no distinct wording fall through to "TOKEN".
public fn typeToString(t: TokenType) -> String {
    match (t) {
        TokenType.STRING_LITERAL => { return "STRING" }
        TokenType.CHAR_LITERAL => { return "CHAR" }
        TokenType.NUMBER_LITERAL => { return "NUMBER" }
        TokenType.FLOAT_LITERAL => { return "FLOAT" }
        TokenType.BOOL_LITERAL => { return "BOOL" }
        TokenType.IDENTIFIER => { return "IDENTIFIER" }
        TokenType.KEYWORD => { return "KEYWORD" }
        TokenType.SEPARATOR => { return "SEPARATOR" }
        TokenType.ARITHMETIC_OPERATOR => { return "OPERATOR" }
        TokenType.RELATIONAL_OPERATOR => { return "REL_OP" }
        TokenType.ASSIGNMENT_OPERATOR => { return "ASSIGN_OP" }
        TokenType.ARROW => { return "ARROW" }
        TokenType.EOF => { return "EOF" }
    }
    return "TOKEN"
}

// Every reserved word, in one place. A module-level array of literals is read-only
// data: nothing is built, allocated or copied when the scanner asks, and anything
// that needs the vocabulary (the scanner, an editor integration's keyword list, a
// test) reads `reservedWords` instead of keeping its own copy.
let reservedWords = [
    "import",

    "match", "if", "else", "and", "or",

    "true", "false",

    "break", "continue", "return", "throw",

    "while", "loop", "for", "in",

    "let", "struct", "impl", "enum", "trait", "where", "fn", "extern",

    "mut", "as",

    // Parameter conventions: ownership and borrows.
    "inout", "sink",

    // SPEC 5.2: pins an arena at this scope. Unlike the FFI contract names, which
    // are contextual, this one opens a statement and so has to be a real keyword.
    "region",

    // REQUIREMENTS 4. The absent reference. A real keyword rather than a
    // contextual name, unlike `unique` and `pin`: those are annotations, and
    // SPEC 5 requires that deleting one leave a working program. `none` is a
    // *value* -- deleting it leaves a hole -- so the obligation does not apply
    // and a keyword is the honest spelling.
    "none",

    // `let x: String = default`. A keyword for `none`'s reason: it is a value, so
    // a binding named `default` would change what the word means below it.
    "default"
]

// A list searched with `contains` rather than a lookup table: the set is small and
// this runs once per identifier.
internal fn isKeyword(word: String) -> Bool {
    return reservedWords.contains(word)
}

internal fn isBoolean(word: String) -> Bool {
    if (word.equals("true")) { return true }
    if (word.equals("false")) { return true }
    return false
}
