// Default_Ignorable_Code_Point: dropped from a UTS #39 skeleton.
// 17 ranges.
public fn isDefaultIgnorable(scalar: Int) -> Bool {
    let table = [
        0x000AD, 0x000AD,
        0x0034F, 0x0034F,
        0x0061C, 0x0061C,
        0x0115F, 0x01160,
        0x017B4, 0x017B5,
        0x0180B, 0x0180F,
        0x0200B, 0x0200F,
        0x0202A, 0x0202E,
        0x02060, 0x0206F,
        0x03164, 0x03164,
        0x0FE00, 0x0FE0F,
        0x0FEFF, 0x0FEFF,
        0x0FFA0, 0x0FFA0,
        0x0FFF0, 0x0FFF8,
        0x1BCA0, 0x1BCA3,
        0x1D173, 0x1D17A,
        0xE0000, 0xE0FFF
    ]
    return identifierRangeRow(table, 17, 2, scalar) >= 0
}

