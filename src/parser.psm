import lexer
import token
import utils
import ast
import diag

struct Parser {
    current: String // Token pointer
}

// When 0, `ident {` is NOT parsed as a struct literal. Disabled while reading
// for-range bounds so `for i in 0..n { ... }` doesn't read the body as a struct.
let mut parser_allow_struct_lit = 1

fn parser_create(tokens: Token) -> Parser {
    return Parser { current: token_to_ptr(tokens) }
}

fn parser_current(p: Parser) -> Token {
    return ptr_to_token(p.current)
}

fn parser_peek(p: Parser) -> Token {
    let mut curr = ptr_to_token(p.current)
    return ptr_to_token(curr.tok_next)
}

fn parser_advance(p: Parser) {
    let mut curr = ptr_to_token(p.current)
    if (curr.type != TokenType.EOF) {
        p.current = curr.tok_next
    }
}

fn parser_check(p: Parser, t: TokenType) -> Bool {
    let mut curr = parser_current(p)
    return curr.type == t
}

fn parser_check_val(p: Parser, t: TokenType, val: String) -> Bool {
    let mut curr = parser_current(p)
    return curr.type == t and str_equals(curr.value, val) == 1
}

fn parser_match(p: Parser, t: TokenType) -> Bool {
    if (parser_check(p, t)) {
        parser_advance(p)
        return true
    }
    return false
}

fn parser_match_val(p: Parser, t: TokenType, val: String) -> Bool {
    if (parser_check_val(p, t, val)) {
        parser_advance(p)
        return true
    }
    return false
}

extern fn exit(code: Int)

// Creates a node already stamped with the position of the token the parser is
// sitting on. Every node the parser builds comes from here rather than from
// create_node(), so a node without a span means "synthesised", not "forgotten".
fn parser_node(p: Parser, kind: NodeKind) -> ASTNode {
    let node = create_node(kind)
    let mut tok = parser_current(p)
    node.line = tok.line
    node.col = tok.col
    node.len = tok.len
    node.file = tok.file
    return node
}

// Reports against the token the parser is looking at -- which is the token that
// was *unexpected*, and so the one worth underlining.
fn parser_error(p: Parser, message: String) {
    let mut tok = parser_current(p)
    diag_error_at(tok.file, tok.line, tok.col, tok.len, message)
}

// How the offending token reads in a message. EOF has no source text, so name it
// rather than quoting the empty string.
fn parser_describe(tok: Token) -> String {
    if (tok.type == TokenType.EOF) {
        return "end of file"
    }
    return diag_quote(tok.value)
}

// Drops tokens until something that plausibly begins a new declaration or
// statement, so one syntax error does not turn the rest of the file into noise.
//
// Prismio has no statement terminator, so the anchors are the keywords that can
// only start a construct, plus '}' which can only end one. Two properties matter:
// it always consumes at least one token (otherwise the parser loops forever on
// the token it could not handle), and it stops *before* the anchor so the caller
// resumes by parsing it normally.
fn parser_synchronize(p: Parser) {
    parser_advance(p)

    let mut scanning = true
    while (scanning) {
        let mut tok = parser_current(p)
        if (tok.type == TokenType.EOF) {
            scanning = false
        } else if (tok.type == TokenType.SEPARATOR and str_equals(tok.value, "}") == 1) {
            scanning = false
        } else if (tok.type == TokenType.KEYWORD) {
            if (str_equals(tok.value, "fn") == 1 or str_equals(tok.value, "let") == 1
                or str_equals(tok.value, "struct") == 1 or str_equals(tok.value, "enum") == 1
                or str_equals(tok.value, "extern") == 1 or str_equals(tok.value, "import") == 1
                or str_equals(tok.value, "impl") == 1 or str_equals(tok.value, "trait") == 1
                or str_equals(tok.value, "if") == 1 or str_equals(tok.value, "while") == 1
                or str_equals(tok.value, "for") == 1 or str_equals(tok.value, "loop") == 1
                or str_equals(tok.value, "match") == 1 or str_equals(tok.value, "return") == 1) {
                scanning = false
            } else {
                parser_advance(p)
            }
        } else {
            parser_advance(p)
        }
    }
}

// A parse error the parser cannot recover from locally. Reports, then stops:
// continuing past a malformed type or parameter list means handing sema an AST
// whose shape does not match what its callers assume, and a crash there is a
// worse experience than one honest error.
fn parser_fatal(p: Parser, message: String) {
    parser_error(p, message)
    diag_finish()
    exit(1)
}

fn parser_expect(p: Parser, t: TokenType, context: String) {
    if (parser_check(p, t) == false) {
        let mut tok = parser_current(p)
        parser_fatal(p, str_concat(str_concat(str_concat("expected ", type_to_string(t)),
                     str_concat(" in ", context)),
                     str_concat(", found ", parser_describe(tok))))
    }
    parser_advance(p)
}

fn parser_expect_val(p: Parser, t: TokenType, val: String, context: String) {
    if (parser_check_val(p, t, val) == false) {
        let mut tok = parser_current(p)
        parser_fatal(p, str_concat(str_concat(str_concat("expected ", diag_quote(val)),
                     str_concat(" in ", context)),
                     str_concat(", found ", parser_describe(tok))))
    }
    parser_advance(p)
}

// ---------------------------------------------------------
// Forward Declarations
// ---------------------------------------------------------
extern fn parse_declaration(p: Parser) -> ASTNode
extern fn parse_type_annotation(p: Parser) -> ASTNode
extern fn parse_variable_decl(p: Parser) -> ASTNode
extern fn parse_extern_fn_decl(p: Parser) -> ASTNode
extern fn parse_function_decl(p: Parser) -> ASTNode
extern fn parse_struct_decl(p: Parser) -> ASTNode
extern fn parse_enum_decl(p: Parser) -> ASTNode
extern fn parse_block(p: Parser) -> ASTNode
extern fn parse_statement(p: Parser) -> ASTNode
extern fn parse_expression(p: Parser, precedence: Int) -> ASTNode
extern fn parse_unary(p: Parser) -> ASTNode
extern fn parse_postfix(p: Parser) -> ASTNode
extern fn parse_primary(p: Parser) -> ASTNode
extern fn parse_module(p: Parser) -> ASTNode

// ---------------------------------------------------------
// Declarations
// ---------------------------------------------------------

fn parse_import_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "import", "import statement")
    
    let import_node = parser_node(p, NodeKind.IMPORT_STATEMENT)
    let mut curr = parser_current(p)
    import_node.s1 = curr.value

    if (curr.type == TokenType.IDENTIFIER or curr.type == TokenType.KEYWORD) {
        parser_advance(p)
    } else {
        parser_fatal(p, str_concat("expected a module name after `import`, found ",
                                   parser_describe(curr)))
    }

    return import_node
}

fn parse_declaration(p: Parser) -> ASTNode {
    if (parser_check_val(p, TokenType.KEYWORD, "import")) {
        return parse_import_statement(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "let")) {
        return parse_variable_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "extern")) {
        return parse_extern_fn_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "fn")) {
        return parse_function_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "struct")) {
        return parse_struct_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "enum")) {
        return parse_enum_decl(p)
    }
    
    // Nothing here starts a declaration. Report it, skip to the next thing that
    // could, and hand back a placeholder -- so a file with three broken
    // functions reports three errors instead of only the first.
    let bad = parser_node(p, NodeKind.ERROR_NODE)
    let mut curr = parser_current(p)
    parser_error(p, str_concat(str_concat("expected a declaration, found ", parser_describe(curr)),
                               " (expected one of `import`, `let`, `fn`, `extern`, `struct`, `enum`)"))
    parser_synchronize(p)
    return bad
}

fn parse_type_annotation(p: Parser) -> ASTNode {
    let type_node = parser_node(p, NodeKind.TYPE_ANNOTATION)
    
    if (parser_match_val(p, TokenType.SEPARATOR, "[")) {
        type_node.i1 = 1 // is_array
        type_node.child1 = node_to_ptr(parse_type_annotation(p))
        parser_expect_val(p, TokenType.SEPARATOR, "]", "array type")
        return type_node
    }
    
    let mut curr = parser_current(p)
    if (curr.type == TokenType.IDENTIFIER or curr.type == TokenType.KEYWORD) {
        type_node.s1 = curr.value
        parser_advance(p)
    } else {
        parser_fatal(p, str_concat("expected a type name, found ", parser_describe(curr)))
    }

    // Generic list type: List<T>
    if (str_equals(type_node.s1, "List") == 1 and parser_match_val(p, TokenType.RELATIONAL_OPERATOR, "<")) {
        type_node.i2 = 1 // is_list
        type_node.child1 = node_to_ptr(parse_type_annotation(p))
        parser_expect_close_angle(p, "list type argument")
    }

    return type_node
}

// Consumes the '>' that closes a generic argument.
//
// The lexer produces `>>` as a single shift token, so `List<List<Int>>` would
// otherwise fail to close the inner argument -- the classic C++ problem. Rather
// than requiring a space, split the token: rewrite it to a single '>' in place
// and leave it for the enclosing type to consume.
fn parser_expect_close_angle(p: Parser, context: String) {
    let mut curr = parser_current(p)
    if (str_equals(curr.value, ">>") == 1) {
        curr.value = ">"
        return
    }
    parser_expect_val(p, TokenType.RELATIONAL_OPERATOR, ">", context)
}

fn parse_variable_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "let", "variable declaration")
    let var_node = parser_node(p, NodeKind.VARIABLE_DECL)
    
    if (parser_match_val(p, TokenType.KEYWORD, "mut")) {
        var_node.i1 = 1 // is_mutable
    }
    
    let mut curr = parser_current(p)
    var_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "variable name")
    
    if (parser_match_val(p, TokenType.SEPARATOR, ":")) {
        var_node.child1 = node_to_ptr(parse_type_annotation(p))
    }
    
    if (parser_match_val(p, TokenType.ASSIGNMENT_OPERATOR, "=")) {
        var_node.child2 = node_to_ptr(parse_expression(p, 0))
    }
    
    return var_node
}

fn parse_extern_fn_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "extern", "extern fn")
    parser_expect_val(p, TokenType.KEYWORD, "fn", "extern fn")
    
    let ext_node = parser_node(p, NodeKind.EXTERN_FUNCTION)
    let mut curr = parser_current(p)
    ext_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "function name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "(", "params")
    
    let mut last_param = ""
    if (parser_check_val(p, TokenType.SEPARATOR, ")") == false) {
        let mut is_looping = true
        while (is_looping) {
            let mut param = parser_node(p, NodeKind.FUNCTION_PARAMETER)
            let mut curr = parser_current(p)
            param.s1 = curr.value
            parser_expect(p, TokenType.IDENTIFIER, "parameter name")
            parser_expect_val(p, TokenType.SEPARATOR, ":", "parameter type")
            param.child1 = node_to_ptr(parse_type_annotation(p))
            
            if (str_equals(ext_node.child1, "") == 1) {
                ext_node.child1 = node_to_ptr(param)
            } else {
                let last = ptr_to_node(last_param)
                last.next = node_to_ptr(param)
            }
            last_param = node_to_ptr(param)
            
            if (parser_match_val(p, TokenType.SEPARATOR, ",") == false) {
                is_looping = false
            }
        }
    }
    parser_expect_val(p, TokenType.SEPARATOR, ")", "params")
    
    if (parser_match_val(p, TokenType.ARROW, "->")) {
        ext_node.child2 = node_to_ptr(parse_type_annotation(p))
    }
    
    return ext_node
}

fn parse_function_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "fn", "function")
    
    let fn_node = parser_node(p, NodeKind.FUNCTION)
    let mut curr = parser_current(p)
    fn_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "function name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "(", "params")
    
    let mut last_param = ""
    if (parser_check_val(p, TokenType.SEPARATOR, ")") == false) {
        let mut is_looping = true
        while (is_looping) {
            let mut param = parser_node(p, NodeKind.FUNCTION_PARAMETER)
            // Optional parameter convention: `sink` (move-in) or `inout` (mutable
            // borrow). Default (none) is a shared read-only borrow.
            if (parser_match_val(p, TokenType.KEYWORD, "sink")) {
                param.s2 = "sink"
            } else {
                if (parser_match_val(p, TokenType.KEYWORD, "inout")) {
                    param.s2 = "inout"
                }
            }
            let mut curr = parser_current(p)
            param.s1 = curr.value
            parser_expect(p, TokenType.IDENTIFIER, "parameter name")
            parser_expect_val(p, TokenType.SEPARATOR, ":", "parameter type")
            param.child1 = node_to_ptr(parse_type_annotation(p))

            if (str_equals(fn_node.child1, "") == 1) {
                fn_node.child1 = node_to_ptr(param)
            } else {
                let last = ptr_to_node(last_param)
                last.next = node_to_ptr(param)
            }
            last_param = node_to_ptr(param)
            
            if (parser_match_val(p, TokenType.SEPARATOR, ",") == false) {
                is_looping = false
            }
        }
    }
    parser_expect_val(p, TokenType.SEPARATOR, ")", "params")
    
    if (parser_match_val(p, TokenType.ARROW, "->")) {
        fn_node.child3 = node_to_ptr(parse_type_annotation(p)) // child3 is ret_type
    }
    
    fn_node.child2 = node_to_ptr(parse_block(p)) // child2 is body
    
    return fn_node
}

fn parse_struct_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "struct", "struct")
    
    let struct_node = parser_node(p, NodeKind.STRUCT_DECL)
    let mut curr = parser_current(p)
    struct_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "struct name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "{", "struct body")
    
    let mut last_field = ""
    while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
        let field = parser_node(p, NodeKind.STRUCT_FIELD)
        let mut curr = parser_current(p)
        field.s1 = curr.value
        parser_expect(p, TokenType.IDENTIFIER, "field name")
        parser_expect_val(p, TokenType.SEPARATOR, ":", "field type")
        field.child1 = node_to_ptr(parse_type_annotation(p))
        
        if (str_equals(struct_node.child1, "") == 1) {
            struct_node.child1 = node_to_ptr(field)
        } else {
            let last = ptr_to_node(last_field)
            last.next = node_to_ptr(field)
        }
        last_field = node_to_ptr(field)
        
        parser_match_val(p, TokenType.SEPARATOR, ",")
    }
    
    parser_expect_val(p, TokenType.SEPARATOR, "}", "struct body")
    return struct_node
}

fn parse_enum_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "enum", "enum")
    
    let enum_node = parser_node(p, NodeKind.ENUM_DECL)
    let mut curr = parser_current(p)
    enum_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "enum name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "{", "enum body")
    
    let mut last_var = ""
    while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
        let variant = parser_node(p, NodeKind.ENUM_VARIANT)
        let mut curr = parser_current(p)
        variant.s1 = curr.value
        parser_expect(p, TokenType.IDENTIFIER, "variant name")
        
        if (str_equals(enum_node.child1, "") == 1) {
            enum_node.child1 = node_to_ptr(variant)
        } else {
            let last = ptr_to_node(last_var)
            last.next = node_to_ptr(variant)
        }
        last_var = node_to_ptr(variant)
        
        parser_match_val(p, TokenType.SEPARATOR, ",")
    }
    
    parser_expect_val(p, TokenType.SEPARATOR, "}", "enum body")
    return enum_node
}
// ---------------------------------------------------------
// Statements
// ---------------------------------------------------------

fn parse_block(p: Parser) -> ASTNode {
    let open = parser_current(p)
    parser_expect_val(p, TokenType.SEPARATOR, "{", "block")
    let block_node = parser_node(p, NodeKind.BLOCK)

    let mut last_stmt = ""
    while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
        // Without this the loop spins at EOF until some inner parser happens to
        // fail, and blames whatever it was looking at instead of the brace that
        // was never closed.
        if (parser_check(p, TokenType.EOF)) {
            diag_error_at(open.file, open.line, open.col, open.len,
                          "this block is never closed; reached end of file looking for `}`")
            diag_finish()
            exit(1)
        }
        let stmt = parse_statement(p)
        if (str_equals(block_node.child1, "") == 1) {
            block_node.child1 = node_to_ptr(stmt)
        } else {
            let last = ptr_to_node(last_stmt)
            last.next = node_to_ptr(stmt)
        }
        last_stmt = node_to_ptr(stmt)
    }
    
    parser_expect_val(p, TokenType.SEPARATOR, "}", "block")
    return block_node
}

fn parse_if_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "if", "if statement")
    
    let if_node = parser_node(p, NodeKind.IF_STATEMENT)
    
    parser_expect_val(p, TokenType.SEPARATOR, "(", "if condition")
    if_node.child1 = node_to_ptr(parse_expression(p, 0))
    parser_expect_val(p, TokenType.SEPARATOR, ")", "if condition")
    
    if_node.child2 = node_to_ptr(parse_block(p))
    
    if (parser_match_val(p, TokenType.KEYWORD, "else")) {
        if (parser_check_val(p, TokenType.KEYWORD, "if")) {
            if_node.child3 = node_to_ptr(parse_if_statement(p))
        } else {
            if_node.child3 = node_to_ptr(parse_block(p))
        }
    }
    
    return if_node
}

fn parse_while_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "while", "while statement")
    
    let while_node = parser_node(p, NodeKind.WHILE_STATEMENT)
    
    parser_expect_val(p, TokenType.SEPARATOR, "(", "while condition")
    while_node.child1 = node_to_ptr(parse_expression(p, 0))
    parser_expect_val(p, TokenType.SEPARATOR, ")", "while condition")
    
    while_node.child2 = node_to_ptr(parse_block(p))
    
    return while_node
}

fn parse_loop_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "loop", "loop statement")
    let loop_node = parser_node(p, NodeKind.LOOP_STATEMENT)
    loop_node.child1 = node_to_ptr(parse_block(p))
    return loop_node
}

fn parse_for_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "for", "for statement")
    let for_node = parser_node(p, NodeKind.FOR_STATEMENT)
    let mut curr = parser_current(p)
    for_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "for loop variable")
    parser_expect_val(p, TokenType.KEYWORD, "in", "for ... in")
    parser_allow_struct_lit = 0
    for_node.child1 = node_to_ptr(parse_expression(p, 0))      // range start
    parser_expect_val(p, TokenType.RANGE, "..", "for range")
    for_node.child2 = node_to_ptr(parse_expression(p, 0))      // range end (exclusive)
    parser_allow_struct_lit = 1
    for_node.child3 = node_to_ptr(parse_block(p))
    return for_node
}

fn parse_match_arm(p: Parser) -> ASTNode {
    let arm = parser_node(p, NodeKind.MATCH_ARM)
    if (parser_match_val(p, TokenType.IDENTIFIER, "_")) {
        arm.s1 = "_"
    } else {
        arm.child1 = node_to_ptr(parse_expression(p, 0))
    }
    parser_expect_val(p, TokenType.FAT_ARROW, "=>", "match arm")
    arm.child2 = node_to_ptr(parse_block(p))
    return arm
}

fn parse_match_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "match", "match statement")
    let match_node = parser_node(p, NodeKind.MATCH_STATEMENT)

    parser_expect_val(p, TokenType.SEPARATOR, "(", "match scrutinee")
    match_node.child1 = node_to_ptr(parse_expression(p, 0))
    parser_expect_val(p, TokenType.SEPARATOR, ")", "match scrutinee")

    parser_expect_val(p, TokenType.SEPARATOR, "{", "match body")
    let mut head = ""
    let mut tail_ptr = ""
    while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
        let arm = parse_match_arm(p)
        if (str_equals(head, "") == 1) {
            head = node_to_ptr(arm)
            tail_ptr = head
        } else {
            let tail = ptr_to_node(tail_ptr)
            tail.next = node_to_ptr(arm)
            tail_ptr = tail.next
        }
        parser_match_val(p, TokenType.SEPARATOR, ",")
    }
    parser_expect_val(p, TokenType.SEPARATOR, "}", "match body")

    match_node.child2 = head
    return match_node
}

fn parse_statement(p: Parser) -> ASTNode {
    if (parser_check_val(p, TokenType.KEYWORD, "if")) {
        return parse_if_statement(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "while")) {
        return parse_while_statement(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "loop")) {
        return parse_loop_statement(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "match")) {
        return parse_match_statement(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "for")) {
        return parse_for_statement(p)
    }
    if (parser_match_val(p, TokenType.KEYWORD, "break")) {
        return parser_node(p, NodeKind.BREAK_STATEMENT)
    }
    if (parser_match_val(p, TokenType.KEYWORD, "continue")) {
        return parser_node(p, NodeKind.CONTINUE_STATEMENT)
    }
    if (parser_match_val(p, TokenType.KEYWORD, "return")) {
        let ret_node = parser_node(p, NodeKind.RETURN_STATEMENT)
        let mut curr = parser_current(p)
        if (curr.type != TokenType.SEPARATOR or str_equals(curr.value, "}") == 0) {
            ret_node.child1 = node_to_ptr(parse_expression(p, 0))
        }
        return ret_node
    }
    if (parser_check_val(p, TokenType.KEYWORD, "let")) {
        return parse_variable_decl(p)
    }
    
    let mut expr = parse_expression(p, 0)

    if (parser_match_val(p, TokenType.ASSIGNMENT_OPERATOR, "=")) {
        let assign_stmt = parser_node(p, NodeKind.ASSIGNMENT_STATEMENT)
        assign_stmt.child1 = node_to_ptr(expr)
        assign_stmt.child2 = node_to_ptr(parse_expression(p, 0))
        return assign_stmt
    }

    // `x op= e` becomes `x = x op e`.
    //
    // Restricted to a plain variable on the left. The desugaring names the
    // target twice, so a target with a subexpression -- `a[i()] += 1`, or
    // `f().field += 1` -- would evaluate that subexpression twice. Rejecting
    // those is better than silently doing it, and the workaround is to write
    // the assignment out in full.
    let assign_tok = parser_current(p)
    if (assign_tok.type == TokenType.ASSIGNMENT_OPERATOR and str_length(assign_tok.value) == 2) {
        let op = str_substring(assign_tok.value, 0, 1)
        parser_advance(p)

        if (expr.kind != NodeKind.IDENTIFIER_EXPR) {
            diag_error_at(expr.file, expr.line, expr.col, expr.len,
                str_concat(str_concat("compound assignment ", diag_quote(assign_tok.value)),
                           " requires a plain variable on the left"))
            diag_note("the desugaring names the target twice, so a subexpression here would be evaluated twice; write the assignment out in full instead")
            diag_finish()
            exit(1)
        }

        let combined = parser_node(p, NodeKind.BINARY_EXPR)
        combined.s1 = op
        combined.child1 = node_to_ptr(expr)
        combined.child2 = node_to_ptr(parse_expression(p, 0))

        let compound = parser_node(p, NodeKind.ASSIGNMENT_STATEMENT)
        compound.child1 = node_to_ptr(expr)
        compound.child2 = node_to_ptr(combined)
        return compound
    }
    
    let stmt = parser_node(p, NodeKind.EXPRESSION_STATEMENT)
    stmt.child1 = node_to_ptr(expr)
    return stmt
}

// ---------------------------------------------------------
// Expressions
// ---------------------------------------------------------

// Bitwise operators bind *tighter* than comparison, unlike C.
//
// C puts & | ^ below == and !=, so `flags & MASK != 0` silently means
// `flags & (MASK != 0)`. That is C's best-known precedence mistake -- Ritchie
// said as much, and both Rust and Go corrected it. Prismio has no compatibility
// reason to inherit it, and the ordering below makes the natural reading the
// correct one. Everything else follows C.
fn get_operator_precedence(t: Token) -> Int {
    if (str_equals(t.value, "or") == 1) { return 1 }
    if (str_equals(t.value, "and") == 1) { return 2 }
    if (t.type == TokenType.KEYWORD) { return 0 }

    if (str_equals(t.value, "==") == 1 or str_equals(t.value, "!=") == 1) { return 3 }
    if (str_equals(t.value, "<") == 1 or str_equals(t.value, ">") == 1 or str_equals(t.value, "<=") == 1 or str_equals(t.value, ">=") == 1) { return 4 }
    if (str_equals(t.value, "|") == 1) { return 5 }
    if (str_equals(t.value, "^") == 1) { return 6 }
    if (str_equals(t.value, "&") == 1) { return 7 }
    if (str_equals(t.value, "<<") == 1 or str_equals(t.value, ">>") == 1) { return 8 }
    if (str_equals(t.value, "+") == 1 or str_equals(t.value, "-") == 1) { return 9 }
    if (str_equals(t.value, "*") == 1 or str_equals(t.value, "/") == 1 or str_equals(t.value, "%") == 1) { return 10 }

    return 0
}

// Prefix operators bind tighter than any binary operator, so they sit between
// parse_expression and parse_primary. Recursing into parse_unary rather than
// parse_primary is what makes `--x` and `!!b` parse.
fn parse_unary(p: Parser) -> ASTNode {
    let mut curr = parser_current(p)

    let is_neg = curr.type == TokenType.ARITHMETIC_OPERATOR and str_equals(curr.value, "-") == 1
    let is_not = curr.type == TokenType.NEGATION and str_equals(curr.value, "!") == 1
    let is_bnot = curr.type == TokenType.ARITHMETIC_OPERATOR and str_equals(curr.value, "~") == 1

    if (is_neg or is_not or is_bnot) {
        let op = curr.value
        parser_advance(p)
        let operand = parse_unary(p)

        // Fold `-<numeric literal>` into the literal itself rather than lowering
        // it to `sub 0, n`. Negative numbers then still count as literals, which
        // is what lets them appear where a constant is required (a global
        // initializer) and what lets `let x: I8 = -5` reach sema's int-literal
        // coercion. Guarded on the leading '-' so `--5` stays a negation of the
        // literal -5 instead of folding into the nonsense literal "--5".
        if (str_equals(op, "-") == 1 and operand.kind == NodeKind.LITERAL_EXPR) {
            let is_number = operand.i1 == TokenType.NUMBER_LITERAL or operand.i1 == TokenType.FLOAT_LITERAL
            if (is_number and str_starts_with(operand.s1, "-") == 0) {
                operand.s1 = str_concat("-", operand.s1)
                // The folded literal's span still covered only the digits, so a
                // diagnostic about `-42` underlined `42`. Widen it to include
                // the sign that is now part of its value.
                operand.line = curr.line
                operand.col = curr.col
                operand.len = operand.len + 1
                return operand
            }
        }

        let unary = parser_node(p, NodeKind.UNARY_EXPR)
        unary.s1 = op
        unary.child1 = node_to_ptr(operand)
        return unary
    }

    return parse_postfix(p)
}

// `expr as Type`. Binds tighter than any binary operator and looser than a
// prefix operator, so `-x as I64` negates first and `a + b as I64` converts only
// b. Looping allows `x as I64 as Float` to chain left to right.
fn parse_postfix(p: Parser) -> ASTNode {
    let mut expr = parse_primary(p)

    let mut casting = true
    while (casting) {
        if (parser_match_val(p, TokenType.KEYWORD, "as")) {
            let cast = parser_node(p, NodeKind.CAST_EXPR)
            cast.child1 = node_to_ptr(expr)
            cast.child2 = node_to_ptr(parse_type_annotation(p))
            expr = cast
        } else {
            casting = false
        }
    }

    return expr
}

fn parse_expression(p: Parser, precedence: Int) -> ASTNode {
    let mut left = parse_unary(p)
    
    let mut is_looping = true
    while (is_looping) {
        let mut curr = parser_current(p)
        
        let is_operator = curr.type == TokenType.ARITHMETIC_OPERATOR or curr.type == TokenType.RELATIONAL_OPERATOR or str_equals(curr.value, "and") == 1 or str_equals(curr.value, "or") == 1
        
        if (is_operator == false) {
            is_looping = false
        } else {
            let current_precedence = get_operator_precedence(curr)
            
            if (current_precedence == 0 or current_precedence < precedence) {
                is_looping = false
            } else {
                let op = curr.value
                parser_advance(p)
                
                // Left associativity: pass current_precedence + 1
                let right = parse_expression(p, current_precedence + 1)
                
                let bin_expr = parser_node(p, NodeKind.BINARY_EXPR)
                bin_expr.s1 = op
                bin_expr.child1 = node_to_ptr(left)
                bin_expr.child2 = node_to_ptr(right)
                
                left = bin_expr
            }
        }
    }
    
    return left
}

fn parse_primary(p: Parser) -> ASTNode {
    let mut curr = parser_current(p)
    
    if (curr.type == TokenType.NUMBER_LITERAL or curr.type == TokenType.FLOAT_LITERAL or curr.type == TokenType.STRING_LITERAL or curr.type == TokenType.BOOL_LITERAL or curr.type == TokenType.CHAR_LITERAL) {
        let lit = parser_node(p, NodeKind.LITERAL_EXPR)
        lit.i1 = curr.type // literal type
        lit.s1 = curr.value
        parser_advance(p)
        return lit
    }
    
    if (curr.type == TokenType.IDENTIFIER) {
        let next_tok = parser_peek(p)
        if (next_tok.type == TokenType.SEPARATOR and str_equals(next_tok.value, "{") == 1 and parser_allow_struct_lit == 1) {
            let struct_lit = parser_node(p, NodeKind.STRUCT_LITERAL_EXPR)
            struct_lit.s1 = curr.value
            parser_advance(p)
            parser_expect_val(p, TokenType.SEPARATOR, "{", "struct literal")
            
            let mut last_field = ""
            while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
                let field = parser_node(p, NodeKind.STRUCT_FIELD)
                let field_tok = parser_current(p)
                field.s1 = field_tok.value
                parser_expect(p, TokenType.IDENTIFIER, "struct literal field")
                parser_expect_val(p, TokenType.SEPARATOR, ":", "struct literal")
                field.child1 = node_to_ptr(parse_expression(p, 0))
                
                if (str_equals(struct_lit.child1, "") == 1) {
                    struct_lit.child1 = node_to_ptr(field)
                } else {
                    let last = ptr_to_node(last_field)
                    last.next = node_to_ptr(field)
                }
                last_field = node_to_ptr(field)
                
                parser_match_val(p, TokenType.SEPARATOR, ",")
            }
            
            parser_expect_val(p, TokenType.SEPARATOR, "}", "struct literal")
            return struct_lit
        }
    }
    
    if (curr.type == TokenType.IDENTIFIER) {
        let ident = parser_node(p, NodeKind.IDENTIFIER_EXPR)
        ident.s1 = curr.value
        parser_advance(p)
        
        let mut expr = ident
        
        let mut is_looping = true
        while (is_looping) {
            // Function call
            if (parser_match_val(p, TokenType.SEPARATOR, "(")) {
                let call = parser_node(p, NodeKind.CALL_EXPR)
                // Point the call at its callee rather than at the first
                // argument, so "expects 1 argument, found 2" underlines the
                // name of the thing being called.
                node_span_from(call, expr)
                call.child1 = node_to_ptr(expr) // callee
                
                let mut last_arg = ""
                if (parser_check_val(p, TokenType.SEPARATOR, ")") == false) {
                    let mut is_arg_looping = true
                    while (is_arg_looping) {
                        let mut arg = parse_expression(p, 0)
                        if (str_equals(call.child2, "") == 1) {
                            call.child2 = node_to_ptr(arg)
                        } else {
                            let last = ptr_to_node(last_arg)
                            last.next = node_to_ptr(arg)
                        }
                        last_arg = node_to_ptr(arg)
                        
                        if (parser_match_val(p, TokenType.SEPARATOR, ",") == false) {
                            is_arg_looping = false
                        }
                    }
                }
                parser_expect_val(p, TokenType.SEPARATOR, ")", "function call")
                expr = call
            } else if (parser_match_val(p, TokenType.SEPARATOR, "[")) {
                // Array indexing
                let index_node = parser_node(p, NodeKind.INDEX_EXPR)
                index_node.child1 = node_to_ptr(expr)
                index_node.child2 = node_to_ptr(parse_expression(p, 0))
                parser_expect_val(p, TokenType.SEPARATOR, "]", "array index")
                expr = index_node
            } else if (parser_match_val(p, TokenType.SEPARATOR, ".")) {
                // Member access
                let member_node = parser_node(p, NodeKind.MEMBER_ACCESS_EXPR)
                member_node.child1 = node_to_ptr(expr)
                let curr_mem = parser_current(p)
                member_node.s1 = curr_mem.value
                parser_expect(p, TokenType.IDENTIFIER, "member name")
                expr = member_node
            } else {
                is_looping = false
            }
        }
        
        return expr
    }
    if (parser_match_val(p, TokenType.SEPARATOR, "(")) {
        let expr_inner = parse_expression(p, 0)
        parser_expect_val(p, TokenType.SEPARATOR, ")", "parenthesized expression")
        return expr_inner
    }
    
    // Array literals
    if (parser_match_val(p, TokenType.SEPARATOR, "[")) {
        let array_lit = parser_node(p, NodeKind.ARRAY_LITERAL_EXPR)
        
        let mut last_elem = ""
        if (parser_check_val(p, TokenType.SEPARATOR, "]") == false) {
            let mut is_looping = true
            while (is_looping) {
                let elem = parse_expression(p, 0)
                
                if (str_equals(array_lit.child1, "") == 1) {
                    array_lit.child1 = node_to_ptr(elem)
                } else {
                    let last = ptr_to_node(last_elem)
                    last.next = node_to_ptr(elem)
                }
                last_elem = node_to_ptr(elem)
                
                if (parser_match_val(p, TokenType.SEPARATOR, ",") == false) {
                    is_looping = false
                }
            }
        }
        
        parser_expect_val(p, TokenType.SEPARATOR, "]", "array literal")
        return array_lit
    }
    
    parser_fatal(p, str_concat(str_concat("expected an expression, found ", parser_describe(curr)),
                               str_concat(" (a ", str_concat(type_to_string(curr.type), ")"))))
    return parser_node(p, NodeKind.ERROR_NODE)
}

// ---------------------------------------------------------
// Main Parse Function
// ---------------------------------------------------------

fn parse_module(p: Parser) -> ASTNode {
    let module = parser_node(p, NodeKind.MODULE)
    let mut last_stmt = ""

    let mut is_looping = true
    while (is_looping) {
        let mut curr = parser_current(p)
        if (curr.type == TokenType.EOF) {
            is_looping = false
        } else {
            let stmt = parse_declaration(p)
            // A placeholder from recovery. Dropping it here is what keeps every
            // later pass free of the question -- nothing downstream has to know
            // that recovery exists.
            if (stmt.kind != NodeKind.ERROR_NODE) {
                if (str_equals(module.child1, "") == 1) {
                    module.child1 = node_to_ptr(stmt)
                } else {
                    let last = ptr_to_node(last_stmt)
                    last.next = node_to_ptr(stmt)
                }
                last_stmt = node_to_ptr(stmt)
            }
        }
    }

    return module
}
