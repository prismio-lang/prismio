// Which standard-library module declares a free function, for a program that names one without
// importing anything that brings it in.
//
// The merge reads only what a program imports, so a call to `println` in a file with no `import
// std.io` meets an empty overload set, and the honest answer used to be "unknown function". The
// import to add is the one thing an editor's quick fix needs (`fix.addImport`), and the library is
// on disk beside the compiler. So on that error path -- never on a program that resolves -- each
// library module's text is read once and its top-level `public fn` lines are kept by name.
//
// **Text, not a parse.** A module's free functions are its column-0 `public fn` lines (a method
// is written inside an `impl`, indented), and parsing every module of the library would put its
// declarations into the compile that is reporting the error. A top-level function whose first
// parameter is `self` is a method all the same, and is not kept: a method comes with its receiver,
// so no import makes a bare call to one legal.

import std.collections.vec
import std.fs
import std.string
import common.native
import common.lang_items
import std.collections.map

// The directory the library's modules are read from, `std/` of a source tree or `stdlib/` of a
// toolchain; "" when none was found. Whether its functions are offered as imports for unknown names.
let mut libraryDirectory = ""
let mut libraryOffersImports = true
// The modules and their files, listed on the first question: module `m` is `libraryModules[m]` at
// `libraryPaths[m]`.
let mut libraryModules: Vec<String>
let mut libraryPaths: Vec<String>
let mut libraryListed = false
// The library's lang items (ast/lang_marks.psm), read from each module's header facts:
// `libraryLangIds[i]` is declared in `libraryModules[libraryLangOwners[i]]` as `libraryLangNames[i]`.
// Every program that needs one asks, so this reads only the metadata of a compiled module.
let mut libraryLangIds: Vec<String>
let mut libraryLangOwners: Vec<Int>
let mut libraryLangNames: Vec<String>
let mut libraryItemsRead = false
// The free functions, read from interface text only when a name turns out to be unknown. Parallel
// columns: function `i` is `libraryNames[i]` in module `libraryModules[libraryOwners[i]]`, and a
// module's own `std` imports are `libraryImports[m]` as `;std.io;std.string;`.
let mut libraryImports: Vec<String>
let mut libraryNames: Vec<String>
let mut libraryOwners: Vec<Int>
// Each module's types and traits, read with the functions: `libraryTypes[i]` is declared in
// `libraryModules[libraryTypeOwners[i]]`.
let mut libraryTypes: Vec<String>
let mut libraryTypeOwners: Vec<Int>
let mut libraryFunctionsRead = false
// What the prelude modules declare (the lazy prelude, driver/imports.psm): name `i` is declared by
// module `libraryModules[libraryPreludeOwners[i]]`.
let mut libraryPreludeNames: Vec<String>
let mut libraryPreludeOwners: Vec<Int>
let mut libraryPreludeRead = false
// The names each package member declares, read on the first question about it: name `i` is declared by `libraryModules[libraryMemberOwners[i]]`.
let mut libraryFactModules: HashMap<String, Int>
let mut libraryFactTexts: Vec<String>
let mut libraryFactsOpened = false
let mut libraryMemberNames: Vec<String>
let mut libraryMemberOwners: Vec<Int>
let mut libraryMembersRead: Vec<Int>
let mut libraryMembersOpened = false

// Where the library is, for the compile about to run. Everything is read again for each directory,
// so that a process that compiles twice never answers from the first one's library.
public fn libraryUseDirectory(directory: String, offerImports: Bool) {
    libraryDirectory = directory.clone()
    libraryOffersImports = offerImports
    libraryListed = false
    libraryItemsRead = false
    libraryFunctionsRead = false
    libraryPreludeRead = false
    libraryMembersOpened = false
    libraryFactsOpened = false
}

// Whether `module` is one file of a package: a program imports the package, never the file.
public fn libraryModuleIsPart(module: String) -> Bool {
    return libraryHeaderHas(libraryFactsOf(module), "part")
}

// What `module` needs, from its header: 0 nothing, 1 the runtime's allocator, 2 an operating system.
public fn libraryModuleTier(module: String) -> Int {
    let facts = libraryFactsOf(module)
    if (libraryHeaderHas(facts, "freestanding(runtime)")) { return 1 }
    if (libraryHeaderHas(facts, "freestanding")) { return 0 }
    return 2
}

public fn libraryModuleIsPrelude(module: String) -> Bool {
    return libraryHeaderHas(libraryFactsOf(module), "prelude")
}

// Every name a program could write after `import std.`, a package's once, with ` prelude` after the
// modules that need no import. What an editor offers (`prismio library-modules`).
public fn libraryImportableModules() -> Vec<String> {
    libraryList()
    let mut found: Vec<String> = []
    let mut names: Vec<String> = []
    for m in 0..<libraryModules.length { names.push(libraryModules[m].clone()) }
    for name in names {
        let mut line = libraryPublicModule(name)
        // The module a wide number asks for is read for the syntax too, never imported.
        if (libraryModuleIsPrelude(name) or libraryModuleHasLang(name, langItemId(LangItem.INT_TEXT))) {
            line = line.concat(" prelude")
        }
        let mut seen = false
        for earlier in found {
            if (earlier.equals(line)) { seen = true }
        }
        if (seen == false) { found.push(line) }
    }
    return found
}

// The name a program imports to reach `module`: the package, for a part of one.
public fn libraryPublicModule(module: String) -> String {
    if (module.equals("") or libraryModuleIsPart(module) == false) { return module.clone() }
    return module.substring(0, module.lastIndexOf("."))
}

// The facts of one module, "" when the library has no such module. Asked of each module a program
// imports, more than once, so it reads that one file, and reads it once.
private fn libraryFactsOf(module: String) -> String {
    libraryList()
    if (libraryFactsOpened == false) {
        libraryFactsOpened = true
        libraryFactModules = HashMap<String, Int>()
        libraryFactTexts = []
    }
    let known = libraryFactModules.getOr(module, -1)
    if (known >= 0) { return libraryFactTexts[known].clone() }
    for m in 0..<libraryModules.length {
        if (libraryModules[m].equals(module)) {
            libraryFactModules.set(module.clone(), libraryFactTexts.length)
            libraryFactTexts.push(libraryModuleFacts(m))
            return libraryFactTexts[libraryFactTexts.length - 1].clone()
        }
    }
    return "".clone()
}

// The source of one module, "" when the library has no such module.
private fn libraryTextOf(module: String) -> String {
    libraryList()
    for m in 0..<libraryModules.length {
        if (libraryModules[m].equals(module)) { return libraryModuleText(m) }
    }
    return "".clone()
}

// The name of the item `id` as a module that `module` imports declares it, or "". What lets one
// lang item be asked of the few modules that can carry it, not of the whole library.
public fn libraryLangNameImportedBy(module: String, id: String) -> String {
    for line in libraryTextOf(module).split("\n") {
        if (line.startsWith("import ") == false) { continue }
        let imported = line.slice(7, line.length).trim()
        let mut facts = libraryFactsOf(imported)
        if (facts.contains("lang(\"")) { facts = libraryLangMeta(facts) }
        let mark = "lang ".concat(id, " ")
        let at = facts.indexOf(mark)
        if (at < 0) { continue }
        let start = at + mark.length
        let mut stop = facts.indexOf("\n", start)
        if (stop < 0) { stop = facts.length }
        return facts.slice(start, stop).clone()
    }
    return "".clone()
}

// What says a module's header and lang items: its source, or a compiled module's metadata.
private fn libraryModuleFacts(m: Int) -> String {
    if (libraryPaths[m].endsWith(".plib")) { return compiler_plib_meta(libraryPaths[m], libraryModules[m]) }
    return readFile(libraryPaths[m])
}

private fn libraryModuleText(m: Int) -> String {
    if (libraryPaths[m].endsWith(".plib")) { return compiler_plib_interface(libraryPaths[m], libraryModules[m]) }
    return readFile(libraryPaths[m])
}

// The names `module` declares that a program could look up, for a package member that is merged only
// when one of them is.
public fn libraryDeclaredNames(module: String) -> Vec<String> {
    libraryList()
    if (libraryMembersOpened == false) {
        libraryMembersOpened = true
        libraryMemberNames = []
        libraryMemberOwners = []
        libraryMembersRead = []
    }
    let mut found: Vec<String> = []
    for m in 0..<libraryModules.length {
        if (libraryModules[m].equals(module) == false) { continue }
        let mut read = false
        for earlier in libraryMembersRead {
            if (earlier == m) { read = true }
        }
        if (read == false) {
            libraryMembersRead.push(m)
            for name in libraryDeclarationNames(libraryModuleText(m)) {
                libraryMemberNames.push(name.clone())
                libraryMemberOwners.push(m)
            }
        }
        for i in 0..<libraryMemberNames.length {
            if (libraryMemberOwners[i] == m) { found.push(libraryMemberNames[i].clone()) }
        }
    }
    return found
}

// Whether some declaration of `module` carries the lang item `id`.
public fn libraryModuleHasLang(module: String, id: String) -> Bool {
    let mut facts = libraryFactsOf(module)
    if (facts.contains("lang(\"")) { facts = libraryLangMeta(facts) }
    return facts.contains("lang ".concat(id, " "))
}

// The library modules that declare a public free function `name`, in module order; empty when
// none does or no library is known. The modules a program reaches into the machine through
// (`std.sys.raw` and its kind) are never offered: importing one is a decision, not a fix.
public fn libraryModulesDeclaring(name: String) -> Vec<String> {
    let mut found: Vec<String> = []
    if (libraryOffersImports == false) { return found }
    libraryReadFunctions()
    for i in 0..<libraryNames.length {
        if (libraryNames[i].equals(name) == false) { continue }
        let owner = libraryPublicModule(libraryModules[libraryOwners[i]])
        let mut seen = false
        for earlier in found {
            if (earlier.equals(owner)) { seen = true }
        }
        if (seen == false) { found.push(owner.clone()) }
    }
    return found
}

// The prelude modules that declare `name`: a function, a method, a property, a type or a trait a
// program may name without importing it. Empty when none does or no library is known. A
// `--freestanding` program is answered too: its tier is checked at the import, as written ones are.
public fn libraryPreludeModulesDeclaring(name: String) -> Vec<String> {
    libraryReadPrelude()
    let mut found: Vec<String> = []
    for i in 0..<libraryPreludeNames.length {
        if (libraryPreludeNames[i].equals(name) == false) { continue }
        let module = libraryModules[libraryPreludeOwners[i]].clone()
        let mut seen = false
        for earlier in found {
            if (earlier.equals(module)) { seen = true }
        }
        if (seen == false) { found.push(module.clone()) }
    }
    return found
}

// The types and traits `module` itself declares.
public fn libraryTypesDeclaredBy(module: String) -> Vec<String> {
    libraryReadFunctions()
    let mut found: Vec<String> = []
    for i in 0..<libraryTypes.length {
        if (libraryModules[libraryTypeOwners[i]].equals(module)) { found.push(libraryTypes[i].clone()) }
    }
    return found
}

// The types and traits that importing `module` brings into a program: its own, and those of every
// library module it imports, directly or not.
public fn libraryTypesImportedWith(module: String) -> Vec<String> {
    libraryReadFunctions()
    let mut reached: Vec<String> = [module.clone()]
    let mut found: Vec<String> = []
    let mut next = 0
    while (next < reached.length) {
        let current = reached[next].clone()
        next = next + 1
        for m in 0..<libraryModules.length {
            if (libraryModules[m].equals(current) == false) { continue }
            for i in 0..<libraryTypes.length {
                if (libraryTypeOwners[i] == m) { found.push(libraryTypes[i].clone()) }
            }
            for imported in libraryImports[m].split(";") {
                if (imported.equals("")) { continue }
                let mut seen = false
                for earlier in reached {
                    if (earlier.equals(imported)) { seen = true }
                }
                if (seen == false) { reached.push(imported.clone()) }
            }
        }
    }
    return found
}

// The one module of `candidates` that each of the others imports, or "". `print` is declared in
// `std.io` and again, for more types, in `std.fmt.display` and `std.fmt.number`; both import `std.io`,
// which is the one a program that prints needs. Two modules that know nothing of each other
// (`std.math` and `std.core.vec` both have a `min`) have no such answer.
public fn libraryBaseModule(candidates: Vec<String>) -> String {
    if (candidates.length == 1) { return candidates[0].clone() }
    let mut base = "".clone()
    for candidate in candidates {
        let mut importedByAll = true
        for other in candidates {
            if (other.equals(candidate)) { continue }
            if (libraryModuleImports(other, candidate) == false) { importedByAll = false }
        }
        if (importedByAll) {
            if (base.equals("") == false) { return "".clone() }
            base = candidate.clone()
        }
    }
    return base
}

private fn libraryModuleImports(module: String, imported: String) -> Bool {
    for m in 0..<libraryModules.length {
        if (libraryModules[m].equals(module)) {
            return libraryImports[m].contains(";".concat(imported, ";"))
        }
    }
    return false
}

// `std.sys` is the library's way into the machine: importing a module of it is a decision a program
// makes, so its functions are never offered as the fix for an unknown name.
private fn libraryIsLowLevel(module: String) -> Bool {
    return module.equals("std.sys") or module.startsWith("std.sys.")
}

private fn libraryList() {
    if (libraryListed) { return }
    libraryListed = true
    libraryModules = []
    libraryPaths = []
    if (libraryDirectory.equals("")) { return }
    libraryListDirectory(libraryDirectory, "std")
}

// The modules of one directory of the library, then of each directory below it. A path segment that
// begins with `_` is sealed to the library (the driver refuses an import of it from outside), so a
// program is never offered one.
private fn libraryListDirectory(directory: String, prefix: String) {
    for entry in listDirectory(directory) {
        if (entry.startsWith("_") or entry.startsWith(".")) { continue }
        let path = joinPath(directory, entry)
        if (directoryExists(path)) {
            libraryListDirectory(path, prefix.concat(".", entry))
            continue
        }
        let mut leaf = "".clone()
        if (entry.endsWith(".psm")) { leaf = entry.slice(0, entry.length - 4).clone() }
        if (entry.endsWith(".plib")) { leaf = entry.slice(0, entry.length - 5).clone() }
        if (leaf.equals("")) { continue }
        libraryModules.push(prefix.concat(".", leaf))
        libraryPaths.push(path.clone())
    }
}

private fn libraryReadItems() {
    if (libraryItemsRead) { return }
    libraryItemsRead = true
    libraryList()
    libraryLangIds = []
    libraryLangOwners = []
    libraryLangNames = []
    for m in 0..<libraryModules.length {
        let mut meta = "".clone()
        if (libraryPaths[m].endsWith(".plib")) {
            meta = compiler_plib_meta(libraryPaths[m], libraryModules[m])
        } else {
            meta = libraryLangMeta(readFile(libraryPaths[m]))
        }
        for line in meta.split("\n") {
            if (line.startsWith("lang ") == false) { continue }
            let words = line.split(" ")
            if (words.length != 3) { continue }
            libraryLangIds.push(words[1].clone())
            libraryLangOwners.push(m)
            libraryLangNames.push(words[2].clone())
        }
    }
}

// The `lang <id> <name>` lines of a module's source, which a compiled module records in its metadata
// (driver/plib.psm): one per line that begins with a marker, a trait's or an `impl`'s member included.
// Found by searching for the marker rather than line by line, since a source library is read whole.
public fn libraryLangMeta(text: String) -> String {
    let mut meta = "".clone()
    let mut at = text.indexOf("lang(\"")
    while (at >= 0) {
        let mut start = at
        while (start > 0 and text.byteAt(start - 1) == 32) { start = start - 1 }
        let mut stop = text.indexOf("\n", at)
        if (stop < 0) { stop = text.length }
        if (start == 0 or text.byteAt(start - 1) == 10) {
            let line = text.slice(at, stop).clone()
            let id = libraryLangMarkId(line)
            if (id.equals("") == false) { meta = meta.concat("lang ", id, " ", libraryLangDeclaredName(line), "\n") }
        }
        at = text.indexOf("lang(\"", stop)
    }
    return meta
}

private fn libraryReadFunctions() {
    if (libraryFunctionsRead) { return }
    libraryFunctionsRead = true
    libraryList()
    libraryImports = []
    libraryNames = []
    libraryOwners = []
    libraryTypes = []
    libraryTypeOwners = []
    for m in 0..<libraryModules.length {
        let mut text = "".clone()
        if (libraryPaths[m].endsWith(".plib")) {
            text = compiler_plib_interface(libraryPaths[m], libraryModules[m])
        } else {
            text = readFile(libraryPaths[m])
        }
        libraryScanModule(m, text, libraryIsLowLevel(libraryModules[m]) == false)
    }
}

private fn libraryReadPrelude() {
    if (libraryPreludeRead) { return }
    libraryPreludeRead = true
    libraryList()
    libraryPreludeNames = []
    libraryPreludeOwners = []
    for m in 0..<libraryModules.length {
        if (libraryHeaderHas(libraryModuleFacts(m), "prelude") == false) { continue }
        for name in libraryDeclarationNames(libraryModuleText(m)) {
            libraryPreludeNames.push(name.clone())
            libraryPreludeOwners.push(m)
        }
    }
}

// Whether a module's header has the word `flag`: the first line that is neither blank nor a comment,
// in its source or in the metadata a compiled module records.
private fn libraryHeaderHas(text: String, flag: String) -> Bool {
    for line in text.split("\n") {
        if (line.equals("") or line.startsWith("//")) { continue }
        if (line.startsWith("module ") == false) { return false }
        for word in line.split(" ") {
            if (word.equals(flag)) { return true }
        }
        return false
    }
    return false
}

// Every name a module declares that a program could look up: its types, traits, type lists and
// globals, and its functions, methods and properties at any depth, except those marked `private` or
// `internal`.
private fn libraryDeclarationNames(text: String) -> Vec<String> {
    let mut names: Vec<String> = []
    for line in text.split("\n") {
        let mut at = 0
        while (at < line.length and line.byteAt(at) == 32) { at = at + 1 }
        let column = at
        if (line.slice(at, line.length).startsWith("lang(\"")) {
            let close = line.indexOf("\")", at)
            if (close < 0) { continue }
            at = close + 2
        }
        loop {
            while (at < line.length and line.byteAt(at) == 32) { at = at + 1 }
            let mut stop = at
            while (stop < line.length and libraryIsNameByte(line.byteAt(stop))) { stop = stop + 1 }
            let word = line.slice(at, stop)
            if (word.equals("public") or word.equals("export") or word.equals("cold")) {
                at = stop
                continue
            }
            if (word.equals("inline")) {
                // `inline` or `inline(always)`.
                at = stop
                if (at < line.length and line.byteAt(at) == 40) {
                    let close = line.indexOf(")", at)
                    if (close < 0) { break }
                    at = close + 1
                }
                continue
            }
            let isTopLevel = column == 0 and (word.equals("struct") or word.equals("enum") or word.equals("trait")
                or word.equals("typelist") or word.equals("let") or word.equals("const"))
            if (isTopLevel == false and word.equals("fn") == false and word.equals("prop") == false) { break }
            at = stop
            while (at < line.length and line.byteAt(at) == 32) { at = at + 1 }
            if (line.slice(at, line.length).startsWith("mut ")) { at = at + 4 }
            stop = at
            while (stop < line.length and libraryIsNameByte(line.byteAt(stop))) { stop = stop + 1 }
            if (stop > at) { names.push(line.slice(at, stop).clone()) }
            break
        }
    }
    return names
}

// One module's free functions and its `std` imports, from its column-0 lines.
private fn libraryScanModule(owner: Int, text: String, offerFunctions: Bool) {
    let mut imports = ";".clone()
    for line in text.split("\n") {
        if (line.startsWith("import std.")) {
            let mut stop = 7
            while (stop < line.length and (libraryIsNameByte(line.byteAt(stop)) or line.byteAt(stop) == 46)) {
                stop = stop + 1
            }
            imports = imports.concat(line.slice(7, stop), ";")
            continue
        }
        let typeName = libraryTopLevelTypeName(line)
        if (typeName.equals("") == false) {
            libraryTypes.push(typeName.clone())
            libraryTypeOwners.push(owner)
        }
        if (offerFunctions == false or line.startsWith("public fn ") == false) { continue }
        let name = libraryFreeFunctionName(line)
        if (name.equals("") == false) {
            libraryNames.push(name.clone())
            libraryOwners.push(owner)
        }
    }
    libraryImports.push(imports.clone())
}

// The name a column-0 `struct`, `enum` or `trait` line declares, past a `lang("id")` marker and
// `public`; "" for any other line.
private fn libraryTopLevelTypeName(line: String) -> String {
    let mut rest = line.slice(0, line.length)
    if (rest.startsWith("lang(\"")) {
        let close = rest.indexOf("\")", 6)
        if (close < 0) { return "".clone() }
        rest = rest.slice(close + 3, rest.length)
    }
    if (rest.startsWith("public ")) { rest = rest.slice(7, rest.length) }
    let mut start = 0
    if (rest.startsWith("struct ") or rest.startsWith("trait ")) { start = rest.indexOf(" ", 0) + 1 }
    else if (rest.startsWith("enum ")) { start = 5 }
    else { return "".clone() }
    let mut stop = start
    while (stop < rest.length and libraryIsNameByte(rest.byteAt(stop))) { stop = stop + 1 }
    return rest.slice(start, stop).clone()
}

// The id of a `lang("id")` marker at the start of a line, or "".
private fn libraryLangMarkId(line: String) -> String {
    if (line.startsWith("lang(\"") == false) { return "".clone() }
    let end = line.indexOf("\")", 6)
    if (end < 0) { return "".clone() }
    return line.slice(6, end).clone()
}

// The name a marked declaration's line declares: `lang("id") public fn name<T>(...)` is `name`.
private fn libraryLangDeclaredName(line: String) -> String {
    let close = line.indexOf("\")", 6)
    if (close < 0) { return "".clone() }
    for word in line.slice(close + 2, line.length).split(" ") {
        if (word.equals("") or word.equals("public") or word.equals("private") or word.equals("internal")
            or word.equals("fn") or word.equals("struct") or word.equals("enum") or word.equals("trait")
            or word.equals("prop")) { continue }
        let mut stop = 0
        while (stop < word.length and libraryIsNameByte(word.byteAt(stop))) { stop = stop + 1 }
        return word.slice(0, stop).clone()
    }
    return "".clone()
}

// The declared name of a lang item as the library text says, or "" when the library has none.
public fn libraryLangName(id: String) -> String {
    libraryReadItems()
    for i in 0..<libraryLangIds.length {
        if (libraryLangIds[i].equals(id)) { return libraryLangNames[i].clone() }
    }
    return "".clone()
}

// The library module that declares a lang item, or "" when none does or no library is known. Asked when
// a program needs an item whose module it never imported, to name the import that supplies it.
public fn libraryLangModule(id: String) -> String {
    libraryReadItems()
    for i in 0..<libraryLangIds.length {
        if (libraryLangIds[i].equals(id)) { return libraryModules[libraryLangOwners[i]].clone() }
    }
    return "".clone()
}

// The name a `public fn` line declares, or "" when it declares a method (first parameter `self`)
// or is not a declaration this scan understands.
private fn libraryFreeFunctionName(line: String) -> String {
    let start = 10
    let mut at = start
    while (at < line.length and libraryIsNameByte(line.byteAt(at))) { at = at + 1 }
    if (at == start or at >= line.length) { return "".clone() }
    let name = line.slice(start, at).clone()
    // Past a generic parameter list, whose bounds may nest angle brackets of their own.
    if (line.byteAt(at) == 60) {
        let mut depth = 0
        while (at < line.length) {
            let b = line.byteAt(at)
            if (b == 60) { depth = depth + 1 }
            if (b == 62) {
                depth = depth - 1
                if (depth == 0) {
                    at = at + 1
                    break
                }
            }
            at = at + 1
        }
    }
    if (at >= line.length or line.byteAt(at) != 40) { return "".clone() }
    at = at + 1
    // The first parameter's name, past the passing-mode words that can come before it.
    loop {
        while (at < line.length and line.byteAt(at) == 32) { at = at + 1 }
        let mut stop = at
        while (stop < line.length and libraryIsNameByte(line.byteAt(stop))) { stop = stop + 1 }
        let word = line.slice(at, stop)
        if (word.equals("inout") or word.equals("mut") or word.equals("sink") or word.equals("borrow")) {
            at = stop
            continue
        }
        if (word.equals("self")) { return "".clone() }
        break
    }
    return name
}

private fn libraryIsNameByte(b: Int) -> Bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95
}
