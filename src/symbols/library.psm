// Which standard-library module declares a free function, for a program that names one without
// importing anything that brings it in.
//
// The merge reads only what a program imports, so a call to `println` in a file with no `import
// std.io` meets an empty overload set, and the honest answer used to be "unknown function". The
// import to add is the one thing an editor's quick fix needs (`fix.addImport`), and the library is
// on disk beside the compiler. So on that error path -- never on a program that resolves -- each
// library module's text is read once and its top-level `public fn` lines are kept by name.
//
// **Text, not a parse.** A module's free functions are its column-0 `public fn` lines (a method
// is written inside an `impl`, indented), and parsing every module of the library would put its
// declarations into the compile that is reporting the error. A top-level function whose first
// parameter is `self` is a method all the same, and is not kept: a method comes with its receiver,
// so no import makes a bare call to one legal.

import std.fs
import std.string
import std.vec
import common.native

// The directory the library's modules are read from, `std/` of a source tree or `stdlib/` of a
// toolchain; "" when none was found. Whether its functions are offered as imports for unknown names.
let mut libraryDirectory = ""
let mut libraryOffersImports = true
// The modules and their files, listed on the first question: module `m` is `libraryModules[m]` at
// `libraryPaths[m]`.
let mut libraryModules: Vec<String>
let mut libraryPaths: Vec<String>
let mut libraryListed = false
// The library's lang items (ast/lang_marks.psm), read from each module's header facts:
// `libraryLangIds[i]` is declared in `libraryModules[libraryLangOwners[i]]` as `libraryLangNames[i]`.
// Every program that needs one asks, so this reads only the metadata of a compiled module.
let mut libraryLangIds: Vec<String>
let mut libraryLangOwners: Vec<Int>
let mut libraryLangNames: Vec<String>
let mut libraryItemsRead = false
// The free functions, read from interface text only when a name turns out to be unknown. Parallel
// columns: function `i` is `libraryNames[i]` in module `libraryModules[libraryOwners[i]]`, and a
// module's own `std` imports are `libraryImports[m]` as `;std.io;std.string;`.
let mut libraryImports: Vec<String>
let mut libraryNames: Vec<String>
let mut libraryOwners: Vec<Int>
let mut libraryFunctionsRead = false

// Where the library is, for the compile about to run. Everything is read again for each directory,
// so that a process that compiles twice never answers from the first one's library.
public fn libraryUseDirectory(directory: String, offerImports: Bool) {
    libraryDirectory = directory.clone()
    libraryOffersImports = offerImports
    libraryListed = false
    libraryItemsRead = false
    libraryFunctionsRead = false
}

// The library modules that declare a public free function `name`, in module order; empty when
// none does or no library is known. The modules a program reaches into the machine through
// (`std.raw` and its kind) are never offered: importing one is a decision, not a fix.
public fn libraryModulesDeclaring(name: String) -> Vec<String> {
    let mut found: Vec<String> = []
    if (libraryOffersImports == false) { return found }
    libraryReadFunctions()
    for i in 0..<libraryNames.length {
        if (libraryNames[i].equals(name) == false) { continue }
        let owner = libraryOwners[i]
        let mut seen = false
        for earlier in found {
            if (earlier.equals(libraryModules[owner])) { seen = true }
        }
        if (seen == false) { found.push(libraryModules[owner].clone()) }
    }
    return found
}

// The one module of `candidates` that each of the others imports, or "". `print` is declared in
// `std.io` and again, for more types, in `std.display` and `std.number_text`; both import `std.io`,
// which is the one a program that prints needs. Two modules that know nothing of each other
// (`std.math` and `std.vec` both have a `min`) have no such answer.
public fn libraryBaseModule(candidates: Vec<String>) -> String {
    if (candidates.length == 1) { return candidates[0].clone() }
    let mut base = "".clone()
    for candidate in candidates {
        let mut importedByAll = true
        for other in candidates {
            if (other.equals(candidate)) { continue }
            if (libraryModuleImports(other, candidate) == false) { importedByAll = false }
        }
        if (importedByAll) {
            if (base.equals("") == false) { return "".clone() }
            base = candidate.clone()
        }
    }
    return base
}

private fn libraryModuleImports(module: String, imported: String) -> Bool {
    for m in 0..<libraryModules.length {
        if (libraryModules[m].equals(module)) {
            return libraryImports[m].contains(";".concat(imported, ";"))
        }
    }
    return false
}

private fn libraryIsLowLevel(module: String) -> Bool {
    return module.equals("std.raw") or module.equals("std.asm") or module.equals("std.port")
        or module.equals("std.syscall")
}

private fn libraryList() {
    if (libraryListed) { return }
    libraryListed = true
    libraryModules = []
    libraryPaths = []
    if (libraryDirectory.equals("")) { return }
    libraryListDirectory(libraryDirectory, "std")
}

// The modules of one directory of the library, then of each directory below it. A path segment that
// begins with `_` is sealed to the library (the driver refuses an import of it from outside), so a
// program is never offered one.
private fn libraryListDirectory(directory: String, prefix: String) {
    for entry in listDirectory(directory) {
        if (entry.startsWith("_") or entry.startsWith(".")) { continue }
        let path = joinPath(directory, entry)
        if (directoryExists(path)) {
            libraryListDirectory(path, prefix.concat(".", entry))
            continue
        }
        let mut leaf = "".clone()
        if (entry.endsWith(".psm")) { leaf = entry.slice(0, entry.length - 4).clone() }
        if (entry.endsWith(".plib")) { leaf = entry.slice(0, entry.length - 5).clone() }
        if (leaf.equals("")) { continue }
        libraryModules.push(prefix.concat(".", leaf))
        libraryPaths.push(path.clone())
    }
}

private fn libraryReadItems() {
    if (libraryItemsRead) { return }
    libraryItemsRead = true
    libraryList()
    libraryLangIds = []
    libraryLangOwners = []
    libraryLangNames = []
    for m in 0..<libraryModules.length {
        let mut meta = "".clone()
        if (libraryPaths[m].endsWith(".plib")) {
            meta = compiler_plib_meta(libraryPaths[m], libraryModules[m])
        } else {
            meta = libraryLangMeta(readFile(libraryPaths[m]))
        }
        for line in meta.split("\n") {
            if (line.startsWith("lang ") == false) { continue }
            let words = line.split(" ")
            if (words.length != 3) { continue }
            libraryLangIds.push(words[1].clone())
            libraryLangOwners.push(m)
            libraryLangNames.push(words[2].clone())
        }
    }
}

// The `lang <id> <name>` lines of a module's source, which a compiled module records in its metadata
// (driver/plib.psm): one per column-0 marker.
public fn libraryLangMeta(text: String) -> String {
    let mut meta = "".clone()
    for line in text.split("\n") {
        let id = libraryLangMarkId(line)
        if (id.equals("")) { continue }
        meta = meta.concat("lang ", id, " ", libraryLangDeclaredName(line), "\n")
    }
    return meta
}

private fn libraryReadFunctions() {
    if (libraryFunctionsRead) { return }
    libraryFunctionsRead = true
    libraryList()
    libraryImports = []
    libraryNames = []
    libraryOwners = []
    for m in 0..<libraryModules.length {
        let mut text = "".clone()
        if (libraryPaths[m].endsWith(".plib")) {
            text = compiler_plib_interface(libraryPaths[m], libraryModules[m])
        } else {
            text = readFile(libraryPaths[m])
        }
        libraryScanModule(m, text, libraryIsLowLevel(libraryModules[m]) == false)
    }
}

// One module's free functions and its `std` imports, from its column-0 lines.
private fn libraryScanModule(owner: Int, text: String, offerFunctions: Bool) {
    let mut imports = ";".clone()
    for line in text.split("\n") {
        if (line.startsWith("import std.")) {
            let mut stop = 7
            while (stop < line.length and (libraryIsNameByte(line.byteAt(stop)) or line.byteAt(stop) == 46)) {
                stop = stop + 1
            }
            imports = imports.concat(line.slice(7, stop), ";")
            continue
        }
        if (offerFunctions == false or line.startsWith("public fn ") == false) { continue }
        let name = libraryFreeFunctionName(line)
        if (name.equals("") == false) {
            libraryNames.push(name.clone())
            libraryOwners.push(owner)
        }
    }
    libraryImports.push(imports.clone())
}

// The id of a `lang("id")` marker at the start of a column-0 line, or "".
private fn libraryLangMarkId(line: String) -> String {
    if (line.startsWith("lang(\"") == false) { return "".clone() }
    let end = line.indexOf("\")", 6)
    if (end < 0) { return "".clone() }
    return line.slice(6, end).clone()
}

// The name a marked declaration's line declares: `lang("id") public fn name<T>(...)` is `name`.
private fn libraryLangDeclaredName(line: String) -> String {
    let close = line.indexOf("\")", 6)
    if (close < 0) { return "".clone() }
    for word in line.slice(close + 2, line.length).split(" ") {
        if (word.equals("") or word.equals("public") or word.equals("private") or word.equals("internal")
            or word.equals("fn") or word.equals("struct") or word.equals("enum") or word.equals("trait")
            or word.equals("prop")) { continue }
        let mut stop = 0
        while (stop < word.length and libraryIsNameByte(word.byteAt(stop))) { stop = stop + 1 }
        return word.slice(0, stop).clone()
    }
    return "".clone()
}

// The declared name of a lang item as the library text says, or "" when the library has none.
public fn libraryLangName(id: String) -> String {
    libraryReadItems()
    for i in 0..<libraryLangIds.length {
        if (libraryLangIds[i].equals(id)) { return libraryLangNames[i].clone() }
    }
    return "".clone()
}

// The library module that declares a lang item, or "" when none does or no library is known. Asked when
// a program needs an item whose module it never imported, to name the import that supplies it.
public fn libraryLangModule(id: String) -> String {
    libraryReadItems()
    for i in 0..<libraryLangIds.length {
        if (libraryLangIds[i].equals(id)) { return libraryModules[libraryLangOwners[i]].clone() }
    }
    return "".clone()
}

// The name a `public fn` line declares, or "" when it declares a method (first parameter `self`)
// or is not a declaration this scan understands.
private fn libraryFreeFunctionName(line: String) -> String {
    let start = 10
    let mut at = start
    while (at < line.length and libraryIsNameByte(line.byteAt(at))) { at = at + 1 }
    if (at == start or at >= line.length) { return "".clone() }
    let name = line.slice(start, at).clone()
    // Past a generic parameter list, whose bounds may nest angle brackets of their own.
    if (line.byteAt(at) == 60) {
        let mut depth = 0
        while (at < line.length) {
            let b = line.byteAt(at)
            if (b == 60) { depth = depth + 1 }
            if (b == 62) {
                depth = depth - 1
                if (depth == 0) {
                    at = at + 1
                    break
                }
            }
            at = at + 1
        }
    }
    if (at >= line.length or line.byteAt(at) != 40) { return "".clone() }
    at = at + 1
    // The first parameter's name, past the passing-mode words that can come before it.
    loop {
        while (at < line.length and line.byteAt(at) == 32) { at = at + 1 }
        let mut stop = at
        while (stop < line.length and libraryIsNameByte(line.byteAt(stop))) { stop = stop + 1 }
        let word = line.slice(at, stop)
        if (word.equals("inout") or word.equals("mut") or word.equals("sink") or word.equals("borrow")) {
            at = stop
            continue
        }
        if (word.equals("self")) { return "".clone() }
        break
    }
    return name
}

private fn libraryIsNameByte(b: Int) -> Bool {
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95
}
