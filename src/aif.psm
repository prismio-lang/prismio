// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// Site kinds, mirroring runtime/aif_support.c. Only "struct" is load-bearing --
// the T0 clause and the copy rule test it -- but the manifest reports the split
// because it is where the residue turns out to live.
let AIF_KIND_STRUCT = 0
let AIF_KIND_STRING = 1
let AIF_KIND_ARRAY = 2
let AIF_KIND_LIST = 3
let AIF_KIND_OPAQUE = 4

// Default round budget. INFERENCE 5.7 makes the budget the only difference
// between optimisation levels; 200 is far past what any observed program needs
// (the compiler's own source converges in single digits), so exhausting it is a
// signal rather than a routine outcome.
let AIF_DEFAULT_ROUNDS = 200

// FFI contract codes. 0 and 1 are FFI 5.1's `borrow` and `retain`; anything >= 2
// is `retain_in(k)` with k = code - 2, which says the callee stores this
// argument into argument k, so it escapes exactly as far as that container does
// and no further.
let AIF_FFI_BORROW = 0
let AIF_FFI_RETAIN = 1
// The callee takes ownership and frees it. Nothing on a stack or in an arena can
// be handed to a free, so this bars T0 the way an explicit `drop` does, and the
// value leaves this frame's control so its escape rises with it.
let AIF_FFI_CONSUME = 2
// The callee writes through the pointer and does not read what was there. No
// ownership consequence at all, so it behaves as `borrow`.
let AIF_FFI_OUT = 3
let AIF_FFI_RETAIN_IN_BASE = 100

// Counters the manifest reports. They exist so that what the model *excludes*
// is visible rather than silent -- an exclusion nobody can see is indistinguish-
// able from a bug.
let mut aif_literal_strings = 0
let mut aif_extern_alloc = 0
let mut aif_opaque_returns = 0
let mut aif_static_returns = 0

// The budget this run was given, so the manifest header reports what was
// actually enforced rather than the default.
let mut aif_budget = 200

// How many loops enclose the statement being walked. LAYOUT 7.1 weights a site's
// contribution to an arena's benefit by the loops between them.
let mut aif_loop_depth = 0

// SPEC 5.4's verdicts, mirroring AIF_PIN_* in runtime/aif_support.c.
let AIF_PIN_NONE = 0
let AIF_PIN_HONOURED = 1
let AIF_PIN_REFUTED = 2
let AIF_PIN_UNPROVEN = 3

// The derivation's root, mirroring AIF_RULE_ALLOC in runtime/aif_support.c: the
// fact was never raised and is still where the allocation put it.
let AIF_RULE_ALLOC = 14

// FFI 5.4: the default contract for an extern nobody declared one for. `borrow`
// is optimistic, `retain` costs 33 points of tier distribution on this
// compiler's own source (RESULTS-L0 4.1). Kept switchable because that
// measurement is the argument for the default.
let mut aif_ffi_default = 0

// The empty value set. -1 rather than an allocated empty one, because
// aif_support.c reads any out-of-range value set as empty and the walk produces
// a great many of these.
fn aif_vs_empty() -> Int {
    return 0 - 1
}

// ---------------------------------------------------------------------------
// Type classification
// ---------------------------------------------------------------------------

// The type a node was given by sema, spelled the way diagnostics spell it.
// Empty for nodes sema does not type -- statements and declarations.
fn aif_node_type(node: ASTNode) -> String {
    if (node_exists(node.type_info)) {
        return type_display(ptr_to_type(node.type_info))
    }
    return ""
}

// `List<Token>` -> `List`. Field keys are per nominal type, so a generic
// container's fields are shared across its instantiations -- object-insensitive
// in the type argument as well as in the object (INFERENCE 11.1).
fn aif_base_type(ty: String) -> String {
    let at = str_index_of(ty, "<")
    if (at < 0) {
        return ty
    }
    return str_substring(ty, 0, at)
}

// Does a value of this type participate in the memory model at all? Scalars and
// enums do not: they are registers, they are copied, and there is nothing to
// reclaim.
fn aif_is_ref(ty: String) -> Bool {
    if (str_equals(ty, "") == 1) { return false }
    if (str_equals(ty, "Int") == 1) { return false }
    if (str_equals(ty, "I8") == 1) { return false }
    if (str_equals(ty, "I16") == 1) { return false }
    if (str_equals(ty, "I32") == 1) { return false }
    if (str_equals(ty, "I64") == 1) { return false }
    if (str_equals(ty, "U8") == 1) { return false }
    if (str_equals(ty, "U16") == 1) { return false }
    if (str_equals(ty, "U32") == 1) { return false }
    if (str_equals(ty, "U64") == 1) { return false }
    if (str_equals(ty, "Isize") == 1) { return false }
    if (str_equals(ty, "Usize") == 1) { return false }
    if (str_equals(ty, "Float") == 1) { return false }
    if (str_equals(ty, "Bool") == 1) { return false }
    if (str_equals(ty, "Char") == 1) { return false }
    if (str_equals(ty, "Void") == 1) { return false }
    if (aif_is_enum(ty) == 1) { return false }
    return true
}

fn aif_kind_of(ty: String) -> Int {
    if (aif_is_struct(ty) == 1) { return AIF_KIND_STRUCT }
    if (str_equals(ty, "String") == 1) { return AIF_KIND_STRING }
    if (str_equals(aif_base_type(ty), "List") == 1) { return AIF_KIND_LIST }
    if (str_starts_with(ty, "[") == 1) { return AIF_KIND_ARRAY }
    if (str_equals(ty, "Array") == 1) { return AIF_KIND_ARRAY }
    return AIF_KIND_OPAQUE
}

fn aif_kind_name(kind: Int) -> String {
    if (kind == AIF_KIND_STRUCT) { return "struct" }
    if (kind == AIF_KIND_STRING) { return "string" }
    if (kind == AIF_KIND_ARRAY) { return "array" }
    if (kind == AIF_KIND_LIST) { return "list" }
    return "opaque"
}

// ---------------------------------------------------------------------------
// FFI ownership contracts (FFI 5)
//
// These describe the Prismio runtime surface. They cannot be inferred -- the
// callee is C -- and both available guesses are wrong: `borrow` everywhere is
// unsound where a callee does retain, and `retain` everywhere sinks every value
// that ever touches a runtime call.
//
// `retain_in(k)` is the entry that matters and it is not in FFI.md's vocabulary
// yet: `list_push` is neither `borrow` nor `retain`, and collections are the
// most common FFI shape in a systems language. Without it every element pushed
// into a list looks like it never escapes, which is optimistic, i.e. unsound.
// ---------------------------------------------------------------------------

// Decodes what an `extern` declaration said, if it said anything.
// Returns -1 when there is no declared contract, so the caller can fall through
// to the runtime table and then to the default.
fn aif_declared_contract(name: String, index: Int) -> Int {
    let text = aif_extern_contract(name, index)
    if (str_equals(text, "") == 1) { return 0 - 1 }

    if (str_equals(text, "borrow") == 1) { return AIF_FFI_BORROW }
    if (str_equals(text, "retain") == 1) { return AIF_FFI_RETAIN }
    if (str_equals(text, "consume") == 1) { return AIF_FFI_CONSUME }
    if (str_equals(text, "out") == 1) { return AIF_FFI_OUT }

    if (str_starts_with(text, "retain_in:") == 1) {
        let k = str_to_int(str_substring(text, 10, str_length(text) - 10))
        return AIF_FFI_RETAIN_IN_BASE + k
    }

    // `alias` and `produce` are return contracts and sema has already rejected
    // them on a parameter, so reaching here means the declaration was malformed
    // and never got past the checker. Default rather than guess.
    return 0 - 1
}

// The ownership semantics of the Prismio runtime's own surface.
//
// **This is a fallback, not the source of truth.** A declared contract wins;
// this only answers for a call whose `extern` says nothing, and it exists
// because these functions' semantics are a property of the runtime rather than
// of any one program's declaration of it -- every corpus program declares
// `list_push` itself, and none of them should have to get it right for the
// analysis to be sound. FFI 5.3a is the measurement that made `retain_in`
// necessary in the first place.
//
// It should shrink as declarations gain contracts, and the entry that matters is
// `list_push`: without it every element pushed into a list appears never to
// escape, which is optimistic and therefore unsound.
fn aif_runtime_contract(name: String, index: Int) -> Int {
    if (str_equals(name, "list_push") == 1) {
        if (index == 1) { return AIF_FFI_RETAIN_IN_BASE + 0 }
        return AIF_FFI_BORROW
    }
    // `list_set(list, index, value)` -- the stored value is argument **2**.
    // Argument 1 is the integer index, and naming it here said the *index*
    // escapes into the container while the value only borrows: optimistic, and
    // therefore exactly the unsoundness the comment above warns about. Both this
    // and the oracle had it, identically, which is how a differential test agrees
    // on a wrong answer. Latent until Level 5, when a stored value that appeared
    // not to escape took a stack slot and list_set wrote a frame pointer into a
    // container that outlives the frame.
    if (str_equals(name, "list_set") == 1) {
        if (index == 2) { return AIF_FFI_RETAIN_IN_BASE + 0 }
        return AIF_FFI_BORROW
    }
    if (str_equals(name, "list_get") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "list_len") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_concat") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_equals") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_length") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_substring") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_index_of") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_contains") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_starts_with") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_ends_with") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_char_at") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "str_byte_at") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "print") == 1) { return AIF_FFI_BORROW }
    if (str_equals(name, "println") == 1) { return AIF_FFI_BORROW }
    return aif_ffi_default
}

// Declared contract, then the runtime table, then FFI 5.1's default.
fn aif_ffi_contract(name: String, index: Int) -> Int {
    let declared = aif_declared_contract(name, index)
    if (declared >= 0) {
        return declared
    }
    return aif_runtime_contract(name, index)
}

// FFI 5.2 `alias`: the return is an existing value reached through an argument,
// not a fresh allocation. Modelled by returning that argument's own sites.
//
// `list_get` is deliberately NOT here any more, and the reason is a soundness
// bug this comment used to describe as fixed: it claimed "an element read back
// out of a list is the element rather than a new object", and returning the
// argument's value set does not do that -- it returns *the list*. Reading an
// element and pushing it into a second container then recorded the container as
// the element, so A-CONTAIN never saw the sharing and the second container was
// told its elements were lists when they were structs. Elements go through
// aif_elem_key now, which is what makes that sentence true.
fn aif_ffi_alias_of(name: String) -> Int {
    // REQUIREMENTS 4. `expect(x)` is the identity on a pointer -- it checks and
    // hands back the same one -- so its result is argument 0's sites. Without
    // this it reads as an opaque extern return: a fresh site, escape raised to
    // Caller, and the unwrapped value would stop being reclaimable by whatever
    // owned the optional.
    if (str_equals(name, "expect") == 1) { return 0 }
    return 0 - 1
}

// Which argument's element field a call reads, or -1. The counterpart of
// `retain_in(k)` on the way out: one says a value was stored into the container
// at k, this says the result came back out of it.
fn aif_ffi_reads_element(name: String) -> Int {
    if (str_equals(name, "list_get") == 1) { return 0 }
    return 0 - 1
}

// A container's contents, as a field key.
//
// Elements are a field of the container, and treating them as one gets the whole
// of INFERENCE 3.1's field-sensitivity for free: object-insensitive, so every
// `List` shares an element key, exactly as `Lexer.source` is one key across every
// Lexer. Through aif_base_type for the same reason its own comment gives --
// merging `List<Token>` with `List<Node>` is imprecise and sound, and keying on
// the spelled type would be neither, because `list_new()` types as `List<Invalid>`
// and an annotated binding does not. Two spellings of one container that did not
// share a key would lose edges, and a lost edge is the unsound direction.
fn aif_elem_key(container_type: String) -> Int {
    return aif_key_field(aif_base_type(container_type), "@elem")
}

// The static type of a call's k-th argument. Walking the argument list again is
// safe only because reading a type creates nothing; evaluating one creates sites,
// which is why the values go through the argv stack instead.
fn aif_arg_type_at(call: ASTNode, index: Int) -> String {
    let mut i = 0
    let mut a_ptr = call.child2
    while (node_exists(a_ptr)) {
        let a = ptr_to_node(a_ptr)
        if (i == index) { return aif_node_type(a) }
        i = i + 1
        a_ptr = a.next
    }
    return ""
}

// FFI 5.2's return contracts, read off the declaration. `alias` says the return
// borrows from an argument or from static storage rather than being a fresh
// allocation, so it must not be modelled as one; `produce` says the caller owns
// it, which is exactly what the undeclared case cannot assume.
fn aif_declared_return_is_produce(name: String) -> Bool {
    return str_starts_with(aif_extern_contract(name, 0 - 1), "produce") == 1
}

fn aif_declared_return_is_alias(name: String) -> Bool {
    return str_equals(aif_extern_contract(name, 0 - 1), "alias") == 1
}

// FFI 5.2 `produce`: a fresh owned value the caller must release. Anything
// undeclared has unknown provenance -- it may already be shared and may already
// outlive this frame -- and is handled by the `opaque` constraint instead.
fn aif_ffi_produces(name: String) -> Bool {
    if (str_equals(name, "list_new") == 1) { return true }
    if (str_equals(name, "str_concat") == 1) { return true }
    if (str_equals(name, "str_substring") == 1) { return true }
    if (str_equals(name, "str_from_char") == 1) { return true }
    if (str_equals(name, "int_to_str") == 1) { return true }
    if (str_equals(name, "read_file") == 1) { return true }
    if (str_equals(name, "get_directory") == 1) { return true }
    if (str_equals(name, "join_path") == 1) { return true }
    return false
}

// ---------------------------------------------------------------------------
// Value-set helpers
// ---------------------------------------------------------------------------

fn aif_vs_of_site(site: Int) -> Int {
    let v = aif_vs_new()
    aif_vs_site(v, site)
    return v
}

fn aif_vs_of_key(key: Int) -> Int {
    let v = aif_vs_new()
    aif_vs_key(v, key)
    return v
}

// The node pointer is what codegen later looks the tier up by, so it is
// registered here rather than derived: the two passes walk the same tree in the
// same process, and one node names one site exactly.
fn aif_new_site(ty: String, fn_id: Int, scope: Int, node_ptr: String) -> Int {
    let node = ptr_to_node(node_ptr)
    let sid = aif_site_new(ty, aif_kind_of(ty), fn_id, scope,
                           node.file, node.line, node.col, aif_struct_nfields(ty))
    aif_site_note_node(sid, node_ptr)
    return sid
}

// ---------------------------------------------------------------------------
// Abstract evaluation
//
// The set of allocation sites an expression may denote, creating a site where
// the expression allocates. Takes a node pointer rather than a node so that the
// recursion never has to reason about who owns the ASTNode it is looking at --
// the same idiom dumpast.psm uses.
// ---------------------------------------------------------------------------

fn aif_sites_of(node_ptr: String, fn_id: Int, scope: Int) -> Int {
    if (node_is_null(node_ptr)) {
        return aif_vs_empty()
    }

    let e = ptr_to_node(node_ptr)
    // Narrower than the statement's position, and it is the one a reader wants:
    // a store's cause is the expression that did the storing, not the line the
    // statement began on.
    aif_con_at(e.file, e.line, e.col)
    let ty = aif_node_type(e)

    if (e.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        // Re-derived rather than `sname = ty`. Strings are affine, and `ty` is
        // read again by the branches below -- a move here would poison it for
        // every one of them, because move state is per name over the whole body.
        let mut sname = e.s1
        if (str_equals(sname, "") == 1) { sname = aif_node_type(e) }

        let sid = aif_new_site(sname, fn_id, scope, node_ptr)
        let owner = aif_vs_of_site(sid)

        let mut f_ptr = e.child1
        while (node_exists(f_ptr)) {
            let f = ptr_to_node(f_ptr)
            if (node_exists(f.child1)) {
                // E-STORE / A-STORE: a field initialiser is a store into the
                // field, and the literal is the container it is stored into.
                aif_field_access(sname, f.s1, aif_loop_depth)
                aif_con_store(aif_key_field(sname, f.s1),
                              aif_sites_of(f.child1, fn_id, scope), owner)
            }
            f_ptr = f.next
        }
        return aif_vs_of_site(sid)
    }

    if (e.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let mut aname = aif_node_type(e)
        if (str_equals(aname, "") == 1) { aname = "Array" }

        let sid = aif_new_site(aname, fn_id, scope, node_ptr)
        let owner = aif_vs_of_site(sid)

        // Elements are stored into the array, exactly as a struct literal's
        // initialisers are stored into its fields. There is no field name to
        // key on, so all elements share one -- field-insensitive within the
        // array type, which is the same granularity the struct case uses.
        let mut el_ptr = e.child1
        while (node_exists(el_ptr)) {
            let el = ptr_to_node(el_ptr)
            aif_con_store(aif_key_field(aname, "[]"),
                          aif_sites_of(el_ptr, fn_id, scope), owner)
            el_ptr = el.next
        }
        return aif_vs_of_site(sid)
    }

    if (e.kind == NodeKind.LITERAL_EXPR) {
        // A string literal is not an allocation. It lowers to an LLVM global --
        // static, immortal, zero cost -- so it has no place on a ladder that
        // ranks ways of reclaiming heap memory. Counted so the exclusion is
        // visible in the manifest rather than silent.
        if (str_equals(ty, "String") == 1) {
            aif_literal_strings = aif_literal_strings + 1
        }
        return aif_vs_empty()
    }

    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        if (aif_is_ref(ty)) {
            return aif_vs_of_key(aif_key_var(fn_id, e.s1))
        }
        return aif_vs_empty()
    }

    if (e.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        if (node_exists(e.child1)) {
            let obj = ptr_to_node(e.child1)
            let obj_ty = aif_node_type(obj)
            if (aif_is_ref(obj_ty)) {
                // LAYOUT 2.1's profile, statically estimated. Every field access
                // in the program passes through here or through the assignment
                // case, so one count per syntactic access is the whole profile.
                // Reads and writes are not separated: the only thing this
                // compiler can act on is field *order*, and order is decided by
                // how often a field is touched, not by which way.
                aif_field_access(aif_base_type(obj_ty), e.s1, aif_loop_depth)
                // Walked for its own allocations; the value of the access is
                // the field node, not the object.
                aif_sites_of(e.child1, fn_id, scope)
                return aif_vs_of_key(aif_key_field(aif_base_type(obj_ty), e.s1))
            }
        }
        return aif_vs_empty()
    }

    // REQUIREMENTS 4. `none` denotes nothing, so it contributes no site. It
    // would fall through to the child walk below and reach the same answer, but
    // the property is load-bearing enough to say out loud: a `T?` field holding
    // `none` puts no site in that field's points-to set, which is what keeps a
    // sometimes-absent field's release derived from the sites that *are* there.
    //
    // The release it derives has to tolerate a null, and all four dispositions
    // now do -- `free(NULL)` is a no-op, list_release and rc_release guard, and
    // the generated release opens with a null test.
    if (e.kind == NodeKind.NONE_LITERAL_EXPR) {
        return aif_vs_empty()
    }

    if (e.kind == NodeKind.CALL_EXPR) {
        return aif_call_sites(node_ptr, fn_id, scope)
    }

    // Everything else contributes whatever its children do.
    let mut out = aif_vs_empty()
    out = aif_vs_union(out, aif_sites_of_chain(e.child1, fn_id, scope))
    out = aif_vs_union(out, aif_sites_of_chain(e.child2, fn_id, scope))
    out = aif_vs_union(out, aif_sites_of_chain(e.child3, fn_id, scope))
    return out
}

fn aif_sites_of_chain(head: String, fn_id: Int, scope: Int) -> Int {
    let mut out = aif_vs_empty()
    let mut p = head
    while (node_exists(p)) {
        let n = ptr_to_node(p)
        out = aif_vs_union(out, aif_sites_of(p, fn_id, scope))
        p = n.next
    }
    return out
}

// A call is where interprocedural flow happens, and where it stops: a function
// whose body this compilation can see gets real parameter and return edges,
// while an extern -- or a sealed function, which is the same situation (PIR 5)
// -- gets its contracts and nothing more.
fn aif_call_sites(call_ptr: String, fn_id: Int, scope: Int) -> Int {
    let e = ptr_to_node(call_ptr)
    let ty = aif_node_type(e)

    // s2 is the mangled symbol sema resolved this call to; the callee node's s1
    // is the name as written, which is what an FFI contract is keyed on.
    let mut callee = e.s2
    let mut plain = callee
    if (node_exists(e.child1)) {
        let target = ptr_to_node(e.child1)
        plain = target.s1
        if (str_equals(callee, "") == 1) { callee = target.s1 }
    }

    let callee_id = aif_fn_lookup(callee)
    let mut known = false
    if (callee_id >= 0) {
        if (aif_fn_is_sealed(callee_id) == 0) { known = true }
    }

    // Arguments are evaluated exactly once, into a frame, because evaluating one
    // creates allocation sites and a contract may name another argument by
    // index. Re-walking to find argument k would duplicate every site inside it.
    let base = aif_argv_begin()
    let mut a_ptr = e.child2
    while (node_exists(a_ptr)) {
        let a = ptr_to_node(a_ptr)
        aif_argv_push(aif_sites_of(a_ptr, fn_id, scope))
        a_ptr = a.next
    }
    let argc = aif_argv_count(base)

    // `drop(x)` lowers to a free, and a stack slot cannot be freed. Suppress T0
    // for whatever it names -- see aif_con_no_stack for why this is a codegen
    // constraint rather than a fact.
    if (str_equals(plain, "drop") == 1) {
        if (argc > 0) {
            aif_con_no_stack(aif_argv_get(base, 0))
        }
    }

    let mut i = 0
    while (i < argc) {
        let av = aif_argv_get(base, i)
        if (known) {
            aif_con_arg(aif_key_param(callee_id, i), av)
        } else {
            let contract = aif_ffi_contract(plain, i)
            if (contract >= AIF_FFI_RETAIN_IN_BASE) {
                let holder_index = contract - AIF_FFI_RETAIN_IN_BASE
                aif_con_retain_in(av, aif_argv_get(base, holder_index))
                // ...and the container's element field now points at it, so a
                // later read gets the element back rather than the container.
                aif_con_bind(aif_elem_key(aif_arg_type_at(e, holder_index)), av)
            } else if (contract == AIF_FFI_RETAIN) {
                aif_con_escape_global(av)
            } else if (contract == AIF_FFI_CONSUME) {
                // The callee frees it, so it must be something a free can take:
                // never a stack slot, and no longer this frame's to reclaim.
                aif_con_no_stack(av)
                aif_con_escape_caller(av)
            } else {
                // FFI 5.1: the callee may read and write during the call but does
                // not retain, so it cannot extend a lifetime. Only A rises.
                aif_con_borrow(av)
            }
        }
        i = i + 1
    }

    let alias_of = aif_ffi_alias_of(plain)
    let mut aliased = aif_vs_empty()
    if (alias_of >= 0 and alias_of < argc) {
        aliased = aif_argv_get(base, alias_of)
    }

    // Reading an element out of a container yields what was stored into it, which
    // is the element field rather than the container. Resolved at the fixed point
    // like any other key, so it does not matter that the pushes may be walked
    // after this read.
    let elem_read_of = aif_ffi_reads_element(plain)
    let mut element = aif_vs_empty()
    let mut reads_element = false
    if (elem_read_of >= 0 and elem_read_of < argc) {
        element = aif_vs_of_key(aif_elem_key(aif_arg_type_at(e, elem_read_of)))
        reads_element = true
    }

    // For a declared `alias`, everything the call could have reached.
    let mut aliased_all = aif_vs_empty()
    let mut aliased_any = false
    let mut a_i = 0
    while (a_i < argc) {
        let one = aif_argv_get(base, a_i)
        if (aif_vs_is_empty(one) == 0) {
            aliased_all = aif_vs_union(aliased_all, one)
            aliased_any = true
        }
        a_i = a_i + 1
    }
    aif_argv_end(base)

    if (known) {
        // Item 3. The caller may own what a known callee returned, and the escape
        // lattice cannot say so -- E is per site and a site belongs to one
        // function, so Region(s) never names a scope in the caller. Recording the
        // call node lets the question be asked of the converged facts later; see
        // aif_owns_call_result_at_node for what it takes to answer yes.
        let ret_vs = aif_vs_of_key(aif_key_ret(callee_id))
        aif_note_call_result(call_ptr, ret_vs, callee_id)
        return ret_vs
    }
    if (reads_element) {
        return element
    }
    if (alias_of >= 0 and alias_of < argc) {
        return aliased
    }
    if (aif_is_ref(ty)) {
        // FFI 5.2 `alias`: the return is not an allocation -- it borrows from an
        // argument or from static storage. Modelling it as a fresh site would
        // invent an allocation that does not exist, which is what makes every
        // `ptr_to_node` result look like an independent opaque value.
        //
        // FFI.md's `alias` names no argument, so the return is the union of the
        // arguments' value sets. That generalises the `list_get` special case
        // rather than adding a second mechanism, and it is the sound reading:
        // whatever the callee could have returned, it reached through one of
        // them.
        //
        // Returning nothing would NOT be sound. A value set with no sites makes
        // every subsequent store through the result a no-op, so nothing inherits
        // the container's escape -- optimistic, and optimistic is the direction
        // that produces a use-after-free rather than a slow program. Where there
        // is nothing to alias, fall through to the opaque path instead.
        if (aif_declared_return_is_alias(plain)) {
            if (aliased_any) {
                return aliased_all
            }
            // `alias` with nothing to alias is FFI 5.2's other case: static
            // storage. That is not an allocation and does not belong on a ladder
            // that ranks ways of reclaiming heap memory -- the same reason a
            // string literal is excluded. Interned names, temp names and the
            // symbol tables are all this shape.
            //
            // The exclusion rests on the declaration being true, which is what
            // FFI 1 means by the boundary being the one place a wrong answer is
            // unsafe. If it is wrong the value leaks rather than being freed
            // twice, which is the direction FFI 5.4 chooses deliberately.
            // Counted so the exclusion is visible rather than silent.
            aif_static_returns = aif_static_returns + 1
            return aif_vs_empty()
        }

        aif_extern_alloc = aif_extern_alloc + 1
        let sid = aif_new_site(ty, fn_id, scope, call_ptr)
        let mut produces = aif_ffi_produces(plain)
        if (aif_declared_return_is_produce(plain)) { produces = true }
        if (produces == false) {
            // Undeclared return: provenance unknown. It may already be shared
            // and may already outlive this frame, so it cannot be modelled as a
            // fresh local allocation.
            aif_opaque_returns = aif_opaque_returns + 1
            aif_con_opaque(aif_vs_of_site(sid))
        }
        return aif_vs_of_site(sid)
    }
    return aif_vs_empty()
}

// ---------------------------------------------------------------------------
// Statement walk
// ---------------------------------------------------------------------------

fn aif_is_statement_kind(k: NodeKind) -> Bool {
    if (k == NodeKind.BLOCK) { return true }
    if (k == NodeKind.VARIABLE_DECL) { return true }
    if (k == NodeKind.ASSIGNMENT_STATEMENT) { return true }
    if (k == NodeKind.RETURN_STATEMENT) { return true }
    if (k == NodeKind.IF_STATEMENT) { return true }
    if (k == NodeKind.WHILE_STATEMENT) { return true }
    if (k == NodeKind.FOR_STATEMENT) { return true }
    if (k == NodeKind.LOOP_STATEMENT) { return true }
    if (k == NodeKind.MATCH_STATEMENT) { return true }
    if (k == NodeKind.MATCH_ARM) { return true }
    if (k == NodeKind.EXPRESSION_STATEMENT) { return true }
    if (k == NodeKind.REGION_STATEMENT) { return true }
    return false
}

// SPEC 5's annotations, read off the declaration the parser stored them on.
//
// They apply to the value set the *initialiser* denotes, not to the name: an
// annotation is a statement about an allocation, and the binding is how the
// source points at one. `let unique b = a` therefore annotates whatever `a`
// already named, which is the same value -- the move made it this scope's.
//
// A malformed tier has already been reported by sema and is skipped here rather
// than guessed at: AIF reports nothing (SPEC 1) and must not turn a warning into
// a different tier.
fn aif_tier_from_name(name: String) -> Int {
    if (str_equals(name, "T0") == 1) { return 0 }
    if (str_equals(name, "T1") == 1) { return 1 }
    if (str_equals(name, "T2") == 1) { return 2 }
    if (str_equals(name, "T3") == 1) { return 3 }
    if (str_equals(name, "T4b") == 1) { return 4 }
    return 0 - 1
}

fn aif_apply_annotations(decl: ASTNode, vs: Int) {
    if (str_equals(decl.s2, "") == 1) { return }

    if (str_contains(decl.s2, "unique ") == 1) {
        aif_con_unique(vs)
    }

    let at = str_index_of(decl.s2, "pin:")
    if (at >= 0) {
        let mut name = str_substring(decl.s2, at + 4, str_length(decl.s2) - at - 4)
        let space = str_index_of(name, " ")
        if (space >= 0) { name = str_substring(name, 0, space) }
        let tier = aif_tier_from_name(name)
        if (tier >= 0) { aif_con_pin(vs, tier) }
    }
}

fn aif_walk(node_ptr: String, fn_id: Int, scope: Int) {
    if (node_is_null(node_ptr)) { return }
    let n = ptr_to_node(node_ptr)

    // Every constraint added from here down is attributed to this statement.
    // SPEC 6.3's witness path puts a file:line on each edge, and the rule alone
    // does not carry one -- "A-STORE" without a position says which rule fired
    // and not where, which is the half a reader cannot supply themselves.
    aif_con_at(n.file, n.line, n.col)

    if (n.kind == NodeKind.BLOCK) {
        // Every scope is an implicit region (INFERENCE 2.1), which is what makes
        // the T0/T1 boundary a size question rather than an escape question.
        // Which of them gets a real arena is LAYOUT 7.1's cost decision, and it
        // needs the block back to tell codegen where to bracket it.
        let inner = aif_scope_new(scope, fn_id)
        aif_scope_note_node(inner, node_ptr)
        aif_scope_set_loop_depth(inner, aif_loop_depth)
        aif_walk_chain(n.child1, fn_id, inner)
        aif_walk_chain(n.child2, fn_id, inner)
        aif_walk_chain(n.child3, fn_id, inner)
        return
    }

    // A loop body allocates once per iteration, not once per entry of the
    // enclosing scope. Tracking the depth is what lets the benefit of an arena
    // inside a loop be weighed against one outside it. The header is outside the
    // body: a `while` condition and a `for` range are evaluated in the enclosing
    // scope, and an allocation there is not the loop's.
    if (n.kind == NodeKind.WHILE_STATEMENT) {
        aif_walk_children(n.child1, fn_id, scope)
        aif_loop_depth = aif_loop_depth + 1
        aif_walk_children(n.child2, fn_id, scope)
        aif_loop_depth = aif_loop_depth - 1
        return
    }

    if (n.kind == NodeKind.LOOP_STATEMENT) {
        aif_loop_depth = aif_loop_depth + 1
        aif_walk_children(n.child1, fn_id, scope)
        aif_loop_depth = aif_loop_depth - 1
        return
    }

    if (n.kind == NodeKind.FOR_STATEMENT) {
        aif_walk_children(n.child1, fn_id, scope)
        aif_walk_children(n.child2, fn_id, scope)
        aif_loop_depth = aif_loop_depth + 1
        aif_walk_children(n.child3, fn_id, scope)
        aif_loop_depth = aif_loop_depth - 1
        return
    }

    // SPEC 5.2. The scope it opens is an ordinary one -- the escape fact would
    // have been the same without the keyword. Naming it is what changes: an
    // allocation whose escape bottoms at or below this scope may be served from
    // an arena rather than the heap, and the manifest can say which one.
    if (n.kind == NodeKind.REGION_STATEMENT) {
        let inner = aif_scope_new(scope, fn_id)
        aif_scope_set_region(inner, n.s1)
        // REQUIREMENTS 19. `region work pin(4096)` asserts a cap on what this
        // arena serves. Recorded here and checked once the facts have converged,
        // for the same reason SPEC 5.4's pins are: the estimate reads tiers.
        if (n.i1 > 0) {
            aif_scope_set_budget(inner, n.i1, n.file, n.line, n.col)
        }
        aif_walk(n.child1, fn_id, inner)
        return
    }

    if (n.kind == NodeKind.VARIABLE_DECL) {
        // Recorded whether or not there is an initialiser: a later assignment to
        // this name needs the declaring scope, and `let x: T` with no value is
        // still a declaration.
        aif_var_note_scope(fn_id, n.s1, scope)
        if (node_exists(n.child2)) {
            let v = aif_sites_of(n.child2, fn_id, scope)
            aif_con_bind(aif_key_var(fn_id, n.s1), v)
            aif_con_live_in(v, scope, fn_id)
            aif_apply_annotations(n, v)
        }
        return
    }

    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        // Value before target, because both may allocate and site identity is
        // creation order. Nothing downstream depends on it, but the oracle
        // orders them this way and a difference here would be invisible until
        // it was not.
        let mut val = aif_vs_empty()
        if (node_exists(n.child2)) {
            val = aif_sites_of(n.child2, fn_id, scope)
        }

        if (node_exists(n.child1)) {
            let tgt = ptr_to_node(n.child1)
            if (tgt.kind == NodeKind.IDENTIFIER_EXPR) {
                aif_con_bind(aif_key_var(fn_id, tgt.s1), val)
                // E-BIND against the *variable's* scope, not the assignment's.
                // A value created in a loop body and assigned to a binding
                // declared outside it survives the iteration, so its escape has
                // to say so. Using the assignment's scope instead reads as "dies
                // at the end of this iteration", which is how a hoisted T0
                // alloca would hand two live values the same slot.
                //
                // Falls back to the assignment's scope for a name with no
                // declaration on record -- a global, which lives longer than any
                // scope anyway and is handled by the store path.
                let mut holder_scope = aif_var_scope(fn_id, tgt.s1)
                if (holder_scope < 0) { holder_scope = scope }
                aif_con_live_in(val, holder_scope, fn_id)
            } else if (tgt.kind == NodeKind.MEMBER_ACCESS_EXPR) {
                let mut owner = aif_vs_empty()
                let mut base = ""
                if (node_exists(tgt.child1)) {
                    let obj = ptr_to_node(tgt.child1)
                    base = aif_base_type(aif_node_type(obj))
                    owner = aif_sites_of(tgt.child1, fn_id, scope)
                }
                aif_field_access(base, tgt.s1, aif_loop_depth)
                aif_con_store(aif_key_field(base, tgt.s1), val, owner)
            }
        }
        return
    }

    if (n.kind == NodeKind.RETURN_STATEMENT) {
        if (node_exists(n.child1)) {
            let v = aif_sites_of(n.child1, fn_id, scope)
            aif_con_bind(aif_key_ret(fn_id), v)
            aif_con_escape_caller(v)
        }
        return
    }

    aif_walk_children(n.child1, fn_id, scope)
    aif_walk_children(n.child2, fn_id, scope)
    aif_walk_children(n.child3, fn_id, scope)
}

fn aif_walk_chain(head: String, fn_id: Int, scope: Int) {
    let mut p = head
    while (node_exists(p)) {
        let n = ptr_to_node(p)
        aif_walk(p, fn_id, scope)
        p = n.next
    }
}

// A child is either a nested statement, which keeps walking, or an expression,
// which is evaluated for its allocations.
fn aif_walk_children(head: String, fn_id: Int, scope: Int) {
    let mut p = head
    while (node_exists(p)) {
        let n = ptr_to_node(p)
        if (aif_is_statement_kind(n.kind)) {
            aif_walk(p, fn_id, scope)
        } else {
            aif_sites_of(p, fn_id, scope)
        }
        p = n.next
    }
}

// ---------------------------------------------------------------------------
// Building the fact graph
// ---------------------------------------------------------------------------

// The type reference graph (INFERENCE 4.4 stage 1) needs an edge from a struct
// to every nominal type its fields can reach. A missing edge is the one
// direction here that is unsound rather than merely imprecise: it makes a
// genuine cycle look acyclic, and a T3 refcount on a cycle leaks.
// ---------------------------------------------------------------------------
// Struct layout
//
// SPEC 4.2's T0 clause tests `size(s) <= Theta_stack`, in bytes. The prototype
// approximates it with field count because a JSON AST dump carries no layout
// (its A5); in the compiler that approximation is not merely imprecise, it is
// the difference between Level 1 doing something and doing nothing. ASTNode is
// 14 fields and about 88 bytes: over a threshold of 8 fields, comfortably under
// one of 256 bytes.
//
// AIF-1's layout is declaration order with natural alignment (SPEC 8.2 grants
// layout freedom; AIF-1 does not use it), so this is not an estimate of what the
// backend will do -- it is the same rule the backend follows.
// ---------------------------------------------------------------------------

// What a field of this type occupies. Size equals alignment for every type
// Prismio has, because every one of them is a scalar or a pointer; the day a
// struct is stored by value that stops being true and this needs the real rule.
// Struct-field ownership. A field's declared type, base-named, which the release
// derivation compares against what the sites say is in the slot. Answers "" when
// the field has no annotation, and the comparison is then skipped.
//
// Base-named for the reason aif_base_type exists: a container made by
// `list_new()` types as `List<Invalid>` and an annotated field as `List<Node>`,
// so comparing the spellings would reject every container field there is.
fn aif_field_type_name(field: ASTNode) -> String {
    if (node_exists(field.child1) == false) { return "" }
    let ann = ptr_to_node(field.child1)
    if (ann.i2 == 1) { return "List" }
    if (ann.i1 == 1) { return "Array" }
    return aif_base_type(ann.s1)
}

fn aif_type_bytes(ann: ASTNode) -> Int {
    // `[T]` and `List<T>` are both a pointer to elements held elsewhere.
    if (ann.i1 == 1) { return 8 }
    if (ann.i2 == 1) { return 8 }

    let n = ann.s1
    if (str_equals(n, "I8") == 1) { return 1 }
    if (str_equals(n, "U8") == 1) { return 1 }
    if (str_equals(n, "Char") == 1) { return 1 }
    if (str_equals(n, "Bool") == 1) { return 1 }
    if (str_equals(n, "I16") == 1) { return 2 }
    if (str_equals(n, "U16") == 1) { return 2 }
    if (str_equals(n, "Int") == 1) { return 4 }
    if (str_equals(n, "I32") == 1) { return 4 }
    if (str_equals(n, "U32") == 1) { return 4 }
    if (str_equals(n, "I64") == 1) { return 8 }
    if (str_equals(n, "U64") == 1) { return 8 }
    if (str_equals(n, "Isize") == 1) { return 8 }
    if (str_equals(n, "Usize") == 1) { return 8 }
    if (str_equals(n, "Float") == 1) { return 8 }
    if (aif_is_enum(n) == 1) { return 4 }

    // String, Ptr, and every struct: a pointer. Structs have reference
    // semantics here, so a struct-typed field is one word rather than the
    // nested layout (COMPILER-AUDIT 2.2).
    return 8
}

fn aif_align_up(offset: Int, align: Int) -> Int {
    let slack = offset % align
    if (slack == 0) { return offset }
    return offset + align - slack
}

// LAYOUT 7.2 runs before this, so the widths are summed in the order codegen will
// emit rather than in declaration order. That is the whole measurable effect of
// the search on this compiler: sorting by descending width removes interior
// padding, and the size it removes feeds Theta_stack, which is what decides T0.
fn aif_compute_struct_size(decl: ASTNode) {
    let mut offset = 0
    let mut max_align = 1

    let n = aif_struct_nfields(decl.s1)
    let mut i = 0
    while (i < n) {
        let width = aif_layout_field_bytes(decl.s1, i)
        if (width > 0) {
            offset = aif_align_up(offset, width) + width
            if (width > max_align) { max_align = width }
        }
        i = i + 1
    }

    // Trailing padding, so an array of these would be correctly strided. A
    // zero-field struct still occupies a byte.
    let mut total = aif_align_up(offset, max_align)
    if (total == 0) { total = 1 }
    aif_struct_set_size(decl.s1, total)
}

// `[T]` and `List<T>` both hang T off child1, so descending finds the type the
// field actually refers to; the annotation's own name is `` or `List`.
fn aif_annotation_leaf_name(ann: ASTNode) -> String {
    let mut name = ann.s1
    let mut child_ptr = ann.child1
    while (node_exists(child_ptr)) {
        let c = ptr_to_node(child_ptr)
        name = c.s1
        child_ptr = c.child1
    }
    return name
}

fn aif_register_type_edges(decl: ASTNode) {
    let mut f_ptr = decl.child1
    while (node_exists(f_ptr)) {
        let f = ptr_to_node(f_ptr)
        if (f.kind == NodeKind.STRUCT_FIELD) {
            if (node_exists(f.child1)) {
                let ann = ptr_to_node(f.child1)
                let reached = aif_annotation_leaf_name(ann)
                if (aif_is_struct(reached) == 1) {
                    aif_type_edge(decl.s1, reached)
                }
            }
        }
        f_ptr = f.next
    }
}

fn aif_declare(module: ASTNode) {
    let mut p = module.child1
    while (node_exists(p)) {
        let d = ptr_to_node(p)

        if (d.kind == NodeKind.STRUCT_DECL) {
            aif_struct_new(d.s1)
            let mut f_ptr = d.child1
            while (node_exists(f_ptr)) {
                let f = ptr_to_node(f_ptr)
                if (f.kind == NodeKind.STRUCT_FIELD) {
                    let mut width = 8
                    if (node_exists(f.child1)) {
                        width = aif_type_bytes(ptr_to_node(f.child1))
                    }
                    aif_struct_add_field(d.s1, f.s1, aif_field_type_name(f), width)
                }
                f_ptr = f.next
            }
        } else if (d.kind == NodeKind.ENUM_DECL) {
            aif_enum_new(d.s1)
        } else if (d.kind == NodeKind.EXTERN_FUNCTION) {
            // Contracts live on each type annotation's s2 (see parser.psm). The
            // return's is filed under index -1.
            let mut index = 0
            let mut p_ptr = d.child1
            while (node_exists(p_ptr)) {
                let param = ptr_to_node(p_ptr)
                if (param.kind == NodeKind.FUNCTION_PARAMETER) {
                    if (node_exists(param.child1)) {
                        let ann = ptr_to_node(param.child1)
                        if (str_equals(ann.s2, "") == 0) {
                            aif_extern_contract_set(d.s1, index, ann.s2)
                        }
                    }
                    index = index + 1
                }
                p_ptr = param.next
            }
            if (node_exists(d.child2)) {
                let ret = ptr_to_node(d.child2)
                if (str_equals(ret.s2, "") == 0) {
                    aif_extern_contract_set(d.s1, 0 - 1, ret.s2)
                }
            }
        } else if (d.kind == NodeKind.FUNCTION) {
            // s2 is the mangled symbol, which is the identity an overloaded name
            // does not have. Falling back to s1 keeps this working on an AST
            // that has not been through sema, which is a debugging convenience
            // rather than a supported path.
            let mut sym = d.s2
            if (str_equals(sym, "") == 1) { sym = d.s1 }
            aif_fn_new(sym, d.s1, d.file)
        }

        p = d.next
    }
}

// Sizes are computed after the layout search, because the search decides the
// order the widths are summed in and therefore the padding. It used to run at the
// top of aif_build, which is before the walk that builds the access profile --
// too early for a size that depends on it.
//
// Still after the declaration pass, for the reason that placement already had: a
// field typed by an enum declared later in the file must be sized as an i32
// rather than as a pointer.
fn aif_compute_sizes(module: ASTNode) {
    let mut p = module.child1
    while (node_exists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            aif_compute_struct_size(d)
        }
        p = d.next
    }
}

fn aif_build(module: ASTNode) {
    // Structs must all exist before any edge is added, because an edge names
    // both ends and fields are declared in whatever order the source has.
    let mut p = module.child1
    while (node_exists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            aif_register_type_edges(d)
        }
        p = d.next
    }
    aif_compute_type_acyclic()

    let mut q = module.child1
    while (node_exists(q)) {
        let d = ptr_to_node(q)
        if (d.kind == NodeKind.FUNCTION) {
            let mut sym = d.s2
            if (str_equals(sym, "") == 1) { sym = d.s1 }
            let fid = aif_fn_lookup(sym)

            if (fid >= 0) {
                let root = aif_scope_new(0 - 1, fid)

                let mut param_ptr = d.child1
                let mut index = 0
                while (node_exists(param_ptr)) {
                    let param = ptr_to_node(param_ptr)
                    if (param.kind == NodeKind.FUNCTION_PARAMETER) {
                        // A parameter is declared at the function root, so a
                        // value assigned to it anywhere in the body outlives
                        // every block inside it.
                        aif_var_note_scope(fid, param.s1, root)
                        let mut pty = aif_node_type(param)
                        if (str_equals(pty, "") == 1) {
                            if (node_exists(param.child1)) {
                                let ann = ptr_to_node(param.child1)
                                pty = ann.s1
                            }
                        }
                        if (aif_is_ref(pty)) {
                            aif_con_bind(aif_key_var(fid, param.s1),
                                         aif_vs_of_key(aif_key_param(fid, index)))
                            // SPEC 5.1 on a parameter. The axiom belongs to what
                            // the caller passed, which is the parameter key --
                            // the binding key would only cover uses inside this
                            // body and the cut is about what comes from outside.
                            if (param.i2 == 1) {
                                aif_con_unique(aif_vs_of_key(aif_key_param(fid, index)))
                            }
                        }
                    }
                    index = index + 1
                    param_ptr = param.next
                }

                aif_walk_chain(d.child2, fid, root)
            }
        }
        q = d.next
    }
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

fn aif_tier_name(tier: Int) -> String {
    if (tier == 0) { return "T0" }
    if (tier == 1) { return "T1" }
    if (tier == 2) { return "T2" }
    if (tier == 3) { return "T3" }
    return "T4b"
}

// SPEC 6.2's `placement` column, which is SPEC 3's codegen contract per tier.
// T1 names the region it is bound to: a `region` statement's name when one
// encloses it and the value cannot outlive it, otherwise the implicit region of
// its own scope, which has no arena and is served by the heap.
fn aif_placement(tier: Int, site: Int) -> String {
    if (tier == 0) { return "stack" }
    if (tier == 1) {
        let named = aif_region_name_at_site(site)
        if (str_equals(named, "") == 0) { return str_concat("region:", named) }
        return "region:scope"
    }
    if (tier == 2) { return "owned" }
    // T3 says the facts permit a count; whether one was emitted is a separate
    // question, and reporting "rc" for a site nothing counts would make the
    // manifest assert a mechanism the binary does not contain. `rc:none` is a
    // value that leaks: an opaque pointer with no header of ours in front of it,
    // a string or list allocated past the seam, or one held by no container.
    if (tier == 3) {
        if (aif_site_is_rc(site) == 1) { return "rc" }
        return "rc:none"
    }
    // T4b, and the same distinction one tier up. `rc+cycle` was printed for every
    // T4b site while the collector did not exist -- the manifest asserting a
    // mechanism the binary did not contain, which is exactly what the `rc`/
    // `rc:none` split was introduced to stop. `cycle:none` is a value the
    // collector cannot take: an opaque pointer, one allocated past the seam, or
    // one no container holds, so nothing ever decrements it into a candidate.
    if (aif_site_is_cyclic(site) == 1) { return "rc+cycle" }
    return "cycle:none"
}

fn aif_count_tier(tier: Int) -> Int {
    let mut n = 0
    let mut i = 0
    let total = aif_site_count()
    while (i < total) {
        if (aif_tier_of(i) == tier) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn aif_count_kind(kind: Int) -> Int {
    let mut n = 0
    let mut i = 0
    let total = aif_site_count()
    while (i < total) {
        if (aif_site_kind(i) == kind) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn aif_count_kind_tier(kind: Int, tier: Int) -> Int {
    let mut n = 0
    let mut i = 0
    let total = aif_site_count()
    while (i < total) {
        if (aif_site_kind(i) == kind and aif_tier_of(i) == tier) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn aif_pad(s: String, width: Int) -> String {
    let mut out = s
    let mut n = str_length(s)
    while (n < width) {
        out = str_concat(out, " ")
        n = n + 1
    }
    return out
}

fn aif_kv(key: String, value: String) {
    print(aif_pad(key, 12))
    println(value)
}

fn aif_site_position(site: Int) -> String {
    let path = diag_file_path(aif_site_file(site))
    return str_concat(str_concat(path, ":"), str_concat(int_to_str(aif_site_line(site)),
           str_concat(":", int_to_str(aif_site_col(site)))))
}

// The manifest's record name. Numbering within the declaring function rather
// than by source position is what keeps a diff readable: an edit shows up on the
// function it changed, and adding a line at the top of a file does not rewrite
// every record below it.
fn aif_symbol_of(site: Int) -> String {
    let owner = aif_site_fn(site)
    let mut base = "<module>"
    if (owner >= 0) { base = aif_fn_symbol(owner) }
    return str_concat(str_concat(base, "#"), int_to_str(aif_site_ordinal(site)))
}

// SPEC 6.2. Line-oriented UTF-8, records sorted byte-wise ascending by symbol --
// the sort is normative, because an unstable order makes every diff useless.
fn aif_emit_manifest(source_path: String, version: String, converged: Bool) {
    let total = aif_site_count()

    println("aif-manifest 1")
    aif_kv("level", "AIF-1")
    // `prismio aif` never runs codegen, so the manifest it prints describes an
    // analysis, not a build. SPEC 7.3's verify mode changes the allocator names
    // and nothing the inference does, so the facts here are the same either way.
    aif_kv("build", "release")
    aif_kv("budget", str_concat(int_to_str(aif_budget), " rounds"))
    if (converged) {
        aif_kv("converged", "yes")
    } else {
        aif_kv("converged", "no")
    }
    // Split because the two phases truncate very differently: a budget that
    // stops the points-to phase leaves the whole graph unproven, one that stops
    // the fact phase leaves only a frontier.
    aif_kv("rounds", str_concat(str_concat(int_to_str(aif_rounds()), " (points-to "),
                                str_concat(int_to_str(aif_pt_rounds()), ")")))
    // SPEC 4.2 requires the implementation document its Theta_stack. This is
    // where it does it.
    let mut theta_unit = " bytes"
    if (aif_theta_mode() == 1) { theta_unit = " fields (oracle-parity mode)" }
    aif_kv("theta-stack", str_concat(int_to_str(aif_theta_stack()), theta_unit))
    aif_kv("ffi-default", "borrow")
    aif_kv("compiler", str_concat("prismio ", version))
    aif_kv("llvm", ir_llvm_version())
    aif_kv("source", source_path)
    aif_kv("sites", int_to_str(total))
    // CYCLES 2's headline result, and it costs one line: a program whose types
    // have no non-trivial SCC needs no cycle collector, and this is where the
    // compiler says so. It is a property of the type declarations, checkable
    // before any inference runs -- not a tuning outcome and not a heuristic.
    // REQUIREMENTS 19. The arena high-water mark, which is what a fixed-budget
    // target needs from a build artifact. An estimate, and it names the part it
    // cannot see rather than guessing at it: a struct's size comes from its
    // layout, a string's is its length, and a fabricated per-string constant
    // would make the `pin` gate turn on a number nobody computed.
    let unsized = aif_arena_unsized_sites()
    let mut budget_note = str_concat(int_to_str(aif_arena_high_water()), " bytes peak arena (est.)")
    if (unsized > 0) {
        budget_note = str_concat(budget_note,
                                 str_concat(str_concat(", ", int_to_str(unsized)),
                                            " dynamically-sized site(s) excluded"))
    }
    aif_kv("peak-bytes", budget_note)

    let scc_types = aif_scc_type_count()
    if (scc_types == 0) {
        aif_kv("cycles", "none")
    } else {
        aif_kv("cycles", str_concat(str_concat("collector (", int_to_str(scc_types)),
                                    str_concat(" cyclic type(s), ",
                                    str_concat(int_to_str(aif_t4b_site_count()), " T4b site(s))"))))
    }
    println("#")
    println("# symbol                                      tier  placement         type            layout  origin            site")

    let mut i = 0
    while (i < total) {
        aif_order_add(aif_symbol_of(i), i)
        i = i + 1
    }
    aif_order_sort()

    // A record whose facts came from a truncated iteration is not a settled
    // proof, and SPEC 6.2 makes that visible: a reviewer should read a large
    // budget-exhausted population as a signal to raise the budget, not as a
    // result. Only the widened frontier is marked -- the rest of a truncated
    // build converged, and calling those records exhausted too would make the
    // signal useless for deciding whether to raise the budget.
    let n = aif_order_count()
    let mut r = 0
    while (r < n) {
        let site = aif_order_site(r)
        let tier = aif_tier_of(site)
        // SPEC 6.2's vocabulary. `region` means the arena serving this site was
        // pinned by a `region` statement rather than chosen by LAYOUT 7.1's cost
        // model -- a pin that stops being honoured is a gate regression and an
        // inferred placement moving is not, so the two have to be tellable apart.
        let mut origin = "inferred"
        if (aif_site_arena_is_pinned(site) == 1) { origin = "region" }
        if (aif_site_alias_axiom(site) == 1) { origin = "unique" }
        if (aif_site_pin_verdict(site) == AIF_PIN_HONOURED) { origin = "pin" }
        if (aif_site_widened(site) == 1) { origin = "budget-exhausted" }
        print(aif_pad(aif_order_symbol(r), 44))
        print(aif_pad(aif_tier_name(tier), 6))
        print(aif_pad(aif_placement(tier, site), 18))
        print(aif_pad(aif_site_type(site), 16))
        // LAYOUT 6's grouping dimension is always AoS -- SoA needs handles, which
        // is 1's finding 6 -- so what this column can actually report is whether
        // the field-order search moved anything. `AoS*` is a struct whose physical
        // order is not its declaration order.
        let mut grouping = "AoS"
        if (aif_layout_reordered(aif_site_type(site)) == 1) { grouping = "AoS*" }
        print(aif_pad(grouping, 8))
        print(aif_pad(origin, 18))
        println(aif_site_position(site))
        r = r + 1
    }
}

fn aif_emit_kind_row(kind: Int) {
    let n = aif_count_kind(kind)
    if (n == 0) { return }
    print("  ")
    print(aif_pad(aif_kind_name(kind), 9))
    print(aif_pad(int_to_str(n), 8))
    let mut t = 0
    while (t < 5) {
        print(aif_pad(int_to_str(aif_count_kind_tier(kind, t)), 7))
        t = t + 1
    }
    println("")
}

// The distribution, in the form the oracle prints it. This is what gets compared
// against aif/prototype/aif.py, so it reports the same quantities under the same
// names -- including the exclusions, because a site the model declines to count
// is exactly the kind of difference that would otherwise hide a real one.
fn aif_emit_summary(source_path: String, converged: Bool) {
    let total = aif_site_count()
    let mut denom = total
    if (denom == 0) { denom = 1 }

    print("# ")
    print(source_path)
    print("  (")
    print(int_to_str(aif_fn_count()))
    print(" functions, ")
    print(int_to_str(aif_nominal_count()))
    println(" nominal types)")

    print("aif-manifest 1 (in-compiler)  rounds=")
    print(int_to_str(aif_rounds()))
    print("  converged=")
    if (converged) { print("yes") } else { print("no") }
    print("  constraints=")
    println(int_to_str(aif_con_count()))

    print("sites        ")
    print(int_to_str(total))
    print("   (excluded: ")
    print(int_to_str(aif_literal_strings))
    println(" string literals -- static, not allocated)")

    print("opaque-ret   ")
    print(int_to_str(aif_opaque_returns))
    println("  (undeclared extern/sealed returns -- provenance unknown)")

    print("extern-alloc ")
    print(int_to_str(aif_extern_alloc))
    println("  (values produced by runtime calls, e.g. str_concat)")

    print("static-ret   ")
    print(int_to_str(aif_static_returns))
    println("  (declared `alias` with nothing to alias -- static, not allocated)")

    println("#")
    println("# tier distribution  (BENCHMARKS H1: static D over abstract values)")

    let mut cheap = 0
    let mut t = 0
    while (t < 5) {
        let n = aif_count_tier(t)
        if (t < 3) { cheap = cheap + n }
        print("  ")
        print(aif_pad(aif_tier_name(t), 5))
        print(aif_pad(int_to_str(n), 8))
        print(aif_pad(str_concat(int_to_str(100 * n / denom), "%"), 6))
        let mut bar = ""
        let mut b = 0
        let width = 60 * n / denom
        while (b < width) {
            bar = str_concat(bar, "#")
            b = b + 1
        }
        println(bar)
        t = t + 1
    }

    println("")
    print("  T0-T2 (no runtime bookkeeping): ")
    print(int_to_str(cheap))
    print(" / ")
    print(int_to_str(total))
    print(" = ")
    print(int_to_str(100 * cheap / denom))
    println("%")
    print("  H1 kill criterion is < 70%.  ")
    if (100 * cheap / denom >= 70) { println("PASS") } else { println("FAIL") }

    println("")
    println("# by allocation kind -- where the residue actually lives")
    println("  kind     sites   T0     T1     T2     T3     T4b")
    let mut k = 0
    while (k < 5) {
        aif_emit_kind_row(k)
        k = k + 1
    }

    println("")
    println("# cyclicity (CYCLES 1-2)")
    let mut cyclic = 0
    let mut structs = 0
    let mut i = 0
    while (i < aif_nominal_count()) {
        if (aif_nominal_is_struct(i) == 1) {
            structs = structs + 1
            if (aif_nominal_acyclic(i) == 0) { cyclic = cyclic + 1 }
        }
        i = i + 1
    }
    if (cyclic == 0) {
        print("  none -- no struct type lies in a non-trivial SCC, of ")
        print(int_to_str(structs))
        println(" struct types.")
        println("  The collector can be omitted from the binary entirely.")
    } else {
        print("  collector needed: ")
        print(int_to_str(cyclic))
        print(" of ")
        print(int_to_str(structs))
        println(" struct types lie in or reach a non-trivial SCC")
    }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

// Runs the whole engine over a merged, type-checked module and reports.
//
// Called after analyze_module and before generate_module. It reads the AST and
// writes nothing back to it.
//
// **This used to claim that SPEC 7.1's zero-analysis mode was true by
// construction, "because nothing it produces is an input to codegen yet". That
// was true at Level 0 and has been false since Level 1.** Inference now drives
// codegen at eight points -- stack promotion, arena placement, scope drops,
// container element disposition, refcounting, struct-field release, cycle
// collection, and field order -- so the invariant is a property that has to be
// *tested*, not asserted. `--debug` and run_no_inference_test are what make it
// falsifiable; see SPEC 7.2's level table for what the budget of zero means.
// Build the graph and solve. Reports nothing -- `build` runs this and then asks
// aif_tier_at() per allocation site, while the `aif` command runs it and prints.
//
// Returns whether inference converged. A false return is not a failure: SPEC 1
// makes giving up a performance outcome, and aif_widen has already raised the
// unproven facts to the conservative end, so every tier that follows is at or
// above the true one.
fn aif_run(module: ASTNode, owned_collections: Bool, theta_fields: Bool,
           budget: Int) -> Bool {
    aif_reset()
    aif_literal_strings = 0
    aif_extern_alloc = 0
    aif_opaque_returns = 0
    aif_static_returns = 0
    aif_budget = budget
    aif_loop_depth = 0

    if (owned_collections) {
        aif_set_owned_collections(1)
    } else {
        aif_set_owned_collections(0)
    }
    if (theta_fields) {
        aif_set_theta_mode(1)
    } else {
        aif_set_theta_mode(0)
    }

    aif_declare(module)
    aif_build(module)

    // LAYOUT 7.2, and it has to sit exactly here. The access profile is built by
    // the walk above, and the sizes below are summed in the order this chooses --
    // which is what feeds Theta_stack, which is what the T0 clause reads. Before
    // the walk there is no profile; after the solve the sizes are already stamped
    // onto every site.
    // SPEC 7.2's `debug` level is a budget of **zero rounds**, and its row also
    // says "layout search: none". Gated on the budget rather than on a separate
    // flag because 7.2 is explicit that the levels are budgets and not different
    // algorithms -- the same engine runs at every one of them. `--budget=` on the
    // `aif` command refuses anything below 1, so zero means this and only this.
    if (budget > 0) {
        aif_layout_select()
    }
    aif_compute_sizes(module)

    let converged = aif_solve(budget) == 1
    if (converged == false) {
        // INFERENCE 5.3: a truncated ascending iteration is a pre-fixed point,
        // so its facts are too optimistic. Widening to a post-fixed point is
        // mandatory, not an optimisation.
        aif_widen()
    }

    // SPEC 5.4, before the arenas: a pin freezes a tier and the cost model ranks
    // scopes by tiers, so the pins have to be settled first or an arena could be
    // placed for a site whose tier is about to change.
    if (converged) {
        aif_check_pins(1)
    } else {
        aif_check_pins(0)
    }

    // LAYOUT 7.1, after the facts and after widening: every input to the cost
    // model is a converged (or conservatively raised) tier, so placing arenas
    // earlier would be ranking scopes by numbers still in motion.
    aif_place_arenas()
    return converged
}

// ---------------------------------------------------------------------------
// Minimal cause and ranked repairs -- SPEC 6.3, INFERENCE 5.6
//
// `prismio aif <src> --why <symbol>` prints the witness path for one manifest
// record, in the layout SPEC 6.3 specifies: the tier, the fact that moved, the
// edges that moved it innermost-first, and the repairs that would undo it.
//
// The split between here and tools/aif_manifest_diff.py is deliberate: only the
// compiler has the derivation, and only the differ knows what changed. The differ
// finds the regressed symbols and asks for each one.
// ---------------------------------------------------------------------------

// The repair for an edge is a property of the rule that fired, because breaking
// the edge is what restores the tier and the rule says what breaking it means.
// Cost is stated in the units a reader can act on -- a copy, a declaration, or
// nothing -- rather than in cycles, which would be a modelled number pretending
// to be a measured one.
fn aif_repair_for(rule: Int) -> String {
    if (str_equals(aif_rule_name(rule), "E-STATIC") == 1) {
        return "make the destination region-scoped instead of static     restores T1, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "E-RETURN") == 1) {
        return "have the caller allocate and pass it in                  restores T1, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "E-OPAQUE") == 1) {
        return "declare the extern's return contract (FFI 5.2)           restores T2, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "A-STORE") == 1) {
        return "store a copy instead of the value                        restores T2, +1 copy per store"
    }
    if (str_equals(aif_rule_name(rule), "A-RETAIN") == 1) {
        return "declare the parameter `borrow` if the callee keeps nothing  restores T2, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "A-COPY") == 1) {
        return "make the type move-only so a second holder is a move     restores T2, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "E-BIND") == 1) {
        return "declare the binding inside the scope that uses it        restores T1, no runtime cost"
    }
    return ""
}

fn aif_emit_cause(site: Int, converged: Bool) {
    let domain = aif_cause_domain_for(site)
    let n = aif_cause_build(site, domain)

    print(aif_pad(aif_symbol_of(site), 32))
    print("  ")
    println(aif_tier_name(aif_tier_of(site)))
    println("")

    println("  minimal cause")

    // A path of one edge whose rule is ALLOC means nothing ever raised the fact:
    // it is still at the bottom the site was created with. Saying "rose to" there
    // would describe a propagation that did not happen.
    let mut fact = aif_escape_name(aif_cause_value(0))
    if (domain == 1) { fact = aif_alias_name(aif_cause_value(0)) }
    let mut label = "    E rose to "
    if (domain == 1) { label = "    A rose to " }
    if (aif_cause_rule(0) == AIF_RULE_ALLOC) {
        label = "    E is still "
        if (domain == 1) { label = "    A is still " }
    }
    print(label)
    println(fact)

    let mut i = 0
    while (i < n) {
        let rule = aif_cause_rule(i)
        print("      <- ")
        print(aif_pad(aif_rule_name(rule), 10))
        print(aif_pad(diag_file_path(aif_cause_file(i)), 36))
        print(" ")
        print(int_to_str(aif_cause_line(i)))
        print(":")
        println(int_to_str(aif_cause_col(i)))
        i = i + 1
    }

    println("")
    println("  repairs, cheapest first")

    // Walked outermost-first: the root cause is the cheapest thing to change,
    // because everything downstream of it follows. An edge with no repair is one
    // whose rule is not a choice the programmer made -- ALLOC, or a propagation
    // step -- and listing "no action available" for it would be noise.
    let mut rank = 1
    let mut j = n - 1
    while (j >= 0) {
        let repair = aif_repair_for(aif_cause_rule(j))
        if (str_equals(repair, "") == 0) {
            print("    ")
            print(int_to_str(rank))
            print(". ")
            println(repair)
            rank = rank + 1
        }
        j = j - 1
    }

    // SPEC 6.3: a repair that is unsound SHALL be listed as rejected with its
    // reason. Pinning the tier back is the one every reader reaches for first,
    // and it is exactly the one a converged analysis refuses (SPEC 5.4.1) --
    // which is also why the reason has to distinguish the two cases. On a
    // truncated run the same pin is unproven rather than disproven, and SPEC
    // 5.4.2 makes it a warning that raising the budget may clear.
    print("    ")
    print(int_to_str(rank))
    print(". pin(")
    print(aif_tier_name(aif_tier_of(site) - 1))
    if (converged) {
        println(") on the binding                     rejected -- inference converged, so this is proven false")
    } else {
        println(") on the binding                     unproven -- the budget ran out; raising it may settle this")
    }

    if (rank == 1) {
        println("")
        println("  no repair is derivable: the path ends at the allocation itself.")
    }
}

// Finds the record by the symbol the manifest prints, so a reader can copy one
// out of a diff and paste it back. Returns 1 when it found one.
fn aif_explain(symbol: String, converged: Bool) -> Int {
    let total = aif_site_count()
    let mut i = 0
    while (i < total) {
        if (str_equals(aif_symbol_of(i), symbol) == 1) {
            aif_emit_cause(i, converged)
            return 1
        }
        i = i + 1
    }
    print("no manifest record named ")
    println(symbol)
    return 0
}

// SPEC 5.4's diagnostics, and the one place AIF reports anything.
//
// That is not a contradiction of SPEC 1. The invariant governs *inference
// failure* -- the analysis being unable to prove a value cheap -- and says that
// degrades performance and never compilation. A pin a converged analysis refutes
// is the other thing: a programmer assertion that is false about their own
// program, in the same category as `use of moved value`. SPEC 5.4.1 spells that
// distinction out and makes this one an error.
//
// Returns the number of errors reported, so the caller can stop before codegen.
fn aif_report_pins() -> Int {
    let n = aif_site_count()
    let mut i = 0
    let mut errors = 0
    while (i < n) {
        let verdict = aif_site_pin_verdict(i)

        if (verdict == AIF_PIN_REFUTED) {
            let want = aif_tier_name(aif_site_pin_tier(i))
            let got = aif_tier_name(aif_site_derived_tier(i))
            diag_error_at(aif_site_file(i), aif_site_line(i), aif_site_col(i), 0,
                          str_concat(str_concat(str_concat("pin(", want), ") cannot hold: this value is "), got))
            diag_note("inference converged, so this is a proven-false assertion rather than a limit of the analysis")
            errors = errors + 1
        }

        if (verdict == AIF_PIN_UNPROVEN) {
            let want = aif_tier_name(aif_site_pin_tier(i))
            diag_warning_at(aif_site_file(i), aif_site_line(i), aif_site_col(i), 0,
                            str_concat(str_concat("pin(", want), ") is unproven: the analysis budget ran out"))
            diag_note("raising --budget may settle it; the derived tier is used meanwhile")
        }

        i = i + 1
    }
    return errors
}

// REQUIREMENTS 19's gate. A `region name pin(N)` whose arena is estimated to
// serve more than N bytes is a false assertion about one's own program, in the
// same category as a refuted tier pin -- so it is an error, and SPEC 1's
// invariant is untouched for the same reason SPEC 5.4.1 gives.
//
// Only checked when the analysis converged. A truncated one has raised the
// unproven facts to the conservative end, which *lowers* the arena's estimated
// load -- fewer sites stay T1 -- so a budget could pass for want of analysis and
// fail on the next build. Silence is the honest answer there.
fn aif_report_budgets(converged: Bool) -> Int {
    if (converged == false) { return 0 }

    let n = aif_budget_count()
    let mut s = 0
    let mut errors = 0
    while (s < n) {
        let cap = aif_scope_budget(s)
        if (cap > 0) {
            let served = aif_scope_served(s)
            if (served > cap) {
                diag_error_at(aif_scope_budget_file(s), aif_scope_budget_line(s),
                              aif_scope_budget_col(s), 0,
                              str_concat(str_concat(str_concat("region ", aif_scope_region(s)),
                                         str_concat(" exceeds its budget: ", int_to_str(served))),
                                         str_concat(" bytes estimated, ", str_concat(int_to_str(cap), " asserted"))))
                diag_note("the estimate counts statically sized allocations only; a string's length is a run-time value")
                errors = errors + 1
            }
        }
        s = s + 1
    }
    return errors
}

fn aif_analyze(module: ASTNode, source_path: String, version: String,
               owned_collections: Bool, summary: Bool, theta_fields: Bool,
               budget: Int) {
    let converged = aif_run(module, owned_collections, theta_fields, budget)

    if (summary) {
        aif_emit_summary(source_path, converged)
    } else {
        aif_emit_manifest(source_path, version, converged)
    }
}
