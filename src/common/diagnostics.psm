// Diagnostics FFI.
//
// The renderer lives in runtime/diagnostics.c because it needs the original text
// of the file a node came from, which the frontend has thrown away by the time it
// reports anything -- and because `resolveImports` flattens every module into a
// single AST, so "which file" has to travel on the node itself as an id into the
// registry rather than being implied by context.
//
// Prismio has no varargs, so a message is composed here with str_concat and
// handed over finished.


// Registers a source file's text and returns the id stamped onto every token and
// AST node parsed from it. Registering the same path twice returns the first id.
import std.string
public extern fn exit(code: Int)
public extern fn diag_add_file(path: String, content: String) -> Int
public extern fn diag_file_path(file: Int) -> String alias
// How many files the registry holds. Used by v0.1 3.5's name resolution to ask
// "is this identifier a module?" without a module table of its own -- the file
// registry already is one.
public extern fn diag_file_count() -> Int

// The logical import path a file was reached by -- `std.string`, not `string`
// and not the directory it happens to sit in. Recorded by the merge rather than
// derived from the path, because `resolveImportPath` flattens `std/` to
// `stdlib/` on install: a qualifier computed from the path would read
// `std.string` in a checkout and `stdlib.string` from an installed toolchain.
// "" for a file the merge never named, which is the entry file.
//
// `alias` for the same reason as diag_file_path: the pointer is into the
// registry's own storage and the runtime frees it in diag_reset.
public extern fn diag_set_file_module(file: Int, module: String)
public extern fn diag_file_module(file: Int) -> String alias

// A located diagnostic. `len` is the width of the caret run -- the length of the
// token the node starts at -- and may be 0 for "just point at the column".
public extern fn diag_error_at_code(code: String, file: Int, line: Int, col: Int, len: Int, message: String)
public extern fn diag_warning_at_code(code: String, file: Int, line: Int, col: Int, len: Int, message: String)
public extern fn diag_note_at(file: Int, line: Int, col: Int, len: Int, message: String)

// Unlocated forms, for anything that is not about a particular piece of source:
// a missing file, a bad command-line argument.
public extern fn diag_error_code(code: String, message: String)
public extern fn diag_warning_code(code: String, message: String)
public extern fn diag_note(message: String)

public extern fn diag_error_count() -> Int
public extern fn diag_warning_count() -> Int

// Switches the renderer to the versioned JSON Lines protocol consumed by IDEs.
// This changes presentation only; diagnostic accounting and exit status stay the
// same as the human renderer.
public extern fn diag_set_json_mode(on: Int)

// Prints the "aborting due to N previous errors" line. That wording is the
// contract the negative tests match on: it distinguishes a program the compiler
// deliberately rejected from one that made it crash.
public extern fn diag_finish()
public extern fn diag_reset()

// Terminal presentation. Every one of these is styled only when its stream is a
// terminal, and prints exactly the old plain text -- or nothing -- when it is
// not, so a pipe, a log and the test suite read what they always read.
//
// The progress line: `begin` names the source and starts the clock the result
// line reports; each `progress` rewrites one line on stderr with the phase now
// running. A diagnostic or result clears it first.
public extern fn diag_progress_begin(subject: String)
public extern fn diag_progress(phase: String)
public extern fn diag_progress_clear()
// `Built ./hello  (optimized, 0.84s)` on a terminal; `<plain><subject>` on a
// pipe, or nothing when `plain` is "".
public extern fn diag_result(plain: String, verb: String, subject: String, detail: String)
// A styled status line with no plain form, such as `Running ./hello`.
public extern fn diag_status(verb: String, subject: String)
// Text in a role -- "ok", "fail", "heading", "command", "dim", "accent" -- on
// stdout, or on stderr for the `_err` form. No newline is added.
public extern fn diag_styled(style: String, text: String)
public extern fn diag_styled_err(style: String, text: String)
// The usage text, with headings and commands styled on a terminal.
public extern fn diag_print_help(text: String)

// Quotes a name the way every message in the compiler quotes one, so the style
// cannot drift between call sites.
public fn diagQuote(name: String) -> String {
    return "`".concat(name, "`")
}
