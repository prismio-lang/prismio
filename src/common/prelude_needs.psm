// What a program's own files look up: what the lazy prelude may answer, and which parts of an
// imported library package are merged.
//
// A `module prelude` library module is merged when a name it declares is looked up and found nowhere
// else, and a part of a package a file imports when the file looks up a name it declares
// (driver/imports.psm). Which names a file looks up is read from its tokens as it is parsed.
//
// A name is looked up where it is a call (`min(`, `largest<`), a member (`v.push`), capitalised (a
// type or a trait), or a name the file binds nowhere (a function passed as a value, a library
// global). Syntax with no name of its own is a lang item: `??`, `${}`, a String used as more than an
// argument, a wide number, and a map literal or a non-empty bracket literal, which the parser notes
// -- the latter a vector only in a program that writes `Vec` somewhere, and an array otherwise.

import std.collections.vec
import std.collections.map
import std.string
import lexer.token
import lexer.scanner

// Parallel columns: need `i` is `preludeNames[i]`, looked up first at the token
// `preludeFiles[i]`:`preludeLines[i]`:`preludeCols[i]`. A lang item is `lang:<id>`.
let mut preludeNames: Vec<String>
let mut preludeFiles: Vec<Int>
let mut preludeLines: Vec<Int>
let mut preludeCols: Vec<Int>
let mut preludeSeen: HashMap<String, Int>
// Every name any file looked up.
let mut preludeAny: HashMap<String, Int>
// A zero-filled global `Vec` is not an empty one.
let mut preludeOpened = false
// Whether any file writes a number type the console does not know by itself.
let mut preludeWroteWide = false
// Whether any file writes the type `Vec`, which is what makes a literal a vector rather than an array.
let mut preludeWroteVec = false

// Forgets the last compile's needs, before the next one parses its entry.
public fn preludeReset() {
    preludeNames = []
    preludeFiles = []
    preludeLines = []
    preludeCols = []
    preludeSeen = HashMap<String, Int>()
    preludeAny = HashMap<String, Int>()
    preludeOpened = true
    preludeWroteVec = false
    preludeWroteWide = false
}

public fn preludeVecWritten() -> Bool { return preludeWroteVec }

public fn preludeWideNumberWritten() -> Bool { return preludeWroteWide }

public fn preludeNeedCount() -> Int {
    if (preludeOpened == false) { return 0 }
    return preludeNames.length
}

public fn preludeNeedName(at: Int) -> String { return preludeNames[at].clone() }
public fn preludeNeedFile(at: Int) -> Int { return preludeFiles[at] }
public fn preludeNeedLine(at: Int) -> Int { return preludeLines[at] }
public fn preludeNeedCol(at: Int) -> Int { return preludeCols[at] }

// One need per name per file: the first place it is written is where a refusal points.
public fn preludeNote(name: String, file: Int, line: Int, col: Int) {
    if (preludeOpened == false) { return }
    let key = file.toString().concat(" ", name)
    if (preludeSeen.contains(key)) { return }
    preludeSeen.set(key, 1)
    preludeAny.set(name.clone(), 1)
    preludeNames.push(name.clone())
    preludeFiles.push(file)
    preludeLines.push(line)
    preludeCols.push(col)
}

// Whether `file` looks up `name`.
public fn preludeFileLooks(file: Int, name: String) -> Bool {
    if (preludeOpened == false) { return false }
    return preludeSeen.contains(file.toString().concat(" ", name))
}

// Whether any file of the program does.
public fn preludeProgramLooks(name: String) -> Bool {
    if (preludeOpened == false) { return false }
    return preludeAny.contains(name)
}

// Every lookup written in a file, from its first token.
public fn preludeNoteTokens(head: Ptr) {
    if (preludeOpened == false) { return }
    let bound = preludeBoundNames(head)
    // A file that writes the type `String` and an operator or a member may join, compare or measure
    // one with no literal in sight.
    let mut writtenString = false
    let mut stringFile = 0
    let mut stringLine = 0
    let mut stringCol = 0
    let mut operators = false
    let mut at = head
    let mut previous = "".clone()
    loop {
        let token = ptr_to_token(at)
        if (token.type == TokenType.EOF) { break }
        // An import's path names modules, not things the file looks up.
        if (token.value.equals("import") or token.value.equals("from")) {
            at = preludeNextLine(token)
            previous = "".clone()
            continue
        }
        if (token.type == TokenType.ARITHMETIC_OPERATOR and token.value.equals("??")) {
            preludeNote("lang:option_coalesce", token.file, token.line, token.col)
        }
        if (token.type == TokenType.INTERP_BEGIN) {
            preludeNote("lang:show", token.file, token.line, token.col)
            preludeNote("lang:string_concat", token.file, token.line, token.col)
        }
        // A literal that is more than an argument is used as a String: joined, compared or kept.
        if (token.type == TokenType.STRING_LITERAL) {
            let next = ptr_to_token(token.tokNext).value
            if ((previous.equals("(") or previous.equals(",")) == false
                    or (next.equals(")") or next.equals(",")) == false) {
                preludeNote("lang:string_concat", token.file, token.line, token.col)
            }
        }
        if (token.type == TokenType.IDENTIFIER) {
            if (token.value.equals("Vec")) {
                preludeWroteVec = true
                if (preludeFillsByCopy(token.tokNext)) {
                    preludeNote("lang:vec_filled", token.file, token.line, token.col)
                }
            }
            if (token.value.equals("String") and writtenString == false) {
                writtenString = true
                stringFile = token.file
                stringLine = token.line
                stringCol = token.col
            }
            if (previous.equals(".") == false and preludeIsWideNumber(token.value, token.tokNext)) {
                preludeWroteWide = true
                preludeNote("lang:int_text", token.file, token.line, token.col)
            }
            if (preludeLanguageType(token.value) == false
                    and (previous.equals(".") or preludeCapitalised(token.value) or preludeCalled(token.tokNext)
                        or bound.contains(token.value) == false)) {
                preludeNote(token.value, token.file, token.line, token.col)
            }
        }
        if (preludeComparesOrJoins(token.value) or token.value.equals(".")) { operators = true }
        previous = token.value.clone()
        at = token.tokNext
    }
    if (writtenString and operators) {
        preludeNote("lang:string_concat", stringFile, stringLine, stringCol)
    }
}

// The first token past the line `token` is on.
private fn preludeNextLine(token: Token) -> Ptr {
    let line = token.line
    let mut at = token.tokNext
    loop {
        let next = ptr_to_token(at)
        if (next.type == TokenType.EOF or next.line != line) { return at }
        at = next.tokNext
    }
}

// A type the language declares itself. No module has to be read to find that none declares it.
private fn preludeLanguageType(name: String) -> Bool {
    let types = ";Int;I8;I16;I64;I128;Isize;U8;U16;U32;U64;U128;Usize;Float;F16;F32;BF16;F128;Bool;Char;String;Vec;Void;"
    return types.contains(";".concat(name, ";"))
}

private fn preludeComparesOrJoins(word: String) -> Bool {
    return word.equals("+") or word.equals("+=") or word.equals("==") or word.equals("!=")
        or word.equals("<=") or word.equals(">=")
}

// The names a file binds: what follows `fn`, `let`, `mut` or `for`, and what is written before a `:`
// (a parameter, a field). A bare name outside this set is something the file got from elsewhere.
private fn preludeBoundNames(head: Ptr) -> HashMap<String, Int> {
    let mut bound = HashMap<String, Int>()
    let mut at = head
    let mut previous = "".clone()
    loop {
        let token = ptr_to_token(at)
        if (token.type == TokenType.EOF) { break }
        if (token.type == TokenType.IDENTIFIER) {
            if (previous.equals("fn") or previous.equals("let") or previous.equals("mut") or previous.equals("for")
                    or ptr_to_token(token.tokNext).value.equals(":")) {
                bound.set(token.value.clone(), 1)
            }
        }
        previous = token.value.clone()
        at = token.tokNext
    }
    return bound
}

// A number type whose text the console does not know by itself: a float that is not `Float`, or an
// integer wider than 64 bits.
private fn preludeIsWideNumber(name: String, next: Ptr) -> Bool {
    if (name.equals("F32") or name.equals("F16") or name.equals("BF16") or name.equals("F128")) { return true }
    if ((name.equals("Int") or name.equals("UInt")) == false) { return false }
    let open = ptr_to_token(next)
    if (open.value.equals("<") == false) { return false }
    let width = ptr_to_token(open.tokNext).value
    return width.length > 2 or (width.length == 2 and width.compare("64") > 0)
}

// Whether the tokens after `Vec` read `<T>.filled` for an element the compiler cannot copy itself,
// which std.core.vec then fills: any but an integer up to 64 bits, a Float, a Bool or a Char.
private fn preludeFillsByCopy(open: Ptr) -> Bool {
    let first = ptr_to_token(open)
    if (first.value.equals("<") == false) { return false }
    let element = ptr_to_token(first.tokNext)
    if (element.type != TokenType.IDENTIFIER) { return false }
    let mut at = element.tokNext
    loop {
        let token = ptr_to_token(at)
        if (token.type == TokenType.EOF or token.value.equals("(") or token.value.equals("=")) { return false }
        if (token.value.equals(".")) { break }
        at = token.tokNext
    }
    if (ptr_to_token(ptr_to_token(at).tokNext).value.equals("filled") == false) { return false }
    let scalars = ";Int;I8;I16;I64;Isize;U8;U16;U32;U64;Usize;Float;F32;Bool;Char;"
    if (scalars.contains(";".concat(element.value, ";"))) { return false }
    return true
}

private fn preludeCapitalised(name: String) -> Bool {
    if (name.length == 0) { return false }
    let first = name.byteAt(0)
    return first >= 65 and first <= 90
}

// Whether the token after a name makes it a call: `(`, or the `<` of explicit type arguments.
private fn preludeCalled(next: Ptr) -> Bool {
    let token = ptr_to_token(next)
    if (token.type == TokenType.SEPARATOR and token.value.equals("(")) { return true }
    return token.value.equals("<")
}
