// Character classification for the scanner. Everything textual beyond this is
// `std.string`'s now: the C `str_*` layer this module used to declare was
// replaced by native Prismio in 2026-08, including the length-carrying
// `str_slice` whose whole purpose was avoiding a `strlen` that a fat String no
// longer performs -- `strSubstring` reads the carried length and is O(1)-bounded.
import std.string
import std.option

// **Renamed, and the rename is the point.** These were `isAlpha` and `isAlnum`,
// which was wrong twice over: `_` is not alphabetic, and `std.string` now spells
// `isAlpha(Char)` too -- as `impl Char`'s method, whose body is `charIsAlpha` and
// therefore does *not* accept `_`. Two functions of that name and that signature
// is an ambiguous overload at best; at worst the scanner silently resolves to the
// std one and identifiers stop starting with an underscore. The names below say
// what the scanner actually asks, and cannot collide with a classification.
fn isIdentStart(c: Char) -> Bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn isIdentPart(c: Char) -> Bool {
    return isIdentStart(c) or isDigit(c)
}

fn isSeparator(c: Char) -> Bool {
    if (c == '(') { return true }
    if (c == ')') { return true }
    if (c == '{') { return true }
    if (c == '}') { return true }
    if (c == '[') { return true }
    if (c == ']') { return true }
    if (c == ',') { return true }
    if (c == '.') { return true }
    if (c == ':') { return true }
    // REQUIREMENTS 4. Only ever the nullable-type suffix `T?`; there is no
    // ternary and no try operator, so it needs no precedence anywhere.
    if (c == '?') { return true }
    return false
}

fn isOperator(c: Char) -> Bool {
    if (c == '+') { return true }
    if (c == '-') { return true }
    if (c == '*') { return true }
    if (c == '/') { return true }
    if (c == '%') { return true }
    if (c == '<') { return true }
    if (c == '>') { return true }
    if (c == '!') { return true }
    if (c == '&') { return true }
    if (c == '|') { return true }
    if (c == '^') { return true }
    if (c == '~') { return true }
    if (c == '=') { return true }
    return false
}

// This was once an if-chain over every ASCII character, because the language had
// no way to convert a Char to its numeric value. It was also silently wrong: any
// character it had no branch for -- '^' (94), '~' (126), '@', '#', '?' and the
// whole range above 126 -- came back as 0, so a char literal for one of those
// compared equal to '\0'. That is precisely how '^' and '~' failed to lex when
// they were first added as operators.
//
// `as` makes the whole thing a zero-extension. Kept as a named function because
// it reads better at the call sites and is the documented spelling.
fn charCode(c: Char) -> Int {
    return c as Int
}
