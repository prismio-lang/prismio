// Structured control-flow analysis: can control fall out of the bottom of this
// statement, and does this loop have a break. Both feed definite-return and
// unreachable-code checking.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string

public extern fn exit(code: Int)

// --- structured control-flow analysis ---------------------------------------
//
// Prismio's control flow is fully structured -- no goto, and a labelled break
// can only leave loops that enclose it -- so "can control fall out of the bottom
// of this statement?" is answerable from the AST alone, without building a CFG. That is what definite-return and
// unreachable-code checking need.
//
// Both answers are deliberately conservative in the safe direction: when in
// doubt, report that control *can* fall through. That risks demanding a return
// the programmer knows is unreachable, which is an annoyance; the opposite
// error would let a function fall off its end, which is a miscompile.

private fn semaBlockHasBreak(block: ASTNode) -> Bool {
    let mut stmtPtr = block.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)

        if (stmt.kind == NodeKind.BREAK_STATEMENT) { return true }

        // Nested loops own their own unlabelled breaks, but a `break@outer`
        // inside one leaves this loop too. Descending into them counts both, and
        // is conservative about the first kind rather than wrong about the second.
        if (stmt.kind == NodeKind.IF_STATEMENT) {
            if (semaIfHasBreak(stmt)) { return true }
        }
        if (stmt.kind == NodeKind.WHILE_STATEMENT or stmt.kind == NodeKind.LOOP_STATEMENT) {
            let mut body = ptr_to_node(stmt.child1)
            if (stmt.kind == NodeKind.WHILE_STATEMENT) { body = ptr_to_node(stmt.child2) }
            if (semaBlockHasBreak(body)) { return true }
        }
        if (stmt.kind == NodeKind.FOR_STATEMENT) {
            if (semaBlockHasBreak(ptr_to_node(stmt.child3))) { return true }
        }
        // A region is not a loop, so a `break` inside one belongs to the loop
        // enclosing it and has to be visible through the block.
        if (stmt.kind == NodeKind.REGION_STATEMENT) {
            if (semaBlockHasBreak(ptr_to_node(stmt.child1))) { return true }
        }
        if (stmt.kind == NodeKind.MATCH_STATEMENT) {
            let mut armPtr = stmt.child2
            while (nodeExists(armPtr)) {
                let arm = ptr_to_node(armPtr)
                if (semaBlockHasBreak(ptr_to_node(arm.child2))) { return true }
                armPtr = arm.next
            }
        }

        stmtPtr = stmt.next
    }
    return false
}

// A whole `if` / `else if` / `else` chain. Recurses through the chain rather
// than being inlined into the walk above, which had the same eight lines written
// out twice -- once for the statement and once for the else-if that follows it.
private fn semaIfHasBreak(stmt: ASTNode) -> Bool {
    if (semaBlockHasBreak(ptr_to_node(stmt.child2))) { return true }
    if (nodeIsNull(stmt.child3)) { return false }

    let elseNode = ptr_to_node(stmt.child3)
    if (elseNode.kind == NodeKind.IF_STATEMENT) {
        return semaIfHasBreak(elseNode)
    }
    return semaBlockHasBreak(elseNode)
}

// True when control cannot continue past this statement.
internal fn semaStmtDiverges(stmt: ASTNode) -> Bool {
    if (stmt.kind == NodeKind.RETURN_STATEMENT) { return true }
    if (stmt.kind == NodeKind.BREAK_STATEMENT) { return true }
    if (stmt.kind == NodeKind.CONTINUE_STATEMENT) { return true }

    if (stmt.kind == NodeKind.IF_STATEMENT) {
        // Only when there is an else and *both* sides diverge.
        if (nodeIsNull(stmt.child3)) { return false }
        let elseNode = ptr_to_node(stmt.child3)
        let mut elseDiverges = false
        if (elseNode.kind == NodeKind.IF_STATEMENT) {
            elseDiverges = semaStmtDiverges(elseNode)
        } else {
            elseDiverges = semaBlockDiverges(elseNode)
        }
        return semaBlockDiverges(ptr_to_node(stmt.child2)) and elseDiverges
    }

    // A `loop` with no break never finishes. A `while` or `for` may run zero
    // times, so neither ever counts as diverging.
    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        return semaBlockHasBreak(ptr_to_node(stmt.child1)) == false
    }

    return false
}

internal fn semaBlockDiverges(block: ASTNode) -> Bool {
    let mut stmtPtr = block.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        if (semaStmtDiverges(stmt)) { return true }
        stmtPtr = stmt.next
    }
    return false
}

// --- jumps -------------------------------------------------------------------
//
// `break` and `continue` outside any loop, and a label that no enclosing loop
// carries. Checked over the statement tree before the body is typed, because
// both are properties of where a jump is written rather than of any type.
//
// `labels` holds the enclosing loops' labels, each with a space on both sides,
// so looking one up cannot match a prefix of another. A closure's body is an
// expression and is never entered here: it is checked as its own function,
// where a `break` has no loop around it.

internal fn semaCheckJumps(body: ASTNode) {
    semaCheckJumpsIn(body, " ", 0)
}

private fn semaCheckJumpsIn(block: ASTNode, labels: String, depth: Int) {
    let mut p = block.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        semaCheckJumpsAt(stmt, labels, depth)
        p = stmt.next
    }
}

private fn semaCheckJumpsAt(stmt: ASTNode, labels: String, depth: Int) {
    if (stmt.kind == NodeKind.BREAK_STATEMENT or stmt.kind == NodeKind.CONTINUE_STATEMENT) {
        let mut word = "break"
        if (stmt.kind == NodeKind.CONTINUE_STATEMENT) { word = "continue" }
        if (depth == 0) {
            semaErrorAt(stmt, "`".concat(word, "` is only valid inside a loop"))
            return
        }
        if (stmt.s1.equals("") == false and labels.contains(" ".concat(stmt.s1, " ")) == false) {
            semaErrorAt(stmt, "no enclosing loop is labelled ".concat(diagQuote(stmt.s1)))
            diag_note("a label is written on the loop it names: `".concat(stmt.s1, "@ for i in 0..<n { ... }`"))
        }
        return
    }

    if (stmt.kind == NodeKind.IF_STATEMENT) {
        semaCheckJumpsIn(ptr_to_node(stmt.child2), labels, depth)
        if (nodeIsNull(stmt.child3)) { return }
        let elseNode = ptr_to_node(stmt.child3)
        if (elseNode.kind == NodeKind.IF_STATEMENT) {
            semaCheckJumpsAt(elseNode, labels, depth)
        } else {
            semaCheckJumpsIn(elseNode, labels, depth)
        }
        return
    }

    if (stmt.kind == NodeKind.WHILE_STATEMENT or stmt.kind == NodeKind.LOOP_STATEMENT
            or stmt.kind == NodeKind.FOR_STATEMENT) {
        let body = ptr_to_node(loopBodyOf(stmt))
        if (body.s1.equals("")) {
            semaCheckJumpsIn(body, labels, depth + 1)
            return
        }
        // Shadowing a label would make `break@outer` in the inner loop mean the
        // nearer one, silently; a reader would take it for the outer.
        if (labels.contains(" ".concat(body.s1, " "))) {
            semaErrorAt(stmt, "the label ".concat(diagQuote(body.s1), " is already used by a loop around this one"))
        }
        semaCheckJumpsIn(body, labels.concat(body.s1, " "), depth + 1)
        return
    }

    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        semaCheckJumpsIn(ptr_to_node(stmt.child1), labels, depth)
        return
    }

    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        let mut armPtr = stmt.child2
        while (nodeExists(armPtr)) {
            let arm = ptr_to_node(armPtr)
            semaCheckJumpsIn(ptr_to_node(arm.child2), labels, depth)
            armPtr = arm.next
        }
    }
}
