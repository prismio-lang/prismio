// Move, borrow and drop enforcement, plus the FFI contracts that describe what
// foreign code does to ownership.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string
import std.option

// Whether binding this expression to a name produces a *borrow* rather than an
// owned value.
//
// AIF Level 4 made String and List affine, and that turned the compiler's own
// commonest idiom -- `let mut p = node.child1`, walking a chain of pointers
// punned as strings -- into "use of moved value" everywhere. It is not a move:
// reading a field yields a reference the container still owns, and so does
// naming a binding that was already a borrow. Both stay borrows.
//
// This is also what keeps it sound rather than merely quiet. A borrowed binding's
// initialiser registers no allocation site, so aif_frees_at_scope_node never
// admits it and nothing frees a value it does not own.
internal fn semaBindingIsBorrow(node: ASTNode) -> Bool {
    if (node.kind == NodeKind.MEMBER_ACCESS_EXPR) { return true }
    if (node.kind == NodeKind.INDEX_EXPR) { return true }
    // `v[i]` on a Vec, once sema has lowered it: the element is the Vec's.
    if (semaIsElementRead(node)) { return true }
    if (node.kind == NodeKind.IDENTIFIER_EXPR) {
        return ir_is_borrowed(node.s1) == 1
    }
    return false
}

// If `node` is a move-only value referenced by name, transfer ownership out of it:
// any later use of that binding becomes a "use of moved value" error.
//
// A borrowed operand is reborrowed instead -- the caller marks the new binding
// borrowed in turn. Consuming one is still an error; that goes through
// semaConsumeOperand.
internal fn semaMoveOperand(node: ASTNode) {
    if (node.kind == NodeKind.IDENTIFIER_EXPR) {
        if (typeIsMoveOnly(nodeGetType(node))) {
            if (ir_is_borrowed(node.s1) == 1) { return }
            // M2.1b. Keep the transfer on the use node as well as in sema's
            // per-name state. Codegen runs after that state has been cleared,
            // but reset/reuse has to prove that every owned payload extracted
            // from a consumed constructor is transferred into its replacement.
            // i3 has no other meaning on an identifier expression.
            node.i3 = 1
            // Move state is tracked per name over the AST in source order, so a
            // move inside a loop body is seen once but executes on every
            // iteration. If the binding was created outside the loop, that is a
            // use-after-move -- and for drop(), a double free that crashes at
            // run time with nothing reported at compile time.
            // M2.1c. `acc = f(acc)` is the exception the rule has to make: the
            // move is an operand of the assignment that rebinds the same name, so
            // the slot holds a fresh value before the next iteration reads it and
            // the move does *not* repeat. Anything else moved out of a binding
            // that predates the loop still does.
            if (ir_binding_predates_loop(node.s1) == 1
                and ir_is_reinit_target(node.s1) == 0) {
                semaErrorAt(node, diagQuote(node.s1).concat(" is moved inside a loop, so the move would repeat on the next iteration"))
            }
            ir_mark_moved(node.s1)
        }
    }
}

// A move that destroys: `drop(x)` and a `sink` parameter both end the value's
// life here, so a borrow cannot supply one -- the owner would be left with a
// dangling binding. This is the check semaMoveOperand used to make for every
// caller, kept for the two that still need it.
internal fn semaConsumeOperand(node: ASTNode) {
    if (node.kind == NodeKind.IDENTIFIER_EXPR) {
        if (typeIsMoveOnly(nodeGetType(node))) {
            if (ir_is_borrowed(node.s1) == 1) {
                semaErrorAt(node, "cannot move out of borrowed value ".concat(diagQuote(node.s1)))
                return
            }
        }
    }
    semaMoveOperand(node)
}

// `list_get(v, i)`: a Vec element read, which is what `v[i]` lowers to.
internal fn semaIsElementRead(node: ASTNode) -> Bool {
    if (node.kind != NodeKind.CALL_EXPR or nodeIsNull(node.child1) or nodeIsNull(node.child2)) {
        return false
    }
    let callee = ptr_to_node(node.child1)
    return callee.kind == NodeKind.IDENTIFIER_EXPR and callee.s1.equals("list_get")
}

// The binding a place's contents belong to: indexing, a Vec element read and a
// slice are followed to what they index, since `grid[i].push(x)` changes
// `grid` and `v[0..<2][0] = x` changes `v`. A field is not followed -- the Vec
// a struct holds is part of that struct, assignable through any binding.
private fn semaPlaceRoot(place: ASTNode) -> ASTNode {
    let mut root = place
    loop {
        if ((root.kind == NodeKind.INDEX_EXPR or root.kind == NodeKind.SLICE_EXPR)
                and nodeExists(root.child1)) {
            root = ptr_to_node(root.child1)
        } else if (semaIsElementRead(root)) {
            root = ptr_to_node(root.child2)
        } else {
            break
        }
    }
    return root
}

// Whether a store through `place` is allowed, without reporting. Anything
// without a root binding is a temporary, which nothing else can observe
// changing.
private fn semaPlaceIsChangeable(place: ASTNode) -> Bool {
    if (semaSliceIsReadOnly(place)) { return false }
    let root = semaPlaceRoot(place)
    if (root.kind != NodeKind.IDENTIFIER_EXPR or ir_has_var_type(root.s1) == 0) { return true }
    if (ir_var_is_readonly_view(root.s1) == 1) { return false }
    if (ir_var_is_mutable(root.s1) == 1 or ir_var_is_inout(root.s1) == 1) { return true }
    if (ir_var_is_global(root.s1) == 1 and semaIsExternGlobal(root.s1)) { return true }
    return false
}

// Whether the contents of `place` may change here: the Vec a mutating method or
// an element store is applied to, an array or a slice being stored into, or an
// argument to an `inout` parameter. Reports when they may not.
//
// The binding at the root decides -- a `let mut`, or an `inout` parameter
// (semaPlaceRoot says which binding that is). A Slice binding also has to view
// something changeable: `mut` on the view only lets it be rebound
// (semaMarkSliceBinding).
internal fn semaCheckMutablePlace(place: ASTNode) -> Bool {
    if (semaPlaceIsChangeable(place)) { return true }
    let root = semaPlaceRoot(place)
    let rootIsName = root.kind == NodeKind.IDENTIFIER_EXPR
    if (semaSliceIsReadOnly(place) or (rootIsName and ir_var_is_readonly_view(root.s1) == 1)) {
        if (rootIsName) {
            semaErrorAt(root, "cannot change what ".concat(diagQuote(root.s1), " views: the view is read-only"))
        } else {
            semaErrorAt(place, "cannot change what this slice views: the view is read-only")
        }
        diag_note("a slice of a Vec that is not `mut`, and a Slice returned by a function with no `inout` parameter, can only be read; slice a `let mut` Vec or an `inout` parameter")
        return false
    }
    semaErrorAt(root, "cannot change ".concat(diagQuote(root.s1), ", which is not declared `mut`"))
    diag_note("declare it `let mut`, or `inout` if it is a parameter")
    return false
}

// A Slice expression that views something its holder may not change. Read
// from the binding for a name; otherwise from the Slice type's read-only mark,
// which semaSliceExpr sets from its base and semaCallExpr sets on a Slice
// returned by a function that has no `inout` parameter -- it can only have
// viewed what it was allowed to read.
internal fn semaSliceIsReadOnly(value: ASTNode) -> Bool {
    if (value.kind == NodeKind.IDENTIFIER_EXPR) {
        return ir_has_var_type(value.s1) == 1 and ir_var_is_readonly_view(value.s1) == 1
    }
    let t = nodeGetType(value)
    return typeIsValid(t) and t.kind == TypeKind.SLICE and typeSliceIsReadOnly(t)
}

// The read-only mark for a slice taken from `base`, as semaSliceExpr needs it.
internal fn semaSliceOfIsReadOnly(base: ASTNode) -> Bool {
    if (semaSliceIsReadOnly(base)) { return true }
    return semaPlaceIsChangeable(base) == false
}

// `let s = v[0..<2]` or `s = w[0..<2]`: a Slice binding takes on the value's
// read-only mark. Rebinding a changeable view to a read-only one is refused,
// since a store written earlier in a loop body would otherwise run through it
// on the next iteration; a view that starts read-only stays so.
internal fn semaMarkSliceBinding(name: String, value: ASTNode, isDeclaration: Bool) {
    if (semaSliceIsReadOnly(value) == false) { return }
    if (isDeclaration == false and ir_var_is_readonly_view(name) == 0) {
        semaErrorAt(value, "a read-only view cannot replace ".concat(diagQuote(name),
            ", which views something changeable"))
        diag_note("bind it to a new name, or slice a `let mut` Vec")
        return
    }
    ir_mark_readonly_view(name)
}

// Type-check a value against an expected type, allowing a bare integer literal to
// take on any sized integer type (so `let x: U8 = 200` and `f(200)` type-check).
internal fn semaCheckValue(module: ASTNode, valNode: ASTNode, expected: TypeInfo, context: String) -> TypeInfo {
    // `default` becomes the expected type's value here, and is then checked as
    // the literal it became -- so `0` still adopts `U8` below.
    if (valNode.kind == NodeKind.DEFAULT_EXPR) {
        if (semaResolveDefault(module, valNode, expected) == false) {
            nodeSetType(valNode, typeInvalid())
            return typeInvalid()
        }
    }
    enumQualifyFromExpected(module, valNode, expected)
    if (typeIsValid(expected) and expected.kind == TypeKind.INT and semaIsIntLiteral(valNode)) {
        // Adopting a type is also where the value has to fit in it. Without
        // this, `let small: U8 = 999` typed as U8 and stored 231.
        //
        // A literal too large for *any* integer type has already been reported
        // where it was typed; saying so again here would be two diagnostics for
        // one mistake, in two different vocabularies.
        if (typeIntLiteralFitsAnyInt(valNode.s1)
            and typeIntLiteralFits(valNode.s1, expected) == false) {
            semaErrorAt(valNode, "integer literal ".concat(diagQuote(valNode.s1),
                                                           " does not fit in ", typeDisplay(expected)))
        }
        nodeSetType(valNode, expected)
        return expected
    }

    // An array literal takes its element type from the annotation when there is
    // one, for the same reason a bare integer literal does above.
    //
    // Without this, `let x: [I64] = [1, 2]` was rejected: the elements are bare
    // integer literals, which infer as Int, so the literal typed as [Int] and
    // did not match the declared [I64] -- even though every element would have
    // coerced happily on its own had it been written `let y: I64 = 1`.
    if (typeIsValid(expected) and expected.kind == TypeKind.ARRAY
        and valNode.kind == NodeKind.ARRAY_LITERAL_EXPR
        and nodeExists(expected.child)) {
        let elemExpected = ptr_to_type(expected.child)
        let mut count = 0
        let mut elemPtr = valNode.child1
        while (nodeExists(elemPtr)) {
            let elem = ptr_to_node(elemPtr)
            semaCheckValue(module, elem, elemExpected, context)
            count = count + 1
            elemPtr = elem.next
        }
        // The literal's own length, whatever the annotation knew: `[T]` knows
        // none, and a binding typed from this has to (typeArrayCopies).
        let sized = typeArraySized(elemExpected, count)
        nodeSetType(valNode, sized)
        return sized
    }
    // A list literal, which is an array literal until its context asks for a
    // `List<T>`. Tried after the array case above, so an annotation that says
    // `[T]` still gets the frame array it asks for.
    if (semaListLiteral(module, valNode, expected)) {
        return nodeGetType(valNode)
    }

    let actual = semaExpr(module, valNode)
    semaExpectAssignable(valNode, context, expected, actual)

    // M4.2. A fresh empty list takes its element type from the annotation, for
    // the same reason the two literals above take theirs: `list_new()` types as
    // `List<Invalid>` on its own and the annotation is the only place the
    // element type is written.
    //
    // Nothing about *checking* needed this -- `List<Invalid>` is assignable to
    // any list, which is how these programs compiled before. What needs it is
    // codegen: a container's element storage is chosen from the element type at
    // the construction site, and without this that site sees `Invalid` and every
    // list is told what it holds only once something has been pushed into it.
    if (typeIsValid(expected) and expected.kind == TypeKind.LIST
        and actual.kind == TypeKind.LIST
        and typeIsValid(semaListElementType(actual)) == false) {
        nodeSetType(valNode, expected)
        return expected
    }
    return actual
}

// FFI ownership contracts (aif/spec/FFI.md 5), checked where they are written.
//
// FFI 1 is blunt about why this matters: an `extern` contract describes opaque
// foreign code and cannot be verified, so **the FFI boundary is the one place in
// AIF where being wrong is unsafe rather than slow.** Nothing downstream can
// catch a `retain_in(9)` on a two-argument function or an `alias` on a
// parameter; the analysis would read a contract that means nothing and quietly
// apply a default instead. So the declaration is the only place these can be
// rejected, and they are rejected here rather than warned about.
private fn semaContractName(encoded: String) -> String {
    let at = encoded.indexOf(":")
    if (at < 0) {
        return encoded
    }
    return encoded.substring(0, at)
}

private fn semaContractArgument(encoded: String) -> String {
    let at = encoded.indexOf(":")
    if (at < 0) {
        return ""
    }
    return encoded.substring(at + 1, __builtin_string_len(encoded) - at - 1)
}

private fn semaIsParameterContract(name: String) -> Bool {
    if (name.equals("borrow")) { return true }
    if (name.equals("bytes")) { return true }
    if (name.equals("retain")) { return true }
    if (name.equals("retain_in")) { return true }
    if (name.equals("consume")) { return true }
    if (name.equals("out")) { return true }
    return false
}

// `bytes` is the only contract that describes *marshalling* rather than
// ownership, and it is a String-only question: a view ends where its length
// says, inside a buffer that continues, so the boundary normally hands the
// callee a NUL-terminated copy of it. `bytes` says the callee does not read to a
// terminator -- it was given the count separately -- so the String's own pointer
// goes through untouched, and the copy is not made.
//
// Ownership is unchanged: the callee reads and retains nothing, exactly as under
// `borrow`, which is what aifDeclaredContract maps it to.
private fn semaContractIsStringOnly(name: String) -> Bool {
    return name.equals("bytes")
}

// SPEC 8.4: a Slice is a language view descriptor, not a C buffer. The FFI
// specification permits a future marshalling copy for non-contiguous views,
// but this compiler has no such copy yet. Reject the boundary instead of
// passing the private `{ handle, offset, length }` aggregate as though it were
// a stable foreign ABI.
private fn semaExternTypeIsSlice(annotation: ASTNode) -> Bool {
    return annotation.i2 == 1 and annotation.s1.equals("Slice")
}

private fn semaExternTypeIsDataView(annotation: ASTNode) -> Bool {
    return annotation.i2 == 1 and annotation.s1.equals("DataView")
}

// `extern let`. Only a type that carries no ownership may name foreign storage:
// an integer, `Float` or `Char` is copied out on every read, and a `Ptr` is
// opaque. A String would be read as a `{ptr, len}` pair C never wrote, and a
// struct or a List as a value this program releases at scope exit.
//
// `Bool` is refused for a reason of its own. It lowers to `i1`, and a store of
// one leaves the other seven bits of a C `bool` unspecified.
internal fn semaCheckExternGlobalType(annotation: ASTNode, name: String, varT: TypeInfo) {
    if (typeIsValid(varT) == false) { return }
    let k = varT.kind
    if (k == TypeKind.INT or k == TypeKind.FLOAT or k == TypeKind.CHAR or k == TypeKind.PTR) {
        return
    }
    diag_error_at_code("P4111", annotation.file, annotation.line, annotation.col, annotation.len,
        "extern global ".concat(diagQuote(name), " cannot have type ", typeDisplay(varT)))
    if (k == TypeKind.BOOL) {
        diag_note("a C `bool` is a byte; declare it `U8` and compare it with 0")
    } else {
        diag_note("an extern global is an integer, `Float`, `Char` or `Ptr`; reach anything else through an `extern fn` whose contract says who owns it")
    }
}

internal fn semaCheckExternContracts(extNode: ASTNode) {
    // Counted first: `retain_in(k)` names another parameter by index, so the
    // arity has to be known before any of them can be checked.
    let mut arity = 0
    let mut countPtr = extNode.child1
    while (nodeExists(countPtr)) {
        let param = ptr_to_node(countPtr)
        if (param.kind == NodeKind.FUNCTION_PARAMETER) {
            arity = arity + 1
        }
        countPtr = param.next
    }

    let mut index = 0
    let mut paramPtr = extNode.child1
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        if (param.kind == NodeKind.FUNCTION_PARAMETER and nodeExists(param.child1)) {
            let annotation = ptr_to_node(param.child1)
            let encoded = annotation.s2

            if (semaExternTypeIsSlice(annotation)) {
                diag_error_at_code("P4101", param.file, param.line, param.col, __builtin_string_len(param.s1),
                    "Slice cannot cross an extern boundary without explicit marshalling: ".concat(diagQuote(param.s1)))
                diag_note("copy the view into a C-compatible buffer before the call")
            }
            if (semaExternTypeIsDataView(annotation)) {
                diag_error_at_code("P4102", param.file, param.line, param.col, __builtin_string_len(param.s1),
                    "DataView cannot cross an extern boundary: ".concat(diagQuote(param.s1)))
                diag_note("materialise ordinary AoS storage with aos(view) before the call")
            }

            if (encoded.equals("") == false) {
                let name = semaContractName(encoded)

                if (semaIsParameterContract(name) == false) {
                    diag_error_at_code("P4103", param.file, param.line, param.col, __builtin_string_len(param.s1),
                        diagQuote(name).concat(" is a return contract and cannot appear on parameter ",
                                               diagQuote(param.s1)))
                    diag_note("parameters take `borrow`, `bytes`, `retain`, `retain_in(k)`, `consume` or `out`")
                } else if (semaContractIsStringOnly(name) and annotation.s1.equals("String") == false) {
                    diag_error_at_code("P4110", param.file, param.line, param.col, __builtin_string_len(param.s1),
                        diagQuote(name).concat(" applies to a String parameter, but ",
                                               diagQuote(param.s1), " is ", annotation.s1))
                    diag_note("it suppresses the NUL-terminated copy a String view would otherwise be given; no other type is copied there")
                } else if (name.equals("retain_in")) {
                    let target = optionOr(semaContractArgument(encoded).parseInt(), 0)
                    if (target < 0 or target >= arity) {
                        diag_error_at_code("P4104", param.file, param.line, param.col, __builtin_string_len(param.s1),
                            "`retain_in` names argument ".concat(semaContractArgument(encoded),
                                                                 ", but this function takes ",
                                                                 arity.toString()))
                        diag_note("the index is zero-based and names the container this argument is stored into")
                    } else if (target == index) {
                        diag_error_at_code("P4105", param.file, param.line, param.col, __builtin_string_len(param.s1),
                            "`retain_in` on ".concat(diagQuote(param.s1), " names itself"))
                        diag_note("it names the *other* argument this one is stored into; a value cannot contain itself")
                    }
                }
            }
            index = index + 1
        }
        paramPtr = param.next
    }

    if (nodeExists(extNode.child2)) {
        let ret = ptr_to_node(extNode.child2)
        if (semaExternTypeIsSlice(ret)) {
            diag_error_at_code("P4106", extNode.file, extNode.line, extNode.col, __builtin_string_len(extNode.s1),
                "Slice cannot cross an extern boundary without explicit marshalling")
            diag_note("return a C-compatible buffer and construct the Slice inside Prismio")
        }
        if (semaExternTypeIsDataView(ret)) {
            diag_error_at_code("P4107", extNode.file, extNode.line, extNode.col, __builtin_string_len(extNode.s1),
                "DataView cannot cross an extern boundary")
            diag_note("return ordinary AoS storage and construct the DataView inside Prismio")
        }
        if (ret.s2.equals("") == false) {
            let name = semaContractName(ret.s2)
            if (name.equals("alias") == false and name.equals("produce") == false) {
                diag_error_at_code("P4108", extNode.file, extNode.line, extNode.col, __builtin_string_len(extNode.s1),
                    diagQuote(name).concat(" is a parameter contract and cannot appear on a return type"))
                diag_note("returns take `alias` or `produce(free_fn)`")
            } else if (name.equals("produce")) {
                if (semaContractArgument(ret.s2).equals("")) {
                    diag_error_at_code("P4109", extNode.file, extNode.line, extNode.col, __builtin_string_len(extNode.s1),
                        "`produce` requires the name of the function that releases the value")
                    diag_note("FFI 5.2: calling `free` on something from a custom allocator is the bug this prevents")
                }
            }
        }
    }
}
