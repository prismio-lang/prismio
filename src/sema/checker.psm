// The checking passes themselves: expressions, statements, functions, and the
// module-level walk that drives them.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string

// Sema reports and keeps going. Stopping at the first type error meant one
// diagnostic per run, so fixing a file was a sequence of edit-rebuild rounds --
// which is also why enforcing `mut` needed the check shipped as a warning first
// to collect all 75 violations at once. The decision to give up belongs to
// compileSource(), which checks diag_error_count() before running codegen.
//
// Continuing is only safe because every caller of a checking function treats an
// invalid type as "already reported" (see semaExpectAssignable) and because
// the sites that would otherwise walk a null child return early instead.
internal fn semaErrorAt(node: ASTNode, message: String) {
    diag_error_at_code("P4001", node.file, node.line, node.col, node.len, message)
}

// For the few errors that belong to no particular node.
private fn semaError(message: String) {
    diag_error_code("P4002", message)
}

// SPEC 5: being wrong about an annotation is a diagnostic of severity *warning*
// and never fails compilation -- the annotation is discarded and the value is
// inferred normally. The one exception is a pin a converged analysis refutes
// (SPEC 5.4.1), which is a program error and goes through semaErrorAt.
internal fn semaWarningAt(node: ASTNode, message: String) {
    diag_warning_at_code("P4003", node.file, node.line, node.col, node.len, message)
}

// REQUIREMENTS 15. What may cross a task boundary as an argument.
//
// The predicate is "lowers to a pointer", not "is move-only", and the two are
// not the same set: `Ptr` is copyable and is admitted, an array is not admitted
// even though it is a reference, because an array literal is frame storage
// (typeIsMoveOnly says why) and a frame does not outlive the spawn.
//
// Enums and scalars are excluded because they lower to an integer. That is an
// ABI fact here, but it lines up with a memory-model one worth stating: a
// scalar registers no allocation site, so it is precisely the case AIF's `T`
// domain has nothing to say about, and admitting it would widen the surface
// without widening what the analysis can prove.
// What `prismio_task_invoke` has a correctly-typed function pointer for.
// Float and the sized integers are absent because each would need its own arm
// there rather than a cast -- calling an i32-returning function through a
// pointer declared to return something wider leaves the upper half undefined,
// which is the one class of bug a task runtime must not have.
private fn semaTaskResultAllowed(t: TypeInfo) -> Bool {
    if (t.kind == TypeKind.VOID) { return true }
    if (t.kind == TypeKind.INT) { return strEquals(t.name, "Int") }
    if (t.kind == TypeKind.STRUCT) { return true }
    if (t.kind == TypeKind.STRING) { return true }
    if (t.kind == TypeKind.LIST) { return true }
    return t.kind == TypeKind.PTR
}

private fn semaSpawnArgAllowed(t: TypeInfo) -> Bool {
    if (t.kind == TypeKind.STRUCT) { return true }
    if (t.kind == TypeKind.STRING) { return true }
    if (t.kind == TypeKind.LIST) { return true }
    return t.kind == TypeKind.PTR
}

internal fn semaTypeErrorAt(node: ASTNode, context: String, expected: TypeInfo, actual: TypeInfo) {
    semaErrorAt(node, strConcat(strConcat(context, ": expected "),
                  strConcat(typeDisplay(expected), strConcat(", found ", typeDisplay(actual)))))
}

// SPEC 5.1's `unique` on a parameter lowers to `noalias`, which makes it the one
// annotation whose falsehood is undefined behaviour rather than a lost
// optimisation. The axiom's local half is discharged by the affine discipline --
// a second owning reference in the declaring scope is already `use of moved
// value` -- but parameters borrow, so `f(x, x)` is two legal borrows and no rule
// above notices that it hands one object to two `unique` parameters.
//
// This is the reachable half of that hole, and it is the half worth having:
// aliasing through two *different* names still is not detected, which is what
// `unique` being an axiom means and is why deleting the annotation is always
// safe. Without this the annotation would be exactly the unsafe-not-slow error
// FFI 1 warns about, asserted by the programmer and trusted by LLVM with nothing
// in between.
private fn semaCheckUniqueArgs(expr: ASTNode, fnNode: ASTNode, name: String) {
    let mut outerArg = expr.child2
    let mut outerParam = fnNode.child1
    while (nodeExists(outerArg) and nodeExists(outerParam)) {
        let a = ptr_to_node(outerArg)
        let pa = ptr_to_node(outerParam)
        if (pa.i2 == 1 and a.kind == NodeKind.IDENTIFIER_EXPR) {
            let mut innerArg = a.next
            let mut innerParam = pa.next
            while (nodeExists(innerArg) and nodeExists(innerParam)) {
                let b = ptr_to_node(innerArg)
                let pb = ptr_to_node(innerParam)
                if (pb.i2 == 1 and b.kind == NodeKind.IDENTIFIER_EXPR) {
                    if (strEquals(a.s1, b.s1)) {
                        semaErrorAt(b, strConcat(strConcat("`", a.s1),
                            strConcat("` is passed to two `unique` parameters of ", diagQuote(name))))
                        diag_note("`unique` asserts exactly one reference exists, and this call makes two")
                    }
                }
                innerArg = b.next
                innerParam = pb.next
            }
        }
        outerArg = a.next
        outerParam = pa.next
    }
}

// The dotted name a call's receiver spells, or "" if it does not spell one.
// `std.string.strTrim(x)` reaches the qualified-call check below with a receiver
// that is itself a MEMBER_ACCESS -- `std.string` -- rather than the single
// identifier the leaf-qualifier version could assume.
//
// A local anywhere in the chain answers "", which is what keeps `p.state.reset()`
// a method call: the *root* is what decides, so a receiver rooted in a value is
// never read as a module however many segments follow it. That is the same
// ordering rule as the three readings of `a.b(...)` -- a local wins first.
private fn semaDottedModulePath(node: ASTNode) -> String {
    if (node.kind == NodeKind.IDENTIFIER_EXPR) {
        if (ir_has_var_type(node.s1) == 1) { return "" }
        return strClone(node.s1)
    }
    if (node.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let inner = semaDottedModulePath(ptr_to_node(node.child1))
        if (strEquals(inner, "")) { return "" }
        // Bound rather than nested: an intermediate passed straight into another
        // call has its release withheld (KNOWN_ISSUES.md, argument-position
        // release), so
        // `strConcat(strConcat(a, b), c)` leaks the inner result.
        let head = strConcat(inner, ".")
        return strConcat(head, node.s1)
    }
    return ""
}

// ---------------------------------------------------------------------------
// v0.1 3.6 -- the String operators, as desugarings
//
// `a == b`, `a + b`, `s[i]`, `s[a..b]` and `s.length` on a String are all
// rewritten here into the `std.string` call they mean, before anything else in
// the compiler sees them. Overload resolution, the ownership analysis, AIF and
// codegen therefore meet an ordinary call and need to know nothing about any of
// this -- the same trick monomorphisation, payload enums and method syntax all
// use, and the reason five operators cost one file rather than five passes.
//
// **The ownership consequence is the point, not a side effect.** `a + b`
// allocates. Because the rewrite produces a real call to `strConcat`, the result
// gets an owner exactly as `strConcat(a, b)` does, and RUNTIME.md 3.1's rule
// applies to it unchanged: `println(a + b)` leaks and `let j = a + b` does not.
// An operator lowered straight to IR would have had to re-derive that, and would
// have got it wrong in a place no ledger points at.
//
// **They need `import std.string`.** There is no prelude (RUNTIME.md 2): a
// program that compares no strings links no string code, which is what lets a
// target with no stdout link at all. Naming the missing import is a better
// diagnostic than the "unknown function `strEquals`" the bare rewrite produces,
// so every entry point below asks first.
// ---------------------------------------------------------------------------

// Whichever side of a mixed comparison is not the String, so the diagnostic can
// name the type that actually needs converting.
private fn typeStringOther(leftT: TypeInfo, rightT: TypeInfo) -> TypeInfo {
    if (leftT.kind == TypeKind.STRING) { return rightT }
    return leftT
}

// Whether the merged module declares a function of this name at all. The
// declaration index is by name, so this is a lookup and not a walk.
private fn semaDeclaresFunction(name: String) -> Bool {
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (decl.kind == NodeKind.FUNCTION) { return true }
        i = i + 1
    }
    return false
}

// Turn `expr` into a call to `name` over `args`, in place.
//
// In place by rewriting the kind, for the reason the payload-enum rewrite is:
// semaExpr runs over a node more than once -- overload resolution types every
// argument of every candidate -- and a node that has already become a call is
// simply re-checked as one. That is what makes every rewrite here idempotent.
//
// Every field the old kind used is cleared. A SLICE_EXPR carries a third child
// and a BINARY_EXPR carries its operator in `s1`, which is where a CALL_EXPR
// keeps its module qualifier; leaving either behind gives the call a qualifier
// nobody wrote.
private fn semaBecomeCall(expr: ASTNode, name: String, args: Ptr) {
    let callee = createNode(NodeKind.IDENTIFIER_EXPR)
    callee.s1 = strClone(name)
    nodeSpanFrom(callee, expr)

    expr.kind = NodeKind.CALL_EXPR
    expr.s1 = ""
    expr.i1 = 0
    expr.child1 = node_to_ptr(callee)
    expr.child2 = args
    expr.child3 = ptr_null()
}

// The operands as a fresh two-element sibling chain. Each is unlinked first:
// they were children of the node being rewritten, and a stale `next` would splice
// whatever followed the old node into the argument list.
private fn semaCallArgs2(a: ASTNode, b: ASTNode) -> Ptr {
    a.next = ptr_null()
    b.next = ptr_null()
    let args = nodeList()
    nodeListPush(args, a)
    nodeListPush(args, b)
    return args.head
}

private fn semaCallArgs3(a: ASTNode, b: ASTNode, c: ASTNode) -> Ptr {
    a.next = ptr_null()
    b.next = ptr_null()
    c.next = ptr_null()
    let args = nodeList()
    nodeListPush(args, a)
    nodeListPush(args, b)
    nodeListPush(args, c)
    return args.head
}

// Reported once, at the operator, naming the import rather than the function the
// rewrite was about to call.
private fn semaStringSugarAvailable(expr: ASTNode, fnName: String, what: String) -> Bool {
    if (semaDeclaresFunction(fnName)) { return true }
    semaErrorAt(expr, strConcat(what, " needs `import std.string`"))
    return false
}

// `a == b` is `strEquals(a, b)`; `a != b` is its negation; the four orderings are
// the sign of `strCompare` against zero, compared by the very operator being
// rewritten -- which is why the ordering case re-enters semaExpr on a node whose
// operands are now Int, and so cannot come back here.
private fn semaStringComparison(module: ASTNode, expr: ASTNode, op: String,
                                leftNode: ASTNode, rightNode: ASTNode) -> TypeInfo {
    if (strEquals(op, "==")) {
        semaBecomeCall(expr, "strEquals", semaCallArgs2(leftNode, rightNode))
        return semaExpr(module, expr)
    }

    if (strEquals(op, "!=")) {
        // The call becomes a *new* node and this one becomes the negation, not
        // the other way round: `expr` is the node the parent already points at.
        let inner = createNode(NodeKind.CALL_EXPR)
        nodeSpanFrom(inner, expr)
        semaBecomeCall(inner, "strEquals", semaCallArgs2(leftNode, rightNode))

        expr.kind = NodeKind.UNARY_EXPR
        expr.s1 = "!"
        expr.child1 = node_to_ptr(inner)
        expr.child2 = ptr_null()
        expr.child3 = ptr_null()
        return semaExpr(module, expr)
    }

    let cmp = createNode(NodeKind.CALL_EXPR)
    nodeSpanFrom(cmp, expr)
    semaBecomeCall(cmp, "strCompare", semaCallArgs2(leftNode, rightNode))

    let zero = createNode(NodeKind.LITERAL_EXPR)
    zero.i1 = TokenType.NUMBER_LITERAL
    zero.s1 = "0"
    nodeSpanFrom(zero, expr)

    expr.child1 = node_to_ptr(cmp)
    expr.child2 = node_to_ptr(zero)
    expr.child3 = ptr_null()
    return semaExpr(module, expr)
}

// Whether every leaf of a `+` spine is a String.
//
// Every leaf, not just the leftmost: `"n = " + count` must fall through to the
// arithmetic arm and be reported as the missing conversion it is, rather than
// reaching overload resolution as `strConcat("n = ", count)` and coming back as
// "no overload accepts these argument types". Typing a leaf here is free --
// semaExpr over an expression is idempotent, which is what the whole rewrite
// scheme already relies on.
private fn semaConcatSpineIsString(module: ASTNode, expr: ASTNode) -> Bool {
    if (expr.kind == NodeKind.BINARY_EXPR and strEquals(expr.s1, "+")) {
        if (semaConcatSpineIsString(module, ptr_to_node(expr.child1)) == false) { return false }
        return semaConcatSpineIsString(module, ptr_to_node(expr.child2))
    }
    return semaExpr(module, expr).kind == TypeKind.STRING
}

// `for c in s { ... }` rewritten into the range loop it means.
//
//     for $c in 0..strLength(s) { let c = s[$c]   ... }
//
// The element read is built as an INDEX_EXPR rather than as a direct call, which
// is deliberate: `s[$c]` re-enters the indexing arm, so a String gets `strCharAt`
// from the desugaring above and a `List` gets the existing element path
// **including `ir_unmark_list_exclusive`** -- the bookkeeping that makes binding
// an element safe. Emitting `list_get` by hand would have skipped it.
//
// **The collection has to be a name.** `for line in text.lines()` is refused, and
// not to keep this function simple: the loop needs the collection twice -- once
// for the length, once per element -- and an expression evaluated twice would run
// `lines()` per iteration. Binding it here instead is not available either,
// because a `let` needs a statement slot this rewrite does not have, and because
// binding a *name* would move it and leave `s` unusable after the loop. The
// caller writing `let parts = text.lines()` first is the same rule RUNTIME.md 3.1
// already imposes on that call: an owned result nothing names is a leak.
//
// The index is named after the loop variable, so nested loops cannot collide
// without the user's own variables colliding first. `$` is the compiler-generated
// marker no source identifier may contain.
private fn semaForEachDesugar(module: ASTNode, stmt: ASTNode) -> Bool {
    let source = ptr_to_node(stmt.child1)
    if (source.kind != NodeKind.IDENTIFIER_EXPR) {
        semaErrorAt(source, "the collection in a `for ... in` loop must be a name")
        diag_note("bind it first -- `let parts = text.lines()`, then `for p in parts`")
        return false
    }

    let sourceT = semaExpr(module, source)
    if (typeIsValid(sourceT) == false) { return false }

    let mut lengthFn = "list_len"
    if (sourceT.kind == TypeKind.STRING) {
        lengthFn = "strLength"
        if (semaStringSugarAvailable(stmt, "strLength", "iterating a String") == false) {
            return false
        }
    } else if (sourceT.kind != TypeKind.LIST) {
        semaErrorAt(source, strConcat("`for ... in` needs a String or a List, found ",
                                      typeDisplay(sourceT)))
        diag_note("iterate anything else by index -- `for i in 0..n`")
        return false
    }

    let indexName = strConcat("$", stmt.s1)

    // let <var> = <source>[<indexName>], prepended to the body the user wrote.
    let index = createNode(NodeKind.INDEX_EXPR)
    nodeSpanFrom(index, source)
    index.child1 = node_to_ptr(semaNameNode(source, source.s1))
    index.child2 = node_to_ptr(semaNameNode(source, indexName))

    let bind = createNode(NodeKind.VARIABLE_DECL)
    nodeSpanFrom(bind, stmt)
    bind.s1 = stmt.s1
    bind.child2 = node_to_ptr(index)

    let body = ptr_to_node(stmt.child3)
    bind.next = body.child1
    body.child1 = node_to_ptr(bind)

    // The header becomes the range. `stmt.s1` is read into `indexName` above
    // before it is overwritten here.
    let length = createNode(NodeKind.CALL_EXPR)
    nodeSpanFrom(length, source)
    let lengthArgs = nodeList()
    nodeListPush(lengthArgs, semaNameNode(source, source.s1))
    semaBecomeCall(length, lengthFn, lengthArgs.head)

    let zero = createNode(NodeKind.LITERAL_EXPR)
    zero.i1 = TokenType.NUMBER_LITERAL
    zero.s1 = "0"
    nodeSpanFrom(zero, source)

    stmt.s1 = indexName
    stmt.child1 = node_to_ptr(zero)
    stmt.child2 = node_to_ptr(length)
    return true
}

// A fresh identifier node. Fresh rather than reused: the source appears three
// times in the rewrite, and one node cannot be in three places in a tree whose
// siblings are a `next` chain.
private fn semaNameNode(at: ASTNode, name: String) -> ASTNode {
    let node = createNode(NodeKind.IDENTIFIER_EXPR)
    node.s1 = strClone(name)
    nodeSpanFrom(node, at)
    return node
}

// Every leaf of a `+` spine, in source order, as one sibling chain.
//
// Both sides are walked, so `a + (b + c)` flattens exactly as `a + b + c` does
// -- parentheses group, they do not change what is being concatenated. The
// intermediate BINARY_EXPR nodes are simply abandoned; the AST is arena memory
// and nothing else points at them once this node has been rewritten.
private fn semaConcatParts(expr: ASTNode, parts: NodeList) {
    if (expr.kind == NodeKind.BINARY_EXPR and strEquals(expr.s1, "+")) {
        semaConcatParts(ptr_to_node(expr.child1), parts)
        semaConcatParts(ptr_to_node(expr.child2), parts)
        return
    }
    expr.next = ptr_null()
    nodeListPush(parts, expr)
}

// `a + b + c` is **one** `strConcat`, not two.
//
// Nested `strConcat(strConcat(a, b), c)` allocates an intermediate that nothing
// names, and RUNTIME.md 3.1 is that a value nothing names is a value nothing
// frees -- measured at 2 allocated / 1 released, on the released 0.1 compiler
// too, so it is the language's rule and not a regression. Lowering the chain
// pairwise would therefore have made the obvious spelling of the obvious
// operation leak once per `+`, which is not an operator worth having.
//
// Flattening removes the intermediate rather than leaking it, and copies each
// byte once instead of twice. Past six parts there is no overload to call and
// `strJoin` is the better answer anyway, so that is where it stops -- as an
// error naming the alternative, never as a silent fallback to the leaking form.
private fn semaStringConcatChain(module: ASTNode, expr: ASTNode) -> TypeInfo {
    if (semaStringSugarAvailable(expr, "strConcat", "joining Strings with `+`") == false) {
        nodeSetType(expr, typeString())
        return typeString()
    }

    let parts = nodeList()
    semaConcatParts(expr, parts)

    let mut count = 0
    let mut partPtr = parts.head
    while (nodeExists(partPtr)) {
        count = count + 1
        partPtr = ptr_to_node(partPtr).next
    }

    if (count > 6) {
        semaErrorAt(expr, "joining more than six Strings with `+` is not supported")
        diag_note("build a `List<String>` and call `strJoin(parts, \"\")` instead")
        nodeSetType(expr, typeString())
        return typeString()
    }

    semaBecomeCall(expr, "strConcat", parts.head)
    return semaExpr(module, expr)
}

// `s.length` -- a property, which is `length(s)` with the parentheses left off.
//
// **A property may not allocate, and that is enforced rather than documented.**
// `s.length` reading as a field is right; `s.trim` reading as a field is a trap,
// because it allocates and RUNTIME.md 3.1 then requires the result to be bound.
// So the rewrite is refused when the resolved function returns an owned value,
// with a message that says to add the parentheses. That rule needs no new
// keyword, which matters: a `prop` marker could not be used in `std/string.psm`
// until the committed seed understood it, and CODE_STYLE's two-step would have
// made this a two-release feature.
//
// The return type is read from the *declaration* rather than by typing the
// rewritten call, so the refusal happens before any node is modified. Rewriting
// first and complaining afterwards would report once per pass of overload
// resolution over the enclosing call.
private fn semaPropertyReturnsOwned(module: ASTNode, name: String) -> Bool {
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (decl.kind == NodeKind.FUNCTION and semaParamCount(decl) == 1) {
            if (nodeIsNull(decl.child3)) { return false }
            return typeIsMoveOnly(semaAnnotationType(module, ptr_to_node(decl.child3)))
        }
        i = i + 1
    }
    return false
}

private fn semaParamCount(decl: ASTNode) -> Int {
    let mut n = 0
    let mut paramPtr = decl.child1
    while (nodeExists(paramPtr)) {
        n = n + 1
        paramPtr = ptr_to_node(paramPtr).next
    }
    return n
}

// 0 -- not a property, the caller should carry on and report what it was going to.
// 1 -- rewritten into a call; re-enter semaExpr.
// 2 -- refused, **and already reported**. The caller must stop: appending
//      "no property `trim` on String" to a message that already named the fix is
//      two errors for one mistake, which is what this three-way answer avoids.
private fn semaPropertyRewrite(module: ASTNode, expr: ASTNode) -> Int {
    let name = expr.s1
    if (semaDeclaresFunction(name) == false) { return 0 }

    if (semaPropertyReturnsOwned(module, name)) {
        semaErrorAt(expr, strConcat(strConcat("property ", diagQuote(name)),
                                    " returns an owned value, so it allocates; call it as a method instead"))
        diag_note("a property must not allocate -- write `()` after the name")
        return 2
    }

    let receiver = ptr_to_node(expr.child1)
    receiver.next = ptr_null()
    let args = nodeList()
    nodeListPush(args, receiver)
    semaBecomeCall(expr, name, args.head)
    return 1
}

internal fn semaExpr(module: ASTNode, expr: ASTNode) -> TypeInfo {
    if (nodeHasType(expr)) {
        return nodeGetType(expr)
    }

    if (expr.kind == NodeKind.LITERAL_EXPR) {
        let mut t = typeInvalid()
        if (expr.i1 == TokenType.NUMBER_LITERAL) { t = typeInt() }
        if (expr.i1 == TokenType.FLOAT_LITERAL) { t = typeFloat() }
        if (expr.i1 == TokenType.BOOL_LITERAL) { t = typeBool() }
        if (expr.i1 == TokenType.CHAR_LITERAL) { t = typeChar() }
        if (expr.i1 == TokenType.STRING_LITERAL) { t = typeString() }
        nodeSetType(expr, t)
        return t
    }

    if (expr.kind == NodeKind.IDENTIFIER_EXPR) {
        if (ir_has_var_type(expr.s1) == 0) {
            semaErrorAt(expr, strConcat("unknown identifier ", diagQuote(expr.s1)))
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        if (ir_is_moved(expr.s1) == 1) {
            semaErrorAt(expr, strConcat("use of moved value ", diagQuote(expr.s1)))
        }
        let mut t = typeFromSemKey(ir_get_var_type(expr.s1))
        nodeSetType(expr, t)
        return t
    }

    // REQUIREMENTS 4. `none` is absent-of-anything: an optional with no inner
    // type, which typeEquals matches against every `T?`. It registers no
    // allocation site, which is what keeps the memory model out of this -- there
    // is nothing to place, count or release.
    if (expr.kind == NodeKind.NONE_LITERAL_EXPR) {
        let nt = typeNone()
        nodeSetType(expr, nt)
        return nt
    }

    // `expr as T`. Explicit conversion between scalar types -- the only way to
    // move between integer widths, or between integers and floats, at all.
    // Deliberately narrow: only conversions with an unambiguous meaning are
    // allowed, so a cast never quietly reinterprets memory.
    if (expr.kind == NodeKind.CAST_EXPR) {
        let source = ptr_to_node(expr.child1)
        let fromT = semaExpr(module, source)
        let toT = semaAnnotationType(module, ptr_to_node(expr.child2))

        let fromScalar = fromT.kind == TypeKind.INT or fromT.kind == TypeKind.FLOAT
                          or fromT.kind == TypeKind.CHAR or fromT.kind == TypeKind.BOOL
                          or fromT.kind == TypeKind.ENUM
        // Bool is included here so the check below reports the specific reason
        // rather than falling into the generic "expected X, got Y".
        let toScalar = toT.kind == TypeKind.INT or toT.kind == TypeKind.FLOAT
                        or toT.kind == TypeKind.CHAR or toT.kind == TypeKind.ENUM
                        or toT.kind == TypeKind.BOOL

        // Bool converts out to a number but nothing converts *to* Bool: an
        // implicit "non-zero is true" rule is exactly the kind of silent
        // coercion this language avoids. Write `x != 0`.
        if (toT.kind == TypeKind.BOOL) {
            semaErrorAt(expr, "cannot cast to Bool; compare explicitly instead, as in `x != 0`")
            nodeSetType(expr, toT)
            return toT
        }

        if (fromScalar == false or toScalar == false) {
            semaTypeErrorAt(expr, "cast", toT, fromT)
        }

        nodeSetType(expr, toT)
        return toT
    }

    if (expr.kind == NodeKind.UNARY_EXPR) {
        let operand = ptr_to_node(expr.child1)
        let operandT = semaExpr(module, operand)
        let uop = expr.s1

        if (strEquals(uop, "!")) {
            semaExpectAssignable(operand, "operator `!`", typeBool(), operandT)
            nodeSetType(expr, typeBool())
            return typeBool()
        }

        if (strEquals(uop, "~")) {
            if (operandT.kind != TypeKind.INT and operandT.kind != TypeKind.CHAR) {
                semaErrorAt(operand, "unary `~` requires an integer operand")
            }
            nodeSetType(expr, operandT)
            return operandT
        }

        if (strEquals(uop, "-")) {
            if (typeIsNumeric(operandT) == false) {
                semaErrorAt(operand, "unary `-` requires a numeric operand")
            }
            // Negating an unsigned value is almost always a mistake, and the
            // result is not representable in the operand's own type. Reject it
            // rather than silently wrapping.
            if (typeIntIsUnsigned(operandT)) {
                semaErrorAt(operand, strConcat("cannot apply unary `-` to unsigned type ", typeDisplay(operandT)))
            }
            nodeSetType(expr, operandT)
            return operandT
        }

        semaErrorAt(expr, strConcat("unknown unary operator ", diagQuote(uop)))
        nodeSetType(expr, typeInvalid())
        return typeInvalid()
    }

    if (expr.kind == NodeKind.BINARY_EXPR) {
        // v0.1 3.6. A `+` spine over Strings is flattened here, **before either
        // operand is typed**, and the ordering is the whole reason this is not
        // three lines further down: typing the left operand of `a + b + c`
        // rewrites the inner `+` into its `strConcat` call, after which the spine
        // is no longer visible and the chain lowers pairwise -- which is the
        // leaking form. Measured in exactly that shape: 2 allocated, 1 released.
        if (strEquals(expr.s1, "+") and semaConcatSpineIsString(module, expr)) {
            return semaStringConcatChain(module, expr)
        }

        let leftNode = ptr_to_node(expr.child1)
        let rightNode = ptr_to_node(expr.child2)
        let mut leftT = semaExpr(module, leftNode)
        let mut rightT = semaExpr(module, rightNode)

        // Coerce a bare integer literal to the other operand's integer type so
        // mixing a sized int with a literal (e.g. `n <= 0`, `u / 7`) type-checks.
        if (leftT.kind == TypeKind.INT and rightT.kind == TypeKind.INT and typeEquals(leftT, rightT) == false) {
            if (semaIsIntLiteral(rightNode)) {
                nodeSetType(rightNode, leftT)
                rightT = typeCopy(leftT)
            } else if (semaIsIntLiteral(leftNode)) {
                nodeSetType(leftNode, rightT)
                leftT = typeCopy(rightT)
            }
        }

        let op = expr.s1

        if (strEquals(op, "and") or strEquals(op, "or")) {
            semaExpectAssignable(leftNode, "boolean operator left operand", typeBool(), leftT)
            semaExpectAssignable(rightNode, "boolean operator right operand", typeBool(), rightT)
            nodeSetType(expr, typeBool())
            return typeBool()
        }

        if (strEquals(op, "+") or strEquals(op, "-") or strEquals(op, "*") or strEquals(op, "/")) {
            if (typeIsNumeric(leftT) == false) {
                semaErrorAt(leftNode, strConcat(strConcat("operator ", diagQuote(op)), " requires numeric operands"))
            }
            semaExpectAssignable(rightNode, strConcat("operator ", diagQuote(op)), leftT, rightT)
            nodeSetType(expr, leftT)
            return leftT
        }

        // Modulo follows the same rule as + - * /: the left operand drives the
        // result type, so it works on every sized integer type. Hardcoding
        // typeInt() here rejected `u % 7` for any u that was not a plain Int,
        // even though codegen has always emitted the right urem/srem for it.
        // Still integer-only -- there is no frem in codegen.
        if (strEquals(op, "%")) {
            if (leftT.kind != TypeKind.INT and leftT.kind != TypeKind.ENUM) {
                semaErrorAt(leftNode, "operator `%` requires integer operands")
            }
            semaExpectAssignable(rightNode, "operator `%`", leftT, rightT)
            nodeSetType(expr, leftT)
            return leftT
        }

        // Bitwise and/or/xor: integer-shaped operands of the same type.
        if (strEquals(op, "&") or strEquals(op, "|") or strEquals(op, "^")) {
            if (leftT.kind != TypeKind.INT and leftT.kind != TypeKind.ENUM and leftT.kind != TypeKind.CHAR) {
                semaErrorAt(leftNode, strConcat(strConcat("bitwise operator ", diagQuote(op)), " requires integer operands"))
            }
            semaExpectAssignable(rightNode, strConcat("operator ", diagQuote(op)), leftT, rightT)
            nodeSetType(expr, leftT)
            return leftT
        }

        // Shifts. The result takes the left operand's type, and the shift amount
        // is an independent integer rather than something that has to match it.
        if (strEquals(op, "<<") or strEquals(op, ">>")) {
            if (leftT.kind != TypeKind.INT and leftT.kind != TypeKind.CHAR) {
                semaErrorAt(leftNode, strConcat(strConcat("shift ", diagQuote(op)), " requires an integer left operand"))
            }
            if (rightT.kind != TypeKind.INT) {
                semaErrorAt(rightNode, strConcat(strConcat("the shift amount of ", diagQuote(op)), " must be an integer"))
            }
            nodeSetType(expr, leftT)
            return leftT
        }

        if (strEquals(op, "==") or strEquals(op, "!=") or strEquals(op, "<") or strEquals(op, "<=") or strEquals(op, ">") or strEquals(op, ">=")) {
            // REQUIREMENTS 4. `x == none` is the presence test, and it is
            // checked before the String and struct rejections below -- a
            // `String?` compared against `none` is a null test and not the
            // address comparison those exist to forbid.
            //
            // Only equality: an optional has no order, and `<` on one would be
            // comparing addresses, which is exactly the silent wrong answer the
            // next two rules are about.
            if (leftT.kind == TypeKind.OPTIONAL or rightT.kind == TypeKind.OPTIONAL) {
                if (strEquals(op, "==") == false and strEquals(op, "!=") == false) {
                    semaErrorAt(expr, strConcat(strConcat("cannot order optional values with ",
                                                              diagQuote(op)),
                                                   "; compare with `none` instead"))
                } else if (leftT.kind != TypeKind.OPTIONAL or rightT.kind != TypeKind.OPTIONAL) {
                    // Comparing `T?` to a present `T` would be an address
                    // comparison, which is the thing the String rule forbids.
                    semaErrorAt(expr, "an optional can only be compared with `none`")
                }
                nodeSetType(expr, typeBool())
                return typeBool()
            }

            // v0.1 3.6. Two Strings compare by *content*, via the desugaring
            // above.
            //
            // This was a hard rejection naming `strEquals`, and the rejection was
            // right for the reason it gave: a String is a pointer, so a raw
            // comparison compares addresses and quietly answers "not equal" for
            // two equal strings. What changed is not that the hazard went away
            // but that the operator now means the call instead of the address --
            // there is no longer an address comparison to fall into.
            if (leftT.kind == TypeKind.STRING and rightT.kind == TypeKind.STRING) {
                let mut cmpFn = "strCompare"
                if (strEquals(op, "==") or strEquals(op, "!=")) { cmpFn = "strEquals" }
                if (semaStringSugarAvailable(expr, cmpFn,
                        strConcat(strConcat("comparing String values with ", diagQuote(op)), "")) == false) {
                    nodeSetType(expr, typeBool())
                    return typeBool()
                }
                return semaStringComparison(module, expr, op, leftNode, rightNode)
            }
            // One side a String and the other not. Never an address comparison,
            // so it gets its own message rather than the one above: the mistake
            // is a missing conversion, not a missing `strEquals`.
            if (leftT.kind == TypeKind.STRING or rightT.kind == TypeKind.STRING) {
                semaErrorAt(expr, strConcat(strConcat("cannot compare a String with ",
                                                      typeDisplay(typeStringOther(leftT, rightT))),
                                            "; convert one side first"))
                nodeSetType(expr, typeBool())
                return typeBool()
            }
            if (leftT.kind == TypeKind.STRUCT or rightT.kind == TypeKind.STRUCT) {
                semaErrorAt(expr, "cannot compare struct values directly; compare their fields")
                nodeSetType(expr, typeBool())
                return typeBool()
            }

            semaExpectAssignable(rightNode, strConcat("comparison ", diagQuote(op)), leftT, rightT)
            nodeSetType(expr, typeBool())
            return typeBool()
        }

        semaErrorAt(expr, strConcat("unknown operator ", diagQuote(op)))
        nodeSetType(expr, typeInvalid())
        return typeInvalid()
    }

    if (expr.kind == NodeKind.CLOSURE_EXPR) {
        return semaLowerClosure(module, expr)
    }

    if (expr.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(expr.child1)

        // A call to a generic function names a template, not a declaration.
        // Solving its type arguments needs the types of the arguments, which is
        // why this is sema's job rather than the parser's -- and rewriting the
        // callee to the instantiated name is what leaves everything below,
        // overload resolution included, exactly as it was.
        // `Shape.Circle(5)` -- a payload variant, which is a constructor rather
        // than a call. Rewritten into a struct literal here, before anything
        // tries to resolve `Circle` as a function; semaExpr is re-entered on the
        // rewritten node so the literal is checked exactly as a written one is.
        if (callee.kind == NodeKind.MEMBER_ACCESS_EXPR) {
            let target = ptr_to_node(callee.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR or target.kind == NodeKind.TYPE_ANNOTATION) {
                if (enumResolveConstruction(module, expr, target.s1, callee.s1,
                                            expr.child2, enumExplicitArgs(target))) {
                    return semaExpr(module, expr)
                }
            }

            // v0.1 3.5. `token.isKeyword(w)` -- a *module*-qualified call.
            //
            // Checked before the method rewrite below, and after enum
            // construction above, because all three spell `a.b(...)`. What tells
            // them apart is what `a` is: a local of some type is a receiver, an
            // enum name is a constructor, and a name that is neither but that
            // some declaration of `b` was parsed under is a module.
            //
            // The qualifier is parked on the call's `s1`, where overload
            // resolution reads it as a filter. It survives the re-entry into
            // semaExpr and monoCopyOne's copy, which is what makes this
            // idempotent and instantiation-safe.
            let modulePath = semaDottedModulePath(target)
            if (strEquals(modulePath, "") == false
                and semaModuleDeclares(modulePath, callee.s1)) {
                let qualifiedName = createNode(NodeKind.IDENTIFIER_EXPR)
                qualifiedName.s1 = strClone(callee.s1)
                nodeSpanFrom(qualifiedName, callee)
                expr.s1 = strClone(modulePath)
                expr.child1 = node_to_ptr(qualifiedName)
                return semaExpr(module, expr)
            }

            // Method call syntax, as a rewrite: `x.f(a)` **is** `f(x, a)`.
            //
            // The parser already accepts the shape -- `text.trim()` reached here
            // and failed with "unknown function `trim`", because the receiver was
            // read off as the *name* and then dropped. Prepending it as argument
            // zero is the whole feature: overload resolution, ownership, AIF and
            // codegen then see an ordinary call and need to know nothing.
            //
            // The same trick as monomorphisation and payload enums -- put the
            // feature in the AST, not in five passes -- and it is what makes
            // `impl` blocks cheap later: a method is a free function whose first
            // parameter is the receiver, so an `impl` block is a *naming*
            // construct over this, not a second dispatch mechanism.
            //
            // A TYPE_ANNOTATION receiver is skipped: that is `Type.member`, which
            // is a qualified name rather than a value, and rewriting it would
            // turn a bad enum variant into a confusing call to `member`.
            // A module qualifier whose member does not exist. Reported here
            // rather than left to fall through, because the fall-through is the
            // method rewrite -- and `text.nosuch()` becoming `nosuch(text)`
            // reports "unknown function `nosuch`", which sends the reader to
            // check their spelling when the answer is their imports.
            if (strEquals(modulePath, "") == false
                and semaQualifierNamesModule(modulePath)) {
                semaErrorAt(callee, strConcat(strConcat("module ", diagQuote(modulePath)),
                                              strConcat(" declares no ", diagQuote(callee.s1))))
                nodeSetType(expr, typeInvalid())
                return typeInvalid()
            }

            // A qualifier that names no module but is spelled like the *leaf* of
            // one. Qualifiers were file leaves until they became import paths, so
            // `string.strTrim(x)` is the shape of every call written against the
            // older spelling -- and the fall-through answer for it is "unknown
            // identifier `string`", which sends the reader looking for a variable
            // they never declared instead of at the name of their import.
            if (strEquals(modulePath, "") == false
                and semaQualifierNamesModule(modulePath) == false) {
                let suggestion = semaModuleWithLeaf(modulePath)
                if (strEquals(suggestion, "") == false) {
                    semaErrorAt(target, strConcat("no module ", diagQuote(modulePath)))
                    diag_note(strConcat(strConcat("a module is qualified by its full import path -- did you mean ",
                                                  diagQuote(suggestion)),
                                        "?"))
                    nodeSetType(expr, typeInvalid())
                    return typeInvalid()
                }
            }

            if (target.kind != NodeKind.TYPE_ANNOTATION) {
                let methodName = createNode(NodeKind.IDENTIFIER_EXPR)
                methodName.s1 = callee.s1
                nodeSpanFrom(methodName, callee)

                let receiverPtr = callee.child1
                ptr_to_node(receiverPtr).next = expr.child2
                expr.child1 = node_to_ptr(methodName)
                expr.child2 = receiverPtr
                return semaExpr(module, expr)
            }
        }

        // v0.1 3.4. `f(x)` where `f` is a *value* rather than a function: the
        // closure a generic received. Rewritten to `call(f, x)`, which is the
        // same rewrite 3.1 does for `x.f(a)` and lands in the same place --
        // overload resolution over the synthesised `call` functions.
        //
        // Gated on the local's type being a *closure* type rather than on there
        // being no function of that name, and the difference is not cosmetic:
        // `std/string.psm` declares `compare`, so a sort whose comparator
        // parameter was called `compare` would have had its call quietly resolved
        // to the String overload. A closure type's name is compiler-generated and
        // contains `$`, which no user identifier may, so this fires for a closure
        // and for nothing else.
        if (callee.kind == NodeKind.IDENTIFIER_EXPR and ir_has_var_type(callee.s1) == 1) {
            let calleeT = typeFromSemKey(ir_get_var_type(callee.s1))
            if (calleeT.kind == TypeKind.STRUCT and strStartsWith(calleeT.name, semaClosurePrefix())) {
                let receiver = createNode(NodeKind.IDENTIFIER_EXPR)
                receiver.s1 = strClone(callee.s1)
                nodeSpanFrom(receiver, callee)
                receiver.next = expr.child2
                callee.s1 = "call"
                expr.child2 = node_to_ptr(receiver)
                return semaExpr(module, expr)
            }
        }

        monoResolveGenericCall(module, expr, callee)

        // A bound on the template this call names is violated, and monoCheckBounds
        // has said so once. Resolving an overload for it would report the same
        // mistake a second time in the overload machinery's vocabulary, and
        // checking its arguments a third. `i1` is free on a CALL_EXPR and the flag
        // has to live on the node rather than in a local, because semaExpr runs
        // over a call more than once.
        if (expr.i1 == 1) {
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }

        let name = callee.s1

        if (semaCheckBuiltinCall(module, expr, name, expr.child2)) {
            let builtinT = semaBuiltinCallType(name, expr.child2)
            nodeSetType(expr, builtinT)
            return builtinT
        }

        let fnNode = semaFindFunctionOverload(module, expr, name, expr.child2)

        let mut argPtr = expr.child2
        let mut paramPtr = fnNode.child1
        while (nodeExists(argPtr) and nodeExists(paramPtr)) {
            let argNode = ptr_to_node(argPtr)
            let paramNode = ptr_to_node(paramPtr)
            let paramT = semaAnnotationType(module, ptr_to_node(paramNode.child1))
            semaCheckValue(module, argNode, paramT, strConcat(diagQuote(name), " argument"))
            // Only `sink` parameters take ownership; `let`/`inout` borrow.
            if (strEquals(paramNode.s2, "sink")) {
                semaConsumeOperand(argNode)
            } else if (argNode.kind == NodeKind.IDENTIFIER_EXPR
                       and nodeGetType(argNode).kind == TypeKind.LIST) {
                // A callee may return or store a derived element borrow. With no
                // interprocedural lifetime in sema, crossing the call closes the
                // positive exclusive-replacement capability.
                ir_unmark_list_exclusive(argNode.s1)
            }
            argPtr = argNode.next
            paramPtr = paramNode.next
        }
        semaCheckUniqueArgs(expr, fnNode, name)

        let mut retT = typeVoid()
        if (fnNode.kind == NodeKind.FUNCTION) {
            retT = semaDeclaredReturnType(module, fnNode.child3)
            if (strEquals(name, "main")) { retT = typeInt() }
        } else {
            retT = semaDeclaredReturnType(module, fnNode.child2)
        }
        expr.s2 = semaFunctionSymbol(module, fnNode)
        nodeSetType(expr, retT)
        return retT
    }

    // REQUIREMENTS 15, and every restriction below is SPEC 11 item 10 made
    // enforceable rather than hoped for.
    //
    // The load-bearing line is `semaConsumeOperand`. A spawned argument is
    // **moved**, exactly as a `sink` parameter is, so the parent's binding is
    // dead the moment the task exists. That single fact is what "no shared
    // mutable heap" means operationally, it is what makes INFERENCE's
    // T-SPAWN-MOVE rather than T-SPAWN-SHARE the rule that fires, and it is
    // therefore what keeps T3's counter non-atomic. Delete it and the whole
    // isolation argument becomes a comment.
    if (expr.kind == NodeKind.SPAWN_EXPR) {
        let call = ptr_to_node(expr.child1)
        if (call.kind != NodeKind.CALL_EXPR) {
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }

        let retT = semaExpr(module, call)

        // Not a restriction on tasks so much as a restriction on this
        // *lowering*: prismio_task_spawn calls through a function pointer whose
        // type it has to know statically, and a builtin or an overload set does
        // not give it an address. Naming the reason matters -- it is the thing
        // that would have to change to lift the ceiling, and it is not the task
        // model.
        if (strEquals(call.s2, "")) {
            semaErrorAt(expr, "`spawn` needs a named Prismio function; a builtin has no address to hand a task")
        }

        // Any result the runtime has an honestly-typed function pointer for:
        // an Int, a reference, or nothing. What is excluded is Float and the
        // sized integers, because those come back in a different register class
        // or width and would need their own arm rather than a cast.
        if (typeIsValid(retT) and semaTaskResultAllowed(retT) == false) {
            semaErrorAt(expr, strConcat(strConcat("a spawned function cannot return ",
                                                    typeDisplay(retT)),
                                         "; a task result must be Int, a reference type, or nothing"))
        }

        let mut argPtr = call.child2
        let mut argc = 0
        while (nodeExists(argPtr)) {
            let argNode = ptr_to_node(argPtr)
            let argT = nodeGetType(argNode)
            // Pointer-lowered types only. A task's arguments cross a thread
            // boundary through three void* slots, and an Int would need a
            // fourth signature; more to the point, a scalar has no allocation
            // site, so it is exactly the case the T domain has nothing to say
            // about.
            if (typeIsValid(argT) and semaSpawnArgAllowed(argT) == false) {
                semaErrorAt(argNode, strConcat(strConcat("a spawned argument must be a reference type, found ",
                                                           typeDisplay(argT)),
                                                "; tasks own what they are given, and a scalar has nothing to own"))
            }
            semaConsumeOperand(argNode)
            argc = argc + 1
            argPtr = argNode.next
        }

        if (argc > 3) {
            semaErrorAt(expr, "`spawn` takes at most 3 arguments; pack the rest into a struct and move that")
        }

        // `Task<R>`, where R is what the spawned function returns. The handle
        // is still one opaque word; what the type adds is that `join` knows
        // what comes out of it, so a task's result is checked rather than
        // assumed to be an Int.
        let taskT = typeTask(retT)
        nodeSetType(expr, taskT)
        return taskT
    }

    if (expr.kind == NodeKind.JOIN_EXPR) {
        let handle = ptr_to_node(expr.child1)
        let handleT = semaExpr(module, handle)
        if (typeIsValid(handleT) == false) {
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        if (typeIsTask(handleT) == false) {
            semaErrorAt(handle, strConcat(strConcat("`join` needs a task handle, found ",
                                                      typeDisplay(handleT)),
                                           "; only `spawn` produces one"))
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        let resultT = typeTaskResult(handleT)
        nodeSetType(expr, resultT)
        return resultT
    }

    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let objectNode = ptr_to_node(expr.child1)

        // `Shape.Dot` -- a payload enum's variant that happens to carry nothing.
        // It is still the tagged struct, not an integer, because the enum it
        // belongs to has payloads elsewhere and one value has one representation.
        if (objectNode.kind == NodeKind.IDENTIFIER_EXPR or objectNode.kind == NodeKind.TYPE_ANNOTATION) {
            if (enumResolveConstruction(module, expr, objectNode.s1, expr.s1, ptr_null(),
                                        enumExplicitArgs(objectNode))) {
                return semaExpr(module, expr)
            }
        }

        if (objectNode.kind == NodeKind.IDENTIFIER_EXPR and semaEnumHasVariant(module, objectNode.s1, expr.s1)) {
            nodeSetType(expr, typeInt())
            return typeInt()
        }

        let objectT = semaExpr(module, objectNode)
        if (objectT.kind == TypeKind.DATAELEMENT) {
            if (nodeIsNull(objectT.child)) {
                semaErrorAt(objectNode, "DataView element has no row type")
                nodeSetType(expr, typeInvalid())
                return typeInvalid()
            }
            let rowT = ptr_to_type(objectT.child)
            if (rowT.kind != TypeKind.STRUCT) {
                semaErrorAt(objectNode, strConcat("DataView element must name a struct, found ",
                                                   typeDisplay(rowT)))
                nodeSetType(expr, typeInvalid())
                return typeInvalid()
            }
            let dataFieldT = semaFindStructFieldType(module, expr, rowT.name, expr.s1)
            nodeSetType(expr, dataFieldT)
            return dataFieldT
        }
        // v0.1 3.6. `s.length` -- a property. Tried after a struct's own fields
        // and before the failure, so a field always wins and no existing program
        // changes meaning; a struct may still have a property, which is what
        // makes `point.magnitude` available next to `point.x`.
        if (objectT.kind != TypeKind.STRUCT or semaStructHasField(objectT.name, expr.s1) == false) {
            if (typeIsValid(objectT)) {
                let property = semaPropertyRewrite(module, expr)
                if (property == 1) { return semaExpr(module, expr) }
                if (property == 2) {
                    nodeSetType(expr, typeInvalid())
                    return typeInvalid()
                }
            }
        }

        if (objectT.kind != TypeKind.STRUCT) {
            // An Invalid object is the *result* of an error already reported --
            // an unresolvable call, a violated bound. Blaming this expression for
            // it is the same mistake semaExpectAssignable refuses to make, and it
            // is how one wrong type argument became a screenful.
            if (typeIsValid(objectT)) {
                // An optional keeps the older wording, because for `T?` the
                // cause is not a missing property: it is that a `T?` is not a
                // `T` until it has been unwrapped, which is the entire point of
                // REQUIREMENTS 4's type. Naming a property here would send the
                // reader looking for a spelling mistake.
                if (objectT.kind == TypeKind.OPTIONAL) {
                    semaErrorAt(objectNode, strConcat("member access requires a struct value, found ",
                                                      typeDisplay(objectT)))
                    diag_note("unwrap it first -- `expect(value)`")
                } else {
                    semaErrorAt(objectNode, strConcat(strConcat("no property ", diagQuote(expr.s1)),
                                                      strConcat(" on ", typeDisplay(objectT))))
                }
            }
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        let fieldT = semaFindStructFieldType(module, expr, objectT.name, expr.s1)
        nodeSetType(expr, fieldT)
        return fieldT
    }

    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let mut elemPtr = expr.child1
        if (nodeIsNull(elemPtr)) {
            let arrT = typeArray(typeInvalid())
            nodeSetType(expr, arrT)
            return arrT
        }

        let firstT = semaExpr(module, ptr_to_node(elemPtr))
        elemPtr = ptr_to_node(elemPtr).next
        while (nodeExists(elemPtr)) {
            let elem = ptr_to_node(elemPtr)
            let elemT = semaExpr(module, elem)
            semaExpectAssignable(elem, "array literal element", firstT, elemT)
            elemPtr = elem.next
        }

        let arrT2 = typeArray(firstT)
        nodeSetType(expr, arrT2)
        return arrT2
    }

    if (expr.kind == NodeKind.INDEX_EXPR) {
        let collectionT = semaExpr(module, ptr_to_node(expr.child1))
        let indexT = semaExpr(module, ptr_to_node(expr.child2))
        semaExpectAssignable(ptr_to_node(expr.child2), "collection index", typeInt(), indexT)
        // v0.1 3.6. `s[i]` is `strCharAt(s, i)`, which answers NUL rather than
        // trapping out of range -- the bounds check the caller would write is the
        // one the accessor already does, and a Prismio String cannot contain a
        // NUL, so the answer is unambiguous. `s.get(i)` is the Option form.
        if (collectionT.kind == TypeKind.STRING) {
            if (semaStringSugarAvailable(expr, "strCharAt", "indexing a String") == false) {
                nodeSetType(expr, typeChar())
                return typeChar()
            }
            semaBecomeCall(expr, "strCharAt",
                           semaCallArgs2(ptr_to_node(expr.child1), ptr_to_node(expr.child2)))
            return semaExpr(module, expr)
        }

        if (collectionT.kind != TypeKind.ARRAY and collectionT.kind != TypeKind.LIST
            and collectionT.kind != TypeKind.SLICE and collectionT.kind != TypeKind.DATAVIEW) {
            semaErrorAt(expr, strConcat("indexing requires a String, array, List, Slice, or DataView, found ",
                                         typeDisplay(collectionT)))
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        let elemT = ptr_to_type(collectionT.child)
        if (collectionT.kind == TypeKind.LIST) {
            let base = ptr_to_node(expr.child1)
            if (base.kind == NodeKind.IDENTIFIER_EXPR) {
                ir_unmark_list_exclusive(base.s1)
            }
        }
        if (collectionT.kind == TypeKind.DATAVIEW) {
            let refT = typeDataElement(elemT)
            nodeSetType(expr, refT)
            return refT
        }
        nodeSetType(expr, elemT)
        return elemT
    }

    if (expr.kind == NodeKind.SLICE_EXPR) {
        let baseT = semaExpr(module, ptr_to_node(expr.child1))
        let startT = semaExpr(module, ptr_to_node(expr.child2))
        let endT = semaExpr(module, ptr_to_node(expr.child3))
        semaExpectAssignable(ptr_to_node(expr.child2), "slice start", typeInt(), startT)
        semaExpectAssignable(ptr_to_node(expr.child3), "slice end", typeInt(), endT)

        // v0.1 3.6. `s[a..b]` is `strSlice(s, a, b)` -- half-open, and a fresh
        // allocation rather than a view. A String slice cannot be a borrow of its
        // source the way `List` slicing is: a String carries its length beside
        // its pointer, so a subrange is a different pair, and there is nowhere to
        // put one that outlives the expression without owning it. That makes this
        // the one indexing form that allocates, so bind what it gives you.
        if (baseT.kind == TypeKind.STRING) {
            if (semaStringSugarAvailable(expr, "strSlice", "slicing a String") == false) {
                nodeSetType(expr, typeString())
                return typeString()
            }
            semaBecomeCall(expr, "strSlice",
                           semaCallArgs3(ptr_to_node(expr.child1), ptr_to_node(expr.child2),
                                         ptr_to_node(expr.child3)))
            return semaExpr(module, expr)
        }

        if (baseT.kind != TypeKind.LIST and baseT.kind != TypeKind.SLICE) {
            semaErrorAt(expr, strConcat("slicing requires a String, List, or Slice, found ",
                                         typeDisplay(baseT)))
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        if (baseT.kind == TypeKind.LIST) {
            let base = ptr_to_node(expr.child1)
            if (base.kind == NodeKind.IDENTIFIER_EXPR) {
                ir_unmark_list_exclusive(base.s1)
            }
        }
        let sliceT = typeSlice(ptr_to_type(baseT.child))
        nodeSetType(expr, sliceT)
        return sliceT
    }

    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        // A generic literal names its instantiation through the type annotation
        // the parser hung on child2. Resolving that annotation is what creates
        // the instantiation; rewriting `s1` to the instantiated name is what lets
        // everything below -- field lookup, the type, codegen, AIF -- stay
        // exactly as it is for an ordinary struct.
        //
        // child2 is cleared rather than kept. semaExpr runs over a node more than
        // once (overload resolution types every argument of every candidate), and
        // an annotation still hanging here would be resolved again each time.
        if (nodeExists(expr.child2)) {
            let instantiated = monoInstantiateStruct(module, ptr_to_node(expr.child2))
            expr.child2 = ptr_null()
            if (strEquals(instantiated, "")) {
                semaErrorAt(expr, strConcat("unknown generic struct ", diagQuote(expr.s1)))
                nodeSetType(expr, typeInvalid())
                return typeInvalid()
            }
            expr.s1 = instantiated
        }
        if (semaHasStruct(module, expr.s1) == false) {
            semaErrorAt(expr, strConcat("unknown struct ", diagQuote(expr.s1)))
            nodeSetType(expr, typeInvalid())
            return typeInvalid()
        }
        let mut fieldPtr = expr.child1
        while (nodeExists(fieldPtr)) {
            let field = ptr_to_node(fieldPtr)
            let mut expected = semaFindStructFieldType(module, field, expr.s1, field.s1)
            semaCheckValue(module, ptr_to_node(field.child1), expected, strConcat("struct field ", diagQuote(field.s1)))
            semaMoveOperand(ptr_to_node(field.child1))
            fieldPtr = field.next
        }
        semaFillOmittedFields(module, expr, expr.s1)

        let structT = typeStruct(expr.s1)
        nodeSetType(expr, structT)
        return structT
    }

    semaErrorAt(expr, "unsupported expression")
    return typeInvalid()
}

private fn semaStatement(module: ASTNode, stmt: ASTNode, expectedReturn: TypeInfo) {
    if (stmt.kind == NodeKind.VARIABLE_DECL) {
        let mut varT = typeInvalid()
        let hasAnnotation = nodeExists(stmt.child1)
        let hasInit = nodeExists(stmt.child2)

        if (hasAnnotation) {
            varT = semaAnnotationType(module, ptr_to_node(stmt.child1))
        }
        if (hasInit) {
            if (hasAnnotation) {
                semaCheckValue(module, ptr_to_node(stmt.child2), varT, strConcat("initializer for ", diagQuote(stmt.s1)))
            } else {
                varT = semaExpr(module, ptr_to_node(stmt.child2))
            }
            semaMoveOperand(ptr_to_node(stmt.child2))
        }
        // M4.3b. A saved element descriptor borrows its DataView. The compiler
        // does not yet carry a named lifetime in the type, so only save one when
        // its source is already a borrow (normally a function parameter). An
        // immediate `owned[i].field` is safe, but allowing `let p = owned[i]`
        // would let `aos(owned)` free the handle while `p` still names it.
        if (varT.kind == TypeKind.DATAELEMENT and hasInit) {
            let init = ptr_to_node(stmt.child2)
            let mut safeBorrow = false
            if (init.kind == NodeKind.INDEX_EXPR and nodeExists(init.child1)) {
                let base = ptr_to_node(init.child1)
                if (base.kind == NodeKind.IDENTIFIER_EXPR) {
                    safeBorrow = ir_is_borrowed(base.s1) == 1
                }
            } else if (init.kind == NodeKind.IDENTIFIER_EXPR) {
                safeBorrow = ir_is_borrowed(init.s1) == 1
            }
            if (safeBorrow == false) {
                semaErrorAt(init, "a DataView element may only be saved from a borrowed DataView")
                diag_note("project the field immediately, or pass the DataView to a borrowing function")
                varT = typeInvalid()
            }
        }
        // Only genuinely uninferrable declarations are reported. If there *was*
        // an annotation or an initializer, its own error has already been
        // reported and the invalid type is that error's shadow -- saying "cannot
        // infer" as well blames the declaration for a mistake in its right-hand
        // side.
        if (typeIsValid(varT) == false) {
            if (hasAnnotation == false and hasInit == false) {
                semaErrorAt(stmt, strConcat(strConcat("cannot infer a type for ", diagQuote(stmt.s1)),
                                               "; add a type annotation or an initializer"))
            }
        }

        semaCheckAnnotations(stmt, varT)

        // This `let` binds a fresh value, so drop any moved-from state left over
        // from an earlier binding of the same name (see ir_unmark_moved).
        ir_unmark_moved(stmt.s1)
        // ...and any borrow state, for the same reason. Whether *this* binding is
        // a borrow is decided by its own initialiser.
        ir_unmark_borrowed(stmt.s1)
        if (hasInit) {
            if (semaBindingIsBorrow(ptr_to_node(stmt.child2))) {
                ir_mark_borrowed(stmt.s1)
            }
        }
        ir_set_var_type(stmt.s1, typeSemKey(varT))
        if (varT.kind == TypeKind.LIST and hasInit) {
            let init = ptr_to_node(stmt.child2)
            if (init.kind == NodeKind.CALL_EXPR and nodeExists(init.child1)) {
                let callee = ptr_to_node(init.child1)
                if (strEquals(callee.s1, "list_new")
                    or strEquals(callee.s1, "list_new_with_capacity")) {
                    ir_mark_list_exclusive(stmt.s1)
                }
            }
        }
        // i1 carries `mut` from the parser. Nothing read it before, so
        // "explicit mutability" was advertised and entirely unenforced.
        if (stmt.i1 == 1) {
            ir_mark_mutable(stmt.s1)
        }
        nodeSetType(stmt, varT)
    }

    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        let target = ptr_to_node(stmt.child1)

        // Only a direct rebinding is checked. Assigning through a struct field
        // is mutation of a heap object reached by pointer, which is a separate
        // question from whether the binding itself may be reseated.
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            if (ir_var_is_mutable(target.s1) == 0) {
                semaErrorAt(target, strConcat(strConcat("cannot assign to ", diagQuote(target.s1)),
                                                 ", which is not declared `mut`"))
                diag_note("change its declaration to `let mut`")
            }
        }

        // M2.1c. Cleared *before* the target is read, not only after the move.
        // `s = f("x")` after `consume(s)` reads `s` as the assignment's target,
        // and that read is what reported "use of moved value" -- an assignment is
        // the one place a moved-from name is legal, because the store is what
        // replaces what was moved out.
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            ir_unmark_moved(target.s1)
            ir_unmark_list_exclusive(target.s1)
        }
        let targetT = semaExpr(module, target)
        // Named while the right-hand side is checked, so a move of the target
        // *into* its own replacement is not read as a move that repeats.
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            ir_set_reinit_target(target.s1)
        }
        let valueT = semaExpr(module, ptr_to_node(stmt.child2))
        semaExpectAssignable(ptr_to_node(stmt.child2), "assignment", targetT, valueT)
        semaMoveOperand(ptr_to_node(stmt.child2))
        ir_set_reinit_target("")

        if (target.kind == NodeKind.IDENTIFIER_EXPR and targetT.kind == TypeKind.LIST) {
            let replacement = ptr_to_node(stmt.child2)
            if (replacement.kind == NodeKind.CALL_EXPR and nodeExists(replacement.child1)) {
                let callee = ptr_to_node(replacement.child1)
                if (strEquals(callee.s1, "list_new")
                    or strEquals(callee.s1, "list_new_with_capacity")) {
                    ir_mark_list_exclusive(target.s1)
                }
            }
        }

        // And again after the right-hand side's own move, which may have marked
        // the target: `acc = f(acc)` moves `acc` into `f` and the store puts a
        // fresh value back, so the name is live for every later use.
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            ir_unmark_moved(target.s1)
        }

        // Reborrowing through an assignment. Marked but never unmarked: an
        // assignment in one branch says nothing about the other, and a binding
        // that might hold a borrow must not be consumable. Erring towards
        // "borrowed" refuses a `drop`; erring the other way permits one.
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            if (semaBindingIsBorrow(ptr_to_node(stmt.child2))) {
                ir_mark_borrowed(target.s1)
            }
        }
    }

    if (stmt.kind == NodeKind.RETURN_STATEMENT) {
        if (nodeExists(stmt.child1)) {
            // Deliberately no semaMoveOperand() here. Ownership does leave the
            // function, but move state is tracked per name for the whole function
            // body rather than per control-flow path, so marking the returned name
            // moved poisons it for every *other* path: a function with `return x`
            // in one branch and a use of `x` in another reports a bogus "use of
            // moved value" (parseTypeAnnotation in parser.psm does exactly this).
            // It also made `return expected` inside semaCheckValue report "cannot
            // move out of borrowed value" for an ordinary borrowed parameter.
            // Nothing can use a value after it has been returned on the same path,
            // so skipping the mark loses no real diagnostic.
            semaCheckValue(module, ptr_to_node(stmt.child1), expectedReturn, "return")

            // An array is a stack allocation (ir_array_alloca), so returning one
            // the function itself created hands back a pointer into a frame that
            // no longer exists. This compiled clean and appeared to work --
            // reading the dead frame usually still finds the values -- which is
            // the worst possible failure mode for it.
            //
            // Returning an array that came *in* as a borrowed parameter is fine:
            // the caller owns that storage and it outlives the call.
            if (expectedReturn.kind == TypeKind.ARRAY) {
                let returned = ptr_to_node(stmt.child1)
                let mut isBorrowedParam = false
                if (returned.kind == NodeKind.IDENTIFIER_EXPR) {
                    isBorrowedParam = ir_is_borrowed(returned.s1) == 1
                }
                if (isBorrowedParam == false) {
                    semaErrorAt(returned, "cannot return an array created in this function; it lives on the stack frame that is about to be discarded")
                    diag_note("return an array that was passed in, or write into one the caller provides")
                }
            }
        } else {
            semaExpectAssignable(stmt, "return", expectedReturn, typeVoid())
        }
    }

    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) {
        if (nodeExists(stmt.child1)) {
            semaExpr(module, ptr_to_node(stmt.child1))
        }
    }

    if (stmt.kind == NodeKind.IF_STATEMENT) {
        let condT = semaExpr(module, ptr_to_node(stmt.child1))
        semaExpectAssignable(ptr_to_node(stmt.child1), "if condition", typeBool(), condT)
        semaBlock(module, ptr_to_node(stmt.child2), expectedReturn)
        if (nodeExists(stmt.child3)) {
            let elseNode = ptr_to_node(stmt.child3)
            if (elseNode.kind == NodeKind.IF_STATEMENT) {
                semaStatement(module, elseNode, expectedReturn)
            } else {
                semaBlock(module, elseNode, expectedReturn)
            }
        }
    }

    if (stmt.kind == NodeKind.WHILE_STATEMENT) {
        let condT2 = semaExpr(module, ptr_to_node(stmt.child1))
        semaExpectAssignable(ptr_to_node(stmt.child1), "while condition", typeBool(), condT2)
        ir_loop_barrier_push()
        semaBlock(module, ptr_to_node(stmt.child2), expectedReturn)
        ir_loop_barrier_pop()
    }

    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        ir_loop_barrier_push()
        semaBlock(module, ptr_to_node(stmt.child1), expectedReturn)
        ir_loop_barrier_pop()
    }

    // A region is an ordinary block as far as checking goes. It says nothing
    // about types or ownership -- SPEC 5.2 makes it a placement pin, and the
    // escape fact it would assert is one the analysis already has.
    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        semaBlock(module, ptr_to_node(stmt.child1), expectedReturn)
    }

    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        // v0.1 3.6. `for c in s` becomes `for $c in 0..strLength(s) { let c = s[$c] ... }`
        // right here, so everything below -- and every pass after it -- only ever
        // sees the range loop it already handled.
        if (nodeIsNull(stmt.child2)) {
            if (semaForEachDesugar(module, stmt) == false) { return }
        }
        let startT = semaExpr(module, ptr_to_node(stmt.child1))
        semaExpectAssignable(ptr_to_node(stmt.child1), "for range start", typeInt(), startT)
        let endT = semaExpr(module, ptr_to_node(stmt.child2))
        semaExpectAssignable(ptr_to_node(stmt.child2), "for range end", typeInt(), endT)
        // The loop variable belongs to the loop, not to the enclosing block.
        ir_scope_push()
        ir_set_var_type(stmt.s1, typeSemKey(typeInt()))
        ir_loop_barrier_push()
        semaBlock(module, ptr_to_node(stmt.child3), expectedReturn)
        ir_loop_barrier_pop()
        ir_scope_pop()
    }

    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        let scrutT = semaExpr(module, ptr_to_node(stmt.child1))

        // An enum with payloads is a tagged struct by the time it gets here, and
        // its arms bind names rather than comparing values, so it takes a
        // different path entirely -- see semaCheckPayloadArm.
        if (enumIsPayloadType(module, scrutT)) {
            semaMatchPayloadArms(module, stmt, scrutT, expectedReturn)
            return
        }

        if (scrutT.kind != TypeKind.INT and scrutT.kind != TypeKind.ENUM) {
            semaErrorAt(ptr_to_node(stmt.child1), strConcat("match scrutinee must be an integer or enum value, found ", typeDisplay(scrutT)))
        }
        let mut patExpected = typeCopy(scrutT)
        if (scrutT.kind == TypeKind.ENUM) { patExpected = typeInt() }
        let mut armPtr = stmt.child2
        while (nodeExists(armPtr)) {
            let arm = ptr_to_node(armPtr)
            if (strEquals(arm.s1, "_") == false) {
                semaCheckValue(module, ptr_to_node(arm.child1), patExpected, "match pattern")
            }
            semaBlock(module, ptr_to_node(arm.child2), expectedReturn)
            armPtr = arm.next
        }
    }
}

// A block is a scope: anything declared inside it stops being visible at the
// closing brace, and a `let` that repeats an outer name shadows it for the rest
// of the block rather than overwriting it.
internal fn semaBlock(module: ASTNode, block: ASTNode, expectedReturn: TypeInfo) {
    ir_scope_push()

    let mut stmtPtr = block.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        semaStatement(module, stmt, expectedReturn)

        // Anything after a statement control cannot continue past is dead. It
        // used to be emitted anyway, producing instructions after a terminator
        // -- invalid IR that surfaced as a confusing backend error rather than
        // as the source-level mistake it is.
        if (semaStmtDiverges(stmt) and nodeExists(stmt.next)) {
            semaErrorAt(ptr_to_node(stmt.next), "unreachable code: control cannot continue past the previous statement")
        }

        stmtPtr = stmt.next
    }

    ir_scope_pop()
}

internal fn semaPredeclareFunction(module: ASTNode, fnNode: ASTNode) {
    // Builtins have compiler-owned identity and signatures. Allowing source to
    // declare one would bring back the exact ambiguity the reserved spelling is
    // meant to remove: a name that looks foreign or user-defined but whose call
    // is silently replaced by codegen.
    if (strStartsWith(fnNode.s1, "__builtin_")) {
        semaErrorAt(fnNode, strConcat(diagQuote(fnNode.s1),
                    " is reserved for a compiler builtin and cannot be declared"))
        return
    }

    let mut retT = typeVoid()
    if (fnNode.kind == NodeKind.FUNCTION) {
        retT = semaDeclaredReturnType(module, fnNode.child3)
        if (strEquals(fnNode.s1, "main")) { retT = typeInt() }
    } else {
        retT = semaDeclaredReturnType(module, fnNode.child2)
    }
    // Already mangled and cached by semaCacheFunctionSymbols().
    let symbol = fnNode.s2

    // Reported against the *later* definition only, with a note pointing at the
    // one it collides with. Counting instead meant a single clash produced two
    // identical errors, neither of which said where the other definition was.
    //
    // The earliest declaration with this symbol is `fnNode` itself when nothing
    // collides, so the position test below is the whole condition -- there is no
    // count to consult first.
    let first = semaFirstFunctionWithSymbol(module, fnNode)
    // Identity by source position, not by pointer: node_to_ptr() puns a
    // pointer into a String, and str_equals is strcmp -- it would compare
    // the bytes of the two nodes rather than their addresses. Two
    // declarations cannot begin at the same file, line and column, so this
    // is exact.
    if (semaSamePosition(first, fnNode) == false) {
        semaErrorAt(fnNode, strConcat(strConcat("duplicate definition of ", diagQuote(fnNode.s1)),
                                          " with the same parameter types"))
        diag_note_at(first.file, first.line, first.col, first.len, "the first definition is here")
    }
    ir_set_fn_return_type(symbol, typeSemKey(retT))
}

private fn semaPredeclareGlobal(module: ASTNode, varNode: ASTNode) {
    let mut varT = typeInvalid()
    if (nodeExists(varNode.child1)) {
        varT = semaAnnotationType(module, ptr_to_node(varNode.child1))
    }
    if (nodeExists(varNode.child2)) {
        if (typeIsValid(varT)) {
            semaCheckValue(module, ptr_to_node(varNode.child2), varT, strConcat("initializer for global ", diagQuote(varNode.s1)))
        } else {
            varT = semaExpr(module, ptr_to_node(varNode.child2))
        }

        // A global is emitted as an LLVM global with a static initializer, and
        // there is no pass that runs code before main. This was caught in
        // codegen, which meant it was reported without a span, after every other
        // check had passed, and only for whichever global came first.
        //
        // `-5` is fine: the parser folds a leading minus into the literal itself
        // (see parseUnary), so negative constants are still LITERAL_EXPR.
        let init = ptr_to_node(varNode.child2)
        if (init.kind != NodeKind.LITERAL_EXPR) {
            semaErrorAt(init, strConcat(strConcat("global ", diagQuote(varNode.s1)),
                                           " needs a constant initializer"))
            diag_note("nothing runs before main, so a global cannot be initialized by an expression; move the computation into a function")
        }
    }
    if (typeIsValid(varT) == false) {
        if (nodeIsNull(varNode.child1) and nodeIsNull(varNode.child2)) {
            semaErrorAt(varNode, strConcat(strConcat("cannot infer a type for global ", diagQuote(varNode.s1)),
                                               "; add a type annotation or an initializer"))
        }
    }
    ir_register_global_name(varNode.s1)
    ir_set_global_var_type(varNode.s1, typeSemKey(varT))
    if (varNode.i1 == 1) {
        ir_mark_mutable(varNode.s1)
    }
    nodeSetType(varNode, varT)
}

private fn semaFunction(module: ASTNode, fnNode: ASTNode) {
    ir_clear_local_var_types()
    ir_clear_moved()
    ir_clear_borrowed()

    // Parameters live in a scope of their own, outside the body block, so the
    // body may shadow a parameter name without clobbering it.
    ir_scope_push()

    let mut expectedReturn = semaDeclaredReturnType(module, fnNode.child3)
    if (strEquals(fnNode.s1, "main")) { expectedReturn = typeInt() }

    let mut paramPtr = fnNode.child1
    while (nodeExists(paramPtr)) {
        let mut param = ptr_to_node(paramPtr)
        let paramT = semaAnnotationType(module, ptr_to_node(param.child1))
        if (strEquals(param.s2, "inout") and typeIsMoveOnly(paramT) == false) {
            semaErrorAt(param, strConcat(strConcat("inout parameter ", diagQuote(param.s1)), " must be a struct (reference) type"))
        }
        // let/inout params are non-owning borrows; sink params own their value.
        if (strEquals(param.s2, "sink") == false) {
            ir_mark_borrowed(param.s1)
        }
        ir_set_var_type(param.s1, typeSemKey(paramT))
        nodeSetType(param, paramT)
        paramPtr = param.next
    }

    if (nodeExists(fnNode.child2)) {
        let mut body = ptr_to_node(fnNode.child2)
        semaBlock(module, body, expectedReturn)

        // Every path out of a value-returning function must return. Falling off
        // the end used to emit `ret <type> 0`, which silently returned zero for
        // an Int and produced invalid IR (`ret ptr 0`) for anything pointer-
        // shaped.
        if (expectedReturn.kind != TypeKind.VOID) {
            if (semaBlockDiverges(body) == false) {
                semaErrorAt(fnNode, strConcat(strConcat("function ", diagQuote(fnNode.s1)),
                              strConcat(strConcat(" must return ", typeDisplay(expectedReturn)),
                                         " on every path, but control can reach its closing brace")))
            }
        }
    }

    ir_scope_pop()
}

// ---------------------------------------------------------
// v0.1 3.3 -- conformance
// ---------------------------------------------------------

// `impl Ord for Int` says the type implements the trait; this is where that claim
// is checked against the trait's signatures.
//
// **Syntactic, not by resolved type**, and that is a decision rather than a
// shortcut. The `impl` block's methods have already had `Self` rewritten to the
// block's type by the parser, so a signature and its implementation agree exactly
// when their annotations agree with `Self` standing for the impl's type -- no
// resolution needed. Resolving instead would mean calling semaAnnotationType on a
// synthesised node, which *reports* an unknown type, so a misspelt `impl Poitn`
// would be blamed here as well as where it is written.
//
// The cost is that two spellings of one type would not match. Prismio 0.1 has no
// type aliases, so today there are none.
private fn semaCheckImplBlocks(module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.IMPL_DECL and strEquals(stmt.s2, "") == false) {
            semaCheckConformance(module, stmt)
        }
        p = stmt.next
    }
}

private fn semaFindTrait(module: ASTNode, name: String) -> ASTNode {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.TRAIT_DECL and strEquals(stmt.s1, name)) { return stmt }
        p = stmt.next
    }
    return ptr_to_node(ptr_null())
}

private fn semaCheckConformance(module: ASTNode, implNode: ASTNode) {
    let traitDecl = semaFindTrait(module, implNode.s2)
    if (nodeIsNull(node_to_ptr(traitDecl))) {
        semaErrorAt(implNode, strConcat("unknown trait ", diagQuote(implNode.s2)))
        diag_note("a trait has to be declared with `trait Name { fn ... }` before a type can implement it")
        return
    }

    let mut signaturePtr = traitDecl.child1
    while (nodeExists(signaturePtr)) {
        let signature = ptr_to_node(signaturePtr)
        if (semaHasConformingMethod(module, implNode.s1, signature) == false) {
            semaErrorAt(implNode, strConcat(strConcat(diagQuote(implNode.s1),
                        strConcat(" does not implement ", diagQuote(implNode.s2))),
                        strConcat(": no ", diagQuote(signature.s1))))
            diag_note(strConcat(strConcat("the trait declares it as ", semaSignatureText(signature)),
                                ", with `Self` standing for the implementing type"))
        }
        signaturePtr = signature.next
    }
}

// Any declaration of this name whose whole signature agrees. The declaration
// index answers "which declarations carry this name" without a walk, which is
// what makes this cheap enough to run per trait method.
private fn semaHasConformingMethod(module: ASTNode, typeName: String, signature: ASTNode) -> Bool {
    let count = ir_decl_count(signature.s1)
    let mut i = 0
    while (i < count) {
        let candidate = ptr_to_node(ir_decl_at(signature.s1, i))
        if (candidate.kind == NodeKind.FUNCTION
            and semaSignaturesAgree(typeName, signature, candidate)) {
            return true
        }
        i = i + 1
    }
    return false
}

private fn semaSignaturesAgree(typeName: String, signature: ASTNode, candidate: ASTNode) -> Bool {
    if (semaAnnotationsAgree(typeName, signature.child3, candidate.child3) == false) { return false }

    let mut want = signature.child1
    let mut have = candidate.child1
    loop {
        if (nodeIsNull(want) and nodeIsNull(have)) { return true }
        if (nodeIsNull(want) or nodeIsNull(have)) { return false }
        let wantParam = ptr_to_node(want)
        let haveParam = ptr_to_node(have)
        if (semaAnnotationsAgree(typeName, wantParam.child1, haveParam.child1) == false) {
            return false
        }
        want = wantParam.next
        have = haveParam.next
    }
}

// `Self` in the trait's half stands for the implementing type. An absent
// annotation on both sides is a void return and agrees with itself.
private fn semaAnnotationsAgree(typeName: String, wantPtr: Ptr, havePtr: Ptr) -> Bool {
    if (nodeIsNull(wantPtr) and nodeIsNull(havePtr)) { return true }
    if (nodeIsNull(wantPtr) or nodeIsNull(havePtr)) { return false }

    let want = ptr_to_node(wantPtr)
    let have = ptr_to_node(havePtr)
    if (want.i1 != have.i1) { return false }
    if (want.i2 != have.i2) { return false }
    if (want.i3 != have.i3) { return false }

    if (strEquals(want.s1, "Self")) {
        if (strEquals(have.s1, typeName) == false) { return false }
    } else if (strEquals(want.s1, have.s1) == false) {
        return false
    }

    let mut wantArg = want.child1
    let mut haveArg = have.child1
    loop {
        if (nodeIsNull(wantArg) and nodeIsNull(haveArg)) { return true }
        if (semaAnnotationsAgree(typeName, wantArg, haveArg) == false) { return false }
        wantArg = ptr_to_node(wantArg).next
        haveArg = ptr_to_node(haveArg).next
    }
}

// How the trait wrote it, for the note under a conformance error. Reconstructed
// rather than quoted from source, because the signature and the `impl` that fails
// to satisfy it are routinely in different files.
private fn semaSignatureText(signature: ASTNode) -> String {
    let mut text = strConcat(strConcat("fn ", signature.s1), "(")
    let mut paramPtr = signature.child1
    let mut first = true
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        if (first == false) { text = strConcat(text, ", ") }
        first = false
        text = strConcat(text, strConcat(strConcat(param.s1, ": "), semaAnnotationText(param.child1)))
        paramPtr = param.next
    }
    text = strConcat(text, ")")
    if (nodeExists(signature.child3)) {
        text = strConcat(text, strConcat(" -> ", semaAnnotationText(signature.child3)))
    }
    return text
}

private fn semaAnnotationText(annotationPtr: Ptr) -> String {
    if (nodeIsNull(annotationPtr)) { return "" }
    let annotation = ptr_to_node(annotationPtr)
    if (annotation.i1 == 1) {
        return strConcat(strConcat("[", semaAnnotationText(annotation.child1)), "]")
    }
    if (annotation.i2 == 1) {
        let mut text = strConcat(annotation.s1, "<")
        let mut argPtr = annotation.child1
        let mut first = true
        while (nodeExists(argPtr)) {
            if (first == false) { text = strConcat(text, ", ") }
            first = false
            text = strConcat(text, semaAnnotationText(argPtr))
            argPtr = ptr_to_node(argPtr).next
        }
        return strConcat(text, ">")
    }
    if (annotation.i3 == 1) { return strConcat(annotation.s1, "?") }
    return strClone(annotation.s1)
}


// ---------------------------------------------------------
// v0.1 3.4 -- closures
// ---------------------------------------------------------

// How many closures have been lowered. Part of every closure type's name, and
// the only mutable state this feature needs.
let mut closureSerial = 0

// The prefix every closure type's name carries. `$` is not a legal identifier
// character, so no user declaration can collide with one -- which is what lets
// the call rewrite key on the *type* rather than on the absence of a function of
// the same name.
private fn semaClosurePrefix() -> String { return strConcat("Closure", monoSeparator()) }

// **A closure is a struct and a function, and the dispatch is overloading.**
//
// `|x: Int| x > threshold` becomes
//
//     struct Closure$12$0 { threshold: Int }
//     fn call(self: Closure$12$0, x: Int) -> Bool { return x > self.threshold }
//     Closure$12$0 { threshold: threshold }        // at the use site
//
// and `f(x)` inside a generic that received it is rewritten to `call(f, x)`,
// which ordinary overload resolution sends to the right `call`. So there is no
// function pointer, no vtable and no indirect call anywhere: the same trick 3.1,
// 3.2 and 3.3 all used, one more time.
//
// **The prediction in v0.1 3.4 was that the ownership work would dominate the
// syntax work, and it did not -- because a capture is spelled as a struct literal
// field.** `Closure$N { needle: needle }` moves an owned capture into the closure
// exactly the way any other struct literal moves a value into a field, and AIF
// already models that. There is no new escape route, no new lattice case, and no
// change to aif/ at all. The lattice did not have to learn what a capture is; the
// lowering arranged for there to be nothing new to learn.
//
// What that costs is the *default*: a capture is **by value**, so an owned
// capture is moved and the original binding is dead afterwards. Rust spells that
// `move |...|` and defaults to borrowing; Prismio has no way to hold a borrow in
// a struct field, so by-value is the only sound default it can have today.
private fn semaClosureName(expr: ASTNode) -> String {
    // Deterministic, and unique across the copies monomorphisation makes of a
    // generic body -- which is why the serial is here and the span alone is not
    // enough. Two instantiations of one template hold two CLOSURE_EXPRs with
    // identical spans and possibly different capture types.
    closureSerial = closureSerial + 1
    return strConcat(semaClosurePrefix(),
                     strConcat(strFromInt(expr.line),
                               strConcat(monoSeparator(), strFromInt(closureSerial))))
}

private fn semaClosureNamesParam(paramsPtr: Ptr, name: String) -> Bool {
    let mut p = paramsPtr
    while (nodeExists(p)) {
        let param = ptr_to_node(p)
        if (strEquals(param.s1, name)) { return true }
        p = param.next
    }
    return false
}

private fn semaClosureHasCapture(captures: NodeList, name: String) -> Bool {
    let mut p = captures.head
    while (nodeExists(p)) {
        let field = ptr_to_node(p)
        if (strEquals(field.s1, name)) { return true }
        p = field.next
    }
    return false
}

// A free identifier that names a *local* of the enclosing function. A function
// name has no variable type, a global is reachable without capturing it, and a
// closure parameter is bound by the closure itself -- so all three fall out
// without a special case.
private fn semaClosureIsCapture(name: String, paramsPtr: Ptr, captures: NodeList) -> Bool {
    if (semaClosureNamesParam(paramsPtr, name)) { return false }
    if (ir_has_var_type(name) == 0) { return false }
    if (ir_var_is_global(name) == 1) { return false }
    return semaClosureHasCapture(captures, name) == false
}

private fn semaCollectCaptures(node: ASTNode, paramsPtr: Ptr, captures: NodeList) {
    if (node.kind == NodeKind.IDENTIFIER_EXPR) {
        if (semaClosureIsCapture(node.s1, paramsPtr, captures)) {
            let field = createNode(NodeKind.STRUCT_FIELD)
            field.s1 = strClone(node.s1)
            nodeSpanFrom(field, node)
            nodeListPush(captures, field)
        }
    }
    semaCollectCapturesChain(node.child1, paramsPtr, captures)
    semaCollectCapturesChain(node.child2, paramsPtr, captures)
    semaCollectCapturesChain(node.child3, paramsPtr, captures)
}

private fn semaCollectCapturesChain(ptr: Ptr, paramsPtr: Ptr, captures: NodeList) {
    let mut p = ptr
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        semaCollectCaptures(node, paramsPtr, captures)
        p = node.next
    }
}

// Every captured identifier in the body becomes `self.<name>`.
//
// **In place, by rewriting the kind.** A MEMBER_ACCESS_EXPR carries the member
// name in `s1` and the object in `child1`, and an IDENTIFIER_EXPR carries its
// name in `s1` -- so the conversion is one assignment to `kind` and one to
// `child1`, and the node keeps its `next` link and its span. Building a new node
// would mean telling whichever slot points at this one to re-point, and those
// slots belong to eight different kinds.
private fn semaRewriteCaptures(node: ASTNode, captures: NodeList) {
    if (node.kind == NodeKind.IDENTIFIER_EXPR and semaClosureHasCapture(captures, node.s1)) {
        let receiver = createNode(NodeKind.IDENTIFIER_EXPR)
        receiver.s1 = "self"
        nodeSpanFrom(receiver, node)
        node.kind = NodeKind.MEMBER_ACCESS_EXPR
        node.child1 = node_to_ptr(receiver)
        // The probe below typed this as the enclosing local. It is a field read
        // now and has to be typed again as one.
        node.typeInfo = ptr_null()
        return
    }
    semaRewriteCapturesChain(node.child1, captures)
    semaRewriteCapturesChain(node.child2, captures)
    semaRewriteCapturesChain(node.child3, captures)
}

private fn semaRewriteCapturesChain(ptr: Ptr, captures: NodeList) {
    let mut p = ptr
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        semaRewriteCaptures(node, captures)
        p = node.next
    }
}

// The body's type, which is the synthesised `call`'s return type.
//
// Typed here rather than left to the synthesised function, because the function
// needs its return annotation *before* analyzeModule reaches it. The parameters
// are bound in a scope of their own so the body resolves exactly as it will
// inside `call`; the captures resolve as the enclosing locals they still are at
// this point, and a capture and its field have the same type by construction.
private fn semaClosureBodyType(module: ASTNode, expr: ASTNode) -> TypeInfo {
    ir_scope_push()
    let mut paramPtr = expr.child1
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        let paramT = semaAnnotationType(module, ptr_to_node(param.child1))
        ir_set_var_type(param.s1, typeSemKey(paramT))
        ir_mark_borrowed(param.s1)
        nodeSetType(param, paramT)
        paramPtr = param.next
    }
    let bodyT = semaExpr(module, ptr_to_node(expr.child2))
    ir_scope_pop()
    return bodyT
}

private fn semaLowerClosure(module: ASTNode, expr: ASTNode) -> TypeInfo {
    let captures = nodeList()
    semaCollectCaptures(ptr_to_node(expr.child2), expr.child1, captures)

    let bodyT = semaClosureBodyType(module, expr)
    if (typeIsValid(bodyT) == false) {
        nodeSetType(expr, typeInvalid())
        return typeInvalid()
    }

    let name = semaClosureName(expr)

    // The struct, whose fields are the captures at the types they have here.
    let structDecl = createNode(NodeKind.STRUCT_DECL)
    structDecl.s1 = strClone(name)
    nodeSpanFrom(structDecl, expr)
    let fields = nodeList()
    let mut capturePtr = captures.head
    while (nodeExists(capturePtr)) {
        let capture = ptr_to_node(capturePtr)
        let field = createNode(NodeKind.STRUCT_FIELD)
        field.s1 = strClone(capture.s1)
        nodeSpanFrom(field, capture)
        field.child1 = node_to_ptr(monoAnnotationFromType(typeFromSemKey(ir_get_var_type(capture.s1))))
        nodeListPush(fields, field)
        capturePtr = capture.next
    }
    structDecl.child1 = fields.head
    ir_declare_named_type(structDecl.s1, 1)
    monoAppendDeclaration(module, structDecl)
    indexTopLevel(structDecl)

    // The function. `self` first, so that `call(f, x)` and `f.call(x)` are the
    // same call -- a closure is a method like any other.
    semaRewriteCaptures(ptr_to_node(expr.child2), captures)

    let callFn = createNode(NodeKind.FUNCTION)
    callFn.s1 = "call"
    nodeSpanFrom(callFn, expr)

    let params = nodeList()
    let selfParam = createNode(NodeKind.FUNCTION_PARAMETER)
    selfParam.s1 = "self"
    nodeSpanFrom(selfParam, expr)
    let selfAnnotation = createNode(NodeKind.TYPE_ANNOTATION)
    selfAnnotation.s1 = strClone(name)
    nodeSpanFrom(selfAnnotation, expr)
    selfParam.child1 = node_to_ptr(selfAnnotation)
    nodeListPush(params, selfParam)

    let mut closureParam = expr.child1
    while (nodeExists(closureParam)) {
        let param = ptr_to_node(closureParam)
        let following = param.next
        param.next = ptr_null()
        nodeListPush(params, param)
        closureParam = following
    }
    callFn.child1 = params.head

    let returnStatement = createNode(NodeKind.RETURN_STATEMENT)
    nodeSpanFrom(returnStatement, expr)
    returnStatement.child1 = expr.child2
    let body = createNode(NodeKind.BLOCK)
    nodeSpanFrom(body, expr)
    body.child1 = node_to_ptr(returnStatement)
    callFn.child2 = node_to_ptr(body)
    callFn.child3 = node_to_ptr(monoAnnotationFromType(bodyT))

    monoAppendDeclaration(module, callFn)
    indexTopLevel(callFn)
    callFn.s2 = semaFunctionSymbol(module, callFn)
    semaPredeclareFunction(module, callFn)

    // The use site becomes the struct literal that builds the captures. In place,
    // so a second visit finds a STRUCT_LITERAL_EXPR and lowers nothing twice.
    let initialisers = nodeList()
    let mut initPtr = captures.head
    while (nodeExists(initPtr)) {
        let capture = ptr_to_node(initPtr)
        let initialiser = createNode(NodeKind.STRUCT_FIELD)
        initialiser.s1 = strClone(capture.s1)
        nodeSpanFrom(initialiser, capture)
        let value = createNode(NodeKind.IDENTIFIER_EXPR)
        value.s1 = strClone(capture.s1)
        nodeSpanFrom(value, capture)
        initialiser.child1 = node_to_ptr(value)
        nodeListPush(initialisers, initialiser)
        initPtr = capture.next
    }

    expr.kind = NodeKind.STRUCT_LITERAL_EXPR
    expr.s1 = strClone(name)
    expr.i2 = 0
    expr.child1 = initialisers.head
    expr.child2 = ptr_null()
    expr.child3 = ptr_null()
    expr.typeInfo = ptr_null()
    return semaExpr(module, expr)
}

fn analyzeModule(module: ASTNode) {
    ir_clear_var_types()
    ir_reset_globals()
    ir_reset_fn_return_types()

    // All three must run before anything is checked. The first lets a type
    // annotation be resolved without walking the module; the second mangles each
    // function's symbol once instead of once per comparison; the third answers
    // "which declarations carry this name?" without a walk, which is what
    // overload resolution asks once per call site. Together they take checking
    // from cubic to linear in the number of declarations (REQUIREMENTS 16).
    semaRegisterNamedTypes(module)
    semaCacheFunctionSymbols(module)
    indexModuleDeclarations(module)

    // After the index, because conformance is asked by name: an `impl` block's
    // methods are ordinary top-level functions by now, and finding them is the
    // same lookup overload resolution does.
    semaCheckImplBlocks(module)

    // A DataView owns several column allocations, while struct fields are
    // released through the struct layout table. Until that table can name this
    // custom release, storing a view in a field would reclaim only its header.
    let mut dataDeclPtr = module.child1
    while (nodeExists(dataDeclPtr)) {
        let dataDecl = ptr_to_node(dataDeclPtr)
        if (dataDecl.kind == NodeKind.STRUCT_DECL) {
            let mut dataFieldPtr = dataDecl.child1
            while (nodeExists(dataFieldPtr)) {
                let dataField = ptr_to_node(dataFieldPtr)
                if (dataField.kind == NodeKind.STRUCT_FIELD and nodeExists(dataField.child1)) {
                    let dataFieldT = semaAnnotationType(module, ptr_to_node(dataField.child1))
                    if (dataFieldT.kind == TypeKind.DATAVIEW) {
                        semaErrorAt(dataField, "a DataView cannot be stored in a struct field yet")
                    }
                }
                dataFieldPtr = dataField.next
            }
        }
        dataDeclPtr = dataDecl.next
    }

    let mut fnPtr = module.child1
    while (nodeExists(fnPtr)) {
        let stmt = ptr_to_node(fnPtr)
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            semaPredeclareFunction(module, stmt)
        }
        if (stmt.kind == NodeKind.EXTERN_FUNCTION) {
            semaCheckExternContracts(stmt)
        }
        fnPtr = stmt.next
    }

    let mut globalPtr = module.child1
    while (nodeExists(globalPtr)) {
        let stmt2 = ptr_to_node(globalPtr)
        if (stmt2.kind == NodeKind.VARIABLE_DECL) {
            semaPredeclareGlobal(module, stmt2)
        }
        globalPtr = stmt2.next
    }

    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt3 = ptr_to_node(stmtPtr)
        if (stmt3.kind == NodeKind.FUNCTION) {
            semaFunction(module, stmt3)
        }
        if (stmt3.kind == NodeKind.WORKLOAD_DECL) {
            semaWorkload(module, stmt3)
        }
        stmtPtr = stmt3.next
    }
}

// LAYOUT 3. A workload is checked exactly as a `fn() { … }` body is, and it has
// to be: it is compiled and run at build time, so a type error or a use of a
// moved value in it is a build-time crash rather than a bad profile.
//
// Checking it is also the only thing that keeps W1 honest in the other
// direction. The blocks are never reached by generateModule -- every top-level
// walk keys on `== NodeKind.FUNCTION` and a workload is not one, so it costs
// nothing to skip and cannot leak into the shipped binary by omission. What that
// leaves is a body nobody would ever check, which is how a declaration rots.
//
// `setup` and `measure` are two blocks of one activation, not two functions: a
// binding made in `setup` is what `measure` consumes, which is the whole point
// of the split (LAYOUT 3.1 -- input construction must not pollute the counts).
// So they share one scope, and the move state carries from one into the other.
private fn semaWorkload(module: ASTNode, node: ASTNode) {
    ir_clear_local_var_types()
    ir_clear_moved()
    ir_clear_borrowed()
    ir_scope_push()

    // Void: a workload returns nothing and `return` inside one has nothing to
    // return to. semaStatement reports a `return <value>` against this, which is
    // the right diagnostic -- the alternative is codegen failing on a bare `ret`.
    let expectedReturn = typeVoid()

    // Deliberately *not* semaBlock for either: that pushes a scope of its own and
    // pops it, which would put `setup`'s bindings out of scope before `measure`
    // ran. LAYOUT 3.1's own example consumes a binding across the boundary
    // (`setup` builds the input, `measure` parses it), so the two blocks are one
    // scope with a barrier in the middle rather than two scopes.
    if (nodeExists(node.child1)) {
        semaWorkloadStatements(module, ptr_to_node(node.child1), expectedReturn)
    }
    if (nodeExists(node.child2)) {
        // `measure` is emitted inside a `repeat` loop, so a `break` or `continue`
        // written here would bind to a loop the source does not show. The barrier
        // makes it the error it reads as.
        ir_loop_barrier_push()
        semaWorkloadStatements(module, ptr_to_node(node.child2), expectedReturn)
        ir_loop_barrier_pop()
    }

    ir_scope_pop()
}

private fn semaWorkloadStatements(module: ASTNode, block: ASTNode, expectedReturn: TypeInfo) {
    let mut stmtPtr = block.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        semaStatement(module, stmt, expectedReturn)
        if (semaStmtDiverges(stmt) and nodeExists(stmt.next)) {
            semaErrorAt(ptr_to_node(stmt.next),
                        "unreachable code: control cannot continue past the previous statement")
        }
        stmtPtr = stmt.next
    }
}
