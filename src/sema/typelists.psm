// What a `typelist` accepts.
//
//     typelist Scalars { Int, I64, Float, Bool }     // a set
//     typelist Row (Int, String, Bool)               // a sequence
//
// An entry is a type, a trait (any type implementing it fits), or another list. A set
// accepts an argument when any entry does; a sequence accepts by position, and the pack that
// is bounded by it asks entry by entry (sema/packs.psm). Nested lists are flattened by
// asking the inner list the same question, to a bounded depth so a list cannot contain itself.

import symbols.declarations
import ast.nodes
import ast.types
import common.diagnostics
import std.string

let TYPELIST_MAX_DEPTH = 8

internal fn typelistNamed(name: String) -> ASTNode {
    let count = ir_decl_count(name)
    for i in 0..<count {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (decl.kind == NodeKind.TYPELIST_DECL) { return decl }
    }
    return ptr_to_node(ptr_null())
}

internal fn typelistIsSequence(list: ASTNode) -> Bool {
    return list.i1 == 1
}

internal fn typelistWidth(list: ASTNode) -> Int {
    let mut width = 0
    let mut p = list.child1
    while (nodeExists(p)) {
        width = width + 1
        p = ptr_to_node(p).next
    }
    return width
}

internal fn typelistEntryAt(list: ASTNode, index: Int) -> ASTNode {
    let mut p = list.child1
    let mut i = 0
    while (nodeExists(p) and i < index) {
        p = ptr_to_node(p).next
        i = i + 1
    }
    return ptr_to_node(p)
}

// The position of a named entry, or -1.
internal fn typelistIndexOfName(list: ASTNode, name: String) -> Int {
    let mut p = list.child1
    let mut i = 0
    while (nodeExists(p)) {
        if (ptr_to_node(p).s1.equals(name)) { return i }
        p = ptr_to_node(p).next
        i = i + 1
    }
    return -1
}

// What an entry is written as, for a message.
internal fn typelistEntryText(entry: ASTNode) -> String {
    return ptr_to_node(entry.child1).s1.clone()
}

// Whether one entry accepts a type.
internal fn typelistEntryAccepts(module: ASTNode, entry: ASTNode, argT: TypeInfo, depth: Int) -> Bool {
    let annotation = ptr_to_node(entry.child1)
    let name = annotation.s1
    let nested = typelistNamed(name)
    if (nodeExists(node_to_ptr(nested)) and depth < TYPELIST_MAX_DEPTH) {
        return typelistAccepts(module, nested, argT, depth + 1)
    }
    let traitDecl = monoFindTrait(module, name)
    if (nodeExists(node_to_ptr(traitDecl))) {
        let traitRef = createNode(NodeKind.TRAIT_REF)
        traitRef.s1 = name.clone()
        return monoImplements(module, argT, traitRef)
    }
    let entryT = semaAnnotationType(module, annotation)
    return typeIsValid(entryT) and typeEquals(entryT, argT)
}

// Whether any entry accepts a type: a set's rule, and a nested list's whatever its delimiter.
internal fn typelistAccepts(module: ASTNode, list: ASTNode, argT: TypeInfo, depth: Int) -> Bool {
    let mut p = list.child1
    while (nodeExists(p)) {
        if (typelistEntryAccepts(module, ptr_to_node(p), argT, depth)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

// ---------------------------------------------------------
// Declarations
// ---------------------------------------------------------

// Whether an entry names `target` directly or through other lists, to a bounded depth.
private fn typelistReaches(entry: ASTNode, target: String, depth: Int) -> Bool {
    if (depth > TYPELIST_MAX_DEPTH) { return true }
    let name = ptr_to_node(entry.child1).s1
    if (name.equals(target)) { return true }
    let nested = typelistNamed(name)
    if (nodeIsNull(node_to_ptr(nested))) { return false }
    let mut p = nested.child1
    while (nodeExists(p)) {
        if (typelistReaches(ptr_to_node(p), target, depth + 1)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

private fn typelistFail(list: ASTNode, at: ASTNode, message: String) {
    semaErrorAt(at, message)
    list.i3 = 1
}

private fn typelistCheckEntry(module: ASTNode, list: ASTNode, entry: ASTNode, position: Int) {
    let annotation = ptr_to_node(entry.child1)
    if (typelistIsSequence(list) == false and entry.s1.equals("") == false) {
        let hint = "only an ordered sequence names its entries: write `(".concat(entry.s1, ": ", annotation.s1, ")`")
        typelistFail(list, entry, hint)
        return
    }
    let nested = typelistNamed(annotation.s1)
    if (nodeExists(node_to_ptr(nested))) {
        if (typelistReaches(entry, list.s1, 0)) {
            typelistFail(list, entry, "the typelist ".concat(diagQuote(list.s1), " contains itself"))
        } else if (typelistIsSequence(nested)) {
            typelistFail(list, entry, "an entry cannot be an ordered sequence: ".concat(diagQuote(nested.s1),
                                                                                      " is one; use a set"))
        }
        return
    }
    if (nodeExists(node_to_ptr(monoFindTrait(module, annotation.s1)))) { return }
    if (typeIsValid(semaAnnotationType(module, annotation)) == false) { list.i3 = 1 }
}

private fn typelistCheckDuplicates(list: ASTNode) {
    let mut p = list.child1
    let mut index = 0
    while (nodeExists(p)) {
        let entry = ptr_to_node(p)
        let mut q = list.child1
        for j in 0..<index {
            let earlier = ptr_to_node(q)
            let sameType = ptr_to_node(earlier.child1).s1.equals(ptr_to_node(entry.child1).s1)
            let sameName = entry.s1.equals("") == false and earlier.s1.equals(entry.s1)
            if (sameName or (sameType and typelistIsSequence(list) == false)) {
                typelistFail(list, entry, "the typelist ".concat(diagQuote(list.s1), " lists ",
                                                                diagQuote(typelistEntryText(entry)), " twice"))
                return
            }
            q = earlier.next
        }
        index = index + 1
        p = entry.next
    }
}

// Every typelist in the program, used or not: a list is checked where it is written, so a mistake in
// one is reported once, there, and not at each call that tries to use it. A list that fails is marked
// (`i3`) and the packs bounded by it stay quiet.
public fn typelistCheckDeclarations(module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let list = ptr_to_node(p)
        if (list.kind == NodeKind.TYPELIST_DECL) {
            if (nodeIsNull(list.child1)) {
                typelistFail(list, list, "the typelist ".concat(diagQuote(list.s1), " is empty and accepts nothing"))
            } else {
                let mut e = list.child1
                let mut position = 0
                while (nodeExists(e)) {
                    typelistCheckEntry(module, list, ptr_to_node(e), position)
                    position = position + 1
                    e = ptr_to_node(e).next
                }
                if (list.i3 == 0) { typelistCheckDuplicates(list) }
            }
        }
        p = list.next
    }
}
