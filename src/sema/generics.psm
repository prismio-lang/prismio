// Generic declarations: collection, substitution, and demand-driven
// instantiation.
//
// The strategy is monomorphisation, and it is an AST-to-AST transform that
// finishes before codegen sees anything. `Box<Int>` becomes an ordinary struct
// named `Box$Int`; `identity<T>` called on an `Int` becomes an ordinary function
// named `identity$Int`. Sema and codegen are unchanged by this file -- they only
// ever see concrete declarations -- which is what makes the abstraction free at
// runtime rather than merely cheap.
//
// **Templates leave the module chain before sema runs.** monoCollectTemplates
// unlinks every generic declaration and parks it on `module.child2`. That is not
// tidiness: semaCacheFunctionSymbols overwrites `s2` on every FUNCTION in the
// chain, and `s2` is where the parser put the type parameters, so a template
// left in the chain would have its parameter list destroyed before the first
// instantiation could read it.
//
// Instantiation is **demand-driven**, which is INFERENCE 6.3's shape and is
// deliberate -- see monoInstantiateFunction for why that matters beyond this
// file.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import ir.bridge
import std.string

// The separator in an instantiated name. `$` rather than `_` because a mangled
// name has to be one no user declaration can collide with, and `_` is a legal
// identifier character here while `$` is not.
internal fn monoSeparator() -> String { return "$" }

private fn monoIsTemplate(stmt: ASTNode) -> Bool {
    if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.STRUCT_DECL
        or stmt.kind == NodeKind.ENUM_DECL) {
        return strEquals(stmt.s2, "") == false
    }
    return false
}

// Unlinks every generic declaration from the module chain and parks it on
// `module.child2`. Runs after import resolution and before sema.
fn monoCollectTemplates(module: ASTNode) {
    let kept = nodeList()
    let templates = nodeList()

    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        // Read `next` before pushing: nodeListPush rewrites the tail's `next`,
        // so the chain being walked is the chain being rebuilt.
        let following = stmt.next
        stmt.next = ptr_null()
        if (monoIsTemplate(stmt)) {
            nodeListPush(templates, stmt)
        } else {
            nodeListPush(kept, stmt)
        }
        stmtPtr = following
    }

    module.child1 = kept.head
    module.child2 = templates.head
}

// A generic *type* template, which may be a struct or an enum. Both spell their
// use the same way -- `Option<Int>` and `Box<Int>` are one syntax -- so the
// lookup that resolves a type annotation cannot know which it wants in advance.
internal fn monoFindTypeTemplate(module: ASTNode, name: String) -> ASTNode {
    let mut p = module.child2
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (strEquals(stmt.s1, name)) {
            if (stmt.kind == NodeKind.STRUCT_DECL or stmt.kind == NodeKind.ENUM_DECL) {
                return stmt
            }
        }
        p = stmt.next
    }
    return ptr_to_node(ptr_null())
}

private fn monoFindTemplate(module: ASTNode, name: String, kind: NodeKind) -> ASTNode {
    let mut p = module.child2
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == kind and strEquals(stmt.s1, name)) { return stmt }
        p = stmt.next
    }
    return ptr_to_node(ptr_null())
}

private fn monoHasTemplate(module: ASTNode, name: String, kind: NodeKind) -> Bool {
    return nodeExists(node_to_ptr(monoFindTemplate(module, name, kind)))
}

// Appends an instantiated declaration to the module chain.
//
// Walks to the tail rather than caching one. The cached tail in main.psm exists
// because merging appends once per declaration of every module; this appends
// once per *instantiation*, and a program with enough instantiations for the
// walk to matter would be one where the instantiations themselves dominate.
// Measure before replacing it.
internal fn monoAppendDeclaration(module: ASTNode, decl: ASTNode) {
    decl.next = ptr_null()
    if (nodeIsNull(module.child1)) {
        module.child1 = node_to_ptr(decl)
        return
    }
    let mut p = module.child1
    loop {
        let stmt = ptr_to_node(p)
        if (nodeIsNull(stmt.next)) {
            stmt.next = node_to_ptr(decl)
            return
        }
        p = stmt.next
    }
}

// ---------------------------------------------------------
// Copying a template
// ---------------------------------------------------------

// `typeInfo` is deliberately not copied. A copy is made before sema has run over
// it, and the template's own types -- if it ever acquired any -- are types of the
// type *parameter*, not of the argument substituted for it. Carrying one over
// would make the instantiation agree with the template about a type it no longer
// has.
internal fn monoCopyOne(ptr: Ptr) -> ASTNode {
    let src = ptr_to_node(ptr)
    let dup = createNode(src.kind)
    dup.s1 = src.s1
    dup.s2 = src.s2
    dup.i1 = src.i1
    dup.i2 = src.i2
    dup.i3 = src.i3
    dup.line = src.line
    dup.col = src.col
    dup.len = src.len
    dup.file = src.file
    dup.child1 = monoCopyChain(src.child1)
    dup.child2 = monoCopyChain(src.child2)
    dup.child3 = monoCopyChain(src.child3)
    dup.genericInfo = monoCopyChain(src.genericInfo)
    return dup
}

// **Returns the node, not a pointer to it, and the chain is built with
// nodeList().** Both halves of that matter and the first one cost a crash to
// learn: a function that ends `return node_to_ptr(dup)` hands back a pointer to
// a local the scope then drops, and the copy is reclaimed before its first
// reader. Returning the ASTNode moves it to the caller; nodeListPush moves it
// into the chain. Every node-building function in the frontend is shaped this
// way -- parseParameterList returns `params.head` for exactly this reason.
private fn monoCopyChain(ptr: Ptr) -> Ptr {
    let copies = nodeList()
    let mut p = ptr
    while (nodeExists(p)) {
        nodeListPush(copies, monoCopyOne(p))
        p = ptr_to_node(p).next
    }
    return copies.head
}

// ---------------------------------------------------------
// Type parameter lists, which the parser left comma-joined
// ---------------------------------------------------------

internal fn monoParamCount(params: String) -> Int {
    if (strEquals(params, "")) { return 0 }
    let mut count = 1
    let mut i = 0
    let n = __builtin_string_len(params)
    while (i < n) {
        if (strCharAt(params, i) == ',') { count = count + 1 }
        i = i + 1
    }
    return count
}

internal fn monoParamAt(params: String, index: Int) -> String {
    let mut start = 0
    let mut seen = 0
    let mut i = 0
    let n = __builtin_string_len(params)
    while (i <= n) {
        if (i == n or strCharAt(params, i) == ',') {
            if (seen == index) { return strSubstring(params, start, i - start) }
            seen = seen + 1
            start = i + 1
        }
        i = i + 1
    }
    return ""
}

internal fn monoParamName(params: String, index: Int) -> String {
    return monoParamAt(params, index)
}

internal fn monoParamIndex(params: String, name: String) -> Int {
    let count = monoParamCount(params)
    let mut i = 0
    while (i < count) {
        if (strEquals(monoParamName(params, i), name)) { return i }
        i = i + 1
    }
    return -1
}

private fn monoGenericParamAt(infoPtr: Ptr, index: Int) -> Ptr {
    return monoChainAt(infoPtr, index)
}

// ---------------------------------------------------------
// Bounds
// ---------------------------------------------------------

private fn monoFindTrait(module: ASTNode, traitName: String) -> ASTNode {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.TRAIT_DECL and strEquals(stmt.s1, traitName)) { return stmt }
        p = stmt.next
    }
    return ptr_to_node(ptr_null())
}

private fn monoAnnotationText(annotationPtr: Ptr) -> String {
    if (nodeIsNull(annotationPtr)) { return "" }
    let annotation = ptr_to_node(annotationPtr)
    if (annotation.i1 == 1) {
        return strConcat(strConcat("[", monoAnnotationText(annotation.child1)), "]")
    }
    let mut text = strClone(annotation.s1)
    if (annotation.i2 == 1) {
        text = strConcat(text, "<")
        let mut argPtr = annotation.child1
        let mut first = true
        while (nodeExists(argPtr)) {
            if (first == false) { text = strConcat(text, ", ") }
            first = false
            text = strConcat(text, monoAnnotationText(argPtr))
            argPtr = ptr_to_node(argPtr).next
        }
        text = strConcat(text, ">")
    }
    if (annotation.i3 == 1) { text = strConcat(text, "?") }
    return text
}

internal fn monoTraitRefText(traitRefPtr: Ptr) -> String {
    if (nodeIsNull(traitRefPtr)) { return "" }
    let traitRef = ptr_to_node(traitRefPtr)
    if (traitRef.i2 == 0) { return strClone(traitRef.s1) }

    let mut text = strConcat(traitRef.s1, "<")
    let mut argPtr = traitRef.child1
    let mut first = true
    while (nodeExists(argPtr)) {
        if (first == false) { text = strConcat(text, ", ") }
        first = false
        text = strConcat(text, monoAnnotationText(argPtr))
        argPtr = ptr_to_node(argPtr).next
    }

    // Equality constraints are part of what the bound demanded, so they belong in
    // the text a failed bound is reported with. Without them the diagnostic for
    // `Container<Item = Int>` read `Container<>` and told the reader that a type
    // implementing Container did not implement it.
    let mut constraintPtr = traitRef.child2
    while (nodeExists(constraintPtr)) {
        let constraint = ptr_to_node(constraintPtr)
        if (first == false) { text = strConcat(text, ", ") }
        first = false
        text = strConcat(text, strConcat(constraint.s1,
                                         strConcat(" = ", monoAnnotationText(constraint.child1))))
        constraintPtr = constraint.next
    }
    return strConcat(text, ">")
}

private fn monoTraitRefHasValidArity(module: ASTNode, traitRef: ASTNode) -> Bool {
    let traitDecl = monoFindTrait(module, traitRef.s1)
    if (nodeIsNull(node_to_ptr(traitDecl))) { return false }
    return monoChainLength(traitRef.child1) == monoParamCount(traitDecl.s2)
}

private fn monoTraitRefsEqual(module: ASTNode, a: ASTNode, b: ASTNode) -> Bool {
    if (strEquals(a.s1, b.s1) == false) { return false }
    let mut aArg = a.child1
    let mut bArg = b.child1
    loop {
        if (nodeIsNull(aArg) and nodeIsNull(bArg)) { return true }
        if (nodeIsNull(aArg) or nodeIsNull(bArg)) { return false }
        if (typeEquals(semaAnnotationType(module, ptr_to_node(aArg)),
                       semaAnnotationType(module, ptr_to_node(bArg))) == false) {
            return false
        }
        aArg = ptr_to_node(aArg).next
        bArg = ptr_to_node(bArg).next
    }
}

// The no-diagnostic form of a generic impl's bounds. A bound such as
// `impl<T: Key> Hashable for Box<T>` controls whether this impl is applicable;
// failure is not itself an error because another impl may apply. The outer
// bound check reports `Box<X> does not implement Hashable` only after the search
// has exhausted the set.
private fn monoImplBoundsHold(module: ASTNode, params: String,
                              genericInfo: Ptr, argsPtr: Ptr) -> Bool {
    let count = monoParamCount(params)
    let mut i = 0
    while (i < count) {
        let argPtr = monoChainAt(argsPtr, i)
        if (nodeIsNull(argPtr)) { return false }
        let argT = semaAnnotationType(module, ptr_to_node(argPtr))
        let genericParamPtr = monoGenericParamAt(genericInfo, i)
        if (nodeExists(genericParamPtr)) {
            let mut boundPtr = ptr_to_node(genericParamPtr).child1
            while (nodeExists(boundPtr)) {
                let concreteBound = monoCopyOne(boundPtr)
                monoSubstituteChain(concreteBound.child1, params, argsPtr)
                if (monoTraitRefHasValidArity(module, concreteBound) == false) { return false }
                if (monoImplements(module, argT, concreteBound) == false) { return false }
                boundPtr = ptr_to_node(boundPtr).next
            }
        }
        i = i + 1
    }
    return true
}

private fn monoMatchTraitParam(module: ASTNode, patternPtr: Ptr, actualPtr: Ptr,
                               paramName: String) -> ASTNode {
    let mut pattern = patternPtr
    let mut actual = actualPtr
    while (nodeExists(pattern) and nodeExists(actual)) {
        let solved = monoMatchParam(module, ptr_to_node(pattern),
                                    semaAnnotationType(module, ptr_to_node(actual)), paramName)
        if (nodeExists(node_to_ptr(solved))) { return solved }
        pattern = ptr_to_node(pattern).next
        actual = ptr_to_node(actual).next
    }
    return ptr_to_node(ptr_null())
}

private fn monoImplApplies(module: ASTNode, implNode: ASTNode,
                           actual: TypeInfo, traitRef: ASTNode) -> Bool {
    if (nodeIsNull(implNode.child3)) { return false }
    let header = ptr_to_node(implNode.child3)
    if (nodeIsNull(header.child1) or nodeIsNull(header.child2)) { return false }
    let implTrait = ptr_to_node(header.child2)
    if (strEquals(implTrait.s1, traitRef.s1) == false) { return false }

    let params = header.s1
    let target = ptr_to_node(header.child1)
    if (strEquals(params, "")) {
        return typeEquals(semaAnnotationType(module, target), actual)
            and monoTraitRefsEqual(module, implTrait, traitRef)
    }

    let solvedArgs = nodeList()
    let count = monoParamCount(params)
    let mut i = 0
    while (i < count) {
        let mut solved = monoMatchParam(module, target, actual, monoParamName(params, i))
        if (nodeIsNull(node_to_ptr(solved))) {
            solved = monoMatchTraitParam(module, implTrait.child1, traitRef.child1,
                                         monoParamName(params, i))
        }
        if (nodeIsNull(node_to_ptr(solved))) { return false }
        nodeListPush(solvedArgs, solved)
        i = i + 1
    }

    // Solving every parameter is necessary but not sufficient. For
    // `Pair<T, Int>` against `Pair<Bool, String>`, T is solvable while the fixed
    // second argument still disagrees. Substitute the solution into a copy and
    // compare the complete concrete type; this also enforces repeated variables
    // such as `Pair<T, T>`.
    let concreteTarget = monoCopyOne(header.child1)
    monoSubstituteChain(node_to_ptr(concreteTarget), params, solvedArgs.head)
    if (typeEquals(semaAnnotationType(module, concreteTarget), actual) == false) {
        return false
    }

    let concreteTrait = monoCopyOne(header.child2)
    monoSubstituteChain(concreteTrait.child1, params, solvedArgs.head)
    if (monoTraitRefsEqual(module, concreteTrait, traitRef) == false) { return false }
    return monoImplBoundsHold(module, params, header.genericInfo, solvedArgs.head)
}

// Whether the module declares an applicable `impl <traitName> for <actual>`.
// A walk rather than a declaration-index lookup is deliberate: impls are not
// named declarations, and the query occurs once per generic instantiation rather
// than once per identifier expression.
private fn monoImplements(module: ASTNode, actual: TypeInfo, traitRef: ASTNode) -> Bool {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.IMPL_DECL and strEquals(stmt.s2, traitRef.s1)) {
            if (monoImplApplies(module, stmt, actual, traitRef)) {
                return monoConstraintsHold(module, stmt, traitRef)
            }
        }
        p = stmt.next
    }
    return false
}

// The bound check, at the instantiation. This is the one place in the compiler
// where a trait means anything: the concrete type is known here and nowhere
// earlier, which is exactly why a bound is checkable at all without dispatch.
//
// Reported against the use site rather than the template, because the template is
// not wrong -- `sort<T: Ord>` is a correct declaration, and what failed is the
// argument this call made of it.
// Answers whether every bound holds. **A violated bound stops the
// instantiation**, and that is the other half of not cascading: an instantiated
// body whose bound was violated is a body full of calls that cannot resolve, and
// reporting those puts the compiler's own vocabulary and the standard library's
// line numbers in front of a user who wrote one wrong type argument.
private fn monoCheckBounds(module: ASTNode, at: ASTNode, name: String, params: String,
                           genericInfo: Ptr, argsPtr: Ptr) -> Bool {
    let count = monoParamCount(params)
    let mut satisfied = true
    let mut i = 0
    while (i < count) {
        let argPtr = monoChainAt(argsPtr, i)
        if (nodeExists(argPtr)) {
            let argT = semaAnnotationType(module, ptr_to_node(argPtr))
            let genericParamPtr = monoGenericParamAt(genericInfo, i)
            if (nodeExists(genericParamPtr)) {
                let mut boundPtr = ptr_to_node(genericParamPtr).child1
                while (nodeExists(boundPtr)) {
                    let concreteBound = monoCopyOne(boundPtr)
                    monoSubstituteChain(concreteBound.child1, params, argsPtr)
                    if (monoCheckOneBound(module, at, name, monoParamName(params, i),
                                          concreteBound, argT) == false) {
                        satisfied = false
                    }
                    boundPtr = ptr_to_node(boundPtr).next
                }
            }
        }
        i = i + 1
    }
    return satisfied
}

// Which (type, bound) pairs have already been reported.
//
// **A bound failure cascades, and the cascade is structural rather than a
// wording problem.** One `mapNew<Float, Int>()` instantiates `mapNew`, whose body
// names `Map<K, V>`, which instantiates `Map`, whose every function names
// `Map<K, V>` again -- so a single mistake in one user expression reported the
// same fact 25 times, ran into the compiler's error cap, and the cap exits
// without `diag_finish`'s "aborting due to N previous error(s)". A negative test
// then cannot tell a rejection from a crash, which is how this was found.
//
// A `String` rather than a set because a set would need a runtime symbol, and
// this holds one short marker per *distinct* violated bound in a whole compile --
// a program with ten of them has a 60-byte string. It is only ever appended to on
// a path that has already failed the build.
let mut monoReportedBounds = ""

// T21. Instantiation is demand-driven and appends to the chain analyzeModule is
// still walking, so a template that asks for a larger instance of itself --
// `grow<T>` calling `grow(Box<T> { value: x })` -- names `Box<T>`,
// `Box<Box<T>>`, and so on, and the compiler never terminates. It hangs with no
// diagnostic at all, which is the worst possible answer to a one-character
// mistake.
//
// **There is no call stack to bound.** What grows is the type, so that is what
// is bounded. 32 is far past anything written by hand, and a runaway reaches it
// in 32 steps, so the diagnostic arrives at once instead of after a hang.
let MONO_MAX_TYPE_DEPTH = 32

private fn monoFirstReportOfBound(typeName: String, bound: String) -> Bool {
    let marker = strConcat(strConcat("|", typeName), strConcat(":", strConcat(bound, "|")))
    if (strContains(monoReportedBounds, marker)) { return false }
    monoReportedBounds = strConcat(monoReportedBounds, marker)
    return true
}

private fn monoCheckOneBound(module: ASTNode, at: ASTNode, name: String, param: String,
                     bound: ASTNode, argT: TypeInfo) -> Bool {
    // An invalid argument type is the result of an error already reported; a
    // second one about a bound it cannot possibly satisfy is noise. Answered
    // `false` all the same, so the instantiation still does not happen.
    if (typeIsValid(argT) == false) { return false }

    let traitDecl = monoFindTrait(module, bound.s1)
    let boundText = monoTraitRefText(node_to_ptr(bound))
    if (nodeIsNull(node_to_ptr(traitDecl))) {
        if (monoFirstReportOfBound(argT.name, boundText)) {
            semaErrorAt(at, strConcat(strConcat(diagQuote(boundText), " is not a trait, so `"),
                                      strConcat(strConcat(param, ": "), strConcat(boundText, "` cannot be a bound"))))
        }
        return false
    }

    if (monoChainLength(bound.child1) != monoParamCount(traitDecl.s2)) {
        if (monoFirstReportOfBound(argT.name, boundText)) {
            semaErrorAt(at, strConcat(strConcat(diagQuote(bound.s1), " takes trait arguments <"),
                                      strConcat(strConcat(traitDecl.s2,
                                                ">, and the arguments in bound "),
                                                strConcat(diagQuote(boundText), " do not match"))))
        }
        return false
    }

    if (monoImplements(module, argT, bound)) { return true }
    if (monoFirstReportOfBound(argT.name, boundText) == false) { return false }

    semaErrorAt(at, strConcat(strConcat(typeDisplay(argT), " does not implement "),
                              diagQuote(boundText)))
    diag_note(strConcat(strConcat(diagQuote(name), " requires it: the type parameter is declared "),
                        strConcat(strConcat(param, ": "), boundText)))
    diag_note(strConcat(strConcat("write `impl ", boundText),
                        strConcat(strConcat(" for ", argT.name), " { ... }`")))
    return false
}

private fn monoChainLength(ptr: Ptr) -> Int {
    let mut count = 0
    let mut p = ptr
    while (nodeExists(p)) {
        count = count + 1
        p = ptr_to_node(p).next
    }
    return count
}

private fn monoChainAt(ptr: Ptr, index: Int) -> Ptr {
    let mut p = ptr
    let mut i = 0
    while (nodeExists(p)) {
        if (i == index) { return p }
        i = i + 1
        p = ptr_to_node(p).next
    }
    return ptr_null()
}

// ---------------------------------------------------------
// Substitution
// ---------------------------------------------------------

// Rewrites a type parameter in place into the argument written for it.
//
// In place rather than by returning a new node, because a type annotation is
// reached through a `child1`/`next` slot whose owner would otherwise have to be
// told to re-point -- and the owners are five different kinds. The two fields
// that must survive the rewrite are the sibling link, which belongs to the list
// this annotation sits in and not to the type, and the `?` suffix: `T?` with
// `T := Node` is `Node?`, so the suffix is or-ed rather than overwritten.
private fn monoSubstituteInto(target: ASTNode, argPtr: Ptr) {
    let arg = monoCopyOne(argPtr)
    target.s1 = arg.s1
    target.i1 = arg.i1
    target.i2 = arg.i2
    if (arg.i3 == 1) { target.i3 = 1 }
    target.child1 = arg.child1
}

internal fn monoSubstituteChain(ptr: Ptr, params: String, argsPtr: Ptr) {
    let mut p = ptr
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        if (node.kind == NodeKind.TYPE_ANNOTATION and node.i1 == 0 and node.i2 == 0) {
            let index = monoParamIndex(params, node.s1)
            if (index >= 0) {
                let argPtr = monoChainAt(argsPtr, index)
                if (nodeExists(argPtr)) { monoSubstituteInto(node, argPtr) }
            }
        }
        monoSubstituteChain(node.child1, params, argsPtr)
        monoSubstituteChain(node.child2, params, argsPtr)
        monoSubstituteChain(node.child3, params, argsPtr)
        p = node.next
    }
}

// ---------------------------------------------------------
// Naming an instantiation
// ---------------------------------------------------------

// The mangled name is built from the *resolved* argument types rather than from
// the text written at the use site, so `Box<Int>` and a `Box<T>` whose `T` was
// itself substituted with `Int` name the same instantiation instead of two that
// differ only in spelling.
private fn monoMangledName(module: ASTNode, base: String, argsPtr: Ptr) -> String {
    let mut name = base
    let mut p = argsPtr
    while (nodeExists(p)) {
        let arg = ptr_to_node(p)
        let argT = semaAnnotationType(module, arg)
        name = strConcat(strConcat(name, monoSeparator()), semaMangleType(argT))
        p = arg.next
    }
    return name
}

// A type annotation that denotes an already-resolved type. Needed because a
// generic function's arguments are *expressions*: inference produces a TypeInfo
// where substitution consumes an annotation, and this is the bridge.
internal fn monoAnnotationFromType(t: TypeInfo) -> ASTNode {
    let tn = createNode(NodeKind.TYPE_ANNOTATION)
    if (t.kind == TypeKind.OPTIONAL) {
        let inner = typeOptionalInner(t)
        if (typeIsValid(inner)) {
            let base = monoAnnotationFromType(inner)
            base.i3 = 1
            return base
        }
        tn.s1 = "Ptr"
        return tn
    }
    if (t.kind == TypeKind.ARRAY) {
        tn.i1 = 1
        tn.child1 = node_to_ptr(monoAnnotationFromType(ptr_to_type(t.child)))
        return tn
    }
    if (t.kind == TypeKind.LIST) {
        tn.i2 = 1
        tn.s1 = "List"
        tn.child1 = node_to_ptr(monoAnnotationFromType(ptr_to_type(t.child)))
        return tn
    }
    if (t.kind == TypeKind.SLICE) {
        tn.i2 = 1
        tn.s1 = "Slice"
        tn.child1 = node_to_ptr(monoAnnotationFromType(ptr_to_type(t.child)))
        return tn
    }
    if (t.kind == TypeKind.DATAVIEW) {
        tn.i2 = 1
        tn.s1 = "DataView"
        if (nodeExists(t.child)) { tn.child1 = node_to_ptr(monoAnnotationFromType(ptr_to_type(t.child))) }
        return tn
    }
    tn.s1 = t.name
    return tn
}

// ---------------------------------------------------------
// Instantiation
// ---------------------------------------------------------

// Names the parameters rather than counting them: the list says what to write,
// where a count only says how many.
private fn monoArityError(node: ASTNode, name: String, params: String) {
    semaErrorAt(node, strConcat(strConcat(strConcat(
        diagQuote(name), " takes type parameters <"), params),
        ">, and the type arguments written here do not match"))
}

// `Box<Int>` -> the name of an ordinary struct, instantiating it if this is the
// first use. Answers "" when the name is not a generic struct, which is how the
// caller tells a missing type argument list from a missing type.
internal fn monoInstantiateStruct(module: ASTNode, tn: ASTNode) -> String {
    let template = monoFindTypeTemplate(module, tn.s1)
    if (nodeIsNull(node_to_ptr(template))) { return "" }

    let params = template.s2
    let given = monoChainLength(tn.child1)
    if (given != monoParamCount(params)) {
        monoArityError(tn, tn.s1, params)
        return ""
    }
    if (monoCheckBounds(module, tn, tn.s1, params,
                        template.genericInfo, tn.child1) == false) { return "" }
    // The struct half of the same bound. `Box<Box<...>>` is what actually grows
    // when a generic function instantiates itself with a larger argument.
    if (monoArgsTooDeep(tn, tn.s1, tn.child1)) { return "" }

    // The mangled name is written straight onto the declaration that will carry
    // it, and every read below is a read of that field.
    //
    // **It may not be held in a local.** Strings are affine, so a `let` could be
    // named once where this needs it four times -- but parking it on a scratch
    // node is worse than useless, and that is the bug this shape exists to avoid.
    // Automatic arena placement reclaims a scope's allocations at the scope's
    // exit, so a name whose only owner is a local dies when this function
    // returns, while the declaration written from it lives in the module for the
    // rest of the compile.
    //
    // The copy is therefore made before the already-instantiated check, and
    // thrown away on a hit. That is a wasted copy per repeated use site; it is
    // measured in nothing yet, and correctness here is not negotiable.
    let copy = monoCopyOne(node_to_ptr(template))
    copy.s1 = monoMangledName(module, tn.s1, tn.child1)
    copy.s2 = ""

    if (semaHasStruct(module, copy.s1) or semaHasEnum(module, copy.s1)) { return copy.s1 }

    // A generic enum with no payload stays an enum: its values are still i32
    // constants, and nothing about a type parameter changes that.
    if (copy.kind == NodeKind.ENUM_DECL and enumHasPayload(copy) == false) {
        ir_declare_named_type(copy.s1, 2)
        monoAppendDeclaration(module, copy)
        indexTopLevel(copy)
        return copy.s1
    }

    // Declared before the payload or field types are substituted, and that
    // ordering is what makes a self-referential generic terminate: `struct
    // Node<T> { next: Node<T>? }` reaches this function again from inside its
    // own field list, and has to find the name already taken rather than recur.
    ir_declare_named_type(copy.s1, 1)
    monoSubstituteChain(copy.child1, params, tn.child1)
    monoResolveProjections(module, node_to_ptr(copy))

    if (copy.kind == NodeKind.ENUM_DECL) {
        // Desugared *after* substitution, so the struct's payload slots carry
        // the concrete types rather than the parameters. The instantiated enum
        // becomes the shadow, which is what gives `match` the payload types and
        // the tag values for this instantiation.
        let desugared = enumDesugarToStruct(copy)
        desugared.child2 = monoCopyChain(tn.child1)
        enumShadowPush(module, copy)
        monoAppendDeclaration(module, desugared)
        indexTopLevel(desugared)
        return desugared.s1
    }

    // The arguments this was instantiated with, kept on the declaration.
    //
    // Without them a type parameter is unrecoverable the moment it is
    // substituted: `Map<Int, Int>` becomes a struct named `Map$Int$Int`, and a
    // later `fn mapLen<K, V>(m: Map<K, V>)` has nothing to match `K` against but
    // the name. Reading them back out of the mangled name would work until a
    // type argument contained the separator.
    copy.child2 = monoCopyChain(tn.child1)
    monoAppendDeclaration(module, copy)
    indexTopLevel(copy)
    return copy.s1
}

// The function half. `argsPtr` is a chain of type annotations in the template's
// declaration order -- the caller has already solved them, because solving needs
// the types of the call's arguments and those are sema's to give.
//
// **Demand-driven, and that is worth more than the code it saves.** A template
// nothing calls is never emitted, so a generic that is written and unused costs
// nothing in the binary. It is also the shape INFERENCE 6.3 specifies for
// ownership contexts -- discovery at the call site, instantiation into a
// monotonically growing module -- which is why the two can share this machinery
// rather than each grow their own. See the note at the end of this file.
private fn monoInstantiateFunction(module: ASTNode, template: ASTNode, argsPtr: Ptr) -> String {
    let params = template.s2
    // Built onto the copy for the reason monoInstantiateStruct sets out at
    // length: a name owned only by a local does not outlive this call.
    let copy = monoCopyOne(node_to_ptr(template))
    copy.s1 = monoMangledName(module, template.s1, argsPtr)
    copy.s2 = ""

    // Two generic overloads can have the same base name and the same type
    // arguments while still being distinct functions -- generic impl methods
    // make `Box<T>.get` beside `Cell<T>.get` the ordinary case. The old
    // name-only test treated the first instantiation as proof that every other
    // template with that mangled name already existed, so the second method was
    // silently replaced by the first. Template source identity is stable on a
    // copy and distinguishes exactly the declaration being instantiated.
    let existingCount = ir_decl_count(copy.s1)
    let mut existingIndex = 0
    while (existingIndex < existingCount) {
        let existing = ptr_to_node(ir_decl_at(copy.s1, existingIndex))
        if (existing.kind == NodeKind.FUNCTION
            and existing.file == template.file
            and existing.line == template.line
            and existing.col == template.col) {
            return copy.s1
        }
        existingIndex = existingIndex + 1
    }

    if (monoArgsTooDeep(template, template.s1, argsPtr)) { return template.s1 }

    monoSubstituteChain(copy.child1, params, argsPtr)
    monoSubstituteChain(copy.child2, params, argsPtr)
    monoSubstituteChain(copy.child3, params, argsPtr)
    monoResolveProjections(module, node_to_ptr(copy))

    // Appended and indexed before it is predeclared, because predeclaring reads
    // the parameter annotations back through the declaration index.
    monoAppendDeclaration(module, copy)
    indexTopLevel(copy)
    copy.s2 = semaFunctionSymbol(module, copy)
    semaPredeclareFunction(module, copy)

    // Nothing checks the body here. The instantiation is appended to the chain
    // analyzeModule is still walking, so the loop that asked for it reaches it in
    // the same pass -- which is also why an instantiation may itself instantiate.
    return copy.s1
}

// ---------------------------------------------------------
// Solving a call's type arguments
// ---------------------------------------------------------

// Matches one parameter's written type against the type the call actually
// passed, looking for `paramName`. Answers the type it was bound to, or an
// absent node when this parameter says nothing about it.
//
// Structural rather than positional, so `fn first<T>(xs: List<T>) -> T` solves
// `T` from the *element* type of the argument. It goes one constructor deep per
// step and recurses, which is all inference this needs: a type parameter is
// found in argument position, never solved from a return type.
internal fn monoMatchParam(module: ASTNode, tn: ASTNode, actual: TypeInfo, paramName: String) -> ASTNode {
    // `value: T.Item` says nothing about what `T` is -- it is the projection's
    // base that would have to be known first. Contributing nothing here leaves
    // `T` to be solved from a parameter that can actually determine it.
    if (tn.kind == NodeKind.ASSOC_TYPE_REF) { return ptr_to_node(ptr_null()) }

    if (tn.i1 == 0 and tn.i2 == 0 and strEquals(tn.s1, paramName)) {
        if (typeIsValid(actual) == false) { return ptr_to_node(ptr_null()) }
        return monoAnnotationFromType(actual)
    }
    if (tn.i1 == 1 and actual.kind == TypeKind.ARRAY and nodeExists(tn.child1)) {
        return monoMatchParam(module, ptr_to_node(tn.child1), ptr_to_type(actual.child), paramName)
    }
    if (tn.i2 == 1 and actual.kind == TypeKind.LIST and nodeExists(tn.child1)) {
        return monoMatchParam(module, ptr_to_node(tn.child1), semaListElementType(actual), paramName)
    }
    if (tn.i2 == 1 and actual.kind == TypeKind.SLICE and nodeExists(tn.child1)) {
        return monoMatchParam(module, ptr_to_node(tn.child1), semaSliceElementType(actual), paramName)
    }
    if (tn.i2 == 1 and actual.kind == TypeKind.DATAVIEW and nodeExists(tn.child1)) {
        return monoMatchParam(module, ptr_to_node(tn.child1), semaDataViewElementType(actual), paramName)
    }

    // `Map<K, V>` against an argument of type `Map$Int$Int`. The instantiation
    // recorded what it was made from, so the match is positional against that
    // rather than an attempt to read the mangled name back apart.
    if (tn.i2 == 1 and actual.kind == TypeKind.STRUCT and nodeExists(tn.child1)) {
        // `Box<T>` can only solve T from a Box instantiation. Looking only at
        // the recorded argument list made an unrelated `Cell<Int>` appear to
        // match whenever it had the same arity. `$` cannot occur in a source
        // identifier, so this prefix tests the constructor without trying to
        // parse type arguments back out of the mangled name.
        let constructorPrefix = strConcat(tn.s1, monoSeparator())
        if (strStartsWith(actual.name, constructorPrefix) == false) {
            return ptr_to_node(ptr_null())
        }
        let decl = findStructDeclNamed(module, actual.name)
        if (nodeExists(node_to_ptr(decl)) and nodeExists(decl.child2)) {
            let mut want = tn.child1
            let mut have = decl.child2
            while (nodeExists(want) and nodeExists(have)) {
                let solved = monoMatchParam(module, ptr_to_node(want),
                                            semaAnnotationType(module, ptr_to_node(have)), paramName)
                if (nodeExists(node_to_ptr(solved))) { return solved }
                want = ptr_to_node(want).next
                have = ptr_to_node(have).next
            }
        }
    }
    return ptr_to_node(ptr_null())
}

private fn monoSolveTypeParam(module: ASTNode, template: ASTNode, argPtr: Ptr, paramName: String) -> ASTNode {
    let mut param = template.child1
    let mut arg = argPtr
    while (nodeExists(param) and nodeExists(arg)) {
        let paramNode = ptr_to_node(param)
        let solved = monoMatchParam(module, ptr_to_node(paramNode.child1),
                                    semaExpr(module, ptr_to_node(arg)), paramName)
        if (nodeExists(node_to_ptr(solved))) { return solved }
        param = paramNode.next
        arg = ptr_to_node(arg).next
    }
    return ptr_to_node(ptr_null())
}

// Solving every type parameter does not prove the whole signature matches. In
// `Pair<T, T>` against `Pair<Int, Bool>`, T is solvable from the first argument
// position but its second occurrence disagrees. Substitute the proposed
// solution into copies of the parameter annotations and compare every complete
// argument type before committing to this template.
private fn monoTemplateAcceptsCall(module: ASTNode, template: ASTNode,
                                   argPtr: Ptr, solvedArgs: Ptr) -> Bool {
    let mut paramPtr = template.child1
    let mut actualPtr = argPtr
    while (nodeExists(paramPtr) and nodeExists(actualPtr)) {
        let param = ptr_to_node(paramPtr)
        let expectedAnnotation = monoCopyOne(param.child1)
        monoSubstituteChain(node_to_ptr(expectedAnnotation), template.s2, solvedArgs)
        monoResolveProjections(module, node_to_ptr(expectedAnnotation))
        let expected = semaAnnotationType(module, expectedAnnotation)
        let actual = semaExpr(module, ptr_to_node(actualPtr))
        if (typeEquals(expected, actual) == false) { return false }
        paramPtr = param.next
        actualPtr = ptr_to_node(actualPtr).next
    }
    return nodeIsNull(paramPtr) and nodeIsNull(actualPtr)
}

// Rewrites a call to a generic function so that it names an instantiation.
//
// Does nothing when the name is not a generic function, which is the common
// case and has to stay cheap: it is one walk of the template chain, and that
// chain holds only the generics the program declared.
//
// A type parameter that cannot be solved is left alone rather than reported
// here. The call then fails to resolve like any other unknown call, which puts
// the diagnostic at the call site with the overload machinery's wording instead
// of inventing a second vocabulary for the same mistake.
internal fn monoResolveGenericCall(module: ASTNode, callExpr: ASTNode, callee: ASTNode) {
    let firstTemplate = monoFindTemplate(module, callee.s1, NodeKind.FUNCTION)
    if (nodeIsNull(node_to_ptr(firstTemplate))) { return }

    // Written out at the call site: `vecNew<Int>()`. Taken as given rather than
    // solved, and cleared afterwards so that the repeated semaExpr overload
    // resolution performs over a call does not resolve the same annotation
    // again -- the callee's name already records the answer.
    if (nodeExists(callExpr.child3)) {
        let explicit = ptr_to_node(callExpr.child3)
        callExpr.child3 = ptr_null()
        if (monoChainLength(explicit.child1) != monoParamCount(firstTemplate.s2)) {
            monoArityError(callExpr, firstTemplate.s1, firstTemplate.s2)
            return
        }
        if (monoCheckBounds(module, callExpr, firstTemplate.s1,
                            firstTemplate.s2, firstTemplate.genericInfo,
                            explicit.child1) == false) {
            callExpr.i1 = 1
            return
        }
        callee.s1 = monoInstantiateFunction(module, firstTemplate, explicit.child1)
        return
    }

    // A name may have several generic templates. This was unobservable while
    // generic functions were effectively unique by name, but generic inherent
    // impls naturally repeat names such as `get` across receiver types. Try the
    // templates in declaration order and choose the first whose every parameter
    // can be solved structurally from this call. Ordinary overload resolution
    // still chooses among the resulting concrete functions.
    let mut templatePtr = module.child2
    while (nodeExists(templatePtr)) {
        let template = ptr_to_node(templatePtr)
        if (template.kind == NodeKind.FUNCTION and strEquals(template.s1, callee.s1)) {
            let params = template.s2
            let count = monoParamCount(params)
            let solvedArgs = nodeList()
            let mut solvedAll = true
            let mut i = 0
            while (i < count) {
                let solved = monoSolveTypeParam(module, template, callExpr.child2,
                                                monoParamName(params, i))
                if (nodeIsNull(node_to_ptr(solved))) {
                    solvedAll = false
                } else {
                    nodeListPush(solvedArgs, solved)
                }
                i = i + 1
            }
            if (solvedAll and monoTemplateAcceptsCall(module, template,
                                                       callExpr.child2, solvedArgs.head)) {
                if (monoCheckBounds(module, callExpr, template.s1,
                                    params, template.genericInfo,
                                    solvedArgs.head) == false) {
                    callExpr.i1 = 1
                    return
                }
                callee.s1 = monoInstantiateFunction(module, template, solvedArgs.head)
                return
            }
        }
        templatePtr = template.next
    }
}

// ---------------------------------------------------------
// Default trait methods
// ---------------------------------------------------------

// A trait signature carrying a body is a default, and an `impl` that omits the
// method inherits it. The expansion is a splice for the same reason the parser
// splices an `impl` block's own methods: every pass downstream keys on
// `== NodeKind.FUNCTION`, and none of them should learn that defaults exist.
//
// **This must run before monoCollectTemplates.** Templates leave the module
// chain there, so a default expanded after it would never be collected, and a
// default on a generic impl would silently never instantiate. It must also run
// after the merge, because the trait may be declared in another module.
//
// Appending while walking is safe: what is appended is a FUNCTION, and the walk
// only descends into IMPL_DECL.
fn monoExpandDefaultMethods(module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.IMPL_DECL and strEquals(stmt.s2, "") == false) {
            monoExpandOneImpl(module, stmt)
        }
        p = stmt.next
    }
}

private fn monoExpandOneImpl(module: ASTNode, implNode: ASTNode) {
    let header = ptr_to_node(implNode.child3)
    if (nodeIsNull(header.child2)) { return }
    let traitRef = ptr_to_node(header.child2)
    let traitDecl = monoFindTrait(module, traitRef.s1)
    if (nodeIsNull(node_to_ptr(traitDecl))) { return }

    // An unknown trait and a wrong argument count are conformance's diagnostics.
    // Substituting against a mismatched argument list would report the failure
    // as a type error inside a body the program never wrote.
    if (monoChainLength(traitRef.child1) != monoParamCount(traitDecl.s2)) { return }

    let mut signaturePtr = traitDecl.child1
    while (nodeExists(signaturePtr)) {
        let signature = ptr_to_node(signaturePtr)
        if (nodeExists(signature.child2)
            and monoImplDeclaresMethod(implNode, signature.s1) == false) {
            monoAddDefaultMethod(module, implNode, header, traitRef, traitDecl, signature)
        }
        signaturePtr = signature.next
    }
}

// The impl's own IMPL_METHOD records rather than the module chain. A function of
// this name is very likely to exist for some other type, and an override has to
// be this `impl` block's own to count as one.
private fn monoImplDeclaresMethod(implNode: ASTNode, name: String) -> Bool {
    let mut p = implNode.child2
    while (nodeExists(p)) {
        let record = ptr_to_node(p)
        if (record.kind == NodeKind.IMPL_METHOD and strEquals(record.s1, name)) { return true }
        p = record.next
    }
    return false
}

private fn monoAddDefaultMethod(module: ASTNode, implNode: ASTNode, header: ASTNode,
                                traitRef: ASTNode, traitDecl: ASTNode, signature: ASTNode) {
    let method = monoCopyOne(node_to_ptr(signature))

    // `Self` before the trait's arguments. The target may itself be written in
    // terms of those arguments -- `impl<T> From<T> for Box<T>` -- so expanding
    // `Self` first leaves a `Box<T>` the second pass then resolves, where the
    // other order would leave a `T` that no longer has anything to match.
    monoSubstituteChain(node_to_ptr(method), "Self", header.child1)
    monoSubstituteChain(node_to_ptr(method), traitDecl.s2, traitRef.child1)
    monoResolveProjections(module, node_to_ptr(method))

    // The impl's parameters, exactly as parseImplMethodGenericInfo gives them to
    // a method written out by hand: one template carrying the impl's parameters
    // and the method's, so instantiation needs no second mechanism.
    method.s2 = header.s1
    method.genericInfo = monoCopyChain(header.genericInfo)

    // The span stays the trait's. An error inside a default is an error in the
    // body as written, and pointing at the `impl` that inherited it would send
    // the reader to a method that is not there.
    let record = createNode(NodeKind.IMPL_METHOD)
    nodeSpanFrom(record, method)
    record.s1 = method.s1
    monoPushImplMethodRecord(implNode, record)

    monoAppendDeclaration(module, method)
}

private fn monoPushImplMethodRecord(implNode: ASTNode, record: ASTNode) {
    if (nodeIsNull(implNode.child2)) {
        implNode.child2 = node_to_ptr(record)
        return
    }
    let mut p = implNode.child2
    loop {
        let existing = ptr_to_node(p)
        if (nodeIsNull(existing.next)) {
            existing.next = node_to_ptr(record)
            return
        }
        p = existing.next
    }
}

// ---------------------------------------------------------
// Associated type projections
// ---------------------------------------------------------

// `T.Item` is resolved once its base is concrete: with `T := Bag` it becomes
// whatever `impl Container for Bag` chose for `Item`. That happens at the points
// where a template becomes a concrete declaration, because substitution is what
// stops the base being a type parameter.
//
// The node is rewritten in place into an ordinary TYPE_ANNOTATION, so nothing
// after monomorphisation has to know projections exist. A projection that
// cannot be resolved is deliberately left alone: it then names a type nobody
// declared, and the ordinary unknown-type diagnostic reports it at the
// annotation the programmer wrote.
// Whether any trait or impl in this module declares an associated type. Asked
// once before the deep walk below, because a projection cannot resolve to
// something nobody declared -- and without the question, resolving projections
// costs a full recursive walk of every declaration in every compile, including
// the overwhelming majority that have no associated types at all.
internal fn monoModuleHasAssocType(module: ASTNode) -> Bool {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.TRAIT_DECL and monoChainHasAssocType(stmt.child3)) {
            return true
        }
        if (stmt.kind == NodeKind.IMPL_DECL
            and monoChainHasAssocType(ptr_to_node(stmt.child3).child3)) {
            return true
        }
        p = stmt.next
    }
    return false
}

private fn monoChainHasAssocType(ptr: Ptr) -> Bool {
    let mut p = ptr
    while (nodeExists(p)) {
        if (ptr_to_node(p).kind == NodeKind.ASSOC_TYPE) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

internal fn monoResolveProjections(module: ASTNode, ptr: Ptr) {
    let mut p = ptr
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        // Children first, so a projection whose base is itself a projection has
        // a concrete base by the time this one is resolved.
        monoResolveProjections(module, node.child1)
        monoResolveProjections(module, node.child2)
        monoResolveProjections(module, node.child3)
        if (node.kind == NodeKind.ASSOC_TYPE_REF) {
            monoResolveOneProjection(module, node)
        }
        p = node.next
    }
}

private fn monoResolveOneProjection(module: ASTNode, node: ASTNode) {
    if (nodeIsNull(node.child1)) { return }
    let chosenPtr = monoFindAssocType(module, monoAnnotationText(node.child1), node.s1)
    if (nodeIsNull(chosenPtr)) { return }

    // `T.Item?` is an optional whatever `Item` turned out to be, so the suffix
    // written at the projection survives the rewrite rather than being replaced
    // by the chosen type's own.
    let optional = node.i3
    let chosen = monoCopyOne(chosenPtr)
    node.kind = NodeKind.TYPE_ANNOTATION
    node.s1 = chosen.s1
    node.s2 = chosen.s2
    node.i1 = chosen.i1
    node.i2 = chosen.i2
    node.i3 = chosen.i3
    if (optional == 1) { node.i3 = 1 }
    node.child1 = chosen.child1
}

private fn monoFindAssocType(module: ASTNode, targetText: String, member: String) -> Ptr {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.IMPL_DECL) {
            let header = ptr_to_node(stmt.child3)
            if (strEquals(monoAnnotationText(header.child1), targetText)) {
                let mut memberPtr = header.child3
                while (nodeExists(memberPtr)) {
                    let candidate = ptr_to_node(memberPtr)
                    if (candidate.kind == NodeKind.ASSOC_TYPE
                        and strEquals(candidate.s1, member)) {
                        return candidate.child1
                    }
                    memberPtr = candidate.next
                }
            }
        }
        p = stmt.next
    }
    return ptr_null()
}

// `T: Container<Item = Int>` demands more than that an implementation exists:
// the type it chose has to be the one written. Compared as annotation text, the
// same way impl targets are compared everywhere else on this side.
//
// An implementation that does not name the constrained member at all fails the
// bound rather than passing it vacuously -- the constraint asked about something
// this trait does not have, and treating that as satisfied would make the
// spelling meaningless.
private fn monoConstraintsHold(module: ASTNode, implNode: ASTNode, traitRef: ASTNode) -> Bool {
    let header = ptr_to_node(implNode.child3)
    let mut p = traitRef.child2
    while (nodeExists(p)) {
        let wanted = ptr_to_node(p)
        let chosenPtr = monoImplAssocTypeAnnotation(header, wanted.s1)
        if (nodeIsNull(chosenPtr)) { return false }
        if (strEquals(monoAnnotationText(chosenPtr),
                      monoAnnotationText(wanted.child1)) == false) { return false }
        p = wanted.next
    }
    return true
}

private fn monoImplAssocTypeAnnotation(header: ASTNode, name: String) -> Ptr {
    let mut p = header.child3
    while (nodeExists(p)) {
        let member = ptr_to_node(p)
        if (member.kind == NodeKind.ASSOC_TYPE and strEquals(member.s1, name)) {
            return member.child1
        }
        p = member.next
    }
    return ptr_null()
}

private fn monoTypeDepth(ptr: Ptr) -> Int {
    if (nodeIsNull(ptr)) { return 0 }
    let node = ptr_to_node(ptr)

    // **An already-instantiated generic arrives as a mangled name, not a tree.**
    // `Box$Box$Int` is a single annotation with no children, so measuring the
    // tree alone reports depth 1 forever and the bound never fires on the one
    // case it exists for. The nesting is in the name, so the separator is what
    // counts it.
    let mut deepest = monoSeparatorCount(node.s1)

    let mut p = node.child1
    while (nodeExists(p)) {
        let depth = monoTypeDepth(p)
        if (depth > deepest) { deepest = depth }
        p = ptr_to_node(p).next
    }
    return deepest + 1
}

// Answers whether any argument is nested past the bound, and reports it once.
// Reported against the template, which is the declaration that has to change;
// the call site is wherever the recursion happened to be unrolled and is not
// where the mistake lives.
private fn monoArgsTooDeep(at: ASTNode, name: String, argsPtr: Ptr) -> Bool {
    let mut p = argsPtr
    while (nodeExists(p)) {
        if (monoTypeDepth(p) > MONO_MAX_TYPE_DEPTH) {
            semaErrorAt(at, strConcat(strConcat("instantiating ", diagQuote(name)),
                        strConcat(" does not terminate: its type argument ",
                                  strConcat(diagQuote(monoElide(monoAnnotationText(p))),
                                            " grows at every step"))))
            diag_note("a generic that instantiates itself with a larger type has no fixpoint; take the recursive argument by a type that does not grow")
            return true
        }
        p = ptr_to_node(p).next
    }
    return false
}

private fn monoSeparatorCount(name: String) -> Int {
    let separator = strCharAt(monoSeparator(), 0)
    let mut count = 0
    let mut i = 0
    let n = __builtin_string_len(name)
    while (i < n) {
        if (strCharAt(name, i) == separator) { count = count + 1 }
        i = i + 1
    }
    return count
}

// The offending type is 30 levels of mangled name by the time the bound fires,
// and printing all of it buries the sentence that explains what went wrong. The
// head is what identifies it; the tail is the same thing repeated.
private fn monoElide(text: String) -> String {
    let n = __builtin_string_len(text)
    if (n <= 48) { return strClone(text) }
    let mut head = ""
    let mut i = 0
    while (i < 48) {
        head = strConcat(head, strFromChar(strCharAt(text, i)))
        i = i + 1
    }
    return strConcat(head, "...")
}
