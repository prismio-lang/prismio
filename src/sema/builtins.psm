// The calls the compiler knows the shape of without a declaration.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string

internal fn semaBuiltinCallType(name: String, argPtr: Ptr) -> TypeInfo {
    if (name.equals("drop")) { return typeVoid() }

    // String's irreducible representation operations. These are compiler
    // builtins, not foreign functions: sema owns their signatures and codegen
    // replaces their call-shaped syntax with field/GEP operations.
    if (name.equals("__builtin_string_len")) { return typeInt() }
    if (name.equals("__builtin_string_byte_at")) { return typeChar() }
    if (name.equals("__builtin_string_put_byte")) { return typeVoid() }
    // The lowering target for `==` on String. A builtin rather than a call to
    // `strEquals`, so that the operator does not depend on a public function
    // with a prefixed name -- the prefix is implementation, not surface.
    if (name.equals("__builtin_string_eq")) { return typeBool() }
    if (name.equals("__builtin_string_inline")) { return typeString() }

    // REQUIREMENTS 4. The narrowing half. `T?` cannot be used as a `T` -- that
    // is what the type buys -- so there has to be one way across, and this is it.
    //
    // Deliberately a *checked* unwrap rather than flow narrowing. Narrowing
    // `if (x != none) { ... }` would need flow-sensitive types in sema, which is
    // a real feature and not this item; a checked unwrap costs one branch and
    // fails loudly where narrowing would have failed silently. It is also the
    // idiom the compiler already writes by hand -- `if (nodeExists(p)) { let n =
    // ptr_to_node(p) }` is exactly this shape.
    if (name.equals("expect")) {
        if (nodeExists(argPtr)) {
            let ot = nodeGetType(ptr_to_node(argPtr))
            if (ot.kind == TypeKind.OPTIONAL) { return typeOptionalInner(ot) }
        }
        return typeInvalid()
    }

    // v0.1 concurrency. The seven blocking channel operations. Their element
    // type comes from the endpoint argument, exactly as `list_get`'s comes from
    // the list -- the one exception is `chan_new`, which like `list_new` has
    // nothing to read it from and takes it from the annotation.
    if (name.equals("chan_new")) { return typeChannel(typeInvalid()) }
    if (name.equals("chan_share")) {
        if (nodeExists(argPtr)) {
            let ct = nodeGetType(ptr_to_node(argPtr))
            if (typeIsChannel(ct)) { return ct }
        }
        return typeChannel(typeInvalid())
    }
    // `T?`, and that is the whole of receive-after-close: a drained closed
    // channel answers `none`, so a receiving loop ends without a sentinel value
    // and without a second call to ask whether it should have received.
    if (name.equals("chan_recv")) {
        if (nodeExists(argPtr)) {
            let ct = nodeGetType(ptr_to_node(argPtr))
            if (typeIsChannel(ct)) { return typeOptional(typeChannelElem(ct)) }
        }
        return typeInvalid()
    }
    // 1 delivered, 0 dropped because the channel was already closed. `Int`
    // rather than `Bool` because the C returns `int` and the declaration is
    // emitted from this type; see the contract note in semaCheckBuiltinCall.
    if (name.equals("chan_send")) { return typeInt() }
    if (name.equals("chan_len")) { return typeInt() }
    if (name.equals("chan_close")) { return typeVoid() }
    if (name.equals("chan_free")) { return typeVoid() }

    if (name.equals("list_new")) { return typeList(typeInvalid()) }
    if (name.equals("list_new_with_capacity")) { return typeList(typeInvalid()) }
    if (name.equals("list_len")) { return typeInt() }
    if (name.equals("list_push")) { return typeVoid() }
    if (name.equals("list_set")) { return typeVoid() }
    if (name.equals("list_set_exclusive")) { return typeVoid() }
    if (name.equals("slice_len")) { return typeInt() }
    if (name.equals("slice_set")) { return typeVoid() }
    if (name.equals("data_len")) { return typeInt() }
    if (name.equals("soa")) {
        if (nodeExists(argPtr)) {
            let lt = nodeGetType(ptr_to_node(argPtr))
            if (lt.kind == TypeKind.LIST and nodeExists(lt.child)) {
                return typeDataView(ptr_to_type(lt.child))
            }
        }
        return typeInvalid()
    }
    if (name.equals("aos")) {
        if (nodeExists(argPtr)) {
            let vt = nodeGetType(ptr_to_node(argPtr))
            if (vt.kind == TypeKind.DATAVIEW and nodeExists(vt.child)) {
                return typeList(ptr_to_type(vt.child))
            }
        }
        return typeInvalid()
    }
    if (name.equals("list_get")) {
        if (nodeExists(argPtr)) {
            let lt = nodeGetType(ptr_to_node(argPtr))
            if (lt.kind == TypeKind.LIST and nodeExists(lt.child)) {
                return ptr_to_type(lt.child)
            }
        }
        return typeInvalid()
    }
    return typeInvalid()
}

internal fn semaCheckBuiltinCall(module: ASTNode, call: ASTNode, name: String, argPtr: Ptr) -> Bool {
    // drop(x): deterministic, safe free. Consumes (moves) an owned value, so
    // use-after-drop and double-drop are caught by move tracking.
    if (name.equals("drop")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let mut arg = ptr_to_node(argPtr)
        let mut t = semaExpr(module, arg)
        if (typeIsMoveOnly(t) == false) {
            semaErrorAt(arg, "drop requires an owned (move-only) value, found ".concat(typeDisplay(t)))
            return true
        }
        semaConsumeOperand(arg)
        return true
    }

    // REQUIREMENTS 4. The checked unwrap. Its operand is *borrowed*, not
    // consumed: `expect` reads the slot and hands back the pointer it already
    // held, so it transfers no ownership and the optional stays usable. Treating
    // it as a move would make `if (p != none) { use(expect(p)) }` fail on the
    // second visit to a loop body.
    if (name.equals("expect")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let ot = semaExpr(module, a0)
        if (ot.kind != TypeKind.OPTIONAL) {
            semaErrorAt(a0, "expect requires an optional value, found ".concat(typeDisplay(ot)))
            return true
        }
        if (nodeIsNull(ot.child)) {
            semaErrorAt(a0, "expect needs to know what it is unwrapping; `none` on its own has no type")
        }
        return true
    }

    if (name.equals("__builtin_string_len")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        semaCheckValue(module, ptr_to_node(argPtr), typeString(), "string length operand")
        return true
    }

    if (name.equals("__builtin_string_byte_at")) {
        if (semaCheckArity(call, name, argPtr, 2) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        semaCheckValue(module, a0, typeString(), "string byte operand")
        semaCheckValue(module, ptr_to_node(a0.next), typeInt(), "string byte index")
        return true
    }

    if (name.equals("__builtin_string_put_byte")) {
        if (semaCheckArity(call, name, argPtr, 3) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let a1 = ptr_to_node(a0.next)
        semaCheckValue(module, a0, typeString(), "string write operand")
        semaCheckValue(module, a1, typeInt(), "string write index")
        semaCheckValue(module, ptr_to_node(a1.next), typeChar(), "string write value")
        return true
    }

    if (name.equals("__builtin_string_eq")) {
        if (semaCheckArity(call, name, argPtr, 2) == false) { return true }
        let e0 = ptr_to_node(argPtr)
        semaCheckValue(module, e0, typeString(), "string equality operand")
        semaCheckValue(module, ptr_to_node(e0.next), typeString(), "string equality operand")
        return true
    }

    // The German-string short form: `count` bytes of the first operand from
    // `start`, held in the returned pair rather than allocated.
    //
    // **`count <= 12` is the caller's obligation and is not checked here**, for
    // the same reason `__builtin_string_byte_at` does not bound its index: the
    // one caller in std/string.psm establishes it two lines above, and a test
    // here would be a second one on the hot path of every substring. Over the
    // bound, the bytes past twelve are silently dropped -- so this is a builtin
    // for std to reach, not a spelling for a program to use.
    if (name.equals("__builtin_string_inline")) {
        if (semaCheckArity(call, name, argPtr, 3) == false) { return true }
        let i0 = ptr_to_node(argPtr)
        let i1 = ptr_to_node(i0.next)
        semaCheckValue(module, i0, typeString(), "inline string source")
        semaCheckValue(module, i1, typeInt(), "inline string start")
        semaCheckValue(module, ptr_to_node(i1.next), typeInt(), "inline string length")
        return true
    }

    if (name.equals("list_new")) {
        semaCheckArity(call, name, argPtr, 0)
        return true
    }
    // Vec::with_capacity. A hint, not a bound -- the list still doubles past it --
    // so there is nothing here for the analysis to trust and no annotation budget
    // to spend. Worth 0.926x on g2's per-frame list; see runtime/lang_runtime.c.
    if (name.equals("list_new_with_capacity")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        semaCheckValue(module, ptr_to_node(argPtr), typeInt(), "list_new_with_capacity")
        return true
    }
    if (name.equals("list_len")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let lt = semaExpr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            semaErrorAt(a0, "list_len expects a List, found ".concat(typeDisplay(lt)))
        }
        return true
    }

    // M4.3a. The conversion is deliberately explicit and consuming: after
    // `soa(rows)`, the rows live in columns and the old List handle is gone;
    // after `aos(view)`, the reverse is true. Restrict the first boundary to
    // flat structs so a byte copy never duplicates an owned pointer.
    if (name.equals("soa")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let rows = ptr_to_node(argPtr)
        let lt = semaExpr(module, rows)
        if (lt.kind != TypeKind.LIST) {
            semaErrorAt(rows, "soa expects a List, found ".concat(typeDisplay(lt)))
            return true
        }
        let elemT = semaListElementType(lt)
        if (elemT.kind != TypeKind.STRUCT) {
            semaErrorAt(rows, "soa requires a List of flat structs, found ".concat(typeDisplay(lt)))
            return true
        }
        if (structDeclIsPodIn(module, elemT.name, 0, true) == false) {
            semaErrorAt(rows, "soa requires a flat struct with no owned fields; ".concat(elemT.name,
                                                                                         " contains non-flat storage"))
            return true
        }
        semaConsumeOperand(rows)
        return true
    }

    if (name.equals("aos")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let view = ptr_to_node(argPtr)
        let vt = semaExpr(module, view)
        if (vt.kind != TypeKind.DATAVIEW) {
            semaErrorAt(view, "aos expects a DataView, found ".concat(typeDisplay(vt)))
            return true
        }
        semaConsumeOperand(view)
        return true
    }

    if (name.equals("data_len")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let view = ptr_to_node(argPtr)
        let vt = semaExpr(module, view)
        if (vt.kind != TypeKind.DATAVIEW) {
            semaErrorAt(view, "data_len expects a DataView, found ".concat(typeDisplay(vt)))
        }
        return true
    }
    if (name.equals("list_get")) {
        if (semaCheckArity(call, name, argPtr, 2) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let lt = semaExpr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            semaErrorAt(a0, "list_get expects a List, found ".concat(typeDisplay(lt)))
            return true
        }
        semaCheckValue(module, ptr_to_node(a0.next), typeInt(), "list_get index")
        // Once an element has been exposed, Prismio has no CFG lifetime with
        // which to prove that derived borrow dead. The exclusive replacement
        // capability therefore closes permanently for this binding.
        if (a0.kind == NodeKind.IDENTIFIER_EXPR) {
            ir_unmark_list_exclusive(a0.s1)
        }
        return true
    }
    // v0.1 concurrency -- the four rules this surface has to state, and where
    // each one is enforced.
    //
    // **Ownership of a sent value.** `chan_send(c, v)` moves `v` into the
    // channel: the receiving task takes it out and owns it, so the sender must
    // not name it again. Enforced by semaConsumeOperand below and by
    // aifRuntimeContract's RETAIN_IN, exactly as `list_push` is.
    //
    // **Shared endpoint lifetime.** `chan_share(c)` is the syntactically visible
    // duplication SPEC 11 item 10 requires. It returns the same endpoint, it does
    // not copy the channel, and it does not make a second owner -- only the
    // endpoint `chan_new` returned may be freed.
    //
    // **Receive after close.** `chan_recv` drains what is queued and then answers
    // `none` for ever; the `T?` return is what makes a caller handle it.
    //
    // **Destruction.** `chan_free(c)` after `chan_close(c)` and after joining
    // every task the endpoint was shared with. The join is the synchronisation
    // edge that makes the free safe, which is the same edge that keeps the
    // element counts non-atomic.
    if (name.equals("chan_new")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        semaCheckValue(module, ptr_to_node(argPtr), typeInt(), "chan_new capacity")
        return true
    }
    if (name.equals("chan_send")) {
        if (semaCheckArity(call, name, argPtr, 2) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let ct = semaExpr(module, a0)
        if (typeIsChannel(ct) == false) {
            semaErrorAt(a0, "chan_send expects a Channel, found ".concat(typeDisplay(ct)))
            return true
        }
        let valueNode = ptr_to_node(a0.next)
        semaCheckValue(module, valueNode, typeChannelElem(ct), "chan_send value")
        // A closed channel drops the message, and a dropped message is the one
        // value nothing can release -- the sender has moved it and the receiver
        // never saw it. That is why the contract is "close only after every
        // sender has been joined", and why the return is worth reading.
        semaConsumeOperand(valueNode)
        return true
    }
    if (name.equals("chan_recv")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let ct = semaExpr(module, a0)
        if (typeIsChannel(ct) == false) {
            semaErrorAt(a0, "chan_recv expects a Channel, found ".concat(typeDisplay(ct)))
        }
        return true
    }
    if (name.equals("chan_share") or name.equals("chan_close")
        or name.equals("chan_len") or name.equals("chan_free")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let ct = semaExpr(module, a0)
        if (typeIsChannel(ct) == false) {
            semaErrorAt(a0, name.concat(" expects a Channel, found ", typeDisplay(ct)))
        }
        return true
    }

    if (name.equals("list_push")) {
        if (semaCheckArity(call, name, argPtr, 2) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let lt = semaExpr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            semaErrorAt(a0, "list_push expects a List, found ".concat(typeDisplay(lt)))
            return true
        }
        let valueNode = ptr_to_node(a0.next)
        let elemT = semaListElementType(lt)
        semaCheckValue(module, valueNode, elemT, "list_push value")
        // A Slice is three words and List's non-flat fallback is one pointer per
        // element. Silently truncating the descriptor to its handle would lose
        // the range and turn a view into the whole list. Wrap it in a struct if
        // it must be stored; that representation has an address and preserves
        // E-VIEW through the field store.
        if (elemT.kind == TypeKind.SLICE) {
            semaErrorAt(valueNode, "a Slice cannot be stored directly in a List; wrap it in a struct")
        }
        if (elemT.kind == TypeKind.DATAVIEW) {
            semaErrorAt(valueNode, "a DataView cannot be stored directly in a List")
        }
        // AIF item 3. The list owns what is pushed into it and releases it at
        // teardown, so a push is an ownership transfer and has to be move-checked
        // as one. Two pushes of the same name would otherwise put one value under
        // one owner twice, which no fact can see: `list_push` is a call, and the
        // aliasing module counts *containers*, not stores into one.
        //
        // This also recovers the loop case for free -- `ir_binding_predates_loop`
        // already refuses a move that repeats on the next iteration, which is the
        // same double release written differently.
        semaConsumeOperand(ptr_to_node(a0.next))
        return true
    }
    if (name.equals("list_set")) {
        if (semaCheckArity(call, name, argPtr, 3) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let lt = semaExpr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            semaErrorAt(a0, "list_set expects a List, found ".concat(typeDisplay(lt)))
            return true
        }
        let a1 = ptr_to_node(a0.next)
        semaCheckValue(module, a1, typeInt(), "list_set index")
        let valueNode = ptr_to_node(a1.next)
        let elemT = semaListElementType(lt)
        semaCheckValue(module, valueNode, elemT, "list_set value")
        if (elemT.kind == TypeKind.SLICE) {
            semaErrorAt(valueNode, "a Slice cannot be stored directly in a List; wrap it in a struct")
        }
        if (elemT.kind == TypeKind.DATAVIEW) {
            semaErrorAt(valueNode, "a DataView cannot be stored directly in a List")
        }
        // Same transfer as list_push. What it does *not* do is release whatever
        // occupied the slot: an overwritten element leaks, and closing that needs
        // a release the container can only make if it owns the old value, which
        // is the question this level answers for teardown and not for overwrite.
        semaConsumeOperand(ptr_to_node(a1.next))
        return true
    }
    // An explicit safe escape hatch for the boxed replacement leak. Ordinary
    // list_set keeps its compatibility semantics. This operation is admitted
    // only while the first argument is the locally owned list_new binding and
    // no element, Slice, or arbitrary callee has observed it. That is Swift's
    // exclusive-access rule expressed as a small typestate fact; it does not
    // pretend Prismio already has Rust-style CFG borrow liveness.
    if (name.equals("list_set_exclusive")) {
        if (semaCheckArity(call, name, argPtr, 3) == false) { return true }
        let a0 = ptr_to_node(argPtr)
        let lt = semaExpr(module, a0)
        if (lt.kind != TypeKind.LIST) {
            semaErrorAt(a0, "list_set_exclusive expects a List, found ".concat(typeDisplay(lt)))
            return true
        }
        let a1 = ptr_to_node(a0.next)
        semaCheckValue(module, a1, typeInt(), "list_set_exclusive index")
        let valueNode = ptr_to_node(a1.next)
        let elemT = semaListElementType(lt)
        semaCheckValue(module, valueNode, elemT, "list_set_exclusive value")

        // Inline replacement overwrites the bytes a saved element address names;
        // this task is specifically the separately allocated boxed OBJECT case.
        if (elemT.kind != TypeKind.STRUCT
            or structDeclIsPodIn(module, elemT.name, 0, true)) {
            semaErrorAt(a0, "list_set_exclusive requires a boxed struct element type")
            diag_note("flat List elements are inline; use list_set for them")
        }
        if (a0.kind != NodeKind.IDENTIFIER_EXPR
            or ir_is_list_exclusive(a0.s1) == 0) {
            semaErrorAt(a0, "list_set_exclusive requires an unobserved local List")
            diag_note("create it with list_new and replace before list_get, slicing, or passing it to another function")
        }
        semaConsumeOperand(valueNode)
        return true
    }

    if (name.equals("slice_len")) {
        if (semaCheckArity(call, name, argPtr, 1) == false) { return true }
        let slice = ptr_to_node(argPtr)
        let st = semaExpr(module, slice)
        if (st.kind != TypeKind.SLICE) {
            semaErrorAt(slice, "slice_len expects a Slice, found ".concat(typeDisplay(st)))
        }
        return true
    }

    // Mutable views use an explicit operation in v0.1. Two overlapping slices
    // may both call it; the handle is resolved at each access, so list growth
    // cannot strand either one and no aliasing promise is made.
    if (name.equals("slice_set")) {
        if (semaCheckArity(call, name, argPtr, 3) == false) { return true }
        let slice = ptr_to_node(argPtr)
        let st = semaExpr(module, slice)
        if (st.kind != TypeKind.SLICE) {
            semaErrorAt(slice, "slice_set expects a Slice, found ".concat(typeDisplay(st)))
            return true
        }
        let index = ptr_to_node(slice.next)
        semaCheckValue(module, index, typeInt(), "slice_set index")
        let value = ptr_to_node(index.next)
        let elemT = semaSliceElementType(st)
        semaCheckValue(module, value, elemT, "slice_set value")
        if (elemT.kind == TypeKind.SLICE) {
            semaErrorAt(value, "a Slice cannot be stored directly through another Slice; wrap it in a struct")
        }
        semaConsumeOperand(value)
        return true
    }

    return false
}
