// Name mangling, the function symbol table, and overload resolution.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string

internal fn semaMangleType(t: TypeInfo) -> String {
    if (t.kind == TypeKind.VOID) { return "Void" }
    if (t.kind == TypeKind.INT) { return t.name }
    if (t.kind == TypeKind.FLOAT) { return "Float" }
    if (t.kind == TypeKind.BOOL) { return "Bool" }
    if (t.kind == TypeKind.CHAR) { return "Char" }
    if (t.kind == TypeKind.STRING) { return "String" }
    if (t.kind == TypeKind.PTR) { return "Ptr" }
    if (t.kind == TypeKind.STRUCT) { return strConcat("Struct_", t.name) }
    if (t.kind == TypeKind.ENUM) { return strConcat("Enum_", t.name) }
    if (t.kind == TypeKind.ARRAY) {
        if (nodeExists(t.child)) {
            return strConcat("Array_", semaMangleType(ptr_to_type(t.child)))
        }
        return "Array_Invalid"
    }
    if (t.kind == TypeKind.LIST) {
        if (nodeExists(t.child)) {
            return strConcat("List_", semaMangleType(ptr_to_type(t.child)))
        }
        return "List_Invalid"
    }
    if (t.kind == TypeKind.SLICE) {
        if (nodeExists(t.child)) {
            return strConcat("Slice_", semaMangleType(ptr_to_type(t.child)))
        }
        return "Slice_Invalid"
    }
    if (t.kind == TypeKind.DATAVIEW) {
        if (nodeExists(t.child)) {
            return strConcat("DataView_", semaMangleType(ptr_to_type(t.child)))
        }
        return "DataView_Invalid"
    }
    return "Invalid"
}

private fn semaParamSignature(module: ASTNode, paramPtr: Ptr) -> String {
    let mut sig = ""
    let mut curr = paramPtr
    while (nodeExists(curr)) {
        let mut param = ptr_to_node(curr)
        let paramT = semaAnnotationType(module, ptr_to_node(param.child1))
        if (strEquals(sig, "")) {
            sig = semaMangleType(paramT)
        } else {
            sig = strConcat(strConcat(sig, "_"), semaMangleType(paramT))
        }
        curr = param.next
    }
    if (strEquals(sig, "")) { return "Void" }
    return sig
}

internal fn semaFunctionSymbol(module: ASTNode, fnNode: ASTNode) -> String {
    if (fnNode.kind == NodeKind.EXTERN_FUNCTION) {
        return fnNode.s1
    }
    if (strEquals(fnNode.s1, "main")) {
        return "main"
    }
    return strConcat(strConcat(fnNode.s1, "__"), semaParamSignature(module, fnNode.child1))
}

// Mangles every function's symbol once and stores it on the node, so the
// duplicate-detection passes can compare strings instead of recomputing.
internal fn semaCacheFunctionSymbols(module: ASTNode) {
    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            stmt.s2 = semaFunctionSymbol(module, stmt)
        }
        stmtPtr = stmt.next
    }
}

internal fn semaSamePosition(a: ASTNode, b: ASTNode) -> Bool {
    return a.file == b.file and a.line == b.line and a.col == b.col
}

// The earliest declaration whose mangled symbol matches `fnNode`'s. Used to
// point a duplicate-definition diagnostic at the definition it collides with.
//
// Two declarations can only collide if they share a *name*, so the whole
// candidate set is one entry of the declaration index -- which is also why no
// separate count is needed. This answers `fnNode` itself when nothing collides,
// and a duplicate is reported against the later declaration, so "the first one
// is not me" is exactly the condition that used to read `count > 1`.
//
// Compares the symbol cached on each node by semaCacheFunctionSymbols() rather
// than re-mangling: mangling walks a parameter list and reads a type annotation
// per parameter, and this runs once per function.
internal fn semaFirstFunctionWithSymbol(module: ASTNode, fnNode: ASTNode) -> ASTNode {
    let name = fnNode.s1
    let symbol = fnNode.s2
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let stmt = ptr_to_node(ir_decl_at(name, i))
        if (stmt.kind == NodeKind.FUNCTION or stmt.kind == NodeKind.EXTERN_FUNCTION) {
            if (strEquals(stmt.s2, symbol)) {
                return stmt
            }
        }
        i = i + 1
    }
    return createNode(NodeKind.MODULE)
}

private fn semaArgMatchesType(module: ASTNode, argNode: ASTNode, expected: TypeInfo) -> Bool {
    if (typeIsValid(expected) and expected.kind == TypeKind.INT and semaIsIntLiteral(argNode)) {
        return true
    }
    let actual = semaExpr(module, argNode)
    return semaTypesMatch(expected, actual)
}

private fn semaSignatureMatchesCall(module: ASTNode, fnNode: ASTNode, argPtr: Ptr) -> Bool {
    let mut arg = argPtr
    let mut param = fnNode.child1
    while (nodeExists(arg) and nodeExists(param)) {
        let argNode = ptr_to_node(arg)
        let paramNode = ptr_to_node(param)
        let paramT = semaAnnotationType(module, ptr_to_node(paramNode.child1))
        if (semaArgMatchesType(module, argNode, paramT) == false) {
            return false
        }
        arg = argNode.next
        param = paramNode.next
    }
    return nodeIsNull(arg) and nodeIsNull(param)
}

// A bare integer literal has default type Int, but it is also allowed to flow
// directly into any exact integer parameter when that is the only applicable
// context (`take_u8(5)`). An overload set containing every integer width needs
// one further rule: prefer the candidate that keeps the literal's default Int
// type. Casts and typed bindings are not literals here, so they continue to
// resolve only against their exact declared type.
private fn semaDefaultLiteralScore(module: ASTNode, fnNode: ASTNode, argPtr: Ptr) -> Int {
    let mut score = 0
    let mut arg = argPtr
    let mut param = fnNode.child1
    while (nodeExists(arg) and nodeExists(param)) {
        let argNode = ptr_to_node(arg)
        let paramNode = ptr_to_node(param)
        let paramT = semaAnnotationType(module, ptr_to_node(paramNode.child1))
        if (semaIsIntLiteral(argNode) and paramT.kind == TypeKind.INT
            and strEquals(paramT.name, "Int")) {
            score = score + 1
        }
        arg = argNode.next
        param = paramNode.next
    }
    return score
}

// True when the module contains a real `fn` body for `name`, as opposed to only an
// `extern fn` declaration of it.
private fn semaHasFunctionDefinition(module: ASTNode, name: String) -> Bool {
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let scan = ptr_to_node(ir_decl_at(name, i))
        if (scan.kind == NodeKind.FUNCTION) {
            return true
        }
        i = i + 1
    }
    return false
}

// `call` is only ever used to place the diagnostic; resolution itself depends
// on nothing but the name and the argument types.

// ---------------------------------------------------------
// v0.1 3.5 -- modules
// ---------------------------------------------------------

// The name a module is qualified by: the full import path it was reached by.
// `src/lexer/token.psm` is `lexer.token`, and `std/string.psm` is `std.string`.
//
// **Recorded by the merge rather than derived from the path.** The leaf alone
// used to be enough and no longer is, for two independent reasons:
//
// Leaves collide. This tree has `src/ir/expr.psm` and `src/parse/expr.psm`, and
// `src/{ir,sema,ast}/types.psm` three ways over -- so `expr.foo(...)` was
// genuinely ambiguous and the best semaFindFunctionOverload could do was report
// it. A full path distinguishes them.
//
// And the path is not the module. `resolveImportPath` flattens the package on
// install: `std/string.psm` in a checkout ships as `stdlib/string.psm`. Deriving
// a *full* qualifier from the file would read `std.string` here and
// `stdlib.string` from an installed toolchain -- every qualified `std` call
// resolving in this tree and failing in the shipped compiler, with the whole
// suite green. Only the import statement knows the logical name, so the merge
// records it as it resolves each one.
//
// "" for the entry file, which no import ever named. That is not a qualifier a
// call can match, which is correct: nothing imports the entry.
//
// Cloned because diag_file_module is an `alias` into the registry's storage and
// this returns an owned String.
private fn semaFileQualifier(file: Int) -> String {
    return strClone(diag_file_module(file))
}

// The import path of a module whose last segment is `leaf`, or "" if none is.
//
// Asked only when a qualifier named no module, so the walk over the registry
// happens once per mistake rather than once per call -- the same budget as
// semaQualifierNamesModule, and for the same kind of reason.
//
// It exists for one specific wrong answer. A qualifier used to be the file's leaf,
// so `string.strTrim(x)` was how every program written before this spelled a
// qualified call. Without this, that program now reports "unknown identifier
// `string`" and sends its author looking for a variable they never declared.
internal fn semaModuleWithLeaf(leaf: String) -> String {
    let count = diag_file_count()
    let mut file = 0
    while (file < count) {
        let qualifier = semaFileQualifier(file)
        let dot = strLastIndexOf(qualifier, ".")
        if (dot >= 0) {
            let tail = strSubstring(qualifier, dot + 1,
                                    __builtin_string_len(qualifier) - dot - 1)
            if (strEquals(tail, leaf)) { return qualifier }
        }
        file = file + 1
    }
    return ""
}

// Whether some declaration named `name` came from a module qualified `qualifier`.
// Asked before a `q.f(x)` is read as a method call, so a module name and a value
// of the same name cannot be confused: a local is checked for first.
internal fn semaModuleDeclares(qualifier: String, name: String) -> Bool {
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (strEquals(semaFileQualifier(decl.file), qualifier)) { return true }
        i = i + 1
    }
    return false
}

// Whether any file in the registry is a module by this name.
//
// Asked only when a `q.f(...)` failed to find `f` in a module `q`, so the walk
// over the file registry -- forty entries for this compiler -- happens once per
// mistake rather than once per call. It buys the difference between "unknown
// function `nosuch`" and "module `text` declares no `nosuch`", which is the
// difference between a reader checking their spelling and a reader checking
// their imports.
internal fn semaQualifierNamesModule(qualifier: String) -> Bool {
    let count = diag_file_count()
    let mut file = 0
    while (file < count) {
        if (strEquals(semaFileQualifier(file), qualifier)) { return true }
        file = file + 1
    }
    return false
}

// The package a module belongs to: its import path without the last segment.
// `std.string` is `std`, `ir.expr` is `ir`, and a module imported by a bare name
// is "" -- the root package, which is also where the entry file sits.
private fn semaPackageOf(qualifier: String) -> String {
    let dot = strLastIndexOf(qualifier, ".")
    if (dot < 0) { return "" }
    return strSubstring(qualifier, 0, dot)
}

// v0.1 3.5. Whether this declaration is visible from `atFile`.
//
// Visibility is **opt-in**: the default is public, which is the opposite of most
// languages and the only non-breaking spelling available. Every cross-module call
// in `src/` and every `std` function is public today, so a private default would
// have made this a rename of the whole tree rather than a feature. The default can
// be flipped later with a module-level declaration; nothing here precludes it.
//
//   0  public    -- everywhere
//   1  private   -- the declaring file
//   2  internal  -- the declaring package
//
// `internal` is the level that only became expressible once qualifiers became
// import paths: "the same package" is the qualifier minus its last segment, and
// the leaf qualifier it replaced carried no package to compare.
private fn semaDeclVisibleFrom(decl: ASTNode, atFile: Int) -> Bool {
    if (decl.i2 == 0) { return true }
    if (decl.i2 == 1) { return decl.file == atFile }
    let declPackage = semaPackageOf(semaFileQualifier(decl.file))
    let atPackage = semaPackageOf(semaFileQualifier(atFile))
    return strEquals(declPackage, atPackage)
}

internal fn semaFindFunctionOverload(module: ASTNode, call: ASTNode, name: String, argPtr: Ptr) -> ASTNode {
    // Track the winner as a pointer, not an ASTNode binding: `best = stmt` would
    // move the move-only struct out of `stmt`, and the loop still needs `stmt.next`.
    let mut bestPtr: Ptr = ptr_null()
    let mut matchCount = 0
    let mut bestLiteralScore = -1
    let mut nameSeen = false
    // v0.1 3.5. Set when the call was written `module.f(...)`; empty otherwise.
    let qualifier = call.s1
    // The visibility of a declaration that matched by name but was not visible
    // here: 0 none seen, 1 private, 2 internal. Kept as the level rather than a
    // flag so the diagnostic can name the marker the author actually wrote.
    let mut hiddenLevel = 0

    // parser.psm, ir.psm and sema.psm all forward-declare their mutually recursive
    // functions with `extern fn` and then define them with `fn` in the same file.
    // Both nodes carry the same name and signature, so counting both would report
    // every such call as an ambiguous overload. Once a real definition exists the
    // extern is only its forward declaration, so skip it -- generateModule()
    // applies the same rule when deciding whether to emit a `declare`.
    let definitionExists = semaHasFunctionDefinition(module, name)

    // REQUIREMENTS 16. This used to walk every top-level declaration in the
    // module, once per call site -- the compiler's dominant cost, and quadratic.
    // The index holds the declarations carrying this name, in source order, so
    // the loop below visits the overload set and nothing else. Source order is
    // what keeps the diagnostics identical: `bestPtr` breaks a literal-score tie
    // by keeping the first candidate seen.
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let stmtPtr = ir_decl_at(name, i)
        let stmt = ptr_to_node(stmtPtr)
        let mut isCandidate = stmt.kind == NodeKind.FUNCTION
        if (stmt.kind == NodeKind.EXTERN_FUNCTION and definitionExists == false) {
            isCandidate = true
        }
        if (isCandidate and strEquals(qualifier, "") == false
            and strEquals(semaFileQualifier(stmt.file), qualifier) == false) {
            isCandidate = false
        }
        // v0.1 3.5. A `priv` declaration is invisible outside its own file. Noted
        // rather than silently skipped, so the diagnostic can say *private*
        // instead of *unknown* -- an unknown-function error for a function the
        // reader can see is the worst of both.
        if (isCandidate and semaDeclVisibleFrom(stmt, call.file) == false) {
            isCandidate = false
            hiddenLevel = stmt.i2
        }
        if (isCandidate) {
            nameSeen = true
            if (semaSignatureMatchesCall(module, stmt, argPtr)) {
                let literalScore = semaDefaultLiteralScore(module, stmt, argPtr)
                if (literalScore > bestLiteralScore) {
                    bestPtr = stmtPtr
                    bestLiteralScore = literalScore
                    matchCount = 1
                } else if (literalScore == bestLiteralScore) {
                    matchCount = matchCount + 1
                }
            }
        }
        i = i + 1
    }

    // Each of these used to fall through to the next, which was harmless only
    // because semaError exited. Now that it returns, an ambiguous call would
    // also be reported as having no matching overload and as being unknown.
    if (matchCount > 1) {
        semaErrorAt(call, strConcat(strConcat("ambiguous call to ", diagQuote(name)),
                                       ": more than one overload matches these arguments"))
        return ptr_to_node(bestPtr)
    }
    if (matchCount == 1) {
        return ptr_to_node(bestPtr)
    }
    if (nameSeen) {
        semaErrorAt(call, strConcat(strConcat("no overload of ", diagQuote(name)),
                                       " accepts these argument types"))
        return createNode(NodeKind.MODULE)
    }
    if (hiddenLevel == 1) {
        semaErrorAt(call, strConcat(diagQuote(name), " is private to the file that declares it"))
        diag_note("drop `private` from its declaration, or mark it `internal` to share it within its package")
        return createNode(NodeKind.MODULE)
    }
    if (hiddenLevel == 2) {
        semaErrorAt(call, strConcat(diagQuote(name), " is internal to the package that declares it"))
        diag_note("drop `internal` from its declaration to make it part of that package's surface")
        return createNode(NodeKind.MODULE)
    }
    if (strEquals(qualifier, "") == false) {
        semaErrorAt(call, strConcat(strConcat("module ", diagQuote(qualifier)),
                                    strConcat(" declares no ", diagQuote(name))))
        return createNode(NodeKind.MODULE)
    }
    semaErrorAt(call, strConcat("unknown function ", diagQuote(name)))
    return createNode(NodeKind.MODULE)
}

// Argument count for a builtin, counting the linked list of argument nodes.
private fn semaArgCount(argPtr: Ptr) -> Int {
    let mut count = 0
    let mut curr = argPtr
    while (nodeExists(curr)) {
        count = count + 1
        curr = ptr_to_node(curr).next
    }
    return count
}

// Reports a builtin called with the wrong number of arguments, and answers
// whether the arity was right -- so the caller can stop before walking argument
// nodes that are not there. Every one of these checks used to report and then
// dereference the missing argument anyway, which only survived because
// semaError exited the process.
internal fn semaCheckArity(call: ASTNode, name: String, argPtr: Ptr, expected: Int) -> Bool {
    let actual = semaArgCount(argPtr)
    if (actual == expected) { return true }

    let mut noun = " arguments, found "
    if (expected == 1) { noun = " argument, found " }
    semaErrorAt(call, strConcat(strConcat(diagQuote(name), " expects "),
                  strConcat(strFromInt(expected), strConcat(noun, strFromInt(actual)))))
    return false
}
