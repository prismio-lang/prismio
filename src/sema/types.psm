// Resolving type annotations, and the assignability rules between the types they
// name.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string

// ---------------------------------------------------------------------------
// AIF annotations (SPEC 5)
//
// The parser stores them on the declaration's `s2` as space-separated text --
// `unique `, `pin:T1 ` -- the same encoding the FFI contracts use, and for the
// same reason: one free slot, and an argument to carry.
// ---------------------------------------------------------------------------

private fn semaAnnotationHas(encoded: String, name: String) -> Bool {
    return encoded.contains(name.concat(" "))
}

// The `pin:` argument used to be read back out here, by a copy of the three
// lines src/aif/walk.psm uses. It is gone with the check that needed it, and
// walk.psm is the one reader now.

// **`pin`'s argument is deliberately not checked here any more, and that is the
// change rather than an omission.** This used to warn "unknown tier `X`" for any
// name outside T0..T4b, and AIF then dropped the annotation -- so every
// misspelling produced a warning nothing could act on and a build nothing could
// fail.
//
// The name is now one of two things: a tier, or the name of a `region` whose
// arena must serve the value (SPEC 5.4 applied to placement). Sema cannot tell
// them apart usefully -- a region in a *caller* is what serves a bracketed
// callee's allocation (SPEC 5.2.1.1), so the name a binding pins is routinely
// declared in another function and, with imports merged, another file. AIF has
// the whole scope table and adjudicates it there: honoured, or refuted, which
// SPEC 5.4.1 makes an error.
//
// `unique` stays here. It is an axiom about a *type*, which is exactly what this
// pass knows and AIF would have to be handed.
internal fn semaCheckAnnotations(stmt: ASTNode, varT: TypeInfo) {
    let encoded = stmt.s2
    if (encoded.equals("")) { return }

    if (semaAnnotationHas(encoded, "unique")) {
        // A Copyable value has no ownership to be unique about, so the axiom
        // asserts nothing and would silently do nothing.
        if (typeIsMoveOnly(varT) == false and typeIsValid(varT)) {
            semaWarningAt(stmt, "`unique` has no effect on ".concat(typeDisplay(varT)))
            diag_note("only owned values -- structs, strings and lists -- carry an aliasing fact")
        }
    }
}

// Both answer from the registry semaRegisterNamedTypes() fills before any
// checking runs, rather than by walking the module. The `module` parameter is
// kept so the many call sites read the same as before -- and because the
// registry is a cache of exactly what a walk of `module` would have found.
internal fn semaHasStruct(module: ASTNode, name: String) -> Bool {
    return ir_named_type_kind(name) == 1
}

internal fn semaHasEnum(module: ASTNode, name: String) -> Bool {
    return ir_named_type_kind(name) == 2
}

internal fn semaRegisterNamedTypes(module: ASTNode) {
    ir_reset_named_types()
    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        if (stmt.kind == NodeKind.STRUCT_DECL) { ir_declare_named_type(stmt.s1, 1) }
        if (stmt.kind == NodeKind.ENUM_DECL) { ir_declare_named_type(stmt.s1, 2) }
        stmtPtr = stmt.next
    }
}

// The resolved type is **stamped onto the annotation node**, and that is not
// bookkeeping: codegen's `mapTypeNode` otherwise re-derives a key from the raw
// syntax, and the two answers disagree for exactly one shape.
//
// `let b: Bag<Int> = ...` where `Bag<T>` owns a released field: sema resolves the
// annotation to the monomorphised struct `Bag$Int`, while mapTypeNode sees "a
// name with type arguments" and answers `ptr`, because that arm was written for
// `List<T>` and every user generic falls into it too. The drop kind is then taken
// from the *initialiser* (typed release) and the type name from the
// *declaration* (`ptr`), so codegen emits a call to `__aif_release_` -- a symbol
// with an empty type name that nothing defines, and the program fails to link
// with `Undefined symbols: ___aif_release_`.
//
// It reproduces on `let m: Map<Int, Int> = mapNew<Int, Int>()`, which is how the
// documentation spells it, and it predates v0.1's channels -- `build/tbaa3` fails
// the same way. `tests/test_65_map.psm` missed it by writing `let m = mapNew<...>`
// with no annotation, which is the one form that works.
internal fn semaAnnotationType(module: ASTNode, tn: ASTNode) -> TypeInfo {
    let resolved = semaAnnotationTypeOf(module, tn)
    nodeSetType(tn, resolved)
    return resolved
}

private fn semaAnnotationTypeOf(module: ASTNode, tn: ASTNode) -> TypeInfo {
    // REQUIREMENTS 4. `T?` wraps whatever the rest of the annotation says, so
    // the suffix is peeled here once rather than in each branch below.
    if (tn.i3 == 1) {
        let inner = semaAnnotationInner(module, tn)
        if (typeCanBeOptional(inner) == false) {
            if (typeIsValid(inner)) {
                semaErrorAt(tn, "only a reference can be optional, and ".concat(typeDisplay(inner),
                                                                                " is not one"))
            }
            return inner
        }
        return typeOptional(inner)
    }
    return semaAnnotationInner(module, tn)
}

private fn semaAnnotationInner(module: ASTNode, tn: ASTNode) -> TypeInfo {
    if (tn.i1 == 1) {
        // `Array<T, N>`. Where a length may be written was settled once, by
        // semaCheckArrayLengthPositions, so any path typing this meets it here.
        if (nodeExists(tn.child2)) { return semaSizedArrayType(module, tn) }
        if (nodeExists(tn.child1)) {
            return typeArray(semaAnnotationType(module, ptr_to_node(tn.child1)))
        }
        return typeArray(typeInvalid())
    }

    // A name with type arguments. `List` is still the one the compiler builds in
    // -- it has a TypeKind and a runtime -- and everything else is a generic
    // declaration, resolved by instantiating it into an ordinary struct.
    if (tn.i2 == 1) {
        if (monoArgsHoldArray(tn, tn.child1)) { return typeInvalid() }
        // REQUIREMENTS 15. `Task<R>` is built in for the same reason `List<T>`
        // is: it has a runtime and a TypeKind, so there is no struct to
        // instantiate. Without this arm it fell through to
        // monoInstantiateStruct, which found no `Task` declaration, returned
        // Invalid -- and Invalid matches everything, so a written
        // `let t: Task<Int> = spawn describe(j)` type-checked against a
        // Task<String>. A type nobody can spell is a type nobody can get wrong;
        // one that resolves to Invalid is worse than either.
        // `Ptr<T>`, `Ptr<mut T>`, `Ptr<volatile T>`: a typed pointer, docs/PTR_PLAN.md.
        // Built in like `Task<R>` and for its reason -- no struct to instantiate, and
        // falling through would resolve it to Invalid, which matches everything.
        if (tn.s1.equals("Ptr")) { return semaPtrAnnotationType(module, tn) }
        if (tn.s1.equals("Task") or tn.s1.equals("Future")) {
            if (nodeExists(tn.child1)) {
                return typeTask(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeTask(typeInvalid())
        }
        if (tn.s1.equals("List")) {
            if (nodeExists(tn.child1)) {
                return typeList(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeList(typeInvalid())
        }
        // v0.1 concurrency. Built in for the same reason `Task<R>` is: it has a
        // runtime and no struct to instantiate, and falling through to
        // monoInstantiateStruct would resolve it to Invalid -- which matches
        // everything, so a `Channel<Job>` annotation would accept a
        // `Channel<Result>`.
        //
        // **The element must be a reference**: one `void*` travels per message
        // and `chan_recv` answers its `T?` as a null pointer. A `Channel<Int>`
        // used to be accepted and sent an `i32` where the runtime reads a
        // pointer. Not "can be optional", which a scalar can since its `T?`
        // became a value -- and that is not a pointer either.
        if (tn.s1.equals("Channel")) {
            if (nodeExists(tn.child1)) {
                let elem = semaAnnotationType(module, ptr_to_node(tn.child1))
                if (typeIsValid(elem) and (typeCanBeOptional(elem) == false
                        or typeIsScalarOptionalInner(elem))) {
                    semaErrorAt(tn, "a channel carries references, and ".concat(typeDisplay(elem),
                        " is not one; send a struct with one field of it"))
                    return typeChannel(typeInvalid())
                }
                return typeChannel(elem)
            }
            return typeChannel(typeInvalid())
        }
        if (tn.s1.equals("Slice")) {
            if (nodeExists(tn.child1)) {
                return typeSlice(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeSlice(typeInvalid())
        }
        if (tn.s1.equals("DataView")) {
            if (nodeExists(tn.child1)) {
                return typeDataView(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeDataView(typeInvalid())
        }
        let instantiated = monoInstantiateStruct(module, tn)
        if (instantiated.equals("") == false) {
            semaCheckTypeVisible(tn, tn.s1)
            enumCheckTemplateVisible(module, tn)
            return typeStruct(instantiated)
        }
        return typeInvalid()
    }

    if (tn.s1.equals("Int")) { return typeInt() }
    if (tn.s1.equals("Float")) { return typeFloat() }
    if (tn.s1.equals("Bool")) { return typeBool() }
    if (tn.s1.equals("String")) { return typeString() }
    // Kept in step with typeFromAnnotation in src/ast/types.psm, which is the
    // other half of this list. That one resolves; this one resolves *and*
    // reports an unknown name, so a type added to only one of them is a type the
    // compiler understands everywhere except where a user writes it -- which is
    // exactly how `Ptr` behaved until now.
    if (tn.s1.equals("Ptr")) { return typePtr() }
    if (tn.s1.equals("Char")) { return typeChar() }
    if (tn.s1.equals("I8")) { return typeI8() }
    if (tn.s1.equals("I16")) { return typeI16() }
    if (tn.s1.equals("I64")) { return typeI64() }
    if (tn.s1.equals("Isize")) { return typeIsize() }
    if (tn.s1.equals("U8")) { return typeU8() }
    if (tn.s1.equals("U16")) { return typeU16() }
    if (tn.s1.equals("U32")) { return typeU32() }
    if (tn.s1.equals("U64")) { return typeU64() }
    if (tn.s1.equals("Usize")) { return typeUsize() }
    if (tn.s1.equals("")) { return typeVoid() }
    if (semaHasEnum(module, tn.s1)) {
        semaCheckTypeVisible(tn, tn.s1)
        return typeEnum(tn.s1)
    }
    if (semaHasStruct(module, tn.s1)) {
        semaCheckTypeVisible(tn, tn.s1)
        return typeStruct(tn.s1)
    }

    semaErrorAt(tn, "unknown type ".concat(diagQuote(tn.s1)))
    return typeInvalid()
}

// `Ptr<[mut] [volatile] T>`. The qualifiers are the parser's `$mut` / `$volatile`
// markers; what is left is exactly one type.
private fn semaPtrAnnotationType(module: ASTNode, tn: ASTNode) -> TypeInfo {
    let caps = typePtrAnnotationCapabilities(tn)
    let pointeeAt = typePtrAnnotationPointee(tn)
    if (nodeExists(pointeeAt) == false) {
        // The annotation node itself carries the report-once mark: it has no pointee to hold it.
        if (tn.s2.equals("") == false) { return typeInvalid() }
        tn.s2 = semaPtrReported()
        semaErrorAt(tn, "`Ptr<>` needs the type it points at")
        return typeInvalid()
    }
    let pointeeNode = ptr_to_node(pointeeAt)
    // An annotation is typed once per path that meets it, and a refusal is made once: `s2`
    // on the pointee is otherwise unused, and the mark says it was already said.
    let reported = pointeeNode.s2.equals("") == false
    if (nodeExists(pointeeNode.next) and reported == false) {
        semaErrorAt(ptr_to_node(pointeeNode.next), "`Ptr` points at one type")
        diag_note("a pointer to several things is `Ptr<T>` and `offset`, or a `Slice<T>`")
    }
    let pointee = semaAnnotationType(module, pointeeNode)
    let mut refused = nodeExists(pointeeNode.next)
    if (typeIsValid(pointee)) {
        let refusal = semaPtrPointeeRefusal(module, pointee)
        if (refusal.equals("") == false) {
            refused = true
            if (reported == false) {
                semaErrorAt(pointeeNode, refusal)
                diag_note("a typed pointer reads and writes plain data: numbers, `Bool`, `Char`, enums, pointers and structs of those")
            }
        }
    } else {
        refused = true
    }
    if (reported == false) { pointeeNode.s2 = semaPtrReported() }
    // An unusable pointer is an invalid type, not `Ptr<Invalid>`: Invalid is what sema
    // skips, so one refusal is one error rather than one per use.
    if (refused) { return typeInvalid() }
    return typePtrTo(pointee, (caps & 1) == 1, (caps & 2) == 2)
}

private fn semaPtrReported() -> String { return "reported" }

// Why `pointee` cannot be pointed at, or "" when it can. A typed pointer moves bytes
// in and out of memory nothing tracks, so what it points at must own nothing: a
// `String` or `Vec` stored through one would move an owner into memory no release
// will ever visit. A pointer to a pointer is fine -- a pointer owns nothing.
private fn semaPtrPointeeRefusal(module: ASTNode, pointee: TypeInfo) -> String {
    if (typeIsScalarOptionalInner(pointee) or pointee.kind == TypeKind.PTR) { return "" }
    if (pointee.kind == TypeKind.STRUCT) {
        if (semaPtrStructIsPlain(module, pointee.name, 0)) { return "" }
        return "a pointer cannot point at ".concat(diagQuote(pointee.name),
                                                   ": it holds a value that owns memory")
    }
    return "a pointer cannot point at ".concat(typeDisplay(pointee), ", which owns memory")
}

// Every field of `name` is a scalar, a pointer, an enum, or a struct that is plain
// the same way. A pointer field ends the descent -- `Ptr<Node>` inside `Node` is the
// linked list this exists for -- and the depth bound makes a mutually recursive pair
// of by-value structs somebody else's error rather than a loop here.
private fn semaPtrStructIsPlain(module: ASTNode, name: String, depth: Int) -> Bool {
    if (depth > 16) { return false }
    let decl = findStructDeclNamed(module, name)
    if (nodeExists(node_to_ptr(decl)) == false) { return false }
    let mut p = decl.child1
    while (nodeExists(p)) {
        let field = ptr_to_node(p)
        p = field.next
        if (field.kind != NodeKind.STRUCT_FIELD) { continue }
        if (nodeExists(field.child1) == false) { return false }
        let ann = ptr_to_node(field.child1)
        if (ann.i1 == 1) { return false }
        // `Ptr<T>` and `Ptr<T>?` alike: a pointer owns nothing, present or absent.
        if (ann.s1.equals("Ptr")) { continue }
        if (ann.i2 == 1 or ann.i3 == 1) { return false }
        if (semaPtrScalarName(ann.s1) or semaHasEnum(module, ann.s1)) { continue }
        if (semaHasStruct(module, ann.s1) and semaPtrStructIsPlain(module, ann.s1, depth + 1)) { continue }
        return false
    }
    return true
}

// The names `semaAnnotationInner` resolves to a scalar, spelled the way it does. Every
// one is 5 bytes or fewer, so the common miss -- a struct name -- is left by one length test.
private fn semaPtrScalarName(name: String) -> Bool {
    if (name.length > 5) { return false }
    return name.equals("Int") or name.equals("Float") or name.equals("Bool")
        or name.equals("Char") or name.equals("Ptr") or name.equals("I8")
        or name.equals("I16") or name.equals("I64") or name.equals("Isize")
        or name.equals("U8") or name.equals("U16") or name.equals("U32")
        or name.equals("U64") or name.equals("Usize")
}

// `Array<T, N>`, the length read off the annotation.
internal fn semaSizedArrayType(module: ASTNode, ann: ASTNode) -> TypeInfo {
    let mut elemT = typeInvalid()
    if (nodeExists(ann.child1)) {
        elemT = semaAnnotationType(module, ptr_to_node(ann.child1))
    }
    let length = ptr_to_node(ann.child2)
    semaResolveArrayLength(module, length)
    let count = typeIntLiteralCount(length.s1)
    // `i2` marks it reported: an annotation is typed once per path that meets it.
    if (count < 0 and length.i2 == 0) {
        length.i2 = 1
        let shown = diagQuote(length.s1)
        semaErrorAt(length, "an array's length is a positive whole number that fits `Int`, not ".concat(shown))
    }
    let arrT = typeArraySized(elemT, count)
    nodeSetType(ann, arrT)
    return arrT
}

// Whether a return annotation hands an array back by value: `-> Array<T, N>`.
internal fn semaIsSizedArrayAnnotation(ann: ASTNode) -> Bool {
    return ann.kind == NodeKind.TYPE_ANNOTATION and ann.i1 == 1 and ann.i3 == 0
        and nodeExists(ann.child2)
}

internal fn semaDeclaredReturnType(module: ASTNode, retChild: Ptr) -> TypeInfo {
    if (nodeExists(retChild)) {
        return semaAnnotationType(module, ptr_to_node(retChild))
    }
    return typeVoid()
}

internal fn semaTypesMatch(expected: TypeInfo, actual: TypeInfo) -> Bool {
    if (typeEquals(expected, actual)) { return true }
    // REQUIREMENTS 4. A present value goes into an optional slot without
    // ceremony; the reverse does not, and that asymmetry is the whole guarantee.
    // Widening is safe because the representations are identical -- a `T?` is one
    // pointer, and a present `T` is that pointer with a non-null value.
    if (expected.kind == TypeKind.OPTIONAL and actual.kind != TypeKind.OPTIONAL) {
        return semaTypesMatch(typeOptionalInner(expected), actual)
    }
    // docs/PTR_PLAN.md. `Ptr<mut T>` stands where `Ptr<T>` is wanted and either where
    // the opaque `Ptr` is; `Ptr<mut T>?` likewise reaches `Ptr<T>?`.
    if (expected.kind == TypeKind.PTR) { return typePtrConverts(expected, actual) }
    if (expected.kind == TypeKind.OPTIONAL and actual.kind == TypeKind.OPTIONAL
        and nodeExists(expected.child) and nodeExists(actual.child)) {
        return semaTypesMatch(typeOptionalInner(expected), typeOptionalInner(actual))
    }
    return false
}

internal fn semaExpectAssignable(node: ASTNode, context: String, expected: TypeInfo, actual: TypeInfo) {
    // An invalid type is the *result* of an error already reported. Checking
    // against it would blame this expression for a mistake made somewhere else,
    // which is how one real error turns into a screenful of noise now that sema
    // no longer stops at the first.
    if (typeIsValid(expected) == false or typeIsValid(actual) == false) {
        return
    }
    if (semaTypesMatch(expected, actual) == false) {
        semaTypeErrorAt(node, context, expected, actual)
    }
}

internal fn semaIsIntLiteral(e: ASTNode) -> Bool {
    return e.kind == NodeKind.LITERAL_EXPR and e.i1 == TokenType.NUMBER_LITERAL as Int
}

// Both of these ask the declaration index for the declarations carrying the
// type's name rather than walking the module, for the reason REQUIREMENTS 16
// gives: a field read is per-identifier and the walk was per-module. The inner
// loop over fields or variants is unchanged -- it is bounded by the declaration,
// not by the program.
// Whether a declaration at `level` -- 0 public, 1 the declaring file, 2 the declaring
// package -- is visible from `atFile`. The same three levels a function has.
internal fn semaVisibleFrom(level: Int, declFile: Int, atFile: Int) -> Bool {
    if (level == 0 or declFile == atFile) { return true }
    if (level == 1) { return false }
    return ir_same_package(declFile, atFile) == 1
}

// Reports a use of `what` of `owner` that `atFile` may not make, naming the level
// that stops it and what to write to widen it.
private fn semaReportHidden(at: ASTNode, what: String, owner: String, level: Int, widen: String) {
    if (level == 1) {
        semaErrorAt(at, what.concat(" of ", diagQuote(owner), " is private to the file that declares it"))
        diag_note("write `public ".concat(widen, "` to make it part of ", diagQuote(owner),
                                          "'s surface, or `internal` to share it within its package"))
        return
    }
    semaErrorAt(at, what.concat(" of ", diagQuote(owner), " is internal to the package that declares it"))
    diag_note("write `public ".concat(widen, "` to make it part of ", diagQuote(owner), "'s surface"))
}

// What a diagnostic calls a declaration of a named type. A payload enum is a struct by
// the time sema runs, and the diagnostic names the enum the author wrote.
private fn semaTypeWord(decl: ASTNode) -> String {
    if (decl.kind == NodeKind.ENUM_DECL or nodeStructIsFromEnum(decl)) { return "enum" }
    return "struct"
}

// The name the author wrote for a type: `Box` for the instantiation `Box$Int`.
private fn semaWrittenTypeName(name: String) -> String {
    let at = name.indexOf(monoSeparator())
    if (at <= 0) { return name }
    return name.substring(0, at)
}

// Whether the struct or enum `decl` may be named from `at`, reporting the use when it
// may not. `name` is the one the author wrote, which is not `decl.s1` for a generic.
internal fn semaCheckDeclVisible(at: ASTNode, decl: ASTNode, name: String) -> Bool {
    if (semaVisibleFrom(decl.i2, decl.file, at.file)) { return true }
    // A generic's body naming a program's type is the type argument arriving, which
    // was checked where the program wrote it.
    if (semaFileIsStandardLibrary(at.file) and semaFileIsStandardLibrary(decl.file) == false) { return true }
    if (decl.i2 == 1) {
        semaErrorAt(at, semaTypeWord(decl).concat(" ", diagQuote(semaWrittenTypeName(name)), " is private to the file that declares it"))
    } else {
        semaErrorAt(at, semaTypeWord(decl).concat(" ", diagQuote(semaWrittenTypeName(name)), " is internal to the package that declares it"))
    }
    diag_note("write `public ".concat(semaTypeWord(decl), " ", semaWrittenTypeName(name), "` to make it part of its module's surface"))
    return false
}

// A struct or an enum is named where `at` is: the type may be named from there only
// when its own level allows it. A variant takes its enum's level, so constructing one
// is a use of the enum's name.
internal fn semaCheckTypeVisible(at: ASTNode, name: String) {
    let count = ir_decl_count(name)
    for i in 0..<count {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (decl.kind != NodeKind.STRUCT_DECL and decl.kind != NodeKind.ENUM_DECL) { continue }
        semaCheckDeclVisible(at, decl, name)
        return
    }
}

internal fn semaFindStructFieldType(module: ASTNode, at: ASTNode, structName: String, fieldName: String) -> TypeInfo {
    let count = ir_decl_count(structName)
    for i in 0..<count {
        let stmt = ptr_to_node(ir_decl_at(structName, i))
        if (stmt.kind == NodeKind.STRUCT_DECL) {
            let mut fieldPtr = stmt.child1
            while (nodeExists(fieldPtr)) {
                let field = ptr_to_node(fieldPtr)
                if (field.s1.equals(fieldName)) {
                    // A literal's fields are reported together, once, by
                    // semaCheckStructLiteralVisible.
                    if (at.kind != NodeKind.STRUCT_FIELD and semaVisibleFrom(field.i2, stmt.file, at.file) == false) {
                        semaReportHidden(at, "field ".concat(diagQuote(fieldName)), structName, field.i2,
                                         fieldName.concat(": T"))
                    }
                    return semaAnnotationType(module, ptr_to_node(field.child1))
                }
                fieldPtr = field.next
            }
        }
    }

    semaErrorAt(at, "struct ".concat(diagQuote(structName),
                                     " has no field ",
                                     diagQuote(fieldName)))
    return typeInvalid()
}

// The same lookup as above without the diagnostic, for a caller that has another
// thing to try. `semaFindStructFieldType` reports "has no field" itself, which is
// right when a field is the only possibility and wrong once a property might be.
internal fn semaStructHasField(structName: String, fieldName: String) -> Bool {
    let count = ir_decl_count(structName)
    for i in 0..<count {
        let stmt = ptr_to_node(ir_decl_at(structName, i))
        if (stmt.kind == NodeKind.STRUCT_DECL) {
            let mut fieldPtr = stmt.child1
            while (nodeExists(fieldPtr)) {
                let field = ptr_to_node(fieldPtr)
                if (field.s1.equals(fieldName)) { return true }
                fieldPtr = field.next
            }
        }
    }
    return false
}

internal fn semaEnumHasVariant(module: ASTNode, enumName: String, variantName: String) -> Bool {
    let count = ir_decl_count(enumName)
    for i in 0..<count {
        let stmt = ptr_to_node(ir_decl_at(enumName, i))
        if (stmt.kind == NodeKind.ENUM_DECL) {
            let mut variantPtr = stmt.child1
            while (nodeExists(variantPtr)) {
                let variant = ptr_to_node(variantPtr)
                if (variant.s1.equals(variantName)) {
                    return true
                }
                variantPtr = variant.next
            }
        }
    }
    return false
}

internal fn semaListElementType(lt: TypeInfo) -> TypeInfo {
    if (lt.kind == TypeKind.LIST and nodeExists(lt.child)) {
        return ptr_to_type(lt.child)
    }
    return typeInvalid()
}

internal fn semaSliceElementType(st: TypeInfo) -> TypeInfo {
    if (st.kind == TypeKind.SLICE and nodeExists(st.child)) {
        return ptr_to_type(st.child)
    }
    return typeInvalid()
}

internal fn semaDataViewElementType(vt: TypeInfo) -> TypeInfo {
    if (vt.kind == TypeKind.DATAVIEW and nodeExists(vt.child)) {
        return ptr_to_type(vt.child)
    }
    return typeInvalid()
}

// ---------------------------------------------------------------------------
// Struct literals that leave fields out
// ---------------------------------------------------------------------------

private fn semaLiteralHasField(expr: ASTNode, name: String) -> Bool {
    let mut p = expr.child1
    while (nodeExists(p)) {
        let field = ptr_to_node(p)
        if (field.s1.equals(name)) { return true }
        p = field.next
    }
    return false
}

// The zero of a declared field's type, as an expression.
//
// An inline struct field is storage rather than a pointer, so its zero is an
// empty literal of that struct -- which semaFillOmittedFields then fills by this
// same rule, one level down. Everything pointer-shaped takes `none`, which
// codegen already lowers to `null`.
//
// **Inline is a question, not an assumption, and getting it wrong allocates
// uninitialised memory.** Answering "empty literal" for a *pointer* field emits
// a struct literal with no fields at all: codegen mallocs a node and stores
// nothing into it, not even a tag. On this host that reads as zero often enough
// to pass; on glibc and the Windows heap it is whatever was there before.
// `test_73_recursive_release` is the case -- `Tree.Leaf`'s unused `Node$0` and
// `Node$2` slots each got one of these, and `__aif_release_Tree` then walked
// into them and read garbage as child pointers. SIGSEGV on Linux,
// STATUS_HEAP_CORRUPTION on Windows, silence here.
//
// The rule is fieldTypeFor's, because that is what decides the storage: inline
// iff the annotation is POD. A self-referential type such as an enum's shadow
// struct is not, so its fields are pointers -- and the recursive fill this
// comment promises could not terminate on one anyway, which is why those
// literals stayed empty rather than being filled with zeros.
//
// Read `byDecl` rather than through the struct registry: the registry is filled
// by codegen and is empty here, so the registry reading answers POD for every
// struct-typed field during sema. `typeAnnIsPodIn` documents that
// over-approximation as the unsafe direction for exactly this kind of question.
private fn semaZeroValue(module: ASTNode, annotation: ASTNode) -> ASTNode {
    let t = semaAnnotationType(module, annotation)

    if (t.kind == TypeKind.STRUCT) {
        if (typeAnnIsPodIn(module, annotation, 0, true)) {
            let lit = createNode(NodeKind.STRUCT_LITERAL_EXPR)
            lit.s1 = t.name
            return lit
        }
        return createNode(NodeKind.NONE_LITERAL_EXPR)
    }
    if (t.kind == TypeKind.FLOAT) {
        let f = createNode(NodeKind.LITERAL_EXPR)
        f.i1 = TokenType.FLOAT_LITERAL as Int
        f.s1 = "0.0"
        return f
    }
    // Int, the sized ints, Char and Bool all store an integer zero; the width
    // comes from the field's declared type at the store, not from here.
    if (t.kind == TypeKind.INT or t.kind == TypeKind.CHAR or t.kind == TypeKind.BOOL) {
        let n = createNode(NodeKind.LITERAL_EXPR)
        n.i1 = TokenType.NUMBER_LITERAL as Int
        n.s1 = "0"
        return n
    }
    return createNode(NodeKind.NONE_LITERAL_EXPR)
}

// Appends a zero initialiser for every field the literal did not mention.
//
// **Without this, a partial struct literal reads uninitialised memory.**
// `struct P { a: Int, b: Int }` with `P { a: 1 }` type-checked, and the emitted
// IR loaded `b`'s slot with nothing ever having stored to it -- allocation is
// `malloc`, not `calloc`. It read 0 on a fresh page and would not have once the
// allocator recycled. That was true before payload enums and is fixed here for
// every struct, not just theirs.
//
// It is also what makes a payload enum's absent variant safe: `Option.None`
// mentions only the tag, and the `Some` payload slot has to be a defined value
// rather than whatever was in that memory.
//
// **Called after the provided fields are checked, never before.** The
// synthesised initialisers are deliberately not type-checked -- `none` for a
// non-optional `String` field is exactly the null a zero needs to be and is not
// something a program may write.
//
// Idempotent through `i1`, because semaExpr runs over an expression more than
// once: overload resolution types every argument of every candidate, and
// appending twice would emit two stores per slot.
// One synthesised field, **returned rather than linked in here**.
//
// The difference is not style. A node bound to a local and reached only by
// `node_to_ptr` is on that scope's drop list, so it is freed at the closing
// brace and the chain is left holding a dangling pointer -- droppability is a
// property of a *binding*, and a value returned or pushed into a nodeList is
// moved instead of dropped. This is the third bug of that exact shape in this
// session; see monoCopyOne in sema/generics.psm for the first.
private fn semaOmittedField(module: ASTNode, expr: ASTNode, field: ASTNode) -> ASTNode {
    let synth = createNode(NodeKind.STRUCT_FIELD)
    synth.s1 = field.s1
    nodeSpanFrom(synth, expr)
    synth.child1 = node_to_ptr(semaZeroValue(module, ptr_to_node(field.child1)))
    return synth
}

internal fn semaFillOmittedFields(module: ASTNode, expr: ASTNode, structName: String) {
    if (expr.i1 == 1) { return }
    expr.i1 = 1

    let decl = findStructDeclNamed(module, structName)
    if (nodeIsNull(node_to_ptr(decl))) { return }

    let additions = nodeList()
    let mut declField = decl.child1
    while (nodeExists(declField)) {
        let field = ptr_to_node(declField)
        // An array field has no zero to write as an expression, and needs none:
        // codegen zeroes every one before the literal's initializers run
        // (generateStructLiteralFields). A `none` here was copied from null.
        let arrayField = nodeExists(field.child1)
            and semaIsSizedArrayAnnotation(ptr_to_node(field.child1))
        if (arrayField == false and semaLiteralHasField(expr, field.s1) == false) {
            nodeListPush(additions, semaOmittedField(module, expr, field))
        }
        declField = field.next
    }

    if (nodeIsNull(additions.head)) { return }
    if (nodeIsNull(expr.child1)) {
        expr.child1 = additions.head
        return
    }

    let mut tail = expr.child1
    loop {
        let node = ptr_to_node(tail)
        if (nodeIsNull(node.next)) {
            node.next = additions.head
            return
        }
        tail = node.next
    }
}

// A struct literal sets every field -- the ones written, and the ones left to their
// defaults -- so it is written only where all of them are visible, and the struct
// itself too. A struct with a hidden field is built by a function its own file
// provides.
internal fn semaCheckStructLiteralVisible(literal: ASTNode) {
    let name = literal.s1
    let count = ir_decl_count(name)
    for i in 0..<count {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (decl.kind != NodeKind.STRUCT_DECL) { continue }
        // A payload enum's variant is built as a literal of its tagged struct, and the
        // enum was checked where the variant was named, under the name written there.
        if (nodeStructIsFromEnum(decl) == false) { semaCheckDeclVisible(literal, decl, name) }
        let mut hidden = ""
        let mut fieldPtr = decl.child1
        while (nodeExists(fieldPtr)) {
            let field = ptr_to_node(fieldPtr)
            if (semaVisibleFrom(field.i2, decl.file, literal.file) == false) {
                if (hidden.equals("") == false) { hidden = hidden.concat(", ") }
                hidden = hidden.concat(diagQuote(field.s1))
            }
            fieldPtr = field.next
        }
        if (hidden.equals("") == false) {
            semaErrorAt(literal, "a struct literal of ".concat(diagQuote(name), " sets fields not visible here: ", hidden))
            diag_note("build it with a function the declaring file provides, or make the fields `public`")
        }
        return
    }
}
