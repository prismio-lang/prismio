// Resolving type annotations, and the assignability rules between the types they
// name.

import ast.nodes
import lexer.token
import ast.types
import ir.bridge
import common.diagnostics
import std.string

// ---------------------------------------------------------------------------
// AIF annotations (SPEC 5)
//
// The parser stores them on the declaration's `s2` as space-separated text --
// `unique `, `pin:T1 ` -- the same encoding the FFI contracts use, and for the
// same reason: one free slot, and an argument to carry.
// ---------------------------------------------------------------------------

private fn semaAnnotationHas(encoded: String, name: String) -> Bool {
    return strContains(encoded, strConcat(name, " "))
}

// The `pin:` argument used to be read back out here, by a copy of the three
// lines src/aif/walk.psm uses. It is gone with the check that needed it, and
// walk.psm is the one reader now.

// **`pin`'s argument is deliberately not checked here any more, and that is the
// change rather than an omission.** This used to warn "unknown tier `X`" for any
// name outside T0..T4b, and AIF then dropped the annotation -- so every
// misspelling produced a warning nothing could act on and a build nothing could
// fail.
//
// The name is now one of two things: a tier, or the name of a `region` whose
// arena must serve the value (SPEC 5.4 applied to placement). Sema cannot tell
// them apart usefully -- a region in a *caller* is what serves a bracketed
// callee's allocation (SPEC 5.2.1.1), so the name a binding pins is routinely
// declared in another function and, with imports merged, another file. AIF has
// the whole scope table and adjudicates it there: honoured, or refuted, which
// SPEC 5.4.1 makes an error.
//
// `unique` stays here. It is an axiom about a *type*, which is exactly what this
// pass knows and AIF would have to be handed.
internal fn semaCheckAnnotations(stmt: ASTNode, varT: TypeInfo) {
    let encoded = stmt.s2
    if (strEquals(encoded, "")) { return }

    if (semaAnnotationHas(encoded, "unique")) {
        // A Copyable value has no ownership to be unique about, so the axiom
        // asserts nothing and would silently do nothing.
        if (typeIsMoveOnly(varT) == false and typeIsValid(varT)) {
            semaWarningAt(stmt, strConcat("`unique` has no effect on ", typeDisplay(varT)))
            diag_note("only owned values -- structs, strings and lists -- carry an aliasing fact")
        }
    }
}

// Both answer from the registry semaRegisterNamedTypes() fills before any
// checking runs, rather than by walking the module. The `module` parameter is
// kept so the many call sites read the same as before -- and because the
// registry is a cache of exactly what a walk of `module` would have found.
internal fn semaHasStruct(module: ASTNode, name: String) -> Bool {
    return ir_named_type_kind(name) == 1
}

internal fn semaHasEnum(module: ASTNode, name: String) -> Bool {
    return ir_named_type_kind(name) == 2
}

internal fn semaRegisterNamedTypes(module: ASTNode) {
    ir_reset_named_types()
    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        if (stmt.kind == NodeKind.STRUCT_DECL) { ir_declare_named_type(stmt.s1, 1) }
        if (stmt.kind == NodeKind.ENUM_DECL) { ir_declare_named_type(stmt.s1, 2) }
        stmtPtr = stmt.next
    }
}

internal fn semaAnnotationType(module: ASTNode, tn: ASTNode) -> TypeInfo {
    // REQUIREMENTS 4. `T?` wraps whatever the rest of the annotation says, so
    // the suffix is peeled here once rather than in each branch below.
    if (tn.i3 == 1) {
        let inner = semaAnnotationInner(module, tn)
        if (typeCanBeOptional(inner) == false) {
            if (typeIsValid(inner)) {
                semaErrorAt(tn, strConcat(strConcat("only a reference can be optional, and ",
                                                        typeDisplay(inner)),
                                             " is not one"))
            }
            return inner
        }
        return typeOptional(inner)
    }
    return semaAnnotationInner(module, tn)
}

private fn semaAnnotationInner(module: ASTNode, tn: ASTNode) -> TypeInfo {
    if (tn.i1 == 1) {
        if (nodeExists(tn.child1)) {
            return typeArray(semaAnnotationType(module, ptr_to_node(tn.child1)))
        }
        return typeArray(typeInvalid())
    }

    // A name with type arguments. `List` is still the one the compiler builds in
    // -- it has a TypeKind and a runtime -- and everything else is a generic
    // declaration, resolved by instantiating it into an ordinary struct.
    if (tn.i2 == 1) {
        // REQUIREMENTS 15. `Task<R>` is built in for the same reason `List<T>`
        // is: it has a runtime and a TypeKind, so there is no struct to
        // instantiate. Without this arm it fell through to
        // monoInstantiateStruct, which found no `Task` declaration, returned
        // Invalid -- and Invalid matches everything, so a written
        // `let t: Task<Int> = spawn describe(j)` type-checked against a
        // Task<String>. A type nobody can spell is a type nobody can get wrong;
        // one that resolves to Invalid is worse than either.
        if (strEquals(tn.s1, "Task")) {
            if (nodeExists(tn.child1)) {
                return typeTask(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeTask(typeInvalid())
        }
        if (strEquals(tn.s1, "List")) {
            if (nodeExists(tn.child1)) {
                return typeList(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeList(typeInvalid())
        }
        if (strEquals(tn.s1, "Slice")) {
            if (nodeExists(tn.child1)) {
                return typeSlice(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeSlice(typeInvalid())
        }
        if (strEquals(tn.s1, "DataView")) {
            if (nodeExists(tn.child1)) {
                return typeDataView(semaAnnotationType(module, ptr_to_node(tn.child1)))
            }
            return typeDataView(typeInvalid())
        }
        let instantiated = monoInstantiateStruct(module, tn)
        if (strEquals(instantiated, "") == false) { return typeStruct(instantiated) }
        return typeInvalid()
    }

    if (strEquals(tn.s1, "Int")) { return typeInt() }
    if (strEquals(tn.s1, "Float")) { return typeFloat() }
    if (strEquals(tn.s1, "Bool")) { return typeBool() }
    if (strEquals(tn.s1, "String")) { return typeString() }
    // Kept in step with typeFromAnnotation in src/ast/types.psm, which is the
    // other half of this list. That one resolves; this one resolves *and*
    // reports an unknown name, so a type added to only one of them is a type the
    // compiler understands everywhere except where a user writes it -- which is
    // exactly how `Ptr` behaved until now.
    if (strEquals(tn.s1, "Ptr")) { return typePtr() }
    if (strEquals(tn.s1, "Char")) { return typeChar() }
    if (strEquals(tn.s1, "I8")) { return typeI8() }
    if (strEquals(tn.s1, "I16")) { return typeI16() }
    if (strEquals(tn.s1, "I64")) { return typeI64() }
    if (strEquals(tn.s1, "Isize")) { return typeIsize() }
    if (strEquals(tn.s1, "U8")) { return typeU8() }
    if (strEquals(tn.s1, "U16")) { return typeU16() }
    if (strEquals(tn.s1, "U32")) { return typeU32() }
    if (strEquals(tn.s1, "U64")) { return typeU64() }
    if (strEquals(tn.s1, "Usize")) { return typeUsize() }
    if (strEquals(tn.s1, "")) { return typeVoid() }
    if (semaHasEnum(module, tn.s1)) { return typeEnum(tn.s1) }
    if (semaHasStruct(module, tn.s1)) { return typeStruct(tn.s1) }

    semaErrorAt(tn, strConcat("unknown type ", diagQuote(tn.s1)))
    return typeInvalid()
}

internal fn semaDeclaredReturnType(module: ASTNode, retChild: Ptr) -> TypeInfo {
    if (nodeExists(retChild)) {
        return semaAnnotationType(module, ptr_to_node(retChild))
    }
    return typeVoid()
}

// Enum values are i32-backed (see typeEnum in types.psm), and an enum variant
// expression such as `TokenType.EOF` types as plain Int (see MEMBER_ACCESS_EXPR in
// semaExpr). So an enum-typed binding compared against one of its own variants
// reads as Enum-vs-Int here, and the compiler's own AST does the mirror image:
// it stores kinds in plain Int fields (ASTNode.i1) and compares them to variants.
// Both directions are the intended, pervasive spelling, so treat Enum and Int as
// interchangeable. Only the default 32-bit `Int` qualifies — a sized integer such
// as I64 still has to match exactly.
private fn semaEnumMatchesInt(a: TypeInfo, b: TypeInfo) -> Bool {
    if (a.kind != TypeKind.ENUM) { return false }
    if (b.kind != TypeKind.INT) { return false }
    return strEquals(b.name, "Int")
}

internal fn semaTypesMatch(expected: TypeInfo, actual: TypeInfo) -> Bool {
    if (typeEquals(expected, actual)) { return true }
    if (semaEnumMatchesInt(expected, actual)) { return true }
    if (semaEnumMatchesInt(actual, expected)) { return true }
    // REQUIREMENTS 4. A present value goes into an optional slot without
    // ceremony; the reverse does not, and that asymmetry is the whole guarantee.
    // Widening is safe because the representations are identical -- a `T?` is one
    // pointer, and a present `T` is that pointer with a non-null value.
    if (expected.kind == TypeKind.OPTIONAL and actual.kind != TypeKind.OPTIONAL) {
        return semaTypesMatch(typeOptionalInner(expected), actual)
    }
    return false
}

internal fn semaExpectAssignable(node: ASTNode, context: String, expected: TypeInfo, actual: TypeInfo) {
    // An invalid type is the *result* of an error already reported. Checking
    // against it would blame this expression for a mistake made somewhere else,
    // which is how one real error turns into a screenful of noise now that sema
    // no longer stops at the first.
    if (typeIsValid(expected) == false or typeIsValid(actual) == false) {
        return
    }
    if (semaTypesMatch(expected, actual) == false) {
        semaTypeErrorAt(node, context, expected, actual)
    }
}

internal fn semaIsIntLiteral(e: ASTNode) -> Bool {
    return e.kind == NodeKind.LITERAL_EXPR and e.i1 == TokenType.NUMBER_LITERAL
}

// Both of these ask the declaration index for the declarations carrying the
// type's name rather than walking the module, for the reason REQUIREMENTS 16
// gives: a field read is per-identifier and the walk was per-module. The inner
// loop over fields or variants is unchanged -- it is bounded by the declaration,
// not by the program.
internal fn semaFindStructFieldType(module: ASTNode, at: ASTNode, structName: String, fieldName: String) -> TypeInfo {
    let count = ir_decl_count(structName)
    let mut i = 0
    while (i < count) {
        let stmt = ptr_to_node(ir_decl_at(structName, i))
        if (stmt.kind == NodeKind.STRUCT_DECL) {
            let mut fieldPtr = stmt.child1
            while (nodeExists(fieldPtr)) {
                let field = ptr_to_node(fieldPtr)
                if (strEquals(field.s1, fieldName)) {
                    return semaAnnotationType(module, ptr_to_node(field.child1))
                }
                fieldPtr = field.next
            }
        }
        i = i + 1
    }

    semaErrorAt(at, strConcat(strConcat("struct ", diagQuote(structName)),
                                 strConcat(" has no field ", diagQuote(fieldName))))
    return typeInvalid()
}

internal fn semaEnumHasVariant(module: ASTNode, enumName: String, variantName: String) -> Bool {
    let count = ir_decl_count(enumName)
    let mut i = 0
    while (i < count) {
        let stmt = ptr_to_node(ir_decl_at(enumName, i))
        if (stmt.kind == NodeKind.ENUM_DECL) {
            let mut variantPtr = stmt.child1
            while (nodeExists(variantPtr)) {
                let variant = ptr_to_node(variantPtr)
                if (strEquals(variant.s1, variantName)) {
                    return true
                }
                variantPtr = variant.next
            }
        }
        i = i + 1
    }
    return false
}

internal fn semaListElementType(lt: TypeInfo) -> TypeInfo {
    if (lt.kind == TypeKind.LIST and nodeExists(lt.child)) {
        return ptr_to_type(lt.child)
    }
    return typeInvalid()
}

internal fn semaSliceElementType(st: TypeInfo) -> TypeInfo {
    if (st.kind == TypeKind.SLICE and nodeExists(st.child)) {
        return ptr_to_type(st.child)
    }
    return typeInvalid()
}

internal fn semaDataViewElementType(vt: TypeInfo) -> TypeInfo {
    if (vt.kind == TypeKind.DATAVIEW and nodeExists(vt.child)) {
        return ptr_to_type(vt.child)
    }
    return typeInvalid()
}

// ---------------------------------------------------------------------------
// Struct literals that leave fields out
// ---------------------------------------------------------------------------

private fn semaLiteralHasField(expr: ASTNode, name: String) -> Bool {
    let mut p = expr.child1
    while (nodeExists(p)) {
        let field = ptr_to_node(p)
        if (strEquals(field.s1, name)) { return true }
        p = field.next
    }
    return false
}

// The zero of a declared field's type, as an expression.
//
// An inline struct field is storage rather than a pointer, so its zero is an
// empty literal of that struct -- which semaFillOmittedFields then fills by this
// same rule, one level down. Everything pointer-shaped takes `none`, which
// codegen already lowers to `null`.
//
// **Inline is a question, not an assumption, and getting it wrong allocates
// uninitialised memory.** Answering "empty literal" for a *pointer* field emits
// a struct literal with no fields at all: codegen mallocs a node and stores
// nothing into it, not even a tag. On this host that reads as zero often enough
// to pass; on glibc and the Windows heap it is whatever was there before.
// `test_73_recursive_release` is the case -- `Tree.Leaf`'s unused `Node$0` and
// `Node$2` slots each got one of these, and `__aif_release_Tree` then walked
// into them and read garbage as child pointers. SIGSEGV on Linux,
// STATUS_HEAP_CORRUPTION on Windows, silence here.
//
// The rule is fieldTypeFor's, because that is what decides the storage: inline
// iff the annotation is POD. A self-referential type such as an enum's shadow
// struct is not, so its fields are pointers -- and the recursive fill this
// comment promises could not terminate on one anyway, which is why those
// literals stayed empty rather than being filled with zeros.
//
// Read `byDecl` rather than through the struct registry: the registry is filled
// by codegen and is empty here, so the registry reading answers POD for every
// struct-typed field during sema. `typeAnnIsPodIn` documents that
// over-approximation as the unsafe direction for exactly this kind of question.
private fn semaZeroValue(module: ASTNode, annotation: ASTNode) -> ASTNode {
    let t = semaAnnotationType(module, annotation)

    if (t.kind == TypeKind.STRUCT) {
        if (typeAnnIsPodIn(module, annotation, 0, true)) {
            let lit = createNode(NodeKind.STRUCT_LITERAL_EXPR)
            lit.s1 = t.name
            return lit
        }
        return createNode(NodeKind.NONE_LITERAL_EXPR)
    }
    if (t.kind == TypeKind.FLOAT) {
        let f = createNode(NodeKind.LITERAL_EXPR)
        f.i1 = TokenType.FLOAT_LITERAL
        f.s1 = "0.0"
        return f
    }
    // Int, the sized ints, Char and Bool all store an integer zero; the width
    // comes from the field's declared type at the store, not from here.
    if (t.kind == TypeKind.INT or t.kind == TypeKind.CHAR or t.kind == TypeKind.BOOL) {
        let n = createNode(NodeKind.LITERAL_EXPR)
        n.i1 = TokenType.NUMBER_LITERAL
        n.s1 = "0"
        return n
    }
    return createNode(NodeKind.NONE_LITERAL_EXPR)
}

// Appends a zero initialiser for every field the literal did not mention.
//
// **Without this, a partial struct literal reads uninitialised memory.**
// `struct P { a: Int, b: Int }` with `P { a: 1 }` type-checked, and the emitted
// IR loaded `b`'s slot with nothing ever having stored to it -- allocation is
// `malloc`, not `calloc`. It read 0 on a fresh page and would not have once the
// allocator recycled. That was true before payload enums and is fixed here for
// every struct, not just theirs.
//
// It is also what makes a payload enum's absent variant safe: `Option.None`
// mentions only the tag, and the `Some` payload slot has to be a defined value
// rather than whatever was in that memory.
//
// **Called after the provided fields are checked, never before.** The
// synthesised initialisers are deliberately not type-checked -- `none` for a
// non-optional `String` field is exactly the null a zero needs to be and is not
// something a program may write.
//
// Idempotent through `i1`, because semaExpr runs over an expression more than
// once: overload resolution types every argument of every candidate, and
// appending twice would emit two stores per slot.
// One synthesised field, **returned rather than linked in here**.
//
// The difference is not style. A node bound to a local and reached only by
// `node_to_ptr` is on that scope's drop list, so it is freed at the closing
// brace and the chain is left holding a dangling pointer -- droppability is a
// property of a *binding*, and a value returned or pushed into a nodeList is
// moved instead of dropped. This is the third bug of that exact shape in this
// session; see monoCopyOne in sema/generics.psm for the first.
private fn semaOmittedField(module: ASTNode, expr: ASTNode, field: ASTNode) -> ASTNode {
    let synth = createNode(NodeKind.STRUCT_FIELD)
    synth.s1 = field.s1
    nodeSpanFrom(synth, expr)
    synth.child1 = node_to_ptr(semaZeroValue(module, ptr_to_node(field.child1)))
    return synth
}

internal fn semaFillOmittedFields(module: ASTNode, expr: ASTNode, structName: String) {
    if (expr.i1 == 1) { return }
    expr.i1 = 1

    let decl = findStructDeclNamed(module, structName)
    if (nodeIsNull(node_to_ptr(decl))) { return }

    let additions = nodeList()
    let mut declField = decl.child1
    while (nodeExists(declField)) {
        let field = ptr_to_node(declField)
        if (semaLiteralHasField(expr, field.s1) == false) {
            nodeListPush(additions, semaOmittedField(module, expr, field))
        }
        declField = field.next
    }

    if (nodeIsNull(additions.head)) { return }
    if (nodeIsNull(expr.child1)) {
        expr.child1 = additions.head
        return
    }

    let mut tail = expr.child1
    loop {
        let node = ptr_to_node(tail)
        if (nodeIsNull(node.next)) {
            node.next = additions.head
            return
        }
        tail = node.next
    }
}
