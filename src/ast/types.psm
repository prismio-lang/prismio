import ast.nodes
import ast.int_width
import ast.float_width
import ir.bridge
import common.text
import common.target
import std.string
import std.option

// As with NodeKind (ast.psm), **nothing may take ordinal 0**: a TypeInfo is
// punned as a String and `kind` is its first field, so a zero-valued kind makes
// a live TypeInfo read as an empty slot. `INVALID` at ordinal 0 used to make
// nodeHasType answer false for a node that did carry a type. That happened to
// cancel out -- nodeGetType returns typeInvalid() either way -- which is
// exactly why it survived.
public enum TypeKind {
    // Not a type. Keeps every real kind's low byte non-zero.
    NEVER_ZERO,

    INVALID,
    VOID,
    INT,
    FLOAT,
    BOOL,
    CHAR,
    STRING,
    PTR,
    STRUCT,
    ENUM,
    ARRAY,
    LIST,
    FUNCTION,

    // REQUIREMENTS 4. A reference that may be absent. Appended rather than
    // inserted: TypeKind's ordinals are load-bearing (see NEVER_ZERO above and
    // test_41), so adding in the middle would renumber every kind after it.
    OPTIONAL,

    // M4.1. Appended so the established ordinals above remain stable. A slice
    // is a copyable `(List handle, offset, length)` value and owns none of the
    // list storage it names; E-VIEW keeps that storage alive.
    SLICE,

    // M4.3. Appended for the same ordinal-stability reason as Slice. A
    // DataView owns a columnar allocation produced at an explicit `soa`
    // boundary and is consumed by `aos` (or released at scope exit).
    DATAVIEW,

    // M4.3b. The transient `(DataView handle, index)` produced by indexing a
    // DataView. It is intentionally not a source-spellable type: the descriptor
    // is useful only for projecting fields while the borrowed view is alive.
    // Appended because the ordinals above are load-bearing.
    DATAELEMENT
}

public struct TypeInfo {
    public kind: TypeKind,
    public name: String,
    llvm: String,
    public child: Ptr,
    public next: Ptr,
    // An array's element count, when the type knows it: from a literal, or
    // written as `Array<T, N>`. 0 is "not known" -- a `[T]` parameter, which
    // takes any length, and everything bound from one. A known length is what
    // lets a binding copy the array rather than alias it (COLLECTIONS step 3).
    public length: Int
}

// The identity on a pointer, like ptr_to_node -- see ast.psm for why declaring
// it matters.
public extern fn ptr_to_type(ptr: Ptr) -> TypeInfo alias
public extern fn type_to_ptr(t: TypeInfo borrow) -> Ptr alias

private fn typeMake(kind: TypeKind, name: String, llvm: String) -> TypeInfo {
    return TypeInfo {
        kind: kind,
        name: name,
        llvm: llvm,
        child: ptr_null(),
        next: ptr_null(),
        length: 0
    }
}

// Structs are move-only, so binding one TypeInfo to another name (`a = b`) transfers
// ownership and makes the original unusable. A TypeInfo is a descriptor, not an owned
// resource: where the intent is "these two names describe the same type", take an
// independent copy instead of aliasing.
public fn typeCopy(t: TypeInfo) -> TypeInfo {
    let dup = typeMake(t.kind, t.name, t.llvm)
    dup.child = t.child
    dup.next = t.next
    dup.length = t.length
    return dup
}

public fn typeInvalid() -> TypeInfo { return typeMake(TypeKind.INVALID, "Invalid", "") }
public fn typeVoid() -> TypeInfo { return typeMake(TypeKind.VOID, "Void", "void") }
public fn typeInt() -> TypeInfo { return typeMake(TypeKind.INT, "Int", "i32") }
public fn typeFloat() -> TypeInfo { return typeMake(TypeKind.FLOAT, "Float", "double") }
// `F16`, `F32`, `F64`, `F128`, `BF16` (ast/float_width.psm). `F64` is `Float`, so a
// name that is not one of the five answers Invalid, as typeIntFromName does.
public fn typeFloatFromName(name: String) -> TypeInfo {
    let key = floatKeyOfName(name)
    if (key.equals("")) { return typeInvalid() }
    return typeMake(TypeKind.FLOAT, floatNameOfKey(key), key)
}

public fn typeFloatFromKey(key: String) -> TypeInfo {
    if (floatKeyValid(key) == false) { return typeInvalid() }
    return typeMake(TypeKind.FLOAT, floatNameOfKey(key), key)
}

public fn typeBool() -> TypeInfo { return typeMake(TypeKind.BOOL, "Bool", "i1") }
public fn typeChar() -> TypeInfo { return typeMake(TypeKind.CHAR, "Char", "i8") }
public fn typeString() -> TypeInfo { return typeMake(TypeKind.STRING, "String", "ptr") }
public fn typePtr() -> TypeInfo { return typeMake(TypeKind.PTR, "Ptr", "ptr") }

// Sized integers. `Int` is the 32-bit signed default. Unsigned names start with "U".
//
// usize/isize are pointer-width, and that width comes from the target record --
// **not** a constant. sema and codegen have to give the same answer here: src/ir
// lowers Isize through the same call, and if this said i64 while codegen emitted
// i32, `value as I64` in std/io would be a no-op cast (equal keys) and the
// verifier would see a 32-bit value passed to a 64-bit parameter. That is the
// whole reason `--target wasm32-unknown-unknown` used to build nothing at all.
public fn typeI8() -> TypeInfo { return typeMake(TypeKind.INT, "I8", "i8") }
public fn typeI16() -> TypeInfo { return typeMake(TypeKind.INT, "I16", "i16") }
public fn typeI64() -> TypeInfo { return typeMake(TypeKind.INT, "I64", "i64") }
public fn typeIsize() -> TypeInfo { return typeMake(TypeKind.INT, "Isize", targetPtrIntType(targetCurrent())) }
public fn typeU8() -> TypeInfo { return typeMake(TypeKind.INT, "U8", "i8") }
public fn typeU16() -> TypeInfo { return typeMake(TypeKind.INT, "U16", "i16") }
public fn typeU32() -> TypeInfo { return typeMake(TypeKind.INT, "U32", "i32") }
public fn typeU64() -> TypeInfo { return typeMake(TypeKind.INT, "U64", "i64") }
public fn typeUsize() -> TypeInfo { return typeMake(TypeKind.INT, "Usize", targetPtrIntType(targetCurrent())) }

// `Int<N>` and `UInt<N>`. A width with a named spelling is that type exactly
// (ast/int_width.psm), so `Int<16>` and `I16` share a name, a key and every
// overload; the rest are `Int$24` / `UInt$24` over LLVM's `i24`.
public fn typeIntN(bits: Int, unsigned: Bool) -> TypeInfo {
    return typeMake(TypeKind.INT, intWidthName(bits, unsigned), "i".concat(bits.toString()))
}

// The integer type a name spells, or Invalid when it spells none: the named
// widths, and `Int$N` / `UInt$N`. One answer for the annotation, sem-key and
// IR-name tables, which used to each carry their own list.
public fn typeIntFromName(name: String) -> TypeInfo {
    if (name.equals("Int")) { return typeInt() }
    if (name.equals("I8")) { return typeI8() }
    if (name.equals("I16")) { return typeI16() }
    if (name.equals("I64")) { return typeI64() }
    if (name.equals("Isize")) { return typeIsize() }
    if (name.equals("U8")) { return typeU8() }
    if (name.equals("U16")) { return typeU16() }
    if (name.equals("U32")) { return typeU32() }
    if (name.equals("U64")) { return typeU64() }
    if (name.equals("Usize")) { return typeUsize() }
    let bits = intWidthOfName(name)
    if (intWidthValid(bits)) { return typeIntN(bits, name.startsWith("U")) }
    return typeInvalid()
}

// Bit width of an integer type, from its LLVM spelling. Casting needs it to
// choose between truncation and extension.
public fn typeIntBits(t: TypeInfo) -> Int {
    if (t.llvm.equals("i1")) { return 1 }
    if (t.llvm.equals("i8")) { return 8 }
    if (t.llvm.equals("i16")) { return 16 }
    if (t.llvm.equals("i32")) { return 32 }
    if (t.llvm.equals("i64")) { return 64 }
    // `Int<24>`: the digits after the `i`.
    if (t.kind == TypeKind.INT and t.llvm.startsWith("i")) {
        let parsed = t.llvm.substring(1, t.llvm.length - 1).parseInt()
        if (parsed != none) { return expect(parsed) }
    }
    return 0
}

// 2^k, for the integer-literal range check. Written as a loop because there is
// no shift operator and 2^64 is not a literal any type here can hold; callers
// asking for 64 are the ones that name the boundary themselves.
private fn typeTwoToThe(k: Int) -> U64 {
    let mut power = 1 as U64
    repeat(k) {
        power = power * (2 as U64)
    }
    return power
}

// Whether a decimal integer literal's text names a value this type can hold.
//
// **A literal that does not fit used to wrap in silence.** `4294967296 as U64`
// was 0, because the literal typed as `Int` -- i32 -- and the cast widened what
// was left after it wrapped; `let small: U8 = 999` stored 231 for the same
// reason. Both are a program saying one number and running another, with no
// diagnostic anywhere, which is the class of defect `strParseInt` returning
// `None` on overflow exists to remove. The same rule belongs at compile time.
//
// The magnitude goes through `strParseU64`, so a literal too long for any 64-bit
// type is caught by the parse rather than by arithmetic that would itself wrap.
// The asymmetric negative bound is deliberate: two's complement reaches one
// further down than up, so `-2147483648` fits `Int` and `2147483648` does not.
public fn typeIntLiteralFits(text: String, t: TypeInfo) -> Bool {
    let bits = typeIntBits(t)
    if (bits == 0) { return true }
    // A bare `i1` is the Bool a comparison produces; only a *written* one-bit
    // integer, `Int<1>` / `UInt<1>`, has a range to check.
    if (bits == 1 and t.name.contains("$") == false) { return true }

    let negative = text.startsWith("-")
    let unsigned = typeIntIsUnsigned(t)
    if (negative and unsigned) { return false }
    if (bits > 64) { return typeIntLiteralFitsWide(text, bits, unsigned, negative) }

    let mut at = 0
    if (negative or text.startsWith("+")) { at = 1 }

    let parsed = typeIntLiteralMagnitude(text, at)
    if (parsed == none) { return false }
    let magnitude = expect(parsed)

    if (unsigned) {
        if (bits == 64) { return true }
        return magnitude < typeTwoToThe(bits)
    }
    if (negative) { return magnitude <= typeTwoToThe(bits - 1) }
    return magnitude < typeTwoToThe(bits - 1)
}

// A literal for a type wider than any machine integer the compiler parses into.
// Same prefixes as typeIntLiteralMagnitude, handed to ast/int_width.psm as digits.
private fn typeIntLiteralFitsWide(text: String, bits: Int, unsigned: Bool, negative: Bool) -> Bool {
    let mut start = 0
    if (negative or text.startsWith("+")) { start = 1 }
    let mut radix = 10
    if (text.byteAt(start) == 48 and text.length > start + 1) {
        let marker = text.byteAt(start + 1)
        if (marker == 120 or marker == 88) { radix = 16 }
        if (marker == 111 or marker == 79) { radix = 8 }
        if (marker == 98 or marker == 66) { radix = 2 }
        if (radix != 10) { start = start + 2 }
    }
    let digits = text.substring(start, text.length - start)
    return intLiteralFitsWide(digits, radix, bits, unsigned, negative)
}

// The digits from `at` on, as a magnitude. `0xFF`, `0o755`, `0b1010`: the
// literal keeps the spelling it was written with, so this reads the base off the
// prefix exactly as the backend does -- and a leading zero is not octal in
// either place.
public fn typeIntLiteralMagnitude(text: String, at: Int) -> U64? {
    let mut start = at
    let mut radix = 10
    if (text.byteAt(start) == 48 and text.length > start + 1) {
        let marker = text.byteAt(start + 1)
        if (marker == 120 or marker == 88) { radix = 16 }
        if (marker == 111 or marker == 79) { radix = 8 }
        if (marker == 98 or marker == 66) { radix = 2 }
        if (radix != 10) { start = start + 2 }
    }
    let digits = text.substring(start, text.length - start)
    return digits.parseU64(radix)
}

// A length written in a type -- `Array<U8, 0x100>` -- as a count: the literal's
// value when it is a positive number that fits `Int`, and -1 otherwise, so one
// comparison tells the caller whether to report it.
public fn typeIntLiteralCount(text: String) -> Int {
    if (text.startsWith("-") or text.startsWith("+")) { return -1 }
    if (typeIntLiteralFits(text, typeInt()) == false) { return -1 }
    let parsed = typeIntLiteralMagnitude(text, 0)
    if (parsed == none) { return -1 }
    let count = expect(parsed) as Int
    if (count < 1) { return -1 }
    return count
}

// An integer literal's value when it is non-negative and below 2^62, and -1
// otherwise: wide enough for constant arithmetic on lengths, narrow enough that a
// sum or a product of two of them cannot overflow an I64.
public fn typeIntLiteralValue(text: String) -> I64 {
    if (text.startsWith("-") or text.startsWith("+")) { return -1 as I64 }
    let parsed = typeIntLiteralMagnitude(text, 0)
    if (parsed == none) { return -1 as I64 }
    let magnitude = expect(parsed)
    if (magnitude > 4611686018427387903) { return -1 as I64 }
    return magnitude as I64
}

// Whether any integer type could hold this literal. The question `semaExpr` can
// answer about a literal before anything has told it what type it is.
//
// A 64-bit type holds nearly every literal, so that is asked first and cheaply. One
// that does not fit `I64` / `U64` is not rejected: `Int<128>` holds it, and which
// type a literal has is for the context to say -- semaCheckLiteralRange reports it
// against the type it ends up with. It is rejected here only when not even the
// widest `Int<N>` could hold it.
public fn typeIntLiteralFitsAnyInt(text: String) -> Bool {
    let negative = text.startsWith("-")
    if (negative and typeIntLiteralFits(text, typeI64())) { return true }
    if (negative == false and typeIntLiteralFits(text, typeU64())) { return true }
    return typeIntLiteralFitsWide(text, intWidthMax(), negative == false, negative)
}

public fn typeIntIsUnsigned(t: TypeInfo) -> Bool {
    if (t.kind != TypeKind.INT) { return false }
    return t.name.startsWith("U")
}

// Move-only types are owned, heap-backed values that transfer ownership on use.
// Scalars/enums are Copyable (bit-copied) and never move.
//
// AIF Level 4. Strings and lists join structs here, which is what gives the
// memory model a single owner for the values that make up most of a real
// program's allocation traffic -- aif_frees_at_scope_node asks the same question
// through site_is_move_only, so a T1 string now has a free point.
//
// Arrays deliberately do not. An array literal lowers to ir_array_alloca, which
// is frame storage: there is no allocation to own, nothing for a drop to
// reclaim, and `drop(arr)` would hand a stack pointer to the deallocator.
// Making them affine would buy the aliasing rule and cost that hazard.
public fn typeIsMoveOnly(t: TypeInfo) -> Bool {
    match (t.kind) {
        TypeKind.STRUCT => { return true }
        TypeKind.STRING => { return true }
    // REQUIREMENTS 4. `T?` owns whatever `T` owns; being absent is a state of
    // the slot, not a different kind of ownership.
        TypeKind.OPTIONAL => {
            if (nodeExists(t.child)) { return typeIsMoveOnly(ptr_to_type(t.child)) }
            return false
        }
    }
    return t.kind == TypeKind.LIST or t.kind == TypeKind.DATAVIEW
}

public fn typeStruct(name: String) -> TypeInfo {
    return typeMake(TypeKind.STRUCT, name, "ptr")
}

// ---------------------------------------------------------------------------
// REQUIREMENTS 4 -- optional references
//
// **`none` is a null pointer, and that choice is the whole of the punned-slot
// question.** This compiler already has a way to spell "this slot is empty": a
// pointer to the empty string, tested with `p.equals("")`. That encoding
// reads the *first byte of the pointed-to struct*, so a live value whose first
// field is zero is byte-for-byte an empty slot -- which is why NodeKind and
// TypeKind both reserve ordinal 0, why the layout search pins field 0, and what
// test_41 characterises.
//
// A null pointer dereferences nothing. `x == none` is `icmp eq ptr %x, null`,
// which reads no byte of any object, so **no live value can collide with it
// whatever its first field holds**. Reusing the `""` convention would have
// inherited the collision and spread it from the compiler's own punned pointers
// to every user program; a distinct null is immune by construction.
//
// The cost is that both encodings now exist. They do not meet: `""` is the
// compiler's internal idiom on `String`-punned node pointers, `none` is the
// language's, and nothing converts between them.
// ---------------------------------------------------------------------------

// The type of a bare `none`: optional, with no inner type to speak of. Its empty
// `child` is what makes typeEquals match it against any `T?`, which is how the
// literal reaches a typed slot without an inference pass to give it one.
public fn typeNone() -> TypeInfo { return typeMake(TypeKind.OPTIONAL, "none", "ptr") }

public fn typeOptional(inner: TypeInfo) -> TypeInfo {
    let mut key = "ptr"
    if (typeIsScalarOptionalInner(inner)) { key = "opt:".concat(typeIrKey(inner)) }
    let t = typeMake(TypeKind.OPTIONAL, inner.name.concat("?"), key)
    t.child = type_to_ptr(inner)
    return t
}

// REQUIREMENTS 15. A task handle, carrying the type its `join` yields.
//
// PTR-kinded rather than a TypeKind of its own, and that is a considered choice
// rather than a shortcut: the handle *is* an opaque word, every switch in sema,
// AIF and codegen already has a PTR arm that treats it correctly, and a new
// kind would have to be added to all of them to arrive at the same behaviour.
// What the name and the `child` add is the one thing a bare `Ptr` could not
// carry -- what comes back out of the join.
//
// `Future<R>` is the same type, spelled for async/await: a call to an `async fn` is
// a task that has not started, and `await` runs it. It was named `Task<R>` until
// that spelling stopped being what a reader meets first, so the display name is
// `Future<R>` and both are accepted where a type is written.
public fn typeTask(result: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.PTR, "Future<".concat(result.name, ">"), "ptr")
    t.child = type_to_ptr(result)
    return t
}

public fn typeIsTask(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.PTR and t.name.startsWith("Future<")
}

public fn typeTaskResult(t: TypeInfo) -> TypeInfo {
    if (typeIsTask(t) and nodeExists(t.child)) { return ptr_to_type(t.child) }
    return typeInvalid()
}

// v0.1 concurrency. A blocking typed channel endpoint, carrying the type its
// `chan_recv` yields.
//
// PTR-kinded and named, for exactly the reason `typeTask` above is: the endpoint
// is an opaque word the runtime allocated, every PTR arm in sema, AIF and codegen
// already handles it correctly, and a TypeKind of its own would have to be added
// to all of them to arrive at the same behaviour. The name and the `child` carry
// the one thing a bare `Ptr` cannot -- what may be sent through it and what comes
// back out.
//
// **The element type must be reference-shaped.** The runtime moves one `void*`
// per message and `chan_recv` answers `T?`, which REQUIREMENTS 4 defines only for
// a reference. `Channel<Int>` is refused in sema rather than boxed silently.
public fn typeChannel(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.PTR, "Channel<".concat(elem.name, ">"), "ptr")
    t.child = type_to_ptr(elem)
    return t
}

public fn typeIsChannel(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.PTR and t.name.startsWith("Channel<")
}

public fn typeChannelElem(t: TypeInfo) -> TypeInfo {
    if (typeIsChannel(t) and nodeExists(t.child)) { return ptr_to_type(t.child) }
    return typeInvalid()
}

// A typed pointer, `Ptr<T>`, and the capabilities written in front of `T`:
// `Ptr<mut T>` may write, `Ptr<volatile T>` makes every access volatile.
// PTR_PLAN (removed; git history).
//
// PTR-kinded and named, for the reason `typeTask` and `typeChannel` are: it is one
// machine word the program does not own, so every PTR arm in sema, AIF and codegen
// already treats it correctly. A bare `Ptr` is the same family with an opaque,
// zero-sized pointee -- no `child`, nothing to read through.
//
// The capabilities ride in `length`, which a PTR has no other use for, so the
// struct keeps its layout: bit 0 is `mut`, bit 1 is `volatile`.
private fn typePtrToCapabilities(pointee: TypeInfo, caps: Int) -> TypeInfo {
    let mut t = typeMake(TypeKind.PTR,
                         "Ptr<".concat(typePtrQualifierText(caps), pointee.name, ">"), "ptr")
    t.child = type_to_ptr(pointee)
    t.length = caps
    return t
}

// What is written between `<` and the pointee, so a diagnostic shows the type as the
// program spelled it. One table lookup, not a concat per bit.
private fn typePtrQualifierText(caps: Int) -> String {
    match (caps) {
        1 => { return "mut " }
        2 => { return "volatile " }
        3 => { return "mut volatile " }
    }
    return ""
}

public fn typePtrTo(pointee: TypeInfo, writable: Bool, volatile: Bool) -> TypeInfo {
    if (writable) {
        if (volatile) { return typePtrToCapabilities(pointee, 3) }
        return typePtrToCapabilities(pointee, 1)
    }
    if (volatile) { return typePtrToCapabilities(pointee, 2) }
    return typePtrToCapabilities(pointee, 0)
}

public fn typeIsTypedPtr(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.PTR and t.name.startsWith("Ptr<")
}

public fn typePtrPointee(t: TypeInfo) -> TypeInfo {
    if (typeIsTypedPtr(t) and nodeExists(t.child)) { return ptr_to_type(t.child) }
    return typeInvalid()
}

public fn typePtrIsMut(t: TypeInfo) -> Bool {
    return typeIsTypedPtr(t) and (t.length & 1) == 1
}

public fn typePtrIsVolatile(t: TypeInfo) -> Bool {
    return typeIsTypedPtr(t) and (t.length & 2) == 2
}

// The same pointer without its write capability: what `Ptr<mut T>` converts to.
public fn typePtrReadOnly(t: TypeInfo) -> TypeInfo {
    return typePtrTo(typePtrPointee(t), false, typePtrIsVolatile(t))
}

// Whether a pointer of type `actual` may stand where `expected` is wanted, the one
// asymmetric rule `typeEquals` cannot say. `Ptr<mut T>` becomes `Ptr<T>` and either
// becomes the opaque `Ptr`; the other directions are refused -- gaining write access
// or a type needs an explicit `Ptr<T>.cast`, and `volatile` is never added or dropped
// silently, because a volatile access that quietly stops being one is the bug the
// qualifier exists to prevent.
public fn typePtrConverts(expected: TypeInfo, actual: TypeInfo) -> Bool {
    if (actual.kind != TypeKind.PTR or expected.kind != TypeKind.PTR) { return false }
    if (typeIsTypedPtr(expected) == false) {
        // The opaque pointer takes a typed one that may write, and only that one: foreign
        // code handed an opaque `Ptr` may write through it, so a read-only `Ptr<T>` that
        // became one would lose the capability its `readonly` parameter promises LLVM.
        // Nor a volatile one: `Ptr<T>.cast` of the opaque pointer would hand back a plain
        // pointer to a device register, whose accesses LLVM may merge or drop. Another
        // named handle is not a Ptr.
        return expected.name.equals("Ptr") and typePtrIsMut(actual) and typePtrIsVolatile(actual) == false
    }
    if (typeIsTypedPtr(actual) == false) { return false }
    if (typePtrIsVolatile(expected) != typePtrIsVolatile(actual)) { return false }
    if (typePtrIsMut(expected) and typePtrIsMut(actual) == false) { return false }
    return typeEquals(typePtrPointee(expected), typePtrPointee(actual))
}

public fn typeOptionalInner(t: TypeInfo) -> TypeInfo {
    if (t.kind == TypeKind.OPTIONAL and nodeExists(t.child)) {
        return ptr_to_type(t.child)
    }
    return typeInvalid()
}

// A reference is absent as a null pointer. A scalar has no spare representation
// -- 0 is a perfectly good Int -- so its `T?` is a second word beside it: a
// present flag and the value, `{ i1, T }` by value (typeIsValueOptional).
public fn typeCanBeOptional(t: TypeInfo) -> Bool {
    match (t.kind) {
        TypeKind.STRUCT => { return true }
        TypeKind.STRING => { return true }
        TypeKind.LIST => { return true }
    }
    if (typeIsScalarOptionalInner(t)) { return true }
    return t.kind == TypeKind.PTR
}

// The types whose `T?` is a value rather than a nullable pointer: a number,
// `Bool`, `Char` or an enum without payloads. Such a `T?` owns nothing, copies
// like its `T`, and costs no allocation -- which is what `Option<T>`, a boxed
// payload enum, cannot say.
public fn typeIsScalarOptionalInner(t: TypeInfo) -> Bool {
    let k = t.kind
    return k == TypeKind.INT or k == TypeKind.FLOAT or k == TypeKind.BOOL
        or k == TypeKind.CHAR or k == TypeKind.ENUM
}

public fn typeIsValueOptional(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.OPTIONAL and nodeExists(t.child)
        and typeIsScalarOptionalInner(ptr_to_type(t.child))
}

public fn typeEnum(name: String) -> TypeInfo {
    let key = ir_enum_repr_key(name)
    if (key.equals("")) { return typeMake(TypeKind.ENUM, name, "i32") }
    return typeMake(TypeKind.ENUM, name, key.clone())
}

// Whether the enum states a representation or discriminants, and so holds the
// values it was given instead of its variants' positions.
public fn typeEnumIsNumbered(t: TypeInfo) -> Bool {
    return ir_enum_repr_key(t.name).equals("") == false
}

// The integer type an enum is stored as: `U8` for `enum E: U8`, `Int` for an enum
// that states none. A conversion to or from an enum is a conversion of this type,
// which is what decides between sign and zero extension.
public fn typeEnumRepr(t: TypeInfo) -> TypeInfo {
    return typeIntN(typeIntBits(t), ir_enum_repr_unsigned(t.name) == 1)
}

public fn typeArray(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.ARRAY, "Array", "ptr")
    t.child = type_to_ptr(elem)
    return t
}

// Whether a value of this type owns nothing: a number, `Bool`, `Char`, `Ptr` or
// an enum without payloads. What an array element has to be for three things
// that copy or overwrite its bytes with no release: a store through the
// element's address, a zero-filled `Array<T, N>`, and a copied array.
public fn typeOwnsNothing(t: TypeInfo) -> Bool {
    let k = t.kind
    return k == TypeKind.INT or k == TypeKind.FLOAT or k == TypeKind.BOOL
        or k == TypeKind.CHAR or k == TypeKind.PTR or k == TypeKind.ENUM
        or typeIsValueOptional(t)
}

// Whether binding or assigning this array copies its elements: its length is
// known and they own nothing. Anything else is a view -- a `[T]` parameter, and
// what is bound from one -- or holds owners, which a byte copy would duplicate.
// Sema checks against it and codegen emits the copy from it, so the two agree.
public fn typeArrayCopies(t: TypeInfo) -> Bool {
    if (t.kind != TypeKind.ARRAY or t.length <= 0 or nodeExists(t.child) == false) { return false }
    return typeOwnsNothing(ptr_to_type(t.child))
}

// `Array<T, N>`, the length known. See `length` on TypeInfo.
public fn typeArraySized(elem: TypeInfo, length: Int) -> TypeInfo {
    let mut t = typeArray(elem)
    t.length = length
    return t
}

public fn typeList(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.LIST, "List", "ptr")
    t.child = type_to_ptr(elem)
    return t
}

public fn typeSlice(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.SLICE, "Slice", "struct:prismio.slice")
    t.child = type_to_ptr(elem)
    return t
}

// A Slice that views something its holder may not change. Kept in `length`,
// which only an array reads, so the mark reaches no key, no equality test and
// no IR: `Slice<Int>` read-only and changeable are one type that differs only
// in what a store through it is allowed to do. It lives on an expression's type;
// a binding keeps its own flag (ir_mark_readonly_view), because a binding's type
// travels as a semantic key that has no room for it.
public fn typeSliceReadOnly(elem: TypeInfo) -> TypeInfo {
    let mut t = typeSlice(elem)
    t.length = 1
    return t
}

public fn typeSliceIsReadOnly(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.SLICE and t.length == 1
}

public fn typeDataView(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.DATAVIEW, "DataView", "ptr")
    t.child = type_to_ptr(elem)
    return t
}

public fn typeDataElement(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.DATAELEMENT, "DataElement", "struct:prismio.data_element")
    t.child = type_to_ptr(elem)
    return t
}

public fn typeIsValid(t: TypeInfo) -> Bool {
    return t.kind != TypeKind.INVALID
}

// How a type is written, for a person reading a diagnostic. The vector type is
// `Vec`, which is what a program spells.
public fn typeDisplay(t: TypeInfo) -> String {
    return typeInstancesAsWritten(typeSpelling(t, "Vec"))
}

// A generic instance is named `Option$Struct_Point` or `Map$String$Int` inside the
// compiler: the template, then each type argument after a `$`, with a `Struct_` or
// `Enum_` prefix on a user's type. Prose writes it the way the program did --
// `Option<Point>`, `Map<String, Int>`. Anything without a `$` is left alone, and so
// is a key, which is why this is applied to the display spelling only.
private fn typeInstancesAsWritten(spelled: String) -> String {
    if (spelled.contains("$") == false) { return spelled }
    let mut out = ""
    let mut word = ""
    let n = spelled.length
    for i in 0..<n {
        let c = spelled.charAt(i)
        if (isIdentPart(c) or c == '$') {
            word = word.concat(c.toString())
        } else {
            out = out.concat(typeInstanceWord(word), c.toString())
            word = ""
        }
    }
    return out.concat(typeInstanceWord(word))
}

private fn typeInstanceWord(word: String) -> String {
    if (word.contains("$") == false) { return word }
    let parts = word.split('$')
    let mut out = parts[0].concat("<")
    for i in 1..<parts.length {
        if (i > 1) { out = out.concat(", ") }
        let arg = parts[i]
        if (arg.startsWith("Struct_")) { out = out.concat(arg.substring(7, arg.length - 7)) }
        else if (arg.startsWith("Enum_")) { out = out.concat(arg.substring(5, arg.length - 5)) }
        else { out = out.concat(arg) }
    }
    return out.concat(">")
}

// The same spelling under the compiler's own name for the vector type, `List`.
// This is a key rather than prose: AIF's site types, the AST dump the oracle
// reads, and impl targets all compare against it, and none of them may move when
// only the surface name does. See docs/COLLECTIONS.md.
public fn typeKeyName(t: TypeInfo) -> String {
    return typeSpelling(t, "List")
}

// A key back as a person writes it, for a report that has only the key: AIF's
// site types are strings by the time they are printed, and `List<Int>` is a
// spelling the parser now refuses. Only a `List<` that starts a name moves, so
// `FreeList<Int>` stays what it is -- and so does `ÄList<Int>`: a byte past ASCII
// before it is part of a name, since only an identifier puts one there.
public fn typeKeyDisplay(key: String) -> String {
    let mut out = ""
    let mut from = 0
    let mut at = key.indexOf("List<", 0)
    while (at >= 0) {
        if (at == 0 or typeKeyNameEndsAt(key, at) == false) {
            out = out.concat(key.slice(from, at), "Vec<")
            from = at + 5
        }
        at = key.indexOf("List<", at + 5)
    }
    return out.concat(key.slice(from, key.length))
}

private fn typeKeyNameEndsAt(key: String, at: Int) -> Bool {
    let before = key.charAt(at - 1)
    return isIdentPart(before) or charCode(before) >= 128
}

private fn typeSpelling(t: TypeInfo, vecName: String) -> String {
    match (t.kind) {
        TypeKind.STRUCT => {
            // A trait object is a synthesised struct named `dyn$Show`, and `$` cannot
            // occur in a source identifier -- so printing the internal name shows the
            // reader a type they did not write and cannot spell.
            if (t.name.startsWith("dyn$")) {
                return "dyn ".concat(t.name.substring(4, t.name.length - 4))
            }
            return t.name
        }
        TypeKind.ENUM => { return t.name }
        TypeKind.ARRAY => {
            if (nodeExists(t.child)) {
                return "[".concat(typeSpelling(ptr_to_type(t.child), vecName), "]")
            }
            return "[Invalid]"
        }
        TypeKind.LIST => {
            if (nodeExists(t.child)) {
                return vecName.concat("<", typeSpelling(ptr_to_type(t.child), vecName), ">")
            }
            return vecName.clone()
        }
        TypeKind.SLICE => {
            if (nodeExists(t.child)) {
                return "Slice<".concat(typeSpelling(ptr_to_type(t.child), vecName), ">")
            }
            return "Slice"
        }
        TypeKind.DATAVIEW => {
            if (nodeExists(t.child)) {
                return "DataView<".concat(typeSpelling(ptr_to_type(t.child), vecName), ">")
            }
            return "DataView"
        }
        TypeKind.DATAELEMENT => {
            if (nodeExists(t.child)) {
                return "DataElement<".concat(typeSpelling(ptr_to_type(t.child), vecName), ">")
            }
            return "DataElement"
        }
        TypeKind.OPTIONAL => {
            if (nodeExists(t.child)) {
                return typeSpelling(ptr_to_type(t.child), vecName).concat("?")
            }
            return "none"
        }
    }
    return t.name
}

public fn typeEquals(a: TypeInfo, b: TypeInfo) -> Bool {
    if (a.kind != b.kind) { return false }
    if (a.kind == TypeKind.STRUCT or a.kind == TypeKind.ENUM) {
        return a.name.equals(b.name)
    }
    match (a.kind) {
        TypeKind.INT => {
            return a.name.equals(b.name)
        }
        TypeKind.FLOAT => {
            return a.name.equals(b.name)
        }
        TypeKind.ARRAY => {
            if (nodeIsNull(a.child) or nodeIsNull(b.child)) {
                // Element types agree only when *both* are absent. Compared as
                // strings this was a strcmp of two machine pointers.
                return nodeIsNull(a.child) and nodeIsNull(b.child)
            }
            return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
        }
        TypeKind.LIST => {
            // A list with an unknown element type (from list_new()) matches any list.
            if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
            let ac = ptr_to_type(a.child)
            let bc = ptr_to_type(b.child)
            if (typeIsValid(ac) == false or typeIsValid(bc) == false) { return true }
            return typeEquals(ac, bc)
        }
        TypeKind.SLICE => {
            if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return false }
            return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
        }
        TypeKind.DATAVIEW => {
            if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return false }
            return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
        }
        TypeKind.DATAELEMENT => {
            if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return false }
            return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
        }
    }
    // A typed pointer is the same type as another only when it points at the same
    // thing with the same capabilities; the one-way conversions (`mut` dropped, a type
    // forgotten) are `typePtrConverts`, which `semaTypesMatch` adds. Without this arm
    // `Ptr<Header>` and `Ptr<Node>` would meet at PTR's unconditional `true`.
    if (a.kind == TypeKind.PTR and (typeIsTypedPtr(a) or typeIsTypedPtr(b))) {
        if (typeIsTypedPtr(a) == false or typeIsTypedPtr(b) == false) { return false }
        if (a.length != b.length) { return false }
        return typeEquals(typePtrPointee(a), typePtrPointee(b))
    }
    // Two task handles are the same type only when they yield the same thing.
    // Without this they would fall through to PTR's unconditional `true` and
    // `let t: Task<Int> = spawn make_report(j)` would typecheck.
    if (typeIsTask(a) or typeIsTask(b)) {
        if (typeIsTask(a) == false or typeIsTask(b) == false) { return false }
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    // Same rule, same reason: two endpoints are the same type only when they
    // carry the same message. Without this `let c: Channel<Job> = chan_new(4)`
    // would accept a `Channel<Result>` through PTR's unconditional `true`.
    if (typeIsChannel(a) or typeIsChannel(b)) {
        if (typeIsChannel(a) == false or typeIsChannel(b) == false) { return false }
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        let ac = ptr_to_type(a.child)
        let bc = ptr_to_type(b.child)
        // `chan_new` has nothing to read an element type from, so it answers
        // `Channel<Invalid>` and the annotation supplies it -- the same shape
        // `list_new` uses, and the reason this is not the Task clause verbatim.
        if (typeIsValid(ac) == false or typeIsValid(bc) == false) { return true }
        return typeEquals(ac, bc)
    }
    if (a.kind == TypeKind.OPTIONAL) {
        // A bare `none` carries no inner type, so it matches any optional. That
        // is what lets `none` be written wherever a `T?` is wanted without an
        // inference pass to give it one.
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    return true
}

// A number wider than the 64 bits a container slot or an inline row carries:
// `Int<128>`, `UInt<65>`, `F128`. Fine as a local, a parameter, a return, a field and
// an array element; a `Vec` of them would need rows wider than any it has.
public fn typeIsWideScalar(t: TypeInfo) -> Bool {
    if (typeIsValueOptional(t)) { return typeIsWideScalar(ptr_to_type(t.child)) }
    if (t.kind == TypeKind.INT) { return typeIntBits(t) > 64 }
    if (t.kind == TypeKind.FLOAT) { return floatBitsOfKey(t.llvm) > 64 }
    return false
}

public fn typeIsNumeric(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.INT or t.kind == TypeKind.FLOAT
}

public fn typeIrKey(t: TypeInfo) -> String {
    match (t.kind) {
        TypeKind.VOID => { return "void" }
        TypeKind.INT => { return t.llvm }
        TypeKind.FLOAT => { return t.llvm }
        TypeKind.BOOL => { return "i1" }
        TypeKind.CHAR => { return "i8" }
    // The fat String. Kept in step with `mapType` in src/ir/types.psm, which is
    // the same mapping reached from a type *name* rather than a TypeInfo -- two
    // functions answering one question, and a String that is a struct in one and
    // a pointer in the other is a call that disagrees with its own declaration.
        TypeKind.STRING => { return "struct:prismio.str" }
        TypeKind.PTR => { return "ptr" }
        TypeKind.ENUM => { return t.llvm }
        TypeKind.STRUCT => { return "struct:".concat(t.name) }
        TypeKind.LIST => { return "ptr" }
        TypeKind.SLICE => { return "struct:prismio.slice" }
        TypeKind.DATAVIEW => { return "ptr" }
        TypeKind.DATAELEMENT => { return "struct:prismio.data_element" }
    }
    // A scalar's `T?` is `{ i1 present, T value }`, by value.
    if (typeIsValueOptional(t)) { return "opt:".concat(typeIrKey(ptr_to_type(t.child))) }
    // REQUIREMENTS 4. A reference's `T?` is one pointer, absent or not.
    // Deliberately *not* `struct:T` even when the inner is a struct: the storage
    // is the same, but an lvalue of this type must never reach
    // ir_struct_field_ptr without an unwrap, and keeping the key opaque is what
    // makes that a type error rather than a null dereference.
    if (t.kind == TypeKind.OPTIONAL) { return "ptr" }
    if (t.kind == TypeKind.ARRAY) {
        if (nodeExists(t.child)) {
            let elem = ptr_to_type(t.child)
            if (elem.kind == TypeKind.ARRAY) { return "ptrptr" }
        }
        return "ptr"
    }
    return ""
}

public fn typeSemKey(t: TypeInfo) -> String {
    match (t.kind) {
        TypeKind.VOID => { return "Void" }
        TypeKind.INT => { return t.name }
        TypeKind.FLOAT => { return t.name }
        TypeKind.BOOL => { return "Bool" }
        TypeKind.CHAR => { return "Char" }
        TypeKind.STRING => { return "String" }
    // A task's result type has to survive a binding, which is what a sem key is
    // for. Writing "Ptr" here would lose it and `let t = spawn f(x)` would come
    // back as a bare handle -- the same round-trip hole REQUIREMENTS 4's
    // optionals fell into, which is why this case was written with its decoder.
        TypeKind.PTR => {
            if (typeIsTask(t) and nodeExists(t.child)) {
                return "task:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            // Same hole, same fix: a channel endpoint that came back as a bare `Ptr`
            // would make `chan_send(c, v)` report "expects a Channel, found Ptr" one
            // statement after the binding that gave it its type.
            if (typeIsChannel(t) and nodeExists(t.child)) {
                return "chan:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            // `ptr:<capabilities>:<pointee>`, so a typed pointer survives a binding
            // with its pointee and its `mut`/`volatile` rather than coming back opaque.
            if (typeIsTypedPtr(t) and nodeExists(t.child)) {
                return "ptr:".concat(t.length.toString(), ":", typeSemKey(ptr_to_type(t.child)))
            }
            return "Ptr"
        }
        TypeKind.STRUCT => { return "struct:".concat(t.name) }
        TypeKind.ENUM => { return "enum:".concat(t.name) }
        TypeKind.ARRAY => {
            let mut head = "array:"
            if (t.length > 0) { head = "array#".concat(t.length.toString(), ":") }
            if (nodeExists(t.child)) {
                return head.concat(typeSemKey(ptr_to_type(t.child)))
            }
            return head.concat("Invalid")
        }
        TypeKind.LIST => {
            if (nodeExists(t.child)) {
                return "list:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            return "list:Invalid"
        }
        TypeKind.SLICE => {
            if (nodeExists(t.child)) {
                return "slice:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            return "slice:Invalid"
        }
        TypeKind.DATAVIEW => {
            if (nodeExists(t.child)) {
                return "view:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            return "view:Invalid"
        }
        TypeKind.DATAELEMENT => {
            if (nodeExists(t.child)) {
                return "dataelem:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            return "dataelem:Invalid"
        }
        TypeKind.OPTIONAL => {
            if (nodeExists(t.child)) {
                return "opt:".concat(typeSemKey(ptr_to_type(t.child)))
            }
            return "opt:Invalid"
        }
    }
    return "Invalid"
}

private fn typeStorageKey(t: TypeInfo) -> String {
    let key = typeIrKey(t)
    if (key.equals("ptrptr")) { return "ptr" }
    if (key.startsWith("struct:")) { return "ptr" }
    return key
}

// The capabilities a `Ptr<...>` annotation wrote, read off its `$mut` / `$volatile`
// markers (src/parse/decl.psm): bit 0 is `mut`, bit 1 is `volatile`.
public fn typePtrAnnotationCapabilities(tn: ASTNode) -> Int {
    let mut caps = 0
    let mut p = tn.child1
    while (nodeExists(p)) {
        let arg = ptr_to_node(p)
        if (arg.s1.startsWith("$") == false) { break }
        if (arg.s1.equals("$mut")) { caps = caps | 1 } else { caps = caps | 2 }
        p = arg.next
    }
    return caps
}

// The first argument that is not a qualifier marker: what the pointer points at, or
// an absent node for a `Ptr<>` that named nothing.
public fn typePtrAnnotationPointee(tn: ASTNode) -> Ptr {
    let mut p = tn.child1
    while (nodeExists(p)) {
        let arg = ptr_to_node(p)
        if (arg.s1.startsWith("$") == false) { return p }
        p = arg.next
    }
    return p
}

private fn typePtrFromAnnotation(tn: ASTNode) -> TypeInfo {
    let caps = typePtrAnnotationCapabilities(tn)
    let pointee = typePtrAnnotationPointee(tn)
    if (nodeExists(pointee) == false) { return typePtrTo(typeInvalid(), false, false) }
    return typePtrTo(typeFromAnnotation(ptr_to_node(pointee)), (caps & 1) == 1, (caps & 2) == 2)
}

private fn typeFromAnnotation(tn: ASTNode) -> TypeInfo {
    if (tn.i1 == 1) {
        if (nodeExists(tn.child1)) {
            return typeArray(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeArray(typeInvalid())
    }

    if (tn.i2 == 1 and tn.s1.equals("Slice")) {
        if (nodeExists(tn.child1)) {
            return typeSlice(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeSlice(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("DataView")) {
        if (nodeExists(tn.child1)) {
            return typeDataView(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeDataView(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("List")) {
        if (nodeExists(tn.child1)) {
            return typeList(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeList(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("Channel")) {
        if (nodeExists(tn.child1)) {
            return typeChannel(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeChannel(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("Ptr")) { return typePtrFromAnnotation(tn) }

    if (tn.s1.equals("Int")) { return typeInt() }
    if (tn.s1.equals("Float")) { return typeFloat() }
    let floating = typeFloatFromName(tn.s1)
    if (typeIsValid(floating)) { return floating }
    if (tn.s1.equals("Bool")) { return typeBool() }
    if (tn.s1.equals("String")) { return typeString() }
    // An opaque, copyable machine pointer. `typeFromSemKey` has resolved this
    // name since `Task<R>` needed it; the *annotation* path never did, so `Ptr`
    // was a type the compiler could produce and nobody could write.
    //
    // Writing it is the point. This compiler passes AST node, token and TypeInfo
    // handles as `String` -- `struct ASTNode { child1: String }` is an ASTNode
    // pointer -- which is why CODE_STYLE.md has to forbid a zero-valued first
    // field on anything punned through `String`. Those handles become `Ptr`, and
    // two things follow: a node pointer stops being affine (PTR is absent from
    // `typeIsMoveOnly`, so naming one twice is a copy, not a move), and `String`
    // stops having to be a machine word -- which is what a fat `{ptr, len}`
    // String needs.
    if (tn.s1.equals("Ptr")) { return typePtr() }
    if (tn.s1.equals("Char")) { return typeChar() }
    let sized = typeIntFromName(tn.s1)
    if (typeIsValid(sized)) { return sized }
    if (tn.s1.equals("")) { return typeVoid() }
    return typeStruct(tn.s1)
}

private fn typeFromIrKey(key: String) -> TypeInfo {
    if (key.equals("i32")) { return typeInt() }
    if (floatKeyValid(key)) { return typeFloatFromKey(key) }
    if (key.equals("i1")) { return typeBool() }
    if (key.equals("i8")) { return typeChar() }
    if (key.equals("ptr")) { return typePtr() }
    if (key.equals("void")) { return typeVoid() }
    if (key.equals("struct:prismio.slice")) { return typeSlice(typeInvalid()) }
    if (key.equals("struct:prismio.data_element")) {
        return typeDataElement(typeInvalid())
    }
    if (key.startsWith("struct:")) {
        return typeStruct(key.substring(7, key.length - 7))
    }
    return typeInvalid()
}

public fn typeFromSemKey(key: String) -> TypeInfo {
    if (key.equals("Int")) { return typeInt() }
    if (key.equals("Float")) { return typeFloat() }
    let floating = typeFloatFromName(key)
    if (typeIsValid(floating)) { return floating }
    if (key.equals("Bool")) { return typeBool() }
    if (key.equals("Char")) { return typeChar() }
    if (key.equals("String")) { return typeString() }
    if (key.equals("Ptr")) { return typePtr() }
    if (key.equals("Void")) { return typeVoid() }
    let sized = typeIntFromName(key)
    if (typeIsValid(sized)) { return sized }
    if (key.startsWith("struct:")) {
        return typeStruct(key.substring(7, key.length - 7))
    }
    // `ptr:3:struct:Header`: the capabilities are one digit, so the pointee starts at 6.
    if (key.startsWith("ptr:")) {
        let caps = key.charAt(4)
        let pointee = typeFromSemKey(key.substring(6, key.length - 6))
        return typePtrTo(pointee, caps == '1' or caps == '3', caps == '2' or caps == '3')
    }
    if (key.startsWith("enum:")) {
        return typeEnum(key.substring(5, key.length - 5))
    }
    if (key.startsWith("array:")) {
        return typeArray(typeFromSemKey(key.substring(6, key.length - 6)))
    }
    // `array#16:U32`. The count is written by typeSemKey, so it always parses.
    if (key.startsWith("array#")) {
        let colon = key.indexOf(":")
        let count = typeIntLiteralCount(key.substring(6, colon - 6))
        let elem = typeFromSemKey(key.substring(colon + 1, key.length - colon - 1))
        return typeArraySized(elem, count)
    }
    if (key.startsWith("list:")) {
        return typeList(typeFromSemKey(key.substring(5, key.length - 5)))
    }
    if (key.startsWith("chan:")) {
        return typeChannel(typeFromSemKey(key.substring(5, key.length - 5)))
    }
    if (key.startsWith("slice:")) {
        return typeSlice(typeFromSemKey(key.substring(6, key.length - 6)))
    }
    if (key.startsWith("view:")) {
        return typeDataView(typeFromSemKey(key.substring(5, key.length - 5)))
    }
    if (key.startsWith("dataelem:")) {
        return typeDataElement(typeFromSemKey(key.substring(9, key.length - 9)))
    }
    // REQUIREMENTS 4. The inverse of typeSemKey's `opt:` case, which was written
    // without one -- so every optional round-tripping through a binding decoded
    // to Invalid, and `let r = f()` on a `-> T?` function produced a value that
    // could not be compared with `none`.
    //
    // Optional *fields* were unaffected and that is why this survived: a field's
    // type is looked up from its struct declaration on every access and never
    // passes through a sem key. Only a local binding does, which is why
    // tests/test_51_optional_refs.psm -- all fields -- was green throughout.
    //
    // `opt:Invalid` decodes to `none` rather than to `typeOptional(Invalid)`,
    // and the difference is load-bearing. typeSemKey maps both a bare `none`
    // (empty child) and an optional of an invalid type to that one string, and
    // typeEquals gives an empty child the "matches any optional" behaviour that
    // lets `none` reach a typed slot with no inference pass. Decoding to
    // typeOptional(Invalid) would hand back a child that matches nothing, so
    // `let x = none` would stop being assignable to anything at all.
    if (key.startsWith("task:")) {
        return typeTask(typeFromSemKey(key.substring(5, key.length - 5)))
    }
    if (key.startsWith("opt:")) {
        let inner = typeFromSemKey(key.substring(4, key.length - 4))
        if (typeIsValid(inner) == false) { return typeNone() }
        return typeOptional(inner)
    }
    return typeInvalid()
}

public fn nodeSetType(node: ASTNode, t: TypeInfo) {
    node.typeInfo = type_to_ptr(t)
}

// `nodeExists` rather than `typeInfo.equals("")`: a TypeInfo begins with
// its `kind`, and `TypeKind.INVALID` is 0, so a node carrying an invalid type
// used to report as carrying none. That happened to be harmless -- nodeGetType
// returns typeInvalid() on both paths -- but it was the same latent bug as the
// module root, and "wrong in a way that currently cancels out" is not a state to
// leave a predicate in. See ptr_is_null in ast.psm.
public fn nodeHasType(node: ASTNode) -> Bool {
    return nodeExists(node.typeInfo)
}

public fn nodeGetType(node: ASTNode) -> TypeInfo {
    if (nodeHasType(node)) {
        return ptr_to_type(node.typeInfo)
    }
    return typeInvalid()
}

// ---------------------------------------------------------------------------
// Containment: which struct-typed fields are laid out inline
// ---------------------------------------------------------------------------
//
// A field whose type owns nothing -- every field of it, transitively, a scalar --
// is stored inline in its owner rather than as a pointer to a separate
// allocation. `Transform { position: Vec3, rotation: Quat }` is then one
// contiguous object instead of three.
//
// Restricted to plain data on purpose. Anything owning a String, a List, an
// array or a `T?` has a release, and an inline field has no allocation of its
// own for the generated __aif_release_T to free -- inlining one would either
// leak it or hand a deallocator an interior pointer.
//
// This lives here, rather than beside either caller, because codegen and AIF
// have to agree exactly: ir/module.psm asks it to choose the physical layout and
// aif/layout.psm asks it to size that layout. If one said inline and the other
// said one word, Theta_stack would describe a different object than LLVM emits
// and the T0 clause would read it.
//
// `[T]`, `List<T>` and `T?` are pointers, so they are *reference* edges rather
// than containment ones. That distinction is what lets a recursive type be
// spelled `T?` -- the only spelling for one -- and therefore what lets
// containment be required acyclic without rejecting any program.
public extern fn ir_is_struct_type_name(name: String) -> Int

// REQUIREMENTS 16. Every lookup of a declaration by name goes through the index
// these four declare, and the index is a cache of exactly what a walk of the
// module's statement list would have found, in the same order. The walk itself
// is here once, in indexModuleDeclarations(), instead of once per pass that
// wanted an answer from it.
public extern fn ir_reset_decl_index()
public extern fn ir_index_decl(name: String, node: Ptr)
public extern fn ir_decl_count(name: String) -> Int
public extern fn ir_decl_at(name: String, index: Int) -> String alias
public extern fn ir_extern_decl_record(file: Int, name: String, visibility: Int)
public extern fn ir_same_package(fileA: Int, fileB: Int) -> Int

// The integer an enum is stored as (`enum E: U8`), registered by sema as it
// declares the enum. Empty for an enum that states none, which is an i32.
public extern fn ir_register_enum_repr(enumName: String, key: String, isUnsigned: Int)
public extern fn ir_enum_repr_key(enumName: String) -> String alias
public extern fn ir_enum_repr_unsigned(enumName: String) -> Int

// Which top-level statements have a name worth indexing. Also the import
// merge's duplicate rule (main.psm), and it has to be the same predicate: the
// merge fills the index as it goes and every later pass rebuilds it, so a kind
// one of them thought named and the other did not would give the two different
// answers to the same question.
public fn isNamedTopLevel(stmt: ASTNode) -> Bool {
    match (stmt.kind) {
        NodeKind.EXTERN_FUNCTION => { return true }
        NodeKind.EXTERN_VARIABLE => { return true }
        NodeKind.VARIABLE_DECL => { return true }
        NodeKind.FUNCTION => { return true }
        NodeKind.STRUCT_DECL => { return true }
        NodeKind.ENUM_DECL => { return true }
        NodeKind.CODESET_DECL => { return true }
        NodeKind.TYPELIST_DECL => { return true }
    // LAYOUT 3.1 merges several workloads *by summation*, so a workload that
    // arrives twice through two import paths would weight itself twice over. It
    // is named and it is not overloadable, so the existing rule is exactly right
    // for it.
        NodeKind.WORKLOAD_DECL => { return true }
    }
    return false
}

// Either `extern` form. Both are names foreign code defines, and both are
// filed in the one per-file table runtime/ir_symbols.c checks visibility
// against -- one table because C has one namespace for the two.
public fn isExternDecl(stmt: ASTNode) -> Bool {
    return stmt.kind == NodeKind.EXTERN_FUNCTION or stmt.kind == NodeKind.EXTERN_VARIABLE
}

public fn indexTopLevel(stmt: ASTNode) {
    if (isNamedTopLevel(stmt)) {
        ir_index_decl(stmt.s1, node_to_ptr(stmt))
        if (isExternDecl(stmt)) {
            ir_extern_decl_record(stmt.file, stmt.s1, stmt.i2)
        }
    }
}

// Called by analyzeModule() and again by generateModule(), so neither depends on
// the other having run. Rebuilding it is one walk of the top level; asking it a
// question was the thing that cost.
public fn indexModuleDeclarations(module: ASTNode) {
    ir_reset_decl_index()
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        indexTopLevel(stmt)
        p = stmt.next
    }
}

public fn findStructDeclNamed(module: ASTNode, name: String) -> ASTNode {
    let n = ir_decl_count(name)
    for i in 0..<n {
        let p = ir_decl_at(name, i)
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.STRUCT_DECL) { return stmt }
    }
    return ptr_to_node(ptr_null())
}

public fn findStructField(structNode: ASTNode, name: String) -> ASTNode {
    let mut p = structNode.child1
    while (nodeExists(p)) {
        let f = ptr_to_node(p)
        if (f.s1.equals(name)) { return f }
        p = f.next
    }
    return ptr_to_node(ptr_null())
}

public fn typeAnnIsPod(module: ASTNode, ann: ASTNode, depth: Int) -> Bool {
    return typeAnnIsPodIn(module, ann, depth, false)
}

private fn structDeclIsPod(module: ASTNode, name: String, depth: Int) -> Bool {
    return structDeclIsPodIn(module, name, depth, false)
}

// `byDecl` picks which table answers "is this name a struct", and it is the only
// difference between the two readings of this rule.
//
// The struct **registry** is filled by codegen, so during the analysis it is
// empty and the registry reading stops recursing: a struct-typed field reads as
// POD without anyone looking at its fields. For layout that over-approximation is
// the safe direction and is deliberate -- see `aifFieldIsInlineStruct`, which
// documents the corpus failure that established it.
//
// It is the **unsafe** direction for ownership. A field wrongly read as inline is
// a field reported to own nothing, which lets a caller free a value the field
// still points at. So the ownership reading passes `byDecl` and asks
// `findStructDeclNamed` -- the AST the registry is built from, and therefore an
// answer that agrees with it by construction in both phases.
public fn typeAnnIsPodIn(module: ASTNode, ann: ASTNode, depth: Int, byDecl: Bool) -> Bool {
    // A containment cycle would not terminate. semaCheckStructContainment
    // rejects one before this runs, so the cap is reached only by a program that
    // has already failed, and answering false keeps that path on the old layout.
    if (depth > 16) { return false }
    // `Array<T, N>` is N elements in place, and an array field's elements own
    // nothing (semaCheckArrayField), so it is POD when they are. Answering false
    // boxed a struct holding one, and a literal leaving that struct out wrote
    // `none` into a field codegen then read as the struct.
    if (ann.i1 == 1 and ann.i3 == 0 and nodeExists(ann.child2) and nodeExists(ann.child1)) {
        return typeAnnIsPodIn(module, ptr_to_node(ann.child1), depth + 1, byDecl)
    }
    if (ann.i1 == 1) { return false }
    if (ann.i2 == 1) { return false }
    if (ann.i3 == 1) { return false }
    let mut named = ir_is_struct_type_name(ann.s1) == 1
    if (byDecl) {
        named = nodeExists(node_to_ptr(findStructDeclNamed(module, ann.s1)))
    }
    if (named) {
        return structDeclIsPodIn(module, ann.s1, depth + 1, byDecl)
    }
    if (ann.s1.equals("String")) { return false }
    if (ann.s1.equals("Ptr")) { return false }
    return true
}

public fn structDeclIsPodIn(module: ASTNode, name: String, depth: Int, byDecl: Bool) -> Bool {
    if (depth > 16) { return false }
    let decl = findStructDeclNamed(module, name)
    if (nodeExists(node_to_ptr(decl)) == false) { return false }
    let mut p = decl.child1
    while (nodeExists(p)) {
        let f = ptr_to_node(p)
        if (f.kind == NodeKind.STRUCT_FIELD) {
            if (nodeExists(f.child1) == false) { return false }
            if (typeAnnIsPodIn(module, ptr_to_node(f.child1), depth, byDecl) == false) {
                return false
            }
        }
        p = f.next
    }
    return true
}
