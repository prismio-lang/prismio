import ast.nodes
import common.text
import common.target
import std.string

// As with NodeKind (ast.psm), **nothing may take ordinal 0**: a TypeInfo is
// punned as a String and `kind` is its first field, so a zero-valued kind makes
// a live TypeInfo read as an empty slot. `INVALID` at ordinal 0 used to make
// nodeHasType answer false for a node that did carry a type. That happened to
// cancel out -- nodeGetType returns typeInvalid() either way -- which is
// exactly why it survived.
enum TypeKind {
    // Not a type. Keeps every real kind's low byte non-zero.
    NEVER_ZERO,

    INVALID,
    VOID,
    INT,
    FLOAT,
    BOOL,
    CHAR,
    STRING,
    PTR,
    STRUCT,
    ENUM,
    ARRAY,
    LIST,
    FUNCTION,

    // REQUIREMENTS 4. A reference that may be absent. Appended rather than
    // inserted: TypeKind's ordinals are load-bearing (see NEVER_ZERO above and
    // test_41), so adding in the middle would renumber every kind after it.
    OPTIONAL,

    // M4.1. Appended so the established ordinals above remain stable. A slice
    // is a copyable `(List handle, offset, length)` value and owns none of the
    // list storage it names; E-VIEW keeps that storage alive.
    SLICE,

    // M4.3. Appended for the same ordinal-stability reason as Slice. A
    // DataView owns a columnar allocation produced at an explicit `soa`
    // boundary and is consumed by `aos` (or released at scope exit).
    DATAVIEW,

    // M4.3b. The transient `(DataView handle, index)` produced by indexing a
    // DataView. It is intentionally not a source-spellable type: the descriptor
    // is useful only for projecting fields while the borrowed view is alive.
    // Appended because the ordinals above are load-bearing.
    DATAELEMENT
}

struct TypeInfo {
    kind: TypeKind,
    name: String,
    llvm: String,
    child: Ptr,
    next: Ptr
}

// The identity on a pointer, like ptr_to_node -- see ast.psm for why declaring
// it matters.
extern fn ptr_to_type(ptr: Ptr) -> TypeInfo alias
extern fn type_to_ptr(t: TypeInfo borrow) -> Ptr alias

private fn typeMake(kind: TypeKind, name: String, llvm: String) -> TypeInfo {
    return TypeInfo {
        kind: kind,
        name: name,
        llvm: llvm,
        child: ptr_null(),
        next: ptr_null()
    }
}

// Structs are move-only, so binding one TypeInfo to another name (`a = b`) transfers
// ownership and makes the original unusable. A TypeInfo is a descriptor, not an owned
// resource: where the intent is "these two names describe the same type", take an
// independent copy instead of aliasing.
fn typeCopy(t: TypeInfo) -> TypeInfo {
    let dup = typeMake(t.kind, t.name, t.llvm)
    dup.child = t.child
    dup.next = t.next
    return dup
}

fn typeInvalid() -> TypeInfo { return typeMake(TypeKind.INVALID, "Invalid", "") }
fn typeVoid() -> TypeInfo { return typeMake(TypeKind.VOID, "Void", "void") }
fn typeInt() -> TypeInfo { return typeMake(TypeKind.INT, "Int", "i32") }
fn typeFloat() -> TypeInfo { return typeMake(TypeKind.FLOAT, "Float", "double") }
fn typeBool() -> TypeInfo { return typeMake(TypeKind.BOOL, "Bool", "i1") }
fn typeChar() -> TypeInfo { return typeMake(TypeKind.CHAR, "Char", "i8") }
fn typeString() -> TypeInfo { return typeMake(TypeKind.STRING, "String", "ptr") }
fn typePtr() -> TypeInfo { return typeMake(TypeKind.PTR, "Ptr", "ptr") }

// Sized integers. `Int` is the 32-bit signed default. Unsigned names start with "U".
//
// usize/isize are pointer-width, and that width comes from the target record --
// **not** a constant. sema and codegen have to give the same answer here: src/ir
// lowers Isize through the same call, and if this said i64 while codegen emitted
// i32, `value as I64` in std/io would be a no-op cast (equal keys) and the
// verifier would see a 32-bit value passed to a 64-bit parameter. That is the
// whole reason `--target wasm32-unknown-unknown` used to build nothing at all.
fn typeI8() -> TypeInfo { return typeMake(TypeKind.INT, "I8", "i8") }
fn typeI16() -> TypeInfo { return typeMake(TypeKind.INT, "I16", "i16") }
fn typeI64() -> TypeInfo { return typeMake(TypeKind.INT, "I64", "i64") }
fn typeIsize() -> TypeInfo { return typeMake(TypeKind.INT, "Isize", targetPtrIntType(targetCurrent())) }
fn typeU8() -> TypeInfo { return typeMake(TypeKind.INT, "U8", "i8") }
fn typeU16() -> TypeInfo { return typeMake(TypeKind.INT, "U16", "i16") }
fn typeU32() -> TypeInfo { return typeMake(TypeKind.INT, "U32", "i32") }
fn typeU64() -> TypeInfo { return typeMake(TypeKind.INT, "U64", "i64") }
fn typeUsize() -> TypeInfo { return typeMake(TypeKind.INT, "Usize", targetPtrIntType(targetCurrent())) }

// Bit width of an integer type, from its LLVM spelling. Casting needs it to
// choose between truncation and extension.
fn typeIntBits(t: TypeInfo) -> Int {
    if (t.llvm.equals("i1")) { return 1 }
    if (t.llvm.equals("i8")) { return 8 }
    if (t.llvm.equals("i16")) { return 16 }
    if (t.llvm.equals("i32")) { return 32 }
    if (t.llvm.equals("i64")) { return 64 }
    return 0
}

fn typeIntIsUnsigned(t: TypeInfo) -> Bool {
    if (t.kind != TypeKind.INT) { return false }
    return strStartsWith(t.name, "U")
}

// Move-only types are owned, heap-backed values that transfer ownership on use.
// Scalars/enums are Copyable (bit-copied) and never move.
//
// AIF Level 4. Strings and lists join structs here, which is what gives the
// memory model a single owner for the values that make up most of a real
// program's allocation traffic -- aif_frees_at_scope_node asks the same question
// through site_is_move_only, so a T1 string now has a free point.
//
// Arrays deliberately do not. An array literal lowers to ir_array_alloca, which
// is frame storage: there is no allocation to own, nothing for a drop to
// reclaim, and `drop(arr)` would hand a stack pointer to the deallocator.
// Making them affine would buy the aliasing rule and cost that hazard.
fn typeIsMoveOnly(t: TypeInfo) -> Bool {
    if (t.kind == TypeKind.STRUCT) { return true }
    if (t.kind == TypeKind.STRING) { return true }
    // REQUIREMENTS 4. `T?` owns whatever `T` owns; being absent is a state of
    // the slot, not a different kind of ownership.
    if (t.kind == TypeKind.OPTIONAL) {
        if (nodeExists(t.child)) { return typeIsMoveOnly(ptr_to_type(t.child)) }
        return false
    }
    return t.kind == TypeKind.LIST or t.kind == TypeKind.DATAVIEW
}

fn typeStruct(name: String) -> TypeInfo {
    return typeMake(TypeKind.STRUCT, name, "ptr")
}

// ---------------------------------------------------------------------------
// REQUIREMENTS 4 -- optional references
//
// **`none` is a null pointer, and that choice is the whole of the punned-slot
// question.** This compiler already has a way to spell "this slot is empty": a
// pointer to the empty string, tested with `p.equals("")`. That encoding
// reads the *first byte of the pointed-to struct*, so a live value whose first
// field is zero is byte-for-byte an empty slot -- which is why NodeKind and
// TypeKind both reserve ordinal 0, why the layout search pins field 0, and what
// test_41 characterises.
//
// A null pointer dereferences nothing. `x == none` is `icmp eq ptr %x, null`,
// which reads no byte of any object, so **no live value can collide with it
// whatever its first field holds**. Reusing the `""` convention would have
// inherited the collision and spread it from the compiler's own punned pointers
// to every user program; a distinct null is immune by construction.
//
// The cost is that both encodings now exist. They do not meet: `""` is the
// compiler's internal idiom on `String`-punned node pointers, `none` is the
// language's, and nothing converts between them.
// ---------------------------------------------------------------------------

// The type of a bare `none`: optional, with no inner type to speak of. Its empty
// `child` is what makes typeEquals match it against any `T?`, which is how the
// literal reaches a typed slot without an inference pass to give it one.
fn typeNone() -> TypeInfo { return typeMake(TypeKind.OPTIONAL, "none", "ptr") }

fn typeOptional(inner: TypeInfo) -> TypeInfo {
    let t = typeMake(TypeKind.OPTIONAL, inner.name.concat("?"), "ptr")
    t.child = type_to_ptr(inner)
    return t
}

// REQUIREMENTS 15. A task handle, carrying the type its `join` yields.
//
// PTR-kinded rather than a TypeKind of its own, and that is a considered choice
// rather than a shortcut: the handle *is* an opaque word, every switch in sema,
// AIF and codegen already has a PTR arm that treats it correctly, and a new
// kind would have to be added to all of them to arrive at the same behaviour.
// What the name and the `child` add is the one thing a bare `Ptr` could not
// carry -- what comes back out of the join.
fn typeTask(result: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.PTR, "Task<".concat(result.name, ">"), "ptr")
    t.child = type_to_ptr(result)
    return t
}

fn typeIsTask(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.PTR and strStartsWith(t.name, "Task<")
}

fn typeTaskResult(t: TypeInfo) -> TypeInfo {
    if (typeIsTask(t) and nodeExists(t.child)) { return ptr_to_type(t.child) }
    return typeInvalid()
}

// v0.1 concurrency. A blocking typed channel endpoint, carrying the type its
// `chan_recv` yields.
//
// PTR-kinded and named, for exactly the reason `typeTask` above is: the endpoint
// is an opaque word the runtime allocated, every PTR arm in sema, AIF and codegen
// already handles it correctly, and a TypeKind of its own would have to be added
// to all of them to arrive at the same behaviour. The name and the `child` carry
// the one thing a bare `Ptr` cannot -- what may be sent through it and what comes
// back out.
//
// **The element type must be reference-shaped.** The runtime moves one `void*`
// per message and `chan_recv` answers `T?`, which REQUIREMENTS 4 defines only for
// a reference. `Channel<Int>` is refused in sema rather than boxed silently.
fn typeChannel(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.PTR, "Channel<".concat(elem.name, ">"), "ptr")
    t.child = type_to_ptr(elem)
    return t
}

fn typeIsChannel(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.PTR and strStartsWith(t.name, "Channel<")
}

fn typeChannelElem(t: TypeInfo) -> TypeInfo {
    if (typeIsChannel(t) and nodeExists(t.child)) { return ptr_to_type(t.child) }
    return typeInvalid()
}

fn typeOptionalInner(t: TypeInfo) -> TypeInfo {
    if (t.kind == TypeKind.OPTIONAL and nodeExists(t.child)) {
        return ptr_to_type(t.child)
    }
    return typeInvalid()
}

// Only a reference can be absent. A scalar has no spare representation -- 0 is a
// perfectly good Int -- so `Int?` would need a second word and is refused rather
// than silently given one.
fn typeCanBeOptional(t: TypeInfo) -> Bool {
    if (t.kind == TypeKind.STRUCT) { return true }
    if (t.kind == TypeKind.STRING) { return true }
    if (t.kind == TypeKind.LIST) { return true }
    return t.kind == TypeKind.PTR
}

fn typeEnum(name: String) -> TypeInfo {
    return typeMake(TypeKind.ENUM, name, "i32")
}

fn typeArray(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.ARRAY, "Array", "ptr")
    t.child = type_to_ptr(elem)
    return t
}

fn typeList(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.LIST, "List", "ptr")
    t.child = type_to_ptr(elem)
    return t
}

fn typeSlice(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.SLICE, "Slice", "struct:prismio.slice")
    t.child = type_to_ptr(elem)
    return t
}

fn typeDataView(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.DATAVIEW, "DataView", "ptr")
    t.child = type_to_ptr(elem)
    return t
}

fn typeDataElement(elem: TypeInfo) -> TypeInfo {
    let mut t = typeMake(TypeKind.DATAELEMENT, "DataElement", "struct:prismio.data_element")
    t.child = type_to_ptr(elem)
    return t
}

fn typeIsValid(t: TypeInfo) -> Bool {
    return t.kind != TypeKind.INVALID
}

fn typeDisplay(t: TypeInfo) -> String {
    if (t.kind == TypeKind.STRUCT) {
        // A trait object is a synthesised struct named `dyn$Show`, and `$` cannot
        // occur in a source identifier -- so printing the internal name shows the
        // reader a type they did not write and cannot spell.
        if (strStartsWith(t.name, "dyn$")) {
            return "dyn ".concat(strSubstring(t.name, 4, __builtin_string_len(t.name) - 4))
        }
        return t.name
    }
    if (t.kind == TypeKind.ENUM) { return t.name }
    if (t.kind == TypeKind.ARRAY) {
        if (nodeExists(t.child)) {
            return "[".concat(typeDisplay(ptr_to_type(t.child)), "]")
        }
        return "[Invalid]"
    }
    if (t.kind == TypeKind.LIST) {
        if (nodeExists(t.child)) {
            return "List<".concat(typeDisplay(ptr_to_type(t.child)), ">")
        }
        return "List"
    }
    if (t.kind == TypeKind.SLICE) {
        if (nodeExists(t.child)) {
            return "Slice<".concat(typeDisplay(ptr_to_type(t.child)), ">")
        }
        return "Slice"
    }
    if (t.kind == TypeKind.DATAVIEW) {
        if (nodeExists(t.child)) {
            return "DataView<".concat(typeDisplay(ptr_to_type(t.child)), ">")
        }
        return "DataView"
    }
    if (t.kind == TypeKind.DATAELEMENT) {
        if (nodeExists(t.child)) {
            return "DataElement<".concat(typeDisplay(ptr_to_type(t.child)), ">")
        }
        return "DataElement"
    }
    if (t.kind == TypeKind.OPTIONAL) {
        if (nodeExists(t.child)) {
            return typeDisplay(ptr_to_type(t.child)).concat("?")
        }
        return "none"
    }
    return t.name
}

fn typeEquals(a: TypeInfo, b: TypeInfo) -> Bool {
    if (a.kind != b.kind) { return false }
    if (a.kind == TypeKind.STRUCT or a.kind == TypeKind.ENUM) {
        return a.name.equals(b.name)
    }
    if (a.kind == TypeKind.INT) {
        return a.name.equals(b.name)
    }
    if (a.kind == TypeKind.ARRAY) {
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) {
            // Element types agree only when *both* are absent. Compared as
            // strings this was a strcmp of two machine pointers.
            return nodeIsNull(a.child) and nodeIsNull(b.child)
        }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    if (a.kind == TypeKind.LIST) {
        // A list with an unknown element type (from list_new()) matches any list.
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        let ac = ptr_to_type(a.child)
        let bc = ptr_to_type(b.child)
        if (typeIsValid(ac) == false or typeIsValid(bc) == false) { return true }
        return typeEquals(ac, bc)
    }
    if (a.kind == TypeKind.SLICE) {
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return false }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    if (a.kind == TypeKind.DATAVIEW) {
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return false }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    if (a.kind == TypeKind.DATAELEMENT) {
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return false }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    // Two task handles are the same type only when they yield the same thing.
    // Without this they would fall through to PTR's unconditional `true` and
    // `let t: Task<Int> = spawn make_report(j)` would typecheck.
    if (typeIsTask(a) or typeIsTask(b)) {
        if (typeIsTask(a) == false or typeIsTask(b) == false) { return false }
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    // Same rule, same reason: two endpoints are the same type only when they
    // carry the same message. Without this `let c: Channel<Job> = chan_new(4)`
    // would accept a `Channel<Result>` through PTR's unconditional `true`.
    if (typeIsChannel(a) or typeIsChannel(b)) {
        if (typeIsChannel(a) == false or typeIsChannel(b) == false) { return false }
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        let ac = ptr_to_type(a.child)
        let bc = ptr_to_type(b.child)
        // `chan_new` has nothing to read an element type from, so it answers
        // `Channel<Invalid>` and the annotation supplies it -- the same shape
        // `list_new` uses, and the reason this is not the Task clause verbatim.
        if (typeIsValid(ac) == false or typeIsValid(bc) == false) { return true }
        return typeEquals(ac, bc)
    }
    if (a.kind == TypeKind.OPTIONAL) {
        // A bare `none` carries no inner type, so it matches any optional. That
        // is what lets `none` be written wherever a `T?` is wanted without an
        // inference pass to give it one.
        if (nodeIsNull(a.child) or nodeIsNull(b.child)) { return true }
        return typeEquals(ptr_to_type(a.child), ptr_to_type(b.child))
    }
    return true
}

fn typeIsNumeric(t: TypeInfo) -> Bool {
    return t.kind == TypeKind.INT or t.kind == TypeKind.FLOAT
}

fn typeIrKey(t: TypeInfo) -> String {
    if (t.kind == TypeKind.VOID) { return "void" }
    if (t.kind == TypeKind.INT) { return t.llvm }
    if (t.kind == TypeKind.FLOAT) { return "double" }
    if (t.kind == TypeKind.BOOL) { return "i1" }
    if (t.kind == TypeKind.CHAR) { return "i8" }
    // The fat String. Kept in step with `mapType` in src/ir/types.psm, which is
    // the same mapping reached from a type *name* rather than a TypeInfo -- two
    // functions answering one question, and a String that is a struct in one and
    // a pointer in the other is a call that disagrees with its own declaration.
    if (t.kind == TypeKind.STRING) { return "struct:prismio.str" }
    if (t.kind == TypeKind.PTR) { return "ptr" }
    if (t.kind == TypeKind.ENUM) { return "i32" }
    if (t.kind == TypeKind.STRUCT) { return "struct:".concat(t.name) }
    if (t.kind == TypeKind.LIST) { return "ptr" }
    if (t.kind == TypeKind.SLICE) { return "struct:prismio.slice" }
    if (t.kind == TypeKind.DATAVIEW) { return "ptr" }
    if (t.kind == TypeKind.DATAELEMENT) { return "struct:prismio.data_element" }
    // REQUIREMENTS 4. A `T?` is one pointer, absent or not. Deliberately *not*
    // `struct:T` even when the inner is a struct: the storage is the same, but
    // an lvalue of this type must never reach ir_struct_field_ptr without an
    // unwrap, and keeping the key opaque is what makes that a type error rather
    // than a null dereference.
    if (t.kind == TypeKind.OPTIONAL) { return "ptr" }
    if (t.kind == TypeKind.ARRAY) {
        if (nodeExists(t.child)) {
            let elem = ptr_to_type(t.child)
            if (elem.kind == TypeKind.ARRAY) { return "ptrptr" }
        }
        return "ptr"
    }
    return ""
}

fn typeSemKey(t: TypeInfo) -> String {
    if (t.kind == TypeKind.VOID) { return "Void" }
    if (t.kind == TypeKind.INT) { return t.name }
    if (t.kind == TypeKind.FLOAT) { return "Float" }
    if (t.kind == TypeKind.BOOL) { return "Bool" }
    if (t.kind == TypeKind.CHAR) { return "Char" }
    if (t.kind == TypeKind.STRING) { return "String" }
    // A task's result type has to survive a binding, which is what a sem key is
    // for. Writing "Ptr" here would lose it and `let t = spawn f(x)` would come
    // back as a bare handle -- the same round-trip hole REQUIREMENTS 4's
    // optionals fell into, which is why this case was written with its decoder.
    if (t.kind == TypeKind.PTR) {
        if (typeIsTask(t) and nodeExists(t.child)) {
            return "task:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        // Same hole, same fix: a channel endpoint that came back as a bare `Ptr`
        // would make `chan_send(c, v)` report "expects a Channel, found Ptr" one
        // statement after the binding that gave it its type.
        if (typeIsChannel(t) and nodeExists(t.child)) {
            return "chan:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "Ptr"
    }
    if (t.kind == TypeKind.STRUCT) { return "struct:".concat(t.name) }
    if (t.kind == TypeKind.ENUM) { return "enum:".concat(t.name) }
    if (t.kind == TypeKind.ARRAY) {
        if (nodeExists(t.child)) {
            return "array:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "array:Invalid"
    }
    if (t.kind == TypeKind.LIST) {
        if (nodeExists(t.child)) {
            return "list:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "list:Invalid"
    }
    if (t.kind == TypeKind.SLICE) {
        if (nodeExists(t.child)) {
            return "slice:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "slice:Invalid"
    }
    if (t.kind == TypeKind.DATAVIEW) {
        if (nodeExists(t.child)) {
            return "view:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "view:Invalid"
    }
    if (t.kind == TypeKind.DATAELEMENT) {
        if (nodeExists(t.child)) {
            return "dataelem:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "dataelem:Invalid"
    }
    if (t.kind == TypeKind.OPTIONAL) {
        if (nodeExists(t.child)) {
            return "opt:".concat(typeSemKey(ptr_to_type(t.child)))
        }
        return "opt:Invalid"
    }
    return "Invalid"
}

private fn typeStorageKey(t: TypeInfo) -> String {
    let key = typeIrKey(t)
    if (key.equals("ptrptr")) { return "ptr" }
    if (strStartsWith(key, "struct:")) { return "ptr" }
    return key
}

private fn typeFromAnnotation(tn: ASTNode) -> TypeInfo {
    if (tn.i1 == 1) {
        if (nodeExists(tn.child1)) {
            return typeArray(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeArray(typeInvalid())
    }

    if (tn.i2 == 1 and tn.s1.equals("Slice")) {
        if (nodeExists(tn.child1)) {
            return typeSlice(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeSlice(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("DataView")) {
        if (nodeExists(tn.child1)) {
            return typeDataView(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeDataView(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("List")) {
        if (nodeExists(tn.child1)) {
            return typeList(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeList(typeInvalid())
    }
    if (tn.i2 == 1 and tn.s1.equals("Channel")) {
        if (nodeExists(tn.child1)) {
            return typeChannel(typeFromAnnotation(ptr_to_node(tn.child1)))
        }
        return typeChannel(typeInvalid())
    }

    if (tn.s1.equals("Int")) { return typeInt() }
    if (tn.s1.equals("Float")) { return typeFloat() }
    if (tn.s1.equals("Bool")) { return typeBool() }
    if (tn.s1.equals("String")) { return typeString() }
    // An opaque, copyable machine pointer. `typeFromSemKey` has resolved this
    // name since `Task<R>` needed it; the *annotation* path never did, so `Ptr`
    // was a type the compiler could produce and nobody could write.
    //
    // Writing it is the point. This compiler passes AST node, token and TypeInfo
    // handles as `String` -- `struct ASTNode { child1: String }` is an ASTNode
    // pointer -- which is why CODE_STYLE.md has to forbid a zero-valued first
    // field on anything punned through `String`. Those handles become `Ptr`, and
    // two things follow: a node pointer stops being affine (PTR is absent from
    // `typeIsMoveOnly`, so naming one twice is a copy, not a move), and `String`
    // stops having to be a machine word -- which is what a fat `{ptr, len}`
    // String needs.
    if (tn.s1.equals("Ptr")) { return typePtr() }
    if (tn.s1.equals("Char")) { return typeChar() }
    if (tn.s1.equals("I8")) { return typeI8() }
    if (tn.s1.equals("I16")) { return typeI16() }
    if (tn.s1.equals("I64")) { return typeI64() }
    if (tn.s1.equals("Isize")) { return typeIsize() }
    if (tn.s1.equals("U8")) { return typeU8() }
    if (tn.s1.equals("U16")) { return typeU16() }
    if (tn.s1.equals("U32")) { return typeU32() }
    if (tn.s1.equals("U64")) { return typeU64() }
    if (tn.s1.equals("Usize")) { return typeUsize() }
    if (tn.s1.equals("")) { return typeVoid() }
    return typeStruct(tn.s1)
}

private fn typeFromIrKey(key: String) -> TypeInfo {
    if (key.equals("i32")) { return typeInt() }
    if (key.equals("double")) { return typeFloat() }
    if (key.equals("i1")) { return typeBool() }
    if (key.equals("i8")) { return typeChar() }
    if (key.equals("ptr")) { return typePtr() }
    if (key.equals("void")) { return typeVoid() }
    if (key.equals("struct:prismio.slice")) { return typeSlice(typeInvalid()) }
    if (key.equals("struct:prismio.data_element")) {
        return typeDataElement(typeInvalid())
    }
    if (strStartsWith(key, "struct:")) {
        return typeStruct(strSubstring(key, 7, __builtin_string_len(key) - 7))
    }
    return typeInvalid()
}

fn typeFromSemKey(key: String) -> TypeInfo {
    if (key.equals("Int")) { return typeInt() }
    if (key.equals("Float")) { return typeFloat() }
    if (key.equals("Bool")) { return typeBool() }
    if (key.equals("Char")) { return typeChar() }
    if (key.equals("String")) { return typeString() }
    if (key.equals("Ptr")) { return typePtr() }
    if (key.equals("Void")) { return typeVoid() }
    if (key.equals("I8")) { return typeI8() }
    if (key.equals("I16")) { return typeI16() }
    if (key.equals("I64")) { return typeI64() }
    if (key.equals("Isize")) { return typeIsize() }
    if (key.equals("U8")) { return typeU8() }
    if (key.equals("U16")) { return typeU16() }
    if (key.equals("U32")) { return typeU32() }
    if (key.equals("U64")) { return typeU64() }
    if (key.equals("Usize")) { return typeUsize() }
    if (strStartsWith(key, "struct:")) {
        return typeStruct(strSubstring(key, 7, __builtin_string_len(key) - 7))
    }
    if (strStartsWith(key, "enum:")) {
        return typeEnum(strSubstring(key, 5, __builtin_string_len(key) - 5))
    }
    if (strStartsWith(key, "array:")) {
        return typeArray(typeFromSemKey(strSubstring(key, 6, __builtin_string_len(key) - 6)))
    }
    if (strStartsWith(key, "list:")) {
        return typeList(typeFromSemKey(strSubstring(key, 5, __builtin_string_len(key) - 5)))
    }
    if (strStartsWith(key, "chan:")) {
        return typeChannel(typeFromSemKey(strSubstring(key, 5, __builtin_string_len(key) - 5)))
    }
    if (strStartsWith(key, "slice:")) {
        return typeSlice(typeFromSemKey(strSubstring(key, 6, __builtin_string_len(key) - 6)))
    }
    if (strStartsWith(key, "view:")) {
        return typeDataView(typeFromSemKey(strSubstring(key, 5, __builtin_string_len(key) - 5)))
    }
    if (strStartsWith(key, "dataelem:")) {
        return typeDataElement(typeFromSemKey(strSubstring(key, 9, __builtin_string_len(key) - 9)))
    }
    // REQUIREMENTS 4. The inverse of typeSemKey's `opt:` case, which was written
    // without one -- so every optional round-tripping through a binding decoded
    // to Invalid, and `let r = f()` on a `-> T?` function produced a value that
    // could not be compared with `none`.
    //
    // Optional *fields* were unaffected and that is why this survived: a field's
    // type is looked up from its struct declaration on every access and never
    // passes through a sem key. Only a local binding does, which is why
    // tests/test_51_optional_refs.psm -- all fields -- was green throughout.
    //
    // `opt:Invalid` decodes to `none` rather than to `typeOptional(Invalid)`,
    // and the difference is load-bearing. typeSemKey maps both a bare `none`
    // (empty child) and an optional of an invalid type to that one string, and
    // typeEquals gives an empty child the "matches any optional" behaviour that
    // lets `none` reach a typed slot with no inference pass. Decoding to
    // typeOptional(Invalid) would hand back a child that matches nothing, so
    // `let x = none` would stop being assignable to anything at all.
    if (strStartsWith(key, "task:")) {
        return typeTask(typeFromSemKey(strSubstring(key, 5, __builtin_string_len(key) - 5)))
    }
    if (strStartsWith(key, "opt:")) {
        let inner = typeFromSemKey(strSubstring(key, 4, __builtin_string_len(key) - 4))
        if (typeIsValid(inner) == false) { return typeNone() }
        return typeOptional(inner)
    }
    return typeInvalid()
}

fn nodeSetType(node: ASTNode, t: TypeInfo) {
    node.typeInfo = type_to_ptr(t)
}

// `nodeExists` rather than `typeInfo.equals("")`: a TypeInfo begins with
// its `kind`, and `TypeKind.INVALID` is 0, so a node carrying an invalid type
// used to report as carrying none. That happened to be harmless -- nodeGetType
// returns typeInvalid() on both paths -- but it was the same latent bug as the
// module root, and "wrong in a way that currently cancels out" is not a state to
// leave a predicate in. See ptr_is_null in ast.psm.
fn nodeHasType(node: ASTNode) -> Bool {
    return nodeExists(node.typeInfo)
}

fn nodeGetType(node: ASTNode) -> TypeInfo {
    if (nodeHasType(node)) {
        return ptr_to_type(node.typeInfo)
    }
    return typeInvalid()
}

// ---------------------------------------------------------------------------
// Containment: which struct-typed fields are laid out inline
// ---------------------------------------------------------------------------
//
// A field whose type owns nothing -- every field of it, transitively, a scalar --
// is stored inline in its owner rather than as a pointer to a separate
// allocation. `Transform { position: Vec3, rotation: Quat }` is then one
// contiguous object instead of three.
//
// Restricted to plain data on purpose. Anything owning a String, a List, an
// array or a `T?` has a release, and an inline field has no allocation of its
// own for the generated __aif_release_T to free -- inlining one would either
// leak it or hand a deallocator an interior pointer.
//
// This lives here, rather than beside either caller, because codegen and AIF
// have to agree exactly: ir/module.psm asks it to choose the physical layout and
// aif/layout.psm asks it to size that layout. If one said inline and the other
// said one word, Theta_stack would describe a different object than LLVM emits
// and the T0 clause would read it.
//
// `[T]`, `List<T>` and `T?` are pointers, so they are *reference* edges rather
// than containment ones. That distinction is what lets a recursive type be
// spelled `T?` -- the only spelling for one -- and therefore what lets
// containment be required acyclic without rejecting any program.
extern fn ir_is_struct_type_name(name: String) -> Int

// REQUIREMENTS 16. Every lookup of a declaration by name goes through the index
// these four declare, and the index is a cache of exactly what a walk of the
// module's statement list would have found, in the same order. The walk itself
// is here once, in indexModuleDeclarations(), instead of once per pass that
// wanted an answer from it.
extern fn ir_reset_decl_index()
extern fn ir_index_decl(name: String, node: Ptr)
extern fn ir_decl_count(name: String) -> Int
extern fn ir_decl_at(name: String, index: Int) -> String alias

// Which top-level statements have a name worth indexing. Also the import
// merge's duplicate rule (main.psm), and it has to be the same predicate: the
// merge fills the index as it goes and every later pass rebuilds it, so a kind
// one of them thought named and the other did not would give the two different
// answers to the same question.
fn isNamedTopLevel(stmt: ASTNode) -> Bool {
    if (stmt.kind == NodeKind.EXTERN_FUNCTION) { return true }
    if (stmt.kind == NodeKind.VARIABLE_DECL) { return true }
    if (stmt.kind == NodeKind.FUNCTION) { return true }
    if (stmt.kind == NodeKind.STRUCT_DECL) { return true }
    if (stmt.kind == NodeKind.ENUM_DECL) { return true }
    // LAYOUT 3.1 merges several workloads *by summation*, so a workload that
    // arrives twice through two import paths would weight itself twice over. It
    // is named and it is not overloadable, so the existing rule is exactly right
    // for it.
    if (stmt.kind == NodeKind.WORKLOAD_DECL) { return true }
    return false
}

fn indexTopLevel(stmt: ASTNode) {
    if (isNamedTopLevel(stmt)) {
        ir_index_decl(stmt.s1, node_to_ptr(stmt))
    }
}

// Called by analyzeModule() and again by generateModule(), so neither depends on
// the other having run. Rebuilding it is one walk of the top level; asking it a
// question was the thing that cost.
fn indexModuleDeclarations(module: ASTNode) {
    ir_reset_decl_index()
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        indexTopLevel(stmt)
        p = stmt.next
    }
}

fn findStructDeclNamed(module: ASTNode, name: String) -> ASTNode {
    let n = ir_decl_count(name)
    let mut i = 0
    while (i < n) {
        let p = ir_decl_at(name, i)
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.STRUCT_DECL) { return stmt }
        i = i + 1
    }
    return ptr_to_node(ptr_null())
}

fn typeAnnIsPod(module: ASTNode, ann: ASTNode, depth: Int) -> Bool {
    return typeAnnIsPodIn(module, ann, depth, false)
}

private fn structDeclIsPod(module: ASTNode, name: String, depth: Int) -> Bool {
    return structDeclIsPodIn(module, name, depth, false)
}

// `byDecl` picks which table answers "is this name a struct", and it is the only
// difference between the two readings of this rule.
//
// The struct **registry** is filled by codegen, so during the analysis it is
// empty and the registry reading stops recursing: a struct-typed field reads as
// POD without anyone looking at its fields. For layout that over-approximation is
// the safe direction and is deliberate -- see `aifFieldIsInlineStruct`, which
// documents the corpus failure that established it.
//
// It is the **unsafe** direction for ownership. A field wrongly read as inline is
// a field reported to own nothing, which lets a caller free a value the field
// still points at. So the ownership reading passes `byDecl` and asks
// `findStructDeclNamed` -- the AST the registry is built from, and therefore an
// answer that agrees with it by construction in both phases.
fn typeAnnIsPodIn(module: ASTNode, ann: ASTNode, depth: Int, byDecl: Bool) -> Bool {
    // A containment cycle would not terminate. semaCheckStructContainment
    // rejects one before this runs, so the cap is reached only by a program that
    // has already failed, and answering false keeps that path on the old layout.
    if (depth > 16) { return false }
    if (ann.i1 == 1) { return false }
    if (ann.i2 == 1) { return false }
    if (ann.i3 == 1) { return false }
    let mut named = ir_is_struct_type_name(ann.s1) == 1
    if (byDecl) {
        named = nodeExists(node_to_ptr(findStructDeclNamed(module, ann.s1)))
    }
    if (named) {
        return structDeclIsPodIn(module, ann.s1, depth + 1, byDecl)
    }
    if (ann.s1.equals("String")) { return false }
    if (ann.s1.equals("Ptr")) { return false }
    return true
}

fn structDeclIsPodIn(module: ASTNode, name: String, depth: Int, byDecl: Bool) -> Bool {
    if (depth > 16) { return false }
    let decl = findStructDeclNamed(module, name)
    if (nodeExists(node_to_ptr(decl)) == false) { return false }
    let mut p = decl.child1
    while (nodeExists(p)) {
        let f = ptr_to_node(p)
        if (f.kind == NodeKind.STRUCT_FIELD) {
            if (nodeExists(f.child1) == false) { return false }
            if (typeAnnIsPodIn(module, ptr_to_node(f.child1), depth, byDecl) == false) {
                return false
            }
        }
        p = f.next
    }
    return true
}
