import ast.nodes
import std.string
import std.option

// Function attributes the AST has no field for: everything a function can say
// before its `fn` (src/parse/modifiers.psm).
//
// A table beside the AST rather than a field on it: FUNCTION.i1 is codegen's
// scratch state and a new field on every node costs the whole compiler for the
// sake of a few declarations. Keyed by where the `fn` keyword is, which is unique
// per declaration and survives the copy a generic instantiation makes. One record
// per line, `file:line:col|flags|align|section`; align is 0 when none was written.
//
// The flags are bits, named by the predicates below and written only through
// `fnAttrBit*`, so nothing outside this file spells a number:
//
//   how the symbol is exposed   export, naked, section("..."), align(n)
//   how the function is called  async
//   how it is inlined           inline (a hint), inline(always), noinline /
//                               inline(never) -- at most one of the three
//   how likely it is to run     cold, hot -- at most one
//   what it promises            noreturn (never returns to its caller),
//                               const (may also run at compile time)
let mut fnAttrTable = ""

private fn fnAttrKey(fnNode: ASTNode) -> String {
    let position = fnNode.file.toString().concat(":", fnNode.line.toString(), ":")
    return "\n".concat(position, fnNode.col.toString(), "|")
}

public fn nodeSetFnAttrs(fnNode: ASTNode, flags: Int, align: Int, section: String) {
    let head = fnAttrKey(fnNode).concat(flags.toString(), "|", align.toString())
    fnAttrTable = fnAttrTable.concat(head, "|", section)
}

// "" when the function carries none, else `flags|section`.
private fn fnAttrRecord(fnNode: ASTNode) -> String {
    if (fnAttrTable.equals("")) { return "" }
    let key = fnAttrKey(fnNode)
    let at = fnAttrTable.indexOf(key)
    if (at < 0) { return "" }
    let start = at + key.length
    let rest = fnAttrTable.substring(start, fnAttrTable.length - start)
    let end = rest.indexOf("\n")
    if (end < 0) { return rest.clone() }
    return rest.substring(0, end)
}

// The field after the `n`th bar of the record, "" when there is none.
private fn fnAttrField(record: String, n: Int) -> String {
    let mut rest = record.clone()
    let mut i = 0
    while (i < n) {
        let bar = rest.indexOf("|")
        if (bar < 0) { return "" }
        rest = rest.substring(bar + 1, rest.length - bar - 1)
        i = i + 1
    }
    let end = rest.indexOf("|")
    if (end < 0) { return rest }
    return rest.substring(0, end)
}

public fn nodeFnAttrFlags(fnNode: ASTNode) -> Int {
    let record = fnAttrRecord(fnNode)
    if (record.equals("")) { return 0 }
    return fnAttrField(record, 0).parseInt().unwrapOr(0)
}

public fn fnAttrBitExport() -> Int { return 1 }
public fn fnAttrBitNaked() -> Int { return 2 }
public fn fnAttrBitAsync() -> Int { return 4 }
public fn fnAttrBitInline() -> Int { return 8 }
public fn fnAttrBitInlineAlways() -> Int { return 16 }
public fn fnAttrBitNoinline() -> Int { return 32 }
public fn fnAttrBitCold() -> Int { return 64 }
public fn fnAttrBitHot() -> Int { return 128 }
public fn fnAttrBitNoreturn() -> Int { return 256 }
public fn fnAttrBitConst() -> Int { return 512 }

private fn nodeHasFnAttr(fnNode: ASTNode, bit: Int) -> Bool {
    if (fnAttrTable.equals("") or fnNode.kind != NodeKind.FUNCTION) { return false }
    return (nodeFnAttrFlags(fnNode) & bit) == bit
}

public fn nodeIsExported(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitExport()) }
public fn nodeIsNaked(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitNaked()) }

// `async fn`. A call to one does not run it: it yields a `Future<R>`, and the body
// runs when that future is awaited or spawned. The body itself is compiled as an
// ordinary function returning R, which is why a flag is all the declaration needs.
public fn nodeIsAsync(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitAsync()) }

// `inline fn`: LLVM's `inlinehint`, a nudge to the inliner that the body is cheap
// enough to be worth folding in. Rust's `#[inline]`.
public fn nodeIsInlineHint(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitInline()) }

// `inline(always) fn`: LLVM's `alwaysinline`, folded into every caller whatever its
// size. Rust's `#[inline(always)]`.
public fn nodeIsInlineAlways(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitInlineAlways()) }

// `noinline fn` and `inline(never) fn`: never folded into a caller. Two spellings of
// one request; `noinline` is the one the compiler's own sources use.
public fn nodeIsNoinline(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitNoinline()) }

// `cold fn`: a function that rarely runs -- an error path, or the slow half of an
// operation split so the fast half can be inlined. Never inlined (LLVM's `cold`
// and `noinline`), and a branch that calls it is laid out as the unlikely one.
public fn nodeIsCold(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitCold()) }

// `hot fn`: a function that runs often. LLVM's `hot`: optimised for speed even in
// a size-optimised build, and placed with the other hot code.
public fn nodeIsHot(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitHot()) }

// `noreturn fn`: control never comes back from a call to it. Sema holds the body to
// that (semaCheckNoreturn) and reads the marker to end the path at a call.
public fn nodeIsNoreturn(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitNoreturn()) }

// `const fn`: an ordinary function that a constant expression may also call
// (src/sema/const_eval.psm).
public fn nodeIsConstFn(fnNode: ASTNode) -> Bool { return nodeHasFnAttr(fnNode, fnAttrBitConst()) }

// A function that is never folded into a caller, for any of the three reasons.
// Its callsites are not counted toward the single-callsite inlining heuristic.
public fn nodeIsNeverInlined(fnNode: ASTNode) -> Bool {
    if (fnAttrTable.equals("")) { return false }
    return (nodeFnAttrFlags(fnNode) & (fnAttrBitNoinline() | fnAttrBitCold() | fnAttrBitNaked())) != 0
}

public fn nodeFnAlign(fnNode: ASTNode) -> Int {
    let record = fnAttrRecord(fnNode)
    if (record.equals("")) { return 0 }

    return fnAttrField(record, 1).parseInt().unwrapOr(0)
}

// The section is last, so a name that contains a bar is still whole.
public fn nodeFnSection(fnNode: ASTNode) -> String {
    let record = fnAttrRecord(fnNode)
    if (record.equals("")) { return "" }
    let first = record.indexOf("|")
    let second = record.substring(first + 1, record.length - first - 1).indexOf("|")
    let start = first + second + 2
    return record.substring(start, record.length - start)
}
