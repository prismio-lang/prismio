import std.collections.vec
import ast.nodes
import std.string
import std.core.option

// The `lang("id")` marker: which library declarations are what the language itself asks the
// library for (`==` needs the equality trait, `for` needs the iterator trait, ...). A declaration says
// what it is, so the compiler never spells a library module or a declaration's name.
//
// A table beside the AST, for the reason fn_attrs.psm gives: a field on every node costs the whole
// compiler for the sake of a few declarations. Keyed by where the declaration node sits, which is
// unique and survives the copy a generic instantiation makes. One record per line,
// `file:line:col|id`.
let mut langMarkTable = ""

private fn langMarkKey(node: ASTNode) -> String {
    let position = node.file.toString().concat(":", node.line.toString(), ":")
    return "\n".concat(position, node.col.toString(), "|")
}

// Every marked declaration, in the order the parser met them: parallel columns, `langIds[i]` is the id of
// the declaration at `langNodes[i]`. An id may be carried by several declarations (the overloads of one
// function, a name a library spells for more than one type). A zero-filled global `Vec` is not an empty
// one, hence `langOpened`.
let mut langIds: Vec<String>
let mut langNodes: Vec<Ptr>
let mut langOpened = false

private fn langOpen() {
    if (langOpened) { return }
    langIds = []
    langNodes = []
    langOpened = true
}

let mut langRefIds: Vec<String>
let mut langRefNodes: Vec<Ptr>
let mut langRefOpened = false

// Called before a compile parses anything. One process compiles several times -- each target of a project,
// each section of a PLIB -- and a mark left from an earlier compile would name that compile's declaration.
public fn langMarksReset() {
    langMarkTable = "".clone()
    langIds = []
    langNodes = []
    langOpened = true
    langRefIds = []
    langRefNodes = []
    langRefOpened = true
}

public fn nodeSetLangMark(node: ASTNode, id: String) {
    langMarkTable = langMarkTable.concat(langMarkKey(node), id)
    langOpen()
    langIds.push(id.clone())
    langNodes.push(node_to_ptr(node))
}

// How many declarations carry `id`, and the `n`th of them in source order.
public fn langDeclarationCount(id: String) -> Int {
    langOpen()
    let mut found = 0
    for i in 0..<langIds.length {
        if (langIds[i].equals(id)) { found = found + 1 }
    }
    return found
}

public fn langDeclarationAt(id: String, n: Int) -> ASTNode {
    langOpen()
    let mut seen = 0
    for i in 0..<langIds.length {
        if (langIds[i].equals(id) == false) { continue }
        if (seen == n) { return ptr_to_node(langNodes[i]) }
        seen = seen + 1
    }
    return createNode(NodeKind.ERROR_NODE)
}

// "" for a declaration that carries no marker.
public fn nodeLangMark(node: ASTNode) -> String {
    if (langMarkTable.equals("")) { return "" }
    let key = langMarkKey(node)
    let at = langMarkTable.indexOf(key)
    if (at < 0) { return "" }
    let start = at + key.length
    let rest = langMarkTable.substring(start, langMarkTable.length - start)
    let end = rest.indexOf("\n")
    if (end < 0) { return rest.clone() }
    return rest.substring(0, end)
}

// Whether any declaration of this compile has been marked. A program that imports no library
// module that carries one never pays for a search.
public fn langMarksExist() -> Bool {
    return langMarkTable.equals("") == false
}

// References the parser writes before any library is read. The parser cannot name `Result` or `Tuple2`:
// it runs before the merge, and a library declaration says what it is by its marker, not by a name the
// parser could know. It writes `$lang.<id>` (`langReferenceName`) and records the node here; the driver
// replaces each with the declared name once the merge has read the library (`langResolveReferences`).
// "$" is in no source identifier, so a placeholder cannot be written by hand.

private fn langRefOpen() {
    if (langRefOpened) { return }
    langRefIds = []
    langRefNodes = []
    langRefOpened = true
}

public fn langReferenceName(id: String) -> String {
    return "$lang.".concat(id)
}

// Makes `node` a reference to the declaration that carries `id`: its name is the placeholder until resolved.
public fn nodeSetLangReference(node: ASTNode, id: String) {
    langRefOpen()
    node.s1 = langReferenceName(id)
    langRefIds.push(id.clone())
    langRefNodes.push(node_to_ptr(node))
}

// Gives every recorded reference the name of its declaration. Answers the first reference whose item no
// merged module declares, or a null pointer when all resolved; that reference keeps its placeholder, and
// the driver reports it.
public fn langResolveReferences() -> Ptr {
    langRefOpen()
    let mut missing: Ptr = ptr_null()
    for i in 0..<langRefIds.length {
        let id = langRefIds[i]
        if (langDeclarationCount(id) == 0) {
            if (nodeIsNull(missing)) { missing = langRefNodes[i] }
            continue
        }
        ptr_to_node(langRefNodes[i]).s1 = langDeclarationAt(id, 0).s1.clone()
    }
    return missing
}
