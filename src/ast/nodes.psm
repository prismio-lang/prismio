// AST Node Kinds
//
// **NEVER_ZERO must stay first, and nothing may take ordinal 0.** See
// nodeExists below: an ASTNode is punned as a String, an absent slot is the
// empty string, and a node whose first byte is NUL is indistinguishable from
// one. `kind` is the first field, so a zero-valued kind makes a live node read
// as an empty slot -- which is what `MODULE` at ordinal 0 used to do to every
// module root.
enum NodeKind {
    // Not a node. Exists to keep every real kind's low byte non-zero.
    NEVER_ZERO,

    MODULE,

    // Declarations
    IMPORT_STATEMENT,
    EXTERN_FUNCTION,
    VARIABLE_DECL,
    FUNCTION,
    STRUCT_DECL,
    ENUM_DECL,
    TRAIT_DECL,
    IMPL_DECL,
    // LAYOUT 3. A build-time declaration, never part of the shipped program
    // (W1), so it is a declaration kind rather than a statement one: every walk
    // that emits code has to answer "no" for it, and a kind is what those walks
    // already switch on. Same reasoning NONE_LITERAL_EXPR records below.
    WORKLOAD_DECL,

    // Statements
    BLOCK,
    IF_STATEMENT,
    MATCH_STATEMENT,
    FOR_STATEMENT,
    WHILE_STATEMENT,
    LOOP_STATEMENT,
    RETURN_STATEMENT,
    ASSIGNMENT_STATEMENT,
    EXPRESSION_STATEMENT,
    BREAK_STATEMENT,
    CONTINUE_STATEMENT,
    REGION_STATEMENT,

    // Expressions
    BINARY_EXPR,
    UNARY_EXPR,
    LITERAL_EXPR,
    IDENTIFIER_EXPR,
    CALL_EXPR,
    MEMBER_ACCESS_EXPR,
    INDEX_EXPR,
    ARRAY_LITERAL_EXPR,
    STRUCT_LITERAL_EXPR,
    CAST_EXPR,
    // REQUIREMENTS 4. The absent reference. Its own kind rather than a
    // LITERAL_EXPR with a marker, because every walk that asks "does this
    // expression allocate" has to answer *no* for it, and a kind is the thing
    // those walks already switch on.
    NONE_LITERAL_EXPR,
    // REQUIREMENTS 15. `spawn f(a, b)` and `join t`.
    //
    // Their own kinds rather than a CALL_EXPR with a marker, for the reason
    // NONE_LITERAL_EXPR gives one line up and one more that is specific to
    // these: AIF asks "does this call hand its arguments to another task", and
    // INFERENCE 4.1's E-SPAWN answers differently from E-CALL for every
    // argument. A walk that had to re-derive that from a flag on a CALL_EXPR
    // would get it right in sema and wrong in the three walks that only switch
    // on the kind.
    //
    // SPAWN_EXPR.child1 is the CALL_EXPR being spawned -- kept whole so the
    // existing argument checking, move checking and lowering apply unchanged.
    // JOIN_EXPR.child1 is the task handle.
    SPAWN_EXPR,
    JOIN_EXPR,

    // Other
    FUNCTION_PARAMETER,
    TYPE_ANNOTATION,
    STRUCT_FIELD,
    ENUM_VARIANT,
    MATCH_ARM,

    // Placeholder for a declaration the parser could not make sense of. It is
    // dropped by parseModule rather than appended, so nothing downstream ever
    // sees one -- it exists only so recovery has something to return.
    ERROR_NODE,

    // M4.1. `a[start..end]`, kept at the end so adding it does not renumber the
    // NodeKind ordinals the self-hosted seed and test_41 exercise.
    // child1 is the List/Slice base, child2 the inclusive start, and child3 the
    // exclusive end. Codegen lowers it to `(handle, offset, length)` -- never an
    // interior pointer -- as SPEC 8.4 requires.
    SLICE_EXPR,

    // v0.1 3.4. `|a: Int| a + 1`. child1 is the parameter chain, child2 the body
    // expression. It exists only between the parser and semaExpr: the lowering
    // rewrites the node **in place** into the STRUCT_LITERAL_EXPR that builds the
    // closure's captures, so no pass after sema ever sees one. That in-place
    // rewrite is also what makes the lowering idempotent, which it has to be --
    // semaExpr runs over an argument more than once.
    //
    // Last, for the reason SLICE_EXPR is: adding a kind in the middle renumbers
    // the ordinals the committed seed and test_41 depend on.
    CLOSURE_EXPR
}

// Flat AST Node using String for pointers (type punning)
//
// The trailing four fields are the source span: where this node started, and how
// wide its first token was. `file` is an id into the registry in
// runtime/diagnostics.c rather than a path, because `resolveImports` flattens
// every module into one AST -- after that, a node's file is knowable only from
// the node itself.
struct ASTNode {
    kind: NodeKind,
    s1: String,
    s2: String,
    i1: Int,
    i2: Int,
    // REQUIREMENTS 4. On a TYPE_ANNOTATION, whether the type was written `T?`.
    // Its own slot rather than a bit in i2, because i1 and i2 already mean
    // "array" and "list" and a nullable list is both.
    //
    // On a FUNCTION, i1 is codegen's general single-callsite/loop-inline state.
    // It is recomputed before every emission and lowers to `alwaysinline` only
    // when the function is the sole source call in its nearest loop. i2 remains
    // the declaration's visibility.
    //
    // On a FUNCTION_PARAMETER it means something unrelated -- v0.1 3.2's "this
    // was written as a bare `self` in an `impl` block" -- and the two cannot
    // collide because no node is both kinds. On a FUNCTION it is codegen's
    // "needs a task thunk" (ir/module.psm), for the same reason.
    i3: Int,
    child1: Ptr, // ASTNode
    child2: Ptr, // ASTNode
    child3: Ptr, // ASTNode
    next: Ptr,   // ASTNode (for linked lists)
    typeInfo: Ptr, // TypeInfo assigned by sema
    line: Int,
    col: Int,
    len: Int,
    file: Int
}

// Both are the identity on a pointer (runtime/lang_runtime.c), so the result is
// the argument -- `alias` in FFI 5.2's vocabulary. Saying so is not decoration:
// without it the analysis must treat every `ptr_to_node` result as an extern
// return of unknown provenance, which means Shared, which A-STORE then spreads
// to everything stored through the resulting node. That single omission was
// most of the compiler's own T3 population.
extern fn ptr_null() -> Ptr
extern fn ptr_is_null(p: Ptr) -> Int
extern fn ptr_to_node(ptr: Ptr) -> ASTNode alias
extern fn node_to_ptr(node: ASTNode borrow) -> Ptr alias


// Is there a node here?
//
// **Use these two rather than spelling out `strEquals(ptr, "")`.** Not because
// the spelling is long, but because it is only correct under an invariant that
// has to be written down somewhere, and this is that place.
//
// An absent slot is the **empty string** -- createNode initialises every
// pointer slot to "" -- so a null-pointer test is the wrong question and would
// report an empty slot as present. `str_equals` is the right question. The trap
// is the other direction: a punned pointer is a `char*`, so str_equals compares
// the *bytes of the node*, and `kind` is the first field. A node whose kind is 0
// begins with a NUL byte and is byte-for-byte indistinguishable from an empty
// slot.
//
// > **INVARIANT: no type punned through String may have a zero-valued first
// > field.** NodeKind and TypeKind both reserve ordinal 0 for this reason.
//
// This held by luck until something tested a module root: `MODULE` was ordinal
// 0, so every successfully parsed module reported as absent. Every other test in
// the compiler is on a `child`/`next` slot, where the kinds that occur happen to
// be non-zero.
//
// The invariant is little-endian: it is the *low* byte of an i32 kind that lands
// first. So does the punning scheme as a whole -- on big-endian every kind below
// 2^24 has a zero first byte, so every node would read as absent with or without
// this. Moving pointer slots from "" to a real null pointer would fix both and
// is the right eventual answer; it touches every slot assignment in the frontend
// and is not this change.
fn nodeExists(ptr: Ptr) -> Bool {
    return ptr_is_null(ptr) == 0
}

fn nodeIsNull(ptr: Ptr) -> Bool {
    return ptr_is_null(ptr) == 1
}

// The span is left at zero. Anything the parser builds should come from
// parserNode() instead, which stamps the current token; a zero span here means
// "synthesised, no source to point at", and the renderer degrades to a message
// with no snippet rather than pointing somewhere wrong.
fn createNode(kind: NodeKind) -> ASTNode {
    return ASTNode {
        kind: kind,
        s1: "",
        s2: "",
        i1: 0,
        i2: 0,
        i3: 0,
        child1: ptr_null(),
        child2: ptr_null(),
        child3: ptr_null(),
        next: ptr_null(),
        typeInfo: ptr_null(),
        line: 0,
        col: 0,
        len: 0,
        file: 0
    }
}

// Copies a span from one node to another. Used where a node is built from
// another's position -- desugaring `x += 1`, or attributing a synthesised node to
// the construct that implied it.
fn nodeSpanFrom(target: ASTNode, source: ASTNode) {
    target.line = source.line
    target.col = source.col
    target.len = source.len
    target.file = source.file
}

// A sibling chain under construction.
//
// Every list in the AST -- parameters, fields, variants, statements, arguments,
// match arms, array elements -- is a `next`-linked chain hanging off a child
// slot. Building one is four lines of "is this the first, or does it go after the
// tail", and the parser had written those four lines out ten times. Each copy is
// individually trivial and collectively the easiest place in the frontend to make
// a silent mistake: link through the wrong tail and the list simply ends early,
// with no diagnostic and no crash.
struct NodeList {
    head: Ptr,
    tail: Ptr
}

fn nodeList() -> NodeList {
    return NodeList { head: ptr_null(), tail: ptr_null() }
}

// node_to_ptr is the identity on a borrow, so naming it three times costs
// nothing and avoids moving a pointer that both slots need.
fn nodeListPush(list: NodeList, node: ASTNode) {
    if (nodeIsNull(list.head)) {
        list.head = node_to_ptr(node)
    } else {
        let tail = ptr_to_node(list.tail)
        tail.next = node_to_ptr(node)
    }
    list.tail = node_to_ptr(node)
}
