// AST dump -- emits the post-sema AST as JSON on stdout.
//
// Deliberately *generic*: every node emits the same shape, with the raw s1/s2/
// i1/i2 slots and the three child chains, and no attempt is made to interpret
// what those slots mean for a given kind. All semantic reading happens in the
// consumer (tools/aif/), where changing an interpretation costs an edit rather
// than a rebuild and a bootstrap.
//
// Child slots are emitted as arrays: each of child1/child2/child3 is walked
// along `next` and flattened. That keeps JSON nesting proportional to AST depth
// rather than to list length -- a 400-statement function would otherwise nest
// 400 deep and overflow a consumer's recursion limit.
//
// Used by `prismio dump-ast`. Produces no IR and touches no codegen.

import ast.nodes
import ast.types
import common.text
import common.diagnostics

extern fn str_from_char(c: Char) -> String
extern fn str_equals(s1: String, s2: String) -> Int
extern fn int_to_str(value: Int) -> String

fn hexDigit(v: Int) -> String {
    if (v == 0) { return "0" }
    else if (v == 1) { return "1" }
    else if (v == 2) { return "2" }
    else if (v == 3) { return "3" }
    else if (v == 4) { return "4" }
    else if (v == 5) { return "5" }
    else if (v == 6) { return "6" }
    else if (v == 7) { return "7" }
    else if (v == 8) { return "8" }
    else if (v == 9) { return "9" }
    else if (v == 10) { return "a" }
    else if (v == 11) { return "b" }
    else if (v == 12) { return "c" }
    else if (v == 13) { return "d" }
    else if (v == 14) { return "e" }
    return "f"
}

// Bytes, not characters: emitting one byte at a time reproduces the original
// UTF-8 sequence unchanged, so non-ASCII in a string literal or an identifier
// survives without needing to be decoded first.
fn jsonString(s: String) {
    print("\"")
    let n = __builtin_string_len(s)
    let mut i = 0
    while (i < n) {
        let b = __builtin_string_byte_at(s, i)
        let c = charCode(b)
        if (c == 34) { print("\\\"") }
        else if (c == 92) { print("\\\\") }
        else if (c == 10) { print("\\n") }
        else if (c == 13) { print("\\r") }
        else if (c == 9) { print("\\t") }
        else if (c >= 0 and c < 32) {
            print("\\u00")
            let hi = c / 16
            print(hexDigit(hi))
            print(hexDigit(c - hi * 16))
        }
        else { print(str_from_char(b)) }
        i = i + 1
    }
    print("\"")
}

fn jsonFieldStr(name: String, value: String) {
    print("\"")
    print(name)
    print("\":")
    jsonString(value)
}

fn jsonFieldInt(name: String, value: Int) {
    print("\"")
    print(name)
    print("\":")
    print(int_to_str(value))
}

// Names rather than ordinals, so the consumer never depends on the declaration
// order of NodeKind in ast.psm. Adding a kind without adding it here yields
// "UNKNOWN", which the consumer rejects loudly rather than silently misreading.
fn nodeKindName(k: NodeKind) -> String {
    if (k == NodeKind.MODULE) { return "MODULE" }
    else if (k == NodeKind.IMPORT_STATEMENT) { return "IMPORT_STATEMENT" }
    else if (k == NodeKind.EXTERN_FUNCTION) { return "EXTERN_FUNCTION" }
    else if (k == NodeKind.VARIABLE_DECL) { return "VARIABLE_DECL" }
    else if (k == NodeKind.FUNCTION) { return "FUNCTION" }
    else if (k == NodeKind.STRUCT_DECL) { return "STRUCT_DECL" }
    else if (k == NodeKind.ENUM_DECL) { return "ENUM_DECL" }
    else if (k == NodeKind.TRAIT_DECL) { return "TRAIT_DECL" }
    else if (k == NodeKind.IMPL_DECL) { return "IMPL_DECL" }
    else if (k == NodeKind.BLOCK) { return "BLOCK" }
    else if (k == NodeKind.IF_STATEMENT) { return "IF_STATEMENT" }
    else if (k == NodeKind.MATCH_STATEMENT) { return "MATCH_STATEMENT" }
    else if (k == NodeKind.FOR_STATEMENT) { return "FOR_STATEMENT" }
    else if (k == NodeKind.WHILE_STATEMENT) { return "WHILE_STATEMENT" }
    else if (k == NodeKind.LOOP_STATEMENT) { return "LOOP_STATEMENT" }
    else if (k == NodeKind.RETURN_STATEMENT) { return "RETURN_STATEMENT" }
    else if (k == NodeKind.ASSIGNMENT_STATEMENT) { return "ASSIGNMENT_STATEMENT" }
    else if (k == NodeKind.EXPRESSION_STATEMENT) { return "EXPRESSION_STATEMENT" }
    else if (k == NodeKind.BREAK_STATEMENT) { return "BREAK_STATEMENT" }
    else if (k == NodeKind.CONTINUE_STATEMENT) { return "CONTINUE_STATEMENT" }
    else if (k == NodeKind.REGION_STATEMENT) { return "REGION_STATEMENT" }
    else if (k == NodeKind.BINARY_EXPR) { return "BINARY_EXPR" }
    else if (k == NodeKind.UNARY_EXPR) { return "UNARY_EXPR" }
    else if (k == NodeKind.LITERAL_EXPR) { return "LITERAL_EXPR" }
    else if (k == NodeKind.IDENTIFIER_EXPR) { return "IDENTIFIER_EXPR" }
    else if (k == NodeKind.CALL_EXPR) { return "CALL_EXPR" }
    else if (k == NodeKind.MEMBER_ACCESS_EXPR) { return "MEMBER_ACCESS_EXPR" }
    else if (k == NodeKind.INDEX_EXPR) { return "INDEX_EXPR" }
    else if (k == NodeKind.ARRAY_LITERAL_EXPR) { return "ARRAY_LITERAL_EXPR" }
    else if (k == NodeKind.STRUCT_LITERAL_EXPR) { return "STRUCT_LITERAL_EXPR" }
    else if (k == NodeKind.CAST_EXPR) { return "CAST_EXPR" }
    // REQUIREMENTS 15. Named here or the oracle sees "UNKNOWN", falls into its
    // generic child walk, and reads `spawn f(a)` as an ordinary call to f --
    // which would have it derive Isolated where the compiler derives
    // Transferred. The differential would then disagree on every concurrent
    // program, and the two would be *right* to disagree, which is the worst
    // kind of failure this dump can produce.
    else if (k == NodeKind.SPAWN_EXPR) { return "SPAWN_EXPR" }
    else if (k == NodeKind.JOIN_EXPR) { return "JOIN_EXPR" }
    else if (k == NodeKind.FUNCTION_PARAMETER) { return "FUNCTION_PARAMETER" }
    else if (k == NodeKind.TYPE_ANNOTATION) { return "TYPE_ANNOTATION" }
    else if (k == NodeKind.STRUCT_FIELD) { return "STRUCT_FIELD" }
    else if (k == NodeKind.ENUM_VARIANT) { return "ENUM_VARIANT" }
    else if (k == NodeKind.MATCH_ARM) { return "MATCH_ARM" }
    else if (k == NodeKind.ERROR_NODE) { return "ERROR_NODE" }
    return "UNKNOWN"
}

fn dumpChain(head: Ptr) {
    print("[")
    let mut p = head
    let mut first = true
    while (nodeExists(p)) {
        if (first == false) { print(",") }
        first = false
        let node = ptr_to_node(p)
        dumpNode(p)
        p = node.next
    }
    print("]")
}

fn dumpNode(ptr: Ptr) {
    let n = ptr_to_node(ptr)

    print("{")
    jsonFieldStr("k", nodeKindName(n.kind))
    print(",")
    jsonFieldStr("s1", n.s1)
    print(",")
    jsonFieldStr("s2", n.s2)
    print(",")
    jsonFieldInt("i1", n.i1)
    print(",")
    jsonFieldInt("i2", n.i2)
    print(",")
    jsonFieldInt("ln", n.line)
    print(",")
    jsonFieldInt("co", n.col)
    print(",")
    jsonFieldInt("le", n.len)
    print(",")
    jsonFieldInt("fi", n.file)

    // The type sema resolved for this node, rendered the way diagnostics render
    // it. Absent on nodes sema does not type (statements, declarations).
    print(",")
    if (nodeExists(n.typeInfo)) {
        jsonFieldStr("ty", typeDisplay(ptr_to_type(n.typeInfo)))
    } else {
        jsonFieldStr("ty", "")
    }

    print(",\"c1\":")
    dumpChain(n.child1)
    print(",\"c2\":")
    dumpChain(n.child2)
    print(",\"c3\":")
    dumpChain(n.child3)
    print("}")
}

// Probing rather than counting: the registry has no size accessor. An
// unregistered id reports "<unknown>" rather than an empty string, so both are
// treated as the end. 4096 is far past any real import graph.
fn dumpFileTable() {
    print("[")
    let mut i = 0
    let mut first = true
    while (i < 4096) {
        let path = diag_file_path(i)
        if (str_equals(path, "") == 1 or str_equals(path, "<unknown>") == 1) {
            i = 4096
        } else {
            if (first == false) { print(",") }
            first = false
            print("{")
            jsonFieldInt("id", i)
            print(",")
            jsonFieldStr("path", path)
            print("}")
            i = i + 1
        }
    }
    print("]")
}

fn dumpAstJson(root: ASTNode, sourcePath: String, compilerVersion: String) {
    print("{")
    jsonFieldStr("format", "aif-ast")
    print(",")
    jsonFieldInt("version", 1)
    print(",")
    jsonFieldStr("source", sourcePath)
    print(",")
    jsonFieldStr("compiler", compilerVersion)
    print(",\"files\":")
    dumpFileTable()
    print(",\"decls\":")
    dumpChain(root.child1)
    println("}")
}
