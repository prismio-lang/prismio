import lexer
import token
import utils
import ast

struct Parser {
    current: String // Token pointer
}

fn parser_create(tokens: Token) -> Parser {
    return Parser { current: token_to_ptr(tokens) }
}

fn parser_current(p: Parser) -> Token {
    return ptr_to_token(p.current)
}

fn parser_peek(p: Parser) -> Token {
    let curr = ptr_to_token(p.current)
    return ptr_to_token(curr.tok_next)
}

fn parser_advance(p: Parser) {
    let curr = ptr_to_token(p.current)
    if (curr.type != TokenType.EOF) {
        p.current = curr.tok_next
    }
}

fn parser_check(p: Parser, t: TokenType) -> Bool {
    let curr = parser_current(p)
    return curr.type == t
}

fn parser_check_val(p: Parser, t: TokenType, val: String) -> Bool {
    let curr = parser_current(p)
    return curr.type == t and str_equals(curr.value, val) == 1
}

fn parser_match(p: Parser, t: TokenType) -> Bool {
    if (parser_check(p, t)) {
        parser_advance(p)
        return true
    }
    return false
}

fn parser_match_val(p: Parser, t: TokenType, val: String) -> Bool {
    if (parser_check_val(p, t, val)) {
        parser_advance(p)
        return true
    }
    return false
}

extern fn exit(code: Int)

fn parser_expect(p: Parser, t: TokenType, context: String) {
    if (parser_check(p, t) == false) {
        print("Error in ") print(context) print(": Expected token type ") println_int(t)
        exit(1)
    }
    parser_advance(p)
}

fn parser_expect_val(p: Parser, t: TokenType, val: String, context: String) {
    if (parser_check_val(p, t, val) == false) {
        print("Error in ") print(context) print(": Expected token '") print(val) println("'")
        exit(1)
    }
    parser_advance(p)
}

// ---------------------------------------------------------
// Forward Declarations
// ---------------------------------------------------------
extern fn parse_declaration(p: Parser) -> ASTNode
extern fn parse_type_annotation(p: Parser) -> ASTNode
extern fn parse_variable_decl(p: Parser) -> ASTNode
extern fn parse_extern_fn_decl(p: Parser) -> ASTNode
extern fn parse_function_decl(p: Parser) -> ASTNode
extern fn parse_struct_decl(p: Parser) -> ASTNode
extern fn parse_enum_decl(p: Parser) -> ASTNode
extern fn parse_block(p: Parser) -> ASTNode
extern fn parse_statement(p: Parser) -> ASTNode
extern fn parse_expression(p: Parser, precedence: Int) -> ASTNode
extern fn parse_primary(p: Parser) -> ASTNode
extern fn parse_module(p: Parser) -> ASTNode

// ---------------------------------------------------------
// Declarations
// ---------------------------------------------------------

fn parse_import_statement(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "import", "import statement")
    
    let import_node = create_node(NodeKind.IMPORT_STATEMENT)
    let curr = parser_current(p)
    import_node.s1 = curr.value
    
    if (curr.type == TokenType.IDENTIFIER or curr.type == TokenType.KEYWORD) {
        parser_advance(p)
    } else {
        println("Expected module name")
        exit(1)
    }
    
    return import_node
}

fn parse_declaration(p: Parser) -> ASTNode {
    if (parser_check_val(p, TokenType.KEYWORD, "import")) {
        return parse_import_statement(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "let")) {
        return parse_variable_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "extern")) {
        return parse_extern_fn_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "fn")) {
        return parse_function_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "struct")) {
        return parse_struct_decl(p)
    }
    if (parser_check_val(p, TokenType.KEYWORD, "enum")) {
        return parse_enum_decl(p)
    }
    
    // Add other declarations as needed
    println("Unknown declaration")
    exit(1)
    return create_node(NodeKind.MODULE) // Unreachable
}

fn parse_type_annotation(p: Parser) -> ASTNode {
    let type_node = create_node(NodeKind.TYPE_ANNOTATION)
    
    if (parser_match_val(p, TokenType.SEPARATOR, "[")) {
        type_node.i1 = 1 // is_array
        type_node.child1 = node_to_ptr(parse_type_annotation(p))
        parser_expect_val(p, TokenType.SEPARATOR, "]", "array type")
        return type_node
    }
    
    let curr = parser_current(p)
    if (curr.type == TokenType.IDENTIFIER or curr.type == TokenType.KEYWORD) {
        type_node.s1 = curr.value
        parser_advance(p)
    } else {
        println("Expected type name")
        exit(1)
    }
    
    return type_node
}

fn parse_variable_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "let", "variable declaration")
    let var_node = create_node(NodeKind.VARIABLE_DECL)
    
    if (parser_match_val(p, TokenType.KEYWORD, "mut")) {
        var_node.i1 = 1 // is_mutable
    }
    
    let curr = parser_current(p)
    var_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "variable name")
    
    if (parser_match_val(p, TokenType.SEPARATOR, ":")) {
        var_node.child1 = node_to_ptr(parse_type_annotation(p))
    }
    
    if (parser_match_val(p, TokenType.ASSIGNMENT_OPERATOR, "=")) {
        var_node.child2 = node_to_ptr(parse_expression(p, 0))
    }
    
    return var_node
}

fn parse_extern_fn_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "extern", "extern fn")
    parser_expect_val(p, TokenType.KEYWORD, "fn", "extern fn")
    
    let ext_node = create_node(NodeKind.EXTERN_FUNCTION)
    let curr = parser_current(p)
    ext_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "function name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "(", "params")
    
    let last_param = ""
    if (parser_check_val(p, TokenType.SEPARATOR, ")") == false) {
        let is_looping = true
        while (is_looping) {
            let param = create_node(NodeKind.FUNCTION_PARAMETER)
            let curr = parser_current(p)
            param.s1 = curr.value
            parser_expect(p, TokenType.IDENTIFIER, "parameter name")
            parser_expect_val(p, TokenType.SEPARATOR, ":", "parameter type")
            param.child1 = node_to_ptr(parse_type_annotation(p))
            
            if (str_equals(ext_node.child1, "") == 1) {
                ext_node.child1 = node_to_ptr(param)
            } else {
                let last = ptr_to_node(last_param)
                last.next = node_to_ptr(param)
            }
            last_param = node_to_ptr(param)
            
            if (parser_match_val(p, TokenType.SEPARATOR, ",") == false) {
                is_looping = false
            }
        }
    }
    parser_expect_val(p, TokenType.SEPARATOR, ")", "params")
    
    if (parser_match_val(p, TokenType.ARROW, "->")) {
        ext_node.child2 = node_to_ptr(parse_type_annotation(p))
    }
    
    return ext_node
}

fn parse_function_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "fn", "function")
    
    let fn_node = create_node(NodeKind.FUNCTION)
    let curr = parser_current(p)
    fn_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "function name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "(", "params")
    
    let last_param = ""
    if (parser_check_val(p, TokenType.SEPARATOR, ")") == false) {
        let is_looping = true
        while (is_looping) {
            let param = create_node(NodeKind.FUNCTION_PARAMETER)
            let curr = parser_current(p)
            param.s1 = curr.value
            parser_expect(p, TokenType.IDENTIFIER, "parameter name")
            parser_expect_val(p, TokenType.SEPARATOR, ":", "parameter type")
            param.child1 = node_to_ptr(parse_type_annotation(p))
            
            if (str_equals(fn_node.child1, "") == 1) {
                fn_node.child1 = node_to_ptr(param)
            } else {
                let last = ptr_to_node(last_param)
                last.next = node_to_ptr(param)
            }
            last_param = node_to_ptr(param)
            
            if (parser_match_val(p, TokenType.SEPARATOR, ",") == false) {
                is_looping = false
            }
        }
    }
    parser_expect_val(p, TokenType.SEPARATOR, ")", "params")
    
    if (parser_match_val(p, TokenType.ARROW, "->")) {
        fn_node.child3 = node_to_ptr(parse_type_annotation(p)) // child3 is ret_type
    }
    
    fn_node.child2 = node_to_ptr(parse_block(p)) // child2 is body
    
    return fn_node
}

fn parse_struct_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "struct", "struct")
    
    let struct_node = create_node(NodeKind.STRUCT_DECL)
    let curr = parser_current(p)
    struct_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "struct name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "{", "struct body")
    
    let last_field = ""
    while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
        let field = create_node(NodeKind.STRUCT_FIELD)
        let curr = parser_current(p)
        field.s1 = curr.value
        parser_expect(p, TokenType.IDENTIFIER, "field name")
        parser_expect_val(p, TokenType.SEPARATOR, ":", "field type")
        field.child1 = node_to_ptr(parse_type_annotation(p))
        
        if (str_equals(struct_node.child1, "") == 1) {
            struct_node.child1 = node_to_ptr(field)
        } else {
            let last = ptr_to_node(last_field)
            last.next = node_to_ptr(field)
        }
        last_field = node_to_ptr(field)
        
        parser_match_val(p, TokenType.SEPARATOR, ",")
    }
    
    parser_expect_val(p, TokenType.SEPARATOR, "}", "struct body")
    return struct_node
}

fn parse_enum_decl(p: Parser) -> ASTNode {
    parser_expect_val(p, TokenType.KEYWORD, "enum", "enum")
    
    let enum_node = create_node(NodeKind.ENUM_DECL)
    let curr = parser_current(p)
    enum_node.s1 = curr.value
    parser_expect(p, TokenType.IDENTIFIER, "enum name")
    
    parser_expect_val(p, TokenType.SEPARATOR, "{", "enum body")
    
    let last_var = ""
    while (parser_check_val(p, TokenType.SEPARATOR, "}") == false) {
        let variant = create_node(NodeKind.ENUM_VARIANT)
        let curr = parser_current(p)
        variant.s1 = curr.value
        parser_expect(p, TokenType.IDENTIFIER, "variant name")
        
        if (str_equals(enum_node.child1, "") == 1) {
            enum_node.child1 = node_to_ptr(variant)
        } else {
            let last = ptr_to_node(last_var)
            last.next = node_to_ptr(variant)
        }
        last_var = node_to_ptr(variant)
        
        parser_match_val(p, TokenType.SEPARATOR, ",")
    }
    
    parser_expect_val(p, TokenType.SEPARATOR, "}", "enum body")
    return enum_node
}
