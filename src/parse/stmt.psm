// Statements: blocks, control flow, assignment.

import lexer.token
import lexer.scanner
import common.text
import ast.nodes
import common.diagnostics
import std.string
import std.option

impl Parser {
    internal fn parseBlock(self) -> ASTNode {
        let open = self.current()
        self.expectVal(TokenType.SEPARATOR, "{", "block")
        let blockNode = self.node(NodeKind.BLOCK)

        let statements = nodeList()
        let hoistMark = self.hoistTail
        let mut declaredNested = false
        while (self.checkVal(TokenType.SEPARATOR, "}") == false) {
            // Without this the loop spins at EOF until some inner parser happens to
            // fail, and blames whatever it was looking at instead of the brace that
            // was never closed.
            if (self.dead == 1) { break }
            if (self.check(TokenType.EOF)) {
                diag_error_at_code("P3301", open.file, open.line, open.col, open.len,
                              "this block is never closed; reached end of file looking for `}`")
                self.abandon()
                break
            }
            if (self.atNestedFn()) {
                self.parseNestedFn()
                declaredNested = true
                continue
            }
            nodeListPush(statements, self.parseStatement())
        }
        if (declaredNested) { self.renameNestedCalls(statements.head, hoistMark) }

        // The closing brace, before it is consumed. A block's own span starts at `{`
        // and there was nothing recording where it ended, so every scope drop, arena
        // pop and region exit -- all emitted after the last statement -- inherited
        // that statement's line. i1/i2 are otherwise unused on a BLOCK; i3 is not
        // taken here because the file cannot differ from the block's own.
        let close = self.current()
        self.expectVal(TokenType.SEPARATOR, "}", "block")
        blockNode.child1 = statements.head
        blockNode.i1 = close.line
        blockNode.i2 = close.col
        return blockNode
    }

    // `x op= e` becomes `x = x op e`.
    //
    // Restricted to a plain variable on the left. The desugaring names the target
    // twice, so a target with a subexpression -- `a[i()] += 1`, or `f().field += 1`
    // -- would evaluate that subexpression twice. Rejecting those is better than
    // silently doing it, and the workaround is to write the assignment out in full.
    private fn parseCompoundAssignment(self, target: ASTNode, operatorToken: Token,
                                           first: Token) -> ASTNode {
        let op = operatorToken.value.substring(0, 1)
        self.advance()

        if (target.kind != NodeKind.IDENTIFIER_EXPR) {
            diag_error_at_code("P3302", target.file, target.line, target.col, target.len,
                "compound assignment ".concat(diagQuote(operatorToken.value),
                                              " requires a plain variable on the left"))
            diag_note("the desugaring names the target twice, so a subexpression here would be evaluated twice; write the assignment out in full instead")
            self.abandon()
            return target
        }

        // Anchored on the operator for the same reason the ordinary binary
        // expression in parse/expr.psm is: `x += 1` desugars to a BINARY_EXPR whose
        // position is now asked for by --overflow-checks, and `parserCurrent` here
        // is already past the operator.
        let combined = parserNodeFrom(NodeKind.BINARY_EXPR, operatorToken)
        combined.s1 = op
        combined.child1 = node_to_ptr(target)
        combined.child2 = node_to_ptr(self.parseExpression(0))

        // From `first`, not from where the parser is now. The RHS has been consumed
        // by this point, so `parserCurrent` is the *next statement's* first token --
        // the same off-by-one that made an expression statement report the following
        // line until 2026-08-22. Under `-g` it cost `x += 1` a location of its own
        // entirely: the statement inherited the next line's, so the two collapsed to
        // one entry and a debugger stepped straight over the compound assignment.
        let compound = parserNodeFrom(NodeKind.ASSIGNMENT_STATEMENT, first)
        compound.child1 = node_to_ptr(target)
        compound.child2 = node_to_ptr(combined)
        return compound
    }
}


impl Parser {
    // The condition of an `if` or a `while`: any expression, with or without
    // parentheses, ended by the `{` of the body. `if (a) { }` is the parenthesised
    // expression `(a)`, and `if x == none { }` needs nothing around it. Struct
    // literals are off until a bracket opens, or `Foo {` would swallow the body.
    private fn parseCondition(self, what: String) -> ASTNode {
        if (self.checkVal(TokenType.SEPARATOR, "{")) {
            self.fatal("expected a condition in ".concat(what, ", found `{`"))
        }
        let saved = self.allowStructLit
        self.allowStructLit = 0
        let condition = self.parseExpression(0)
        self.allowStructLit = saved
        return condition
    }
}


impl Parser {
    private fn parseIfStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "if", "if statement")
        let ifNode = self.node(NodeKind.IF_STATEMENT)

        ifNode.child1 = node_to_ptr(self.parseCondition("if condition"))

        ifNode.child2 = node_to_ptr(self.parseBlock())

        if (self.matchVal(TokenType.KEYWORD, "else")) {
            if (self.checkVal(TokenType.KEYWORD, "if")) {
                ifNode.child3 = node_to_ptr(self.parseIfStatement())
            } else {
                ifNode.child3 = node_to_ptr(self.parseBlock())
            }
        }

        return ifNode
    }
}


impl Parser {
    private fn parseWhileStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "while", "while statement")
        let whileNode = self.node(NodeKind.WHILE_STATEMENT)

        whileNode.child1 = node_to_ptr(self.parseCondition("while condition"))

        whileNode.child2 = node_to_ptr(self.parseBlock())
        return whileNode
    }
}


impl Parser {
    private fn parseLoopStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "loop", "loop statement")
        let loopNode = self.node(NodeKind.LOOP_STATEMENT)
        loopNode.child1 = node_to_ptr(self.parseBlock())
        return loopNode
    }
}


impl Parser {
    // `scope { ... }` -- every task spawned inside is finished before the scope is left,
    // on every path out of it, so a task cannot outlive the code that started it.
    //
    // **A REGION_STATEMENT with i3 = 1.** It is a block that is entered and left, and
    // every pass that walks a region -- flow, assignment, ranges, the AIF scope tree --
    // already treats it as exactly that. What sets it apart is only what happens on the
    // way out, which codegen and the AIF walk read from the flag.
    //
    // Contextual: `scope` begins a statement only when `{` follows, so a variable called
    // `scope` keeps compiling.
    private fn atScopeStatement(self) -> Bool {
        if (self.checkVal(TokenType.IDENTIFIER, "scope") == false) { return false }
        let open = self.peek()
        return open.type == TokenType.SEPARATOR and open.value.equals("{")
    }

    private fn parseScopeStatement(self) -> ASTNode {
        let scopeNode = self.node(NodeKind.REGION_STATEMENT)
        self.advance()
        scopeNode.i3 = 1
        scopeNode.child1 = node_to_ptr(self.parseBlock())
        return scopeNode
    }
}


impl Parser {
    // `region <name> { ... }` (SPEC 5.2). The name is a label, not a binding: it
    // identifies the arena in the manifest so that a reader can tell which `region`
    // in the source a `region:parse` placement refers to.
    private fn parseRegionStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "region", "region statement")

        let regionNode = self.node(NodeKind.REGION_STATEMENT)
        let name = self.current()
        if (name.type == TokenType.IDENTIFIER) {
            regionNode.s1 = name.value
            self.advance()
        } else {
            self.fatal("expected a name for the region, found ".concat(parserDescribe(name)))
        }

        // REQUIREMENTS 19. `region work pin(4096) { … }` asserts a byte cap on what
        // this region's arena serves, and the build fails when the static estimate
        // exceeds it. A cap belongs on a region rather than on a binding because a
        // budget is a property of a block's peak, not of one value -- which is the
        // one place SPEC 5.4's `pin` had nothing to say.
        //
        // Contextual, like every other use of `pin`: only an annotation when a `(`
        // follows, so a region may still be called `pin`.
        if (self.atAnnotation("pin")) {
            self.advance()
            self.expectVal(TokenType.SEPARATOR, "(", "region budget")
            let cap = self.current()
            if (cap.type != TokenType.NUMBER_LITERAL) {
                self.fatal("expected a byte budget, found ".concat(parserDescribe(cap)))
            }
            regionNode.i1 = cap.value.parseInt().unwrapOr(0)
            self.advance()
            self.expectVal(TokenType.SEPARATOR, ")", "region budget")
        }

        regionNode.child1 = node_to_ptr(self.parseBlock())
        return regionNode
    }
}


impl Parser {
    // The token after the one the parser is looking at, and the one after that.
    private fn parserPeekSecond(self) -> Token {
        let next = self.peek()
        return ptr_to_token(next.tokNext)
    }
}


impl Parser {
    // `(key, value)` in a `for` header. The names land in `s1` and `s2`; which one
    // is the index, the key or the element is sema's question, because it depends
    // on what is being iterated.
    private fn parseForPair(self, forNode: ASTNode) {
        self.expectVal(TokenType.SEPARATOR, "(", "for loop pair")
        let first = self.current()
        forNode.s1 = first.value
        self.expectToken(TokenType.IDENTIFIER, "for loop variable")
        self.expectVal(TokenType.SEPARATOR, ",", "for loop pair")
        let second = self.current()
        forNode.s2 = second.value
        self.expectToken(TokenType.IDENTIFIER, "for loop variable")
        self.expectVal(TokenType.SEPARATOR, ")", "for loop pair")
    }
}


impl Parser {
    // `for i in 1..10`, `for i in 0..<n step 2`, `for c in s`, `for (k, v) in m`,
    // and each of those with the header in parentheses: `for (i in 1..10) { }`.
    //
    // The shape a range leaves behind:
    //
    //     child1   the start
    //     child2   the end, then the step when one was written, as one chain
    //     child3   the body
    //     i1       1 when the end is included (`..`), 0 when it is not (`..<`)
    //     i2       1 for a `repeat` count, which only counts up (below)
    //
    // The step rides on the end's `next` rather than taking a slot of its own
    // because an ASTNode has three children and a `for` already fills them. A chain
    // is also what every walk that visits a child slot already follows.
    private fn parseForStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "for", "for statement")
        let forNode = self.node(NodeKind.FOR_STATEMENT)

        // `for (a, b) in m` opens with a parenthesis too, and is the pair rather than
        // a wrapped header when a comma follows the first name.
        let mut wrapped = false
        if (self.checkVal(TokenType.SEPARATOR, "(")) {
            let second = self.parserPeekSecond()
            wrapped = (second.type == TokenType.SEPARATOR and second.value.equals(",")) == false
        }
        if (wrapped) { self.advance() }

        if (self.checkVal(TokenType.SEPARATOR, "(")) {
            self.parseForPair(forNode)
        } else {
            let name = self.current()
            forNode.s1 = name.value
            self.expectToken(TokenType.IDENTIFIER, "for loop variable")
        }
        self.expectVal(TokenType.KEYWORD, "in", "for ... in")

        // Otherwise `for i in 0..n { ... }` reads `n { ... }` as a struct literal and
        // swallows the body.
        self.allowStructLit = 0
        forNode.child1 = node_to_ptr(self.parseExpression(0))

        // v0.1 3.6. A range operator is what separates the two loops, and its
        // absence is what says this is `for c in s` over a collection rather than
        // `for i in 0..n` over a range. An absent `child2` is the whole marker: the
        // two forms cannot be confused because a range always has both bounds.
        let rangeOp = self.current()
        if (self.matchToken(TokenType.RANGE)) {
            if (rangeOp.value.equals("..")) { forNode.i1 = 1 }
            let end = self.parseExpression(0)

            // Contextual, like `pin`: `step` stays an ordinary name everywhere else,
            // and here nothing else may follow an end.
            if (self.checkVal(TokenType.IDENTIFIER, "step")) {
                self.advance()
                end.next = node_to_ptr(self.parseExpression(0))
            }
            forNode.child2 = node_to_ptr(end)
        } else if (self.checkVal(TokenType.IDENTIFIER, "step")) {
            self.fatal("`step` needs a range to count through, such as `0..<n step 2`")
        }
        self.allowStructLit = 1

        if (wrapped) { self.expectVal(TokenType.SEPARATOR, ")", "for header") }

        forNode.child3 = node_to_ptr(self.parseBlock())
        return forNode
    }
}


impl Parser {
    // `repeat(n) { ... }` at the start of a statement. Contextual rather than a
    // keyword, because `"ab".repeat(3)` is a String method and must stay one: this
    // form is recognised only where a statement begins with `repeat`, a
    // parenthesised count, and a block -- a shape no call can take, since Prismio has
    // no bare block statement for a call to be followed by.
    private fn atRepeatStatement(self) -> Bool {
        if (self.checkVal(TokenType.IDENTIFIER, "repeat") == false) { return false }
        let open = self.peek()
        if (open.type != TokenType.SEPARATOR or open.value.equals("(") == false) { return false }

        let mut depth = 0
        let mut at = open.tokNext
        loop {
            let tok = ptr_to_token(at)
            if (tok.type == TokenType.EOF) { return false }
            if (tok.type == TokenType.SEPARATOR and tok.value.equals("(")) { depth = depth + 1 }
            if (tok.type == TokenType.SEPARATOR and tok.value.equals(")")) {
                if (depth == 0) {
                    let after = ptr_to_token(tok.tokNext)
                    return after.type == TokenType.SEPARATOR and after.value.equals("{")
                }
                depth = depth - 1
            }
            at = tok.tokNext
        }
    }
}


impl Parser {
    // `repeat(n) { body }` is `for $repeat in 0..<n { body }`: the count is read once,
    // and the counter has a name no source can spell, so the body cannot see it or
    // collide with it. Named after the position so that nested repeats each have
    // their own.
    //
    // A count is not a range, so it never counts down: `i2` marks the loop as
    // counting up only, and a count of zero or less runs the body no times.
    private fn parseRepeatStatement(self) -> ASTNode {
        let forNode = self.node(NodeKind.FOR_STATEMENT)
        forNode.s1 = "$repeat_".concat(forNode.line.toString(), "_", forNode.col.toString())
        forNode.i2 = 1
        self.advance()

        self.expectVal(TokenType.SEPARATOR, "(", "repeat count")
        let zero = self.node(NodeKind.LITERAL_EXPR)
        zero.i1 = TokenType.NUMBER_LITERAL as Int
        zero.s1 = "0"
        forNode.child1 = node_to_ptr(zero)
        forNode.child2 = node_to_ptr(self.parseExpression(0))
        self.expectVal(TokenType.SEPARATOR, ")", "repeat count")

        forNode.child3 = node_to_ptr(self.parseBlock())
        return forNode
    }
}


impl Parser {
    // The loop a label names.
    private fn parseLoopKind(self) -> ASTNode {
        if (self.checkVal(TokenType.KEYWORD, "while")) { return self.parseWhileStatement() }
        if (self.checkVal(TokenType.KEYWORD, "loop")) { return self.parseLoopStatement() }
        if (self.checkVal(TokenType.KEYWORD, "for")) { return self.parseForStatement() }
        if (self.atRepeatStatement()) { return self.parseRepeatStatement() }
        self.fatal("a label names a loop; expected `for`, `while`, `loop` or `repeat` after it, found ".concat(parserDescribe(self.current())))
        return self.parseLoopStatement()
    }
}


impl Parser {
    // `outer@ for ... { }`. The label is kept on the loop's body block, in `s1`,
    // which a BLOCK does not otherwise use: every loop kind has a body, and every
    // rewrite a loop goes through later -- `for x in it` becoming a `while` among
    // them -- keeps the body it was given, so the label cannot be lost on the way.
    private fn parseLabeledLoop(self) -> ASTNode {
        let label = self.current()
        self.advance()
        self.expectVal(TokenType.SEPARATOR, "@", "loop label")
        let loopNode = self.parseLoopKind()
        let body = ptr_to_node(loopBodyOf(loopNode))
        body.s1 = label.value
        return loopNode
    }
}


impl Parser {
    // `break@outer` and `continue@outer`. The label has to be on the same line as
    // the keyword: a statement ends at the line, so anything on the next line is
    // the next statement.
    private fn parseJumpLabel(self, jump: ASTNode, keyword: Token) {
        let at = self.current()
        if (at.type != TokenType.SEPARATOR or at.value.equals("@") == false) { return }
        if (at.line != keyword.line) { return }
        self.advance()
        let label = self.current()
        jump.s1 = label.value
        self.expectToken(TokenType.IDENTIFIER, "loop label")
    }
}


impl Parser {
    private fn parseMatchArm(self) -> ASTNode {
        let arm = self.node(NodeKind.MATCH_ARM)
        if (self.matchVal(TokenType.IDENTIFIER, "_")) {
            arm.s1 = "_"
        } else {
            arm.child1 = node_to_ptr(self.parseExpression(0))
        }
        self.expectVal(TokenType.FAT_ARROW, "=>", "match arm")
        arm.child2 = node_to_ptr(self.parseBlock())
        return arm
    }
}


impl Parser {
    private fn parseMatchStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "match", "match statement")
        let matchNode = self.node(NodeKind.MATCH_STATEMENT)

        self.expectVal(TokenType.SEPARATOR, "(", "match scrutinee")
        matchNode.child1 = node_to_ptr(self.parseExpression(0))
        self.expectVal(TokenType.SEPARATOR, ")", "match scrutinee")

        self.expectVal(TokenType.SEPARATOR, "{", "match body")
        let arms = nodeList()
        while (self.checkVal(TokenType.SEPARATOR, "}") == false) {
            if (self.dead == 1) { break }
            nodeListPush(arms, self.parseMatchArm())
            self.matchVal(TokenType.SEPARATOR, ",")
        }
        self.expectVal(TokenType.SEPARATOR, "}", "match body")

        matchNode.child2 = arms.head
        return matchNode
    }
}


impl Parser {
    private fn parseReturnStatement(self) -> ASTNode {
        let retNode = self.node(NodeKind.RETURN_STATEMENT)
        let next = self.current()
        if (next.type != TokenType.SEPARATOR or next.value.equals("}") == false) {
            retNode.child1 = node_to_ptr(self.parseExpression(0))
        }
        return retNode
    }
}



impl Parser {
    private fn parseStatement(self) -> ASTNode {
        if (self.checkVal(TokenType.KEYWORD, "if")) { return self.parseIfStatement() }
        if (self.checkVal(TokenType.KEYWORD, "while")) { return self.parseWhileStatement() }
        if (self.checkVal(TokenType.KEYWORD, "loop")) { return self.parseLoopStatement() }
        if (self.checkVal(TokenType.KEYWORD, "match")) { return self.parseMatchStatement() }
        if (self.checkVal(TokenType.KEYWORD, "for")) { return self.parseForStatement() }
        if (self.checkVal(TokenType.KEYWORD, "region")) { return self.parseRegionStatement() }
        if (self.checkVal(TokenType.KEYWORD, "let")) { return self.parseVariableDecl() }
        if (self.atConstDecl()) { return self.parseVariableDecl() }
        if (self.atRepeatStatement()) { return self.parseRepeatStatement() }
        if (self.atScopeStatement()) { return self.parseScopeStatement() }

        // Held before anything is consumed: every node built below is built *after*
        // its own text has been parsed, so `parserCurrent` is by then the token that
        // follows the statement.
        let first = self.current()

        if (first.type == TokenType.IDENTIFIER) {
            let after = self.peek()
            if (after.type == TokenType.SEPARATOR and after.value.equals("@")) {
                return self.parseLabeledLoop()
            }
        }

        // A label, when there is one, is in `s1`.
        if (self.matchVal(TokenType.KEYWORD, "break")) {
            let jump = parserNodeFrom(NodeKind.BREAK_STATEMENT, first)
            self.parseJumpLabel(jump, first)
            return jump
        }
        if (self.matchVal(TokenType.KEYWORD, "continue")) {
            let jump = parserNodeFrom(NodeKind.CONTINUE_STATEMENT, first)
            self.parseJumpLabel(jump, first)
            return jump
        }
        if (self.matchVal(TokenType.KEYWORD, "return")) {
            return self.parseReturnStatement()
        }

        let expr = self.parseExpression(0)

        if (self.matchVal(TokenType.ASSIGNMENT_OPERATOR, "=")) {
            // `parserMatchVal` has consumed the `=`, so the parser is sitting on the
            // first token of the right-hand side. Stamping that put the statement's
            // span on the value rather than on the target -- right line, wrong
            // column, and one token to the right in anything that underlines it.
            let assignment = parserNodeFrom(NodeKind.ASSIGNMENT_STATEMENT, first)
            assignment.child1 = node_to_ptr(expr)
            assignment.child2 = node_to_ptr(self.parseExpression(0))
            return assignment
        }

        let operatorToken = self.current()
        if (operatorToken.type == TokenType.ASSIGNMENT_OPERATOR and operatorToken.value.length == 2) {
            return self.parseCompoundAssignment(expr, operatorToken, first)
        }

        let stmt = parserNodeFrom(NodeKind.EXPRESSION_STATEMENT, first)
        stmt.child1 = node_to_ptr(expr)
        return stmt
    }
}
