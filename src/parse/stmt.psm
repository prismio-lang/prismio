// Statements: blocks, control flow, assignment.

import lexer.token
import common.text
import ast.nodes
import common.diagnostics
import std.string
import std.option

extern fn exit(code: Int)

internal fn parseBlock(p: Parser) -> ASTNode {
    let open = p.current()
    p.expectVal(TokenType.SEPARATOR, "{", "block")
    let blockNode = p.node(NodeKind.BLOCK)

    let statements = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        // Without this the loop spins at EOF until some inner parser happens to
        // fail, and blames whatever it was looking at instead of the brace that
        // was never closed.
        if (p.check(TokenType.EOF)) {
            diag_error_at_code("P3301", open.file, open.line, open.col, open.len,
                          "this block is never closed; reached end of file looking for `}`")
            diag_finish()
            exit(1)
        }
        nodeListPush(statements, parseStatement(p))
    }

    // The closing brace, before it is consumed. A block's own span starts at `{`
    // and there was nothing recording where it ended, so every scope drop, arena
    // pop and region exit -- all emitted after the last statement -- inherited
    // that statement's line. i1/i2 are otherwise unused on a BLOCK; i3 is not
    // taken here because the file cannot differ from the block's own.
    let close = p.current()
    p.expectVal(TokenType.SEPARATOR, "}", "block")
    blockNode.child1 = statements.head
    blockNode.i1 = close.line
    blockNode.i2 = close.col
    return blockNode
}

private fn parseIfStatement(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "if", "if statement")
    let ifNode = p.node(NodeKind.IF_STATEMENT)

    p.expectVal(TokenType.SEPARATOR, "(", "if condition")
    ifNode.child1 = node_to_ptr(parseExpression(p, 0))
    p.expectVal(TokenType.SEPARATOR, ")", "if condition")

    ifNode.child2 = node_to_ptr(parseBlock(p))

    if (p.matchVal(TokenType.KEYWORD, "else")) {
        if (p.checkVal(TokenType.KEYWORD, "if")) {
            ifNode.child3 = node_to_ptr(parseIfStatement(p))
        } else {
            ifNode.child3 = node_to_ptr(parseBlock(p))
        }
    }

    return ifNode
}

private fn parseWhileStatement(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "while", "while statement")
    let whileNode = p.node(NodeKind.WHILE_STATEMENT)

    p.expectVal(TokenType.SEPARATOR, "(", "while condition")
    whileNode.child1 = node_to_ptr(parseExpression(p, 0))
    p.expectVal(TokenType.SEPARATOR, ")", "while condition")

    whileNode.child2 = node_to_ptr(parseBlock(p))
    return whileNode
}

private fn parseLoopStatement(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "loop", "loop statement")
    let loopNode = p.node(NodeKind.LOOP_STATEMENT)
    loopNode.child1 = node_to_ptr(parseBlock(p))
    return loopNode
}

// `region <name> { ... }` (SPEC 5.2). The name is a label, not a binding: it
// identifies the arena in the manifest so that a reader can tell which `region`
// in the source a `region:parse` placement refers to.
private fn parseRegionStatement(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "region", "region statement")

    let regionNode = p.node(NodeKind.REGION_STATEMENT)
    let name = p.current()
    if (name.type == TokenType.IDENTIFIER) {
        regionNode.s1 = name.value
        p.advance()
    } else {
        p.fatal(strConcat("expected a name for the region, found ",
                                   parserDescribe(name)))
    }

    // REQUIREMENTS 19. `region work pin(4096) { … }` asserts a byte cap on what
    // this region's arena serves, and the build fails when the static estimate
    // exceeds it. A cap belongs on a region rather than on a binding because a
    // budget is a property of a block's peak, not of one value -- which is the
    // one place SPEC 5.4's `pin` had nothing to say.
    //
    // Contextual, like every other use of `pin`: only an annotation when a `(`
    // follows, so a region may still be called `pin`.
    if (p.atAnnotation("pin")) {
        p.advance()
        p.expectVal(TokenType.SEPARATOR, "(", "region budget")
        let cap = p.current()
        if (cap.type != TokenType.NUMBER_LITERAL) {
            p.fatal(strConcat("expected a byte budget, found ", parserDescribe(cap)))
        }
        regionNode.i1 = optionOr(strParseInt(cap.value), 0)
        p.advance()
        p.expectVal(TokenType.SEPARATOR, ")", "region budget")
    }

    regionNode.child1 = node_to_ptr(parseBlock(p))
    return regionNode
}

private fn parseForStatement(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "for", "for statement")
    let forNode = p.node(NodeKind.FOR_STATEMENT)

    let name = p.current()
    forNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "for loop variable")
    p.expectVal(TokenType.KEYWORD, "in", "for ... in")

    // Otherwise `for i in 0..n { ... }` reads `n { ... }` as a struct literal and
    // swallows the body.
    p.allowStructLit = 0
    forNode.child1 = node_to_ptr(parseExpression(p, 0))

    // v0.1 3.6. `..` is what separates the two loops, and its absence is what
    // says this is `for c in s` over a collection rather than `for i in 0..n`
    // over a range. An absent `child2` is the whole marker: no flag, and the two
    // forms cannot be confused because a range always has both bounds.
    if (p.matchToken(TokenType.RANGE)) {
        forNode.child2 = node_to_ptr(parseExpression(p, 0))
    }
    p.allowStructLit = 1

    forNode.child3 = node_to_ptr(parseBlock(p))
    return forNode
}

private fn parseMatchArm(p: Parser) -> ASTNode {
    let arm = p.node(NodeKind.MATCH_ARM)
    if (p.matchVal(TokenType.IDENTIFIER, "_")) {
        arm.s1 = "_"
    } else {
        arm.child1 = node_to_ptr(parseExpression(p, 0))
    }
    p.expectVal(TokenType.FAT_ARROW, "=>", "match arm")
    arm.child2 = node_to_ptr(parseBlock(p))
    return arm
}

private fn parseMatchStatement(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "match", "match statement")
    let matchNode = p.node(NodeKind.MATCH_STATEMENT)

    p.expectVal(TokenType.SEPARATOR, "(", "match scrutinee")
    matchNode.child1 = node_to_ptr(parseExpression(p, 0))
    p.expectVal(TokenType.SEPARATOR, ")", "match scrutinee")

    p.expectVal(TokenType.SEPARATOR, "{", "match body")
    let arms = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        nodeListPush(arms, parseMatchArm(p))
        p.matchVal(TokenType.SEPARATOR, ",")
    }
    p.expectVal(TokenType.SEPARATOR, "}", "match body")

    matchNode.child2 = arms.head
    return matchNode
}

private fn parseReturnStatement(p: Parser) -> ASTNode {
    let retNode = p.node(NodeKind.RETURN_STATEMENT)
    let next = p.current()
    if (next.type != TokenType.SEPARATOR or next.value.equals("}") == false) {
        retNode.child1 = node_to_ptr(parseExpression(p, 0))
    }
    return retNode
}

// `x op= e` becomes `x = x op e`.
//
// Restricted to a plain variable on the left. The desugaring names the target
// twice, so a target with a subexpression -- `a[i()] += 1`, or `f().field += 1`
// -- would evaluate that subexpression twice. Rejecting those is better than
// silently doing it, and the workaround is to write the assignment out in full.
private fn parseCompoundAssignment(p: Parser, target: ASTNode, operatorToken: Token,
                            first: Token) -> ASTNode {
    let op = strSubstring(operatorToken.value, 0, 1)
    p.advance()

    if (target.kind != NodeKind.IDENTIFIER_EXPR) {
        diag_error_at_code("P3302", target.file, target.line, target.col, target.len,
            strConcat(strConcat("compound assignment ", diagQuote(operatorToken.value)),
                       " requires a plain variable on the left"))
        diag_note("the desugaring names the target twice, so a subexpression here would be evaluated twice; write the assignment out in full instead")
        diag_finish()
        exit(1)
    }

    // Anchored on the operator for the same reason the ordinary binary
    // expression in parse/expr.psm is: `x += 1` desugars to a BINARY_EXPR whose
    // position is now asked for by --overflow-checks, and `parserCurrent` here
    // is already past the operator.
    let combined = parserNodeFrom(NodeKind.BINARY_EXPR, operatorToken)
    combined.s1 = op
    combined.child1 = node_to_ptr(target)
    combined.child2 = node_to_ptr(parseExpression(p, 0))

    // From `first`, not from where the parser is now. The RHS has been consumed
    // by this point, so `parserCurrent` is the *next statement's* first token --
    // the same off-by-one that made an expression statement report the following
    // line until 2026-08-22. Under `-g` it cost `x += 1` a location of its own
    // entirely: the statement inherited the next line's, so the two collapsed to
    // one entry and a debugger stepped straight over the compound assignment.
    let compound = parserNodeFrom(NodeKind.ASSIGNMENT_STATEMENT, first)
    compound.child1 = node_to_ptr(target)
    compound.child2 = node_to_ptr(combined)
    return compound
}

private fn parseStatement(p: Parser) -> ASTNode {
    if (p.checkVal(TokenType.KEYWORD, "if")) { return parseIfStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "while")) { return parseWhileStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "loop")) { return parseLoopStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "match")) { return parseMatchStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "for")) { return parseForStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "region")) { return parseRegionStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "let")) { return parseVariableDecl(p) }

    // Held before anything is consumed: every node built below is built *after*
    // its own text has been parsed, so `parserCurrent` is by then the token that
    // follows the statement.
    let first = p.current()

    if (p.matchVal(TokenType.KEYWORD, "break")) {
        return parserNodeFrom(NodeKind.BREAK_STATEMENT, first)
    }
    if (p.matchVal(TokenType.KEYWORD, "continue")) {
        return parserNodeFrom(NodeKind.CONTINUE_STATEMENT, first)
    }
    if (p.matchVal(TokenType.KEYWORD, "return")) {
        return parseReturnStatement(p)
    }

    let expr = parseExpression(p, 0)

    if (p.matchVal(TokenType.ASSIGNMENT_OPERATOR, "=")) {
        // `parserMatchVal` has consumed the `=`, so the parser is sitting on the
        // first token of the right-hand side. Stamping that put the statement's
        // span on the value rather than on the target -- right line, wrong
        // column, and one token to the right in anything that underlines it.
        let assignment = parserNodeFrom(NodeKind.ASSIGNMENT_STATEMENT, first)
        assignment.child1 = node_to_ptr(expr)
        assignment.child2 = node_to_ptr(parseExpression(p, 0))
        return assignment
    }

    let operatorToken = p.current()
    if (operatorToken.type == TokenType.ASSIGNMENT_OPERATOR and __builtin_string_len(operatorToken.value) == 2) {
        return parseCompoundAssignment(p, expr, operatorToken, first)
    }

    let stmt = parserNodeFrom(NodeKind.EXPRESSION_STATEMENT, first)
    stmt.child1 = node_to_ptr(expr)
    return stmt
}
