// Expressions.
//
// Precedence climbing: parseExpression handles binary operators by precedence,
// parseCast the `as` chain, parseUnary the prefix operators, and parsePrimary
// the atoms plus the call/index/member suffixes that bind tightest.

import lexer.token
import lexer.scanner
import common.text
import ast.nodes
import common.diagnostics
import std.string

// Bitwise operators bind *tighter* than comparison, unlike C.
//
// C puts & | ^ below == and !=, so `flags & MASK != 0` silently means
// `flags & (MASK != 0)`. That is C's best-known precedence mistake -- Ritchie said
// as much, and both Rust and Go corrected it. Prismio has no compatibility reason
// to inherit it, and the ordering below makes the natural reading the correct one.
// Everything else follows C.
private fn getOperatorPrecedence(t: Token) -> Int {
    if (t.value.equals("or")) { return 1 }
    if (t.value.equals("and")) { return 2 }
    if (t.type == TokenType.KEYWORD) { return 0 }

    if (t.value.equals("==") or t.value.equals("!=")) { return 3 }
    if (t.value.equals("<") or t.value.equals(">") or t.value.equals("<=") or t.value.equals(">=")) { return 4 }
    // `??` sits between comparison and the bitwise operators, as Swift's does:
    // `a ?? b + 1` is `a ?? (b + 1)`, and `a ?? b == c` is `(a ?? b) == c`.
    if (t.value.equals("??")) { return 5 }
    if (t.value.equals("|")) { return 6 }
    if (t.value.equals("^")) { return 7 }
    if (t.value.equals("&")) { return 8 }
    if (t.value.equals("<<") or t.value.equals(">>")) { return 9 }
    if (t.value.equals("+") or t.value.equals("-")) { return 10 }
    if (t.value.equals("*") or t.value.equals("/") or t.value.equals("%")) { return 11 }

    return 0
}

private fn isBinaryOperator(t: Token) -> Bool {
    if (t.type == TokenType.ARITHMETIC_OPERATOR) { return true }
    if (t.type == TokenType.RELATIONAL_OPERATOR) { return true }
    return t.value.equals("and") or t.value.equals("or")
}

impl Parser {
    internal fn parseExpression(self, precedence: Int) -> ASTNode {
        let mut left = self.parseCast()

        loop {
            let operatorToken = self.current()
            if (isBinaryOperator(operatorToken) == false) { break }

            let operatorPrecedence = getOperatorPrecedence(operatorToken)
            if (operatorPrecedence == 0 or operatorPrecedence < precedence) { break }

            let op = operatorToken.value
            self.advance()

            // Left associativity: the right operand binds only tighter operators.
            // `??` is the exception and associates to the right, so
            // `a ?? b ?? c` tries `a`, then `b`, then `c`.
            let mut rightPrecedence = operatorPrecedence + 1
            if (op.equals("??")) { rightPrecedence = operatorPrecedence }
            let right = self.parseExpression(rightPrecedence)

            // From the operator token, not from where the parser is now. The right
            // operand has been consumed by this point, so `parserCurrent` is the
            // token *after* the whole expression -- the same off-by-one the compound
            // assignment in parse/stmt.psm records, and this is the other half of it.
            //
            // It stayed invisible because nothing had ever reported a source
            // position out of a BINARY_EXPR: sema points at operands, and `-g` takes
            // its locations from statements. `--overflow-checks` is the first thing
            // that does, and it named the line below the addition that overflowed.
            //
            // The operator is the right anchor rather than the left operand's start,
            // because what the position identifies is the *operation* -- which is
            // what overflowed, and which is what a reader looks for on the line.
            let binary = parserNodeFrom(NodeKind.BINARY_EXPR, operatorToken)
            binary.s1 = op
            binary.child1 = node_to_ptr(left)
            binary.child2 = node_to_ptr(right)
            left = binary
        }

        return left
    }
}


// Folds `-<numeric literal>` into the literal itself rather than lowering it to
// `sub 0, n`. Negative numbers then still count as literals, which is what lets
// them appear where a constant is required (a global initializer) and what lets
// `let x: I8 = -5` reach sema's int-literal coercion.
//
// Guarded on the leading '-' so `--5` stays a negation of the literal -5 instead
// of folding into the nonsense literal "--5".
private fn foldNegativeLiteral(operand: ASTNode, minus: Token) -> Bool {
    if (operand.kind != NodeKind.LITERAL_EXPR) { return false }

    let isNumber = operand.i1 == TokenType.NUMBER_LITERAL as Int or operand.i1 == TokenType.FLOAT_LITERAL as Int
    if (isNumber == false or operand.s1.startsWith("-")) { return false }

    operand.s1 = "-".concat(operand.s1)
    // The folded literal's span still covered only the digits, so a diagnostic
    // about `-42` underlined `42`. Widen it to include the sign that is now part
    // of its value.
    operand.line = minus.line
    operand.col = minus.col
    operand.len = operand.len + 1
    return true
}

impl Parser {
    // Prefix operators bind tighter than `as` and any binary operator, so they sit
    // between parseCast and parsePrimary. Recursing into parseUnary rather than
    // parsePrimary is what makes `--x` and `!!b` parse.
    private fn parseUnary(self) -> ASTNode {
        let current = self.current()

        let isNegate = current.type == TokenType.ARITHMETIC_OPERATOR and current.value.equals("-")
        let isNot = current.type == TokenType.NEGATION and current.value.equals("!")
        let isComplement = current.type == TokenType.ARITHMETIC_OPERATOR and current.value.equals("~")

        if (isNegate == false and isNot == false and isComplement == false) {
            return self.parsePrimary()
        }

        let op = current.value
        self.advance()
        let operand = self.parseUnary()

        if (op.equals("-") and foldNegativeLiteral(operand, current)) {
            return operand
        }

        let unary = self.node(NodeKind.UNARY_EXPR)
        unary.s1 = op
        unary.child1 = node_to_ptr(operand)
        return unary
    }
}


impl Parser {
    // `expr as Type`. Binds tighter than any binary operator and looser than a prefix
    // operator, so `-x as I64` negates first and `a + b as I64` converts only b.
    // Looping allows `x as I64 as Float` to chain left to right.
    //
    // The prefix operators are parsed *inside* the cast, not the other way round.
    // When parseUnary called this, `-1 as U8` was `-(1 as U8)` -- a negation of an
    // unsigned value, rejected -- and `-1e30 as I64` saturated before negating, one
    // short of I64.MIN.
    private fn parseCast(self) -> ASTNode {
        let mut expr = self.parseUnary()

        while (self.matchVal(TokenType.KEYWORD, "as")) {
            let cast = self.node(NodeKind.CAST_EXPR)
            cast.child1 = node_to_ptr(expr)
            cast.child2 = node_to_ptr(self.parseTypeAnnotation())
            expr = cast
        }

        return expr
    }
}


impl Parser {
    // Does an identifier at the cursor begin `Name<...>` followed by `opener`?
    //
    // A pure scan over the token chain: it builds nothing and, crucially, **mutates
    // nothing**. The obvious implementation is to speculatively parse the argument
    // list and rewind on failure, and it is wrong here for one specific reason --
    // parserExpectCloseAngle splits a `>>` token in place, and that edit survives a
    // rewind. `a < b >> c` would come back from a failed speculation as `a < b > c`.
    //
    // Scanning cannot decide the general case and does not try. It admits only the
    // tokens a type argument list can contain, so anything else -- an operator, a
    // literal, a call -- settles it as a comparison immediately.
    private fn looksLikeTypeArgs(self, opener: String) -> Bool {
        let mut tok = ptr_to_token(self.current).tokNext
        if (nodeIsNull(tok)) { return false }
        if (ptr_to_token(tok).value.equals("<") == false) { return false }

        let mut depth = 1
        tok = ptr_to_token(tok).tokNext
        while (nodeExists(tok) and depth > 0) {
            let current = ptr_to_token(tok)
            if (current.type == TokenType.IDENTIFIER) {
                // nothing to do: a type name
            } else if (current.value.equals("<")) {
                depth = depth + 1
            } else if (current.value.equals(">")) {
                depth = depth - 1
            } else if (current.value.equals(">>")) {
                depth = depth - 2
            } else if (current.value.equals(",")) {
                // nothing to do: an argument separator
            } else if (current.value.equals("[")) {
                // nothing to do: an array element type
            } else if (current.value.equals("]")) {
                // nothing to do
            } else if (current.value.equals("?")) {
                // nothing to do: an optional suffix
            } else {
                return false
            }
            tok = current.tokNext
        }

        if (depth != 0) { return false }
        if (nodeIsNull(tok)) { return false }
        return ptr_to_token(tok).value.equals(opener)
    }
}


impl Parser {
    // The cursor is on the `{`. Both callers have consumed the name already -- the
    // generic one had to consume an argument list between the two.
    private fn parseStructLiteral(self, name: Token) -> ASTNode {
        let structLit = self.node(NodeKind.STRUCT_LITERAL_EXPR)
        structLit.s1 = name.value
        self.expectVal(TokenType.SEPARATOR, "{", "struct literal")

        let fields = nodeList()
        while (self.checkVal(TokenType.SEPARATOR, "}") == false) {
            let field = self.node(NodeKind.STRUCT_FIELD)
            let fieldName = self.current()
            field.s1 = fieldName.value
            self.expectToken(TokenType.IDENTIFIER, "struct literal field")
            self.expectVal(TokenType.SEPARATOR, ":", "struct literal")
            field.child1 = node_to_ptr(self.parseExpression(0))
            nodeListPush(fields, field)

            self.matchVal(TokenType.SEPARATOR, ",")
        }

        self.expectVal(TokenType.SEPARATOR, "}", "struct literal")
        structLit.child1 = fields.head
        return structLit
    }
}


impl Parser {
    // A literal chunk of an interpolated string, dropped when it is empty: `"${a}${b}"`
    // is two parts rather than five, which matters because `concat` is an overload
    // set with a largest arity and every empty part spends one.
    private fn interpolationChunk(self, parts: NodeList, tok: Token) {
        if (__builtin_string_len(tok.value) == 0) { return }
        let chunk = parserNodeFrom(NodeKind.LITERAL_EXPR, tok)
        chunk.i1 = TokenType.STRING_LITERAL as Int
        chunk.s1 = tok.value
        nodeListPush(parts, chunk)
    }
}


// `show(value)` -- the conversion every interpolated value goes through.
private fn interpolationShow(value: ASTNode) -> ASTNode {
    value.next = ptr_null()
    let callee = createNode(NodeKind.IDENTIFIER_EXPR)
    callee.s1 = "show"
    nodeSpanFrom(callee, value)

    let call = createNode(NodeKind.CALL_EXPR)
    nodeSpanFrom(call, value)
    call.child1 = node_to_ptr(callee)
    call.child2 = node_to_ptr(value)
    return call
}

impl Parser {
    // The parts as one `concat`, or as a tree of them when there are more parts than
    // `impl String` has an overload for.
    //
    // **Grouped rather than chained.** `a.concat(b).concat(c)` copies the prefix once
    // per step, so a long interpolation would be quadratic in its own length; six at
    // a time is one allocation per group and one more to join the groups, which for
    // any interpolation a person writes is two levels at most.
    private fn interpolationJoin(self, parts: Ptr, anchor: Token) -> ASTNode {
        let mut count = 0
        let mut walk = parts
        while (nodeExists(walk)) {
            count = count + 1
            walk = ptr_to_node(walk).next
        }

        if (count == 0) {
            let empty = parserNodeFrom(NodeKind.LITERAL_EXPR, anchor)
            empty.i1 = TokenType.STRING_LITERAL as Int
            empty.s1 = ""
            return empty
        }
        if (count == 1) { return ptr_to_node(parts) }

        if (count <= 6) {
            let call = parserNodeFrom(NodeKind.CALL_EXPR, anchor)
            let callee = parserNodeFrom(NodeKind.IDENTIFIER_EXPR, anchor)
            callee.s1 = "concat"
            call.child1 = node_to_ptr(callee)
            call.child2 = parts
            return call
        }

        // More than one group: take six at a time, join each, and recurse over the
        // results.
        let groups = nodeList()
        let mut restPtr = parts
        while (nodeExists(restPtr)) {
            let groupHead = restPtr
            let mut taken = 1
            let mut tail = ptr_to_node(restPtr)
            while (taken < 6 and nodeExists(tail.next)) {
                tail = ptr_to_node(tail.next)
                taken = taken + 1
            }
            restPtr = tail.next
            tail.next = ptr_null()
            nodeListPush(groups, self.interpolationJoin(groupHead, anchor))
        }
        return self.interpolationJoin(groups.head, anchor)
    }
}


impl Parser {
    private fn parseInterpolation(self) -> ASTNode {
        let opening = self.current()
        let parts = nodeList()

        self.interpolationChunk(parts, opening)
        self.advance()

        loop {
            nodeListPush(parts, interpolationShow(self.parseExpression(0)))

            let edge = self.current()
            if (edge.type == TokenType.INTERP_PART) {
                self.interpolationChunk(parts, edge)
                self.advance()
            } else if (edge.type == TokenType.INTERP_END) {
                self.interpolationChunk(parts, edge)
                self.advance()
                break
            } else {
                // The lexer only ever emits these three together, so reaching here
                // means the expression consumed the closing token -- report against
                // the expression rather than leaving the parser adrift.
                diag_error_at_code("P3102", edge.file, edge.line, edge.col, edge.len,
                    "expected the end of `\${...}` in an interpolated string")
                break
            }
        }

        return self.interpolationJoin(parts.head, opening)
    }
}


impl Parser {
    private fn parseArrayLiteral(self) -> ASTNode {
        let arrayLit = self.node(NodeKind.ARRAY_LITERAL_EXPR)

        let elements = nodeList()
        if (self.checkVal(TokenType.SEPARATOR, "]") == false) {
            loop {
                nodeListPush(elements, self.parseExpression(0))
                if (self.matchVal(TokenType.SEPARATOR, ",") == false) { break }
            }
        }

        self.expectVal(TokenType.SEPARATOR, "]", "array literal")
        arrayLit.child1 = elements.head
        return arrayLit
    }
}


impl Parser {
    // `{ "Alice": 20, "Bob": 25 }`, and `{}`. The cursor is past the `{`. A key is
    // an expression, as in Python: `{ name: 1 }` keys on the value of `name`, never
    // on the string "name". A trailing comma is allowed, as in the array literal.
    private fn parseMapLiteral(self) -> ASTNode {
        let mapLit = self.node(NodeKind.MAP_LITERAL_EXPR)
        let keys = nodeList()
        let values = nodeList()
        while (self.checkVal(TokenType.SEPARATOR, "}") == false) {
            nodeListPush(keys, self.parseExpression(0))
            self.expectVal(TokenType.SEPARATOR, ":", "map literal entry")
            nodeListPush(values, self.parseExpression(0))
            if (self.matchVal(TokenType.SEPARATOR, ",") == false) { break }
        }
        self.expectVal(TokenType.SEPARATOR, "}", "map literal")
        mapLit.child1 = keys.head
        mapLit.child2 = values.head
        return mapLit
    }
}


impl Parser {
    private fn parseCall(self, callee: ASTNode) -> ASTNode {
        let call = self.node(NodeKind.CALL_EXPR)
        // Point the call at its callee rather than at the first argument, so
        // "expects 1 argument, found 2" underlines the name of the thing being
        // called.
        nodeSpanFrom(call, callee)
        call.child1 = node_to_ptr(callee)

        let arguments = nodeList()
        if (self.checkVal(TokenType.SEPARATOR, ")") == false) {
            loop {
                nodeListPush(arguments, self.parseExpression(0))
                if (self.matchVal(TokenType.SEPARATOR, ",") == false) { break }
            }
        }

        self.expectVal(TokenType.SEPARATOR, ")", "function call")
        call.child2 = arguments.head
        return call
    }
}


impl Parser {
    // The end of `a[start..end]`, as the exclusive bound every slice is stored with.
    // `..<` is that bound already; `..` includes its end, so it is one past it.
    private fn parseSliceEnd(self, rangeOp: Token) -> ASTNode {
        let end = self.parseExpression(0)
        if (rangeOp.value.equals("..<")) { return end }

        let pastEnd = parserNodeFrom(NodeKind.BINARY_EXPR, rangeOp)
        pastEnd.s1 = "+"
        let one = parserNodeFrom(NodeKind.LITERAL_EXPR, rangeOp)
        one.i1 = TokenType.NUMBER_LITERAL as Int
        one.s1 = "1"
        pastEnd.child1 = node_to_ptr(end)
        pastEnd.child2 = node_to_ptr(one)
        return pastEnd
    }
}


impl Parser {
    // The suffixes that bind tightest, applied left to right: `f(x)[i].field`.
    //
    // **A `(` or `[` that starts a line starts a statement.** Statements have no
    // terminator, so without this
    //
    //     a.store(7)
    //     (a + 4).store(7)
    //
    // read as a call of the first statement's result, and the error named a
    // function with no name. A `.` still continues across lines, which is how a
    // method chain is broken up.
    private fn parseSuffixes(self, base: ASTNode) -> ASTNode {
        let mut expr = base

        loop {
            let adjoins = self.current().line == self.lastLine
            if (adjoins and self.matchVal(TokenType.SEPARATOR, "(")) {
                expr = self.parseCall(expr)
            } else if (adjoins and self.matchVal(TokenType.SEPARATOR, "[")) {
                // The RANGE token is not a binary operator, so parsing the first
                // bound stops immediately before `..`. That makes one production
                // cover both `a[i]` and SPEC 8.4's `a[start..end]` without making
                // range a general expression operator.
                let first = self.parseExpression(0)
                let rangeOp = self.current()
                if (self.matchToken(TokenType.RANGE)) {
                    let slice = self.node(NodeKind.SLICE_EXPR)
                    nodeSpanFrom(slice, expr)
                    slice.child1 = node_to_ptr(expr)
                    slice.child2 = node_to_ptr(first)
                    slice.child3 = node_to_ptr(self.parseSliceEnd(rangeOp))
                    self.expectVal(TokenType.SEPARATOR, "]", "slice range")
                    expr = slice
                } else {
                    let index = self.node(NodeKind.INDEX_EXPR)
                    nodeSpanFrom(index, expr)
                    index.child1 = node_to_ptr(expr)
                    index.child2 = node_to_ptr(first)
                    self.expectVal(TokenType.SEPARATOR, "]", "array index")
                    expr = index
                }
            } else if (self.matchVal(TokenType.SEPARATOR, ".")) {
                let member = self.node(NodeKind.MEMBER_ACCESS_EXPR)
                // `Self.make()` inside an `impl` names the type being implemented.
                if (expr.kind == NodeKind.IDENTIFIER_EXPR and expr.s1.equals("Self") and nodeExists(self.implType)) {
                    expr.s1 = ptr_to_node(self.implType).s1.clone()
                }
                member.child1 = node_to_ptr(expr)
                let name = self.current()
                member.s1 = name.value
                // `Config.default()`: a type's own default function (parseFunctionDecl).
                if (name.type == TokenType.KEYWORD and name.value.equals("default")) {
                    self.advance()
                } else {
                    self.expectToken(TokenType.IDENTIFIER, "member name")
                }
                expr = member
            } else {
                break
            }
        }

        return expr
    }
}


impl Parser {
    // v0.1 3.4. `|a: Int, b: Int| a + b`, and `|| 42` for one with no parameters.
    //
    // **Parameter types are written, and the body is an expression.** Both are the
    // smallest form with the right structure rather than a limitation the design
    // needs: an inferred parameter type has to be solved from the callee's signature
    // at the call site, and a block body has to take its type from its `return`
    // statements. Neither changes this syntax when it arrives.
    //
    // `|` at the start of a primary is unambiguous -- a bitwise-or is binary and is
    // consumed by parseExpression's operator loop, so nothing else can begin here
    // with one. `||` arrives as a single token from the scanner, which is why the
    // empty list is a spelling rather than a special case.
    private fn parseClosureExpr(self) -> ASTNode {
        let node = self.node(NodeKind.CLOSURE_EXPR)
        let opener = self.current()
        let empty = opener.value.equals("||")
        self.advance()

        let params = nodeList()
        if (empty == false) {
            if (self.checkVal(TokenType.ARITHMETIC_OPERATOR, "|") == false) {
                loop {
                    nodeListPush(params, self.parseParameter(false))
                    if (self.matchVal(TokenType.SEPARATOR, ",") == false) { break }
                }
            }
            self.expectVal(TokenType.ARITHMETIC_OPERATOR, "|", "closure parameter list")
        }

        node.child1 = params.head
        node.child2 = node_to_ptr(self.parseExpression(0))
        return node
    }
}


impl Parser {
    private fn atClosure(self) -> Bool {
        let current = self.current()
        if (current.type != TokenType.ARITHMETIC_OPERATOR) { return false }
        return current.value.equals("|") or current.value.equals("||")
    }
}


private fn isLiteralToken(t: Token) -> Bool {
    match (t.type) {
        TokenType.NUMBER_LITERAL => { return true }
        TokenType.FLOAT_LITERAL => { return true }
        TokenType.STRING_LITERAL => { return true }
        TokenType.BOOL_LITERAL => { return true }
        TokenType.CHAR_LITERAL => { return true }
    }
    return false
}

impl Parser {
    private fn parsePrimary(self) -> ASTNode {
        let current = self.current()

        if (self.atClosure()) { return self.parseClosureExpr() }

        // REQUIREMENTS 4. The absent reference. A keyword rather than an identifier,
        // so it cannot be shadowed by a binding -- `let none = 5` would otherwise
        // make the literal mean something else halfway down a file.
        if (current.type == TokenType.KEYWORD and current.value.equals("none")) {
            let noneLiteral = self.node(NodeKind.NONE_LITERAL_EXPR)
            self.advance()
            return noneLiteral
        }
        if (current.type == TokenType.KEYWORD and current.value.equals("default")) {
            let defaultValue = self.node(NodeKind.DEFAULT_EXPR)
            self.advance()
            return defaultValue
        }

        // v0.1 3.6. Through parseSuffixes, so that `"a,b".contains(",")` parses.
        //
        // It did not, and the reason was here rather than anywhere near the method
        // call rewrite: a literal was the one primary that returned without offering
        // its suffixes, so the `.` was left for the enclosing production and reported
        // as "expected `)` in function call, found `.`". Nothing was deciding that a
        // literal has no members -- the question was never asked.
        //
        // `0..n` is unaffected: `..` lexes as RANGE, which is not the SEPARATOR `.`
        // parseSuffixes matches on.
        // **`"total: ${count} items"`, and it is `concat` by the time anyone else
        // sees it.**
        //
        // The lexer hands over INTERP_BEGIN, the expression's own tokens, then
        // INTERP_PART or INTERP_END -- so the expression is parsed by
        // `parseExpression` like any other, with its real positions, and nothing
        // downstream needs a case for interpolation. Sema, ownership, AIF and codegen
        // see the call this builds.
        //
        // Each value is wrapped in `show(...)`, the `Display` trait's method, which
        // is what makes a user type interpolate the moment it implements `Display`
        // rather than only the builtins doing so.
        if (current.type == TokenType.INTERP_BEGIN) {
            return self.parseInterpolation()
        }

        if (isLiteralToken(current)) {
            let literal = self.node(NodeKind.LITERAL_EXPR)
            literal.i1 = current.type as Int
            literal.s1 = current.value
            self.advance()
            return self.parseSuffixes(literal)
        }

        if (current.type == TokenType.IDENTIFIER) {
            let next = self.peek()

            // REQUIREMENTS 15. `spawn f(a)` and `join t`.
            //
            // **Contextual, not reserved**, and that is not a stylistic choice: the
            // tree already contains `fn spawn(w: World, seed: Float)` in
            // the retired corpus program g4_ecs_world and a struct field named `spawn` in
            // tests/test_62_split_release.psm. Reserving the word would stop both
            // compiling, and a corpus program that no longer builds fails the
            // byte-identical-output rule for a reason that has nothing to do with
            // the change being made -- which is the worst way to lose that signal.
            //
            // The rule is one token of lookahead and it is exact. A spawn is always
            // `spawn` followed by the *name* of the function to run, so an
            // IDENTIFIER follows. An ordinary call to something named `spawn` has a
            // `(` there, an ordinary use has an operator or a separator, and a field
            // access reaches its name through `.` and never comes through here at
            // all. No existing spelling is claimed.
            if (next.type == TokenType.IDENTIFIER) {
                if (current.value.equals("spawn")) {
                    let spawnNode = self.node(NodeKind.SPAWN_EXPR)
                    self.advance()
                    let callee = self.parsePrimary()
                    if (callee.kind != NodeKind.CALL_EXPR) {
                        diag_error_at_code("P3101", spawnNode.file, spawnNode.line, spawnNode.col, spawnNode.len,
                                      "`spawn` needs a call: write `spawn f(args)`, naming the function the task runs")
                    }
                    spawnNode.child1 = node_to_ptr(callee)
                    return spawnNode
                }
                if (current.value.equals("join")) {
                    let joinNode = self.node(NodeKind.JOIN_EXPR)
                    self.advance()
                    joinNode.child1 = node_to_ptr(self.parsePrimary())
                    return joinNode
                }
            }

            let opensStruct = next.type == TokenType.SEPARATOR and next.value.equals("{")
            if (opensStruct and self.allowStructLit == 1) {
                self.advance()
                return self.parseStructLiteral(current)
            }

            // `Box<Int> { value: 7 }`. The type arguments are parsed into a
            // TYPE_ANNOTATION on child2, where sema resolves them the same way it
            // resolves the annotation in `let b: Box<Int>` -- so the literal and the
            // annotation cannot disagree about which instantiation they mean.
            if (self.allowStructLit == 1 and self.looksLikeTypeArgs("{")) {
                self.advance()
                let named = self.node(NodeKind.TYPE_ANNOTATION)
                named.s1 = current.value
                self.matchVal(TokenType.RELATIONAL_OPERATOR, "<")
                self.parseTypeArgList(named)

                let structLit = self.parseStructLiteral(current)
                structLit.child2 = node_to_ptr(named)
                return structLit
            }

            // `vecNew<Int>()` -- explicit type arguments on a call. Needed wherever
            // inference has nothing to work from: a constructor takes no argument
            // that mentions its own element type, so `T` is unsolvable there and
            // has to be written.
            //
            // Unlike the struct-literal case this is not gated on allowStructLit.
            // That flag exists to stop `for i in 0..n {` reading `n {` as a literal,
            // and a `(` is not a block -- there is nothing for it to disambiguate.
            // `Result<Int, String>.Ok` -- a generic enum's variant, qualified by the
            // instantiation. The qualifier is left as a TYPE_ANNOTATION and
            // parseSuffixes hangs the `.` off it, so sema receives the same shape it
            // gets for `Shape.Dot` with the arguments attached.
            //
            // The scan settles this against `a < b . c` on the first `.`, which is
            // not a token a type argument list may contain.
            if (self.looksLikeTypeArgs(".")) {
                self.advance()
                let qualifier = self.node(NodeKind.TYPE_ANNOTATION)
                qualifier.s1 = current.value
                self.matchVal(TokenType.RELATIONAL_OPERATOR, "<")
                self.parseTypeArgList(qualifier)
                return self.parseSuffixes(qualifier)
            }

            if (self.looksLikeTypeArgs("(")) {
                self.advance()
                let named = self.node(NodeKind.TYPE_ANNOTATION)
                named.s1 = current.value
                self.matchVal(TokenType.RELATIONAL_OPERATOR, "<")
                self.parseTypeArgList(named)

                let identifier = self.node(NodeKind.IDENTIFIER_EXPR)
                identifier.s1 = current.value
                self.expectVal(TokenType.SEPARATOR, "(", "call")
                let call = self.parseCall(identifier)
                call.child3 = node_to_ptr(named)
                return self.parseSuffixes(call)
            }

            let identifier = self.node(NodeKind.IDENTIFIER_EXPR)
            identifier.s1 = current.value
            self.advance()
            return self.parseSuffixes(identifier)
        }

        // The same gap as the literal above, and closed the same way: `(a + b).x`
        // and `[1, 2].length()` are expressions whose suffixes nobody was offering.
        if (self.matchVal(TokenType.SEPARATOR, "(")) {
            let inner = self.parseExpression(0)
            self.expectVal(TokenType.SEPARATOR, ")", "parenthesized expression")
            return self.parseSuffixes(inner)
        }

        if (self.matchVal(TokenType.SEPARATOR, "[")) {
            return self.parseSuffixes(self.parseArrayLiteral())
        }

        // Nothing else begins an expression with `{` -- a block is a statement, and
        // a closure opens with `|` -- so a map literal claims no existing spelling.
        // Gated as a struct literal is, so a `for` head ending at `{` is never read
        // as one.
        if (self.allowStructLit == 1 and self.matchVal(TokenType.SEPARATOR, "{")) {
            return self.parseSuffixes(self.parseMapLiteral())
        }

        self.fatal("expected an expression, found ".concat(parserDescribe(current),
                                                        " (a ",
                                                        typeToString(current.type),
                                                        ")"))
        return self.node(NodeKind.ERROR_NODE)
    }
}
