// Expressions.
//
// Precedence climbing: parseExpression handles binary operators by precedence,
// parseUnary the prefix operators, parsePostfix the `as` chain, and
// parsePrimary the atoms plus the call/index/member suffixes that bind tightest.

import lexer.token
import common.text
import ast.nodes
import common.diagnostics
import std.string

// Bitwise operators bind *tighter* than comparison, unlike C.
//
// C puts & | ^ below == and !=, so `flags & MASK != 0` silently means
// `flags & (MASK != 0)`. That is C's best-known precedence mistake -- Ritchie said
// as much, and both Rust and Go corrected it. Prismio has no compatibility reason
// to inherit it, and the ordering below makes the natural reading the correct one.
// Everything else follows C.
private fn getOperatorPrecedence(t: Token) -> Int {
    if (strEquals(t.value, "or")) { return 1 }
    if (strEquals(t.value, "and")) { return 2 }
    if (t.type == TokenType.KEYWORD) { return 0 }

    if (strEquals(t.value, "==") or strEquals(t.value, "!=")) { return 3 }
    if (strEquals(t.value, "<") or strEquals(t.value, ">") or strEquals(t.value, "<=") or strEquals(t.value, ">=")) { return 4 }
    if (strEquals(t.value, "|")) { return 5 }
    if (strEquals(t.value, "^")) { return 6 }
    if (strEquals(t.value, "&")) { return 7 }
    if (strEquals(t.value, "<<") or strEquals(t.value, ">>")) { return 8 }
    if (strEquals(t.value, "+") or strEquals(t.value, "-")) { return 9 }
    if (strEquals(t.value, "*") or strEquals(t.value, "/") or strEquals(t.value, "%")) { return 10 }

    return 0
}

private fn isBinaryOperator(t: Token) -> Bool {
    if (t.type == TokenType.ARITHMETIC_OPERATOR) { return true }
    if (t.type == TokenType.RELATIONAL_OPERATOR) { return true }
    return strEquals(t.value, "and") or strEquals(t.value, "or")
}

internal fn parseExpression(p: Parser, precedence: Int) -> ASTNode {
    let mut left = parseUnary(p)

    loop {
        let operatorToken = p.current()
        if (isBinaryOperator(operatorToken) == false) { break }

        let operatorPrecedence = getOperatorPrecedence(operatorToken)
        if (operatorPrecedence == 0 or operatorPrecedence < precedence) { break }

        let op = operatorToken.value
        p.advance()

        // Left associativity: the right operand binds only tighter operators.
        let right = parseExpression(p, operatorPrecedence + 1)

        // From the operator token, not from where the parser is now. The right
        // operand has been consumed by this point, so `parserCurrent` is the
        // token *after* the whole expression -- the same off-by-one the compound
        // assignment in parse/stmt.psm records, and this is the other half of it.
        //
        // It stayed invisible because nothing had ever reported a source
        // position out of a BINARY_EXPR: sema points at operands, and `-g` takes
        // its locations from statements. `--overflow-checks` is the first thing
        // that does, and it named the line below the addition that overflowed.
        //
        // The operator is the right anchor rather than the left operand's start,
        // because what the position identifies is the *operation* -- which is
        // what overflowed, and which is what a reader looks for on the line.
        let binary = parserNodeFrom(NodeKind.BINARY_EXPR, operatorToken)
        binary.s1 = op
        binary.child1 = node_to_ptr(left)
        binary.child2 = node_to_ptr(right)
        left = binary
    }

    return left
}

// Folds `-<numeric literal>` into the literal itself rather than lowering it to
// `sub 0, n`. Negative numbers then still count as literals, which is what lets
// them appear where a constant is required (a global initializer) and what lets
// `let x: I8 = -5` reach sema's int-literal coercion.
//
// Guarded on the leading '-' so `--5` stays a negation of the literal -5 instead
// of folding into the nonsense literal "--5".
private fn foldNegativeLiteral(operand: ASTNode, minus: Token) -> Bool {
    if (operand.kind != NodeKind.LITERAL_EXPR) { return false }

    let isNumber = operand.i1 == TokenType.NUMBER_LITERAL or operand.i1 == TokenType.FLOAT_LITERAL
    if (isNumber == false or strStartsWith(operand.s1, "-")) { return false }

    operand.s1 = strConcat("-", operand.s1)
    // The folded literal's span still covered only the digits, so a diagnostic
    // about `-42` underlined `42`. Widen it to include the sign that is now part
    // of its value.
    operand.line = minus.line
    operand.col = minus.col
    operand.len = operand.len + 1
    return true
}

// Prefix operators bind tighter than any binary operator, so they sit between
// parseExpression and parsePrimary. Recursing into parseUnary rather than
// parsePrimary is what makes `--x` and `!!b` parse.
private fn parseUnary(p: Parser) -> ASTNode {
    let current = p.current()

    let isNegate = current.type == TokenType.ARITHMETIC_OPERATOR and strEquals(current.value, "-")
    let isNot = current.type == TokenType.NEGATION and strEquals(current.value, "!")
    let isComplement = current.type == TokenType.ARITHMETIC_OPERATOR and strEquals(current.value, "~")

    if (isNegate == false and isNot == false and isComplement == false) {
        return parsePostfix(p)
    }

    let op = current.value
    p.advance()
    let operand = parseUnary(p)

    if (strEquals(op, "-") and foldNegativeLiteral(operand, current)) {
        return operand
    }

    let unary = p.node(NodeKind.UNARY_EXPR)
    unary.s1 = op
    unary.child1 = node_to_ptr(operand)
    return unary
}

// `expr as Type`. Binds tighter than any binary operator and looser than a prefix
// operator, so `-x as I64` negates first and `a + b as I64` converts only b.
// Looping allows `x as I64 as Float` to chain left to right.
private fn parsePostfix(p: Parser) -> ASTNode {
    let mut expr = parsePrimary(p)

    while (p.matchVal(TokenType.KEYWORD, "as")) {
        let cast = p.node(NodeKind.CAST_EXPR)
        cast.child1 = node_to_ptr(expr)
        cast.child2 = node_to_ptr(parseTypeAnnotation(p))
        expr = cast
    }

    return expr
}

// Does an identifier at the cursor begin `Name<...>` followed by `opener`?
//
// A pure scan over the token chain: it builds nothing and, crucially, **mutates
// nothing**. The obvious implementation is to speculatively parse the argument
// list and rewind on failure, and it is wrong here for one specific reason --
// parserExpectCloseAngle splits a `>>` token in place, and that edit survives a
// rewind. `a < b >> c` would come back from a failed speculation as `a < b > c`.
//
// Scanning cannot decide the general case and does not try. It admits only the
// tokens a type argument list can contain, so anything else -- an operator, a
// literal, a call -- settles it as a comparison immediately.
private fn looksLikeTypeArgs(p: Parser, opener: String) -> Bool {
    let mut tok = ptr_to_token(p.current).tokNext
    if (nodeIsNull(tok)) { return false }
    if (strEquals(ptr_to_token(tok).value, "<") == false) { return false }

    let mut depth = 1
    tok = ptr_to_token(tok).tokNext
    while (nodeExists(tok) and depth > 0) {
        let current = ptr_to_token(tok)
        if (current.type == TokenType.IDENTIFIER) {
            // nothing to do: a type name
        } else if (strEquals(current.value, "<")) {
            depth = depth + 1
        } else if (strEquals(current.value, ">")) {
            depth = depth - 1
        } else if (strEquals(current.value, ">>")) {
            depth = depth - 2
        } else if (strEquals(current.value, ",")) {
            // nothing to do: an argument separator
        } else if (strEquals(current.value, "[")) {
            // nothing to do: an array element type
        } else if (strEquals(current.value, "]")) {
            // nothing to do
        } else if (strEquals(current.value, "?")) {
            // nothing to do: an optional suffix
        } else {
            return false
        }
        tok = current.tokNext
    }

    if (depth != 0) { return false }
    if (nodeIsNull(tok)) { return false }
    return strEquals(ptr_to_token(tok).value, opener)
}

// The cursor is on the `{`. Both callers have consumed the name already -- the
// generic one had to consume an argument list between the two.
private fn parseStructLiteral(p: Parser, name: Token) -> ASTNode {
    let structLit = p.node(NodeKind.STRUCT_LITERAL_EXPR)
    structLit.s1 = name.value
    p.expectVal(TokenType.SEPARATOR, "{", "struct literal")

    let fields = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        let field = p.node(NodeKind.STRUCT_FIELD)
        let fieldName = p.current()
        field.s1 = fieldName.value
        p.expectToken(TokenType.IDENTIFIER, "struct literal field")
        p.expectVal(TokenType.SEPARATOR, ":", "struct literal")
        field.child1 = node_to_ptr(parseExpression(p, 0))
        nodeListPush(fields, field)

        p.matchVal(TokenType.SEPARATOR, ",")
    }

    p.expectVal(TokenType.SEPARATOR, "}", "struct literal")
    structLit.child1 = fields.head
    return structLit
}

private fn parseArrayLiteral(p: Parser) -> ASTNode {
    let arrayLit = p.node(NodeKind.ARRAY_LITERAL_EXPR)

    let elements = nodeList()
    if (p.checkVal(TokenType.SEPARATOR, "]") == false) {
        loop {
            nodeListPush(elements, parseExpression(p, 0))
            if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
        }
    }

    p.expectVal(TokenType.SEPARATOR, "]", "array literal")
    arrayLit.child1 = elements.head
    return arrayLit
}

private fn parseCall(p: Parser, callee: ASTNode) -> ASTNode {
    let call = p.node(NodeKind.CALL_EXPR)
    // Point the call at its callee rather than at the first argument, so
    // "expects 1 argument, found 2" underlines the name of the thing being
    // called.
    nodeSpanFrom(call, callee)
    call.child1 = node_to_ptr(callee)

    let arguments = nodeList()
    if (p.checkVal(TokenType.SEPARATOR, ")") == false) {
        loop {
            nodeListPush(arguments, parseExpression(p, 0))
            if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
        }
    }

    p.expectVal(TokenType.SEPARATOR, ")", "function call")
    call.child2 = arguments.head
    return call
}

// The suffixes that bind tightest, applied left to right: `f(x)[i].field`.
private fn parseSuffixes(p: Parser, base: ASTNode) -> ASTNode {
    let mut expr = base

    loop {
        if (p.matchVal(TokenType.SEPARATOR, "(")) {
            expr = parseCall(p, expr)
        } else if (p.matchVal(TokenType.SEPARATOR, "[")) {
            // The RANGE token is not a binary operator, so parsing the first
            // bound stops immediately before `..`. That makes one production
            // cover both `a[i]` and SPEC 8.4's `a[start..end]` without making
            // range a general expression operator.
            let first = parseExpression(p, 0)
            if (p.matchToken(TokenType.RANGE)) {
                let slice = p.node(NodeKind.SLICE_EXPR)
                nodeSpanFrom(slice, expr)
                slice.child1 = node_to_ptr(expr)
                slice.child2 = node_to_ptr(first)
                slice.child3 = node_to_ptr(parseExpression(p, 0))
                p.expectVal(TokenType.SEPARATOR, "]", "slice range")
                expr = slice
            } else {
                let index = p.node(NodeKind.INDEX_EXPR)
                nodeSpanFrom(index, expr)
                index.child1 = node_to_ptr(expr)
                index.child2 = node_to_ptr(first)
                p.expectVal(TokenType.SEPARATOR, "]", "array index")
                expr = index
            }
        } else if (p.matchVal(TokenType.SEPARATOR, ".")) {
            let member = p.node(NodeKind.MEMBER_ACCESS_EXPR)
            member.child1 = node_to_ptr(expr)
            let name = p.current()
            member.s1 = name.value
            p.expectToken(TokenType.IDENTIFIER, "member name")
            expr = member
        } else {
            break
        }
    }

    return expr
}

// v0.1 3.4. `|a: Int, b: Int| a + b`, and `|| 42` for one with no parameters.
//
// **Parameter types are written, and the body is an expression.** Both are the
// smallest form with the right structure rather than a limitation the design
// needs: an inferred parameter type has to be solved from the callee's signature
// at the call site, and a block body has to take its type from its `return`
// statements. Neither changes this syntax when it arrives.
//
// `|` at the start of a primary is unambiguous -- a bitwise-or is binary and is
// consumed by parseExpression's operator loop, so nothing else can begin here
// with one. `||` arrives as a single token from the scanner, which is why the
// empty list is a spelling rather than a special case.
private fn parseClosureExpr(p: Parser) -> ASTNode {
    let node = p.node(NodeKind.CLOSURE_EXPR)
    let opener = p.current()
    let empty = strEquals(opener.value, "||")
    p.advance()

    let params = nodeList()
    if (empty == false) {
        if (p.checkVal(TokenType.ARITHMETIC_OPERATOR, "|") == false) {
            loop {
                nodeListPush(params, parseParameter(p, false))
                if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
            }
        }
        p.expectVal(TokenType.ARITHMETIC_OPERATOR, "|", "closure parameter list")
    }

    node.child1 = params.head
    node.child2 = node_to_ptr(parseExpression(p, 0))
    return node
}

private fn atClosure(p: Parser) -> Bool {
    let current = p.current()
    if (current.type != TokenType.ARITHMETIC_OPERATOR) { return false }
    return strEquals(current.value, "|") or strEquals(current.value, "||")
}

private fn isLiteralToken(t: Token) -> Bool {
    if (t.type == TokenType.NUMBER_LITERAL) { return true }
    if (t.type == TokenType.FLOAT_LITERAL) { return true }
    if (t.type == TokenType.STRING_LITERAL) { return true }
    if (t.type == TokenType.BOOL_LITERAL) { return true }
    if (t.type == TokenType.CHAR_LITERAL) { return true }
    return false
}

private fn parsePrimary(p: Parser) -> ASTNode {
    let current = p.current()

    if (p.atClosure()) { return parseClosureExpr(p) }

    // REQUIREMENTS 4. The absent reference. A keyword rather than an identifier,
    // so it cannot be shadowed by a binding -- `let none = 5` would otherwise
    // make the literal mean something else halfway down a file.
    if (current.type == TokenType.KEYWORD and strEquals(current.value, "none")) {
        let noneLiteral = p.node(NodeKind.NONE_LITERAL_EXPR)
        p.advance()
        return noneLiteral
    }

    // v0.1 3.6. Through parseSuffixes, so that `"a,b".contains(",")` parses.
    //
    // It did not, and the reason was here rather than anywhere near the method
    // call rewrite: a literal was the one primary that returned without offering
    // its suffixes, so the `.` was left for the enclosing production and reported
    // as "expected `)` in function call, found `.`". Nothing was deciding that a
    // literal has no members -- the question was never asked.
    //
    // `0..n` is unaffected: `..` lexes as RANGE, which is not the SEPARATOR `.`
    // parseSuffixes matches on.
    if (isLiteralToken(current)) {
        let literal = p.node(NodeKind.LITERAL_EXPR)
        literal.i1 = current.type
        literal.s1 = current.value
        p.advance()
        return parseSuffixes(p, literal)
    }

    if (current.type == TokenType.IDENTIFIER) {
        let next = p.peek()

        // REQUIREMENTS 15. `spawn f(a)` and `join t`.
        //
        // **Contextual, not reserved**, and that is not a stylistic choice: the
        // tree already contains `fn spawn(w: World, seed: Float)` in
        // aif/corpus/g4_ecs_world.psm and a struct field named `spawn` in
        // tests/test_62_split_release.psm. Reserving the word would stop both
        // compiling, and a corpus program that no longer builds fails the
        // byte-identical-output rule for a reason that has nothing to do with
        // the change being made -- which is the worst way to lose that signal.
        //
        // The rule is one token of lookahead and it is exact. A spawn is always
        // `spawn` followed by the *name* of the function to run, so an
        // IDENTIFIER follows. An ordinary call to something named `spawn` has a
        // `(` there, an ordinary use has an operator or a separator, and a field
        // access reaches its name through `.` and never comes through here at
        // all. No existing spelling is claimed.
        if (next.type == TokenType.IDENTIFIER) {
            if (strEquals(current.value, "spawn")) {
                let spawnNode = p.node(NodeKind.SPAWN_EXPR)
                p.advance()
                let callee = parsePrimary(p)
                if (callee.kind != NodeKind.CALL_EXPR) {
                    diag_error_at_code("P3101", spawnNode.file, spawnNode.line, spawnNode.col, spawnNode.len,
                                  "`spawn` needs a call: write `spawn f(args)`, naming the function the task runs")
                }
                spawnNode.child1 = node_to_ptr(callee)
                return spawnNode
            }
            if (strEquals(current.value, "join")) {
                let joinNode = p.node(NodeKind.JOIN_EXPR)
                p.advance()
                joinNode.child1 = node_to_ptr(parsePrimary(p))
                return joinNode
            }
        }

        let opensStruct = next.type == TokenType.SEPARATOR and strEquals(next.value, "{")
        if (opensStruct and p.allowStructLit == 1) {
            p.advance()
            return parseStructLiteral(p, current)
        }

        // `Box<Int> { value: 7 }`. The type arguments are parsed into a
        // TYPE_ANNOTATION on child2, where sema resolves them the same way it
        // resolves the annotation in `let b: Box<Int>` -- so the literal and the
        // annotation cannot disagree about which instantiation they mean.
        if (p.allowStructLit == 1 and p.looksLikeTypeArgs("{")) {
            p.advance()
            let named = p.node(NodeKind.TYPE_ANNOTATION)
            named.s1 = current.value
            p.matchVal(TokenType.RELATIONAL_OPERATOR, "<")
            parseTypeArgList(p, named)

            let structLit = parseStructLiteral(p, current)
            structLit.child2 = node_to_ptr(named)
            return structLit
        }

        // `vecNew<Int>()` -- explicit type arguments on a call. Needed wherever
        // inference has nothing to work from: a constructor takes no argument
        // that mentions its own element type, so `T` is unsolvable there and
        // has to be written.
        //
        // Unlike the struct-literal case this is not gated on allowStructLit.
        // That flag exists to stop `for i in 0..n {` reading `n {` as a literal,
        // and a `(` is not a block -- there is nothing for it to disambiguate.
        // `Option<Int>.None` -- a generic enum's variant, qualified by the
        // instantiation. The qualifier is left as a TYPE_ANNOTATION and
        // parseSuffixes hangs the `.` off it, so sema receives the same shape it
        // gets for `Shape.Dot` with the arguments attached.
        //
        // The scan settles this against `a < b . c` on the first `.`, which is
        // not a token a type argument list may contain.
        if (p.looksLikeTypeArgs(".")) {
            p.advance()
            let qualifier = p.node(NodeKind.TYPE_ANNOTATION)
            qualifier.s1 = current.value
            p.matchVal(TokenType.RELATIONAL_OPERATOR, "<")
            parseTypeArgList(p, qualifier)
            return parseSuffixes(p, qualifier)
        }

        if (p.looksLikeTypeArgs("(")) {
            p.advance()
            let named = p.node(NodeKind.TYPE_ANNOTATION)
            named.s1 = current.value
            p.matchVal(TokenType.RELATIONAL_OPERATOR, "<")
            parseTypeArgList(p, named)

            let identifier = p.node(NodeKind.IDENTIFIER_EXPR)
            identifier.s1 = current.value
            p.expectVal(TokenType.SEPARATOR, "(", "call")
            let call = parseCall(p, identifier)
            call.child3 = node_to_ptr(named)
            return parseSuffixes(p, call)
        }

        let identifier = p.node(NodeKind.IDENTIFIER_EXPR)
        identifier.s1 = current.value
        p.advance()
        return parseSuffixes(p, identifier)
    }

    // The same gap as the literal above, and closed the same way: `(a + b).x`
    // and `[1, 2].length()` are expressions whose suffixes nobody was offering.
    if (p.matchVal(TokenType.SEPARATOR, "(")) {
        let inner = parseExpression(p, 0)
        p.expectVal(TokenType.SEPARATOR, ")", "parenthesized expression")
        return parseSuffixes(p, inner)
    }

    if (p.matchVal(TokenType.SEPARATOR, "[")) {
        return parseSuffixes(p, parseArrayLiteral(p))
    }

    p.fatal(strConcat(strConcat("expected an expression, found ", parserDescribe(current)),
                               strConcat(" (a ", strConcat(typeToString(current.type), ")"))))
    return p.node(NodeKind.ERROR_NODE)
}
