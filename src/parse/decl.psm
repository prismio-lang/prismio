// Top-level declarations, type annotations, and the annotations that ride on
// them: AIF's `unique`/`pin` and the FFI ownership contracts.

import lexer.token
import common.text
import ast.nodes
import common.diagnostics
import std.string
import std.option

internal fn parseDeclaration(p: Parser) -> ASTNode {
    // v0.1 3.5. `priv fn helper(...)` -- visible only inside the file that
    // declares it.
    //
    // **Contextual, and opt-in**, for the two reasons `workload` gives one screen
    // down: reserving the word would break a program that uses it as a name, and
    // an identifier cannot begin a declaration anyway, so `priv fn` is
    // unambiguous. Opt-in rather than private-by-default because every
    // cross-module call in `src/` and every `std` function is public today -- a
    // private default would have made this a rename of the whole tree.
    let visibility = p.visibilityLevel()
    if (visibility >= 0) {
        let marker = p.current()
        let markerText = strClone(marker.value)
        let onFunction = p.privateTakesFunction()
        p.advance()
        let declaration = parseDeclaration(p)
        if (onFunction) {
            declaration.i2 = visibility
        } else {
            // Rejected rather than accepted and ignored, for the reason a `trait`
            // default body is: the check lives in overload resolution, so a
            // marker on a type or a global would be a promise the compiler does
            // not keep -- which is worse than an error.
            diag_error_at_code("P3001", marker.file, marker.line, marker.col, marker.len,
                          strConcat(strConcat("`", markerText),
                                    "` is only accepted on a function in v0.1"))
            diag_note("a visibility marker on a type or a global is not enforced yet, and accepting it would promise that it is")
        }
        return declaration
    }

    if (p.checkVal(TokenType.KEYWORD, "import")) { return parseImportStatement(p) }
    if (p.checkVal(TokenType.KEYWORD, "let")) { return parseVariableDecl(p) }
    if (p.checkVal(TokenType.KEYWORD, "extern")) { return parseExternFnDecl(p) }
    if (p.checkVal(TokenType.KEYWORD, "fn")) { return parseFunctionDecl(p) }
    if (p.checkVal(TokenType.KEYWORD, "struct")) { return parseStructDecl(p) }
    if (p.checkVal(TokenType.KEYWORD, "enum")) { return parseEnumDecl(p) }
    if (p.checkVal(TokenType.KEYWORD, "impl")) { return parseImplDecl(p) }
    if (p.checkVal(TokenType.KEYWORD, "trait")) { return parseTraitDecl(p) }
    if (p.atWorkload()) { return parseWorkloadDecl(p) }

    // Nothing here starts a declaration. Report it, skip to the next thing that
    // could, and hand back a placeholder -- so a file with three broken functions
    // reports three errors instead of only the first.
    let bad = p.node(NodeKind.ERROR_NODE)
    let current = p.current()
    p.error(strConcat(strConcat("expected a declaration, found ", parserDescribe(current)),
                               " (expected one of `import`, `let`, `fn`, `extern`, `struct`, `enum`, `impl`, `trait`)"))
    p.synchronize()
    return bad
}

// The visibility a marker before a declaration keyword asks for, or -1 when the
// token is not a marker at all. The levels are the values stored in `i2`:
//
//   0  public    -- everywhere, and the default, so the marker is redundant
//   1  private   -- the declaring file
//   2  internal  -- the declaring package
//
// Recognising every declaration kind and rejecting all but `fn` in
// parseDeclaration keeps the marker consumed either way, so a misplaced one is a
// single error rather than a cascade.
//
// These are **contextual**, matched as identifiers rather than reserved as
// keywords, which is how `priv` has always worked. Reserving them would break
// any program with a variable named `public` and buy nothing: a marker is only a
// marker directly before a declaration keyword, and nothing else can appear there.
//
// `protected` is deliberately absent. It means "this type and its subtypes", and
// there is no inheritance here to give it a referent -- Kotlin rejects it at top
// level for the same reason. Adding it would be a spelling whose only possible
// outcome is an error.
private fn visibilityLevel(p: Parser) -> Int {
    if (p.check(TokenType.IDENTIFIER) == false) { return -1 }
    let current = p.current()

    let mut level = -1
    // `priv` was the pre-v0.1 spelling and is gone rather than kept as an alias:
    // v0.1 is unreleased, so nothing outside this tree can be holding it, and two
    // spellings for one level is surface that would have to be documented,
    // diagnosed and kept in step forever to save a single rename.
    if (strEquals(current.value, "private")) { level = 1 }
    if (strEquals(current.value, "public")) { level = 0 }
    if (strEquals(current.value, "internal")) { level = 2 }
    if (level < 0) { return -1 }

    let next = p.peek()
    if (next.type != TokenType.KEYWORD) { return -1 }
    if (strEquals(next.value, "fn")) { return level }
    if (strEquals(next.value, "extern")) { return level }
    if (strEquals(next.value, "struct")) { return level }
    if (strEquals(next.value, "enum")) { return level }
    if (strEquals(next.value, "let")) { return level }
    return -1
}

private fn privateTakesFunction(p: Parser) -> Bool {
    let next = p.peek()
    return strEquals(next.value, "fn") or strEquals(next.value, "extern")
}

// ---------------------------------------------------------
// Types
// ---------------------------------------------------------

// Consumes the '>' that closes a generic argument.
//
// The lexer produces `>>` as a single shift token, so `List<List<Int>>` would
// otherwise fail to close the inner argument -- the classic C++ problem. Rather
// than requiring a space, split the token: rewrite it to a single '>' in place
// and leave it for the enclosing type to consume.
//
// The token's *type* has to be rewritten too, not just its text. The lexer types
// a two-character operator as arithmetic, so leaving `>>` as `>` with the old
// type made the enclosing argument fail with "expected `>`, found `>`" -- which
// is what this did until a nested container needed it. Written with the comment
// above and never exercised, because `List<List<T>>` was unwritable and so nobody
// had written one.
private fn expectCloseAngle(p: Parser, context: String) {
    let current = p.current()
    if (strEquals(current.value, ">>")) {
        current.value = ">"
        current.type = TokenType.RELATIONAL_OPERATOR
        return
    }
    p.expectVal(TokenType.RELATIONAL_OPERATOR, ">", context)
}

// A trait reference is a path in semantic trait position, not a type. Its
// arguments are type annotations because `From<List<T>>` applies a trait to a
// type tree, but the root keeps its own kind so no pass can accidentally ask for
// the runtime type of `From`.
private fn parseTraitRef(p: Parser) -> ASTNode {
    let traitRef = p.node(NodeKind.TRAIT_REF)
    let name = p.current()
    traitRef.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "a trait name in a type parameter list")
    if (p.matchVal(TokenType.RELATIONAL_OPERATOR, "<")) {
        parseTraitRefArgs(p, traitRef)
    }
    return traitRef
}

// A trait reference's arguments, which unlike a type's may fix an associated
// type: `Container<Item = Int>`. Not parseTypeArgList, which is shared with type
// annotations and generic struct literals and must keep meaning exactly what it
// meant there.
//
// Positional arguments stay on child1 so arity checking is untouched; equality
// constraints go on child2, because they are a further demand on an
// implementation rather than an argument the trait declared.
private fn parseTraitRefArgs(p: Parser, traitRef: ASTNode) {
    traitRef.i2 = 1
    let args = nodeList()
    let constraints = nodeList()
    loop {
        if (p.check(TokenType.IDENTIFIER) and p.peek().type == TokenType.ASSIGNMENT_OPERATOR) {
            let name = p.current()
            p.advance()
            p.advance()
            let constraint = p.node(NodeKind.ASSOC_TYPE)
            constraint.s1 = name.value
            constraint.child1 = node_to_ptr(parseTypeAnnotation(p))
            nodeListPush(constraints, constraint)
        } else {
            nodeListPush(args, parseTypeAnnotation(p))
        }
        if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
    }
    traitRef.child1 = args.head
    traitRef.child2 = constraints.head
    p.expectCloseAngle("trait argument list")
}

// The declaration keeps comma-joined parameter names for substitution and
// mangling, while genericInfo owns one GENERIC_PARAM node per name and structural
// TRAIT_REF nodes for its bounds. The split is intentional: names are a flat
// substitution environment, but a bound such as `From<List<T>>` is a tree and
// must not be encoded with punctuation delimiters.
private fn parseGenericParams(p: Parser, owner: ASTNode) -> String {
    if (p.matchVal(TokenType.RELATIONAL_OPERATOR, "<") == false) { return "" }

    let mut params = ""
    let genericParams = nodeList()
    loop {
        let name = p.current()
        p.expectToken(TokenType.IDENTIFIER, "type parameter name")

        let genericParam = parserNodeFrom(NodeKind.GENERIC_PARAM, name)
        genericParam.s1 = name.value
        if (p.matchVal(TokenType.SEPARATOR, ":")) {
            let bounds = nodeList()
            loop {
                nodeListPush(bounds, parseTraitRef(p))
                if (p.matchVal(TokenType.ARITHMETIC_OPERATOR, "+") == false) { break }
            }
            genericParam.child1 = bounds.head
        }
        nodeListPush(genericParams, genericParam)

        if (strEquals(params, "")) {
            params = strClone(name.value)
        } else {
            params = strConcat(strConcat(params, ","), name.value)
        }
        if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
    }
    p.expectCloseAngle("type parameter list")
    owner.genericInfo = genericParams.head
    return params
}

// The shared tail of `Name<...>`: the caller has consumed the name and the `<`,
// and this consumes the arguments and the `>`, hanging the list on `child1` and
// marking `i2`.
//
// Three constructs need it -- a type annotation, a generic struct literal, and a
// call with explicit type arguments -- and they had better agree on the shape
// they produce, because sema resolves all three through one path.
internal fn parseTypeArgList(p: Parser, node: ASTNode) {
    node.i2 = 1
    let args = nodeList()
    loop {
        nodeListPush(args, parseTypeAnnotation(p))
        if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
    }
    node.child1 = args.head
    p.expectCloseAngle("type argument list")
}

// Deep-copy one type annotation tree. An impl target and each method annotation
// must own separate child chains: substitution mutates annotations in place, so
// sharing the header's `Box<T>` with every receiver would make instantiating one
// method rewrite the target seen by all the others.
private fn copyTypeAnnotationChain(ptr: Ptr) -> Ptr {
    let copies = nodeList()
    let mut p = ptr
    while (nodeExists(p)) {
        let source = ptr_to_node(p)
        let copy = createNode(NodeKind.TYPE_ANNOTATION)
        copy.s1 = source.s1
        copy.s2 = source.s2
        copy.i1 = source.i1
        copy.i2 = source.i2
        copy.i3 = source.i3
        copy.line = source.line
        copy.col = source.col
        copy.len = source.len
        copy.file = source.file
        copy.child1 = copyTypeAnnotationChain(source.child1)
        nodeListPush(copies, copy)
        p = source.next
    }
    return copies.head
}

private fn copyTypeAnnotationInto(target: ASTNode, sourcePtr: Ptr) {
    let source = ptr_to_node(sourcePtr)
    target.s1 = source.s1
    target.s2 = source.s2
    target.i1 = source.i1
    target.i2 = source.i2
    target.i3 = source.i3
    target.child1 = copyTypeAnnotationChain(source.child1)
}

private fn copyTraitRefChain(ptr: Ptr) -> Ptr {
    let copies = nodeList()
    let mut p = ptr
    while (nodeExists(p)) {
        let source = ptr_to_node(p)
        let copy = createNode(NodeKind.TRAIT_REF)
        copy.s1 = source.s1
        copy.i2 = source.i2
        nodeSpanFrom(copy, source)
        copy.child1 = copyTypeAnnotationChain(source.child1)
        copy.child2 = copyAssocTypeChain(source.child2)
        nodeListPush(copies, copy)
        p = source.next
    }
    return copies.head
}

private fn copyAssocTypeChain(ptr: Ptr) -> Ptr {
    let copies = nodeList()
    let mut p = ptr
    while (nodeExists(p)) {
        let source = ptr_to_node(p)
        let copy = createNode(NodeKind.ASSOC_TYPE)
        copy.s1 = source.s1
        nodeSpanFrom(copy, source)
        copy.child1 = copyTypeAnnotationChain(source.child1)
        nodeListPush(copies, copy)
        p = source.next
    }
    return copies.head
}

private fn copyGenericParamChain(ptr: Ptr) -> Ptr {
    let copies = nodeList()
    let mut p = ptr
    while (nodeExists(p)) {
        let source = ptr_to_node(p)
        let copy = createNode(NodeKind.GENERIC_PARAM)
        copy.s1 = source.s1
        nodeSpanFrom(copy, source)
        copy.child1 = copyTraitRefChain(source.child1)
        nodeListPush(copies, copy)
        p = source.next
    }
    return copies.head
}

private fn implTargetAnnotation(p: Parser) -> Ptr {
    let owner = ptr_to_node(p.implType)
    let header = ptr_to_node(owner.child3)
    return header.child1
}

// `Self` inside an `impl` block is the type the block is for.
//
// Resolved here, in the parser, because this is the only place that knows which
// block an annotation is inside: by the time sema sees the method it is an
// ordinary top-level function and `Self` is an unknown type name.
//
// Inside a `trait` body it is deliberately left alone. There is no type there to
// resolve it to, and the conformance check substitutes it once per `impl` --
// which is the only thing a trait signature is ever read for.
internal fn parseTypeAnnotation(p: Parser) -> ASTNode {
    let typeNode = p.node(NodeKind.TYPE_ANNOTATION)

    if (p.matchVal(TokenType.SEPARATOR, "[")) {
        typeNode.i1 = 1 // is_array
        typeNode.child1 = node_to_ptr(parseTypeAnnotation(p))
        p.expectVal(TokenType.SEPARATOR, "]", "array type")
        // REQUIREMENTS 4. `[T]?` binds the whole array, matching the suffix below
        // rather than reaching inside the brackets.
        if (p.matchVal(TokenType.SEPARATOR, "?")) { typeNode.i3 = 1 }
        return typeNode
    }

    let name = p.current()
    if (name.type == TokenType.IDENTIFIER or name.type == TokenType.KEYWORD) {
        // `dyn Show` -- a trait object. **Contextual, not reserved**, for the
        // reason the AIF annotations and `type` are: reserving a word breaks
        // programs already using it as a name, and `dyn` is only special when a
        // trait name follows it in type position.
        //
        // Named `dyn$Show`. `$` cannot occur in a source identifier, so the name
        // cannot collide, and every pass that resolves a named type resolves
        // this one without being taught anything -- the struct it names is
        // synthesised in sema.
        if (strEquals(name.value, "dyn") and p.peek().type == TokenType.IDENTIFIER) {
            p.advance()
            let traitName = p.current()
            typeNode.s1 = strConcat("dyn$", traitName.value)
            p.advance()
            if (p.matchVal(TokenType.SEPARATOR, "?")) { typeNode.i3 = 1 }
            return typeNode
        }

        if (strEquals(name.value, "Self") and nodeExists(p.implType)
            and ptr_to_node(p.implType).kind == NodeKind.IMPL_DECL) {
            copyTypeAnnotationInto(typeNode, implTargetAnnotation(p))
        } else {
            typeNode.s1 = name.value
        }
        p.advance()
    } else {
        p.fatal(strConcat("expected a type name, found ", parserDescribe(name)))
    }

    // A type constructor applied to arguments: `List<Int>`, `Map<String, Int>`.
    //
    // `i2` used to mean `is_list` and now means "this name has type arguments",
    // with the constructor in `s1` and the arguments a `next`-chain under
    // `child1`. `List<Int>` parses to exactly what it parsed to before -- one
    // argument, name "List" -- which is why generalising it changes no output.
    //
    // Unambiguous because this is type position. A `<` cannot be a less-than
    // here, so it is always an argument list, and the name in front of it does
    // not have to be known to the parser -- which is the whole point: `List` was
    // the only generic type because it was the only name this test admitted.
    if (p.matchVal(TokenType.RELATIONAL_OPERATOR, "<")) {
        if (strEquals(name.value, "Self") and nodeExists(p.implType)
            and ptr_to_node(p.implType).kind == NodeKind.IMPL_DECL) {
            p.fatal("`Self` already denotes the complete impl target and cannot take type arguments")
        }
        parseTypeArgList(p, typeNode)
    }

    // `T.Item` -- a projection through a trait's associated type. Its own node
    // rather than a name containing a dot: substitution has to resolve it to the
    // implementing type's choice, and encoding structure as text is what the
    // trait-argument work already had to undo once.
    if (p.checkVal(TokenType.SEPARATOR, ".")) {
        p.advance()
        let projection = p.node(NodeKind.ASSOC_TYPE_REF)
        let member = p.current()
        projection.s1 = member.value
        p.expectToken(TokenType.IDENTIFIER, "associated type name after `.`")
        projection.child1 = node_to_ptr(typeNode)
        if (p.matchVal(TokenType.SEPARATOR, "?")) { projection.i3 = 1 }
        return projection
    }

    // REQUIREMENTS 4. `T?` -- a reference that may be absent. Postfix, and after
    // the list argument so `List<Node>?` is an optional list rather than a list
    // of optionals; `List<Node?>` spells the other one, because the `?` there is
    // consumed by the recursive call above.
    if (p.matchVal(TokenType.SEPARATOR, "?")) { typeNode.i3 = 1 }

    return typeNode
}

// ---------------------------------------------------------
// Annotations
// ---------------------------------------------------------

// AIF annotations on a binding -- SPEC 5's `unique` and `pin`.
//
//     let unique buf = make_buffer()
//     let pin(T1) work = build()
//     let mut unique pin(T2) cache = ...
//
// **Contextual, not reserved**, for the same reason the FFI contracts are: SPEC 5
// requires that deleting every annotation leave a working program, and reserving
// two more words would break programs that already use them as names -- which is
// the opposite obligation. `unique` is an annotation only when another identifier
// follows it, so `let unique = 5` is still a variable called `unique`; `pin` only
// when a `(` follows.
internal fn atAnnotation(p: Parser, name: String) -> Bool {
    if (p.check(TokenType.IDENTIFIER) == false) { return false }

    let current = p.current()
    if (strEquals(current.value, name) == false) { return false }

    let next = p.peek()
    if (strEquals(name, "pin")) {
        return strEquals(next.value, "(")
    }
    return next.type == TokenType.IDENTIFIER
}

// Stored on the declaration's `s2`, which is free on a VARIABLE_DECL, encoded as
// text so `pin`'s tier travels without needing a second slot. Same idiom as the
// FFI contracts below, and for the same reason.
private fn parseAifAnnotations(p: Parser, node: ASTNode) {
    loop {
        if (p.atAnnotation("unique")) {
            p.expectToken(TokenType.IDENTIFIER, "unique annotation")
            node.s2 = strConcat(node.s2, "unique ")
        } else if (p.atAnnotation("pin")) {
            p.expectToken(TokenType.IDENTIFIER, "pin annotation")
            p.expectVal(TokenType.SEPARATOR, "(", "pin tier")
            let tier = p.current()
            p.expectToken(TokenType.IDENTIFIER, "a tier name such as T1")
            p.expectVal(TokenType.SEPARATOR, ")", "pin tier")
            node.s2 = strConcat(node.s2, strConcat(strConcat("pin:", tier.value), " "))
        } else {
            break
        }
    }
}

// FFI ownership contracts -- aif/spec/FFI.md 5.
//
// Postfix on the type, which is the form FFI.md 5.4's own examples use:
//
//     extern fn strlen(s: String borrow) -> Int
//     extern fn fopen(path: String borrow, mode: String borrow) -> File produce(fclose)
//     extern fn list_push(list: List borrow, item: Ptr retain_in(0))
//
// Three decisions worth stating, because each could reasonably have gone the
// other way:
//
// **Contextual, not reserved.** None of these is a keyword, so they lex as
// ordinary identifiers and a program may still call a variable `out` or a
// function `alias`. A contract is only recognised in the one position where a
// type annotation has just ended inside an `extern` declaration, and at top level
// the token after a return type is otherwise always a keyword, so there is
// nothing to be ambiguous with.
//
// **Parsed here, not in parseTypeAnnotation.** FFI.md 5 is explicit that a
// contract is part of an *extern declaration's signature* -- it describes foreign
// code. Putting it in the shared type parser would also make `let x: Int borrow`
// parse, which is not a thing and should not become one.
//
// **Stored on the type annotation's `s2`.** It is the only free slot on that
// node, and EXTERN_FUNCTION's own `s2` already carries the mangled symbol that
// sema caches there. String-encoded so `retain_in(k)` and `produce(free_fn)`
// carry their argument without needing a second slot.
//
// Call-site contracts (`pure`, `nocallback`, FFI 5.3) are deliberately not
// parsed. They drive the fact invalidation of FFI 6, which AIF-1 does not model
// at all -- there is no static-root invalidation to switch off. They trail the
// declaration, so adding them later breaks nothing.
private fn isFfiContractName(name: String) -> Bool {
    if (strEquals(name, "borrow")) { return true }
    if (strEquals(name, "retain")) { return true }
    if (strEquals(name, "retain_in")) { return true }
    if (strEquals(name, "consume")) { return true }
    if (strEquals(name, "out")) { return true }
    if (strEquals(name, "alias")) { return true }
    if (strEquals(name, "produce")) { return true }
    return false
}

// Whether the contract takes a parenthesised argument. Checked so that
// `borrow(3)` is a syntax error where it is written rather than a silently
// ignored suffix.
private fn ffiContractTakesArgument(name: String) -> Bool {
    if (strEquals(name, "retain_in")) { return true }
    if (strEquals(name, "produce")) { return true }
    return false
}

// Reads a contract, if one is present, onto the annotation it follows. Whether
// the contract makes sense in this position -- `alias` on a parameter, `produce`
// on an argument -- is sema's call, not the parser's.
private fn parseFfiContract(p: Parser, annotation: ASTNode) {
    let current = p.current()
    if (current.type != TokenType.IDENTIFIER) { return }
    if (isFfiContractName(current.value) == false) { return }

    let name = current.value
    p.advance()

    if (ffiContractTakesArgument(name)) {
        p.expectVal(TokenType.SEPARATOR, "(", "contract argument")
        let argument = p.current()
        let argumentText = argument.value
        p.advance()
        p.expectVal(TokenType.SEPARATOR, ")", "contract argument")
        annotation.s2 = strConcat(strConcat(name, ":"), argumentText)
        return
    }

    if (p.checkVal(TokenType.SEPARATOR, "(")) {
        diag_error_at_code("P3002", current.file, current.line, current.col, __builtin_string_len(name),
            strConcat(strConcat("the ", diagQuote(name)), " contract takes no argument"))
        diag_note("only `retain_in(k)` and `produce(free_fn)` are parameterised")
    }

    annotation.s2 = name
}

// ---------------------------------------------------------
// Declarations
// ---------------------------------------------------------

internal fn parseVariableDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "let", "variable declaration")
    let varNode = p.node(NodeKind.VARIABLE_DECL)

    if (p.matchVal(TokenType.KEYWORD, "mut")) {
        varNode.i1 = 1 // is_mutable
    }

    parseAifAnnotations(p, varNode)

    let name = p.current()
    varNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "variable name")

    if (p.matchVal(TokenType.SEPARATOR, ":")) {
        varNode.child1 = node_to_ptr(parseTypeAnnotation(p))
    }

    if (p.matchVal(TokenType.ASSIGNMENT_OPERATOR, "=")) {
        varNode.child2 = node_to_ptr(parseExpression(p, 0))
    }

    return varNode
}

// One `name: Type` pair. `extern` declarations may carry an FFI contract after
// the type; ordinary functions may carry a calling convention and `unique`
// before the name. Nothing else differs, so both parameter lists come through
// here.
// What a bare `self` is typed as. Inside an `impl` block it is the block's type;
// inside a `trait` it is `Self`, which has no type yet and is substituted once
// per conforming `impl`.
internal fn parseParameter(p: Parser, isExtern: Bool) -> ASTNode {
    let param = p.node(NodeKind.FUNCTION_PARAMETER)

    if (isExtern == false) {
        // `sink` moves in, `inout` is a mutable borrow. The default is a shared
        // read-only borrow.
        if (p.matchVal(TokenType.KEYWORD, "sink")) {
            param.s2 = "sink"
        } else if (p.matchVal(TokenType.KEYWORD, "inout")) {
            param.s2 = "inout"
        }

        // SPEC 5.1. `s2` is taken by the convention, so the flag goes in `i2`.
        // `pin` is deliberately not accepted here: a pin constrains an allocation
        // site's tier, and a parameter is a binding, not an allocation.
        if (p.atAnnotation("unique")) {
            p.expectToken(TokenType.IDENTIFIER, "unique annotation")
            param.i2 = 1
        }
    }

    let name = p.current()
    param.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "parameter name")

    // `self` inside an `impl` block, written without a type. Repeating the
    // receiver's type on every method is exactly what the block exists to avoid,
    // so the annotation is synthesised from the block's own type -- and `self`
    // written *with* a type is an ordinary parameter that falls through below.
    //
    // Nothing reserves the word: outside an `impl` block `self` is a name like
    // any other, and inside one a parameter still has to be first-and-untyped to
    // mean the receiver. Which position it is in is sema's business, not the
    // parser's; see semaImplDecl.
    if (nodeExists(p.implType) and strEquals(param.s1, "self")
        and p.checkVal(TokenType.SEPARATOR, ":") == false) {
        let receiver = parserNodeFrom(NodeKind.TYPE_ANNOTATION, name)
        let owner = ptr_to_node(p.implType)
        if (owner.kind == NodeKind.TRAIT_DECL) {
            receiver.s1 = "Self"
        } else {
            copyTypeAnnotationInto(receiver, implTargetAnnotation(p))
        }
        // The span is the block's type name, not this `self`. A misspelt type is
        // reported once per method either way, and pointing at `self` would blame
        // a token that spells nothing wrong.
        nodeSpanFrom(receiver, ptr_to_node(p.implType))
        param.child1 = node_to_ptr(receiver)
        param.i3 = 1
        return param
    }

    p.expectVal(TokenType.SEPARATOR, ":", "parameter type")
    param.child1 = node_to_ptr(parseTypeAnnotation(p))

    if (isExtern) {
        parseFfiContract(p, ptr_to_node(param.child1))
    }

    return param
}

// The shared `( a: A, b: B )` shape. Returns the head of the parameter chain.
private fn parseParameterList(p: Parser, isExtern: Bool) -> Ptr {
    p.expectVal(TokenType.SEPARATOR, "(", "params")

    let params = nodeList()
    if (p.checkVal(TokenType.SEPARATOR, ")") == false) {
        loop {
            nodeListPush(params, parseParameter(p, isExtern))
            if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
        }
    }

    p.expectVal(TokenType.SEPARATOR, ")", "params")
    return params.head
}

private fn parseExternFnDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "extern", "extern fn")
    p.expectVal(TokenType.KEYWORD, "fn", "extern fn")

    let extNode = p.node(NodeKind.EXTERN_FUNCTION)
    let name = p.current()
    extNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "function name")

    extNode.child1 = parseParameterList(p, true)

    if (p.matchVal(TokenType.ARROW, "->")) {
        extNode.child2 = node_to_ptr(parseTypeAnnotation(p))
        parseFfiContract(p, ptr_to_node(extNode.child2))
    }

    return extNode
}

private fn parseFunctionDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "fn", "function")

    let fnNode = p.node(NodeKind.FUNCTION)
    let name = p.current()
    fnNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "function name")

    fnNode.s2 = parseGenericParams(p, fnNode)
    fnNode.child1 = parseParameterList(p, false)

    if (p.matchVal(TokenType.ARROW, "->")) {
        fnNode.child3 = node_to_ptr(parseTypeAnnotation(p))
    }
    parseWhereClause(p, fnNode)
    fnNode.child2 = node_to_ptr(parseBlock(p))

    return fnNode
}

// ---------------------------------------------------------
// v0.1 3.2 -- `impl` blocks
// ---------------------------------------------------------

// `impl Point { fn shifted(self, dx: Int) -> Point { ... } }`
//
// **A naming construct, not a second dispatch mechanism.** `x.f(a)` is already
// rewritten to `f(x, a)` in semaExpr, so a method *is* a free function whose
// first parameter is the receiver. All an `impl` block adds is somewhere to
// write one without repeating the receiver's type -- and that is what makes it
// cheap: parseModule splices the methods straight into the module's declaration
// chain, and overload resolution, ownership, AIF and codegen see exactly what
// they saw before this existed.
//
// The standard library is the reason it is worth having. `std/string.psm` has 46
// `str*`-prefixed functions and 848 call sites in `src/` alone; the prefix is
// there because there is no namespacing. `impl String { fn trim(self) }`
// delegating to `strTrim` is additive and costs none of that churn.
//
// The IMPL_HEADER under child3 is the source of truth for the declaration:
// generic parameter names in s1 and their bounds in genericInfo, the target
// annotation in child1, and (for a trait impl) the TRAIT_REF in child2.
// IMPL_DECL.s1/s2 retain the two base names as lookup accelerators; they
// deliberately do not try to encode either structural side as text.
private fn parseImplDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "impl", "impl block")

    let implNode = p.node(NodeKind.IMPL_DECL)
    let header = createNode(NodeKind.IMPL_HEADER)
    nodeSpanFrom(header, implNode)
    header.s1 = parseGenericParams(p, header)

    let head = parseTypeAnnotation(p)

    // `impl Ord for Int` -- the trait form. The name is read once and then
    // placed, rather than assigned twice: a String field assigned over is a
    // String nothing releases.
    if (p.matchVal(TokenType.KEYWORD, "for")) {
        head.kind = NodeKind.TRAIT_REF
        header.child2 = node_to_ptr(head)
        implNode.s2 = head.s1
        if (head.i1 == 1 or head.i3 == 1) {
            p.fatal("an implemented trait must be a named, non-optional trait reference")
        }

        let target = parseTypeAnnotation(p)
        header.child1 = node_to_ptr(target)
        implNode.s1 = target.s1
    } else {
        header.child1 = node_to_ptr(head)
        implNode.s1 = head.s1
    }
    implNode.child3 = node_to_ptr(header)

    parseImplCheckTarget(p, implNode)
    parseWhereClause(p, header)

    p.expectVal(TokenType.SEPARATOR, "{", "impl body")

    // Set for the body and cleared after it, so a bare `self` is only a receiver
    // where one can be meant. Not saved and restored, because an `impl` block
    // holds `fn` declarations and a `fn` body holds no declarations -- there is
    // no way to nest one.
    p.implType = node_to_ptr(implNode)

    let methods = nodeList()
    let methodRecords = nodeList()
    let constants = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        if (p.check(TokenType.EOF)) {
            p.fatal("this `impl` block is never closed; reached end of file looking for `}`")
        }
        // A method carries a visibility marker exactly as a top-level `fn` does.
        // Without this the two features did not compose: `impl` was the natural
        // home for the helpers most worth marking `private`, and marking them
        // meant giving up the `impl` block. The marker means the same thing here
        // -- the declaring file, or its package -- because a method *is* a free
        // function whose first parameter is the receiver, and it carries the same
        // `file` id either way.
        if (p.checkVal(TokenType.KEYWORD, "let")) {
            nodeListPush(constants, parseAssocConst(p, true))
        } else if (parseAtAssocType(p)) {
            nodeListPush(constants, parseAssocType(p, true))
        } else {
        let methodVisibility = p.visibilityLevel()
        if (methodVisibility >= 0) { p.advance() }

        if (p.checkVal(TokenType.KEYWORD, "fn") == false) {
            p.fatal(strConcat("an `impl` block holds `fn` and `let` declarations, found ",
                                       parserDescribe(p.current())))
        }
        let method = parseFunctionDecl(p)
        method.s2 = parseImplMethodParams(p, header.s1, method.s2)
        parseImplMethodGenericInfo(header, method)
        if (methodVisibility >= 0) { method.i2 = methodVisibility }
        parseImplCheckReceiver(p, method)

        // The method itself is moved into the module's declaration chain after
        // this block returns. Keep its name and unique source span in a separate
        // record with its own sibling link, so conformance can recover the exact
        // function without retaining an AST back-edge.
        let record = createNode(NodeKind.IMPL_METHOD)
        nodeSpanFrom(record, method)
        record.s1 = method.s1
        nodeListPush(methodRecords, record)
        nodeListPush(methods, method)
        }
    }
    p.expectVal(TokenType.SEPARATOR, "}", "impl body")

    p.implType = ptr_null()
    implNode.child1 = methods.head
    implNode.child2 = methodRecords.head
    header.child3 = constants.head
    return implNode
}

private fn parseImplMethodGenericInfo(header: ASTNode, method: ASTNode) {
    if (nodeIsNull(header.genericInfo)) { return }
    let implParams = copyGenericParamChain(header.genericInfo)
    let mut tail = implParams
    while (nodeExists(ptr_to_node(tail).next)) { tail = ptr_to_node(tail).next }
    ptr_to_node(tail).next = method.genericInfo
    method.genericInfo = implParams
}

// The flat name environment is shared with generic functions and types. Bounds
// travel separately through parseImplMethodGenericInfo, so this reader never
// has to parse semantic information back out of text.
private fn implParamNameAt(params: String, index: Int) -> String {
    let mut start = 0
    let mut seen = 0
    let mut i = 0
    let n = __builtin_string_len(params)
    while (i <= n) {
        if (i == n or strCharAt(params, i) == ',') {
            if (seen == index) {
                return strSubstring(params, start, i - start)
            }
            seen = seen + 1
            start = i + 1
        }
        i = i + 1
    }
    return ""
}

private fn implParamCount(params: String) -> Int {
    if (strEquals(params, "")) { return 0 }
    let mut count = 1
    let mut i = 0
    while (i < __builtin_string_len(params)) {
        if (strCharAt(params, i) == ',') { count = count + 1 }
        i = i + 1
    }
    return count
}

private fn implParamsContain(params: String, name: String) -> Bool {
    let mut i = 0
    while (i < implParamCount(params)) {
        if (strEquals(implParamNameAt(params, i), name)) { return true }
        i = i + 1
    }
    return false
}

private fn implTargetContainsParam(annotationPtr: Ptr, name: String) -> Bool {
    let mut p = annotationPtr
    while (nodeExists(p)) {
        let annotation = ptr_to_node(p)
        if (annotation.i1 == 0 and annotation.i2 == 0
            and strEquals(annotation.s1, name)) { return true }
        if (implTargetContainsParam(annotation.child1, name)) { return true }
        p = annotation.next
    }
    return false
}

private fn parseImplCheckTarget(p: Parser, implNode: ASTNode) {
    let header = ptr_to_node(implNode.child3)
    let target = ptr_to_node(header.child1)
    if (target.i1 == 1 or target.i3 == 1) {
        p.fatal("an `impl` target must be a named, non-optional type")
    }
    // An inherent `impl T` has no trait to give the methods a home and would put
    // a method on every type at once. A *trait* impl over a bare parameter is a
    // blanket implementation, which is allowed: the trait names it, and coherence
    // decides whether it may coexist with any other implementation.
    if (target.i2 == 0 and implParamsContain(header.s1, target.s1)
        and strEquals(implNode.s2, "")) {
        p.fatal("an inherent `impl` target must have a nominal type constructor, not a type parameter")
    }

    let count = implParamCount(header.s1)
    let mut i = 0
    while (i < count) {
        if (implTargetContainsParam(header.child1, implParamNameAt(header.s1, i)) == false
            and (nodeIsNull(header.child2)
                 or implTargetContainsParam(ptr_to_node(header.child2).child1,
                                            implParamNameAt(header.s1, i)) == false)) {
            p.fatal(strConcat(strConcat("unconstrained type parameter `",
                                        implParamNameAt(header.s1, i)),
                              "` in `impl`; every impl parameter must occur in its target or trait arguments"))
        }
        i = i + 1
    }
}

private fn parseImplMethodParams(p: Parser, implParams: String, methodParams: String) -> String {
    if (strEquals(implParams, "")) { return methodParams }

    let mut i = 0
    while (i < implParamCount(methodParams)) {
        let name = implParamNameAt(methodParams, i)
        if (implParamsContain(implParams, name)) {
            p.fatal(strConcat(strConcat("method type parameter `", name),
                              "` duplicates an `impl` type parameter"))
        }
        i = i + 1
    }

    if (strEquals(methodParams, "")) { return strClone(implParams) }
    return strConcat(strConcat(implParams, ","), methodParams)
}

// A bare `self` has to be the *first* parameter, and that is a shape error in the
// declaration rather than a fact about the program -- so it is diagnosed here,
// where the parameter list is still a list, and not in sema, where the method is
// already an ordinary function and `self` an ordinary name.
//
// The parser accepts one anywhere because position is not a parse question. It
// matters because `x.f(a)` is `f(x, a)`: a receiver written second is a method
// no method call can ever reach.
private fn parseImplCheckReceiver(p: Parser, method: ASTNode) {
    let mut paramPtr = method.child1
    let mut index = 0
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        if (param.i3 == 1 and index > 0) {
            diag_error_at_code("P3003", param.file, param.line, param.col, param.len,
                          "`self` has to be the first parameter of a method")
            diag_note("`x.f(a)` is `f(x, a)`, so the receiver is argument zero")
        }
        index = index + 1
        paramPtr = param.next
    }
}

// ---------------------------------------------------------
// v0.1 3.3 -- `trait`
// ---------------------------------------------------------

// `trait Ord { fn compare(self, other: Self) -> Int }`
//
// **A trait is a check, not a dispatch mechanism.** Prismio monomorphises before
// type checking reaches a body, so at the point a bound matters the concrete type
// is already known: `fn sort<T: Ord>(...)` instantiated at `Int` is a function
// whose body calls `compare(Int, Int)`, and *ordinary overload resolution* finds
// the method `impl Ord for Int` wrote. Nothing has to be looked up at run time,
// and nothing here emits code.
//
// What the trait declaration is for, then, is exactly two questions: does this
// type implement that trait (the bound, checked at instantiation in
// sema/generics.psm), and does this `impl` provide what the trait asked for (the
// conformance check, in sema/checker.psm). The signatures below are the second
// question's input and are never compiled.
//
// So a TRAIT_DECL stays out of every walk downstream by being a kind none of them
// name -- the same way a WORKLOAD_DECL does -- and its signatures hang off
// `child1` rather than being spliced the way an `impl` block's methods are. A
// method with no body spliced into the module chain is a `define` with no blocks.
private fn parseTraitDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "trait", "trait declaration")

    let traitNode = p.node(NodeKind.TRAIT_DECL)
    let name = p.current()
    traitNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "trait name")

    traitNode.s2 = parseGenericParams(p, traitNode)

    // Supertraits. `child2` rather than a name list, because a supertrait may be
    // an application -- `trait Sorted: Ord<Self>` -- and comparing those is the
    // same structural question a bound asks.
    if (p.matchVal(TokenType.SEPARATOR, ":")) {
        let supertraits = nodeList()
        loop {
            nodeListPush(supertraits, parseTraitRef(p))
            if (p.matchVal(TokenType.ARITHMETIC_OPERATOR, "+") == false) { break }
        }
        traitNode.child2 = supertraits.head
    }

    parseWhereClause(p, traitNode)

    p.expectVal(TokenType.SEPARATOR, "{", "trait body")

    // Set for the same reason an `impl` block sets it, and read differently: a
    // bare `self` in a trait signature has no type to take, so parseParameter
    // gives it `Self` and the conformance check substitutes.
    p.implType = node_to_ptr(traitNode)

    let signatures = nodeList()
    let constants = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        if (p.check(TokenType.EOF)) {
            p.fatal("this `trait` is never closed; reached end of file looking for `}`")
        }
        if (p.checkVal(TokenType.KEYWORD, "let")) {
            nodeListPush(constants, parseAssocConst(p, false))
        } else if (parseAtAssocType(p)) {
            nodeListPush(constants, parseAssocType(p, false))
        } else {
            if (p.checkVal(TokenType.KEYWORD, "fn") == false) {
                p.fatal(strConcat("a `trait` holds `fn` signatures, `let` constants and `type` members, found ",
                                           parserDescribe(p.current())))
            }
            let signature = parseTraitSignature(p)
            parseImplCheckReceiver(p, signature)
            nodeListPush(signatures, signature)
        }
    }
    p.expectVal(TokenType.SEPARATOR, "}", "trait body")

    p.implType = ptr_null()
    traitNode.child1 = signatures.head
    traitNode.child3 = constants.head
    return traitNode
}

// `let NAME: Type` in a trait states the obligation; `let NAME: Type = value` in
// an `impl` discharges it. Requiring the value on exactly one side is what makes
// the declaration say which half of the contract it is, rather than leaving a
// trait constant that silently defaults.
//
// `let` rather than a new keyword: it is already how the language names an
// immutable value, including at module level, and a reserved word bought nothing
// that the existing one did not already say.
private fn parseAssocConst(p: Parser, requireValue: Bool) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "let", "associated constant")

    let constNode = p.node(NodeKind.ASSOC_CONST)
    let name = p.current()
    constNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "constant name")

    p.expectVal(TokenType.SEPARATOR, ":", "associated constant type")
    constNode.child1 = node_to_ptr(parseTypeAnnotation(p))

    if (requireValue) {
        p.expectVal(TokenType.ASSIGNMENT_OPERATOR, "=", "associated constant value")
        constNode.child2 = node_to_ptr(parseExpression(p, 0))
    } else {
        if (p.checkVal(TokenType.ASSIGNMENT_OPERATOR, "=")) {
            p.fatal("a `trait` declares a constant's type; the value belongs in each `impl`")
        }
    }

    return constNode
}

// A method signature: a FUNCTION with no `child2`. That absence is the whole
// difference from a definition, and it is what the conformance check reads.
private fn parseTraitSignature(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "fn", "trait method signature")

    let signature = p.node(NodeKind.FUNCTION)
    let name = p.current()
    signature.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "method name")

    if (p.checkVal(TokenType.RELATIONAL_OPERATOR, "<")) {
        p.fatal("a generic method in a `trait` is not supported yet")
    }

    signature.child1 = parseParameterList(p, false)
    if (p.matchVal(TokenType.ARROW, "->")) {
        signature.child3 = node_to_ptr(parseTypeAnnotation(p))
    }

    // A body makes this signature a default. The presence of `child2` is the only
    // difference between a method an `impl` must supply and one it may inherit,
    // and it is what both conformance and the expansion in generics.psm read.
    if (p.checkVal(TokenType.SEPARATOR, "{")) {
        signature.child2 = node_to_ptr(parseBlock(p))
    }

    return signature
}

// ---------------------------------------------------------
// LAYOUT 3 -- `workload`
// ---------------------------------------------------------

// Contextual, not a reserved word, and the choice is forced rather than stylistic.
//
// `region` had to be a real keyword because it opens a *statement*, where an
// identifier followed by a block is otherwise an expression statement. At top
// level there is no such ambiguity: an identifier cannot start a declaration at
// all, so `workload NAME {` is unambiguous and nothing else can spell it.
//
// The governance rule decides the rest. SPEC 5 requires that deleting an
// annotation leave a working program, and LAYOUT 3.2's W1 says a workload is
// build-time only -- so deleting one has to leave the program not merely working
// but *identical*. Reserving the word would break `let workload = 5`, which is a
// program this language accepts today: a strictly larger change than the feature
// needs. `unique` and `pin` are contextual for the same reason.
private fn atWorkload(p: Parser) -> Bool {
    if (p.check(TokenType.IDENTIFIER) == false) { return false }
    let current = p.current()
    if (strEquals(current.value, "workload") == false) { return false }
    return p.peek().type == TokenType.IDENTIFIER
}

// workload NAME {
//     setup   { ... }        // optional; excluded from the profile
//     measure { ... }        // the profiled region
//     repeat  200            // optional; defaults to 1
// }
//
// **`weight` is deliberately not accepted.** LAYOUT 3.1 gives it as the merge
// weight when a program declares several workloads, and this runner measures one
// and warns about the rest -- so accepting the clause would be accepting an
// annotation that provably does nothing. Add it with the merge, not before.
//
// The clauses are order-independent and each may appear once. LAYOUT 3.1 writes
// them in a fixed order and says nothing about repetition; accepting any order
// costs one loop and rejecting a duplicate is what stops `repeat 1 repeat 200`
// from silently meaning one of the two.
private fn parseWorkloadDecl(p: Parser) -> ASTNode {
    p.advance()                                  // `workload`
    let node = p.node(NodeKind.WORKLOAD_DECL)
    let name = p.current()
    node.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "workload name")

    // `repeat` bounds build-time cost and is a hint (LAYOUT 3.1), so a default of
    // 1 is the honest one: it runs `measure` exactly once and measures something
    // rather than nothing.
    node.i1 = 1
    let mut sawMeasure = false

    p.expectVal(TokenType.SEPARATOR, "{", "workload body")
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        if (p.check(TokenType.EOF)) {
            p.fatal("this workload is never closed; reached end of file looking for `}`")
        }

        let clause = p.current()
        if (strEquals(clause.value, "setup")) {
            p.advance()
            if (nodeExists(node.child1)) {
                p.error("duplicate `setup` in this workload")
            }
            node.child1 = node_to_ptr(parseBlock(p))
        } else if (strEquals(clause.value, "measure")) {
            p.advance()
            if (sawMeasure) {
                p.error("duplicate `measure` in this workload")
            }
            sawMeasure = true
            node.child2 = node_to_ptr(parseBlock(p))
        } else if (strEquals(clause.value, "repeat")) {
            p.advance()
            node.i1 = parseWorkloadCount(p, "repeat")
        } else {
            p.error(strConcat(strConcat("expected `setup`, `measure` or `repeat`, found ",
                                                  parserDescribe(clause)),
                                       " in this workload"))
            p.synchronize()
            return node
        }
    }
    p.expectVal(TokenType.SEPARATOR, "}", "workload body")

    // `measure` is the profiled region, so a workload without one names nothing to
    // profile. Diagnosed here rather than in sema because it is a shape error in
    // the declaration, not a fact about the program it profiles.
    if (sawMeasure == false) {
        p.error("this workload has no `measure` block; there is nothing to profile")
    }

    return node
}

private fn parseWorkloadCount(p: Parser, clause: String) -> Int {
    let tok = p.current()
    if (tok.type != TokenType.NUMBER_LITERAL) {
        p.fatal(strConcat(strConcat("expected a count after `", clause), "`"))
    }
    let n = optionOr(strParseInt(tok.value), 0)
    p.advance()
    // Zero repeats profiles nothing and a negative one is meaningless; both would
    // reach the runner and produce an empty profile that reads as a failed run.
    // Rejecting here keeps W2's fallback meaning "the workload failed", not "the
    // workload was written to do nothing".
    if (n < 1) {
        p.error(strConcat(strConcat("`", clause), "` must be at least 1"))
        return 1
    }
    return n
}

private fn parseStructDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "struct", "struct")

    let structNode = p.node(NodeKind.STRUCT_DECL)
    let name = p.current()
    structNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "struct name")

    structNode.s2 = parseGenericParams(p, structNode)
    parseWhereClause(p, structNode)
    p.expectVal(TokenType.SEPARATOR, "{", "struct body")

    let fields = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        let field = p.node(NodeKind.STRUCT_FIELD)
        let fieldName = p.current()
        field.s1 = fieldName.value
        p.expectToken(TokenType.IDENTIFIER, "field name")
        p.expectVal(TokenType.SEPARATOR, ":", "field type")
        field.child1 = node_to_ptr(parseTypeAnnotation(p))
        nodeListPush(fields, field)

        p.matchVal(TokenType.SEPARATOR, ",")
    }

    p.expectVal(TokenType.SEPARATOR, "}", "struct body")
    structNode.child1 = fields.head
    return structNode
}

private fn parseEnumDecl(p: Parser) -> ASTNode {
    p.expectVal(TokenType.KEYWORD, "enum", "enum")

    let enumNode = p.node(NodeKind.ENUM_DECL)
    let name = p.current()
    enumNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "enum name")

    enumNode.s2 = parseGenericParams(p, enumNode)
    p.expectVal(TokenType.SEPARATOR, "{", "enum body")

    let variants = nodeList()
    while (p.checkVal(TokenType.SEPARATOR, "}") == false) {
        let variant = p.node(NodeKind.ENUM_VARIANT)
        let variantName = p.current()
        variant.s1 = variantName.value
        p.expectToken(TokenType.IDENTIFIER, "variant name")

        // `Some(T)` -- a variant that carries values. The payload types hang off
        // child1 as a `next`-chain, the same shape a parameter list has, because
        // that is what a variant constructor is.
        if (p.matchVal(TokenType.SEPARATOR, "(")) {
            let payload = nodeList()
            loop {
                nodeListPush(payload, parseTypeAnnotation(p))
                if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
            }
            variant.child1 = payload.head
            p.expectVal(TokenType.SEPARATOR, ")", "variant payload")
        }

        nodeListPush(variants, variant)

        p.matchVal(TokenType.SEPARATOR, ",")
    }

    p.expectVal(TokenType.SEPARATOR, "}", "enum body")
    enumNode.child1 = variants.head
    return enumNode
}

// ---------------------------------------------------------
// `where` clauses
// ---------------------------------------------------------

// `where T: Ord` states the same constraint as `<T: Ord>`. It appends to the
// parameter's bound chain rather than replacing it, so a declaration may use
// both spellings on one parameter and get the union -- which is what makes this
// a notation and not a second constraint mechanism for bound checking to learn.
//
// Naming a parameter the declaration does not have is refused here. Sema reads
// bounds through `genericInfo`, so an unmatched clause would otherwise be
// silently dropped and the constraint the author wrote would never be checked.
private fn parseWhereClause(p: Parser, owner: ASTNode) {
    if (p.matchVal(TokenType.KEYWORD, "where") == false) { return }

    loop {
        let name = p.current()
        p.expectToken(TokenType.IDENTIFIER, "type parameter name in `where`")

        let param = findGenericParamNamed(owner.genericInfo, name.value)
        if (nodeIsNull(node_to_ptr(param))) {
            p.fatal(strConcat(strConcat("`where` names `", name.value),
                              "`, which is not a type parameter of this declaration"))
        }

        p.expectVal(TokenType.SEPARATOR, ":", "`where` bound")
        loop {
            appendTraitRefTo(param, parseTraitRef(p))
            if (p.matchVal(TokenType.ARITHMETIC_OPERATOR, "+") == false) { break }
        }

        if (p.matchVal(TokenType.SEPARATOR, ",") == false) { break }
    }
}

private fn findGenericParamNamed(infoPtr: Ptr, name: String) -> ASTNode {
    let mut p = infoPtr
    while (nodeExists(p)) {
        let param = ptr_to_node(p)
        if (param.kind == NodeKind.GENERIC_PARAM and strEquals(param.s1, name)) { return param }
        p = param.next
    }
    return ptr_to_node(ptr_null())
}

private fn appendTraitRefTo(param: ASTNode, bound: ASTNode) {
    if (nodeIsNull(param.child1)) {
        param.child1 = node_to_ptr(bound)
        return
    }
    let mut p = param.child1
    loop {
        let existing = ptr_to_node(p)
        if (nodeIsNull(existing.next)) {
            existing.next = node_to_ptr(bound)
            return
        }
        p = existing.next
    }
}

// `type` is **contextual, not reserved**. It is an ordinary identifier almost
// everywhere -- `extern fn ir_alloca(type: String, ...)` and 178 others spell it
// that way -- and reserving it to gain an associated type would have been a
// rename across the compiler for a word that is only special in two places.
//
// A trait or `impl` body holds `fn`, `let` and `type` members, so `type`
// followed by a name is unambiguous exactly here and nowhere else.
private fn parseAtAssocType(p: Parser) -> Bool {
    if (p.checkVal(TokenType.IDENTIFIER, "type") == false) { return false }
    return p.peek().type == TokenType.IDENTIFIER
}

// `type Item` in a trait states the obligation; `type Item = Int` in an `impl`
// discharges it. The value is required on exactly one side, for the reason
// parseAssocConst gives.
private fn parseAssocType(p: Parser, requireValue: Bool) -> ASTNode {
    let typeNode = p.node(NodeKind.ASSOC_TYPE)
    p.advance()

    let name = p.current()
    typeNode.s1 = name.value
    p.expectToken(TokenType.IDENTIFIER, "associated type name")

    if (requireValue) {
        p.expectVal(TokenType.ASSIGNMENT_OPERATOR, "=", "associated type value")
        typeNode.child1 = node_to_ptr(parseTypeAnnotation(p))
    } else {
        if (p.checkVal(TokenType.ASSIGNMENT_OPERATOR, "=")) {
            p.fatal("a `trait` names an associated type; the choice belongs in each `impl`")
        }
    }

    return typeNode
}
