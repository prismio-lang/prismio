// Parser state, token access, error recovery, and the module entry point.
//
// The grammar itself lives beside this file: declarations in decl.psm,
// statements in stmt.psm, expressions in expr.psm. They call each other freely
// and need no forward declarations -- sema registers every function in the merged
// module before it checks any of them.
//
// Two prefixes, kept apart on purpose. `parserX` is the parser's own machinery:
// look at a token, consume one, complain about one. `parseX` is a grammar
// production and is named after the thing it parses.

import lexer.scanner
import lexer.token
import common.text
import ast.nodes
import common.diagnostics
import std.string

public extern fn exit(code: Int)

// `allowStructLit` is off while reading the bounds of a `for`, so that
// `for i in 0..n { ... }` reads the body as a block rather than `n { ... }` as a
// struct literal. It was a module-level global until it became clear it is
// simply parser state, and parser state belongs on the parser.
//
// `implType` is the IMPL_DECL whose body is being read, or null outside one. Its
// IMPL_HEADER child supplies the structural target annotation copied onto a bare
// `self` parameter and every `Self` annotation in the body.
// A `Ptr` rather than the type's name because `Ptr` is copyable -- a `String`
// field would be moved out of the parser by the first method that read it.
struct Parser {
    current: Ptr, // Token pointer
    allowStructLit: Int,
    implType: Ptr, // ASTNode (IMPL_DECL with child3 IMPL_HEADER), or null
    // T16 argument position. `fn f(v: impl Show)` *is* `fn f<T: Show>(v: T)`, but
    // the generic parameter list is parsed before the parameter list that reveals
    // it, so the synthesised GENERIC_PARAM cannot be attached where it is created.
    // It waits here until the declaration that owns it drains this chain --
    // parseImplTraitParams -- immediately after its parameters are parsed.
    //
    // A chain rather than one slot because `fn f(a: impl Show, b: impl Ord)`
    // synthesises two, and the sequence numbers them so they cannot collide.
    implParams: Ptr, // ASTNode (GENERIC_PARAM chain), or null
    implParamSeq: Int,
    // Where an `impl Trait` currently being parsed is allowed to mean something.
    // 0 nowhere, 1 argument position, 2 return position. The two positions are
    // different constructs -- argument is a generic parameter the caller picks,
    // return is one concrete type the body picks -- so the type parser cannot
    // decide between them from the token alone, and anywhere else is an error
    // rather than a third meaning.
    implPosition: Int
}

public fn parserCreate(tokens: Token) -> Parser {
    return Parser { current: token_to_ptr(tokens), allowStructLit: 1, implType: ptr_null(),
                    implParams: ptr_null(), implParamSeq: 0, implPosition: 0 }
}
impl Parser {

    internal fn current(self) -> Token {
        return ptr_to_token(self.current)
    }

    internal fn peek(self) -> Token {
        let current = ptr_to_token(self.current)
        return ptr_to_token(current.tokNext)
    }

    internal fn advance(self) {
        let current = ptr_to_token(self.current)
        if (current.type != TokenType.EOF) {
            self.current = current.tokNext
        }
    }

    internal fn check(self, t: TokenType) -> Bool {
        let current = self.current()
        return current.type == t
    }

    internal fn checkVal(self, t: TokenType, val: String) -> Bool {
        let current = self.current()
        return current.type == t and current.value.equals(val)
    }

    internal fn matchToken(self, t: TokenType) -> Bool {
        if (self.check(t)) {
            self.advance()
            return true
        }
        return false
    }

    internal fn matchVal(self, t: TokenType, val: String) -> Bool {
        if (self.checkVal(t, val)) {
            self.advance()
            return true
        }
        return false
    }

    // Creates a node already stamped with the position of the token the parser is
    // sitting on. Every node the parser builds comes from here rather than from
    // createNode(), so a node without a span means "synthesised", not "forgotten".
    internal fn node(self, kind: NodeKind) -> ASTNode {
        let node = createNode(kind)
        let tok = self.current()
        node.line = tok.line
        node.col = tok.col
        node.len = tok.len
        node.file = tok.file
        return node
    }

    // Reports against the token the parser is looking at -- which is the token that
    // was *unexpected*, and so the one worth underlining.
    internal fn error(self, message: String) {
        let tok = self.current()
        diag_error_at_code("P3201", tok.file, tok.line, tok.col, tok.len, message)
    }

    // A parse error the parser cannot recover from locally. Reports, then stops:
    // continuing past a malformed type or parameter list means handing sema an AST
    // whose shape does not match what its callers assume, and a crash there is a
    // worse experience than one honest error.
    internal fn fatal(self, message: String) {
        self.error(message)
        diag_finish()
        exit(1)
    }

    internal fn expectToken(self, t: TokenType, context: String) {
        if (self.check(t) == false) {
            let tok = self.current()
            self.fatal("expected ".concat(typeToString(t),
                                          " in ",
                                          context,
                                          ", found ",
                                          parserDescribe(tok)))
        }
        self.advance()
    }

    internal fn expectVal(self, t: TokenType, val: String, context: String) {
        if (self.checkVal(t, val) == false) {
            let tok = self.current()
            self.fatal("expected ".concat(diagQuote(val),
                                          " in ",
                                          context,
                                          ", found ",
                                          parserDescribe(tok)))
        }
        self.advance()
    }

    // Drops tokens until something that plausibly begins a new declaration or
    // statement, so one syntax error does not turn the rest of the file into noise.
    //
    // Prismio has no statement terminator, so the anchors are the keywords above plus
    // '}', which can only end a construct. Two properties matter: it always consumes
    // at least one token (otherwise the parser loops forever on the token it could
    // not handle), and it stops *before* the anchor so the caller resumes by parsing
    // it normally.
    internal fn synchronize(self) {
        self.advance()

        loop {
            let tok = self.current()
            if (tok.type == TokenType.EOF) { break }
            if (tok.type == TokenType.SEPARATOR and tok.value.equals("}")) { break }
            if (tok.type == TokenType.KEYWORD and startsConstruct(tok.value)) { break }
            self.advance()
        }
    }

    // One segment of a dotted module path. A keyword is accepted as well as an
    // identifier: `import ir.match` is a reasonable module name, and in this position
    // there is nothing for a keyword to be ambiguous with.
    private fn parseModuleSegment(self) -> String {
        let segment = self.current()
        if (segment.type != TokenType.IDENTIFIER and segment.type != TokenType.KEYWORD) {
            self.fatal("expected a module name after `import`, found ".concat(parserDescribe(segment)))
        }
        self.advance()
        return segment.value
    }

    // `import ir.expr` names the module in src/ir/expr.psm; `import ir.*` names every
    // module directly inside src/ir/, and sets `i1`.
    //
    // Dotted rather than slashed because a module name is an identifier path, not a
    // file path: mapping it onto a directory is joinImportPath's business, and
    // keeping the separator out of the token stream means no operator has to change
    // meaning inside an import. The name is stored as written, dots and all, so a
    // diagnostic quotes what the programmer typed rather than a resolved path.
    //
    // The wildcard is only ever a whole final segment, so `import ir.ex*` is a syntax
    // error rather than a prefix match. Matching on partial names would make the set
    // of modules a program depends on a function of what the directory happens to
    // contain, which is exactly what a reader cannot see from the import.
    //
    // The three shapes read as one progression: a path names one file
    // (`import std.io`), a directory's children by name (`import {io, vec} from
    // std`) or all of them (`import std.*`, or `import * from std`), and a path
    // one step past a file names a declaration inside it (`import std.string.trim`).
    internal fn parseImportStatement(self) -> ASTNode {
        self.expectVal(TokenType.KEYWORD, "import", "import statement")

        if (self.checkVal(TokenType.SEPARATOR, "{")) {
            return parseImportGroup(self)
        }
        if (self.checkVal(TokenType.ARITHMETIC_OPERATOR, "*")) {
            return parseImportAllFrom(self)
        }

        let importNode = self.node(NodeKind.IMPORT_STATEMENT)
        let first = self.current()
        importNode.s1 = parseModuleSegment(self)

        // The node's span starts at the first segment and has to be stretched over
        // the rest, or a diagnostic about `import lexer.token` underlines `lexer`.
        let mut endCol = first.col + first.len

        while (self.matchVal(TokenType.SEPARATOR, ".")) {
            let segment = self.current()
            endCol = segment.col + segment.len
            if (self.matchVal(TokenType.ARITHMETIC_OPERATOR, "*")) {
                importNode.i1 = 1
                break
            }
            // The path-first group other languages spell. Refused by name, so the
            // one reader who types it learns the order rather than reading
            // "expected a module name, found `{`".
            if (self.checkVal(TokenType.SEPARATOR, "{")) {
                self.fatal("an import group names the modules first and the directory after: `import {io, string} from ".concat(importNode.s1, "`"))
            }
            importNode.s1 = importNode.s1.concat(".", parseModuleSegment(self))
        }

        // `import std.io as io` -- a second name for the module, usable wherever
        // its import path is: `io.println(x)` rather than `std.io.println(x)`.
        //
        // A **second** name, not a replacement. `import std.io` already brings
        // this module's names in unqualified, and an alias that switched that off
        // would make `as` two features wearing one spelling. What it adds is a
        // short qualifier, which is the thing you reach for exactly when the
        // unqualified name is taken -- by a local `print`, or by another import.
        //
        // The alias lands in `s2`; `s1` stays the real import path, so the merge,
        // the import gate and every diagnostic keep naming the module the reader
        // would find on disk.
        if (self.checkVal(TokenType.KEYWORD, "as") and importNode.i1 == 1) {
            self.fatal("`import <package>.* as <name>` has no meaning: the wildcard brings in every module in the package, and an alias can only name one")
        }
        endCol = parseImportAlias(self, importNode, endCol)

        importNode.len = endCol - importNode.col
        return importNode
    }

    // `as <name>` after an import path, into `s2`. Answers where the statement now
    // ends, which is the alias when there is one.
    private fn parseImportAlias(self, importNode: ASTNode, endCol: Int) -> Int {
        if (self.matchVal(TokenType.KEYWORD, "as") == false) { return endCol }
        let aliasToken = self.current()
        if (aliasToken.type != TokenType.IDENTIFIER) {
            self.fatal("expected a name after `as`, found ".concat(parserDescribe(aliasToken)))
        }
        importNode.s2 = aliasToken.value
        self.advance()
        // An alias is one name, not a path. `import std.io as std.io` would
        // otherwise stop at `std` and report the `.` as a stray declaration,
        // which points at the line after the mistake.
        if (self.checkVal(TokenType.SEPARATOR, ".")) {
            self.fatal("an `as` name is a single identifier, not a dotted path")
        }
        return aliasToken.col + aliasToken.len
    }

    // `from <directory>` after a group or a `*`: the dotted path the entries sit in.
    //
    // `from` is contextual, an identifier with that spelling in this one position,
    // so no program that already names something `from` changes meaning.
    private fn parseImportFrom(self, shape: String) -> String {
        let word = self.current()
        if (word.type != TokenType.IDENTIFIER or word.value.equals("from") == false) {
            self.fatal("expected `from` and a directory after ".concat(shape, ", found ",
                parserDescribe(word), ": `import {io, string} from std`"))
        }
        self.advance()
        let mut path = parseModuleSegment(self)
        while (self.matchVal(TokenType.SEPARATOR, ".")) {
            if (self.checkVal(TokenType.ARITHMETIC_OPERATOR, "*") or self.checkVal(TokenType.SEPARATOR, "{")) {
                self.fatal("the path after `from` names one directory")
            }
            path = path.concat(".", parseModuleSegment(self))
        }
        if (self.checkVal(TokenType.KEYWORD, "as")) {
            self.fatal("`as` names one module, so it goes on an entry inside the group: `import {io as out} from std`")
        }
        return path
    }

    // `import * from std` -- `import std.*` with the directory last, so every
    // shape that reaches into a directory can be written in one order.
    private fn parseImportAllFrom(self) -> ASTNode {
        let importNode = self.node(NodeKind.IMPORT_STATEMENT)
        self.advance()
        importNode.i1 = 1
        importNode.s1 = parseImportFrom(self, "`import *`")
        return importNode
    }

    // `import {io, string, vec} from std` -- several modules that sit in one
    // directory.
    //
    // Each entry becomes exactly the statement its own line would have been:
    // `import {io, string as s} from std` is `import std.io` and `import
    // std.string as s`, chained on `next` for parseModule to splice in order,
    // and nothing after the parser learns that groups exist.
    //
    // An entry is one file, never a declaration. `import std.string.trim` already
    // selects a name, and braces that selected modules in one place and
    // declarations in another would be one spelling for two jobs. The parser
    // cannot tell a module from a declaration, so it marks each entry (`i2`) and
    // the merge refuses one that does not name a file. A dotted entry is refused
    // here: the entries are siblings, and a nested directory is its own group.
    private fn parseImportGroup(self) -> ASTNode {
        self.expectVal(TokenType.SEPARATOR, "{", "import group")
        let entries = nodeList()
        while (self.checkVal(TokenType.SEPARATOR, "}") == false) {
            nodeListPush(entries, parseImportGroupEntry(self))
            if (self.matchVal(TokenType.SEPARATOR, ",") == false) { break }
        }
        self.expectVal(TokenType.SEPARATOR, "}", "import group")
        if (nodeIsNull(entries.head)) {
            self.fatal("an import group names at least one module: `import {io, vec} from std`")
        }
        let directory = parseImportFrom(self, "an import group")

        let mut entryPtr = entries.head
        while (nodeExists(entryPtr)) {
            let entry = ptr_to_node(entryPtr)
            entry.s1 = directory.concat(".", entry.s1)
            entryPtr = entry.next
        }
        return ptr_to_node(entries.head)
    }

    private fn parseImportGroupEntry(self) -> ASTNode {
        let entry = self.node(NodeKind.IMPORT_STATEMENT)
        let first = self.current()
        entry.s1 = parseModuleSegment(self)
        entry.i2 = 1
        if (self.checkVal(TokenType.SEPARATOR, ".")) {
            self.fatal("an import group names modules directly inside one directory; write a nested one as its own group, and select a declaration with its own import: `import std.string.trim`")
        }
        let endCol = parseImportAlias(self, entry, first.col + first.len)
        entry.len = endCol - entry.col
        return entry
    }

    public fn parseModule(self) -> ASTNode {
        let module = self.node(NodeKind.MODULE)
        let declarations = nodeList()

        loop {
            if (self.check(TokenType.EOF)) { break }

            let stmt = parseDeclaration(self)

            // An `impl` block's methods are spliced into the module's own chain, and
            // that splice is the whole lowering: a method is a free function whose
            // first parameter is the receiver, so every pass downstream keys on
            // `== NodeKind.FUNCTION` and needs to know nothing about `impl`.
            //
            // The IMPL_DECL itself stays. Its method definitions move from child1
            // into the module chain; child2 retains separate IMPL_METHOD records
            // and child3 retains the structural IMPL_HEADER
            // with their names and source spans. A node cannot be in two `next`
            // chains at once, so the records own the impl-local sibling chain while
            // overload resolution continues to see ordinary top-level functions.
            if (stmt.kind == NodeKind.IMPL_DECL) {
                let methods = stmt.child1
                stmt.child1 = ptr_null()
                nodeListPush(declarations, stmt)

                let mut methodPtr = methods
                while (nodeExists(methodPtr)) {
                    let method = ptr_to_node(methodPtr)
                    // Read `next` before pushing, for the reason monoCollectTemplates
                    // gives: nodeListPush rewrites the tail's `next`, so the chain
                    // being walked is the chain being rebuilt.
                    let following = method.next
                    method.next = ptr_null()
                    nodeListPush(declarations, method)
                    methodPtr = following
                }
            } else if (stmt.kind == NodeKind.IMPORT_STATEMENT) {
                // One node, or a group's entries chained on `next`
                // (parseImportGroup). Read before pushing, as for methods above.
                let mut importPtr = node_to_ptr(stmt)
                while (nodeExists(importPtr)) {
                    let entry = ptr_to_node(importPtr)
                    let following = entry.next
                    entry.next = ptr_null()
                    nodeListPush(declarations, entry)
                    importPtr = following
                }
            } else if (stmt.kind != NodeKind.ERROR_NODE) {
                // A placeholder from recovery. Dropping it here is what keeps every
                // later pass free of the question -- nothing downstream has to know
                // that recovery exists.
                nodeListPush(declarations, stmt)
            }
        }

        module.child1 = declarations.head
        return module
    }

}

// Free functions the parser's methods share. Outside `impl Parser` because none
// takes the parser: a function with no `self` inside an `impl` belongs to the
// type and is called `Parser.name(...)`, and these are called bare, from the
// declaration and expression parsers as well as from here.

// A node stamped like Parser.node's, from a token the caller kept rather than the
// one the parser is looking at now. A statement whose node is built *after* its body is parsed --
// an expression statement, `break`, `continue` -- is looking at the token that
// follows it by then, which is the next statement's first token, or the closing
// brace. Stamping that is an off-by-one in the line table and an underline in
// the wrong place in a diagnostic.
internal fn parserNodeFrom(kind: NodeKind, tok: Token) -> ASTNode {
    let node = createNode(kind)
    node.line = tok.line
    node.col = tok.col
    node.len = tok.len
    node.file = tok.file
    return node
}

// How the offending token reads in a message. EOF has no source text, so name it
// rather than quoting the empty string.
internal fn parserDescribe(tok: Token) -> String {
    if (tok.type == TokenType.EOF) {
        return "end of file"
    }
    return diagQuote(tok.value)
}

// Whether this keyword can only begin a construct, and so is a safe place for
// recovery to resume.
private fn startsConstruct(word: String) -> Bool {
    if (word.equals("fn")) { return true }
    if (word.equals("let")) { return true }
    if (word.equals("struct")) { return true }
    if (word.equals("enum")) { return true }
    if (word.equals("extern")) { return true }
    if (word.equals("import")) { return true }
    if (word.equals("impl")) { return true }
    if (word.equals("trait")) { return true }
    if (word.equals("if")) { return true }
    if (word.equals("while")) { return true }
    if (word.equals("for")) { return true }
    if (word.equals("loop")) { return true }
    if (word.equals("match")) { return true }
    if (word.equals("return")) { return true }
    if (word.equals("region")) { return true }
    return false
}
