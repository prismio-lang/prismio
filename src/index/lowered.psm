    if (head.equals("U8")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("U16")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("U32")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("U64")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("Usize")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("Float")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("F32")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("F16")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("BF16")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("F128")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("Bool")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("Char")) {
        if (name.equals("unwrapOr")) { return "The value, or `fallback` when there is none.".clone() }
        if (name.equals("expect")) { return "The value; stops the program when there is none.".clone() }
    }
    if (head.equals("Ptr")) {
        if (name.equals("load")) { return "Reads the value the pointer points at.".clone() }
        if (name.equals("store")) { return "Writes `value` through a `Ptr<mut T>`.".clone() }
        if (name.equals("readVolatile")) { return "A volatile read, for a pointer whose type is not volatile.".clone() }
        if (name.equals("writeVolatile")) { return "A volatile write, for a pointer whose type is not volatile.".clone() }
        if (name.equals("addr")) { return "The address.".clone() }
        if (name.equals("offset")) { return "The pointer `count` elements away, checked.".clone() }
        if (name.equals("byteOffset")) { return "The pointer `count` bytes away, checked.".clone() }
        if (name.equals("wrappingOffset")) { return "The pointer `count` elements away, wrapping on overflow.".clone() }
        if (name.equals("offsetFrom")) { return "The distance from `other`, in elements.".clone() }
        if (name.equals("isAligned")) { return "Whether the address is a multiple of `alignment`.".clone() }
        if (name.equals("sameAs")) { return "Whether both point at the same address.".clone() }
        if (name.equals("advance")) { return "`count` elements on, or none past `limit`.".clone() }
        if (name.equals("at")) { return "The pointer at `address`, or none when it is not valid.".clone() }
        if (name.equals("atUnchecked")) { return "The pointer at `address`, unchecked.".clone() }
        if (name.equals("cast")) { return "The pointer reinterpreted as this type.".clone() }
        if (name.equals("castAligned")) { return "The pointer reinterpreted as this type, or none when it is misaligned.".clone() }
        if (name.equals("atomicLoad")) { return "An atomic read.".clone() }
        if (name.equals("atomicStore")) { return "An atomic write.".clone() }
        if (name.equals("atomicSwap")) { return "An atomic swap; the previous value.".clone() }
        if (name.equals("atomicAdd")) { return "An atomic add; the previous value.".clone() }
        if (name.equals("atomicSub")) { return "An atomic sub; the previous value.".clone() }
        if (name.equals("atomicAnd")) { return "An atomic and; the previous value.".clone() }
        if (name.equals("atomicOr")) { return "An atomic or; the previous value.".clone() }
        if (name.equals("atomicXor")) { return "An atomic xor; the previous value.".clone() }
        if (name.equals("atomicCompareExchange")) { return "Stores `desired` when the value is `expected`; the previous value.".clone() }
    }
    return "".clone()
}

// The names of the lowered members of the type `head`, for completion.
public fn ixLoweredNames(head: String) -> Vec<String> {
    let mut names: Vec<String> = []
    if (head.equals("Vec")) {
        names.push("push".clone())
        names.push("set".clone())
        names.push("replace".clone())
        names.push("swap".clone())
        names.push("insert".clone())
        names.push("reserve".clone())
        names.push("truncate".clone())
        names.push("clear".clone())
        names.push("length".clone())
        names.push("capacity".clone())
        names.push("isEmpty".clone())
        names.push("isNotEmpty".clone())
        names.push("first".clone())
        names.push("last".clone())
    }
    if (head.equals("List")) {
        names.push("push".clone())
        names.push("set".clone())
        names.push("replace".clone())
        names.push("swap".clone())
        names.push("insert".clone())
        names.push("reserve".clone())
        names.push("truncate".clone())
        names.push("clear".clone())
        names.push("length".clone())
        names.push("capacity".clone())
        names.push("isEmpty".clone())
        names.push("isNotEmpty".clone())
        names.push("first".clone())
        names.push("last".clone())
    }
    if (head.equals("Slice")) {
        names.push("length".clone())
    }
    if (head.equals("DataView")) {
        names.push("length".clone())
    }
    if (head.equals("Channel")) {
        names.push("send".clone())
        names.push("receive".clone())
        names.push("share".clone())
        names.push("close".clone())
        names.push("free".clone())
        names.push("length".clone())
    }
    if (head.equals("Chan")) {
        names.push("send".clone())
        names.push("receive".clone())
        names.push("share".clone())
        names.push("close".clone())
        names.push("free".clone())
        names.push("length".clone())
    }
    if (head.equals("Int")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("I8")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("I16")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("I64")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("Isize")) {
        names.push("unwrapOr".clone())
