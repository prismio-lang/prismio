    }
    if (head.equals("U32")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("U64")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("Usize")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("Float")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("F32")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("F16")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("BF16")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("F128")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("Bool")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("Char")) {
        names.push("unwrapOr".clone())
        names.push("expect".clone())
    }
    if (head.equals("Ptr")) {
        names.push("load".clone())
        names.push("store".clone())
        names.push("readVolatile".clone())
        names.push("writeVolatile".clone())
        names.push("addr".clone())
        names.push("offset".clone())
        names.push("byteOffset".clone())
        names.push("wrappingOffset".clone())
        names.push("offsetFrom".clone())
        names.push("isAligned".clone())
        names.push("sameAs".clone())
        names.push("advance".clone())
        names.push("at".clone())
        names.push("atUnchecked".clone())
        names.push("cast".clone())
        names.push("castAligned".clone())
        names.push("atomicLoad".clone())
        names.push("atomicStore".clone())
        names.push("atomicSwap".clone())
        names.push("atomicAdd".clone())
        names.push("atomicSub".clone())
        names.push("atomicAnd".clone())
        names.push("atomicOr".clone())
        names.push("atomicXor".clone())
        names.push("atomicCompareExchange".clone())
    }
    return names
}
