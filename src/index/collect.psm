// Pass one of the semantic index: every declaration of the program, as an entry in the tables.
//
// The merged module holds two chains, and both are read. `child1` is what sema checked: concrete
// declarations, including one copy of a generic for each type it was instantiated with. `child2` is
// the generic templates themselves, which sema never walks and which are the only place a generic
// that nothing instantiates exists at all, and the only place `T` is still written as `T`. The templates
// are read first, so a template and its instances (which share source positions) are one declaration, and
// the first to arrive is the template.
//
// A declaration is only recorded if its name is where its node says it is. A closure's lifted function,
// the struct a payload enum became and a generic instance's mangled name all carry a span but not the
// name written there; they are not something the user can point at, and a declaration the user cannot
// find in the text is worse than none.

import ast.nodes
import ast.types
import ast.fn_attrs
import fmt.scan
import index.source
import index.tables
import std.string
import std.vec

// The name a node was written with: its `s1` up to the `$` that separates an instance's type
// arguments from it.
public fn ixBaseName(name: String) -> String {
    let at = name.indexOf("$")
    if (at < 0) { return name.clone() }
    return name.substring(0, at).clone()
}

// A type as a person writes it: the compiler's `List<Int>` is `Vec<Int>`, an instance `Box$Int` is
// `Box<Int>`, and a closure's invented struct is just a closure.
public fn ixCleanType(display: String) -> String {
    if (display.equals("")) { return "".clone() }
    if (display.startsWith("Closure")) { return "closure".clone() }
    let mut text = display.replaceAll("List<", "Vec<")
    if (text.contains("$")) {
        let parts = text.split("$")
        let mut out = parts[0].clone()
        let mut i = 1
        while (i < parts.length) {
            if (i == 1) { out = out.concat("<", parts[i]) } else { out = out.concat(", ", parts[i]) }
            i = i + 1
        }
        text = out.concat(">")
    }
    return text
}

public fn ixNodeType(node: ASTNode) -> String {
    if (nodeIsNull(node.typeInfo)) { return "".clone() }
    let t = nodeGetType(node)
    if (t.kind == TypeKind.INVALID) { return "".clone() }
    return ixCleanType(typeDisplay(t))
}

// The token of the name a node declares. The node's span is where the parser was when it made the
// node, which is the name for most declarations and a word in front of it for some (`let mut x`
// is at `mut`, a parameter written `inout xs` at `inout`); the name is the first token on that line
// that is the right word. -1 if there is not one, which is how a node the compiler made up (a
// lifted closure, a mangled instance) is told from one the user wrote.
public fn ixNameToken(src: IxSources, slot: Int, node: ASTNode) -> Int {
    if (slot < 0 or node.line < 1) { return 0 - 1 }
    let first = ixTokenAt(src, slot, node.line, node.col)
    if (first < 0) { return 0 - 1 }
    let mut base = ixBaseName(node.s1)
    let dot = base.lastIndexOf(".")
    if (dot >= 0) { base = base.substring(dot + 1, base.length - dot - 1).clone() }
    // A function written inside another is lifted as `outer$inner` (parse/decl.psm): the word in the source is `inner`.
    let mut written = "".clone()
    let dollar = node.s1.lastIndexOf("$")
    if (dollar >= 0) { written = node.s1.substring(dollar + 1, node.s1.length - dollar - 1).clone() }
    let mut at = first
    let limit = first + 4
    while (at < limit and at < ixTokenCount(src, slot)) {
        if (ixTokenLine(src, slot, at) != node.line) { break }
        let text = ixTokenText(src, slot, at)
        if (text.equals(base) or text.equals(node.s1) or (written.equals("") == false and text.equals(written))) { return at }
        // Only a keyword or a marker stands in front of a name.
        let kind = ixKindAt(src, slot, at)
        if (kind != FmtKind.KEYWORD and kind != FmtKind.CONTEXTUAL) { break }
        at = at + 1
    }
    return 0 - 1
}

// Records the declaration `node` names, if its name is where the source says. Answers its id, or -1.
public fn ixDeclareNode(inout ix: Ix, inout src: IxSources, kind: String, node: ASTNode, container: Int,
                        vis: Int, type: String, symbol: String) -> Int {
    let slot = ixView(src, node.file)
    let token = ixNameToken(src, slot, node)
    if (token < 0) { return 0 - 1 }
    return ixAddDecl(ix, kind, ixTokenText(src, slot, token), node.file, ixTokenLine(src, slot, token),
                     ixTokenCol(src, slot, token), ixTokenLen(src, slot, token), container, vis, type, symbol,
                     node_to_ptr(node))
}

// The type written after the name a node declares (`name: Type`), or "" when none is written.
public fn ixWrittenType(inout src: IxSources, node: ASTNode) -> String {
    let slot = ixView(src, node.file)
    let token = ixNameToken(src, slot, node)
    if (token < 0 or ixKindAt(src, slot, token + 1) != FmtKind.COLON) { return "".clone() }
    return ixTypeAfter(src, slot, token + 1)
}

// What the user sees of a binding's type: what was written, else what sema inferred.
public fn ixBindingType(inout src: IxSources, node: ASTNode) -> String {
    let written = ixWrittenType(src, node)
    if (written.equals("") == false) { return written }
    return ixNodeType(node)
}

// The return type written after the `->` that follows a function's parameter list.
fn ixReturnType(inout src: IxSources, node: ASTNode) -> String {
    let slot = ixView(src, node.file)
    let token = ixNameToken(src, slot, node)
    if (token < 0) { return "".clone() }
    let end = ixSignatureEnd(src, slot, token)
    if (end < 0) { return "".clone() }
    let mut at = token
    while (at <= end) {
        if (ixKindAt(src, slot, at) == FmtKind.ARROW) { return ixTypeAfter(src, slot, at) }
        at = at + 1
    }
    return "".clone()
}

fn ixDeclareParameters(inout ix: Ix, inout src: IxSources, fnNode: ASTNode, owner: Int, ownerType: String) {
    let mut ptr = fnNode.child1
    while (nodeExists(ptr)) {
        let param = ptr_to_node(ptr)
        ptr = param.next
        if (param.kind != NodeKind.FUNCTION_PARAMETER) { continue }
        let mut type = ixWrittenType(src, param)
        if (type.equals("") and param.s1.equals("self")) { type = ownerType.clone() }
        if (type.equals("")) { type = ixNodeType(param) }
        ixDeclareNode(ix, src, "param", param, owner, 0 - 1, type, "")
    }
}

// The leading words of a function's first parameter's type, `Vec` for `xs: Vec<Int>`: the type a
// `x.name()` call on that type would find it for. "" for a function with no parameters.
public fn ixReceiverOf(ix: Ix, id: Int) -> String {
    if (nodeIsNull(ix.dNode[id])) { return "".clone() }
    let node = ptr_to_node(ix.dNode[id])
    if (node.kind != NodeKind.FUNCTION and node.kind != NodeKind.EXTERN_FUNCTION) { return "".clone() }
    if (nodeIsNull(node.child1)) { return "".clone() }
    let first = ptr_to_node(node.child1)
    if (first.kind != NodeKind.FUNCTION_PARAMETER) { return "".clone() }
    if (first.s1.equals("self") and ix.dOwner[id].equals("") == false) { return ix.dOwner[id].clone() }
    let mut typeText = ixAnnotationText(first)
    // A generic parameter is not a type to look members up on.
    let mut generic = node.genericInfo
    while (nodeExists(generic)) {
        let parameter = ptr_to_node(generic)
        generic = parameter.next
        if (parameter.s1.equals(typeText)) { return "".clone() }
    }
    let angle = typeText.indexOf("<")
    if (angle >= 0) { typeText = typeText.substring(0, angle).clone() }
    if (typeText.endsWith("?")) { typeText = typeText.substring(0, typeText.length - 1).clone() }
    return typeText
}

// The name of a parameter's annotated type, without generic arguments.
fn ixAnnotationText(param: ASTNode) -> String {
    if (nodeIsNull(param.child1)) { return "".clone() }
    let annotation = ptr_to_node(param.child1)
    if (annotation.i1 == 1 and annotation.s1.equals("")) { return "Array".clone() }
    if (annotation.s1.equals("List")) { return "Vec".clone() }
    return annotation.s1.clone()
}

fn ixRegisterFunction(inout ix: Ix, id: Int) {
    let name = ix.dName[id]
    let first = ix.byFn.get(name)
    if (first < 0) {
        ix.byFn.put(name, id)
        return
    }
    let mut at = first
    while (at != id and ix.dOverload[at] >= 0) { at = ix.dOverload[at] }
    if (at != id) { ix.dOverload[at] = id }
}

fn ixCollectFunction(inout ix: Ix, inout src: IxSources, fnNode: ASTNode, implOf: IxMap) {
    let mut kind = "fn"
    if (nodeIsProperty(fnNode)) { kind = "prop" }
    let key = ixKey(fnNode.file, fnNode.line, fnNode.col)
    let mut container = 0 - 1
    let implId = implOf.get(key)
    let mut ownerType = "".clone()
    if (implId >= 0) {
        container = implId
        ownerType = ix.dOwner[implId].clone()
        if (kind.equals("fn")) { kind = "method" }
    }
    let id = ixDeclareNode(ix, src, kind, fnNode, container, fnNode.i2, ixReturnType(src, fnNode), fnNode.s2)
    if (id < 0) {
        // A function the compiler made (a closure's body): not a declaration, but the closure's
        // parameters are written in the source.
        ixDeclareParameters(ix, src, fnNode, 0 - 1, "")
        return
    }
    if (implId >= 0) { ix.dOwner[id] = ownerType.clone() }
    ix.dRecv[id] = ixReceiverOf(ix, id)
    if (fnNode.s2.equals("") == false) { ix.bySymbol.putFirst(fnNode.s2, id) }
    ixRegisterFunction(ix, id)
    ixDeclareParameters(ix, src, fnNode, id, ownerType)
}

fn ixCollectStruct(inout ix: Ix, inout src: IxSources, node: ASTNode) {
    if (nodeStructIsFromEnum(node)) {
        ixCollectPayloadEnum(ix, src, node)
        return
    }
    let id = ixDeclareNode(ix, src, "struct", node, 0 - 1, 0 - 1, "", "")
    if (id < 0) { return }
    ix.byType.putFirst(ix.dName[id], id)
    let mut ptr = node.child1
    while (nodeExists(ptr)) {
        let field = ptr_to_node(ptr)
        ptr = field.next
        if (field.kind != NodeKind.STRUCT_FIELD or field.s1.startsWith("$") or field.line < 1) { continue }
        let fid = ixDeclareNode(ix, src, "field", field, id, 0 - 1, ixWrittenType(src, field), "")
        if (fid >= 0) { ix.byMember.putFirst(ix.dName[id].concat(".", ix.dName[fid]), fid) }
    }
}

// A payload enum reaches here as the struct enumDesugarToStruct made of it: a `$tag` field and
// `Variant$n` fields for each payload. A variant with no payload leaves no field at all, so the
// variants are read from the text of the declaration: the word that begins each entry of the
// braces.
fn ixCollectPayloadEnum(inout ix: Ix, inout src: IxSources, node: ASTNode) {
    let id = ixDeclareNode(ix, src, "enum", node, 0 - 1, 0 - 1, "", "")
    if (id < 0) { return }
    ix.byType.putFirst(ix.dName[id], id)
    let slot = ixView(src, node.file)
    let name = ixNameToken(src, slot, node)
    if (name < 0) { return }
    let count = ixTokenCount(src, slot)
    let mut open = name
    while (open < count and ixKindAt(src, slot, open) != FmtKind.LBRACE) { open = open + 1 }
    if (open >= count) { return }
    let close = ixMatching(src, slot, open)
    let mut depth = 0
    let mut expectVariant = true
    let mut at = open
    while (at <= close) {
        let kind = ixKindAt(src, slot, at)
        if (kind == FmtKind.LBRACE or kind == FmtKind.LPAREN or kind == FmtKind.LBRACKET) { depth = depth + 1 }
        if (kind == FmtKind.RBRACE or kind == FmtKind.RPAREN or kind == FmtKind.RBRACKET) { depth = depth - 1 }
        if (depth == 1 and kind == FmtKind.COMMA) { expectVariant = true }
        if (depth == 1 and expectVariant and (kind == FmtKind.WORD or kind == FmtKind.CONTEXTUAL)) {
            let variant = ixTokenText(src, slot, at)
            let vid = ixAddDecl(ix, "variant", variant, node.file, ixTokenLine(src, slot, at), ixTokenCol(src, slot, at),
                                ixTokenLen(src, slot, at), id, 0 - 1, "", "", node_to_ptr(node))
            ix.byMember.putFirst(ix.dName[id].concat(".", variant), vid)
            expectVariant = false
        }
        if (kind == FmtKind.LINE_COMMENT or kind == FmtKind.BLOCK_COMMENT) { expectVariant = expectVariant }
        at = at + 1
    }
}

fn ixCollectEnum(inout ix: Ix, inout src: IxSources, node: ASTNode, kind: String, memberKind: String) {
    let id = ixDeclareNode(ix, src, kind, node, 0 - 1, node.i2, "", "")
    if (id < 0) { return }
    ix.byType.putFirst(ix.dName[id], id)
    let mut ptr = node.child1
    while (nodeExists(ptr)) {
        let variant = ptr_to_node(ptr)
        ptr = variant.next
        if (variant.kind != NodeKind.ENUM_VARIANT) { continue }
        let vid = ixDeclareNode(ix, src, memberKind, variant, id, 0 - 1, "", "")
        if (vid >= 0) { ix.byMember.putFirst(ix.dName[id].concat(".", ix.dName[vid]), vid) }
    }
}

fn ixCollectTrait(inout ix: Ix, inout src: IxSources, node: ASTNode) {
    let id = ixDeclareNode(ix, src, "trait", node, 0 - 1, 0 - 1, "", "")
    if (id < 0) { return }
    ix.byType.putFirst(ix.dName[id], id)
    let mut ptr = node.child1
    while (nodeExists(ptr)) {
        let signature = ptr_to_node(ptr)
        ptr = signature.next
        if (signature.kind != NodeKind.FUNCTION) { continue }
        let mid = ixDeclareNode(ix, src, "method", signature, id, 0 - 1, ixReturnType(src, signature), "")
        if (mid < 0) { continue }
        ix.dOwner[mid] = ix.dName[id].clone()
        ix.byMember.putFirst(ix.dName[id].concat(".", ix.dName[mid]), mid)
        ixDeclareParameters(ix, src, signature, mid, ix.dName[id])
    }
    let mut cptr = node.child3
    while (nodeExists(cptr)) {
        let member = ptr_to_node(cptr)
        cptr = member.next
        if (member.kind == NodeKind.ASSOC_CONST) {
            ixDeclareNode(ix, src, "assocconst", member, id, 0 - 1, "", "")
        } else if (member.kind == NodeKind.ASSOC_TYPE) {
            ixDeclareNode(ix, src, "assoctype", member, id, 0 - 1, "", "")
        }
    }
}

// An `impl` block is a declaration of its own, the container of its methods. Its name is what it
// reads as: `impl Dog`, `impl Named for Dog`.
fn ixCollectImpl(inout ix: Ix, inout src: IxSources, node: ASTNode, inout implOf: IxMap) {
    let slot = ixView(src, node.file)
    if (slot < 0 or node.line < 1) { return }
    let token = ixTokenAt(src, slot, node.line, node.col)
    if (token < 0) { return }
    let mut label = "impl ".concat(node.s1)
    if (node.s2.equals("") == false) { label = "impl ".concat(node.s2, " for ", node.s1) }
    let id = ixAddDecl(ix, "impl", label, node.file, node.line, node.col, ixTokenLen(src, slot, token), 0 - 1, 0 - 1,
                       "", "", node_to_ptr(node))
    ix.dOwner[id] = node.s1.clone()
    let mut ptr = node.child2
    while (nodeExists(ptr)) {
        let record = ptr_to_node(ptr)
        ptr = record.next
        if (record.kind == NodeKind.IMPL_METHOD and record.line > 0) {
            implOf.put(ixKey(record.file, record.line, record.col), id)
        }
    }
    if (nodeIsNull(node.child3)) { return }
    let header = ptr_to_node(node.child3)
    let mut cptr = header.child3
    while (nodeExists(cptr)) {
        let member = ptr_to_node(cptr)
        cptr = member.next
        if (member.kind == NodeKind.ASSOC_CONST) {
            ixDeclareNode(ix, src, "assocconst", member, id, 0 - 1, ixWrittenType(src, member), "")
        } else if (member.kind == NodeKind.ASSOC_TYPE) {
            ixDeclareNode(ix, src, "assoctype", member, id, 0 - 1, "", "")
        }
    }
}

fn ixCollectGlobal(inout ix: Ix, inout src: IxSources, node: ASTNode) {
    let mut kind = "const"
    if (node.i1 == 1) { kind = "global" }
    let id = ixDeclareNode(ix, src, kind, node, 0 - 1, node.i2, ixBindingType(src, node), "")
    if (id >= 0) { ix.byGlobal.putFirst(ix.dName[id], id) }
}

fn ixCollectNode(inout ix: Ix, inout src: IxSources, node: ASTNode, inout implOf: IxMap) {
    match (node.kind) {
        NodeKind.STRUCT_DECL => { ixCollectStruct(ix, src, node) }
        NodeKind.ENUM_DECL => { ixCollectEnum(ix, src, node, "enum", "variant") }
        NodeKind.CODESET_DECL => { ixCollectEnum(ix, src, node, "codeset", "code") }
        NodeKind.TRAIT_DECL => { ixCollectTrait(ix, src, node) }
        NodeKind.IMPL_DECL => { ixCollectImpl(ix, src, node, implOf) }
        NodeKind.FUNCTION => { ixCollectFunction(ix, src, node, implOf) }
        NodeKind.EXTERN_FUNCTION => {
            let id = ixDeclareNode(ix, src, "extern", node, 0 - 1, node.i2, "", node.s2)
            if (id >= 0) {
                ix.byGlobal.putFirst(ix.dName[id], id)
                ixDeclareParameters(ix, src, node, id, "")
            }
        }
        NodeKind.VARIABLE_DECL => { ixCollectGlobal(ix, src, node) }
        NodeKind.EXTERN_VARIABLE => {
            let id = ixDeclareNode(ix, src, "externvar", node, 0 - 1, node.i2, ixWrittenType(src, node), "")
            if (id >= 0) { ix.byGlobal.putFirst(ix.dName[id], id) }
        }
        NodeKind.TYPELIST_DECL => {
            let id = ixDeclareNode(ix, src, "typelist", node, 0 - 1, 0 - 1, "", "")
            if (id >= 0) { ix.byType.putFirst(ix.dName[id], id) }
        }
        _ => { }
    }
}

fn ixCollectChain(inout ix: Ix, inout src: IxSources, head: Ptr, inout implOf: IxMap) {
    let mut ptr = head
    while (nodeExists(ptr)) {
        let node = ptr_to_node(ptr)
        ptr = node.next
        if (node.line < 1) { continue }
        ixCollectNode(ix, src, node, implOf)
    }
}

// Every declaration of the program: the templates of `merged.child2`, then the concrete chain.
public fn ixCollect(inout ix: Ix, inout src: IxSources, merged: ASTNode) {
    let mut implOf = ixMap()
    ixCollectChain(ix, src, merged.child2, implOf)
    ixCollectChain(ix, src, merged.child1, implOf)
}

// ---------------------------------------------------------------------------------------------
// Imports
//
// The merge consumes `import` statements, so they are not in the tree the walk reads; they are read
// from the text of each of the user's files. An import declares the name a program refers to the module
// by: its last segment, or its alias.

fn ixImportPath(src: IxSources, slot: Int, first: Int) -> Int {
    // The last token of `a.b.c` starting at `first`.
    let mut at = first
    while (ixKindAt(src, slot, at + 1) == FmtKind.DOT and ixKindAt(src, slot, at + 2) != FmtKind.NONE) {
        at = at + 2
    }
    return at
}

fn ixDeclareImport(inout ix: Ix, inout src: IxSources, file: Int, slot: Int, directory: String, first: Int,
                   last: Int, aliasToken: Int) {
    if (first < 0 or last < first or last >= ixTokenCount(src, slot)) { return }
    let leaf = ixTokenText(src, slot, last)
    let mut path = leaf.clone()
    if (last > first) { path = ixSlice(src, slot, first, last).replaceAll(" ", "") }
    if (directory.equals("") == false) { path = directory.concat(".", path) }
    let mut shown = last
    let mut local = leaf.clone()
    if (aliasToken >= 0 and aliasToken < ixTokenCount(src, slot)) {
        shown = aliasToken
        local = ixTokenText(src, slot, aliasToken)
    }
    let id = ixAddDecl(ix, "import", path, file, ixTokenLine(src, slot, shown), ixTokenCol(src, slot, shown),
                       ixTokenLen(src, slot, shown), 0 - 1, 0 - 1, "", "", ptr_null())
    ix.byImport.putFirst(local, id)
}

fn ixCollectImportsIn(inout ix: Ix, inout src: IxSources, file: Int) {
    let slot = ixView(src, file)
    if (slot < 0) { return }
    let count = ixTokenCount(src, slot)
    let mut at = 0
    while (at < count) {
        let isFirst = at == 0 or src.tokens[slot].breaks[at] > 0
        let word = ixTokenText(src, slot, at)
        if (isFirst == false or (word.equals("import") == false and word.equals("from") == false)) {
            at = at + 1
            continue
        }
        let fromFirst = word.equals("from")
        let mut cursor = at + 1
        let mut directory = "".clone()
        if (fromFirst) {
            // `from std import {io, string}`: the directory, then the group.
            let dirFirst = cursor
            let dirLast = ixImportPath(src, slot, dirFirst)
            directory = ixSlice(src, slot, dirFirst, dirLast).replaceAll(" ", "")
            cursor = dirLast + 1
            if (ixTokenText(src, slot, cursor).equals("import")) { cursor = cursor + 1 }
        }
        // A statement cut off after the keyword names nothing.
        if (cursor >= count) { return }
        if (ixKindAt(src, slot, cursor) == FmtKind.LBRACE) {
            let close = ixMatching(src, slot, cursor)
            let mut entry = cursor + 1
            let mut entries: Vec<Int> = []
            let mut aliases: Vec<Int> = []
            while (entry < close) {
                if (ixKindAt(src, slot, entry) == FmtKind.WORD or ixKindAt(src, slot, entry) == FmtKind.CONTEXTUAL) {
                    let mut alias = 0 - 1
                    if (ixTokenText(src, slot, entry + 1).equals("as")) { alias = entry + 2 }
                    entries.push(entry)
                    aliases.push(alias)
                    entry = entry + 1
                    if (alias >= 0) { entry = alias + 1 }
                } else {
                    entry = entry + 1
                }
            }
            if (fromFirst == false) {
                // `import {io, string} from std`: the directory follows the group.
                let fromToken = close + 1
                if (ixTokenText(src, slot, fromToken).equals("from")) {
                    let dirLast = ixImportPath(src, slot, fromToken + 1)
                    directory = ixSlice(src, slot, fromToken + 1, dirLast).replaceAll(" ", "")
                }
            }
            let mut k = 0
            while (k < entries.length) {
                ixDeclareImport(ix, src, file, slot, directory, entries[k], entries[k], aliases[k])
                k = k + 1
            }
        } else if (fromFirst == false and ixKindAt(src, slot, cursor) != FmtKind.ARITH) {
            let last = ixImportPath(src, slot, cursor)
            let mut alias = 0 - 1
            if (ixTokenText(src, slot, last + 1).equals("as")) { alias = last + 2 }
            ixDeclareImport(ix, src, file, slot, "", cursor, last, alias)
        }
        at = cursor + 1
    }
}

// The imports of every file the user is working in.
public fn ixCollectImports(inout ix: Ix, inout src: IxSources) {
    let mut file = 0
    while (file < ix.userFiles.length) {
        if (ix.userFiles[file]) { ixCollectImportsIn(ix, src, file) }
        file = file + 1
    }
}
