// LLVM Bridge FFI for Prismio

// Global state
extern fn ir_reset()
extern fn ir_print()
extern fn ir_write_file(filename: String) -> Int
extern fn ir_append(text: String)
extern fn ir_append_line(text: String)
extern fn ir_get_temp() -> Int

// Module
extern fn ir_module_start(module_name: String)
extern fn ir_module_start_wasm(module_name: String)
extern fn ir_module_end()

// Types
extern fn ir_type_void() -> String
extern fn ir_type_i1() -> String
extern fn ir_type_i8() -> String
extern fn ir_type_i32() -> String
extern fn ir_type_i64() -> String
extern fn ir_type_i8_ptr() -> String

// Function Builders
extern fn ir_declare_function_begin(name: String, ret_type: String)
extern fn ir_declare_function_param(param_type: String)
extern fn ir_declare_function_end()

extern fn ir_function_begin(name: String, ret_type: String)
extern fn ir_function_param(param_type: String, param_name: String)
extern fn ir_function_body_start()
extern fn ir_function_end()

// Call Builder
extern fn ir_call_begin()
extern fn ir_call_arg(arg_type: String, arg_value: String)
extern fn ir_call_end(ret_type: String, func_name: String) -> Int

// Basic Blocks
extern fn ir_get_label() -> Int
extern fn ir_label(label_name: String)
extern fn ir_label_numbered(label_num: Int)

// Memory
extern fn ir_alloca(type: String, name: String) -> Int
extern fn ir_load(type: String, ptr_name: String) -> Int
extern fn ir_store(type: String, value: String, ptr_name: String)
extern fn ir_load_global(type: String, name: String) -> Int
extern fn ir_store_global(type: String, value: String, name: String)

// Arithmetic
extern fn ir_add(type: String, lhs: String, rhs: String) -> Int
extern fn ir_sub(type: String, lhs: String, rhs: String) -> Int
extern fn ir_mul(type: String, lhs: String, rhs: String) -> Int
extern fn ir_sdiv(type: String, lhs: String, rhs: String) -> Int
extern fn ir_srem(type: String, lhs: String, rhs: String) -> Int
extern fn ir_udiv(type: String, lhs: String, rhs: String) -> Int
extern fn ir_urem(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fadd(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fsub(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fmul(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fdiv(type: String, lhs: String, rhs: String) -> Int
extern fn ir_neg(type: String, value: String) -> Int

// Width conversions
extern fn ir_zext(from_type: String, value: String, to_type: String) -> Int
extern fn ir_sext(from_type: String, value: String, to_type: String) -> Int
extern fn ir_trunc(from_type: String, value: String, to_type: String) -> Int
extern fn ir_sitofp(from_type: String, value: String, to_type: String) -> Int
extern fn ir_uitofp(from_type: String, value: String, to_type: String) -> Int
extern fn ir_fptosi(from_type: String, value: String, to_type: String) -> Int
extern fn ir_fptoui(from_type: String, value: String, to_type: String) -> Int
extern fn ir_and(type: String, lhs: String, rhs: String) -> Int
extern fn ir_or(type: String, lhs: String, rhs: String) -> Int
extern fn ir_xor(type: String, lhs: String, rhs: String) -> Int
extern fn ir_not(type: String, value: String) -> Int
extern fn ir_shl(type: String, lhs: String, rhs: String) -> Int
extern fn ir_lshr(type: String, lhs: String, rhs: String) -> Int
extern fn ir_ashr(type: String, lhs: String, rhs: String) -> Int

// Comparisons
extern fn ir_icmp_eq(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_ne(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_slt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_sle(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_sgt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_sge(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_ult(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_ule(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_ugt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_uge(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_oeq(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_one(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_olt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_ole(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_ogt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_oge(type: String, lhs: String, rhs: String) -> Int

// Control Flow
extern fn ir_ret(type: String, value: String)
extern fn ir_ret_void()
extern fn ir_br(label: String)
extern fn ir_br_numbered(label_num: Int)
extern fn ir_cond_br(condition: String, true_label: String, false_label: String)
extern fn ir_cond_br_numbered(condition: String, true_label: Int, false_label: Int)

// Loop context (break/continue targets)
extern fn ir_loop_push(continue_label: Int, break_label: Int)
extern fn ir_loop_pop()
extern fn ir_loop_continue_label() -> Int
extern fn ir_loop_break_label() -> Int

// Move tracking (ownership / MVS)
extern fn ir_clear_moved()
extern fn ir_mark_moved(name: String)
extern fn ir_unmark_moved(name: String)
extern fn ir_is_moved(name: String) -> Int

// Borrow tracking (non-owning bindings: let/inout params)
extern fn ir_clear_borrowed()
extern fn ir_mark_borrowed(name: String)
extern fn ir_is_borrowed(name: String) -> Int

// Globals
extern fn ir_global_string(name: String, str_content: String)
extern fn ir_global_var(name: String, type: String, init_value: String, is_const: Int)

// Typed structural builders.
// Both backends implement these identically. The frontend must build structs,
// arrays and field access through them rather than emitting IR text, because
// the LLVM C API backend has no way to honour raw text.
extern fn ir_set_pointer_int_type(t: String)
extern fn ir_set_opt_level(level: Int)
extern fn ir_struct_type_begin(name: String)
extern fn ir_struct_type_field(field_type: String)
extern fn ir_struct_type_end()
extern fn ir_alloc_object(struct_name: String) -> Int
extern fn ir_free_object(value: String)
extern fn ir_struct_field_ptr(struct_name: String, object: String, field_index: Int) -> Int
extern fn ir_elem_ptr(elem_type: String, base: String, index: String) -> Int
extern fn ir_array_alloca(elem_type: String, count: Int) -> Int
extern fn ir_string_ptr(global_name: String) -> Int
extern fn ir_load_ptr(type: String, ptr_value: String) -> Int
extern fn ir_store_ptr(type: String, value: String, ptr_value: String)

// Helpers
extern fn ir_get_temp_name(temp_num: Int) -> String
extern fn ir_get_label_name(label_num: Int) -> String
extern fn ir_register_global_name(name: String)
extern fn ir_is_global_name(name: String) -> Int
extern fn ir_reset_globals()
extern fn ir_reset_types()
extern fn ir_register_struct(name: String)
extern fn ir_register_struct_field(struct_name: String, field_name: String, field_type: String)
extern fn ir_is_struct_type_name(name: String) -> Int
extern fn ir_get_struct_field_index(struct_name: String, field_name: String) -> Int
extern fn ir_get_struct_field_type(struct_name: String, field_name: String) -> String
extern fn ir_register_enum_variant(enum_name: String, variant_name: String, value: Int)
extern fn ir_get_enum_variant(enum_name: String, variant_name: String) -> Int
extern fn ir_set_var_type(name: String, var_type: String)
extern fn ir_set_global_var_type(name: String, var_type: String)
extern fn ir_get_var_type(name: String) -> String
extern fn ir_has_var_type(name: String) -> Int

// Lexical scoping. A block pushes on entry and pops on exit; a binding is
// visible only until its scope is popped, and re-declaring a name shadows the
// outer one rather than overwriting it.
extern fn ir_scope_push()
extern fn ir_scope_pop()

// Loop barriers, so move checking can tell a binding the loop created from one
// it inherited. Moving out of the latter inside a loop repeats every iteration.
extern fn ir_loop_barrier_push()
extern fn ir_loop_barrier_pop()
extern fn ir_binding_predates_loop(name: String) -> Int

// The LLVM-level name of the innermost binding, and whether that binding is
// module-level. Both are shadowing-aware, which is what codegen needs to pick
// between @global and %slot and to give sibling blocks separate stack slots.
extern fn ir_get_var_slot(name: String) -> String
extern fn ir_var_is_global(name: String) -> Int
extern fn ir_mark_mutable(name: String)
extern fn ir_var_is_mutable(name: String) -> Int
extern fn ir_clear_var_types()
extern fn ir_clear_local_var_types()
extern fn ir_set_returned()
extern fn ir_has_returned() -> Int
extern fn ir_clear_returned()
extern fn ir_comment(comment: String)
extern fn ir_blank_line()
