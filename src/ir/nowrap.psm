// No-wrap facts that an unchecked array access implies.
//
// An element of an `Array<T, N>` or of a `[T]` view is addressed without a check
// (generateIndex; the store in stmt.psm), and the language requires every index
// to lie in range (specification/behavior.md). So an access that ran had its index
// in [0, len), and every length fits `Int`: the index was in [0, Int.MAX - 1]. The
// fact holds until the name is assigned or bound again. A scalar cannot be passed
// `inout` and a closure captures by value, so nothing but an assignment in this
// function changes one of its `Int` locals.
//
// Two kinds of `+`/`-` become `nsw` (generateBinary):
//
// - One whose operands the facts bound and whose exact result lies inside `Int`.
//   It cannot wrap, so the mark is a fact, not an assumption. Quicksort's scan
//   `while (a[i] < p) { i = i + 1 }` adds 1 to an `i` the access left at most
//   Int.MAX - 1.
// - One that *is* an unchecked subscript, with its left operand (either operand of
//   a `+`) known non-negative. Such a sum can only wrap upwards, to a negative
//   value, so a wrapped result is out of range, and the access that is its only use
//   is undefined anyway. Knapsack's `best[c - w]`, after `best[c]` put `c` at 0 or
//   more.
//
// Measured on the freestanding suite (aarch64, instructions executed): quicksort
// 11.30M -> 9.99M, against C's 10.10M; knapsack 5.69M -> 5.12M, C's count.
//
// **A counter's update is marked only when its loop's subscripts are.** `nsw` on
// `c = c - 1` lets IndVarSimplify widen `c` to 64 bits, and a subscript computed
// from it with a plain `-` then costs a truncation and an extension per access:
// knapsack with `c - 1` marked and `c - w` not measured 6.26M, worse than neither.
// The first walk records every counter some subscript in a loop combines without a
// mark; the second marks, and leaves those counters' updates in those loops plain.
//
// Two more sources feed the same facts: a counted loop bounds its counter
// (ir/counters.psm), and a local array whose stores the walk can see keeps a bound on its
// elements (ir/contents.psm), which edit distance's `min(a + 1, b + 1)` needs.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string

let NOWRAP_RECORD = 0
let NOWRAP_MARK = 1
// A walk of a loop body under a guessed invariant (nowrapInvariants): it marks
// nothing and records nothing, so a guess that fails leaves no trace.
let NOWRAP_PROBE = 2

// Probes one function may spend on loop invariants. A nest multiplies them, and past
// this a loop keeps only what it kept before.
let NOWRAP_PROBE_BUDGET = 400
// Rounds before an invariant is given up. Widening starts at the third; from the sixth a
// guess that still moves is dropped, so the others are not held up by it.
let NOWRAP_INVARIANT_ROUNDS = 10
let NOWRAP_WIDEN_ROUND = 2
let NOWRAP_DROP_ROUND = 5

// Literals this reads stay far from the edge of the i64 intervals are computed in.
let NOWRAP_LITERAL_DIGITS = 9

struct NowrapFacts {
    // `names[i]` lies in [los[i], his[i]] at the walk's point. A dropped fact keeps
    // its slot with an empty interval.
    names: Vec<String>,
    internal los: Vec<I64>,
    internal his: Vec<I64>,
    // False once every path to the walk's point has left the block: a `return`,
    // `break` or `continue`.
    live: Bool
}

struct NowrapWalk {
    mode: Int,
    pass: Int,
    // The ordinal of every loop around the walk's point, innermost last, in the
    // first `loopDepth` slots, and how many times each one's body can run, or -1.
    // Loops are numbered in walk order, which the two walks share.
    loops: Vec<Int>,
    trips: Vec<Int>,
    loopDepth: Int,
    loopCount: Int,
    // The block the walk is in, numbered as it enters them.
    block: Int,
    blockCount: Int,
    // The `and` conjunct of a condition being read, numbered from 0 in evaluation order.
    internal leaf: Int,
    // What local `Int` arrays hold (ir/contents.psm): recorded by the first walk,
    // settled between the two, read by the second.
    contents: ArrayContents,
    // A counter that a subscript in loop `blockedLoops[i]` combines with `+` or `-`
    // without a mark.
    blockedNames: Vec<String>,
    blockedLoops: Vec<Int>,
    // The interval the last nowrapInterval call found.
    internal lo: I64,
    internal hi: I64,
    // Loop-body probes spent so far, against NOWRAP_PROBE_BUDGET.
    probes: Int,
    // Where calls to the functions ir/param_ranges.psm watches are recorded, by the
    // record walk only: a probe walks a body under guesses, not facts.
    calls: NowrapCallSites,
    // Set while an expression already walked is walked again: no call is recorded.
    internal quiet: Bool,
    // Congruences of the immutable `let`s in scope, and its literal arrays
    // (ir/strides.psm), and the congruence the last nowrapStride call found.
    internal strides: IndexStrides,
    internal stride: I64,
    internal residue: I64,
    // The function's body, which a literal array's no-store check reads.
    body: Ptr
}

// The calls one record walk saw to watched functions. Each call is one entry of
// `seen`, its callee's symbol, and each of its arguments one row: the callee, the
// argument's position, and its interval where the facts bound it (lo > hi where
// they did not), read where the call is made, after every argument ran.
struct NowrapCallSites {
    internal watched: Vec<String>,
    internal seen: Vec<String>,
    internal symbols: Vec<String>,
    internal indices: Vec<Int>,
    internal los: Vec<I64>,
    internal his: Vec<I64>
}

internal fn nowrapCallSitesNew() -> NowrapCallSites {
    return NowrapCallSites { watched: [], seen: [], symbols: [], indices: [], los: [], his: [] }
}

impl NowrapCallSites {
    private fn watches(self, symbol: String) -> Bool {
        for i in 0..<self.watched.length {
            let known: String = self.watched[i]
            if (known.equals(symbol)) { return true }
        }
        return false
    }
}

// The pass whose marks the function's body carries, or 0. Run before the body is
// generated, so that every copy of every loop in it sees the same marks. `entry`
// holds at the first statement: what every caller passes (ir/param_ranges.psm).
internal fn nowrapAnalyse(func: ASTNode, entry: NowrapFacts) -> Int {
    if (nodeIsNull(func.child2)) { return 0 }
    let w = nowrapWalkNew(func, nowrapCallSitesNew())
    nowrapBlock(w, entry.copy(), func.child2)
    w.contents.settle()
    w.mode = NOWRAP_MARK
    w.pass = ir_range_proof_new()
    w.loopCount = 0
    w.blockCount = 0
    nowrapBlock(w, entry.copy(), func.child2)
    return w.pass
}

// The record walk alone, adding to `sites` the calls it sees to their watched
// functions. The walk records into sites of its own, which it owns and releases;
// holding the caller's borrowed `sites` in the walk would have released them too.
internal fn nowrapRecordCalls(func: ASTNode, entry: NowrapFacts, sites: NowrapCallSites) {
    if (nodeIsNull(func.child2)) { return }
    let own = nowrapCallSitesNew()
    for i in 0..<sites.watched.length {
        let symbol: String = sites.watched[i]
        own.watched.push(symbol.clone())
    }
    let w = nowrapWalkNew(func, own)
    nowrapBlock(w, entry.copy(), func.child2)
    for i in 0..<w.calls.seen.length {
        let symbol: String = w.calls.seen[i]
        sites.seen.push(symbol.clone())
    }
    for i in 0..<w.calls.symbols.length {
        let symbol: String = w.calls.symbols[i]
        sites.symbols.push(symbol.clone())
        sites.indices.push(w.calls.indices[i])
        sites.los.push(w.calls.los[i])
        sites.his.push(w.calls.his[i])
    }
}

private fn nowrapWalkNew(func: ASTNode, sites: NowrapCallSites) -> NowrapWalk {
    return NowrapWalk {
        mode: NOWRAP_RECORD, pass: ir_range_proof_new(), loops: [], trips: [], loopDepth: 0,
        loopCount: 0, block: 0, blockCount: 0, leaf: 0, contents: contentsCollect(func),
        blockedNames: [], blockedLoops: [], lo: 0 as I64, hi: 0 as I64, probes: 0, calls: sites, quiet: false,
        strides: indexStridesNew(), stride: 1 as I64, residue: 0 as I64, body: func.child2
    }
}

// Whether `expr`, a `+` or `-`, is one the active pass proved cannot wrap.
internal fn nowrapImplied(expr: ASTNode) -> Bool {
    if (irNowrapPass == 0) { return false }
    return ir_nowrap_of(node_to_ptr(expr)) == irNowrapPass
}

// ---------------------------------------------------------------------------
// Facts
// ---------------------------------------------------------------------------

internal fn nowrapFactsNew() -> NowrapFacts {
    return NowrapFacts { names: [], los: [], his: [], live: true }
}

// `name` lies in [lo, hi] where the walk starts.
internal fn nowrapAssume(f: NowrapFacts, name: String, lo: I64, hi: I64) {
    f.set(name, lo, hi)
}

impl NowrapFacts {
    // The slot holding a live fact on `name`, or -1.
    internal fn find(self, name: String) -> Int {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name) and self.los[i] <= self.his[i]) { return i }
        }
        return 0 - 1
    }
}


impl NowrapFacts {
    private fn copy(self) -> NowrapFacts {
        let out = nowrapFactsNew()
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            out.names.push(known.clone())
            out.los.push(self.los[i])
            out.his.push(self.his[i])
        }
        out.live = self.live
        return out
    }
}


impl NowrapFacts {
    // The name is an integer of at most 32 bits, so a bound past every such type's
    // edge says nothing more.
    private fn set(self, name: String, lo: I64, hi: I64) {
        self.kill(name)
        self.names.push(name.clone())
        self.los.push(nowrapClamp(lo))
        self.his.push(nowrapClamp(hi))
    }
}


private fn nowrapClamp(v: I64) -> I64 {
    let low = (0 - 2147483647 - 1) as I64
    let high = 4294967295 as I64
    if (v < low) { return low }
    if (v > high) { return high }
    return v
}


impl NowrapFacts {
    private fn kill(self, name: String) {
        let at = self.find(name)
        if (at < 0) { return }
        self.los[at] = 1 as I64
        self.his[at] = 0 as I64
    }
}


impl NowrapFacts {
    // Narrows the fact on `name` to [lo, hi], as an access does.
    private fn narrow(self, name: String, lo: I64, hi: I64) {
        let at = self.find(name)
        if (at < 0) {
            self.set(name, lo, hi)
            return
        }
        if (lo > self.los[at]) { self.los[at] = nowrapClamp(lo) }
        if (hi < self.his[at]) { self.his[at] = nowrapClamp(hi) }
    }
}


impl NowrapFacts {
    // The facts that hold where this path and `other` meet: each name both bound,
    // in the hull of the two intervals.
    private fn joinFrom(self, other: NowrapFacts) {
        if (other.live == false) { return }
        if (self.live == false) {
            for i in 0..<self.names.length {
                self.los[i] = 1 as I64
                self.his[i] = 0 as I64
            }
            for i in 0..<other.names.length {
                let known: String = other.names[i]
                self.names.push(known.clone())
                self.los.push(other.los[i])
                self.his.push(other.his[i])
            }
            self.live = true
            return
        }
        for i in 0..<self.names.length {
            if (self.los[i] <= self.his[i]) {
                let known: String = self.names[i]
                let theirs = other.find(known)
                if (theirs < 0) {
                    self.los[i] = 1 as I64
                    self.his[i] = 0 as I64
                } else {
                    if (other.los[theirs] < self.los[i]) { self.los[i] = other.los[theirs] }
                    if (other.his[theirs] > self.his[i]) { self.his[i] = other.his[theirs] }
                }
            }
        }
    }
}


// Drops every fact on a name the subtree assigns or binds: what a loop's head
// can still rely on, whichever iteration it is.
private fn nowrapKillBound(f: NowrapFacts, nodePtr: Ptr) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.CLOSURE_EXPR) { return }
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
        let target = ptr_to_node(n.child1)
        if (target.kind == NodeKind.IDENTIFIER_EXPR) { f.kill(target.s1) }
    }
    if (n.kind == NodeKind.VARIABLE_DECL or n.kind == NodeKind.FOR_STATEMENT) { f.kill(n.s1) }
    // `for (i, x) in xs` binds its second name in s2.
    if (n.kind == NodeKind.FOR_STATEMENT) { f.kill(n.s2) }
    if (n.kind == NodeKind.MATCH_ARM) { nowrapKillNames(f, n.child1) }
    nowrapKillBoundChain(f, n.child1)
    nowrapKillBoundChain(f, n.child2)
    nowrapKillBoundChain(f, n.child3)
}

private fn nowrapKillBoundChain(f: NowrapFacts, head: Ptr) {
    let mut p = head
    while (nodeExists(p)) {
        nowrapKillBound(f, p)
        p = ptr_to_node(p).next
    }
}

// Every name a pattern mentions, any of which it may bind.
private fn nowrapKillNames(f: NowrapFacts, nodePtr: Ptr) {
    let mut p = nodePtr
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (n.kind == NodeKind.IDENTIFIER_EXPR) { f.kill(n.s1) }
        nowrapKillNames(f, n.child1)
        nowrapKillNames(f, n.child2)
        nowrapKillNames(f, n.child3)
        p = n.next
    }
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

// A block in order. The names it declares go out of scope at its end, where the
// same names mean whatever they meant before it, so their facts go too.
private fn nowrapBlock(w: NowrapWalk, f: NowrapFacts, blockPtr: Ptr) {
    if (nodeIsNull(blockPtr)) { return }
    let outer = w.block
    w.blockCount = w.blockCount + 1
    w.block = w.blockCount
    let mut p = ptr_to_node(blockPtr).child1
    while (nodeExists(p) and f.live) {
        nowrapStmt(w, f, p)
        p = ptr_to_node(p).next
    }
    w.block = outer
    let mut q = ptr_to_node(blockPtr).child1
    while (nodeExists(q)) {
        let s = ptr_to_node(q)
        if (s.kind == NodeKind.VARIABLE_DECL) {
            f.kill(s.s1)
            w.strides.kill(s.s1)
        }
        q = s.next
    }
}

private fn nowrapStmt(w: NowrapWalk, f: NowrapFacts, stmtPtr: Ptr) {
    let s = ptr_to_node(stmtPtr)
    match (s.kind) {
        NodeKind.EXPRESSION_STATEMENT => {
            nowrapExpr(w, f, s.child1)
            return
        }
        NodeKind.VARIABLE_DECL => {
            nowrapExpr(w, f, s.child2)
            let known = nowrapInterval(w, f, s.child2)
            f.kill(s.s1)
            if (known and ir_var_is_global(s.s1) == 0) { f.set(s.s1, w.lo, w.hi) }
            nowrapDeclaredStride(w, f, s, stmtPtr)
            nowrapDeclared(w, f, s)
            return
        }
        NodeKind.ASSIGNMENT_STATEMENT => {
            nowrapAssign(w, f, s)
            return
        }
        NodeKind.IF_STATEMENT => {
            nowrapIf(w, f, s)
            return
        }
        NodeKind.MATCH_STATEMENT => {
            nowrapMatch(w, f, s)
            return
        }
        NodeKind.WHILE_STATEMENT => {
            nowrapLoop(w, f, s.child1, s.child2, s)
            return
        }
        NodeKind.LOOP_STATEMENT => {
            nowrapLoop(w, f, ptr_null(), s.child1, s)
            return
        }
        NodeKind.FOR_STATEMENT => {
            nowrapExpr(w, f, s.child1)
            nowrapExprChain(w, f, s.child2)
            let counted = nowrapForRange(w, f, s)
            f.kill(s.s1)
            f.kill(s.s2)
            if (counted) { f.set(s.s1, w.lo, w.hi) }
            nowrapLoop(w, f, ptr_null(), s.child3, s)
            f.kill(s.s1)
            f.kill(s.s2)
            return
        }
        NodeKind.BLOCK => {
            nowrapBlock(w, f, stmtPtr)
            return
        }
        NodeKind.REGION_STATEMENT => {
            nowrapBlock(w, f, s.child1)
            return
        }
        NodeKind.RETURN_STATEMENT => {
            nowrapExpr(w, f, s.child1)
            f.live = false
            return
        }
        NodeKind.BREAK_STATEMENT => {
            f.live = false
            return
        }
        NodeKind.CONTINUE_STATEMENT => {
            f.live = false
            return
        }
    }
    // A statement this does not model: its arithmetic is still read, from a copy,
    // nothing it may assign keeps a fact, and no array it stores into keeps a bound.
    let inside = f.copy()
    nowrapExprChain(w, inside, s.child1)
    nowrapExprChain(w, inside, s.child2)
    nowrapExprChain(w, inside, s.child3)
    nowrapKillBound(f, stmtPtr)
    nowrapFailStores(w, stmtPtr)
}

private fn nowrapFailStores(w: NowrapWalk, nodePtr: Ptr) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
        let slot = w.contents.slotOfIndex(ptr_to_node(n.child1))
        if (slot >= 0) { w.contents.fail(slot) }
    }
    let mut p = n.child1
    while (nodeExists(p)) {
        nowrapFailStores(w, p)
        p = ptr_to_node(p).next
    }
    let mut q = n.child2
    while (nodeExists(q)) {
        nowrapFailStores(w, q)
        q = ptr_to_node(q).next
    }
    let mut r = n.child3
    while (nodeExists(r)) {
        nowrapFailStores(w, r)
        r = ptr_to_node(r).next
    }
}

private fn nowrapAssign(w: NowrapWalk, f: NowrapFacts, s: ASTNode) {
    if (nodeIsNull(s.child1)) { return }
    let target = ptr_to_node(s.child1)
    if (target.kind == NodeKind.IDENTIFIER_EXPR) {
        if (nowrapIsUpdate(s)) {
            nowrapUpdate(w, f, s)
        } else {
            nowrapExpr(w, f, s.child2)
        }
        let known = nowrapInterval(w, f, s.child2)
        f.kill(target.s1)
        if (known and nowrapHoldsFacts(target)) { f.set(target.s1, w.lo, w.hi) }
        return
    }
    // `a[i] = v` evaluates the array, the subscript, then the value, then stores
    // (generateAssignment), so the store's fact holds only after the value.
    if (target.kind == NodeKind.INDEX_EXPR and nowrapIsUnchecked(target)) {
        nowrapExpr(w, f, target.child1)
        nowrapExpr(w, f, target.child2)
        nowrapSubscript(w, f, target)
        nowrapMarkInRange(w, f, target)
        nowrapExpr(w, f, s.child2)
        nowrapStored(w, f, target, s.child2)
        nowrapAccessed(f, target)
        return
    }
    nowrapExpr(w, f, s.child1)
    nowrapExpr(w, f, s.child2)
}

// An immutable `let`'s congruence, and whether it is a literal array whose elements
// are known (ir/strides.psm). A `let mut` of the same name ends what was known.
private fn nowrapDeclaredStride(w: NowrapWalk, f: NowrapFacts, s: ASTNode, stmtPtr: Ptr) {
    w.strides.kill(s.s1)
    if (s.i1 == 1 or ir_var_is_global(s.s1) != 0) { return }
    if (nowrapStride(w, f, s.child2)) { w.strides.setCongruence(s.s1, w.stride, w.residue) }
    if (strideIsLiteralArray(s, w.body)) { w.strides.addArray(s.s1, stmtPtr) }
}

// The declaration of an array ir/contents.psm follows: where its lifetime starts, and
// what its elements start as, zero or a literal's.
private fn nowrapDeclared(w: NowrapWalk, f: NowrapFacts, s: ASTNode) {
    if (w.mode != NOWRAP_RECORD) { return }
    let slot = w.contents.slotOf(s.s1)
    if (slot < 0) { return }
    if (nodeIsNull(s.child2)) {
        w.contents.declare(slot, w.block, w.loopDepth, 0 as I64, 0 as I64)
        return
    }
    let init = ptr_to_node(s.child2)
    if (init.kind != NodeKind.ARRAY_LITERAL_EXPR) {
        w.contents.fail(slot)
        return
    }
    let mut lo = 2147483647 as I64
    let mut hi = (0 - 2147483647 - 1) as I64
    let mut p = init.child1
    while (nodeExists(p)) {
        if (nowrapInterval(w, f, p) == false) {
            w.contents.fail(slot)
            return
        }
        if (w.lo < lo) { lo = w.lo }
        if (w.hi > hi) { hi = w.hi }
        p = ptr_to_node(p).next
    }
    w.contents.declare(slot, w.block, w.loopDepth, lo, hi)
}

// A store into an array ir/contents.psm follows, with its value's form and how many
// times it can run in one lifetime of the array.
private fn nowrapStored(w: NowrapWalk, f: NowrapFacts, target: ASTNode, valuePtr: Ptr) {
    if (w.mode != NOWRAP_RECORD) { return }
    let slot = w.contents.slotOfIndex(target)
    if (slot < 0) { return }
    let form = nowrapForm(w, f, valuePtr, slot)
    w.contents.store(slot, form, nowrapExecutions(w, w.contents.depth[slot]))
}

// How many times the walk's point can run per run of a statement `depth` loops deep:
// the product of the counts of the loops between them, or -1.
private fn nowrapExecutions(w: NowrapWalk, depth: Int) -> I64 {
    let mut product = 1 as I64
    let mut k = depth
    while (k < w.loopDepth) {
        if (w.trips[k] < 0) { return (0 - 1) as I64 }
        product = product * (w.trips[k] as I64)
        if (product > 2147483647 as I64) { return (0 - 1) as I64 }
        k = k + 1
    }
    return product
}

// `x = x + e`, `x = e + x` or `x = x - e`: an update of the counter `x`.
internal fn nowrapIsUpdate(s: ASTNode) -> Bool {
    let name = ptr_to_node(s.child1).s1
    if (nodeIsNull(s.child2)) { return false }
    let rhs = ptr_to_node(s.child2)
    if (rhs.kind != NodeKind.BINARY_EXPR) { return false }
    if (rangeIsNamed(rhs.child1, name)) { return rhs.s1.equals("+") or rhs.s1.equals("-") }
    return rhs.s1.equals("+") and rangeIsNamed(rhs.child2, name)
}

// An update's own sum is marked like any bounded one, except inside a loop where
// some subscript combines the counter without a mark.
private fn nowrapUpdate(w: NowrapWalk, f: NowrapFacts, s: ASTNode) {
    let rhs = ptr_to_node(s.child2)
    nowrapExpr(w, f, rhs.child1)
    nowrapExpr(w, f, rhs.child2)
    if (w.mode != NOWRAP_MARK or w.isBlocked(ptr_to_node(s.child1).s1)) { return }
    nowrapArith(w, f, rhs)
}

impl NowrapWalk {
    private fn isBlocked(self, name: String) -> Bool {
        for i in 0..<self.blockedNames.length {
            let known: String = self.blockedNames[i]
            if (known.equals(name)) {
                for k in 0..<self.loopDepth {
                    if (self.loops[k] == self.blockedLoops[i]) { return true }
                }
            }
        }
        return false
    }
}


impl NowrapWalk {
    private fn block(self, name: String) {
        for k in 0..<self.loopDepth {
            self.blockedNames.push(name.clone())
            self.blockedLoops.push(self.loops[k])
        }
    }
}


private fn nowrapIf(w: NowrapWalk, f: NowrapFacts, s: ASTNode) {
    let taken = f.copy()
    w.leaf = 0
    nowrapCondition(w, taken, s.child1, nowrapNoCounter())
    // The condition's second walk records no call: each was recorded on the first,
    // which saw a call right of `and` with the left conjunct's facts as well, and a
    // call recorded twice is one ir/param_ranges.psm cannot match to the module.
    let quiet = w.quiet
    w.quiet = true
    nowrapExpr(w, f, s.child1)
    w.quiet = quiet
    nowrapConditionFalse(w, f, s.child1)
    nowrapBlock(w, taken, s.child2)
    if (nodeExists(s.child3)) {
        if (ptr_to_node(s.child3).kind == NodeKind.IF_STATEMENT) {
            nowrapStmt(w, f, s.child3)
        } else {
            nowrapBlock(w, f, s.child3)
        }
    }
    f.joinFrom(taken)
}

// Every arm from the facts after the scrutinee, without what its pattern binds,
// and the path no arm takes.
private fn nowrapMatch(w: NowrapWalk, f: NowrapFacts, s: ASTNode) {
    nowrapExpr(w, f, s.child1)
    let entry = f.copy()
    let mut arm = s.child2
    while (nodeExists(arm)) {
        let a = ptr_to_node(arm)
        let inside = entry.copy()
        nowrapKillNames(inside, a.child1)
        nowrapBlock(w, inside, a.child2)
        f.joinFrom(inside)
        arm = a.next
    }
}

// A loop's head keeps only facts on names nothing in it assigns, which hold on every
// iteration; the body runs from the head with what its condition's accesses add,
// and the loop leaves with the head's facts.
private fn nowrapLoop(w: NowrapWalk, f: NowrapFacts, condPtr: Ptr, bodyPtr: Ptr, loopStmt: ASTNode) {
    let counter = nowrapCounter(w, f, condPtr, bodyPtr)
    let residues = loopResidues(condPtr, bodyPtr)
    let entry = f.copy()
    nowrapKillBound(f, condPtr)
    nowrapKillBound(f, bodyPtr)
    nowrapKeepResidues(f, entry, residues)
    let invariants = nowrapInvariants(w, f, entry, condPtr, bodyPtr, counter)
    // Without a `break` the loop leaves only from its head, where the invariants hold
    // and the condition is false. A `break` leaves from inside the body.
    let leavesAtHead = nowrapHasBreak(bodyPtr) == false
    if (leavesAtHead) { nowrapApply(f, invariants) }
    let mut trips = 0 - 1
    if (counter.trips >= 0 as I64 and counter.trips <= 2147483647 as I64) { trips = counter.trips as Int }
    if (w.loopDepth < w.loops.length) {
        w.loops[w.loopDepth] = w.loopCount
        w.trips[w.loopDepth] = trips
    } else {
        w.loops.push(w.loopCount)
        w.trips.push(trips)
    }
    w.loopDepth = w.loopDepth + 1
    w.loopCount = w.loopCount + 1
    let inside = f.copy()
    if (leavesAtHead == false) { nowrapApply(inside, invariants) }
    w.leaf = 0
    nowrapCondition(w, inside, condPtr, counter)
    nowrapBlock(w, inside, bodyPtr)
    w.loopDepth = w.loopDepth - 1
    if (leavesAtHead) { nowrapConditionFalse(w, f, condPtr) }
}

// Where `for i in a..<b` (or `a..b`) keeps `i`, into w.lo/w.hi, when the facts bound both
// ends. The loop counts up from `a` while `i < b`, or down while `i > b` when `a` is
// above `b` (generateFor picks the direction at run time when it is not known here),
// and a step only skips values, so `i` lies between the ends, the excluded one left out
// on either side it can be.
private fn nowrapForRange(w: NowrapWalk, f: NowrapFacts, s: ASTNode) -> Bool {
    if (nodeIsNull(s.child1) or nodeIsNull(s.child2) or s.s2.equals("") == false) { return false }
    if (nowrapInterval(w, f, s.child1) == false) { return false }
    let startLo = w.lo
    let startHi = w.hi
    if (nowrapInterval(w, f, s.child2) == false) { return false }
    let mut endLo = w.lo
    let mut endHi = w.hi
    if (s.i1 != 1) {
        endLo = endLo + 1 as I64
        endHi = endHi - 1 as I64
    }
    w.lo = nowrapLower(startLo, endLo)
    w.hi = nowrapHigher(startHi, endHi)
    return true
}

private fn nowrapApply(f: NowrapFacts, facts: NowrapFacts) {
    for i in 0..<facts.names.length {
        let name: String = facts.names[i]
        f.set(name, facts.los[i], facts.his[i])
    }
}

// ---------------------------------------------------------------------------
// Loop invariants
// ---------------------------------------------------------------------------

// The names a loop assigns that are worth a guess: locals of a fact type with a fact
// where the loop starts, each with its type's range and its current guess.
struct NowrapCandidates {
    names: Vec<String>,
    typeLos: Vec<I64>,
    typeHis: Vec<I64>,
    los: Vec<I64>,
    his: Vec<I64>,
    live: Vec<Bool>
}

// Facts on names the loop assigns that hold at its head on every iteration. A guess
// starts from the facts at entry and is widened by what one probe of the body puts at
// its end, until a probe puts nothing outside it: then it is inductive, and true at
// the head whichever iteration it is. From the third round a bound that still moves
// jumps to the next of the name's thresholds -- a literal the loop compares it with,
// one either side of that, or its own entry bound -- or to its type's edge: the
// widening with thresholds of abstract interpretation (Blanchet et al., PLDI 2003).
// Thresholds of the name's own, because any literal in the loop would let a guess
// creep a step a round: bytecode_interpreter's `pc` against its opcode tests. Binary search is the case: `hi = mid` and `lo = mid + 1` under
// `lo < hi` keep both in [0, 4096] only as a pair, which no single assignment shows.
//
// A `continue` is a way back to the head the walk does not follow, so a loop with one
// anywhere inside gets no invariants.
private fn nowrapInvariants(w: NowrapWalk, f: NowrapFacts, entry: NowrapFacts, condPtr: Ptr,
                            bodyPtr: Ptr, counter: NowrapCounter) -> NowrapFacts {
    let found = nowrapFactsNew()
    if (nodeIsNull(bodyPtr) or nowrapHasContinue(bodyPtr)) { return found }
    let c = NowrapCandidates { names: [], typeLos: [], typeHis: [], los: [], his: [], live: [] }
    nowrapCollectCandidates(c, f, entry, condPtr)
    nowrapCollectCandidates(c, f, entry, bodyPtr)
    if (c.names.length == 0) { return found }
    let th = NowrapThresholds { names: [], values: [] }
    nowrapCollectThresholds(th, c, condPtr)
    nowrapCollectThresholds(th, c, bodyPtr)
    for i in 0..<c.names.length {
        let name: String = c.names[i]
        th.add(name, c.los[i])
        th.add(name, c.his[i])
    }
    for round in 0..<NOWRAP_INVARIANT_ROUNDS {
        if (w.probes >= NOWRAP_PROBE_BUDGET) { return found }
        let back = nowrapProbe(w, f, c, condPtr, bodyPtr, counter)
        if (nowrapSettles(c, back, round, th)) {
            for i in 0..<c.names.length {
                if (c.live[i]) {
                    let name: String = c.names[i]
                    found.set(name, c.los[i], c.his[i])
                }
            }
            return found
        }
    }
    return found
}

// Folds one probe's end-of-body facts into the guesses; true when none moved.
private fn nowrapSettles(c: NowrapCandidates, back: NowrapFacts, round: Int, th: NowrapThresholds) -> Bool {
    // No path reaches the end of the body: nothing comes back to the head.
    if (back.live == false) { return true }
    let mut settled = true
    for i in 0..<c.names.length {
        if (c.live[i]) {
            let name: String = c.names[i]
            let at = back.find(name)
            if (at < 0) {
                c.live[i] = false
                settled = false
            } else {
                let mut lo = nowrapLower(c.los[i], back.los[at])
                let mut hi = nowrapHigher(c.his[i], back.his[at])
                if (lo < c.los[i] or hi > c.his[i]) {
                    settled = false
                    if (round >= NOWRAP_DROP_ROUND) { c.live[i] = false }
                    if (round >= NOWRAP_WIDEN_ROUND) {
                        if (lo < c.los[i]) { lo = th.widenDown(name, lo, c.typeLos[i]) }
                        if (hi > c.his[i]) { hi = th.widenUp(name, hi, c.typeHis[i]) }
                    }
                    c.los[i] = lo
                    c.his[i] = hi
                }
            }
        }
    }
    return settled
}

// One walk of the condition and body from the head's facts with the guesses added,
// returning the facts at the end of the body. Marks go to a pass of their own, and the
// walk's counters are put back, so the real walk that follows numbers loops and
// blocks as if no probe ran.
private fn nowrapProbe(w: NowrapWalk, f: NowrapFacts, c: NowrapCandidates, condPtr: Ptr,
                       bodyPtr: Ptr, counter: NowrapCounter) -> NowrapFacts {
    w.probes = w.probes + 1
    let mode = w.mode
    let pass = w.pass
    let loopCount = w.loopCount
    let blockCount = w.blockCount
    let leaf = w.leaf
    w.mode = NOWRAP_PROBE
    w.pass = ir_range_proof_new()
    let head = f.copy()
    for i in 0..<c.names.length {
        if (c.live[i]) {
            let name: String = c.names[i]
            head.set(name, c.los[i], c.his[i])
        }
    }
    w.leaf = 0
    nowrapCondition(w, head, condPtr, counter)
    nowrapBlock(w, head, bodyPtr)
    w.mode = mode
    w.pass = pass
    w.loopCount = loopCount
    w.blockCount = blockCount
    w.leaf = leaf
    return head
}

// Every local the subtree assigns that had a fact at entry and lost it at the head.
private fn nowrapCollectCandidates(c: NowrapCandidates, f: NowrapFacts, entry: NowrapFacts, nodePtr: Ptr) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.CLOSURE_EXPR) { return }
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
        let target = ptr_to_node(n.child1)
        let known = target.kind == NodeKind.IDENTIFIER_EXPR and nowrapHoldsFacts(target)
        if (known and f.find(target.s1) < 0 and nowrapCandidateOf(c, target.s1) < 0) {
            let at = entry.find(target.s1)
            if (at >= 0) {
                let t = nodeGetType(target)
                c.names.push(target.s1.clone())
                c.typeLos.push(nowrapTypeMin(t))
                c.typeHis.push(nowrapTypeMax(t))
                c.los.push(entry.los[at])
                c.his.push(entry.his[at])
                c.live.push(true)
            }
        }
    }
    let mut p = n.child1
    while (nodeExists(p)) {
        nowrapCollectCandidates(c, f, entry, p)
        p = ptr_to_node(p).next
    }
    let mut q = n.child2
    while (nodeExists(q)) {
        nowrapCollectCandidates(c, f, entry, q)
        q = ptr_to_node(q).next
    }
    let mut r = n.child3
    while (nodeExists(r)) {
        nowrapCollectCandidates(c, f, entry, r)
        r = ptr_to_node(r).next
    }
}

private fn nowrapCandidateOf(c: NowrapCandidates, name: String) -> Int {
    for i in 0..<c.names.length {
        let known: String = c.names[i]
        if (known.equals(name)) { return i }
    }
    return 0 - 1
}

// Values a guess may widen to, each a candidate's own.
struct NowrapThresholds {
    names: Vec<String>,
    values: Vec<I64>
}

impl NowrapThresholds {
    // `v` and one either side of it: `x < 7` stops `x` at 6, `x <= 7` at 7.
    private fn add(self, name: String, v: I64) {
        for d in 0..<3 {
            self.names.push(name.clone())
            self.values.push(v + (d - 1) as I64)
        }
    }
}


impl NowrapThresholds {
    // The largest of `name`'s thresholds at or below `lo`, or its type's edge.
    private fn widenDown(self, name: String, lo: I64, floor: I64) -> I64 {
        let mut best = floor
        for i in 0..<self.values.length {
            let known: String = self.names[i]
            let t: I64 = self.values[i]
            if (known.equals(name) and t <= lo and t > best) { best = t }
        }
        return best
    }
}


impl NowrapThresholds {
    // The smallest of `name`'s thresholds at or above `hi`, or its type's edge.
    private fn widenUp(self, name: String, hi: I64, ceiling: I64) -> I64 {
        let mut best = ceiling
        for i in 0..<self.values.length {
            let known: String = self.names[i]
            let t: I64 = self.values[i]
            if (known.equals(name) and t >= hi and t < best) { best = t }
        }
        return best
    }
}


// Every comparison in the subtree between a candidate and a literal.
private fn nowrapCollectThresholds(th: NowrapThresholds, c: NowrapCandidates, nodePtr: Ptr) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.BINARY_EXPR and nowrapComparison(n.s1, true).equals("") == false
        and nodeExists(n.child1) and nodeExists(n.child2)) {
        nowrapComparedThreshold(th, c, ptr_to_node(n.child1), ptr_to_node(n.child2))
        nowrapComparedThreshold(th, c, ptr_to_node(n.child2), ptr_to_node(n.child1))
    }
    let mut p = n.child1
    while (nodeExists(p)) {
        nowrapCollectThresholds(th, c, p)
        p = ptr_to_node(p).next
    }
    let mut q = n.child2
    while (nodeExists(q)) {
        nowrapCollectThresholds(th, c, q)
        q = ptr_to_node(q).next
    }
    let mut r = n.child3
    while (nodeExists(r)) {
        nowrapCollectThresholds(th, c, r)
        r = ptr_to_node(r).next
    }
}

private fn nowrapComparedThreshold(th: NowrapThresholds, c: NowrapCandidates, name: ASTNode, other: ASTNode) {
    if (name.kind != NodeKind.IDENTIFIER_EXPR or nowrapCandidateOf(c, name.s1) < 0) { return }
    let literal = nowrapLiteral(other)
    if (literal >= 0) { th.add(name.s1, literal as I64) }
    let negative = nowrapNegativeLiteral(other)
    if (negative < 0 as I64) { th.add(name.s1, negative) }
}

// Whether the subtree holds a `break`, which may be this loop's: a labelled one in a
// nested loop can leave it too.
private fn nowrapHasBreak(nodePtr: Ptr) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.BREAK_STATEMENT) { return true }
    return nowrapChainHasBreak(n.child1) or nowrapChainHasBreak(n.child2)
           or nowrapChainHasBreak(n.child3)
}

private fn nowrapChainHasBreak(head: Ptr) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        if (nowrapHasBreak(p)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

// What the head keeps of the names the loop assigns only remainders: each one's range
// where the loop was entered, widened to the remainder's.
private fn nowrapKeepResidues(f: NowrapFacts, entry: NowrapFacts, residues: LoopResidues) {
    let range = residueRangeNew()
    for i in 0..<residues.names.length {
        let name: String = residues.names[i]
        let at = entry.find(name)
        if (at >= 0 and residues.headRange(name, entry.los[at], entry.his[at], range)) {
            f.set(name, range.lo, range.hi)
        }
    }
}

// The facts that hold when a condition is true: every `and` conjunct ran. A counted
// loop's counter is bounded from its bounding conjunct on, not before it: a conjunct
// ahead of that one also runs on the last check, with the counter past the bound.
private fn nowrapCondition(w: NowrapWalk, f: NowrapFacts, condPtr: Ptr, counter: NowrapCounter) {
    if (nodeIsNull(condPtr)) { return }
    let c = ptr_to_node(condPtr)
    if (c.kind == NodeKind.BINARY_EXPR and c.s1.equals("and")) {
        nowrapCondition(w, f, c.child1, counter)
        nowrapCondition(w, f, c.child2, counter)
        return
    }
    nowrapExpr(w, f, condPtr)
    nowrapRefine(w, f, c, true)
    if (w.leaf == counter.conjunct) { f.set(counter.name, counter.lo, counter.hi) }
    w.leaf = w.leaf + 1
}

// The facts on the path where `cond` is false: every `or` disjunct was.
private fn nowrapConditionFalse(w: NowrapWalk, f: NowrapFacts, condPtr: Ptr) {
    if (nodeIsNull(condPtr)) { return }
    let c = ptr_to_node(condPtr)
    if (c.kind == NodeKind.BINARY_EXPR and c.s1.equals("or")) {
        nowrapConditionFalse(w, f, c.child1)
        nowrapConditionFalse(w, f, c.child2)
        return
    }
    nowrapRefine(w, f, c, false)
}

// Narrows the locals a comparison names to what it being `holds` leaves them: for
// `a < b`, `a` below `b`'s largest value and `b` above `a`'s smallest. An operand with
// no fact is anything its type holds. Binary search's `while (lo < hi)` is what puts
// its `mid` inside the table.
private fn nowrapRefine(w: NowrapWalk, f: NowrapFacts, c: ASTNode, holds: Bool) {
    if (c.kind != NodeKind.BINARY_EXPR or nodeIsNull(c.child1) or nodeIsNull(c.child2)) { return }
    let op = nowrapComparison(c.s1, holds)
    if (op.equals("")) { return }
    let a = ptr_to_node(c.child1)
    let b = ptr_to_node(c.child2)
    if (nowrapOperandRange(w, f, a) == false) { return }
    let aLo = w.lo
    let aHi = w.hi
    if (nowrapOperandRange(w, f, b) == false) { return }
    let bLo = w.lo
    let bHi = w.hi
    if (op.equals("<")) {
        nowrapNarrowName(f, a, aLo, bHi - 1 as I64)
        nowrapNarrowName(f, b, aLo + 1 as I64, bHi)
    } else if (op.equals("<=")) {
        nowrapNarrowName(f, a, aLo, bHi)
        nowrapNarrowName(f, b, aLo, bHi)
    } else if (op.equals(">")) {
        nowrapNarrowName(f, a, bLo + 1 as I64, aHi)
        nowrapNarrowName(f, b, bLo, aHi - 1 as I64)
    } else if (op.equals(">=")) {
        nowrapNarrowName(f, a, bLo, aHi)
        nowrapNarrowName(f, b, bLo, aHi)
    } else if (op.equals("==")) {
        nowrapNarrowName(f, a, bLo, bHi)
        nowrapNarrowName(f, b, aLo, aHi)
    } else {
        // `!=` says something only of an interval whose edge is the other side's one value.
        if (bLo == bHi) { nowrapNarrowName(f, a, nowrapPastEdge(aLo, bLo, 1), nowrapPastEdge(aHi, bLo, 0 - 1)) }
        if (aLo == aHi) { nowrapNarrowName(f, b, nowrapPastEdge(bLo, aLo, 1), nowrapPastEdge(bHi, aLo, 0 - 1)) }
    }
}

// `edge`, moved one step by `step` when it is the excluded value.
private fn nowrapPastEdge(edge: I64, excluded: I64, step: Int) -> I64 {
    if (edge == excluded) { return edge + step as I64 }
    return edge
}

// The comparison `op` is, or its negation when it does not hold; "" for anything else.
private fn nowrapComparison(op: String, holds: Bool) -> String {
    if (holds) {
        if (op.equals("<") or op.equals("<=") or op.equals(">") or op.equals(">=")
            or op.equals("==") or op.equals("!=")) { return op }
        return ""
    }
    if (op.equals("<")) { return ">=" }
    if (op.equals("<=")) { return ">" }
    if (op.equals(">")) { return "<=" }
    if (op.equals(">=")) { return "<" }
    if (op.equals("==")) { return "!=" }
    if (op.equals("!=")) { return "==" }
    return ""
}

// What a comparison operand can be, into w.lo/w.hi: its interval, or for a local of a
// fact type with none, its whole type.
private fn nowrapOperandRange(w: NowrapWalk, f: NowrapFacts, n: ASTNode) -> Bool {
    if (nowrapInterval(w, f, node_to_ptr(n))) { return true }
    if (n.kind != NodeKind.IDENTIFIER_EXPR or nowrapHoldsFacts(n) == false) { return false }
    w.lo = nowrapTypeMin(nodeGetType(n))
    w.hi = nowrapTypeMax(nodeGetType(n))
    return true
}

// Narrows a local operand's fact to [lo, hi] within its type; anything else is left.
private fn nowrapNarrowName(f: NowrapFacts, n: ASTNode, lo: I64, hi: I64) {
    if (n.kind != NodeKind.IDENTIFIER_EXPR or nowrapHoldsFacts(n) == false) { return }
    let t = nodeGetType(n)
    let mut low = lo
    let mut high = hi
    if (low < nowrapTypeMin(t)) { low = nowrapTypeMin(t) }
    if (high > nowrapTypeMax(t)) { high = nowrapTypeMax(t) }
    f.narrow(n.s1, low, high)
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

private fn nowrapExprChain(w: NowrapWalk, f: NowrapFacts, head: Ptr) {
    let mut p = head
    while (nodeExists(p)) {
        nowrapExpr(w, f, p)
        p = ptr_to_node(p).next
    }
}

// One expression in evaluation order. Facts come only from accesses that ran before
// the point, so the part of an expression that may not run -- the right of `and`,
// `or` and `??` -- is read from a copy.
private fn nowrapExpr(w: NowrapWalk, f: NowrapFacts, exprPtr: Ptr) {
    if (nodeIsNull(exprPtr)) { return }
    let e = ptr_to_node(exprPtr)
    match (e.kind) {
        NodeKind.LITERAL_EXPR => { return }
        NodeKind.IDENTIFIER_EXPR => { return }
        NodeKind.NONE_LITERAL_EXPR => { return }
        NodeKind.CLOSURE_EXPR => { return }
        NodeKind.BINARY_EXPR => {
            nowrapExpr(w, f, e.child1)
            if (e.s1.equals("and") or e.s1.equals("or")) {
                let maybe = f.copy()
                nowrapExpr(w, maybe, e.child2)
                return
            }
            nowrapExpr(w, f, e.child2)
            nowrapArith(w, f, e)
            nowrapMarkRemainder(w, f, e)
            return
        }
        NodeKind.INDEX_EXPR => {
            nowrapExpr(w, f, e.child1)
            nowrapExpr(w, f, e.child2)
            if (nowrapIsUnchecked(e)) {
                nowrapSubscript(w, f, e)
                nowrapMarkInRange(w, f, e)
                nowrapAccessed(f, e)
            }
            return
        }
        NodeKind.CALL_EXPR => {
            nowrapExpr(w, f, e.child1)
            if (irCallIsCoalesce(e) and nodeExists(e.child2)) {
                nowrapExpr(w, f, e.child2)
                let maybe = f.copy()
                nowrapExprChain(w, maybe, ptr_to_node(e.child2).next)
                return
            }
            nowrapExprChain(w, f, e.child2)
            nowrapRecordCall(w, f, e)
            // A list subscript is an address too: one left unmarked keeps its
            // counters' updates plain, as an array's does.
            if (w.mode == NOWRAP_RECORD and rangeIsAccess(e)) {
                w.blockUnmarked(rangeAccessIndex(e))
            }
            return
        }
        NodeKind.UNARY_EXPR => {
            nowrapExpr(w, f, e.child1)
            return
        }
        NodeKind.CAST_EXPR => {
            nowrapExpr(w, f, e.child1)
            return
        }
        NodeKind.MEMBER_ACCESS_EXPR => {
            nowrapExpr(w, f, e.child1)
            return
        }
    }
    let inside = f.copy()
    nowrapExprChain(w, inside, e.child1)
    nowrapExprChain(w, inside, e.child2)
    nowrapExprChain(w, inside, e.child3)
}

// A call to a watched function by its plain name, with the interval of each argument.
// Any other form -- a method call, a coalesce -- goes unrecorded, and an unrecorded call
// is one ir/param_ranges.psm counts against the function.
private fn nowrapRecordCall(w: NowrapWalk, f: NowrapFacts, e: ASTNode) {
    if (w.mode != NOWRAP_RECORD or w.quiet or w.calls.watched.length == 0) { return }
    if (nodeIsNull(e.child1) or ptr_to_node(e.child1).kind != NodeKind.IDENTIFIER_EXPR) { return }
    if (w.calls.watches(e.s2) == false) { return }
    w.calls.seen.push(e.s2.clone())
    let mut index = 0
    let mut p = e.child2
    while (nodeExists(p)) {
        w.calls.symbols.push(e.s2.clone())
        w.calls.indices.push(index)
        if (nowrapInterval(w, f, p)) {
            w.calls.los.push(w.lo)
            w.calls.his.push(w.hi)
        } else {
            w.calls.los.push(1 as I64)
            w.calls.his.push(0 as I64)
        }
        index = index + 1
        p = ptr_to_node(p).next
    }
}

// An element access no check stands in front of: a fixed array's or a view's.
private fn nowrapIsUnchecked(e: ASTNode) -> Bool {
    if (nodeIsNull(e.child1) or nodeIsNull(e.child2)) { return false }
    let base = ptr_to_node(e.child1)
    if (nodeHasType(base) == false) { return false }
    return nodeGetType(base).kind == TypeKind.ARRAY
}

// The largest index an access to `e`'s array can have run with.
private fn nowrapLastIndex(e: ASTNode) -> I64 {
    let length = nodeGetType(ptr_to_node(e.child1)).length
    if (length > 0) { return (length - 1) as I64 }
    return (2147483647 - 1) as I64
}

// A fixed array's access whose subscript the facts already put inside it needs no
// bounds check (generateArrayIndexCheck). Outside a loop the range prover versions
// this is the only proof an index gets; binary_search's `table[mid]` and
// edit_distance's rows are the cases. The mark sits on the INDEX_EXPR, which no
// `+`/`-` mark shares.
private fn nowrapMarkInRange(w: NowrapWalk, f: NowrapFacts, e: ASTNode) {
    if (w.mode != NOWRAP_MARK) { return }
    if (nodeGetType(ptr_to_node(e.child1)).length <= 0) { return }
    if (nowrapInterval(w, f, e.child2) == false) { return }
    if (w.lo < 0 as I64 or w.hi > nowrapLastIndex(e)) { return }
    ir_nowrap_mark(node_to_ptr(e), w.pass)
}

// Whether the active pass proved this fixed array access in range.
internal fn nowrapIndexInRange(access: ASTNode) -> Bool {
    if (irNowrapPass == 0) { return false }
    return ir_nowrap_of(node_to_ptr(access)) == irNowrapPass
}

// What an access that ran says of its subscript: a name, or a name plus or minus
// a literal, was inside the array.
private fn nowrapAccessed(f: NowrapFacts, e: ASTNode) {
    let last = nowrapLastIndex(e)
    let mut sub = ptr_to_node(e.child2)
    // `x as Int` that was in range was `x`, whatever integer type `x` has: a value past
    // `Int` would have converted to a negative index.
    if (sub.kind == NodeKind.CAST_EXPR and nodeExists(sub.child1)) {
        let inner = ptr_to_node(sub.child1)
        if (inner.kind == NodeKind.IDENTIFIER_EXPR and nowrapHoldsFacts(inner)) {
            f.narrow(inner.s1, 0 as I64, last)
        }
        return
    }
    if (sub.kind == NodeKind.IDENTIFIER_EXPR) {
        if (nowrapIsIntName(sub)) { f.narrow(sub.s1, 0 as I64, last) }
        return
    }
    if (sub.kind != NodeKind.BINARY_EXPR or nowrapIsIntName(sub) == false) { return }
    let k = nowrapLiteral(ptr_to_node(sub.child2))
    if (k < 0) { return }
    let name = ptr_to_node(sub.child1)
    if (name.kind != NodeKind.IDENTIFIER_EXPR or nowrapIsIntName(name) == false) { return }
    let shift = k as I64
    // A `name + k` that wrapped is negative, so out of range. A `name - k` that
    // wrapped is in [Int.MAX - k + 1, Int.MAX], which a view's indices reach once
    // k is 2: the access then ran with `name` near Int.MIN.
    if (sub.s1.equals("+")) { f.narrow(name.s1, 0 - shift, last - shift) }
    if (sub.s1.equals("-") and last + shift <= 2147483647 as I64) {
        f.narrow(name.s1, shift, last + shift)
    }
}

// A subscript's own `+`/`-`: marked when its left operand -- either operand of a
// `+` -- is known non-negative, since then only an upward wrap is possible and it
// lands out of range. Any sum in the subscript left plain blocks its counters'
// updates in every loop around it.
private fn nowrapSubscript(w: NowrapWalk, f: NowrapFacts, e: ASTNode) {
    let sub = ptr_to_node(e.child2)
    if (nowrapIsSum(sub) and ir_nowrap_marked(e.child2) != w.pass) {
        let leftSafe = nowrapInterval(w, f, sub.child1) and w.lo >= 0 as I64
        let rightSafe = nowrapInterval(w, f, sub.child2) and w.lo >= 0 as I64
        if (leftSafe or (sub.s1.equals("+") and rightSafe)) {
            ir_nowrap_mark(e.child2, w.pass)
        }
    }
    if (w.mode == NOWRAP_RECORD) { w.blockUnmarked(e.child2) }
}

// A signed `Int` `+` or `-`, the two this marks.
private fn nowrapIsSum(n: ASTNode) -> Bool {
    if (n.kind != NodeKind.BINARY_EXPR) { return false }
    if (n.s1.equals("+") == false and n.s1.equals("-") == false) { return false }
    return nowrapIsIntName(n)
}

impl NowrapWalk {
    // Blocks the names every unmarked sum in an address combines directly.
    private fn blockUnmarked(self, nodePtr: Ptr) {
        if (nodeIsNull(nodePtr)) { return }
        let n = ptr_to_node(nodePtr)
        if (n.kind != NodeKind.BINARY_EXPR) { return }
        if (nowrapIsSum(n) and ir_nowrap_marked(nodePtr) != self.pass) {
            let left = ptr_to_node(n.child1)
            let right = ptr_to_node(n.child2)
            if (left.kind == NodeKind.IDENTIFIER_EXPR) { self.block(left.s1) }
            if (right.kind == NodeKind.IDENTIFIER_EXPR) { self.block(right.s1) }
        }
        self.blockUnmarked(n.child1)
        self.blockUnmarked(n.child2)
    }
}

// A `+`/`-` whose operands the facts bound, with an exact result inside `Int`.
private fn nowrapArith(w: NowrapWalk, f: NowrapFacts, e: ASTNode) {
    if (nowrapIsSum(e) == false) { return }
    if (nowrapInterval(w, f, node_to_ptr(e))) { ir_nowrap_mark(node_to_ptr(e), w.pass) }
}

// The interval an `Int` expression takes here, into w.lo/w.hi, when the facts and
// literals bound it and nothing in it can wrap.
internal fn nowrapInterval(w: NowrapWalk, f: NowrapFacts, exprPtr: Ptr) -> Bool {
    if (nodeIsNull(exprPtr)) { return false }
    let e = ptr_to_node(exprPtr)
    let literal = nowrapLiteral(e)
    if (literal >= 0) {
        w.lo = literal as I64
        w.hi = literal as I64
        return true
    }
    let negative = nowrapNegativeLiteral(e)
    if (negative < 0 as I64) {
        w.lo = negative
        w.hi = negative
        return true
    }
    if (e.kind == NodeKind.UNARY_EXPR and e.s1.equals("-") and nodeExists(e.child1)) {
        let negated = nowrapLiteral(ptr_to_node(e.child1))
        if (negated < 0) { return false }
        w.lo = 0 - (negated as I64)
        w.hi = w.lo
        return true
    }
    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        if (nowrapHoldsFacts(e) == false) { return false }
        let at = f.find(e.s1)
        if (at < 0) { return false }
        w.lo = f.los[at]
        w.hi = f.his[at]
        return true
    }
    if (e.kind == NodeKind.INDEX_EXPR) {
        if (nowrapLiteralElement(w, f, e)) { return true }
        let slot = w.contents.slotOfIndex(e)
        if (w.contents.bounded(slot) == false) { return false }
        w.lo = w.contents.lo[slot] as I64
        w.hi = w.contents.hi[slot] as I64
        return true
    }
    if (e.kind == NodeKind.CAST_EXPR) { return nowrapCastInterval(w, f, e) }
    if (e.kind != NodeKind.BINARY_EXPR or nowrapIsFactType(e) == false) { return false }
    let divisor = remainderDivisor(e)
    if (divisor > 0) { return nowrapRemainder(w, f, e, divisor) }
    if (e.s1.equals("%")) { return nowrapUnsignedRemainder(w, f, e) }
    if (e.s1.equals(">>")) { return nowrapShiftRight(w, f, e) }
    if (e.s1.equals("&")) { return nowrapMask(w, f, e) }
    if (e.s1.equals("/")) { return nowrapQuotient(w, f, e) }
    if (e.s1.equals("+") == false and e.s1.equals("-") == false and e.s1.equals("*") == false) {
        return false
    }
    if (nowrapInterval(w, f, e.child1) == false) { return false }
    let aLo = w.lo
    let aHi = w.hi
    if (nowrapInterval(w, f, e.child2) == false) { return false }
    if (e.s1.equals("+")) {
        w.lo = aLo + w.lo
        w.hi = aHi + w.hi
    } else if (e.s1.equals("-")) {
        let bLo = w.lo
        w.lo = aLo - w.hi
        w.hi = aHi - bLo
    } else {
        // Every factor is inside 32 bits, so each corner product is inside an i64.
        let bLo = w.lo
        let bHi = w.hi
        let p1 = aLo * bLo
        let p2 = aLo * bHi
        let p3 = aHi * bLo
        let p4 = aHi * bHi
        w.lo = nowrapLower(nowrapLower(p1, p2), nowrapLower(p3, p4))
        w.hi = nowrapHigher(nowrapHigher(p1, p2), nowrapHigher(p3, p4))
    }
    return nowrapFitsType(w.lo, w.hi, nodeGetType(e))
}

// `a / d` with every divisor above zero: truncation is monotone in `a` and shrinks the
// magnitude as `d` grows, so the corners bound it, and no positive divisor overflows.
// Heapsort's `start = (2048 - 2) / 2` is the entry bound its loop invariant needs.
private fn nowrapQuotient(w: NowrapWalk, f: NowrapFacts, e: ASTNode) -> Bool {
    if (nowrapInterval(w, f, e.child2) == false or w.lo < 1 as I64) { return false }
    let dLo = w.lo
    let dHi = w.hi
    if (nowrapInterval(w, f, e.child1) == false) { return false }
    let aLo = w.lo
    let aHi = w.hi
    w.lo = nowrapLower(aLo / dLo, aLo / dHi)
    w.hi = nowrapHigher(aHi / dLo, aHi / dHi)
    return nowrapFitsType(w.lo, w.hi, nodeGetType(e))
}

private fn nowrapLower(a: I64, b: I64) -> I64 {
    if (a < b) { return a }
    return b
}

private fn nowrapHigher(a: I64, b: I64) -> I64 {
    if (a > b) { return a }
    return b
}

// `x as T` between integer types: the value is unchanged whenever it fits `T`, whether
// the conversion truncates, extends or reinterprets.
private fn nowrapCastInterval(w: NowrapWalk, f: NowrapFacts, e: ASTNode) -> Bool {
    if (nodeIsNull(e.child1) or nowrapIsFactType(e) == false) { return false }
    if (nowrapIsFactType(ptr_to_node(e.child1)) == false) { return false }
    if (nowrapInterval(w, f, e.child1) == false) { return false }
    return nowrapFitsType(w.lo, w.hi, nodeGetType(e))
}

// An unsigned `x % m`, `m` a literal or bounded above zero: below the largest `m`, and no
// larger than `x`.
private fn nowrapUnsignedRemainder(w: NowrapWalk, f: NowrapFacts, e: ASTNode) -> Bool {
    if (nowrapIsUnsigned(nodeGetType(e)) == false) { return false }
    if (nowrapInterval(w, f, e.child2) == false or w.lo < 1 as I64) { return false }
    let bound = w.hi - 1 as I64
    if (nowrapInterval(w, f, e.child1) and w.hi <= bound) { return true }
    w.lo = 0 as I64
    w.hi = bound
    return true
}

// `x >> k` by a literal, on an `x` the facts put at zero or above: logical and
// arithmetic shifts agree there, and the result is monotonic in `x`.
private fn nowrapShiftRight(w: NowrapWalk, f: NowrapFacts, e: ASTNode) -> Bool {
    let k = nowrapLiteral(ptr_to_node(e.child2))
    if (k < 0 or k > 31) { return false }
    if (nowrapInterval(w, f, e.child1) == false or w.lo < 0 as I64) { return false }
    let mut divisor = 1 as I64
    for _ in 0..<k { divisor = divisor * (2 as I64) }
    w.lo = w.lo / divisor
    w.hi = w.hi / divisor
    return true
}

// `x & m` with a literal `m` at zero or above, either way round: in [0, m] whatever `x`
// is, and no larger than an `x` known to be at zero or above.
private fn nowrapMask(w: NowrapWalk, f: NowrapFacts, e: ASTNode) -> Bool {
    let mut m = nowrapLiteral(ptr_to_node(e.child2))
    let mut other = e.child1
    if (m < 0) {
        m = nowrapLiteral(ptr_to_node(e.child1))
        other = e.child2
    }
    if (m < 0) { return false }
    let bound = m as I64
    if (nowrapInterval(w, f, other) and w.lo >= 0 as I64 and w.hi <= bound) {
        w.lo = 0 as I64
        return true
    }
    w.lo = 0 as I64
    w.hi = bound
    return true
}

// A remainder by `m`: inside (-m, m) with the dividend's sign, whether or not the
// facts bound the dividend (ir/residues.psm), and no wider than a bounded one.
private fn nowrapRemainder(w: NowrapWalk, f: NowrapFacts, e: ASTNode, m: Int) -> Bool {
    let bound = (m - 1) as I64
    if (nowrapInterval(w, f, e.child1) == false) {
        w.lo = 0 - bound
        w.hi = bound
        return true
    }
    if (w.lo >= 0 as I64) {
        w.lo = 0 as I64
    } else if (w.lo < 0 - bound) {
        w.lo = 0 - bound
    }
    if (w.hi <= 0 as I64) {
        w.hi = 0 as I64
    } else if (w.hi > bound) {
        w.hi = bound
    }
    return true
}

// A `%` by a literal whose dividend the facts bound tightly enough to drop the
// remainder for a conditional add or subtract (ir/residues.psm).
private fn nowrapMarkRemainder(w: NowrapWalk, f: NowrapFacts, e: ASTNode) {
    if (w.mode != NOWRAP_MARK) { return }
    let m = remainderDivisor(e)
    if (m < 2 or nowrapInterval(w, f, e.child1) == false) { return }
    let form = remainderForm(w.lo, w.hi, m)
    if (form != REM_KEEP) { ir_rem_form_mark(node_to_ptr(e), w.pass, form) }
}

// The form the active pass gave a `%`, or REM_KEEP.
internal fn nowrapRemainderForm(expr: ASTNode) -> Int {
    if (irNowrapPass == 0) { return REM_KEEP }
    return ir_rem_form_of(node_to_ptr(expr), irNowrapPass)
}

// The form of a value stored into `slot`'s array (ir/contents.psm): an interval the
// facts give, an element of the array's family, or a sum, `min` or `max` of those.
private fn nowrapForm(w: NowrapWalk, f: NowrapFacts, exprPtr: Ptr, slot: Int) -> ContentForm {
    if (nodeIsNull(exprPtr)) { return contentFail() }
    if (nowrapInterval(w, f, exprPtr)) { return contentConst(w.lo, w.hi) }
    let e = ptr_to_node(exprPtr)
    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        let aliased = w.contents.slotOfAlias(e.s1)
        if (aliased < 0 or w.contents.family[aliased] != w.contents.family[slot]) { return contentFail() }
        w.contents.noteRead(slot, aliased)
        return contentRead()
    }
    if (e.kind == NodeKind.INDEX_EXPR) {
        let read = w.contents.slotOfIndex(e)
        if (read < 0 or w.contents.family[read] != w.contents.family[slot]) { return contentFail() }
        w.contents.noteRead(slot, read)
        return contentRead()
    }
    if (nowrapIsSum(e)) {
        let sum = contentSum(nowrapForm(w, f, e.child1, slot), nowrapForm(w, f, e.child2, slot),
                             e.s1.equals("-"))
        w.contents.noteSum(slot, sum)
        return sum
    }
    let which = nowrapMinMax(e)
    if (which == 0) { return contentFail() }
    let a = nowrapForm(w, f, e.child2, slot)
    let b = nowrapForm(w, f, ptr_to_node(e.child2).next, slot)
    if (which < 0) { return contentMin(a, b) }
    return contentMax(a, b)
}

// -1 for a two-operand call that answers the smaller operand, 1 for the larger,
// otherwise 0.
private fn nowrapMinMax(e: ASTNode) -> Int {
    if (e.kind != NodeKind.CALL_EXPR or nodeIsNull(e.child1) or nodeIsNull(e.child2)) { return 0 }
    let second = ptr_to_node(e.child2).next
    if (nodeIsNull(second) or nodeExists(ptr_to_node(second).next)) { return 0 }
    let callee = ptr_to_node(e.child1)
    if (callee.kind != NodeKind.IDENTIFIER_EXPR) { return 0 }
    if (callee.s1.equals("__builtin_min")) { return 0 - 1 }
    if (callee.s1.equals("__builtin_max")) { return 1 }
    // `min(a, b)` and `max(a, b)` are the public spellings, and what a program can
    // write: the builtin underneath is the standard library's own.
    if (callee.s1.equals("min") and nowrapIsStdMath(callee.s1)) { return 0 - 1 }
    if (callee.s1.equals("max") and nowrapIsStdMath(callee.s1)) { return 1 }
    return nowrapProgramSelection(callee.s1)
}

// A program's own `min` or `max`, judged by its body rather than its name. A
// freestanding program cannot import std.math and writes one; asking for the name
// cost edit_distance its element bound, and C's count (5.90M instructions to 5.60M).
// Every declaration of the name must make the same selection.
private fn nowrapProgramSelection(name: String) -> Int {
    let count = ir_decl_count(name)
    if (count == 0) { return 0 }
    let selection = nowrapSelection(ptr_to_node(ir_decl_at(name, 0)))
    for i in 1..<count {
        if (nowrapSelection(ptr_to_node(ir_decl_at(name, i))) != selection) { return 0 }
    }
    return selection
}

// -1 when `decl` is `fn f(a: Int, b: Int) -> Int` whose whole body returns the smaller
// of `a` and `b`, 1 when it returns the larger, otherwise 0. The body is one comparison
// of the two parameters and a `return` of each, in either of two shapes:
//
//     if (x < y) { return p } return q        if (x < y) { return p } else { return q }
//
// with `<`, `<=`, `>` or `>=`. Nothing else may run, so nothing can assign a parameter.
private fn nowrapSelection(decl: ASTNode) -> Int {
    if (decl.kind != NodeKind.FUNCTION or nodeIsNull(decl.child1) or nodeIsNull(decl.child2)) { return 0 }
    let first = ptr_to_node(decl.child1)
    if (nodeIsNull(first.next) or nodeExists(ptr_to_node(first.next).next)) { return 0 }
    let a = first.s1
    let b = ptr_to_node(first.next).s1
    let body = ptr_to_node(decl.child2)
    if (body.kind != NodeKind.BLOCK or nodeIsNull(body.child1)) { return 0 }
    let test = ptr_to_node(body.child1)
    if (test.kind != NodeKind.IF_STATEMENT or nodeIsNull(test.child1)) { return 0 }
    let taken = nowrapBlockReturns(test.child2)
    let mut other = ""
    if (nodeExists(test.child3)) {
        if (nodeExists(test.next)) { return 0 }
        other = nowrapBlockReturns(test.child3)
    } else {
        if (nodeIsNull(test.next) or nodeExists(ptr_to_node(test.next).next)) { return 0 }
        other = nowrapReturnedName(ptr_to_node(test.next))
    }
    if (nowrapIsPair(taken, other, a, b) == false) { return 0 }
    let cond = ptr_to_node(test.child1)
    if (cond.kind != NodeKind.BINARY_EXPR or nodeIsNull(cond.child1) or nodeIsNull(cond.child2)) { return 0 }
    let x = ptr_to_node(cond.child1)
    let y = ptr_to_node(cond.child2)
    if (x.kind != NodeKind.IDENTIFIER_EXPR or y.kind != NodeKind.IDENTIFIER_EXPR) { return 0 }
    if (nowrapIsIntName(x) == false or nowrapIsIntName(y) == false) { return 0 }
    if (nowrapIsPair(x.s1, y.s1, a, b) == false) { return 0 }
    let mut smaller = ""
    if (cond.s1.equals("<") or cond.s1.equals("<=")) {
        smaller = x.s1
    } else if (cond.s1.equals(">") or cond.s1.equals(">=")) {
        smaller = y.s1
    } else {
        return 0
    }
    if (taken.equals(smaller)) { return 0 - 1 }
    return 1
}

// The name a block's only statement returns, or "".
private fn nowrapBlockReturns(blockPtr: Ptr) -> String {
    if (nodeIsNull(blockPtr)) { return "" }
    let only = ptr_to_node(blockPtr).child1
    if (nodeIsNull(only) or nodeExists(ptr_to_node(only).next)) { return "" }
    return nowrapReturnedName(ptr_to_node(only))
}

// The name `return name` returns, or "".
private fn nowrapReturnedName(s: ASTNode) -> String {
    if (s.kind != NodeKind.RETURN_STATEMENT or nodeIsNull(s.child1)) { return "" }
    let value = ptr_to_node(s.child1)
    if (value.kind != NodeKind.IDENTIFIER_EXPR) { return "" }
    return value.s1
}

// Whether `p` and `q` are `a` and `b`, one each, in either order.
private fn nowrapIsPair(p: String, q: String, a: String, b: String) -> Bool {
    if (a.equals(b)) { return false }
    return (p.equals(a) and q.equals(b)) or (p.equals(b) and q.equals(a))
}

// Whether every function of this name is std.math's.
private fn nowrapIsStdMath(name: String) -> Bool {
    let count = ir_decl_count(name)
    if (count == 0) { return false }
    for i in 0..<count {
        let decl = ptr_to_node(ir_decl_at(name, i))
        if (decl.kind != NodeKind.FUNCTION) { return false }
        if (diag_file_module(decl.file).equals("std.math") == false) { return false }
    }
    return true
}

// A negative integer literal, which the parser folds from `-` and a number
// (foldNegativeLiteral in parse/expr.psm), or 0.
private fn nowrapNegativeLiteral(n: ASTNode) -> I64 {
    if (n.kind != NodeKind.LITERAL_EXPR or n.i1 != TokenType.NUMBER_LITERAL as Int) { return 0 as I64 }
    if (n.s1.startsWith("-") == false) { return 0 as I64 }
    if (n.s1.length > NOWRAP_LITERAL_DIGITS + 1) { return 0 as I64 }
    let value = n.s1.parseIntOr(0)
    if (value >= 0 or value != n.s1.parseIntOr(1)) { return 0 as I64 }
    return value as I64
}

// A non-negative integer literal of at most NOWRAP_LITERAL_DIGITS digits, or -1.
internal fn nowrapLiteral(n: ASTNode) -> Int {
    if (n.kind != NodeKind.LITERAL_EXPR) { return 0 - 1 }
    if (n.i1 != TokenType.NUMBER_LITERAL as Int) { return 0 - 1 }
    if (n.s1.length > NOWRAP_LITERAL_DIGITS) { return 0 - 1 }
    let value = n.s1.parseIntOr(0 - 1)
    if (value != n.s1.parseIntOr(0 - 2)) { return 0 - 1 }
    return value
}

// An integer type of at most 32 bits, whose every value an i64 holds with room for a
// sum or product of two: the types a fact can describe.
internal fn nowrapIsFactType(n: ASTNode) -> Bool {
    if (nodeHasType(n) == false) { return false }
    return nowrapTypeBits(nodeGetType(n)) > 0
}

// The width of `t` if it is one of those types, or 0.
internal fn nowrapTypeBits(t: TypeInfo) -> Int {
    if (t.kind != TypeKind.INT) { return 0 }
    if (t.name.equals("Int") or t.name.equals("U32")) { return 32 }
    if (t.name.equals("I16") or t.name.equals("U16")) { return 16 }
    if (t.name.equals("I8") or t.name.equals("U8")) { return 8 }
    return 0
}

private fn nowrapIsUnsigned(t: TypeInfo) -> Bool {
    return t.name.startsWith("U")
}

// The smallest and largest value of `t`, one of the fact types.
internal fn nowrapTypeMin(t: TypeInfo) -> I64 {
    if (nowrapIsUnsigned(t)) { return 0 as I64 }
    return 0 - nowrapTypeMax(t) - 1 as I64
}

internal fn nowrapTypeMax(t: TypeInfo) -> I64 {
    let bits = nowrapTypeBits(t)
    let mut top = 1 as I64
    let mut b = 1
    if (nowrapIsUnsigned(t)) { b = 0 }
    while (b < bits) {
        top = top * (2 as I64)
        b = b + 1
    }
    return top - 1 as I64
}

// Whether every value in [lo, hi] is one `t` holds: an exact result that did not wrap.
internal fn nowrapFitsType(lo: I64, hi: I64, t: TypeInfo) -> Bool {
    if (nowrapTypeBits(t) == 0) { return false }
    return lo >= nowrapTypeMin(t) and hi <= nowrapTypeMax(t)
}

// A local of a fact type: a global is not a local a callee cannot change.
internal fn nowrapHoldsFacts(n: ASTNode) -> Bool {
    if (nowrapIsFactType(n) == false) { return false }
    if (n.kind == NodeKind.IDENTIFIER_EXPR or n.kind == NodeKind.VARIABLE_DECL) {
        return ir_var_is_global(n.s1) == 0
    }
    return true
}

// A node of the signed `Int` type, the one type whose `+`/`-` this marks `nsw`: an
// unsigned sum must not be `nsw`, and a global is not a local a callee cannot change.
internal fn nowrapIsIntName(n: ASTNode) -> Bool {
    if (nodeHasType(n) == false) { return false }
    let t = nodeGetType(n)
    if (t.kind != TypeKind.INT or t.name.equals("Int") == false) { return false }
    if (n.kind == NodeKind.IDENTIFIER_EXPR or n.kind == NodeKind.VARIABLE_DECL) {
        return ir_var_is_global(n.s1) == 0
    }
    return true
}
