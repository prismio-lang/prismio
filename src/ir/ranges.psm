// Loop index ranges: which list accesses in one loop provably stay inside their
// list on every iteration, and the preheader facts each of those proofs rests on.
//
// The caller versions the loop on the guard this folds its facts into. The
// guarded copy drops the bounds check at every access marked here; the other copy
// is the loop as written, so `list_get` stays total. A fact that is false at run
// time selects the checked loop -- nothing here can admit an out-of-range access.
//
// The proof is an abstract interpretation of the body over its *induction
// variables*: `Int` locals every assignment to which, in the body and outside any
// nested loop, adds a non-negative step (or every one subtracts), the step being a
// literal or the same loop-invariant name each time. A delta walk runs the body
// for one linear combination of them and answers the least and greatest change
// since the loop head, at every access and over a whole iteration. The one walk
// serves three questions:
//
// - per variable: its span at each access, and how far one iteration can move it,
//   which is what keeps it from wrapping between the checks the guard makes;
// - per candidate relation: `out - left - right` changing on no path that stays in
//   the loop is what bounds a merge's output cursor, which nothing in the
//   condition mentions;
// - for a `for` loop, whose variable the latch advances after every such path.
//
// Head bounds come from the condition's `and` conjuncts, from a monotone
// variable's start, and from relations. Index expressions are then evaluated as
// intervals in i64, in the preheader. The loop computes the index in wrapping
// `Int`; `+ - *` agree with their wrapped results modulo 2^32, so an interval
// inside [0, len) -- which is inside `Int` -- is the index the loop computes.
// `/` and `%` do not commute with wrapping, and each adds the fact that its
// operand did not wrap.
//
// A loop with no list guard to ride on is analysed for its sized-array accesses
// instead (`arrays`). Those are never checked, so a proof drops nothing; what it
// buys is its guard, which dominates the proved copy, and the `nsw` the guard
// licenses. Knapsack's `best[c - w]` over `c` in `[w, 1500]` puts `w >= 0` in the
// guard, and from that one fact LLVM proves the loop's reads trail its store and
// interleaves it: 3.14M instructions against 5.69M without the guard and C's 5.12M
// (freestanding, aarch64). The guard `w != Int.MIN` that only keeps `c - 1` from
// wrapping measured 6.26M, worse than none: a widened `c` with an unproved
// `c - w` costs a truncation and an extension per access.

import ast.nodes
import ast.types
import common.text
import std.string

let RANGE_OPAQUE = 0
let RANGE_UP = 1
let RANGE_DOWN = 2
let RANGE_PENDING = 3

let RANGE_INT_MAX = "2147483647"
let RANGE_INT_MIN = "-2147483648"

// Every literal this reads -- a step, a shift, a multiplier -- is at most six
// digits, so no product or sum of them with 32-bit values can approach the edge of
// the i64 the guard computes in.
let RANGE_LITERAL_DIGITS = 6

// A relation is `y - y0 = sum of (x - x0)` over at most this many variables.
let RANGE_RELATION_MEMBERS = 3

// Walk modes. Enumeration sizes the per-access tables; measurement fills one
// column of them; emission computes each access's interval and folds its facts.
let RANGE_WALK_ENUMERATE = 0
let RANGE_WALK_MEASURE = 1
let RANGE_WALK_EMIT = 2

struct RangeLoop {
    condPtr: Ptr,
    bodyPtr: Ptr,
    slot: String,
    proof: Int,
    proved: Int,
    // Arithmetic nodes the proof marked `nsw`.
    markedOps: Int,
    failed: Bool,
    // Whether this serves the loop's sized-array accesses rather than its flat list
    // accesses: a loop without a list guard, whose copies cannot read a list flat.
    arrays: Bool,
    // The loop's own label, which a `continue@label` in its body names, and its
    // source line, for PRISMIO_RANGE_TRACE.
    label: String,
    line: Int,

    // The induction variables, indexed alike across every field below.
    names: Vec<String>,
    kinds: Vec<Int>,
    // "" while every update adds a literal, and a walk counts literal amounts;
    // otherwise the one invariant name every update adds, and a walk counts steps.
    units: Vec<String>,
    // The walk's linear combination.
    coefs: Vec<Int>,
    // How far one iteration can move the variable along its direction, in the
    // units above.
    growth: Vec<Int>,
    // The first condition conjunct that bounds the variable, or -1.
    boundConj: Vec<Int>,
    // The members of the relation that bounds it, as a bit set, or 0.
    relations: Vec<Int>,

    // Preheader values, as i64: the variable's start, its step when symbolic,
    // and its bounds at the loop head ("" when it has none).
    inits: Vec<String>,
    unitValues: Vec<String>,
    lows: Vec<String>,
    highs: Vec<String>,
    // Whether this variable's no-wrap facts are already in the guard.
    folded: Vec<Int>,

    // The `for` variable's index, or -1, and how far its latch moves it in units.
    forVar: Int,
    forStep: Int,

    // Per access, in walk order: the conjunct it sits in (-1 in the body), then a
    // (least, greatest) delta pair per variable.
    accessConj: Vec<Int>,
    accessSpans: Vec<Int>,
    // Immutable `Int` lets in the body, in walk order, with their spans.
    letNames: Vec<String>,
    letSpans: Vec<Int>,
    // Receivers whose element base the preheader has loaded, and the loads.
    dataNames: Vec<String>,
    dataValues: Vec<String>,
    // The lets in scope at the walk's current point, innermost last.
    scopeLets: Vec<Int>,
    scopeCount: Int,

    // Walk state.
    mode: Int,
    column: Int,
    cursor: Int,
    letCursor: Int,
    conjunct: Int,
    nextConjunct: Int,
    curLo: Int,
    curHi: Int,
    live: Bool,
    contLo: Int,
    contHi: Int,
    contLive: Bool,
    allLo: Int,
    allHi: Int,
    allLive: Bool,

    // Interval results. `extra` gathers the operand facts `/` and `%` need.
    outLo: String,
    outHi: String,
    extra: String,
    usedMask: Int,
    // The conjunct the access being evaluated sits in, or -1 in the body.
    conjLimit: Int
}

private fn rangeLoopNew(condPtr: Ptr, bodyPtr: Ptr, arrays: Bool) -> RangeLoop {
    let mut label = ""
    if (nodeExists(bodyPtr)) { label = ptr_to_node(bodyPtr).s1.clone() }
    return RangeLoop {
        condPtr: condPtr, bodyPtr: bodyPtr, slot: "", proof: 0, proved: 0, markedOps: 0,
        failed: false, arrays: arrays, label: label, line: 0,
        names: [], kinds: [], units: [], coefs: [],
        growth: [], boundConj: [], relations: [],
        inits: [], unitValues: [], lows: [], highs: [],
        folded: [], forVar: 0 - 1, forStep: 0,
        accessConj: [], accessSpans: [],
        letNames: [], letSpans: [], dataNames: [], dataValues: [],
        scopeLets: [], scopeCount: 0,
        mode: RANGE_WALK_ENUMERATE, column: 0 - 1, cursor: 0, letCursor: 0,
        conjunct: 0 - 1, nextConjunct: 0,
        curLo: 0, curHi: 0, live: true, contLo: 0, contHi: 0, contLive: false,
        allLo: 0, allHi: 0, allLive: false,
        outLo: "", outHi: "", extra: "", usedMask: 0, conjLimit: 0 - 1
    }
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

// A `while` loop. Returns the guard slot for the proved copy, or "" when no access
// could be proved; `irLoopRangeProofPending` then holds the proof to activate.
// `arrays` serves the loop's sized-array accesses instead of its list accesses.
internal fn generateWhileRangeGuard(cond: ASTNode, body: ASTNode, arrays: Bool) -> String {
    let rl = rangeLoopNew(node_to_ptr(cond), node_to_ptr(body), arrays)
    rl.line = cond.line
    rl.collectVars()
    return rl.prove()
}

// A range `for` over `name` from the value already in its slot to `endVal`,
// advancing by `stepVal` -- a literal, or an i32 value the loop has already
// required to be positive before it is entered. `endVal` is exclusive unless
// `inclusive`. `down` counts from the start down to `endVal`, which is then the
// low end rather than the high one.
internal fn generateForRangeGuard(stmt: ASTNode, endVal: String, stepVal: String,
                                  stepIsLiteral: Bool, inclusive: Bool, down: Bool,
                                  arrays: Bool) -> String {
    let rl = rangeLoopNew(ptr_null(), stmt.child3, arrays)
    rl.line = stmt.line
    let index = rl.addVar(stmt.s1)
    let mut kind = RANGE_UP
    if (down) { kind = RANGE_DOWN }
    rl.kinds[index] = kind
    if (stepIsLiteral) {
        if (__builtin_string_len(stepVal) > RANGE_LITERAL_DIGITS) { return "" }
        rl.forStep = stepVal.parseIntOr(0)
        if (rl.forStep <= 0) { return "" }
    } else {
        rl.units[index] = "$for"
        rl.forStep = 1
    }
    rl.forVar = index
    rl.collectVars()
    if (rl.kinds[index] != kind) { return "" }

    // The latch leaves the loop before it would pass `end`, so the variable is
    // never past it at the head and never wraps: no fact to fold for it.
    let slotName = rangeSlotName()
    rl.slot = slotName.clone()
    let start = ir_get_temp_name(ir_sext("i32",
        ir_get_temp_name(ir_load("i32", ir_get_var_slot(stmt.s1))), "i64"))
    let end64 = ir_get_temp_name(ir_sext("i32", endVal, "i64"))
    let mut last = end64.clone()
    if (inclusive == false and down) {
        last = ir_get_temp_name(ir_add("i64", end64, "1"))
    } else if (inclusive == false) {
        last = ir_get_temp_name(ir_sub("i64", end64, "1"))
    }
    rl.inits[index] = start.clone()
    if (down) {
        rl.lows[index] = last.clone()
        rl.highs[index] = start.clone()
    } else {
        rl.lows[index] = start.clone()
        rl.highs[index] = last.clone()
    }
    if (stepIsLiteral == false) {
        rl.unitValues[index] = ir_get_temp_name(ir_sext("i32", stepVal, "i64"))
    }
    rl.folded[index] = 1
    return rl.finish()
}

impl RangeLoop {
    // The slot, the analysis and the emission, once the variables are known.
    private fn prove(self) -> String {
        if (self.failed) { return "" }
        self.slot = rangeSlotName()
        return self.finish()
    }
}


impl RangeLoop {
    private fn finish(self) -> String {
        self.runWalk(RANGE_WALK_ENUMERATE)
        if (self.failed or self.accessConj.length == 0) { return "" }
        self.measureVars()
        self.findConditionBounds()
        self.findRelations()
        self.emitVarValues()

        self.proof = ir_range_proof_new()
        self.runWalk(RANGE_WALK_EMIT)
        relationsProve(self)
        // An array proof drops no check, so a loop whose arithmetic it leaves
        // unmarked -- `for i in 0..<n { a[i] }` -- would get a second copy for
        // nothing but a fact LLVM rarely uses.
        if (self.arrays and self.markedOps == 0) { return "" }
        ir_range_trace(self.line, self.proved, self.accessConj.length)
        if (self.proved == 0) { return "" }
        irLoopRangeProofPending = self.proof
        irLoopRangeProofComplete = self.proved == self.accessConj.length
        return self.slot.clone()
    }
}


// A fresh `i1` slot, true until a fact is folded into it.
private fn rangeSlotName() -> String {
    let name = "rangeguard.".concat(irLoopFlatGuardCounter.toString())
    irLoopFlatGuardCounter = irLoopFlatGuardCounter + 1
    ir_set_var_type(name, "Bool")
    let slot = ir_get_var_slot(name)
    ir_alloca("i1", slot)
    ir_store("i1", "true", slot)
    return slot.clone()
}

impl RangeLoop {
    internal fn fold(self, fact: String) {
        let prev = ir_get_temp_name(ir_load("i1", self.slot))
        ir_store("i1", ir_get_temp_name(ir_and("i1", prev, fact)), self.slot)
    }
}


impl RangeLoop {
    // ---------------------------------------------------------------------------
    // Induction variables
    // ---------------------------------------------------------------------------

    private fn varIndex(self, name: String) -> Int {
        let n = self.names.length
        for i in 0..<n {
            let known: String = self.names[i]
            if (known.equals(name)) { return i }
        }
        return 0 - 1
    }
}


impl RangeLoop {
    private fn addVar(self, name: String) -> Int {
        let found = self.varIndex(name)
        if (found >= 0) { return found }
        self.names.push(name.clone())
        self.kinds.push(RANGE_PENDING)
        self.units.push("")
        self.coefs.push(0)
        self.growth.push(0)
        self.boundConj.push(0 - 1)
        self.relations.push(0)
        self.inits.push("")
        self.unitValues.push("")
        self.lows.push("")
        self.highs.push("")
        self.folded.push(0)
        return self.names.length - 1
    }
}


impl RangeLoop {
    private fn opaque(self, index: Int) {
        self.kinds[index] = RANGE_OPAQUE
    }
}


impl RangeLoop {
    private fn collectVars(self) {
        rangeClassify(self.bodyPtr, self, 0)
        let mut i = 0
        while (i < self.names.length) {
            let name: String = self.names[i]
            // A body that declares or pattern-binds the name has a second variable
            // under it, and which one an index means depends on where it sits.
            if (i != self.forVar and rangeBodyDeclares(self.bodyPtr, name)) { self.opaque(i) }
            if (i != self.forVar and ir_var_is_global(name) == 1) { self.opaque(i) }
            if (self.kinds[i] == RANGE_PENDING) { self.opaque(i) }
            i = i + 1
        }
    }
}


private fn rangeClassifyChain(head: Ptr, rl: RangeLoop, nested: Int) {
    let mut p = head
    while (nodeExists(p)) {
        rangeClassify(p, rl, nested)
        p = ptr_to_node(p).next
    }
}

private fn rangeClassify(nodePtr: Ptr, rl: RangeLoop, nested: Int) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)
    let mut inner = nested
    if (rangeIsLoop(n)) { inner = nested + 1 }
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
        let target = ptr_to_node(n.child1)
        if (target.kind == NodeKind.IDENTIFIER_EXPR) {
            rl.classifyUpdate(target, n.child2, nested)
        }
    }
    rangeClassifyChain(n.child1, rl, inner)
    rangeClassifyChain(n.child2, rl, inner)
    rangeClassifyChain(n.child3, rl, inner)
}

internal fn rangeIsLoop(n: ASTNode) -> Bool {
    return n.kind == NodeKind.WHILE_STATEMENT or n.kind == NodeKind.LOOP_STATEMENT
        or n.kind == NodeKind.FOR_STATEMENT
}

impl RangeLoop {
    // One assignment to `target`: an update of the recognised shape keeps the
    // variable's direction and unit, anything else makes it opaque. An update inside
    // a nested loop can run any number of times per iteration of this one, so it
    // bounds nothing.
    private fn classifyUpdate(self, target: ASTNode, rhsPtr: Ptr, nested: Int) {
        let index = self.addVar(target.s1)
        if (self.kinds[index] == RANGE_OPAQUE) { return }
        if (index == self.forVar) {
            self.opaque(index)
            return
        }
        if (nested > 0 or rangeIsIntNode(target) == false) {
            self.opaque(index)
            return
        }
        let dir = rangeUpdateDirection(rhsPtr, target.s1)
        if (dir == RANGE_OPAQUE) {
            self.opaque(index)
            return
        }
        let stepPtr = rangeUpdateStep(rhsPtr, target.s1)
        if (nodeIsNull(stepPtr)) {
            self.opaque(index)
            return
        }
        let step = ptr_to_node(stepPtr)
        let mut unit = ""
        if (step.kind == NodeKind.IDENTIFIER_EXPR) {
            if (rangeIsInvariantName(step, self) == false) {
                self.opaque(index)
                return
            }
            unit = step.s1.clone()
        } else if (rangeLiteralValue(step) < 0) {
            self.opaque(index)
            return
        }
        let kind = self.kinds[index]
        if (kind == RANGE_PENDING) {
            self.kinds[index] = dir
            self.units[index] = unit.clone()
            return
        }
        let known: String = self.units[index]
        if (kind != dir or known.equals(unit) == false) { self.opaque(index) }
    }
}


// RANGE_UP for `x = x + s` or `x = s + x`, RANGE_DOWN for `x = x - s`, otherwise
// RANGE_OPAQUE.
private fn rangeUpdateDirection(rhsPtr: Ptr, name: String) -> Int {
    if (nodeIsNull(rhsPtr)) { return RANGE_OPAQUE }
    let rhs = ptr_to_node(rhsPtr)
    if (rhs.kind != NodeKind.BINARY_EXPR) { return RANGE_OPAQUE }
    if (nodeIsNull(rhs.child1) or nodeIsNull(rhs.child2)) { return RANGE_OPAQUE }
    let lhsNamed = rangeIsNamed(rhs.child1, name)
    if (rhs.s1.equals("+")) {
        if (lhsNamed or rangeIsNamed(rhs.child2, name)) { return RANGE_UP }
        return RANGE_OPAQUE
    }
    if (rhs.s1.equals("-") and lhsNamed) { return RANGE_DOWN }
    return RANGE_OPAQUE
}

// The step operand of an update rangeUpdateDirection accepted: a literal or a
// name. Null for anything else.
private fn rangeUpdateStep(rhsPtr: Ptr, name: String) -> Ptr {
    if (rangeUpdateDirection(rhsPtr, name) == RANGE_OPAQUE) { return ptr_null() }
    let rhs = ptr_to_node(rhsPtr)
    let mut stepPtr = rhs.child2
    if (rangeIsNamed(rhs.child1, name) == false) { stepPtr = rhs.child1 }
    let step = ptr_to_node(stepPtr)
    if (step.kind == NodeKind.IDENTIFIER_EXPR) { return stepPtr }
    if (rangeLiteralValue(step) >= 0) { return stepPtr }
    return ptr_null()
}

// A non-negative integer literal of at most RANGE_LITERAL_DIGITS digits, or -1.
private fn rangeLiteralValue(n: ASTNode) -> Int {
    if (n.kind != NodeKind.LITERAL_EXPR) { return 0 - 1 }
    if (n.i1 != TokenType.NUMBER_LITERAL as Int) { return 0 - 1 }
    if (__builtin_string_len(n.s1) > RANGE_LITERAL_DIGITS) { return 0 - 1 }
    return n.s1.parseIntOr(0 - 1)
}

internal fn rangeIsNamed(p: Ptr, name: String) -> Bool {
    if (nodeIsNull(p)) { return false }
    let n = ptr_to_node(p)
    return n.kind == NodeKind.IDENTIFIER_EXPR and n.s1.equals(name)
}

internal fn rangeIsIntNode(n: ASTNode) -> Bool {
    if (nodeHasType(n) == false) { return false }
    return storageType(getExprType(n)).equals("i32")
}

// The amount one recognised update moves its variable, in the variable's units.
private fn rangeUpdateAmount(rhsPtr: Ptr, name: String, rl: RangeLoop, index: Int) -> Int {
    let unit: String = rl.units[index]
    if (unit.equals("") == false) { return 1 }
    return rangeLiteralValue(ptr_to_node(rangeUpdateStep(rhsPtr, name)))
}

// A local the loop cannot change: not a global -- a callee the guard looks
// through may still assign one -- and not declared, assigned or pattern-bound
// anywhere in the body.
internal fn rangeIsInvariantName(n: ASTNode, rl: RangeLoop) -> Bool {
    if (n.kind != NodeKind.IDENTIFIER_EXPR) { return false }
    if (rangeIsIntNode(n) == false) { return false }
    if (ir_var_is_global(n.s1) == 1) { return false }
    if (irBodyBindsName(rl.bodyPtr, n.s1)) { return false }
    return rangeBindsInPattern(rl.bodyPtr, n.s1) == false
}

private fn rangeBodyDeclares(bodyPtr: Ptr, name: String) -> Bool {
    if (rangeBindsInPattern(bodyPtr, name)) { return true }
    return nodeExists(irFindDeclInBody(bodyPtr, name))
}

// Whether a `match` arm in the body binds `name` from an enum payload.
internal fn rangeBindsInPattern(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.MATCH_ARM and nodeExists(n.child1)) {
        let pattern = ptr_to_node(n.child1)
        if (pattern.kind == NodeKind.CALL_EXPR) {
            let mut binder = pattern.child2
            while (nodeExists(binder)) {
                if (rangeIsNamed(binder, name)) { return true }
                binder = ptr_to_node(binder).next
            }
        }
    }
    if (rangeBindsInPatternChain(n.child1, name)) { return true }
    if (rangeBindsInPatternChain(n.child2, name)) { return true }
    return rangeBindsInPatternChain(n.child3, name)
}

private fn rangeBindsInPatternChain(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        if (rangeBindsInPattern(p, name)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

impl RangeLoop {
    // ---------------------------------------------------------------------------
    // The delta walk
    // ---------------------------------------------------------------------------

    // Walks the condition and the body once, for the combination in `coefs`. Leaves
    // the span of every path that stays in the loop in cont*, and of every path at
    // all in all*.
    private fn runWalk(self, mode: Int) {
        self.mode = mode
        self.curLo = 0
        self.curHi = 0
        self.live = true
        self.contLive = false
        self.allLive = false
        self.cursor = 0
        self.letCursor = 0
        self.scopeCount = 0
        self.nextConjunct = 0
        self.conjunct = 0 - 1
        if (nodeExists(self.condPtr)) { rangeWalkConjuncts(self.condPtr, self) }
        self.conjunct = 0 - 1
        rangeWalkBlock(self.bodyPtr, self)
        if (self.live) { self.endContinue() }
        if (self.forVar >= 0 and self.contLive) {
            let mut latch = self.coefs[self.forVar] * self.forStep
            if (self.kinds[self.forVar] == RANGE_DOWN) { latch = 0 - latch }
            self.contLo = self.contLo + latch
            self.contHi = self.contHi + latch
        }
        if (self.contLive) { self.joinAll(self.contLo, self.contHi) }
    }
}


impl RangeLoop {
    private fn endContinue(self) {
        if (self.contLive) {
            self.contLo = rangeMin(self.contLo, self.curLo)
            self.contHi = rangeMax(self.contHi, self.curHi)
        } else {
            self.contLo = self.curLo
            self.contHi = self.curHi
            self.contLive = true
        }
        self.live = false
    }
}


impl RangeLoop {
    private fn endExit(self) {
        self.joinAll(self.curLo, self.curHi)
        self.live = false
    }
}


impl RangeLoop {
    private fn joinAll(self, lo: Int, hi: Int) {
        if (self.allLive) {
            self.allLo = rangeMin(self.allLo, lo)
            self.allHi = rangeMax(self.allHi, hi)
        } else {
            self.allLo = lo
            self.allHi = hi
            self.allLive = true
        }
    }
}


impl RangeLoop {
    // Joins a branch's outcome into the current state.
    private fn joinCur(self, lo: Int, hi: Int, live: Bool) {
        if (live == false) { return }
        if (self.live) {
            self.curLo = rangeMin(self.curLo, lo)
            self.curHi = rangeMax(self.curHi, hi)
        } else {
            self.curLo = lo
            self.curHi = hi
            self.live = true
        }
    }
}


private fn rangeMin(a: Int, b: Int) -> Int {
    if (a < b) { return a }
    return b
}

private fn rangeMax(a: Int, b: Int) -> Int {
    if (a > b) { return a }
    return b
}

// The condition's `and` conjuncts, left to right, each numbered so an access in
// one can use the facts of those before it and no others.
private fn rangeWalkConjuncts(nodePtr: Ptr, rl: RangeLoop) {
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.BINARY_EXPR and n.s1.equals("and")) {
        rangeWalkConjuncts(n.child1, rl)
        rangeWalkConjuncts(n.child2, rl)
        return
    }
    rl.conjunct = rl.nextConjunct
    rl.nextConjunct = rl.nextConjunct + 1
    rangeWalkExpr(nodePtr, rl)
}

private fn rangeWalkBlock(blockPtr: Ptr, rl: RangeLoop) {
    if (nodeIsNull(blockPtr)) { return }
    let scope = rl.scopeCount
    let mut p = ptr_to_node(blockPtr).child1
    while (nodeExists(p) and rl.live) {
        rangeWalkStmt(p, rl)
        p = ptr_to_node(p).next
    }
    rl.scopeCount = scope
}

private fn rangeWalkStmt(stmtPtr: Ptr, rl: RangeLoop) {
    let s = ptr_to_node(stmtPtr)
    match (s.kind) {
        NodeKind.EXPRESSION_STATEMENT => {
            rangeWalkExpr(s.child1, rl)
            return
        }
        NodeKind.VARIABLE_DECL => {
            rangeWalkExpr(s.child2, rl)
            rangeVisitLet(s, rl)
            return
        }
        NodeKind.ASSIGNMENT_STATEMENT => {
            rangeWalkExpr(s.child2, rl)
            if (rangeIsNamedTarget(s) == false) { rangeWalkExpr(s.child1, rl) }
            rangeApplyUpdate(s, rl)
            return
        }
        NodeKind.IF_STATEMENT => {
            rangeWalkIf(s, rl)
            return
        }
        NodeKind.MATCH_STATEMENT => {
            rangeWalkMatch(s, rl)
            return
        }
        NodeKind.BLOCK => {
            rangeWalkBlock(stmtPtr, rl)
            return
        }
        NodeKind.REGION_STATEMENT => {
            rangeWalkBlock(s.child1, rl)
            return
        }
        NodeKind.RETURN_STATEMENT => {
            rangeWalkExpr(s.child1, rl)
            rl.endExit()
            return
        }
        NodeKind.BREAK_STATEMENT => {
            rl.endExit()
            return
        }
        NodeKind.CONTINUE_STATEMENT => {
            if (s.s1.equals("") or s.s1.equals(rl.label)) {
                rl.endContinue()
            } else {
                rl.endExit()
            }
            return
        }
    }
    if (rangeIsLoop(s)) {
        rangeWalkNested(stmtPtr, rl)
        return
    }
    rl.failed = true
}

internal fn rangeIsNamedTarget(s: ASTNode) -> Bool {
    if (nodeIsNull(s.child1)) { return false }
    return ptr_to_node(s.child1).kind == NodeKind.IDENTIFIER_EXPR
}

private fn rangeApplyUpdate(s: ASTNode, rl: RangeLoop) {
    if (rangeIsNamedTarget(s) == false) { return }
    let name = ptr_to_node(s.child1).s1
    let index = rl.varIndex(name)
    if (index < 0) { return }
    let coef = rl.coefs[index]
    if (coef == 0) { return }
    let kind = rl.kinds[index]
    if (kind != RANGE_UP and kind != RANGE_DOWN) { return }
    let mut delta = coef * rangeUpdateAmount(s.child2, name, rl, index)
    if (kind == RANGE_DOWN) { delta = 0 - delta }
    rl.curLo = rl.curLo + delta
    rl.curHi = rl.curHi + delta
}

private fn rangeWalkIf(s: ASTNode, rl: RangeLoop) {
    rangeWalkExpr(s.child1, rl)
    let inLo = rl.curLo
    let inHi = rl.curHi
    let inLive = rl.live
    rangeWalkBlock(s.child2, rl)
    let thenLo = rl.curLo
    let thenHi = rl.curHi
    let thenLive = rl.live
    rl.curLo = inLo
    rl.curHi = inHi
    rl.live = inLive
    if (nodeExists(s.child3)) {
        if (ptr_to_node(s.child3).kind == NodeKind.IF_STATEMENT) {
            rangeWalkStmt(s.child3, rl)
        } else {
            rangeWalkBlock(s.child3, rl)
        }
    }
    rl.joinCur(thenLo, thenHi, thenLive)
}

// Every arm from the same state, and the state itself: a match that no arm takes
// falls through, and counting that path only widens the spans.
private fn rangeWalkMatch(s: ASTNode, rl: RangeLoop) {
    rangeWalkExpr(s.child1, rl)
    let inLo = rl.curLo
    let inHi = rl.curHi
    let inLive = rl.live
    let mut outLo = inLo
    let mut outHi = inHi
    let mut outLive = inLive
    let mut arm = s.child2
    while (nodeExists(arm)) {
        rl.curLo = inLo
        rl.curHi = inHi
        rl.live = inLive
        rangeWalkBlock(ptr_to_node(arm).child2, rl)
        if (rl.live) {
            if (outLive) {
                outLo = rangeMin(outLo, rl.curLo)
                outHi = rangeMax(outHi, rl.curHi)
            } else {
                outLo = rl.curLo
                outHi = rl.curHi
                outLive = true
            }
        }
        arm = ptr_to_node(arm).next
    }
    rl.curLo = outLo
    rl.curHi = outHi
    rl.live = outLive
}

// A nested loop changes no variable this analysis tracks -- an update inside one
// made that variable opaque -- and its accesses are its own guard's to prove. What
// it can do is leave this loop: a `return`, or a jump naming an enclosing loop.
// Both are counted where the nested loop starts, which is where this state is.
private fn rangeWalkNested(stmtPtr: Ptr, rl: RangeLoop) {
    if (rangeLeavesLoop(stmtPtr) == false) { return }
    let lo = rl.curLo
    let hi = rl.curHi
    rl.joinAll(lo, hi)
    if (rl.contLive) {
        rl.contLo = rangeMin(rl.contLo, lo)
        rl.contHi = rangeMax(rl.contHi, hi)
    } else {
        rl.contLo = lo
        rl.contHi = hi
        rl.contLive = true
    }
}

private fn rangeLeavesLoop(nodePtr: Ptr) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.RETURN_STATEMENT) { return true }
    if (n.kind == NodeKind.BREAK_STATEMENT or n.kind == NodeKind.CONTINUE_STATEMENT) {
        if (n.s1.equals("") == false) { return true }
    }
    if (rangeLeavesLoopChain(n.child1)) { return true }
    if (rangeLeavesLoopChain(n.child2)) { return true }
    return rangeLeavesLoopChain(n.child3)
}

private fn rangeLeavesLoopChain(head: Ptr) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        if (rangeLeavesLoop(p)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

private fn rangeWalkExprChain(head: Ptr, rl: RangeLoop) {
    let mut p = head
    while (nodeExists(p)) {
        rangeWalkExpr(p, rl)
        p = ptr_to_node(p).next
    }
}

private fn rangeWalkExpr(exprPtr: Ptr, rl: RangeLoop) {
    if (nodeIsNull(exprPtr)) { return }
    let e = ptr_to_node(exprPtr)
    if (rl.servesAccess(e)) { rangeVisitAccess(e, rl) }
    rangeWalkExprChain(e.child1, rl)
    rangeWalkExprChain(e.child2, rl)
    rangeWalkExprChain(e.child3, rl)
}

// The accesses whose check the guarded copy can drop: the flat read and the flat
// scalar write, which are the two sites that consult the proof.
internal fn rangeIsAccess(e: ASTNode) -> Bool {
    if (e.kind != NodeKind.CALL_EXPR or nodeIsNull(e.child1)) { return false }
    let fname = ptr_to_node(e.child1).s1
    if (flatGetStride(e, fname) > 0) { return true }
    return flatSetScalarStride(e, fname) > 0
}

// An element of an `Array<T, N>` whose N the type carries, read or stored. A
// `[T]` parameter's length is its caller's, which the preheader cannot know.
internal fn rangeIsSizedArrayAccess(e: ASTNode) -> Bool {
    if (e.kind != NodeKind.INDEX_EXPR or nodeIsNull(e.child1) or nodeIsNull(e.child2)) { return false }
    let base = ptr_to_node(e.child1)
    if (nodeHasType(base) == false) { return false }
    let t = nodeGetType(base)
    return t.kind == TypeKind.ARRAY and t.length > 0
}

// Whether to analyse a loop without a list guard for its sized-array accesses: an
// innermost loop with one of its own. Versioning an outer loop would copy every
// loop inside it, for facts about its own accesses -- knapsack's item loop got a
// second copy of the capacity loop and nothing for it.
internal fn rangeServesArrays(condPtr: Ptr, bodyPtr: Ptr) -> Bool {
    if (nodeIsNull(bodyPtr) or rangeHasLoopChain(ptr_to_node(bodyPtr).child1)) { return false }
    if (rangeHasArrayAccessIn(condPtr)) { return true }
    return rangeHasArrayAccessChain(ptr_to_node(bodyPtr).child1)
}

private fn rangeHasArrayAccessIn(nodePtr: Ptr) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.CLOSURE_EXPR) { return false }
    if (rangeIsSizedArrayAccess(n)) { return true }
    if (rangeHasArrayAccessChain(n.child1)) { return true }
    if (rangeHasArrayAccessChain(n.child2)) { return true }
    return rangeHasArrayAccessChain(n.child3)
}

private fn rangeHasArrayAccessChain(head: Ptr) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        if (rangeHasArrayAccessIn(p)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}

private fn rangeHasLoopChain(head: Ptr) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (rangeIsLoop(n)) { return true }
        if (n.kind != NodeKind.CLOSURE_EXPR) {
            if (rangeHasLoopChain(n.child1) or rangeHasLoopChain(n.child2)
                    or rangeHasLoopChain(n.child3)) {
                return true
            }
        }
        p = n.next
    }
    return false
}

// The index an access the analysis serves reads: a list call's second argument,
// or an array element's subscript.
internal fn rangeAccessIndex(e: ASTNode) -> Ptr {
    if (e.kind == NodeKind.INDEX_EXPR) { return e.child2 }
    return ptr_to_node(e.child2).next
}

impl RangeLoop {
    internal fn servesAccess(self, e: ASTNode) -> Bool {
        if (self.arrays) { return rangeIsSizedArrayAccess(e) }
        return rangeIsAccess(e)
    }
}


impl RangeLoop {
    // Whether the preheader can know the receiver's length for the whole run: a
    // list the body neither rebinds nor resizes, or a sized array, whose length is
    // its type's whatever the body does.
    internal fn accessIsStable(self, e: ASTNode) -> Bool {
        if (e.kind == NodeKind.INDEX_EXPR) { return true }
        let list = ptr_to_node(e.child2)
        if (nodeIsNull(list.next)) { return false }
        return rangeIsStableList(list, self)
    }
}


impl RangeLoop {
    // The receiver's length as an i64 value, emitted where the caller is.
    internal fn accessLength(self, e: ASTNode) -> String {
        if (e.kind == NodeKind.INDEX_EXPR) {
            return nodeGetType(ptr_to_node(e.child1)).length.toString()
        }
        ir_call_begin()
        ir_call_arg("ptr", generateExpression(ptr_to_node(e.child2)))
        return ir_get_temp_name(ir_sext("i32",
            ir_get_temp_name(ir_call_end("i32", "list_len")), "i64"))
    }
}


impl RangeLoop {
    // What the proved copy reads the elements through: a list's base, loaded once
    // in the preheader. An array element is addressed as it always is.
    internal fn accessData(self, e: ASTNode) -> String {
        if (e.kind == NodeKind.INDEX_EXPR) { return "" }
        return self.dataFor(ptr_to_node(e.child2))
    }
}


impl RangeLoop {
    // Marks an arithmetic node `nsw` in the proved copy.
    internal fn markOp(self, nodePtr: Ptr) {
        ir_range_proof_mark(nodePtr, self.proof, "")
        self.markedOps = self.markedOps + 1
    }
}

private fn rangeVisitAccess(e: ASTNode, rl: RangeLoop) {
    let width = 2 * rl.names.length
    if (rl.mode == RANGE_WALK_ENUMERATE) {
        rl.accessConj.push(rl.conjunct)
        repeat(width) {
            rl.accessSpans.push(0)
        }
    } else if (rl.mode == RANGE_WALK_MEASURE and rl.column >= 0) {
        let at = rl.cursor * width + 2 * rl.column
        rl.accessSpans[at] = rl.curLo
        rl.accessSpans[at + 1] = rl.curHi
    } else if (rl.mode == RANGE_WALK_EMIT) {
        rangeEmitAccess(e, rl)
    }
    rl.cursor = rl.cursor + 1
}

// An immutable `Int` let, which an index may name: its value is the initialiser's
// at this point, whatever the variables do afterwards.
private fn rangeVisitLet(s: ASTNode, rl: RangeLoop) {
    if (s.i1 != 0 or nodeIsNull(s.child2)) { return }
    if (rangeIsIntNode(ptr_to_node(s.child2)) == false) { return }
    let width = 2 * rl.names.length
    if (rl.mode == RANGE_WALK_ENUMERATE) {
        rl.letNames.push(s.s1.clone())
        repeat(width) {
            rl.letSpans.push(0)
        }
    } else if (rl.mode == RANGE_WALK_MEASURE and rl.column >= 0) {
        let at = rl.letCursor * width + 2 * rl.column
        rl.letSpans[at] = rl.curLo
        rl.letSpans[at + 1] = rl.curHi
    }
    if (rl.scopeCount < rl.scopeLets.length) {
        rl.scopeLets[rl.scopeCount] = rl.letCursor
    } else {
        rl.scopeLets.push(rl.letCursor)
    }
    rl.scopeCount = rl.scopeCount + 1
    rl.letCursor = rl.letCursor + 1
}

impl RangeLoop {
    // ---------------------------------------------------------------------------
    // Measurement: spans, growth, bounds and relations
    // ---------------------------------------------------------------------------

    private fn clearCoefs(self) {
        for i in 0..<self.coefs.length {
            self.coefs[i] = 0
        }
    }
}


impl RangeLoop {
    private fn isTracked(self, index: Int) -> Bool {
        let kind = self.kinds[index]
        return kind == RANGE_UP or kind == RANGE_DOWN
    }
}


impl RangeLoop {
    // One walk per variable: its span at every access and let, and its growth over
    // one iteration along its own direction.
    private fn measureVars(self) {
        let mut i = 0
        while (i < self.names.length) {
            if (self.isTracked(i)) {
                self.clearCoefs()
                self.coefs[i] = 1
                self.column = i
                self.runWalk(RANGE_WALK_MEASURE)
                let mut growth = 0
                if (self.allLive) {
                    if (self.kinds[i] == RANGE_UP) { growth = self.allHi } else { growth = 0 - self.allLo }
                }
                self.growth[i] = rangeMax(growth, 0)
            }
            i = i + 1
        }
        self.column = 0 - 1
        self.clearCoefs()
    }
}


impl RangeLoop {
    // The first conjunct that bounds each variable in its direction of travel.
    private fn findConditionBounds(self) {
        if (nodeIsNull(self.condPtr)) { return }
        let count = rangeConjunctCount(self.condPtr)
        for k in 0..<count {
            let c = ptr_to_node(rangeConjunct(self.condPtr, k))
            let mut i = 0
            while (i < self.names.length) {
                if (self.isTracked(i) and self.boundConj[i] < 0) {
                    if (rangeFactBounds(c, self, i)) { self.boundConj.set(i, k) }
                }
                i = i + 1
            }
        }
    }
}


private fn rangeConjunctCount(nodePtr: Ptr) -> Int {
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.BINARY_EXPR and n.s1.equals("and")) {
        return rangeConjunctCount(n.child1) + rangeConjunctCount(n.child2)
    }
    return 1
}

private fn rangeConjunct(nodePtr: Ptr, k: Int) -> Ptr {
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.BINARY_EXPR and n.s1.equals("and")) {
        let left = rangeConjunctCount(n.child1)
        if (k < left) { return rangeConjunct(n.child1, k) }
        return rangeConjunct(n.child2, k - left)
    }
    return nodePtr
}

// A comparison normalised so the variable side is on the left: the operator as
// it reads with the variable first. "" for a node that is no comparison.
private fn rangeFlipped(op: String) -> String {
    if (op.equals("<")) { return ">" }
    if (op.equals("<=")) { return ">=" }
    if (op.equals(">")) { return "<" }
    if (op.equals(">=")) { return "<=" }
    return ""
}

private fn rangeIsComparison(op: String) -> Bool {
    return op.equals("<") or op.equals("<=") or op.equals(">") or op.equals(">=")
}

// Whether conjunct `c` bounds variable `index` in its direction of travel: an
// upper bound for one that counts up, a lower bound for one that counts down.
// The shapes, with `x` the variable, `B` loop-invariant and `y` a variable
// travelling the other way:
//
//     x < B    x <= B    B > x    x + E < B    E + x < B    x < y    x <= y
//
// and their mirrors for a variable counting down.
private fn rangeFactBounds(c: ASTNode, rl: RangeLoop, index: Int) -> Bool {
    if (c.kind != NodeKind.BINARY_EXPR or rangeIsComparison(c.s1) == false) { return false }
    let name: String = rl.names[index]
    let up = rl.kinds[index] == RANGE_UP
    if (rangeSideHas(c.child1, name, rl)) {
        return rangeOpBounds(c.s1, up) and rangeBoundSideOk(c.child2, index, rl)
    }
    if (rangeSideHas(c.child2, name, rl)) {
        return rangeOpBounds(rangeFlipped(c.s1), up) and rangeBoundSideOk(c.child1, index, rl)
    }
    return false
}

private fn rangeOpBounds(op: String, up: Bool) -> Bool {
    if (up) { return op.equals("<") or op.equals("<=") }
    return op.equals(">") or op.equals(">=")
}

// `name`, or `name + E` / `E + name` with E invariant.
private fn rangeSideHas(sidePtr: Ptr, name: String, rl: RangeLoop) -> Bool {
    if (rangeIsNamed(sidePtr, name)) { return true }
    return nodeExists(rangeShiftOf(sidePtr, name, rl))
}

// The E of `name + E` or `E + name`, or null.
private fn rangeShiftOf(sidePtr: Ptr, name: String, rl: RangeLoop) -> Ptr {
    let side = ptr_to_node(sidePtr)
    if (side.kind != NodeKind.BINARY_EXPR or side.s1.equals("+") == false) { return ptr_null() }
    if (nodeIsNull(side.child1) or nodeIsNull(side.child2)) { return ptr_null() }
    if (rangeIsNamed(side.child1, name) and rangeIsInvariant(side.child2, rl)) {
        return side.child2
    }
    if (rangeIsNamed(side.child2, name) and rangeIsInvariant(side.child1, rl)) {
        return side.child1
    }
    return ptr_null()
}

// The bounding side of a fact: an invariant, or a variable travelling the other
// way, whose start then bounds this one.
private fn rangeBoundSideOk(sidePtr: Ptr, index: Int, rl: RangeLoop) -> Bool {
    if (rangeIsInvariant(sidePtr, rl)) { return true }
    let side = ptr_to_node(sidePtr)
    if (side.kind != NodeKind.IDENTIFIER_EXPR) { return false }
    let other = rl.varIndex(side.s1)
    if (other < 0 or other == index or rl.isTracked(other) == false) { return false }
    return rl.kinds[other] != rl.kinds[index]
}

impl RangeLoop {
    // For every variable the condition leaves unbounded, the smallest set of bounded
    // variables whose sum it moves in step with on every path that stays in the loop.
    private fn findRelations(self) {
        let n = self.names.length
        for y in 0..<n {
            if (self.needsRelation(y)) {
                let mask = self.findRelation(y)
                self.relations[y] = mask
            }
        }
        self.clearCoefs()
    }
}


impl RangeLoop {
    private fn needsRelation(self, y: Int) -> Bool {
        if (self.isTracked(y) == false) { return false }
        if (y == self.forVar or self.boundConj[y] >= 0) { return false }
        let unit: String = self.units[y]
        return unit.equals("")
    }
}


impl RangeLoop {
    // A candidate member: bounded directly, travelling the same way, counted in
    // literal amounts like the variable it bounds.
    private fn canRelate(self, y: Int, x: Int) -> Bool {
        if (x == y or self.isTracked(x) == false) { return false }
        if (self.kinds[x] != self.kinds[y]) { return false }
        let unit: String = self.units[x]
        if (x == self.forVar) { return unit.equals("") }
        return unit.equals("") and self.boundConj[x] >= 0
    }
}


impl RangeLoop {
    private fn findRelation(self, y: Int) -> Int {
        let n = self.names.length
        let mut size = 1
        while (size <= RANGE_RELATION_MEMBERS) {
            let limit = rangeShift(n)
            for mask in 1..<limit {
                if (rangeBitCount(mask) == size and (mask & rangeShift(y)) == 0
                        and self.maskCanRelate(y, mask)
                        and self.relationHolds(y, mask)) {
                    return mask
                }
            }
            size = size + 1
        }
        return 0
    }
}


private fn rangeShift(bit: Int) -> Int {
    let mut v = 1
    repeat(bit) {
        v = v * 2
    }
    return v
}

private fn rangeBitCount(mask: Int) -> Int {
    let mut m = mask
    let mut count = 0
    while (m > 0) {
        count = count + (m % 2)
        m = m / 2
    }
    return count
}

impl RangeLoop {
    private fn maskCanRelate(self, y: Int, mask: Int) -> Bool {
        let mut i = 0
        while (i < self.names.length) {
            if ((mask & rangeShift(i)) != 0 and self.canRelate(y, i) == false) { return false }
            i = i + 1
        }
        return true
    }
}


impl RangeLoop {
    // `y - sum(mask)` does not change on any path that stays in the loop.
    private fn relationHolds(self, y: Int, mask: Int) -> Bool {
        self.clearCoefs()
        self.coefs[y] = 1
        let mut i = 0
        while (i < self.names.length) {
            if ((mask & rangeShift(i)) != 0) { self.coefs.set(i, 0 - 1) }
            i = i + 1
        }
        self.column = 0 - 1
        self.runWalk(RANGE_WALK_MEASURE)
        return self.contLive and self.contLo == 0 and self.contHi == 0
    }
}


impl RangeLoop {
    // ---------------------------------------------------------------------------
    // Preheader values
    // ---------------------------------------------------------------------------

    // Every variable's start, step and head bounds, as i64. Emitted whether or not an
    // access ends up needing them: a value nothing reads costs nothing after -O3, and
    // computing them first keeps the emission walk free of ordering questions.
    private fn emitVarValues(self) {
        let n = self.names.length
        let mut i = 0
        while (i < n) {
            if (self.isTracked(i) and i != self.forVar) { self.emitVarStart(i) }
            i = i + 1
        }
        i = 0
        while (i < n) {
            if (self.isTracked(i) and i != self.forVar and self.boundConj[i] >= 0) {
                self.emitConditionBound(i)
            }
            i = i + 1
        }
        i = 0
        while (i < n) {
            if (self.isTracked(i) and self.relations[i] != 0) {
                self.emitRelationBound(i)
            }
            i = i + 1
        }
    }
}


impl RangeLoop {
    private fn emitVarStart(self, i: Int) {
        let name: String = self.names[i]
        let start = ir_get_temp_name(ir_sext("i32",
            ir_get_temp_name(ir_load("i32", ir_get_var_slot(name))), "i64"))
        self.inits[i] = start.clone()
        if (self.kinds[i] == RANGE_UP) {
            self.lows[i] = start.clone()
        } else {
            self.highs[i] = start.clone()
        }
        let unit: String = self.units[i]
        if (unit.equals("") == false) {
            let value = ir_get_temp_name(ir_sext("i32",
                ir_get_temp_name(ir_load("i32", ir_get_var_slot(unit))), "i64"))
            self.unitValues[i] = value.clone()
        }
    }
}


impl RangeLoop {
    // The head bound the variable's first bounding conjunct gives, and the facts that
    // make it one. With `x + E < B`, the condition's own sum is computed in `Int`
    // too, so it must not wrap at any head: from the start, and one iteration's growth
    // past the bound.
    private fn emitConditionBound(self, i: Int) {
        let c = ptr_to_node(rangeConjunct(self.condPtr, self.boundConj[i]))
        let name: String = self.names[i]
        let up = self.kinds[i] == RANGE_UP
        let mut op = c.s1.clone()
        let mut varSide = c.child1
        let mut boundSide = c.child2
        if (rangeSideHas(c.child1, name, self) == false) {
            op = rangeFlipped(c.s1)
            varSide = c.child2
            boundSide = c.child1
        }

        let mut bound = ""
        let boundNode = ptr_to_node(boundSide)
        if (rangeIsInvariant(boundSide, self)) {
            bound = rangeInvariantValue(boundNode)
        } else {
            let other = self.varIndex(boundNode.s1)
            bound = self.inits[other].clone()
        }
        if (bound.equals("")) { return }

        let shiftPtr = rangeShiftOf(varSide, name, self)
        let mut shift = ""
        if (nodeExists(shiftPtr)) {
            shift = rangeInvariantValue(ptr_to_node(shiftPtr))
            bound = ir_get_temp_name(ir_sub("i64", bound, shift))
        }

        // Strict comparisons take the extreme one step in: `k < n` admits n - 1.
        if (op.equals("<")) { bound = ir_get_temp_name(ir_sub("i64", bound, "1")) }
        if (op.equals(">")) { bound = ir_get_temp_name(ir_add("i64", bound, "1")) }
        if (up) {
            self.highs[i] = bound.clone()
        } else {
            self.lows[i] = bound.clone()
        }

        if (shift.equals("") == false) {
            let start: String = self.inits[i]
            let first = ir_get_temp_name(ir_add("i64", start, shift))
            let reach = ir_get_temp_name(ir_add("i64", self.reach(i, bound), shift))
            self.fold(rangeWithinInt(first))
            self.fold(rangeWithinInt(reach))
        }
    }
}


impl RangeLoop {
    // How far the variable can get within the iteration that starts at `head`: one
    // iteration's growth past it, in its direction.
    private fn reach(self, i: Int, head: String) -> String {
        let amount = self.growthValue(i)
        if (self.kinds[i] == RANGE_UP) {
            return ir_get_temp_name(ir_add("i64", head, amount))
        }
        return ir_get_temp_name(ir_sub("i64", head, amount))
    }
}


impl RangeLoop {
    // The variable's growth over one iteration as an i64 value.
    private fn growthValue(self, i: Int) -> String {
        let growth = self.growth[i].toString()
        let unit: String = self.unitValues[i]
        if (unit.equals("")) { return growth }
        return ir_get_temp_name(ir_mul("i64", growth, unit))
    }
}


private fn rangeWithinInt(value: String) -> String {
    let low = ir_get_temp_name(ir_icmp_sge("i64", value, RANGE_INT_MIN))
    let high = ir_get_temp_name(ir_icmp_sle("i64", value, RANGE_INT_MAX))
    return ir_get_temp_name(ir_and("i1", low, high))
}

impl RangeLoop {
    // `y = y0 + sum(x - x0)` at every head, so each member's bound in the shared
    // direction bounds `y` the same way.
    private fn emitRelationBound(self, y: Int) {
        let mask = self.relations[y]
        let up = self.kinds[y] == RANGE_UP
        let mut acc = self.inits[y].clone()
        let mut i = 0
        while (i < self.names.length) {
            if ((mask & rangeShift(i)) != 0) {
                let mut edge = ""
                if (up) { edge = self.highs[i].clone() } else { edge = self.lows[i].clone() }
                if (edge.equals("")) { return }
                let start: String = self.inits[i]
                let moved = ir_get_temp_name(ir_sub("i64", edge, start))
                acc = ir_get_temp_name(ir_add("i64", acc, moved))
            }
            i = i + 1
        }
        if (up) {
            self.highs[y] = acc.clone()
        } else {
            self.lows[y] = acc.clone()
        }
    }
}


impl RangeLoop {
    // The facts under which variable `i`'s bounds hold at every head and every access:
    // it moves only its own way, and never far enough to wrap. Folded once, the first
    // time a proved access relies on the variable.
    private fn foldVar(self, i: Int) {
        if (self.folded[i] != 0) { return }
        self.folded[i] = 1
        let unit: String = self.unitValues[i]
        if (unit.equals("") == false) {
            self.fold(ir_get_temp_name(ir_icmp_sge("i64", unit, "0")))
        }
        if (self.kinds[i] == RANGE_UP) {
            let reach = self.reach(i, self.highs[i])
            self.fold(ir_get_temp_name(ir_icmp_sle("i64", reach, RANGE_INT_MAX)))
        } else {
            let reach = self.reach(i, self.lows[i])
            self.fold(ir_get_temp_name(ir_icmp_sge("i64", reach, RANGE_INT_MIN)))
        }
        // With these facts in the guard, no update of the variable wraps in the
        // proved copy, and saying so lets LLVM widen it.
        if (i != self.forVar) { rangeMarkUpdates(self.bodyPtr, self, self.names[i]) }
        let conj = self.boundConj[i]
        if (conj >= 0) {
            let other = self.boundingVar(i)
            if (other >= 0) { self.foldVar(other) }
        }
        let mask = self.relations[i]
        let mut m = 0
        while (m < self.names.length) {
            if ((mask & rangeShift(m)) != 0) { self.foldVar(m) }
            m = m + 1
        }
    }
}


// Marks the arithmetic of every update of `name` with the proof. Every update of a
// tracked variable is one rangeClassifyUpdate recognised, outside nested loops.
private fn rangeMarkUpdates(nodePtr: Ptr, rl: RangeLoop, name: String) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and rangeIsNamed(n.child1, name)) {
        rl.markOp(n.child2)
    }
    rangeMarkUpdatesChain(n.child1, rl, name)
    rangeMarkUpdatesChain(n.child2, rl, name)
    rangeMarkUpdatesChain(n.child3, rl, name)
}

private fn rangeMarkUpdatesChain(head: Ptr, rl: RangeLoop, name: String) {
    let mut p = head
    while (nodeExists(p)) {
        rangeMarkUpdates(p, rl, name)
        p = ptr_to_node(p).next
    }
}

impl RangeLoop {
    // The variable whose start bounds variable `i`, when its condition fact is
    // `x < y` rather than one against an invariant; -1 otherwise.
    private fn boundingVar(self, i: Int) -> Int {
        let c = ptr_to_node(rangeConjunct(self.condPtr, self.boundConj[i]))
        let name: String = self.names[i]
        let mut boundSide = c.child2
        if (rangeSideHas(c.child1, name, self) == false) { boundSide = c.child1 }
        if (rangeIsInvariant(boundSide, self)) { return 0 - 1 }
        return self.varIndex(ptr_to_node(boundSide).s1)
    }
}


// ---------------------------------------------------------------------------
// Emission: one access
// ---------------------------------------------------------------------------

private fn rangeEmitAccess(e: ASTNode, rl: RangeLoop) {
    if (rl.accessIsStable(e) == false) { return }
    let indexPtr = rangeAccessIndex(e)

    rl.usedMask = 0
    rl.extra = "true"
    rl.conjLimit = rl.accessConj[rl.cursor]
    if (rangeInterval(indexPtr, rl, rl.accessSpans, rl.cursor) == false) { return }
    let lo = rl.outLo.clone()
    let hi = rl.outHi.clone()
    let extra = rl.extra.clone()
    let used = rl.usedMask

    let len = rl.accessLength(e)
    let lowOk = ir_get_temp_name(ir_icmp_sge("i64", lo, "0"))
    let highOk = ir_get_temp_name(ir_icmp_slt("i64", hi, len))
    let inside = ir_get_temp_name(ir_and("i1", lowOk, highOk))
    rl.fold(ir_get_temp_name(ir_and("i1", inside, extra)))
    let mut i = 0
    while (i < rl.names.length) {
        if ((used & rangeShift(i)) != 0) { rl.foldVar(i) }
        i = i + 1
    }
    ir_range_proof_mark(node_to_ptr(e), rl.proof, rl.accessData(e))
    rangeMarkIndex(indexPtr, rl, true, 0, rangeIntMax() - 1)
    rl.proved = rl.proved + 1
}

// Marks the `+` and `-` of a proved index that cannot wrap, so the proved copy
// emits them `nsw` and LLVM can compute the index in 64 bits. Answers whether the
// node's value lies inside `Int`; `known` says the caller has a bound [lo, hi] for
// it from a fact the guard already holds.
//
// The interval above is the loop's value only modulo 2^32, so a node's interval
// inside `Int` is not enough: `(x + k) - k` is in range with `x + k` wrapped. A
// node whose value is inside `Int` does hold the loop's value exactly, though,
// since the two agree modulo 2^32. So an op is marked when its result and both
// operands are inside `Int`: its operands are then what the loop computed, and
// their exact sum is its result.
//
// The bounds come from the guard: the index is in [0, len), len being an `Int`,
// and the operand of `/` and `%` is inside `Int`. They carry down through a
// literal offset -- `c - 1` in [0, len) puts `c` in [1, len] -- which is what
// marks every op of `current + c - 1`. No fact is added for a mark, since one
// that fails at run time would send the loop to its checked copy, and nothing is
// marked that rangeInterval did not evaluate.
private fn rangeMarkIndex(exprPtr: Ptr, rl: RangeLoop, known: Bool, lo: I64, hi: I64) -> Bool {
    let e = ptr_to_node(exprPtr)
    if (rangeLiteralValue(e) >= 0) { return true }
    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        if (rl.scopeLet(e.s1) < 0) { return true }
        let decl = ptr_to_node(irFindDeclInBody(rl.bodyPtr, e.s1))
        return rangeMarkIndex(decl.child2, rl, known, lo, hi)
    }
    if (e.kind == NodeKind.UNARY_EXPR) {
        rangeMarkIndex(e.child1, rl, false, 0, 0)
        return false
    }
    if (e.kind != NodeKind.BINARY_EXPR) { return true }
    let op = e.s1
    if (op.equals("&")) { return true }
    if (op.equals("*") and rangeIsInvariant(node_to_ptr(e), rl)) { return true }
    if (op.equals("+") or op.equals("-")) { return rangeMarkSum(e, rl, known, lo, hi) }
    let divides = op.equals("/") or op.equals("%")
    let mut operand = e.child1
    if (rangeLiteralValue(ptr_to_node(e.child2)) < 0) { operand = e.child2 }
    rangeMarkIndex(operand, rl, divides, rangeIntMin(), rangeIntMax())
    return divides
}

// `a + b` or `a - b` with its value in [lo, hi] when `known`. A literal operand
// bounds the other one by the same interval, shifted.
private fn rangeMarkSum(e: ASTNode, rl: RangeLoop, known: Bool, lo: I64, hi: I64) -> Bool {
    let plus = e.s1.equals("+")
    let right = rangeLiteralValue(ptr_to_node(e.child2))
    let left = rangeLiteralValue(ptr_to_node(e.child1))
    let mut leftInside = false
    let mut rightInside = false
    if (known and right >= 0) {
        let k = right as I64
        if (plus) {
            leftInside = rangeMarkBounded(e.child1, rl, lo - k, hi - k)
        } else {
            leftInside = rangeMarkBounded(e.child1, rl, lo + k, hi + k)
        }
        rightInside = true
    } else if (known and left >= 0) {
        let k = left as I64
        if (plus) {
            rightInside = rangeMarkBounded(e.child2, rl, lo - k, hi - k)
        } else {
            rightInside = rangeMarkBounded(e.child2, rl, k - hi, k - lo)
        }
        leftInside = true
    } else {
        leftInside = rangeMarkIndex(e.child1, rl, false, 0, 0)
        rightInside = rangeMarkIndex(e.child2, rl, false, 0, 0)
    }
    if (known and leftInside and rightInside) { rl.markOp(node_to_ptr(e)) }
    return known
}

// An operand whose value the caller bounds by [lo, hi], which is a bound worth
// carrying only while it stays inside `Int`.
private fn rangeMarkBounded(exprPtr: Ptr, rl: RangeLoop, lo: I64, hi: I64) -> Bool {
    let inside = lo >= rangeIntMin() and hi <= rangeIntMax()
    return rangeMarkIndex(exprPtr, rl, inside, lo, hi)
}

private fn rangeIntMin() -> I64 { return (0 - 2147483647 - 1) as I64 }

private fn rangeIntMax() -> I64 { return 2147483647 as I64 }

impl RangeLoop {
    // The receiver's element base, loaded once here for every proved access to it.
    // The receiver is stable and nothing in the loop moves its block, so the base is
    // the loop's for its whole run; handing it to the access rather than leaving LICM
    // to find it matters because the load otherwise sits in whichever arm of a branch
    // the access is in, where it is not hoisted until after the passes that would
    // have merged the two arms' stores.
    internal fn dataFor(self, list: ASTNode) -> String {
        let mut i = 0
        while (i < self.dataNames.length) {
            let known: String = self.dataNames[i]
            if (known.equals(list.s1)) { return self.dataValues[i].clone() }
            i = i + 1
        }
        let data = ir_get_temp_name(ir_list_data(generateExpression(list)))
        self.dataNames.push(list.s1.clone())
        self.dataValues.push(data.clone())
        return data
    }
}


// A receiver the preheader can read once: a local the body neither rebinds nor
// resizes. A push only grows a list, so a pushed receiver would still be long
// enough -- but its block moves, and the proof is also what licenses reading the
// base once.
internal fn rangeIsStableList(list: ASTNode, rl: RangeLoop) -> Bool {
    if (list.kind != NodeKind.IDENTIFIER_EXPR) { return false }
    if (ir_var_is_global(list.s1) == 1) { return false }
    if (irBodyBindsName(rl.bodyPtr, list.s1)) { return false }
    if (rangeBindsInPattern(rl.bodyPtr, list.s1)) { return false }
    return irBodyPushesList(rl.bodyPtr, list.s1) == false
}

// ---------------------------------------------------------------------------
// Intervals
// ---------------------------------------------------------------------------

// The interval an `Int` expression takes at the point whose spans are row `row`
// of `spans`, into outLo/outHi as i64 values. False when this cannot bound it.
private fn rangeInterval(exprPtr: Ptr, rl: RangeLoop, spans: Vec<Int>, row: Int) -> Bool {
    if (nodeIsNull(exprPtr)) { return false }
    let e = ptr_to_node(exprPtr)
    if (rangeIsIntNode(e) == false) { return false }

    let literal = rangeLiteralValue(e)
    if (literal >= 0) {
        rl.outLo = literal.toString()
        rl.outHi = literal.toString()
        return true
    }
    if (e.kind == NodeKind.IDENTIFIER_EXPR) { return rangeNameInterval(e, rl, spans, row) }
    if (e.kind == NodeKind.UNARY_EXPR and e.s1.equals("-")) {
        if (rangeInterval(e.child1, rl, spans, row) == false) { return false }
        let lo = rl.outLo.clone()
        rl.outLo = ir_get_temp_name(ir_sub("i64", "0", rl.outHi))
        rl.outHi = ir_get_temp_name(ir_sub("i64", "0", lo))
        return true
    }
    if (e.kind == NodeKind.BINARY_EXPR) { return rangeBinaryInterval(e, rl, spans, row) }
    if (rangeIsInvariant(exprPtr, rl)) {
        let value = rangeInvariantValue(e)
        rl.outLo = value.clone()
        rl.outHi = value.clone()
        return true
    }
    return false
}

private fn rangeNameInterval(e: ASTNode, rl: RangeLoop, spans: Vec<Int>, row: Int) -> Bool {
    let letIndex = rl.scopeLet(e.s1)
    if (letIndex >= 0) {
        let decl = irFindDeclInBody(rl.bodyPtr, e.s1)
        if (nodeIsNull(decl)) { return false }
        return rangeInterval(ptr_to_node(decl).child2, rl, rl.letSpans, letIndex)
    }
    let index = rl.varIndex(e.s1)
    if (index >= 0) {
        if (rl.isTracked(index) == false) { return false }
        return rl.varInterval(index, spans, row)
    }
    if (rangeIsInvariantName(e, rl) == false) { return false }
    let value = rangeInvariantValue(e)
    rl.outLo = value.clone()
    rl.outHi = value.clone()
    return true
}

impl RangeLoop {
    // The let in scope under `name`, innermost first, or -1. Only a name declared
    // once in the body is resolved: irFindDeclInBody answers the first declaration,
    // and two would make that answer depend on which one is in scope.
    private fn scopeLet(self, name: String) -> Int {
        let mut k = self.scopeCount - 1
        while (k >= 0) {
            let index = self.scopeLets[k]
            let known: String = self.letNames[index]
            if (known.equals(name)) {
                if (self.letDeclCount(name) != 1) { return 0 - 1 }
                return index
            }
            k = k - 1
        }
        return 0 - 1
    }
}


impl RangeLoop {
    private fn letDeclCount(self, name: String) -> Int {
        let mut count = 0
        for i in 0..<self.letNames.length {
            let known: String = self.letNames[i]
            if (known.equals(name)) { count = count + 1 }
        }
        return count
    }
}


impl RangeLoop {
    // A variable at this point: its head bounds, moved by its span here. An access
    // in the condition sees only the conjuncts before its own, so a bound from a
    // later one -- or from a relation, whose members' bounds are the whole
    // condition's -- is not available there.
    private fn varInterval(self, index: Int, spans: Vec<Int>, row: Int) -> Bool {
        let lowBound: String = self.lows[index]
        let highBound: String = self.highs[index]
        if (lowBound.equals("") or highBound.equals("")) { return false }
        if (self.conjLimit >= 0 and index != self.forVar) {
            if (self.relations[index] != 0) { return false }
            if (self.boundConj[index] >= self.conjLimit) { return false }
        }
        let width = 2 * self.names.length
        let least = spans[row * width + 2 * index]
        let most = spans[row * width + 2 * index + 1]
        self.outLo = self.offset(index, lowBound, least)
        self.outHi = self.offset(index, highBound, most)
        self.usedMask = self.usedMask | rangeShift(index)
        return true
    }
}


impl RangeLoop {
    // `base + delta` units of variable `index`.
    private fn offset(self, index: Int, base: String, delta: Int) -> String {
        if (delta == 0) { return base.clone() }
        let unit: String = self.unitValues[index]
        if (unit.equals("")) { return ir_get_temp_name(ir_add("i64", base, delta.toString())) }
        let scaled = ir_get_temp_name(ir_mul("i64", unit, delta.toString()))
        return ir_get_temp_name(ir_add("i64", base, scaled))
    }
}


private fn rangeBinaryInterval(e: ASTNode, rl: RangeLoop, spans: Vec<Int>, row: Int) -> Bool {
    let op = e.s1
    if (nodeIsNull(e.child1) or nodeIsNull(e.child2)) { return false }
    // `x & m` with `m >= 0` is in [0, m] whatever x is, which is how every
    // power-of-two table is indexed.
    if (op.equals("&")) { return rangeMaskInterval(e, rl) }
    if (op.equals("*") and rangeIsInvariant(node_to_ptr(e), rl)) {
        let value = rangeInvariantValue(e)
        rl.outLo = value.clone()
        rl.outHi = value.clone()
        return true
    }
    if (op.equals("+") == false and op.equals("-") == false and op.equals("*") == false
            and op.equals("/") == false and op.equals("%") == false) {
        return false
    }
    if (op.equals("*") or op.equals("/") or op.equals("%")) {
        return rangeScaledInterval(e, rl, spans, row)
    }
    if (rangeInterval(e.child1, rl, spans, row) == false) { return false }
    let aLo = rl.outLo.clone()
    let aHi = rl.outHi.clone()
    if (rangeInterval(e.child2, rl, spans, row) == false) { return false }
    let bLo = rl.outLo.clone()
    let bHi = rl.outHi.clone()
    if (op.equals("+")) {
        rl.outLo = ir_get_temp_name(ir_add("i64", aLo, bLo))
        rl.outHi = ir_get_temp_name(ir_add("i64", aHi, bHi))
    } else {
        rl.outLo = ir_get_temp_name(ir_sub("i64", aLo, bHi))
        rl.outHi = ir_get_temp_name(ir_sub("i64", aHi, bLo))
    }
    return true
}

// `a * c`, `c * a`, `a / c` and `a % c` for a positive literal c.
private fn rangeScaledInterval(e: ASTNode, rl: RangeLoop, spans: Vec<Int>, row: Int) -> Bool {
    let op = e.s1
    let mut operand = e.child1
    let mut factor = rangeLiteralValue(ptr_to_node(e.child2))
    if (factor < 0 and op.equals("*")) {
        operand = e.child2
        factor = rangeLiteralValue(ptr_to_node(e.child1))
    }
    if (factor <= 0) { return false }
    if (rangeInterval(operand, rl, spans, row) == false) { return false }
    let aLo = rl.outLo.clone()
    let aHi = rl.outHi.clone()
    let c = factor.toString()
    if (op.equals("*")) {
        rl.outLo = ir_get_temp_name(ir_mul("i64", aLo, c))
        rl.outHi = ir_get_temp_name(ir_mul("i64", aHi, c))
        return true
    }
    // Division and remainder see the operand the loop computed, wrapped, so the
    // interval is only the operand's when the operand stayed inside `Int`.
    let lowOk = ir_get_temp_name(ir_icmp_sge("i64", aLo, RANGE_INT_MIN))
    let highOk = ir_get_temp_name(ir_icmp_sle("i64", aHi, RANGE_INT_MAX))
    let prev = rl.extra.clone()
    rl.extra = ir_get_temp_name(ir_and("i1", prev,
        ir_get_temp_name(ir_and("i1", lowOk, highOk))))
    if (op.equals("/")) {
        rl.outLo = ir_get_temp_name(ir_sdiv("i64", aLo, c))
        rl.outHi = ir_get_temp_name(ir_sdiv("i64", aHi, c))
        return true
    }
    // A remainder takes the dividend's sign and is smaller than the divisor.
    let top = (factor - 1).toString()
    let bottom = (1 - factor).toString()
    rl.outLo = rangeSmax(rangeSmin(aLo, "0"), bottom)
    rl.outHi = rangeSmin(rangeSmax(aHi, "0"), top)
    return true
}

private fn rangeMaskInterval(e: ASTNode, rl: RangeLoop) -> Bool {
    let mut mask = ""
    if (rangeIsInvariant(e.child2, rl)) {
        mask = rangeInvariantValue(ptr_to_node(e.child2))
    } else if (rangeIsInvariant(e.child1, rl)) {
        mask = rangeInvariantValue(ptr_to_node(e.child1))
    }
    if (mask.equals("")) { return false }
    let prev = rl.extra.clone()
    rl.extra = ir_get_temp_name(ir_and("i1", prev,
        ir_get_temp_name(ir_icmp_sge("i64", mask, "0"))))
    rl.outLo = "0"
    rl.outHi = mask.clone()
    return true
}

internal fn rangeSmin(a: String, b: String) -> String {
    ir_call_begin()
    ir_call_arg("i64", a)
    ir_call_arg("i64", b)
    return ir_get_temp_name(ir_call_end("i64", "llvm.smin.i64"))
}

internal fn rangeSmax(a: String, b: String) -> String {
    ir_call_begin()
    ir_call_arg("i64", a)
    ir_call_arg("i64", b)
    return ir_get_temp_name(ir_call_end("i64", "llvm.smax.i64"))
}

// ---------------------------------------------------------------------------
// Invariants
// ---------------------------------------------------------------------------

// An `Int` expression the loop cannot change and the preheader can evaluate
// without a trap it would not have had: literals, invariant locals, `+ - *`,
// negation, and the length of a list the body does not resize. No division --
// evaluated ahead of a loop that might never run, a zero divisor would be one.
private fn rangeIsInvariant(exprPtr: Ptr, rl: RangeLoop) -> Bool {
    if (nodeIsNull(exprPtr)) { return false }
    let e = ptr_to_node(exprPtr)
    if (rangeIsIntNode(e) == false) { return false }
    if (e.kind == NodeKind.LITERAL_EXPR) { return rangeLiteralValue(e) >= 0 }
    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        if (rl.varIndex(e.s1) >= 0) { return false }
        return rangeIsInvariantName(e, rl)
    }
    if (e.kind == NodeKind.UNARY_EXPR and e.s1.equals("-")) {
        return rangeIsInvariant(e.child1, rl)
    }
    if (e.kind == NodeKind.BINARY_EXPR) {
        if (e.s1.equals("+") or e.s1.equals("-") or e.s1.equals("*")) {
            return rangeIsInvariant(e.child1, rl) and rangeIsInvariant(e.child2, rl)
        }
        return false
    }
    if (e.kind == NodeKind.CALL_EXPR and nodeExists(e.child1)
            and ptr_to_node(e.child1).s1.equals("list_len") and nodeExists(e.child2)) {
        let list = ptr_to_node(e.child2)
        if (nodeExists(list.next)) { return false }
        return rangeIsStableList(list, rl)
    }
    return false
}

// An invariant's value, computed in `Int` exactly as the loop computes it and
// widened to i64.
private fn rangeInvariantValue(e: ASTNode) -> String {
    return ir_get_temp_name(ir_sext("i32", generateExpression(e), "i64"))
}
