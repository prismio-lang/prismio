// Lowering statements, and the scope and region unwinding that leaving one implies.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string
import sema.enums

// Whether this match is over an enum with payloads. Sema stamps the variant name
// on every non-wildcard arm of one and on no other kind of match, so one arm
// settles it.
private fn matchBindsPayload(stmt: ASTNode) -> Bool {
    let mut armPtr = stmt.child2
    while (nodeExists(armPtr)) {
        let arm = ptr_to_node(armPtr)
        if (arm.s2.equals("") == false) { return true }
        armPtr = arm.next
    }
    return false
}

// Whether this expression contains the transfer of one payload binding. Sema
// stamps the exact identifier use rather than leaving codegen to reconstruct a
// callee's ownership mode after overload resolution.
private fn expressionMovesName(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let node = ptr_to_node(nodePtr)
    if (node.kind == NodeKind.IDENTIFIER_EXPR
        and node.i3 == 1 and node.s1.equals(name)) {
        return true
    }
    if (expressionMovesName(node.child1, name)) { return true }
    if (expressionMovesName(node.child2, name)) { return true }
    if (expressionMovesName(node.child3, name)) { return true }
    return expressionMovesName(node.next, name)
}

// The index of a direct sink parameter, or -1. Only the parameter itself can
// supply a reuse token in this first slice: a local alias would need liveness
// and provenance beyond the syntactic branch proof below.
private fn sinkParameterIndex(name: String) -> Int {
    if (nodeIsNull(irFunctionDecl)) { return 0 - 1 }
    let func = ptr_to_node(irFunctionDecl)
    let mut paramPtr = func.child1
    let mut index = 0
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        if (param.s1.equals(name) and param.s2.equals("sink")) {
            return index
        }
        index = index + 1
        paramPtr = param.next
    }
    return 0 - 1
}

// A same-tag constructor returned directly from this arm, after every owned
// payload binder has been transferred. Returns the constructor node or none.
// This deliberately rejects intervening statements, a constructor nested under
// another expression, and a tag change: each would need a more general token
// lifetime or field-disposition proof.
private fn reusableArmConstructor(arm: ASTNode, structName: String) -> Ptr {
    if (nodeIsNull(arm.child2)) { return ptr_null() }
    let block = ptr_to_node(arm.child2)
    if (nodeIsNull(block.child1)) { return ptr_null() }
    let ret = ptr_to_node(block.child1)
    if (ret.kind != NodeKind.RETURN_STATEMENT or nodeExists(ret.next)
        or nodeIsNull(ret.child1)) {
        return ptr_null()
    }

    let constructor = ptr_to_node(ret.child1)
    if (constructor.kind != NodeKind.STRUCT_LITERAL_EXPR
        or constructor.s1.equals(structName) == false) {
        return ptr_null()
    }

    // Payload enum constructors always carry `$tag` as a literal field. Match
    // it to the arm tag rather than relying on every variant having today's
    // tagged-product size.
    let mut sameTag = false
    let mut fieldPtr = constructor.child1
    while (nodeExists(fieldPtr)) {
        let field = ptr_to_node(fieldPtr)
        if (field.s1.equals("$tag") and nodeExists(field.child1)) {
            let tag = ptr_to_node(field.child1)
            if (tag.kind == NodeKind.LITERAL_EXPR
                and tag.s1.equals(strFromInt(arm.i1))) {
                sameTag = true
            }
        }
        fieldPtr = field.next
    }
    if (sameTag == false) { return ptr_null() }

    let pattern = ptr_to_node(arm.child1)
    if (pattern.kind == NodeKind.CALL_EXPR) {
        let mut binderPtr = pattern.child2
        while (nodeExists(binderPtr)) {
            let binder = ptr_to_node(binderPtr)
            if (typeIsMoveOnly(nodeGetType(binder))
                and expressionMovesName(ret.child1, binder.s1) == false) {
                return ptr_null()
            }
            binderPtr = binder.next
        }
    }
    return ret.child1
}

// Arms are generated one at a time, which makes the reuse token naturally
// frame-limited. The expression consumes irReuseValue on its first use.
private fn beginArmReuse(stmt: ASTNode, arm: ASTNode, structName: String) {
    irReuseValue = ""
    let scrutinee = ptr_to_node(stmt.child1)
    if (scrutinee.kind != NodeKind.IDENTIFIER_EXPR) { return }
    let paramIndex = sinkParameterIndex(scrutinee.s1)
    if (paramIndex < 0) { return }

    let func = ptr_to_node(irFunctionDecl)
    if (aif_param_reusable(functionSymbolName(func), paramIndex) == 0) { return }

    let constructorPtr = reusableArmConstructor(arm, structName)
    if (nodeIsNull(constructorPtr)) { return }
    ptr_to_node(constructorPtr).i3 = 2
    irReuseValue = stmt.s1
}

// Binds the names a variant pattern introduced, by loading the payload fields
// this arm's variant occupies.
private fn generatePayloadBinders(arm: ASTNode, structName: String, scrutVal: String) {
    let pattern = ptr_to_node(arm.child1)
    if (pattern.kind != NodeKind.CALL_EXPR) { return }

    let mut binder = pattern.child2
    let mut index = 0
    while (nodeExists(binder)) {
        let name = ptr_to_node(binder)
        // enumPayloadField is sema's, and is called rather than copied because
        // the two ends have to agree on the spelling exactly -- a second copy of
        // the rule is a second thing to keep in step.
        let fieldName = enumPayloadField(arm.s2, index)
        let fieldType = fieldStorageType(ir_get_struct_field_type(structName, fieldName))
        let fieldIndex = ir_get_struct_field_index(structName, fieldName)
        let slot = ir_struct_field_ptr(structName, scrutVal, fieldIndex)

        // The same rule as a field read in expr.psm: an inline struct field *is*
        // its storage, so the GEP already is the value, and loading it would read
        // the struct rather than address it.
        let mut payloadVal = ir_get_temp_name(slot)
        if (isValueStructKey(fieldType)) {
            // Built-in aggregates are values like scalars, despite their keys
            // naming structs -- see the same test in expr.psm's field read.
            payloadVal = ir_get_temp_name(ir_struct_load_ptr(fieldType, ir_get_temp_name(slot),
                                                             structName, fieldIndex))
        } else if (isStructTypeKey(fieldType) == false) {
            payloadVal = ir_get_temp_name(ir_struct_load_ptr(fieldType, ir_get_temp_name(slot),
                                                             structName, fieldIndex))
        }

        ir_set_var_type(name.s1, fieldType)
        ir_alloca(storageType(fieldType), ir_get_var_slot(name.s1))
        ir_store(storageType(fieldType), payloadVal, ir_get_var_slot(name.s1))


        index = index + 1
        binder = name.next
    }
}

// A terminal constant-string dispatch arm:
//
//     if (name.equals("literal")) { return value }
//
// Method checking has already rewritten the call to `equals(name, literal)`
// and stamped its resolved symbol on s2. Requiring that exact symbol avoids
// capturing an unrelated user method called `equals`; requiring a one-return
// body makes reordering the mutually-exclusive tests semantics-preserving.
// The subject is returned as the capability token for the chain, or empty when
// this statement is not an optimisable arm.
private fn stringDispatchSubject(stmt: ASTNode) -> String {
    if (stmt.kind != NodeKind.IF_STATEMENT or nodeExists(stmt.child3)
        or nodeIsNull(stmt.child1) or nodeIsNull(stmt.child2)) {
        return ""
    }

    let cond = ptr_to_node(stmt.child1)
    if (cond.kind != NodeKind.CALL_EXPR
        or cond.s2.equals("equals__String_String") == false
        or nodeIsNull(cond.child2)) {
        return ""
    }

    let subject = ptr_to_node(cond.child2)
    if (subject.kind != NodeKind.IDENTIFIER_EXPR or nodeIsNull(subject.next)) {
        return ""
    }
    let literal = ptr_to_node(subject.next)
    if (nodeIsStringLiteralExpr(subject.next) == false or nodeExists(literal.next)) {
        return ""
    }

    let body = ptr_to_node(stmt.child2)
    if (nodeIsNull(body.child1)) { return "" }
    let only = ptr_to_node(body.child1)
    if (only.kind != NodeKind.RETURN_STATEMENT or nodeExists(only.next)) {
        return ""
    }
    return subject.s1
}

private fn stringDispatchLiteral(stmt: ASTNode) -> ASTNode {
    let cond = ptr_to_node(stmt.child1)
    let subject = ptr_to_node(cond.child2)
    return ptr_to_node(subject.next)
}

private fn stringDispatchCount(firstPtr: Ptr, subject: String) -> Int {
    let mut count = 0
    let mut current = firstPtr
    while (nodeExists(current)) {
        let armSubject = stringDispatchSubject(ptr_to_node(current))
        if (armSubject.equals(subject) == false) { break }
        count = count + 1
        current = ptr_to_node(current).next
    }
    return count
}

private fn stringDispatchLengthSeen(lengths: Vec<Int>, wanted: Int) -> Bool {
    for i in 0..<list_len(lengths) {
        if (list_get(lengths, i) == wanted) { return true }
    }
    return false
}

private fn stringDispatchByteSeen(values: Vec<Int>, wanted: Int) -> Bool {
    for i in 0..<list_len(values) {
        if (list_get(values, i) == wanted) { return true }
    }
    return false
}

// gperf's useful idea without its table: choose the byte position that splits
// this equal-length bucket into the most classes. The length check makes every
// position safe to read, and the full literal comparison below remains the
// proof for strings outside the static set that happen to share the chosen byte.
private fn stringDispatchBestByte(firstPtr: Ptr, count: Int, length: Int) -> Int {
    let mut bestPosition = -1
    let mut bestClasses = 1
    for position in 0..<length {
        let mut values: Vec<Int> = list_new()
        let mut scan = firstPtr
        repeat(count) {
            let literal = stringDispatchLiteral(ptr_to_node(scan))
            if (__builtin_string_len(literal.s1) == length) {
                let byte = charCode(literal.s1.charAt(position))
                if (stringDispatchByteSeen(values, byte) == false) {
                    list_push(values, byte)
                }
            }
            scan = ptr_to_node(scan).next
        }
        if (list_len(values) > bestClasses) {
            bestClasses = list_len(values)
            bestPosition = position
        }
    }
    return bestPosition
}

private fn generateStringDispatchCandidates(firstPtr: Ptr, count: Int,
                                             subjectValue: String, length: Int,
                                             bytePosition: Int, byteValue: Int,
                                             defaultLabel: Int) {
    let mut scan = firstPtr
    repeat(count) {
        let arm = ptr_to_node(scan)
        let literal = stringDispatchLiteral(arm)
        let matchesLength = __builtin_string_len(literal.s1) == length
        let mut matchesByte = true
        if (matchesLength and bytePosition >= 0) {
            matchesByte = charCode(literal.s1.charAt(bytePosition)) == byteValue
        }
        if (matchesLength and matchesByte) {
            debugAt(arm)
            let equal = ir_get_temp_name(ir_str_eq_literal(subjectValue, literal.s1))
            let bodyLabel = ir_get_label()
            let nextLabel = ir_get_label()
            ir_cond_br_numbered(equal, bodyLabel, nextLabel)

            ir_label_numbered(bodyLabel)
            generateBlock(ptr_to_node(arm.child2))
            if (ir_has_returned() == 0) { ir_br_numbered(defaultLabel) }
            ir_clear_returned()
            ir_label_numbered(nextLabel)
        }
        scan = arm.next
    }
    ir_br_numbered(defaultLabel)
}

// Emit one length switch for a run of terminal String.equals literal arms.
// LLVM receives the case set as an integer switch, so dense lengths become a
// jump table. Within a bucket the original source order is retained and only
// literals of the already-matched length need content comparisons.
private fn generateStringDispatch(firstPtr: Ptr, count: Int) -> Ptr {
    let first = ptr_to_node(firstPtr)
    let firstCond = ptr_to_node(first.child1)
    let firstSubject = ptr_to_node(firstCond.child2)
    let subjectValue = generateExpression(firstSubject)
    let wide = ir_get_temp_name(ir_extract_value("struct:prismio.str", subjectValue, 1))
    let narrow = ir_get_temp_name(ir_trunc("i64", wide, "i32"))
    let lengthValue = ir_get_temp_name(ir_and("i32", narrow, "2147483647"))

    let mut lengths: Vec<Int> = list_new()
    let mut labels: Vec<Int> = list_new()
    let mut scan = firstPtr
    let mut scanned = 0
    while (scanned < count) {
        let literal = stringDispatchLiteral(ptr_to_node(scan))
        let length = __builtin_string_len(literal.s1)
        if (stringDispatchLengthSeen(lengths, length) == false) {
            list_push(lengths, length)
            list_push(labels, ir_get_label())
        }
        scan = ptr_to_node(scan).next
        scanned = scanned + 1
    }

    let defaultLabel = ir_get_label()
    let switchId = ir_switch_begin(lengthValue, defaultLabel, list_len(lengths))
    let mut group = 0
    while (group < list_len(lengths)) {
        ir_switch_case(switchId, list_get(lengths, group), list_get(labels, group))
        group = group + 1
    }

    group = 0
    while (group < list_len(lengths)) {
        let groupLength = list_get(lengths, group)
        ir_label_numbered(list_get(labels, group))

        let bytePosition = stringDispatchBestByte(firstPtr, count, groupLength)
        if (bytePosition < 0) {
            generateStringDispatchCandidates(firstPtr, count, subjectValue,
                                             groupLength, -1, 0, defaultLabel)
        } else {
            let mut rawByte = 0
            if (groupLength > 12) {
                rawByte = ir_str_byte_at_long(subjectValue, bytePosition)
            } else {
                rawByte = ir_str_byte_at(subjectValue, strFromInt(bytePosition))
            }
            let byte8 = ir_get_temp_name(rawByte)
            let byte32 = ir_get_temp_name(ir_zext("i8", byte8, "i32"))
            let mut byteValues: Vec<Int> = list_new()
            let mut byteLabels: Vec<Int> = list_new()

            scan = firstPtr
            scanned = 0
            while (scanned < count) {
                let literal = stringDispatchLiteral(ptr_to_node(scan))
                if (__builtin_string_len(literal.s1) == groupLength) {
                    let byte = charCode(literal.s1.charAt(bytePosition))
                    if (stringDispatchByteSeen(byteValues, byte) == false) {
                        list_push(byteValues, byte)
                        list_push(byteLabels, ir_get_label())
                    }
                }
                scan = ptr_to_node(scan).next
                scanned = scanned + 1
            }

            let byteSwitch = ir_switch_begin(byte32, defaultLabel, list_len(byteValues))
            let mut byteGroup = 0
            while (byteGroup < list_len(byteValues)) {
                ir_switch_case(byteSwitch, list_get(byteValues, byteGroup),
                               list_get(byteLabels, byteGroup))
                byteGroup = byteGroup + 1
            }
            byteGroup = 0
            while (byteGroup < list_len(byteValues)) {
                ir_label_numbered(list_get(byteLabels, byteGroup))
                generateStringDispatchCandidates(firstPtr, count, subjectValue,
                                                 groupLength, bytePosition,
                                                 list_get(byteValues, byteGroup),
                                                 defaultLabel)
                byteGroup = byteGroup + 1
            }
        }
        group = group + 1
    }

    ir_label_numbered(defaultLabel)
    return scan
}


// A struct literal AIF placed on the frame, of a type whose fields own what
// they hold. Nothing else releases those fields: once some object of the type is
// reclaimed, a value stored into an owning field has no other owner (AIF's
// site_in_released_field) -- including one stored into a frame instance, since
// the field's points-to set is the type's and not the object's. A heap object
// gets `__aif_release_T`; this one gets the same field walk without the free.
//
// A type no object of which is ever reclaimed bars nobody, so its values keep
// the owners they had and this must not become a second one.
//
// Only a whole-program build: the fields-only release is defined by the module
// that names it, and a library's facts about a type are not the program's.
private fn frameStructOwnsFields(init: Ptr) -> Bool {
    if (isFrameStructLiteral(init) == false) { return false }
    if (irWholeProgram() == false) { return false }
    let node = ptr_to_node(init)
    return aif_type_releases(node.s1) == 1 and aif_type_is_reclaimed(node.s1) == 1
}

private fn isFrameStructLiteral(init: Ptr) -> Bool {
    if (nodeIsNull(init)) { return false }
    if (ptr_to_node(init).kind != NodeKind.STRUCT_LITERAL_EXPR) { return false }
    if (aif_arena_at_node(init) == 1) { return false }
    return aif_tier_at_node(init) == AIF_TIER_T0
}

private fn frameStructKey(slot: String, floor: Int) -> String {
    return ";".concat(slot, "@", floor.toString(), ";")
}

// `s.field = value` where `s` is a frame struct declared in this very block, of
// a type none of whose objects is reclaimed. Its fields are owned by whatever
// owned them before they were stored -- a binding, or the hidden one a literal's
// owned temporary was given -- so an owned temporary assigned here gets the
// same: a hidden binding, released when this block exits, which is when `s`
// dies. The value it displaces keeps its own owner, so nothing is released
// early and a view of the old value stays good.
//
// The same block, because a hidden binding is dropped at the exit of the scope
// it is made in; made in a nested block or a loop body, it would free a value
// `s` still holds.
private fn frameFieldAssignmentNeedsOwner(objectNode: ASTNode, structName: String) -> Bool {
    if (objectNode.kind != NodeKind.IDENTIFIER_EXPR) { return false }
    if (aif_type_is_reclaimed(structName) == 1) { return false }
    let key = frameStructKey(ir_get_var_slot(objectNode.s1), ir_scope_drop_floor())
    return irFrameStructSlots.contains(key)
}

private fn generateVariableDecl(stmt: ASTNode) {
    let varName = stmt.s1
    let mut varType = "i32"
    if (nodeExists(stmt.child1)) {
        let typeNode = ptr_to_node(stmt.child1)
        varType = mapTypeNode(typeNode)
    } else {
        if (nodeExists(stmt.child2)) {
            varType = getExprType(ptr_to_node(stmt.child2))
        }
    }

    // The initializer is generated before the binding is declared, so that
    // `let x = x + 1` reads the *outer* x rather than the one being defined.
    let mut initVal = ""
    let hasInit = nodeExists(stmt.child2)
    if (hasInit) {
        initVal = generateExpression(ptr_to_node(stmt.child2))
        // `let b = a` for an array whose length is known: storage of b's own,
        // not a second name for a's. A literal already is fresh storage.
        let declT = nodeGetType(stmt)
        if (typeArrayCopies(declT)
                and ptr_to_node(stmt.child2).kind != NodeKind.ARRAY_LITERAL_EXPR) {
            let elemType = storageType(typeIrKey(ptr_to_type(declT.child)))
            initVal = ir_get_temp_name(ir_array_copy(elemType, declT.length, initVal))
        }
    }

    // A fresh binding with its own slot. Two `let x` in sibling blocks get
    // separate stack slots, so they can hold different types without one
    // being written through a slot sized for the other.
    ir_set_var_type(varName, varType)
    let slot = ir_get_var_slot(varName)
    let storeType = storageType(varType)
    ir_alloca(storeType, slot)

    // Declared here rather than after the store: the alloca is what the
    // variable *is*, and a debugger stopped between the two should report the
    // slot with whatever is in it, not report the name as unknown. The slot
    // is uninitialised until the store lands, which is the same window C has
    // and the same one it does not describe either.
    debugLocal(varName, slot, varType, debugTypeName(stmt.child1, stmt.child2), stmt, 0)

    // `let m: Array<U32, 16>`: the frame storage an array literal would get,
    // zeroed where the declaration runs, and its address in the binding's slot.
    if (hasInit == false and nodeExists(stmt.child1)) {
        let typeNode = ptr_to_node(stmt.child1)
        if (typeNode.i1 == 1 and nodeExists(typeNode.child2)) {
            let count = typeIntLiteralCount(ptr_to_node(typeNode.child2).s1)
            let arrT = nodeGetType(stmt)
            let elemType = storageType(typeIrKey(ptr_to_type(arrT.child)))
            let base = ir_get_temp_name(ir_array_alloca_zeroed(elemType, count))
            ir_store(storeType, base, slot)
        }
    }

    if (hasInit) {
        // AIF Level 4, the reassignment half. An owning accumulator's slot
        // holds memory the binding owns at *every* point, not only at the
        // scope exit, and that is what licenses the release in the assignment
        // below. A literal initialiser is the one thing that would break the
        // invariant on the binding's first line -- `let mut s = ""` must not
        // put a borrowed .rodata pointer in a slot whose next assignment
        // releases it. Short literals use the value-owned inline form;
        // longer ones need one heap clone per binding, not per iteration.
        let accumulates = irOwningAccumulator(varName)
            and nodeProducesOwnedValue(stmt.child2)
        if (accumulates and nodeIsStringLiteralExpr(stmt.child2)) {
            initVal = generateOwnedStringLiteral(initVal, stmt.child2)
        }

        ir_store(storeType, initVal, slot)

        // Resolve the German-string representation once, here, where the
        // binding is made and therefore where it dominates every use. A byte
        // loop over this string then indexes a pointer instead of asking per
        // character which half of the pair holds the byte -- five
        // instructions the tokenizer used to pay 204 000 times. Immutable
        // bindings only: see `data_ptr` in runtime/ir_symbols.c.
        if (isFatStringKey(storeType) and stmt.i1 == 0) {
            ir_set_var_data(varName, ir_str_data(initVal))
        }

        // Every accumulator owns what its slot holds. Whether the *last*
        // value is this scope's to drop is the separate question below.
        if (accumulates) { ir_mark_owns_slot(varName) }

        // REQUIREMENTS 15. The task handle is the runtime's own struct and
        // it had no owner at all: `prismio_task_release` existed and codegen
        // never emitted it, so every `spawn` leaked one handle. g9 made that
        // visible -- 8,201 allocations against 23 frees under allocount --
        // because it is the first corpus program that spawns in a loop.
        //
        // **Released at the scope exit and not at the join**, which is the
        // difference between this being sound and not. A handle is copyable
        // and the language does not stop a program joining twice; the
        // runtime guards the second *wait* but could not guard a second read
        // of freed memory. The scope exit runs once however many joins there
        // were, and after all of them.
        //
        // The premise is AIF's, not a new one: `i1` is set only when
        // INFERENCE 4.1's E-SPAWN-J proved the task is joined on every path
        // before this scope exits, so at the exit the thread has finished and
        // the handle is dead. A spawn that was not proved joined keeps the
        // old behaviour and leaks, which is the conservative direction --
        // freeing a handle a running task still writes its result into is
        // the failure this must not have.
        if (nodeExists(stmt.child2)
                and ptr_to_node(stmt.child2).kind == NodeKind.SPAWN_EXPR
            and ptr_to_node(stmt.child2).i1 == 1
            and chainAssignsName(irFunctionBody, varName) == false
            and chainReturnsName(irFunctionBody, varName) == false
            and chainCopiesName(irFunctionBody, varName) == false) {
            ir_mark_droppable(varName, IR_DROP_TASK)
        } else if (aif_frees_at_scope_node(stmt.child2) == 1
            and nodeGetType(stmt).kind != TypeKind.ARRAY
            and chainAssignsName(irFunctionBody, varName) == false
            and chainDropsName(irFunctionBody, varName) == false) {
            // `drop(x)` already freed it, so a scope release as well is a
            // double free. Asked of the binding rather than of the site,
            // because one site backs every `concat` in the program and
            // answering it there suppressed the release of every other
            // binding too -- see aif_frees_at_scope_node.
            ir_mark_droppable(varName, dropKindOf(ptr_to_node(stmt.child2)))
        } else if (accumulates and chainReturnsName(irFunctionBody, varName) == false) {
            // The last value an accumulator holds needs an owner too, and the
            // assignments only ever release what they displace. A returned
            // binding hands that one to the caller -- the same reason the
            // branch above declines a returned value -- so this is every
            // other case.
            ir_mark_droppable(varName, dropKindOf(ptr_to_node(stmt.child2)))
        } else if (frameStructOwnsFields(stmt.child2)
            and chainAssignsName(irFunctionBody, varName) == false
            and chainDropsName(irFunctionBody, varName) == false) {
            ir_mark_droppable(varName, IR_DROP_FIELDS)
            let typeName = structTypeName(getExprType(ptr_to_node(stmt.child2)))
            if (irFrameReleaseTypes.contains(";".concat(typeName, ";")) == false) {
                irFrameReleaseTypes = irFrameReleaseTypes.concat(";", typeName, ";")
            }
        } else {
            // AIF item 3. The initialiser is not an allocation here -- it is a
            // call to a function that made one and handed it over. That is the
            // ownership the escape lattice cannot express, so it is asked of
            // the converged facts (the callee kept nothing, and allocated what
            // it returned) plus the two syntactic guards the facts leave open.
            // An array is frame storage -- a returned one was copied into this
            // frame above -- so nothing here is the deallocator's.
            let owned = aif_owns_call_result_at_node(stmt.child2)
            if (owned != AIF_ELEM_NONE
                    and nodeGetType(stmt).kind != TypeKind.ARRAY
                    and chainAssignsName(irFunctionBody, varName) == false
                and chainReturnsName(irFunctionBody, varName) == false
                and chainDropsName(irFunctionBody, varName) == false
                and chainEscapesThroughCall(irFunctionBody, varName) == false) {
                if (nodeGetType(ptr_to_node(stmt.child2)).kind == TypeKind.DATAVIEW) {
                    ir_mark_droppable(varName, IR_DROP_DATAVIEW)
                } else if (owned == AIF_ELEM_LIST) {
                    ir_mark_droppable(varName, IR_DROP_LIST)
                } else if (owned == AIF_ELEM_TYPED) {
                    ir_mark_droppable(varName, IR_DROP_TYPED)
                } else {
                    ir_mark_droppable(varName, IR_DROP_OBJECT)
                }
            }
        }
    }
    // Not one the function reassigns: after `s = other`, `s.f` is a field of
    // another object, which may outlive this block.
    if (hasInit and isFrameStructLiteral(stmt.child2)
            and chainAssignsName(irFunctionBody, varName) == false) {
        irFrameStructSlots = irFrameStructSlots.concat(
            frameStructKey(ir_get_var_slot(varName), ir_scope_drop_floor()))
    }
}

private fn generateAssignment(stmt: ASTNode) {
    let targetNode = ptr_to_node(stmt.child1)
    if (targetNode.kind == NodeKind.IDENTIFIER_EXPR) {
        let varName = targetNode.s1
        let mut varType = ir_get_var_type(varName)
        let storeType = storageType(varType)

        // AIF Level 4, the reassignment half. Droppable means the slot owns
        // its contents, so a store into it displaces a value with no other
        // owner -- and until this existed, that value had none at all. It is
        // the same fact the scope exit reads, asked through the binding rather
        // than recomputed from the declaration's reasoning, because two
        // answers to "does this binding own what it holds" is exactly how a
        // value ends up unowned.
        //
        // The old pointer is read before the right-hand side is generated,
        // and freed after: `out = out.concat(x)` passes the displaced
        // value *into* the call that replaces it, so releasing it any earlier
        // frees the argument being read.
        let releasesOld = ir_var_is_global(varName) == 0
            and ir_binding_owns_slot(varName) == 1
        let mut old = ""
        if (releasesOld) {
            old = ir_get_temp_name(ir_load(storeType, ir_get_var_slot(varName)))
        }

        // A uniquely-owned String accumulator can hand its old buffer to
        // the replacement concat. The helper returns empty for every other
        // expression shape, which then takes the ordinary immutable path.
        let mut consumedOld = false
        let mut val = ""
        if (releasesOld and storeType.equals("struct:prismio.str")) {
            val = generateStringReinitConcat(stmt.child2, varName, old)
            consumedOld = val.equals("") == false
        }
        if (consumedOld == false) {
            val = generateExpression(ptr_to_node(stmt.child2))
        }
        // The same clone the declaration makes, for the same reason and it
        // was not obvious that both needed it: a literal stored here leaves
        // .rodata in a slot the *next* assignment frees. That is what aborted
        // the compiler's own --verify build, one generation after the
        // declaration alone looked sufficient.
        if (releasesOld and nodeIsStringLiteralExpr(stmt.child2)) {
            val = generateOwnedStringLiteral(val, stmt.child2)
        }
        if (ir_var_is_global(varName) == 1) {
            ir_store_global(storeType, val, varName)
        } else {
            if (releasesOld and consumedOld == false) {
                generateDisplacedRelease(old, val, dropKindOf(ptr_to_node(stmt.child2)), varType)
            }
            // An array whose length is known keeps its own storage: `d = c`
            // copies c's elements in rather than re-pointing d at c's.
            let targetT = nodeGetType(targetNode)
            if (typeArrayCopies(targetT)) {
                let dst = ir_get_temp_name(ir_load(storeType, ir_get_var_slot(varName)))
                let elemType = storageType(typeIrKey(ptr_to_type(targetT.child)))
                ir_array_copy_into(elemType, targetT.length, dst, val)
            } else {
                ir_store(storeType, val, ir_get_var_slot(varName))
            }
        }
    }
    // `a[i] = v` on an array: sema has turned every other collection's store
    // into a call and admits only elements nobody owns, so this is the address
    // generateIndex reads through, and a plain store with no release.
    if (targetNode.kind == NodeKind.INDEX_EXPR) {
        let arrayVal = generateExpression(ptr_to_node(targetNode.child1))
        let indexVal = generateExpression(ptr_to_node(targetNode.child2))
        let elemType = storageType(getExprType(targetNode))
        let val = generateExpression(ptr_to_node(stmt.child2))
        let slot = ir_elem_ptr(elemType, arrayVal, indexVal)
        ir_store_ptr(elemType, val, ir_get_temp_name(slot))
    }
    if (targetNode.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let objectNode = ptr_to_node(targetNode.child1)

        // M4.3c. A DataElement assignment follows the same late column
        // resolution as a read. The descriptor remains `(view, index)`;
        // only this store obtains an interior pointer, and it is consumed
        // immediately. Nested writes such as `row.pair.low = value` use
        // the ordinary struct-field path below after the `row.pair` read
        // returns that column element's inline storage.
        if (nodeHasType(objectNode) and nodeGetType(objectNode).kind == TypeKind.DATAELEMENT) {
            let elemT = nodeGetType(objectNode)
            let rowT = ptr_to_type(elemT.child)
            let structName = rowT.name
            let fieldIndex = ir_get_struct_field_index(structName, targetNode.s1)
            let fieldType = fieldStorageType(ir_get_struct_field_type(structName, targetNode.s1))
            let descriptor = generateExpression(objectNode)
            let view = ir_get_temp_name(ir_extract_value("struct:prismio.data_element",
                                                         descriptor, 0))
            let index = ir_get_temp_name(ir_extract_value("struct:prismio.data_element",
                                                          descriptor, 1))
            ir_call_begin()
            ir_call_arg("ptr", view)
            ir_call_arg("i32", strFromInt(fieldIndex))
            let column = ir_get_temp_name(ir_call_end("ptr", "data_view_column"))
            let slot = ir_get_temp_name(ir_elem_ptr(fieldType, column, index))
            let val = generateExpression(ptr_to_node(stmt.child2))

            irProfileField(structName, targetNode.s1, true)
            irProfileRange(structName, targetNode.s1, fieldType, val)
            // DataView eligibility rejects counted fields, so there is no
            // retain/release path here. Flat nested structs occupy the
            // column element itself and therefore need a value copy.
            if (isStructTypeKey(fieldType) and isValueStructKey(fieldType) == false) {
                ir_copy_struct(structTypeName(fieldType), slot, val)
            } else {
                ir_data_store_ptr(fieldType, val, slot, structName, fieldIndex)
            }
            return
        }

        let objectVal = generateExpression(objectNode)
        let objectType = getExprType(objectNode)
        let structName = structTypeName(objectType)
        let fieldIndex = ir_get_struct_field_index(structName, targetNode.s1)
        let fieldType = fieldStorageType(ir_get_struct_field_type(structName, targetNode.s1))
        let val = generateExpression(ptr_to_node(stmt.child2))
        if (frameFieldAssignmentNeedsOwner(objectNode, structName)) {
            spillOwnedFieldTemporary(ptr_to_node(stmt.child2), val)
        }

        let slot = ir_struct_field_ptr(structName, objectVal, fieldIndex)
        irProfileField(structName, targetNode.s1, true)
        irProfileRange(structName, targetNode.s1, fieldType, val)
        // CYCLES 3, the assignment half. Retain before releasing, so a store
        // of a value into the slot it already occupies does not free it
        // between the two.
        if (aif_field_is_counted(structName, targetNode.s1) == 1) {
            let old = ir_get_temp_name(ir_struct_load_ptr("ptr", ir_get_temp_name(slot),
                                                          structName, fieldIndex))
            ir_call_begin()
            ir_call_arg("ptr", val)
            ir_call_end("void", "cyc_retain")
            ir_call_begin()
            ir_call_arg("ptr", old)
            ir_call_end("void", "cyc_release")
        }
        // Assigning an inline field overwrites storage rather than swapping
        // an address, so it copies. A counted field is never inline: the
        // count sits in a header in front of an allocation, and an inline
        // field has no allocation of its own to put one in front of. An array
        // field is the same: its elements are copied in.
        if (isArrayValueKey(fieldType)) {
            ir_array_copy_key(fieldType, ir_get_temp_name(slot), val)
        } else if (isStructTypeKey(fieldType) and isValueStructKey(fieldType) == false) {
            ir_copy_struct(structTypeName(fieldType), ir_get_temp_name(slot), val)
        } else {
            ir_struct_store_ptr(fieldType, val, ir_get_temp_name(slot),
                                structName, fieldIndex)
        }
    }
    if (targetNode.kind == NodeKind.IDENTIFIER_EXPR
            and targetNode.s1.equals(irLoopHeaderBoundIndex)) {
        irLoopHeaderBoundActive = false
    }
}

private fn generateReturn(stmt: ASTNode) {
    // Every scope in the function unwinds at once, so the floor is 0. The
    // returned value is never among them: returning it puts its escape at
    // Caller, and nothing with that escape is droppable here.
    if (nodeExists(stmt.child1)) {
        let mut retVal = generateExpression(ptr_to_node(stmt.child1))
        let mut retType = storageType(getExprType(ptr_to_node(stmt.child1)))
        // `-> Array<T, N>`: the elements leave by value, loaded out of a frame
        // that is about to go.
        if (nodeExists(irFunctionDecl)) {
            let arrayReturn = irArrayReturnKey(ptr_to_node(irFunctionDecl))
            if (arrayReturn.equals("") == false) {
                retVal = ir_get_temp_name(ir_array_load(arrayReturn, retVal))
                retType = arrayReturn
            }
        }
        generateScopeDrops(0)
        generateRegionExits(ir_region_depth())
        ir_ret(retType, retVal)
    } else {
        generateScopeDrops(0)
        generateRegionExits(ir_region_depth())
        ir_ret_void()
    }
    ir_set_returned()
}

private fn generateExpressionStatement(stmt: ASTNode) {
    if (nodeExists(stmt.child1)) {
        generateExpression(ptr_to_node(stmt.child1))
    }
}

private fn generateIf(stmt: ASTNode) {
    let thenLabel = ir_get_label()
    let elseLabel = ir_get_label()
    let endLabel = ir_get_label()

    let condVal = generateExpression(ptr_to_node(stmt.child1))
    if (nodeExists(stmt.child3)) {
        ir_cond_br_numbered(condVal, thenLabel, elseLabel)
    } else {
        ir_cond_br_numbered(condVal, thenLabel, endLabel)
    }

    ir_label_numbered(thenLabel)
    generateBlock(ptr_to_node(stmt.child2))
    if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
    ir_clear_returned()

    if (nodeExists(stmt.child3)) {
        ir_label_numbered(elseLabel)

        let elseNode = ptr_to_node(stmt.child3)
        if (elseNode.kind == NodeKind.IF_STATEMENT) {
            generateStatement(elseNode)
        } else {
            generateBlock(elseNode)
        }
        if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
        ir_clear_returned()
    }

    ir_label_numbered(endLabel)
}

private fn generateWhile(stmt: ASTNode) {
    let endLabel = ir_get_label()

    // M4.2, the loop half. Emitted here because here is the preheader: the
    // guards have to dominate the loop and be computed once.
    let savedGuard = irLoopFlatGuard
    let savedProof = irLoopRangeProof
    let savedPush = irLoopPushGuard
    let savedHeaderList = irLoopHeaderBoundList
    let savedHeaderIndex = irLoopHeaderBoundIndex
    let savedHeaderActive = irLoopHeaderBoundActive
    let savedHoistedBoundList = irLoopHoistedBoundList
    let savedHoistedBoundValue = irLoopHoistedBoundValue
    let savedHoistedDataValue = irLoopHoistedDataValue
    irLoopRangeProof = 0
    irLoopHeaderBoundList = ""
    irLoopHeaderBoundIndex = ""
    irLoopHeaderBoundActive = false
    irLoopHoistedBoundList = ""
    irLoopHoistedBoundValue = ""
    irLoopHoistedDataValue = ""

    // A successful bulk zero append bypasses the loop entirely. Emit it
    // before preparing the ordinary push guard so the fast arm does not
    // pay the fallback loop's duplicate capacity and representation tests.
    generateWholeBufferZeroFill(ptr_to_node(stmt.child1), ptr_to_node(stmt.child2),
                                endLabel)
    irLoopPushGuard = generateLoopPushGuard(ptr_to_node(stmt.child1),
                                            ptr_to_node(stmt.child2))

    // MEM-006, and it has to come first: the block transfer replaces the
    // whole loop, so it is emitted in the preheader before the loop's own
    // guard exists. It leaves the builder in the arm the loop belongs to.
    generateWholeBufferCopy(ptr_to_node(stmt.child1), ptr_to_node(stmt.child2),
                            endLabel)

    let flatSlot = generateLoopFlatGuard(stmt.child1, ptr_to_node(stmt.child2))
    let mut rangeSlot = ""
    let mut proof = 0
    if (flatSlot.equals("") == false or savedGuard.equals("1")) {
        irLoopRangeProofPending = 0
        irLoopRangeProofComplete = false
        rangeSlot = generateWhileRangeGuard(ptr_to_node(stmt.child1),
                                            ptr_to_node(stmt.child2))
        proof = irLoopRangeProofPending
    }
    generateLoopVersions(stmt, endLabel, flatSlot, rangeSlot, proof, savedGuard, "", "")

    irLoopFlatGuard = strClone(savedGuard)
    irLoopRangeProof = savedProof
    irLoopPushGuard = strClone(savedPush)
    irLoopHeaderBoundList = strClone(savedHeaderList)
    irLoopHeaderBoundIndex = strClone(savedHeaderIndex)
    irLoopHeaderBoundActive = savedHeaderActive
    irLoopHoistedBoundList = strClone(savedHoistedBoundList)
    irLoopHoistedBoundValue = strClone(savedHoistedBoundValue)
    irLoopHoistedDataValue = strClone(savedHoistedDataValue)
    ir_label_numbered(endLabel)
}

// The loop once per version its guards ask for. Behind the flat guard, every
// receiver has the representation its static type names; behind the range guard
// within that, every access the proof marked is in range.
//
// A proof that leaves some flat access unproved keeps its facts out of the flat
// guard, in a copy of its own: one access with a loose interval would otherwise
// send the whole loop to the generic copy, and a proof must never cost more than
// the checked flat loop it replaces. A proof that covers every access has nothing
// left for a checked flat copy to serve, so its facts join the flat guard and the
// loop keeps two copies -- a third is code the function pays for in register
// pressure wherever it lives, measured at 7% on a neighbouring fill loop in
// aos_vs_soa that the proof never touched. `plain` is the representation a loop
// with no guard of its own inherits from the one around it.
private fn generateLoopVersions(stmt: ASTNode, endLabel: Int, flatSlot: String,
                                rangeSlot: String, proof: Int, plain: String,
                                forEnd: String, forStep: String) {
    let hasFlat = flatSlot.equals("") == false
    let mut hasRange = rangeSlot.equals("") == false
    let mut fastProof = 0
    if (hasFlat and hasRange and irLoopRangeProofComplete) {
        let both = ir_get_temp_name(ir_and("i1",
            ir_get_temp_name(ir_load("i1", flatSlot)),
            ir_get_temp_name(ir_load("i1", rangeSlot))))
        ir_store("i1", both, flatSlot)
        hasRange = false
        fastProof = proof
    }
    let genericLabel = ir_get_label()
    if (hasFlat) {
        let flatLabel = ir_get_label()
        ir_cond_br_numbered(ir_get_temp_name(ir_load("i1", flatSlot)), flatLabel, genericLabel)
        ir_label_numbered(flatLabel)
    }
    if (hasRange) {
        let provedLabel = ir_get_label()
        let checkedLabel = ir_get_label()
        ir_cond_br_numbered(ir_get_temp_name(ir_load("i1", rangeSlot)), provedLabel,
                            checkedLabel)
        generateLoopCopy(stmt, provedLabel, endLabel, "1", proof, forEnd, forStep)
        generateLoopCopy(stmt, checkedLabel, endLabel, "1", 0, forEnd, forStep)
    } else if (hasFlat) {
        let flatCopy = ir_get_label()
        ir_br_numbered(flatCopy)
        generateLoopCopy(stmt, flatCopy, endLabel, "1", fastProof, forEnd, forStep)
    }
    if (hasFlat) {
        generateLoopCopy(stmt, genericLabel, endLabel, "", 0, forEnd, forStep)
    }
    if (hasFlat == false and hasRange == false) {
        ir_br_numbered(genericLabel)
        generateLoopCopy(stmt, genericLabel, endLabel, plain, 0, forEnd, forStep)
    }
}

// One copy of a `while` or a range `for`, entered at `entryLabel`, with the
// representation fact `flat` and range proof `proof` in force for its accesses.
private fn generateLoopCopy(stmt: ASTNode, entryLabel: Int, endLabel: Int, flat: String,
                            proof: Int, forEnd: String, forStep: String) {
    irLoopFlatGuard = strClone(flat)
    irLoopRangeProof = proof
    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        if (forIsGeneral(stmt)) {
            generateForGeneralCopy(stmt, entryLabel, endLabel, forEnd, forStep)
        } else {
            generateForCopy(stmt, entryLabel, endLabel, forEnd)
        }
        return
    }
    let bodyLabel = ir_get_label()
    ir_label_numbered(entryLabel)
    let condVal = generateExpression(ptr_to_node(stmt.child1))
    ir_cond_br_numbered(condVal, bodyLabel, endLabel)

    ir_label_numbered(bodyLabel)
    irLoopHeaderBoundActive = irLoopHeaderBoundList.equals("") == false
    irLoopEnter(stmt, entryLabel, endLabel)
    irLoopDepth = irLoopDepth + 1
    generateBlock(ptr_to_node(stmt.child2))
    irLoopDepth = irLoopDepth - 1
    irLoopExit()

    if (ir_has_returned() == 0) { ir_br_numbered(entryLabel) }
    ir_clear_returned()
}

private fn generateLoop(stmt: ASTNode) {
    let bodyLabel = ir_get_label()
    let endLabel = ir_get_label()

    ir_br_numbered(bodyLabel)
    ir_label_numbered(bodyLabel)
    irLoopEnter(stmt, bodyLabel, endLabel)
    generateBlock(ptr_to_node(stmt.child1))
    irLoopExit()

    if (ir_has_returned() == 0) { ir_br_numbered(bodyLabel) }
    ir_clear_returned()

    ir_label_numbered(endLabel)
}

// Every loop enters its body through here, so a label is recorded on the same
// stack entry the unlabelled break and continue read: `outer@ while` and
// `outer@ for` differ only in which labels they pass.
private fn irLoopEnter(stmt: ASTNode, continueLabel: Int, breakLabel: Int) {
    ir_loop_push(continueLabel, breakLabel)
    ir_drop_barrier_push()
    let body = ptr_to_node(loopBodyOf(stmt))
    if (body.s1.equals("") == false) { ir_loop_label(body.s1) }
}

private fn irLoopExit() {
    ir_drop_barrier_pop()
    ir_loop_pop()
}

// Whether a `for` needs the general lowering below rather than the plain
// counted one: an included end, or any step.
private fn forIsGeneral(stmt: ASTNode) -> Bool {
    if (stmt.i1 == 1) { return true }
    return nodeExists(ptr_to_node(stmt.child2).next)
}

// A range `for`. The start, the end and the step are each evaluated once, before
// the first test, and in that order -- `for i in 0..<v.length` does not re-read
// the length every iteration, and `repeat(f())` calls `f` once.
//
// `for i in a..<b` is the plain counted loop: test `i < b`, run the body, add one.
// The increment cannot wrap, because `i < b` held and `b` is an Int.
//
// An included end or a step takes the general form, which tests before the
// increment instead of after it:
//
//     enter:  i <= end (or i < end), and step > 0 when the step is computed
//     latch:  continue while step fits in end - i, taken as unsigned
//     incr:   i = i + step
//
// That is what makes `for i in 0..Int.max` and `0..<n step 3` stop. Adding first
// and testing after would wrap `i` past the largest Int and never exit. `end - i`
// cannot be negative there -- `i` never passes `end` -- so read unsigned it is
// the exact distance left even when it does not fit in a signed Int.
private fn generateFor(stmt: ASTNode) {
    // Scoped to the loop, matching sema.
    ir_scope_push()
    ir_set_var_type(stmt.s1, "i32")
    let loopVar = ir_get_var_slot(stmt.s1)
    ir_alloca("i32", loopVar)

    let startVal = generateExpression(ptr_to_node(stmt.child1))
    ir_store("i32", startVal, loopVar)

    let endNode = ptr_to_node(stmt.child2)
    let endVal = generateExpression(endNode)
    let mut stepVal = "1"
    let mut stepIsLiteral = true
    if (nodeExists(endNode.next)) {
        let stepNode = ptr_to_node(endNode.next)
        stepVal = generateExpression(stepNode)
        stepIsLiteral = forStepIsLiteral(stepNode)
    }

    let endLabel = ir_get_label()
    let savedGuard = irLoopFlatGuard
    let savedProof = irLoopRangeProof
    let savedHeaderList = irLoopHeaderBoundList
    let savedHeaderIndex = irLoopHeaderBoundIndex
    let savedHeaderActive = irLoopHeaderBoundActive
    let savedHoistedBoundList = irLoopHoistedBoundList
    let savedHoistedBoundValue = irLoopHoistedBoundValue
    let savedHoistedDataValue = irLoopHoistedDataValue
    irLoopRangeProof = 0
    irLoopHeaderBoundList = ""
    irLoopHeaderBoundIndex = ""
    irLoopHeaderBoundActive = false
    irLoopHoistedBoundList = ""
    irLoopHoistedBoundValue = ""
    irLoopHoistedDataValue = ""
    let body = ptr_to_node(stmt.child3)
    let flatSlot = generateLoopFlatGuard(ptr_null(), body)
    let mut rangeSlot = ""
    let mut proof = 0
    if (flatSlot.equals("") == false or savedGuard.equals("1")) {
        irLoopRangeProofPending = 0
        irLoopRangeProofComplete = false
        rangeSlot = generateForRangeGuard(stmt, endVal, stepVal, stepIsLiteral, stmt.i1 == 1)
        proof = irLoopRangeProofPending
    }
    generateLoopVersions(stmt, endLabel, flatSlot, rangeSlot, proof, savedGuard, endVal, stepVal)
    irLoopFlatGuard = strClone(savedGuard)
    irLoopRangeProof = savedProof
    irLoopHeaderBoundList = strClone(savedHeaderList)
    irLoopHeaderBoundIndex = strClone(savedHeaderIndex)
    irLoopHeaderBoundActive = savedHeaderActive
    irLoopHoistedBoundList = strClone(savedHoistedBoundList)
    irLoopHoistedBoundValue = strClone(savedHoistedBoundValue)
    irLoopHoistedDataValue = strClone(savedHoistedDataValue)

    ir_label_numbered(endLabel)
    ir_scope_pop()
}

// The plain counted copy: test `i < end`, run the body, add one.
private fn generateForCopy(stmt: ASTNode, entryLabel: Int, endLabel: Int, endVal: String) {
    let loopVar = ir_get_var_slot(stmt.s1)
    let bodyLabel = ir_get_label()
    let incrLabel = ir_get_label()

    ir_label_numbered(entryLabel)
    let iv = ir_load("i32", loopVar)
    let cmp = ir_icmp_slt("i32", ir_get_temp_name(iv), endVal)
    ir_cond_br_numbered(ir_get_temp_name(cmp), bodyLabel, endLabel)

    ir_label_numbered(bodyLabel)
    irLoopEnter(stmt, incrLabel, endLabel)   // continue jumps to the increment step
    irLoopDepth = irLoopDepth + 1
    generateBlock(ptr_to_node(stmt.child3))
    irLoopDepth = irLoopDepth - 1
    irLoopExit()
    if (ir_has_returned() == 0) { ir_br_numbered(incrLabel) }
    ir_clear_returned()

    // `i < end` held and `end` is an Int, so the increment cannot wrap.
    ir_label_numbered(incrLabel)
    let iv2 = ir_load("i32", loopVar)
    let next = ir_add_nsw("i32", ir_get_temp_name(iv2), "1")
    ir_store("i32", ir_get_temp_name(next), loopVar)
    ir_br_numbered(entryLabel)
}

// Sema has refused a literal step that is not positive, so only a computed one
// needs testing at run time.
private fn forStepIsLiteral(stepNode: ASTNode) -> Bool {
    return stepNode.kind == NodeKind.LITERAL_EXPR and stepNode.i1 == TokenType.NUMBER_LITERAL
}

private fn generateForGeneralCopy(stmt: ASTNode, entryLabel: Int, endLabel: Int,
                                  endVal: String, stepVal: String) {
    let loopVar = ir_get_var_slot(stmt.s1)
    let endNode = ptr_to_node(stmt.child2)
    let included = stmt.i1 == 1
    let mut stepChecked = true
    if (nodeExists(endNode.next)) { stepChecked = forStepIsLiteral(ptr_to_node(endNode.next)) }

    let bodyLabel = ir_get_label()
    let latchLabel = ir_get_label()
    let incrLabel = ir_get_label()

    ir_label_numbered(entryLabel)
    let first = ir_get_temp_name(ir_load("i32", loopVar))
    let mut enter = ""
    if (included) {
        enter = ir_get_temp_name(ir_icmp_sle("i32", first, endVal))
    } else {
        enter = ir_get_temp_name(ir_icmp_slt("i32", first, endVal))
    }
    // A step computed as zero or less would never reach the end. The loop runs
    // no times instead, which a literal step never needs: sema refused those.
    if (stepChecked == false) {
        let positive = ir_get_temp_name(ir_icmp_sgt("i32", stepVal, "0"))
        enter = ir_get_temp_name(ir_and("i1", enter, positive))
    }
    ir_cond_br_numbered(enter, bodyLabel, endLabel)

    ir_label_numbered(bodyLabel)
    irLoopEnter(stmt, latchLabel, endLabel)   // continue jumps to the latch
    irLoopDepth = irLoopDepth + 1
    generateBlock(ptr_to_node(stmt.child3))
    irLoopDepth = irLoopDepth - 1
    irLoopExit()
    if (ir_has_returned() == 0) { ir_br_numbered(latchLabel) }
    ir_clear_returned()

    ir_label_numbered(latchLabel)
    let current = ir_get_temp_name(ir_load("i32", loopVar))
    let left = ir_get_temp_name(ir_sub("i32", endVal, current))
    let mut more = ""
    if (included) {
        more = ir_get_temp_name(ir_icmp_uge("i32", left, stepVal))
    } else {
        more = ir_get_temp_name(ir_icmp_ugt("i32", left, stepVal))
    }
    ir_cond_br_numbered(more, incrLabel, endLabel)

    // The latch let it through only if `step` fits in what is left to `end`.
    ir_label_numbered(incrLabel)
    let next = ir_add_nsw("i32", current, stepVal)
    ir_store("i32", ir_get_temp_name(next), loopVar)
    ir_br_numbered(bodyLabel)
}

    // SPEC 5.2. The arena is pushed on entry and popped on every exit; the
    // block inside is otherwise ordinary, and the escape facts that decide what
    // it serves were the same before the keyword was written.
private fn generateRegion(stmt: ASTNode) {
    ir_region_begin()
    ir_region_enter()
    generateBlock(ptr_to_node(stmt.child1))
    // Only on fall-through -- a `return` or `break` inside already popped it
    // on its way out, and popping twice releases the caller's arena.
    if (ir_has_returned() == 0) { ir_region_end() }
    ir_region_exit()
}

    // Both leave every scope between here and the loop body, so the loop's
    // watermark is the floor. Bindings the loop inherited are above it and stay.
    // A label (`break@outer`, in `s1`) moves the floor out to the named loop's,
    // so every loop between here and there is left as well.
private fn generateBreak(stmt: ASTNode) {
    if (stmt.s1.equals("") == false) {
        generateLoopJump(ir_loop_break_label_named(stmt.s1), ir_loop_drop_floor_named(stmt.s1),
                         ir_loop_region_depth_named(stmt.s1))
        return
    }
    generateLoopJump(ir_loop_break_label(), ir_loop_drop_floor(), ir_loop_region_depth())
}

private fn generateContinue(stmt: ASTNode) {
    if (stmt.s1.equals("") == false) {
        generateLoopJump(ir_loop_continue_label_named(stmt.s1), ir_loop_drop_floor_named(stmt.s1),
                         ir_loop_region_depth_named(stmt.s1))
        return
    }
    generateLoopJump(ir_loop_continue_label(), ir_loop_drop_floor(), ir_loop_region_depth())
}

private fn generateLoopJump(target: Int, floor: Int, regionDepth: Int) {
    if (target >= 0) {
        generateScopeDrops(floor)
        generateRegionExits(ir_region_depth() - regionDepth)
        ir_br_numbered(target)
        ir_set_returned()
    }
}

// **A `match` whose every pattern is a constant is one LLVM `switch`.**
//
// The chain below compares the scrutinee arm by arm, and LLVM has to rebuild a
// switch out of it -- which on a 256-arm match came back as a tree of four jump
// tables behind three range tests, where clang's `switch` over the same cases is
// one table behind one. switch_dispatch paid for the difference on every call.
// A switch also says what the chain only implies: that the arms are disjoint
// values, so the backend may order, table or bit-test them as it likes.
//
// Constant means known without generating anything: an integer, Char or Bool
// literal, a negated integer literal, or a variant of an enum without payloads.
// Anything else -- a name, a call, a field -- keeps the chain and its order.
private fn matchPatternIsConstant(pattern: ASTNode) -> Bool {
    if (pattern.kind == NodeKind.LITERAL_EXPR) {
        return pattern.i1 == TokenType.NUMBER_LITERAL or pattern.i1 == TokenType.CHAR_LITERAL
            or pattern.i1 == TokenType.BOOL_LITERAL
    }
    if (pattern.kind == NodeKind.UNARY_EXPR and pattern.s1.equals("-")) {
        let operand = ptr_to_node(pattern.child1)
        return operand.kind == NodeKind.LITERAL_EXPR and operand.i1 == TokenType.NUMBER_LITERAL
    }
    if (pattern.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let owner = ptr_to_node(pattern.child1)
        return owner.kind == NodeKind.IDENTIFIER_EXPR
            and ir_get_enum_variant(owner.s1, pattern.s1) >= 0
    }
    return false
}

// An integer scrutinee, every pattern constant, and a wildcard -- if there is
// one -- last. The chain generates arms after a wildcard into a block already
// closed; rather than reproduce that, such a match keeps the chain.
private fn matchLowersToSwitch(stmt: ASTNode, scrutType: String) -> Bool {
    if (scrutType.equals("i1") == false and scrutType.equals("i8") == false
        and scrutType.equals("i16") == false and scrutType.equals("i32") == false
        and scrutType.equals("i64") == false) {
        return false
    }
    let mut cases = 0
    let mut armPtr = stmt.child2
    while (nodeExists(armPtr)) {
        let arm = ptr_to_node(armPtr)
        if (arm.s1.equals("_")) {
            return cases > 0 and nodeExists(arm.next) == false
        }
        if (matchPatternIsConstant(ptr_to_node(arm.child1)) == false) { return false }
        cases = cases + 1
        armPtr = arm.next
    }
    return cases > 0
}

// The arms in source order, each its own block; the wildcard is the default,
// or the end when there is none. A value two arms share goes to the first, as
// the chain would take it -- ir_switch_case_value declines the second.
//
// Every pattern is generated *before* the switch: a negated literal goes
// through the builder, which folds it to a constant only while the block is
// still open.
private fn generateSwitchMatch(stmt: ASTNode, scrutType: String, endLabel: Int) {
    let mut patterns: Vec<String> = list_new()
    let mut labels: Vec<Int> = list_new()
    let mut defaultLabel = endLabel
    let mut armPtr = stmt.child2
    while (nodeExists(armPtr)) {
        let arm = ptr_to_node(armPtr)
        if (arm.s1.equals("_")) {
            defaultLabel = ir_get_label()
        } else {
            list_push(patterns, generateExpression(ptr_to_node(arm.child1)))
            list_push(labels, ir_get_label())
        }
        armPtr = arm.next
    }

    let switchId = ir_switch_begin_typed(scrutType, stmt.s2, defaultLabel, list_len(labels))
    let mut index = 0
    while (index < list_len(labels)) {
        ir_switch_case_value(switchId, scrutType, list_get(patterns, index), list_get(labels, index))
        index = index + 1
    }

    index = 0
    armPtr = stmt.child2
    while (nodeExists(armPtr)) {
        let arm = ptr_to_node(armPtr)
        if (arm.s1.equals("_")) {
            ir_label_numbered(defaultLabel)
        } else {
            ir_label_numbered(list_get(labels, index))
            index = index + 1
        }
        generateBlock(ptr_to_node(arm.child2))
        irReuseValue = ""
        if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
        ir_clear_returned()
        armPtr = arm.next
    }
}

private fn generateMatch(stmt: ASTNode) {
    // Parked on the statement so it can be read once per arm. A temp name is
    // a String and Strings are affine, so a `let` holding it may be named
    // exactly once, while a field read is a reborrow. The scrutinee is still
    // generated exactly once, which is the property that matters.
    stmt.s1 = generateExpression(ptr_to_node(stmt.child1))
    let scrutType = getExprType(ptr_to_node(stmt.child1))
    let endLabel = ir_get_label()
    let mut needsFinalBr = true

    // A payload enum's arms compare the tag, not the value, and bind names
    // out of the payload fields. Sema left the tag on `i1` and the variant on
    // `s2`, so nothing here needs to know what an enum is.
    //
    // The scrutinee is generated exactly once, above. That is the reason this
    // is done in codegen rather than desugared into `let r = c.Circle$0` in
    // the arm body: the desugaring would re-evaluate the scrutinee expression
    // once per arm, which for anything but a bare name is wrong.
    let payloadMatch = matchBindsPayload(stmt)
    if (payloadMatch) {
        stmt.s2 = ir_get_temp_name(ir_enum_tag(structTypeName(scrutType), stmt.s1))
    } else {
        stmt.s2 = stmt.s1
    }

    if (payloadMatch == false and matchLowersToSwitch(stmt, scrutType)) {
        generateSwitchMatch(stmt, scrutType, endLabel)
        ir_label_numbered(endLabel)
        return
    }

    let mut armPtr = stmt.child2
    while (nodeExists(armPtr)) {
        let arm = ptr_to_node(armPtr)
        if (payloadMatch and arm.s1.equals("_") == false) {
            let cmp = ir_icmp_eq("i32", stmt.s2, strFromInt(arm.i1))
            let armLabel = ir_get_label()
            let nextLabel = ir_get_label()
            ir_cond_br_numbered(ir_get_temp_name(cmp), armLabel, nextLabel)

            ir_label_numbered(armLabel)
            // The binders' own scope, as sema gives them (semaCheckPayloadArm).
            // Bound in the enclosing scope instead, a binder named like an outer
            // variable took over that name's slot for the rest of the enclosing
            // block: `i = i + 1` after `Slot.At(i) => ...` in a loop over `i`
            // stored to the binder, the condition read the loop's `i`, and the
            // loop never ended.
            ir_scope_push()
            generatePayloadBinders(arm, structTypeName(scrutType), stmt.s1)
            beginArmReuse(stmt, arm, structTypeName(scrutType))
            generateBlock(ptr_to_node(arm.child2))
            ir_scope_pop()
            irReuseValue = ""
            if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
            ir_clear_returned()

            ir_label_numbered(nextLabel)
            needsFinalBr = true
            armPtr = arm.next
        } else if (arm.s1.equals("_")) {
            // wildcard: runs in the current fall-through block
            if (payloadMatch) {
                beginArmReuse(stmt, arm, structTypeName(scrutType))
            }
            generateBlock(ptr_to_node(arm.child2))
            irReuseValue = ""
            if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
            ir_clear_returned()
            needsFinalBr = false
            armPtr = arm.next
        } else {
            let patVal = generateExpression(ptr_to_node(arm.child1))
            let cmp = ir_icmp_eq(scrutType, stmt.s2, patVal)
            let armLabel = ir_get_label()
            let nextLabel = ir_get_label()
            ir_cond_br_numbered(ir_get_temp_name(cmp), armLabel, nextLabel)

            ir_label_numbered(armLabel)
            generateBlock(ptr_to_node(arm.child2))
            if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
            ir_clear_returned()

            ir_label_numbered(nextLabel)
            needsFinalBr = true
            armPtr = arm.next
        }
    }

    if (needsFinalBr) { ir_br_numbered(endLabel) }
    ir_label_numbered(endLabel)
}

// One statement kind per line. Each lowering is the function named beside it,
// defined directly above in this order.
//
// No `return` after a call and none needed: the kinds are mutually exclusive, so
// the tests below a match cannot also match.
private fn generateStatement(stmt: ASTNode) {
    // The line table, in one place. Every instruction this statement and its
    // subexpressions build inherits this location, including the calls codegen
    // inserts on its own -- an arena bracket, a drop, a release. Column as well
    // as line, because a `for` header and its body start on the same line and a
    // breakpoint on one should not stop on the other.
    debugAt(stmt)
    if (stmt.kind == NodeKind.VARIABLE_DECL) { generateVariableDecl(stmt) }
    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) { generateAssignment(stmt) }
    if (stmt.kind == NodeKind.RETURN_STATEMENT) { generateReturn(stmt) }
    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) { generateExpressionStatement(stmt) }
    if (stmt.kind == NodeKind.IF_STATEMENT) { generateIf(stmt) }
    if (stmt.kind == NodeKind.WHILE_STATEMENT) { generateWhile(stmt) }
    if (stmt.kind == NodeKind.LOOP_STATEMENT) { generateLoop(stmt) }
    if (stmt.kind == NodeKind.FOR_STATEMENT) { generateFor(stmt) }
    if (stmt.kind == NodeKind.REGION_STATEMENT) { generateRegion(stmt) }
    if (stmt.kind == NodeKind.BREAK_STATEMENT) { generateBreak(stmt) }
    if (stmt.kind == NodeKind.CONTINUE_STATEMENT) { generateContinue(stmt) }
    if (stmt.kind == NodeKind.MATCH_STATEMENT) { generateMatch(stmt) }
}

// AIF Level 2. Frees every droppable binding at or above `floor`, newest first.
//
// There is deliberately no "was it moved?" test here. Move state belongs to
// sema, which clears it per function long before codegen runs, so asking
// ir_is_moved at this point reads an answer about some other function. Every
// case it would have caught is a fact instead: moving a value outward raises its
// escape past this scope, and an explicit `drop` marks the site, so neither
// reaches this list. A binding that merely receives a move (`let b = a`) never
// enters it, because its initialiser allocates nothing -- so the value is still
// freed exactly once, through `a`.
// Closes `count` open regions. Emitted at every exit that leaves them, in the
// same places and for the same reason as the drops -- an arena that is never
// popped holds its chunks for the rest of the program.
private fn generateRegionExits(count: Int) {
    repeat(count) {
        ir_region_end()
    }
}

// A value-owned spelling of a literal for an owning mutable slot. Twelve bytes
// or fewer belong in the String pair itself: copying those into a heap block
// discarded the SSO representation exactly where C++ benefits from it most.
// A longer literal still needs a heap copy because the slot will release it.
internal fn generateOwnedStringLiteral(value: String, exprPtr: Ptr) -> String {
    let expr = ptr_to_node(exprPtr)
    let length = __builtin_string_len(expr.s1)
    if (length <= 12) {
        return ir_get_temp_name(ir_str_inline(value, "0", strFromInt(length)))
    }
    ir_call_begin()
    ir_call_arg("ptr", value)
    // This handwritten call bypasses CALL_EXPR's general foreign-return path,
    // so it must rebuild the pair itself. Returning the raw pointer stores one
    // word into a two-word String slot; opaque pointers let that IR verify, and
    // the old length is whatever stack data happened to occupy the second word.
    return fatFromPtr(ir_get_temp_name(ir_call_end("ptr", "str_clone")))
}

// The release an assignment owes the value it overwrites.
//
// Guarded by a pointer compare rather than emitted straight, for the reason the
// counted-field store one screen up gives: a store of a value into the slot it
// already occupies would free it between the load and the store, and an extern
// that returns its own argument is not a shape this compiler can rule out. The
// branch costs an icmp the optimiser folds away wherever both sides are known.
// The handle goes back to the runtime that made it. Not through the allocator
// seam: `prismio_task_spawn` uses plain calloc, exactly as C_CODE_STYLE requires
// of a temporary the runtime frees itself, so releasing it through `rt_free`
// would report a release of a pointer the verify ledger never handed out.
private fn generateTaskRelease(value: String) {
    ir_call_begin()
    ir_call_arg("ptr", value)
    ir_call_end("void", "prismio_task_release")
}

private fn generateDisplacedRelease(old: String, val: String, kind: Int, declType: String) {
    let differs = ir_get_temp_name(ir_icmp_ne("ptr", old, val))
    let freeLabel = ir_get_label()
    let doneLabel = ir_get_label()
    ir_cond_br_numbered(differs, freeLabel, doneLabel)

    ir_label_numbered(freeLabel)
    if (kind == IR_DROP_LIST) {
        ir_free_list(old)
    } else if (kind == IR_DROP_DATAVIEW) {
        ir_free_data_view(old)
    } else if (kind == IR_DROP_TASK) {
        // Unreachable today -- a reassigned binding is not marked IR_DROP_TASK.
        // Present so the fallthrough cannot free a runtime handle through the
        // allocator seam if that guard is ever relaxed.
        generateTaskRelease(old)
    } else if (kind == IR_DROP_TYPED) {
        ir_free_typed(old, releaseFnName(structTypeName(declType)))
    } else {
        ir_free_object(old)
    }
    ir_br_numbered(doneLabel)

    ir_label_numbered(doneLabel)
}

private fn generateScopeDrops(floor: Int) {
    let n = ir_drop_count(floor)
    for i in 0..<n {
        let declType = ir_drop_type(floor, i)
        let storeType = storageType(declType)
        let loaded = ir_load(storeType, ir_drop_slot(floor, i))
        let value = ir_get_temp_name(loaded)
        let kind = ir_drop_kind(floor, i)

        // M2.1b. A functional update may return the same physical block its
        // sink argument occupied. The source and result bindings can both be on
        // the conservative drop list even though affine ownership means only
        // the newer one is live. Compare pointer slots against the newer drops
        // before releasing: the first occurrence performs the teardown and an
        // older alias skips it. This is deliberately a scope-unwind rule rather
        // than a blanket "moved bindings never drop" rule -- struct-field moves
        // rely on the existing field/caller agreement, and suppressing their
        // caller release regresses test_49.
        let mut duplicate = "0"
        if (storeType.equals("ptr")) {
            for j in 0..<i {
                let earlierType = storageType(ir_drop_type(floor, j))
                if (earlierType.equals("ptr")) {
                    let earlier = ir_get_temp_name(ir_load("ptr", ir_drop_slot(floor, j)))
                    let same = ir_get_temp_name(ir_icmp_eq("ptr", value, earlier))
                    duplicate = ir_get_temp_name(ir_or("i1", duplicate, same))
                }
            }
        }

        let releaseLabel = ir_get_label()
        let doneLabel = ir_get_label()
        if (duplicate.equals("0")) {
            ir_br_numbered(releaseLabel)
        } else {
            ir_cond_br_numbered(duplicate, doneLabel, releaseLabel)
        }
        ir_label_numbered(releaseLabel)
        if (kind == IR_DROP_LIST) {
            ir_free_list(value)
        } else if (kind == IR_DROP_DATAVIEW) {
            ir_free_data_view(value)
        } else if (kind == IR_DROP_TASK) {
            generateTaskRelease(value)
        } else if (kind == IR_DROP_TYPED) {
            // The drop list keeps the declared type, so the generated release is
            // named from it rather than stored a second time.
            ir_free_typed(value, releaseFnName(structTypeName(declType)))
        } else if (kind == IR_DROP_FIELDS) {
            ir_free_typed(value, frameReleaseFnName(structTypeName(declType)))
        } else {
            ir_free_object(value)
        }
        ir_br_numbered(doneLabel)
        ir_label_numbered(doneLabel)
    }
}

internal fn generateBlock(block: ASTNode) {
    // LAYOUT 7.1. The cost model may have placed an arena here, in which case
    // the block is bracketed exactly as a `region` statement is -- same runtime,
    // same early-exit handling through ir_region_depth. The only difference is
    // who decided.
    let arena = aif_auto_arena_at_node(node_to_ptr(block)) == 1

    // M3.2d. Where in the block it is bracketed. -1 is "at the braces", the
    // lexical extent, and the two are not interchangeable: an arena narrowed to
    // a range was accepted *because* of that range -- the obligation that
    // refuses an opaque call in the region body was asked of these statements
    // and no others -- so bracketing the whole block instead would put the calls
    // it cleared back inside the arena.
    let mut rangeFirst = 0 - 1
    let mut rangeLast = 0 - 1
    if (arena) {
        rangeFirst = aif_arena_range_first(node_to_ptr(block))
        rangeLast = aif_arena_range_last(node_to_ptr(block))
    }
    // The braces still own it when there is no range to put it between.
    let lexicalArena = arena and rangeFirst < 0
    if (lexicalArena) {
        ir_region_begin()
        ir_region_enter()
    }

    // Mirrors semaBlock: the same scopes must be pushed and popped in the same
    // order, so that a name resolves to the same binding -- and therefore the
    // same slot -- in both passes.
    ir_scope_push()
    debugPushScope(block)

    // The index has to count what the AIF walk counted, which is every node of
    // this chain. `aifWalk` numbers a BLOCK's child1/child2/child3 as one list
    // and the parser only ever fills child1 (src/parse/stmt.psm), so this loop
    // and that one agree -- and if that ever stops being true the arena opens at
    // the wrong statement.
    let mut stmtIndex = 0
    let mut stmtPtr = block.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        // CSDO: dispatch tables are source-level chains, before ordinary IF
        // lowering turns them into unrelated branches. Four arms is the point
        // where the length switch repays its setup. A narrowed automatic arena
        // is statement-indexed, so retain the ordinary path when one is active;
        // debug builds likewise preserve one condition per source line.
        if (rangeFirst < 0 and ir_debug_enabled() == 0) {
            let dispatchSubject = stringDispatchSubject(stmt)
            if (dispatchSubject.equals("") == false) {
                let dispatchCount = stringDispatchCount(stmtPtr, dispatchSubject)
                if (dispatchCount >= 4) {
                    stmtPtr = generateStringDispatch(stmtPtr, dispatchCount)
                    stmtIndex = stmtIndex + dispatchCount
                    continue
                }
            }
        }
        if (rangeFirst == stmtIndex) {
            ir_region_begin()
            ir_region_enter()
        }
        generateStatement(stmt)
        if (rangeLast == stmtIndex) {
            // Only on fall-through, for the reason the lexical close below gives:
            // a `return` or `break` in the range already popped it on its way
            // out. ir_region_exit runs either way, or the depth every later exit
            // is counted against stays one too high.
            if (ir_has_returned() == 0) { ir_region_end() }
            ir_region_exit()
        }
        stmtIndex = stmtIndex + 1
        stmtPtr = stmt.next
    }

    // Everything from here to the end of the block is the way *out* of it, and
    // belongs to the closing brace rather than to the last statement that ran.
    debugAtBlockEnd(block)

    // Only on fall-through. A block that returned or branched away already
    // emitted its drops at that statement, and emitting them again here would
    // be unreachable code after a terminator -- or, worse, reachable and a
    // double free.
    if (ir_has_returned() == 0) {
        generateScopeDrops(ir_scope_drop_floor())
    }

    debugPopScope()
    ir_scope_pop()

    if (lexicalArena) {
        // Only on fall-through, for the same reason the drops are: a `return` or
        // `break` inside already popped every arena between itself and its
        // target, and popping twice releases the caller's.
        if (ir_has_returned() == 0) { ir_region_end() }
        ir_region_exit()
    }
}
