// Lowering statements, and the scope and region unwinding that leaving one implies.

import ast.nodes
import ast.types
import common.text
import common.diagnostics

// Whether this match is over an enum with payloads. Sema stamps the variant name
// on every non-wildcard arm of one and on no other kind of match, so one arm
// settles it.
fn matchBindsPayload(stmt: ASTNode) -> Bool {
    let mut armPtr = stmt.child2
    while (nodeExists(armPtr)) {
        let arm = ptr_to_node(armPtr)
        if (str_equals(arm.s2, "") == 0) { return true }
        armPtr = arm.next
    }
    return false
}

// Binds the names a variant pattern introduced, by loading the payload fields
// this arm's variant occupies.
fn generatePayloadBinders(arm: ASTNode, structName: String, scrutVal: String) {
    let pattern = ptr_to_node(arm.child1)
    if (pattern.kind != NodeKind.CALL_EXPR) { return }

    let mut binder = pattern.child2
    let mut index = 0
    while (nodeExists(binder)) {
        let name = ptr_to_node(binder)
        // enumPayloadField is sema's, and is called rather than copied because
        // the two ends have to agree on the spelling exactly -- a second copy of
        // the rule is a second thing to keep in step.
        let fieldName = enumPayloadField(arm.s2, index)
        let fieldType = fieldStorageType(ir_get_struct_field_type(structName, fieldName))
        let fieldIndex = ir_get_struct_field_index(structName, fieldName)
        let slot = ir_struct_field_ptr(structName, scrutVal, fieldIndex)

        // The same rule as a field read in expr.psm: an inline struct field *is*
        // its storage, so the GEP already is the value, and loading it would read
        // the struct rather than address it.
        let mut payloadVal = ir_get_temp_name(slot)
        if (isStructTypeKey(fieldType) == false) {
            payloadVal = ir_get_temp_name(ir_load_ptr(fieldType, ir_get_temp_name(slot)))
        }

        ir_set_var_type(name.s1, fieldType)
        ir_alloca(storageType(fieldType), ir_get_var_slot(name.s1))
        ir_store(storageType(fieldType), payloadVal, ir_get_var_slot(name.s1))


        index = index + 1
        binder = name.next
    }
}

fn generateStatement(stmt: ASTNode) {
    // The line table, in one place. Every instruction this statement and its
    // subexpressions build inherits this location, including the calls codegen
    // inserts on its own -- an arena bracket, a drop, a release. Column as well
    // as line, because a `for` header and its body start on the same line and a
    // breakpoint on one should not stop on the other.
    debugAt(stmt)

    if (stmt.kind == NodeKind.VARIABLE_DECL) {
        let varName = stmt.s1
        let mut varType = "i32"
        if (nodeExists(stmt.child1)) {
            let typeNode = ptr_to_node(stmt.child1)
            varType = mapTypeNode(typeNode)
        } else {
            if (nodeExists(stmt.child2)) {
                varType = getExprType(ptr_to_node(stmt.child2))
            }
        }

        // The initializer is generated before the binding is declared, so that
        // `let x = x + 1` reads the *outer* x rather than the one being defined.
        let mut initVal = ""
        let hasInit = nodeExists(stmt.child2)
        if (hasInit) {
            initVal = generateExpression(ptr_to_node(stmt.child2))
        }

        // A fresh binding with its own slot. Two `let x` in sibling blocks get
        // separate stack slots, so they can hold different types without one
        // being written through a slot sized for the other.
        ir_set_var_type(varName, varType)
        let slot = ir_get_var_slot(varName)
        let storeType = storageType(varType)
        ir_alloca(storeType, slot)

        // Declared here rather than after the store: the alloca is what the
        // variable *is*, and a debugger stopped between the two should report the
        // slot with whatever is in it, not report the name as unknown. The slot
        // is uninitialised until the store lands, which is the same window C has
        // and the same one it does not describe either.
        debugLocal(varName, slot, varType, debugTypeName(stmt.child1, stmt.child2), stmt, 0)

        if (hasInit) {
            // AIF Level 4, the reassignment half. An owning accumulator's slot
            // holds memory the binding owns at *every* point, not only at the
            // scope exit, and that is what licenses the release in the assignment
            // below. A literal initialiser is the one thing that would break the
            // invariant on the binding's first line -- `let mut s = ""` puts a
            // .rodata pointer in the slot and the first assignment would free it
            // -- so it is cloned. One allocation per binding, not per iteration.
            let accumulates = irOwningAccumulator(varName)
                and nodeProducesOwnedValue(stmt.child2)
            if (accumulates and nodeIsStringLiteralExpr(stmt.child2)) {
                initVal = generateStringClone(initVal)
            }

            ir_store(storeType, initVal, slot)

            // Every accumulator owns what its slot holds. Whether the *last*
            // value is this scope's to drop is the separate question below.
            if (accumulates) { ir_mark_owns_slot(varName) }

            // AIF Level 2. Only a binding whose initialiser *is* the allocation
            // is droppable: `let b = a` has an identifier for an initialiser,
            // so it registers no site and gets no entry -- and `a` is moved by
            // it, so `a` gets skipped too. That leaks rather than double-frees,
            // and it is what an ownership-transferring move would fix.
            if (aif_frees_at_scope_node(stmt.child2) == 1
                and chainAssignsName(irFunctionBody, varName) == false) {
                ir_mark_droppable(varName, dropKindOf(ptr_to_node(stmt.child2)))
            } else if (accumulates and chainReturnsName(irFunctionBody, varName) == false) {
                // The last value an accumulator holds needs an owner too, and the
                // assignments only ever release what they displace. A returned
                // binding hands that one to the caller -- the same reason the
                // branch above declines a returned value -- so this is every
                // other case.
                ir_mark_droppable(varName, dropKindOf(ptr_to_node(stmt.child2)))
            } else {
                // AIF item 3. The initialiser is not an allocation here -- it is a
                // call to a function that made one and handed it over. That is the
                // ownership the escape lattice cannot express, so it is asked of
                // the converged facts (the callee kept nothing, and allocated what
                // it returned) plus the two syntactic guards the facts leave open.
                let owned = aif_owns_call_result_at_node(stmt.child2)
                if (owned != AIF_ELEM_NONE
                        and chainAssignsName(irFunctionBody, varName) == false
                    and chainReturnsName(irFunctionBody, varName) == false) {
                    if (owned == AIF_ELEM_LIST) {
                        ir_mark_droppable(varName, IR_DROP_LIST)
                    } else if (owned == AIF_ELEM_TYPED) {
                        ir_mark_droppable(varName, IR_DROP_TYPED)
                    } else {
                        ir_mark_droppable(varName, IR_DROP_OBJECT)
                    }
                }
            }
        }
    }
    
    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        let targetNode = ptr_to_node(stmt.child1)
        if (targetNode.kind == NodeKind.IDENTIFIER_EXPR) {
            let varName = targetNode.s1
            let mut varType = ir_get_var_type(varName)
            let storeType = storageType(varType)

            // AIF Level 4, the reassignment half. Droppable means the slot owns
            // its contents, so a store into it displaces a value with no other
            // owner -- and until this existed, that value had none at all. It is
            // the same fact the scope exit reads, asked through the binding rather
            // than recomputed from the declaration's reasoning, because two
            // answers to "does this binding own what it holds" is exactly how a
            // value ends up unowned.
            //
            // The old pointer is read before the right-hand side is generated,
            // and freed after: `out = str_concat(out, x)` passes the displaced
            // value *into* the call that replaces it, so releasing it any earlier
            // frees the argument being read.
            let releasesOld = ir_var_is_global(varName) == 0
                and ir_binding_owns_slot(varName) == 1
            let mut old = ""
            if (releasesOld) {
                old = ir_get_temp_name(ir_load(storeType, ir_get_var_slot(varName)))
            }

            let mut val = generateExpression(ptr_to_node(stmt.child2))
            // The same clone the declaration makes, for the same reason and it
            // was not obvious that both needed it: a literal stored here leaves
            // .rodata in a slot the *next* assignment frees. That is what aborted
            // the compiler's own --verify build, one generation after the
            // declaration alone looked sufficient.
            if (releasesOld and nodeIsStringLiteralExpr(stmt.child2)) {
                val = generateStringClone(val)
            }
            if (ir_var_is_global(varName) == 1) {
                ir_store_global(storeType, val, varName)
            } else {
                if (releasesOld) { generateDisplacedRelease(old, val, dropKindOf(ptr_to_node(stmt.child2)), varType) }
                ir_store(storeType, val, ir_get_var_slot(varName))
            }
        }
        if (targetNode.kind == NodeKind.MEMBER_ACCESS_EXPR) {
            let objectNode = ptr_to_node(targetNode.child1)
            let objectVal = generateExpression(objectNode)
            let objectType = getExprType(objectNode)
            let structName = structTypeName(objectType)
            let fieldIndex = ir_get_struct_field_index(structName, targetNode.s1)
            let fieldType = fieldStorageType(ir_get_struct_field_type(structName, targetNode.s1))
            let val = generateExpression(ptr_to_node(stmt.child2))

            let slot = ir_struct_field_ptr(structName, objectVal, fieldIndex)
            irProfileField(structName, targetNode.s1, true)
            irProfileRange(structName, targetNode.s1, fieldType, val)
            // CYCLES 3, the assignment half. Retain before releasing, so a store
            // of a value into the slot it already occupies does not free it
            // between the two.
            if (aif_field_is_counted(structName, targetNode.s1) == 1) {
                let old = ir_get_temp_name(ir_load_ptr("ptr", ir_get_temp_name(slot)))
                ir_call_begin()
                ir_call_arg("ptr", val)
                ir_call_end("void", "cyc_retain")
                ir_call_begin()
                ir_call_arg("ptr", old)
                ir_call_end("void", "cyc_release")
            }
            // Assigning an inline field overwrites storage rather than swapping
            // an address, so it copies. A counted field is never inline: the
            // count sits in a header in front of an allocation, and an inline
            // field has no allocation of its own to put one in front of.
            if (isStructTypeKey(fieldType)) {
                ir_copy_struct(structTypeName(fieldType), ir_get_temp_name(slot), val)
            } else {
                ir_store_ptr(fieldType, val, ir_get_temp_name(slot))
            }
        }
    }
    
    if (stmt.kind == NodeKind.RETURN_STATEMENT) {
        // Every scope in the function unwinds at once, so the floor is 0. The
        // returned value is never among them: returning it puts its escape at
        // Caller, and nothing with that escape is droppable here.
        if (nodeExists(stmt.child1)) {
            let retVal = generateExpression(ptr_to_node(stmt.child1))
            let retType = storageType(getExprType(ptr_to_node(stmt.child1)))
            generateScopeDrops(0)
            generateRegionExits(ir_region_depth())
            ir_ret(retType, retVal)
        } else {
            generateScopeDrops(0)
            generateRegionExits(ir_region_depth())
            ir_ret_void()
        }
        ir_set_returned()
    }
    
    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) {
        if (nodeExists(stmt.child1)) {
            generateExpression(ptr_to_node(stmt.child1))
        }
    }
    
    if (stmt.kind == NodeKind.IF_STATEMENT) {
        let condVal = generateExpression(ptr_to_node(stmt.child1))
        
        let thenLabel = ir_get_label()
        let elseLabel = ir_get_label()
        let endLabel = ir_get_label()
        
        if (nodeExists(stmt.child3)) {
            ir_cond_br_numbered(condVal, thenLabel, elseLabel)
        } else {
            ir_cond_br_numbered(condVal, thenLabel, endLabel)
        }
        
        ir_label_numbered(thenLabel)
        generateBlock(ptr_to_node(stmt.child2))
        if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
        ir_clear_returned()
        
        if (nodeExists(stmt.child3)) {
            ir_label_numbered(elseLabel)
            
            let elseNode = ptr_to_node(stmt.child3)
            if (elseNode.kind == NodeKind.IF_STATEMENT) {
                generateStatement(elseNode)
            } else {
                generateBlock(elseNode)
            }
            if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
            ir_clear_returned()
        }
        
        ir_label_numbered(endLabel)
    }
    
    if (stmt.kind == NodeKind.WHILE_STATEMENT) {
        let condLabel = ir_get_label()
        let bodyLabel = ir_get_label()
        let endLabel = ir_get_label()

        ir_br_numbered(condLabel)
        ir_label_numbered(condLabel)

        let condVal = generateExpression(ptr_to_node(stmt.child1))
        ir_cond_br_numbered(condVal, bodyLabel, endLabel)

        ir_label_numbered(bodyLabel)
        ir_loop_push(condLabel, endLabel)
        ir_drop_barrier_push()
        generateBlock(ptr_to_node(stmt.child2))
        ir_drop_barrier_pop()
        ir_loop_pop()

        if (ir_has_returned() == 0) { ir_br_numbered(condLabel) }
        ir_clear_returned()

        ir_label_numbered(endLabel)
    }

    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        let bodyLabel = ir_get_label()
        let endLabel = ir_get_label()

        ir_br_numbered(bodyLabel)
        ir_label_numbered(bodyLabel)
        ir_loop_push(bodyLabel, endLabel)
        ir_drop_barrier_push()
        generateBlock(ptr_to_node(stmt.child1))
        ir_drop_barrier_pop()
        ir_loop_pop()

        if (ir_has_returned() == 0) { ir_br_numbered(bodyLabel) }
        ir_clear_returned()

        ir_label_numbered(endLabel)
    }

    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        // Scoped to the loop, matching sema.
        ir_scope_push()
        ir_set_var_type(stmt.s1, "i32")
        let loopVar = ir_get_var_slot(stmt.s1)
        ir_alloca("i32", loopVar)

        let startVal = generateExpression(ptr_to_node(stmt.child1))
        ir_store("i32", startVal, loopVar)

        let condLabel = ir_get_label()
        let bodyLabel = ir_get_label()
        let incrLabel = ir_get_label()
        let endLabel = ir_get_label()

        ir_br_numbered(condLabel)
        ir_label_numbered(condLabel)
        let iv = ir_load("i32", loopVar)
        let endVal = generateExpression(ptr_to_node(stmt.child2))
        let cmp = ir_icmp_slt("i32", ir_get_temp_name(iv), endVal)
        ir_cond_br_numbered(ir_get_temp_name(cmp), bodyLabel, endLabel)

        ir_label_numbered(bodyLabel)
        ir_loop_push(incrLabel, endLabel)   // continue jumps to the increment step
        ir_drop_barrier_push()
        generateBlock(ptr_to_node(stmt.child3))
        ir_drop_barrier_pop()
        ir_loop_pop()
        if (ir_has_returned() == 0) { ir_br_numbered(incrLabel) }
        ir_clear_returned()

        ir_label_numbered(incrLabel)
        let iv2 = ir_load("i32", loopVar)
        let next = ir_add("i32", ir_get_temp_name(iv2), "1")
        ir_store("i32", ir_get_temp_name(next), loopVar)
        ir_br_numbered(condLabel)

        ir_label_numbered(endLabel)
        ir_scope_pop()
    }

    // SPEC 5.2. The arena is pushed on entry and popped on every exit; the
    // block inside is otherwise ordinary, and the escape facts that decide what
    // it serves were the same before the keyword was written.
    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        ir_region_begin()
        ir_region_enter()
        generateBlock(ptr_to_node(stmt.child1))
        // Only on fall-through -- a `return` or `break` inside already popped it
        // on its way out, and popping twice releases the caller's arena.
        if (ir_has_returned() == 0) { ir_region_end() }
        ir_region_exit()
    }

    // Both leave every scope between here and the loop body, so the loop's
    // watermark is the floor. Bindings the loop inherited are above it and stay.
    if (stmt.kind == NodeKind.BREAK_STATEMENT) {
        let target = ir_loop_break_label()
        if (target >= 0) {
            generateScopeDrops(ir_loop_drop_floor())
            generateRegionExits(ir_region_depth() - ir_loop_region_depth())
            ir_br_numbered(target)
            ir_set_returned()
        }
    }

    if (stmt.kind == NodeKind.CONTINUE_STATEMENT) {
        let target = ir_loop_continue_label()
        if (target >= 0) {
            generateScopeDrops(ir_loop_drop_floor())
            generateRegionExits(ir_region_depth() - ir_loop_region_depth())
            ir_br_numbered(target)
            ir_set_returned()
        }
    }

    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        // Parked on the statement so it can be read once per arm. A temp name is
        // a String and Strings are affine, so a `let` holding it may be named
        // exactly once, while a field read is a reborrow. The scrutinee is still
        // generated exactly once, which is the property that matters.
        stmt.s1 = generateExpression(ptr_to_node(stmt.child1))
        let scrutType = getExprType(ptr_to_node(stmt.child1))
        let endLabel = ir_get_label()
        let mut needsFinalBr = true

        // A payload enum's arms compare the tag, not the value, and bind names
        // out of the payload fields. Sema left the tag on `i1` and the variant on
        // `s2`, so nothing here needs to know what an enum is.
        //
        // The scrutinee is generated exactly once, above. That is the reason this
        // is done in codegen rather than desugared into `let r = c.Circle$0` in
        // the arm body: the desugaring would re-evaluate the scrutinee expression
        // once per arm, which for anything but a bare name is wrong.
        let payloadMatch = matchBindsPayload(stmt)
        if (payloadMatch) {
            let tagSlot = ir_struct_field_ptr(structTypeName(scrutType), stmt.s1, 0)
            stmt.s2 = ir_get_temp_name(ir_load_ptr("i32", ir_get_temp_name(tagSlot)))
        } else {
            stmt.s2 = stmt.s1
        }

        let mut armPtr = stmt.child2
        while (nodeExists(armPtr)) {
            let arm = ptr_to_node(armPtr)
            if (payloadMatch and str_equals(arm.s1, "_") == 0) {
                let cmp = ir_icmp_eq("i32", stmt.s2, int_to_str(arm.i1))
                let armLabel = ir_get_label()
                let nextLabel = ir_get_label()
                ir_cond_br_numbered(ir_get_temp_name(cmp), armLabel, nextLabel)

                ir_label_numbered(armLabel)
                generatePayloadBinders(arm, structTypeName(scrutType), stmt.s1)
                generateBlock(ptr_to_node(arm.child2))
                if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
                ir_clear_returned()

                ir_label_numbered(nextLabel)
                needsFinalBr = true
                armPtr = arm.next
            } else if (str_equals(arm.s1, "_") == 1) {
                // wildcard: runs in the current fall-through block
                generateBlock(ptr_to_node(arm.child2))
                if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
                ir_clear_returned()
                needsFinalBr = false
                armPtr = arm.next
            } else {
                let patVal = generateExpression(ptr_to_node(arm.child1))
                let cmp = ir_icmp_eq(scrutType, stmt.s2, patVal)
                let armLabel = ir_get_label()
                let nextLabel = ir_get_label()
                ir_cond_br_numbered(ir_get_temp_name(cmp), armLabel, nextLabel)

                ir_label_numbered(armLabel)
                generateBlock(ptr_to_node(arm.child2))
                if (ir_has_returned() == 0) { ir_br_numbered(endLabel) }
                ir_clear_returned()

                ir_label_numbered(nextLabel)
                needsFinalBr = true
                armPtr = arm.next
            }
        }

        if (needsFinalBr) { ir_br_numbered(endLabel) }
        ir_label_numbered(endLabel)
    }
}

// AIF Level 2. Frees every droppable binding at or above `floor`, newest first.
//
// There is deliberately no "was it moved?" test here. Move state belongs to
// sema, which clears it per function long before codegen runs, so asking
// ir_is_moved at this point reads an answer about some other function. Every
// case it would have caught is a fact instead: moving a value outward raises its
// escape past this scope, and an explicit `drop` marks the site, so neither
// reaches this list. A binding that merely receives a move (`let b = a`) never
// enters it, because its initialiser allocates nothing -- so the value is still
// freed exactly once, through `a`.
// Closes `count` open regions. Emitted at every exit that leaves them, in the
// same places and for the same reason as the drops -- an arena that is never
// popped holds its chunks for the rest of the program.
fn generateRegionExits(count: Int) {
    let mut i = 0
    while (i < count) {
        ir_region_end()
        i = i + 1
    }
}

// A heap copy of a string literal, so a slot that owns its contents never holds
// a .rodata pointer. The runtime already reached this conclusion once, in
// str_substring's out-of-range answer, and for the same reason.
fn generateStringClone(value: String) -> String {
    ir_call_begin()
    ir_call_arg("ptr", value)
    return ir_get_temp_name(ir_call_end("ptr", "str_clone"))
}

// The release an assignment owes the value it overwrites.
//
// Guarded by a pointer compare rather than emitted straight, for the reason the
// counted-field store one screen up gives: a store of a value into the slot it
// already occupies would free it between the load and the store, and an extern
// that returns its own argument is not a shape this compiler can rule out. The
// branch costs an icmp the optimiser folds away wherever both sides are known.
fn generateDisplacedRelease(old: String, val: String, kind: Int, declType: String) {
    let differs = ir_get_temp_name(ir_icmp_ne("ptr", old, val))
    let freeLabel = ir_get_label()
    let doneLabel = ir_get_label()
    ir_cond_br_numbered(differs, freeLabel, doneLabel)

    ir_label_numbered(freeLabel)
    if (kind == IR_DROP_LIST) {
        ir_free_list(old)
    } else if (kind == IR_DROP_TYPED) {
        ir_free_typed(old, releaseFnName(structTypeName(declType)))
    } else {
        ir_free_object(old)
    }
    ir_br_numbered(doneLabel)

    ir_label_numbered(doneLabel)
}

fn generateScopeDrops(floor: Int) {
    let n = ir_drop_count(floor)
    let mut i = 0
    while (i < n) {
        let declType = ir_drop_type(floor, i)
        let storeType = storageType(declType)
        let loaded = ir_load(storeType, ir_drop_slot(floor, i))
        let value = ir_get_temp_name(loaded)
        let kind = ir_drop_kind(floor, i)
        if (kind == IR_DROP_LIST) {
            ir_free_list(value)
        } else if (kind == IR_DROP_TYPED) {
            // The drop list keeps the declared type, so the generated release is
            // named from it rather than stored a second time.
            ir_free_typed(value, releaseFnName(structTypeName(declType)))
        } else {
            ir_free_object(value)
        }
        i = i + 1
    }
}

fn generateBlock(block: ASTNode) {
    // LAYOUT 7.1. The cost model may have placed an arena here, in which case
    // the block is bracketed exactly as a `region` statement is -- same runtime,
    // same early-exit handling through ir_region_depth. The only difference is
    // who decided.
    let arena = aif_auto_arena_at_node(node_to_ptr(block)) == 1

    // M3.2d. Where in the block it is bracketed. -1 is "at the braces", the
    // lexical extent, and the two are not interchangeable: an arena narrowed to
    // a range was accepted *because* of that range -- the obligation that
    // refuses an opaque call in the region body was asked of these statements
    // and no others -- so bracketing the whole block instead would put the calls
    // it cleared back inside the arena.
    let mut rangeFirst = 0 - 1
    let mut rangeLast = 0 - 1
    if (arena) {
        rangeFirst = aif_arena_range_first(node_to_ptr(block))
        rangeLast = aif_arena_range_last(node_to_ptr(block))
    }
    // The braces still own it when there is no range to put it between.
    let lexicalArena = arena and rangeFirst < 0
    if (lexicalArena) {
        ir_region_begin()
        ir_region_enter()
    }

    // Mirrors semaBlock: the same scopes must be pushed and popped in the same
    // order, so that a name resolves to the same binding -- and therefore the
    // same slot -- in both passes.
    ir_scope_push()
    debugPushScope(block)

    // The index has to count what the AIF walk counted, which is every node of
    // this chain. `aifWalk` numbers a BLOCK's child1/child2/child3 as one list
    // and the parser only ever fills child1 (src/parse/stmt.psm), so this loop
    // and that one agree -- and if that ever stops being true the arena opens at
    // the wrong statement.
    let mut stmtIndex = 0
    let mut stmtPtr = block.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        if (rangeFirst == stmtIndex) {
            ir_region_begin()
            ir_region_enter()
        }
        generateStatement(stmt)
        if (rangeLast == stmtIndex) {
            // Only on fall-through, for the reason the lexical close below gives:
            // a `return` or `break` in the range already popped it on its way
            // out. ir_region_exit runs either way, or the depth every later exit
            // is counted against stays one too high.
            if (ir_has_returned() == 0) { ir_region_end() }
            ir_region_exit()
        }
        stmtIndex = stmtIndex + 1
        stmtPtr = stmt.next
    }

    // Everything from here to the end of the block is the way *out* of it, and
    // belongs to the closing brace rather than to the last statement that ran.
    debugAtBlockEnd(block)

    // Only on fall-through. A block that returned or branched away already
    // emitted its drops at that statement, and emitting them again here would
    // be unreachable code after a terminator -- or, worse, reachable and a
    // double free.
    if (ir_has_returned() == 0) {
        generateScopeDrops(ir_scope_drop_floor())
    }

    debugPopScope()
    ir_scope_pop()

    if (lexicalArena) {
        // Only on fall-through, for the same reason the drops are: a `return` or
        // `break` inside already popped every arena between itself and its
        // target, and popping twice releases the caller's.
        if (ir_has_returned() == 0) { ir_region_end() }
        ir_region_exit()
    }
}
