public extern fn ir_icmp_sle(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_icmp_sgt(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_icmp_sge(type: String, lhs: String, rhs: String) -> Int
