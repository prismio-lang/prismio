// LLVM Bridge FFI for Prismio

// Global state
public extern fn ir_reset()
public extern fn ir_print()
public extern fn ir_write_file(filename: String) -> Int
public extern fn ir_append(text: String)
public extern fn ir_append_line(text: String)
public extern fn ir_get_temp() -> Int

// Module
public extern fn ir_module_start(moduleName: String)
public extern fn ir_module_end()

// Stamps the selected target onto the module being built. The target record
// itself lives in common.target, because a type's width is an `ast` question
// and `common` is the only package both it and `ir` may import.
public extern fn ir_module_set_target(triple: String borrow, layout: String borrow)

// Function Builders
public extern fn ir_declare_function_begin(name: String, retType: String)
public extern fn ir_declare_function_param(paramType: String)
// The declaration returns memory nothing else can reach, so LLVM may treat two
// calls as two allocations. Only for a constructor: an entry point returning a
// pointer *into* a block the caller already holds must not carry it.
public extern fn ir_declare_function_fresh()
public extern fn ir_declare_function_end()

public extern fn ir_function_begin(name: String, retType: String)
public extern fn ir_function_param(paramType: String, paramName: String)
public extern fn ir_function_param_unique(paramType: String, paramName: String)
public extern fn ir_function_body_start()
public extern fn ir_function_always_inline()
public extern fn ir_function_end()

// Call Builder
public extern fn ir_call_begin()
public extern fn ir_call_arg(argType: String, argValue: String)
public extern fn ir_call_end(retType: String, funcName: String) -> Int

// Basic Blocks
public extern fn ir_get_label() -> Int
public extern fn ir_label(labelName: String)
public extern fn ir_label_numbered(labelNum: Int)

// Memory
public extern fn ir_alloca(type: String, name: String) -> Int
public extern fn ir_load(type: String, ptrName: String) -> Int
public extern fn ir_store(type: String, value: String, ptrName: String)
public extern fn ir_load_global(type: String, name: String) -> Int
public extern fn ir_store_global(type: String, value: String, name: String)

// Arithmetic
public extern fn ir_add(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_sub(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_mul(type: String, lhs: String, rhs: String) -> Int

// RFC 0560's "check in debug, wrap in release", emitted only under
// `--overflow-checks`. Each one lowers to llvm.s{add,sub,mul}.with.overflow, a
// branch, and a `prismio_overflow_trap` the failing arm cannot return from --
// four LLVM concepts, which is why the whole sequence lives in the backend and
// this asks for a value.
//
// **Never a default**, and the number is measured rather than feared: the
// checked form is 5.4x-6.0x the plain one, because a branch per operation
// defeats vectorization outright. See the note on ir_checked_binop.
public extern fn ir_add_checked(type: String, lhs: String, rhs: String, file: String, line: Int) -> Int
public extern fn ir_sub_checked(type: String, lhs: String, rhs: String, file: String, line: Int) -> Int
public extern fn ir_mul_checked(type: String, lhs: String, rhs: String, file: String, line: Int) -> Int
public extern fn ir_uadd_checked(type: String, lhs: String, rhs: String, file: String, line: Int) -> Int
public extern fn ir_usub_checked(type: String, lhs: String, rhs: String, file: String, line: Int) -> Int
public extern fn ir_umul_checked(type: String, lhs: String, rhs: String, file: String, line: Int) -> Int

// One bit, read by every arithmetic site and decided by none of them.
public extern fn ir_set_overflow_checks(on: Int)
public extern fn ir_overflow_checks() -> Int

public extern fn ir_sdiv(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_srem(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_udiv(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_urem(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_fadd(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_fsub(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_fmul(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_fdiv(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_neg(type: String, value: String) -> Int

// Width conversions
public extern fn ir_zext(fromType: String, value: String, toType: String) -> Int
public extern fn ir_sext(fromType: String, value: String, toType: String) -> Int
public extern fn ir_trunc(fromType: String, value: String, toType: String) -> Int
public extern fn ir_sitofp(fromType: String, value: String, toType: String) -> Int
public extern fn ir_uitofp(fromType: String, value: String, toType: String) -> Int
public extern fn ir_fptosi(fromType: String, value: String, toType: String) -> Int
public extern fn ir_fptoui(fromType: String, value: String, toType: String) -> Int
public extern fn ir_and(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_or(type: String, lhs: String, rhs: String) -> Int
public extern fn ir_xor(type: String, lhs: String, rhs: String) -> Int
