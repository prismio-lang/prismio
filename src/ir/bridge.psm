// Globals
extern fn ir_global_string(name: String, strContent: String)
extern fn ir_global_var(name: String, type: String, initValue: String, isConst: Int)

// Typed structural builders.
// Both backends implement these identically. The frontend must build structs,
// arrays and field access through them rather than emitting IR text, because
// the LLVM C API backend has no way to honour raw text.
extern fn ir_set_pointer_int_type(t: String)
extern fn ir_set_opt_level(level: Int)

// The memory-model seam. Every heap allocation and release codegen emits goes
// through ir_alloc_object/ir_free_object, which call whichever functions these
// name -- so changing the model is a change here, never a change to codegen.
// Default to malloc/free, which is exactly today's behaviour.
extern fn ir_set_alloc_function(name: String)
extern fn ir_set_free_function(name: String)
extern fn ir_get_alloc_function() -> String alias
extern fn ir_get_free_function() -> String alias
extern fn ir_struct_type_begin(name: String)
extern fn ir_struct_type_field(fieldType: String)

// LAYOUT 6's hot/cold split, and the only thing codegen has to say about it.
//
// How many of the fields just declared stay in the hot record; 0 means no split.
// The backend appends the link word, builds the cold record, and redirects every
// field access at or above this index through it -- none of which is visible from
// here, because ir_struct_field_ptr is the single choke point for field access.
extern fn ir_struct_type_split(hotCount: Int)
extern fn ir_struct_type_end()
extern fn ir_alloc_object(structName: String) -> Int

// The T0 half of the seam. aif/implementation/COMPILER-AUDIT.md 3 explains why
// one hook could never express the whole ladder: T0 is an instruction, not a
// call, and no choice of allocator name produces an `alloca`. T1's arena hook is
// the third and does not exist yet.
extern fn ir_alloc_stack(structName: String) -> Int

// The third hook, and the one 3 said did not exist. `region r { ... }` brackets
// the block with ir_region_begin/ir_region_end, and a value the analysis proved
// cannot outlive r bumps from that arena. The handle is dynamically scoped, so
// this stays fn(size) -> ptr like the other two.
extern fn ir_alloc_region(structName: String) -> Int
extern fn ir_region_begin()
extern fn ir_region_end()

// The fourth, and the one 3 rated only "partly" expressible -- on the grounds
// that a count word changes struct layout and every ir_struct_field_ptr index
// with it. It does not, because the count goes in front of the pointer rather
// than inside the object, so this really is just another fn(size) -> ptr.
extern fn ir_alloc_rc(structName: String) -> Int

// The fifth, for T4b. Like ir_alloc_rc it is a fn(size) -> ptr: the colour bits
// and the per-type descriptor go in front of the pointer, so the LLVM struct
// type is untouched and cyc_set_type fills them in afterwards.
extern fn ir_alloc_cycle(structName: String) -> Int

// Level 4's arena path for values the runtime allocates. `ir_alloc_region` only
// serves struct literals; a string comes out of str_concat, which cannot know
// where it was called from -- so the call site brackets it instead.
extern fn ir_arena_hint_begin()
extern fn ir_arena_hint_end()
extern fn ir_region_enter()
extern fn ir_region_exit()
extern fn ir_region_depth() -> Int
extern fn ir_loop_region_depth() -> Int
extern fn ir_free_object(value: String)

// AIF Level 4's second deallocator. A List is a handle plus an element block, so
// the seam's fn(ptr) -> void cannot reclaim it; this routes to the runtime's own
// list_release, which frees both through the allocator the list came from.
extern fn ir_free_list(value: String)

// Struct-field ownership. A struct that owns its fields is reclaimed by a
// function generated for its type, so the deallocator is named rather than
// fixed. Still behind the seam: the generated body frees through ir_free_object
// and its siblings, so a verify build sees every one of them.
extern fn ir_free_typed(value: String, fnName: String)
extern fn ir_free_rc(value: String)
// AIF T4a. The atomic release, as a separate symbol chosen here rather than a
// flag the runtime tests -- SPEC 11 item 10 keeps atomics off the common path,
// and a value proved never to cross a thread boundary should not pay a branch
// to find that out.
extern fn ir_free_rc_atomic(value: String)

// The release half of the hot/cold split. A split object is two allocations and
// ir_free_object frees one block without knowing its type, so the cold block is
// reclaimed from inside the generated `__aif_release_T` -- the one place where the
// pointer and the type are both in hand. A no-op for an unsplit type, which is
// what lets generateReleaseFn call it unconditionally and therefore never get it
// wrong for a particular type.
extern fn ir_free_cold(structName: String, value: String)

// The address of a named function, as a value. A container of structs that own
// their fields cannot be told its disposition with an int -- the release differs
// per element type and the runtime cannot name a type -- so it is told this.
extern fn ir_func_addr(name: String) -> Int

// An indirect call to a `fn(ptr) -> void`. The collector's visitor differs per
// traversal phase, so its callee is a value rather than a name.
extern fn ir_call_indirect_ptr(fnValue: String, arg: String)

// REQUIREMENTS 20. A `List<T>` stores pointer-sized slots, so a scalar element
// rides in one. Boxing it would cost an allocation per element and hand the
// container something to own, which is exactly what a scalar element is not.
extern fn ir_int_to_ptr(fromType: String, value: String) -> Int
extern fn ir_ptr_to_int(value: String, toType: String) -> Int
extern fn ir_bitcast(fromType: String, value: String, toType: String) -> Int
extern fn ir_struct_field_ptr(structName: String, object: String, fieldIndex: Int) -> Int
extern fn ir_elem_ptr(elemType: String, base: String, index: String) -> Int
extern fn ir_array_alloca(elemType: String, count: Int) -> Int
extern fn ir_string_ptr(globalName: String) -> Int
// LAYOUT 2. A constant C string created on demand and interned by content, for
// the type and field names the profile instrumentation passes. Distinct from
// ir_string_ptr, which resolves a global the collect_strings pre-pass named:
// these names are not source literals, so that pre-pass has nothing to find.
extern fn ir_const_cstring(text: String) -> Int
extern fn ir_load_ptr(type: String, ptrValue: String) -> Int
extern fn ir_store_ptr(type: String, value: String, ptrValue: String)
extern fn ir_copy_struct(structName: String, dest: String, src: String)

// Helpers
extern fn ir_get_temp_name(tempNum: Int) -> String produce(free)
extern fn ir_get_label_name(labelNum: Int) -> String produce(free)
extern fn ir_register_global_name(name: String)
extern fn ir_is_global_name(name: String) -> Int
extern fn ir_reset_globals()
extern fn ir_reset_types()
// Named-type registry, filled by sema before checking begins. Distinct from the
// struct registry below, which holds field layouts and is filled by codegen:
// this one only answers "is this identifier a struct, an enum, or neither?",
// which a type annotation asks for every parameter of every function.
extern fn ir_declare_named_type(name: String, kind: Int)
extern fn ir_named_type_kind(name: String) -> Int
extern fn ir_reset_named_types()

// Top-level declaration index (REQUIREMENTS 16), filled by
// indexModuleDeclarations() in ast/types.psm before either sema or codegen runs.
// `ir_decl_at` returns the AST pointer that was indexed -- our own memory, not a
// fresh allocation.
extern fn ir_reset_decl_index()
extern fn ir_index_decl(name: String, node: String)
extern fn ir_decl_count(name: String) -> Int
extern fn ir_decl_at(name: String, index: Int) -> String alias

// A function's return type, keyed by its mangled symbol. Its own table rather
// than a "$fn$" binding: those were permanent, so every identifier lookup in
// every function body scanned past one per function in the module.
extern fn ir_set_fn_return_type(symbol: String, returnType: String)
extern fn ir_get_fn_return_type(symbol: String) -> String alias
extern fn ir_reset_fn_return_types()

extern fn ir_register_struct(name: String)
extern fn ir_register_struct_field(structName: String, fieldName: String, fieldType: String)
extern fn ir_is_struct_type_name(name: String) -> Int
extern fn ir_get_struct_field_index(structName: String, fieldName: String) -> Int
// Both return an *interned* type name -- ir_add_struct_field and add_binding
// each store ir_intern(type), and the fallbacks ("i32", "i64") are literals. No
// branch allocates, so neither is a value the caller could release.
extern fn ir_get_struct_field_type(structName: String, fieldName: String) -> String alias
extern fn ir_register_enum_variant(enumName: String, variantName: String, value: Int)
extern fn ir_get_enum_variant(enumName: String, variantName: String) -> Int
extern fn ir_set_var_type(name: String, varType: String)
extern fn ir_set_global_var_type(name: String, varType: String)
extern fn ir_get_var_type(name: String) -> String alias
extern fn ir_has_var_type(name: String) -> Int

// Lexical scoping. A block pushes on entry and pops on exit; a binding is
// visible only until its scope is popped, and re-declaring a name shadows the
// outer one rather than overwriting it.
extern fn ir_scope_push()
extern fn ir_scope_pop()

// Loop barriers, so move checking can tell a binding the loop created from one
// it inherited. Moving out of the latter inside a loop repeats every iteration.
extern fn ir_loop_barrier_push()
extern fn ir_loop_barrier_pop()
extern fn ir_binding_predates_loop(name: String) -> Int

// Scope drop lists (AIF Level 2). A floor is a binding-table watermark: the
// current scope's for a block exit, the loop's for break/continue, 0 for a
// return. Enumeration is reverse construction order.
// `kind` is which deallocator reclaims the binding (IR_DROP_* in ir.psm). The
// storage type cannot answer it: a String and a List are both `ptr`.
extern fn ir_mark_droppable(name: String borrow, kind: Int)
extern fn ir_scope_drop_floor() -> Int
extern fn ir_drop_barrier_push()
extern fn ir_drop_barrier_pop()
extern fn ir_loop_drop_floor() -> Int
extern fn ir_drop_count(floor: Int) -> Int
extern fn ir_drop_slot(floor: Int, i: Int) -> String alias
extern fn ir_drop_type(floor: Int, i: Int) -> String alias
extern fn ir_drop_kind(floor: Int, i: Int) -> Int

// The LLVM-level name of the innermost binding, and whether that binding is
// module-level. Both are shadowing-aware, which is what codegen needs to pick
// between @global and %slot and to give sibling blocks separate stack slots.
extern fn ir_get_var_slot(name: String borrow) -> String alias
extern fn ir_var_is_global(name: String) -> Int
extern fn ir_mark_mutable(name: String)
extern fn ir_var_is_mutable(name: String) -> Int
extern fn ir_clear_var_types()
extern fn ir_clear_local_var_types()
extern fn ir_set_returned()
extern fn ir_has_returned() -> Int
extern fn ir_clear_returned()
extern fn ir_comment(comment: String)
extern fn ir_blank_line()

// ---------------------------------------------------------------------------
// Debug information (DWARF), off unless `-g`.
//
// The whole surface is inert until ir_debug_begin is called, so a release build
// takes not one branch differently and emits not one byte differently. That is
// the property that let this land: `prismio build` without -g produces the same
// IR it produced before debug info existed, for every program in the corpus.
//
// Every call below is allowed to decline. A node with no source span, a file the
// diagnostics registry never saw, a slot the backend cannot name -- each of
// those produces *no* entry rather than a plausible one. See the section header
// in runtime/llvm-api-backend.c for why that rule is the whole design.
// ---------------------------------------------------------------------------
extern fn ir_debug_begin(producer: String, mainPath: String, isOptimized: Int)
extern fn ir_debug_end()
extern fn ir_debug_enabled() -> Int

// A source function. `name` is what the programmer wrote and `linkageName` the
// mangled symbol, so a debugger can match a frame either way.
extern fn ir_debug_function_begin(name: String, linkageName: String, fileId: Int, line: Int)

// The declared signature, said before the body starts. Without it a signature is
// read off the LLVM function type, where a String, a List, a Point and an opaque
// extern return are all `ptr` -- so a debugger prints `void *` four times for
// four different things. Slot 0 is the return; one call per parameter follows,
// in order.
extern fn ir_debug_signature(retKey: String, retName: String)
extern fn ir_debug_signature_param(typeKey: String, typeName: String)
extern fn ir_debug_function_end()

// A lexical block, pushed and popped exactly where codegen pushes and pops a
// binding scope -- so a name is in scope for the debugger over the same span it
// is in scope for the compiler.
extern fn ir_debug_scope_push(fileId: Int, line: Int, col: Int)
extern fn ir_debug_scope_pop()

// The line every instruction built from here on belongs to.
extern fn ir_debug_location(fileId: Int, line: Int, col: Int)

// A binding and the alloca that holds it. `typeKey` is the storage key the rest
// of this surface already uses; `typeName` is the source-level name sema
// recorded, which is what turns an anonymous `ptr` into a `String` or a `Point*`.
// `argNo` is 0 for a local and the 1-based position for a parameter.
extern fn ir_debug_local(name: String, slot: String, typeKey: String, typeName: String,
                          fileId: Int, line: Int, argNo: Int)

// A module-level global and the type it was declared with. No slot, because a
// global *is* its storage -- the description attaches to the global itself, so
// this is said during the module's global loop rather than inside a function.
extern fn ir_debug_global(name: String, typeKey: String, typeName: String,
                           fileId: Int, line: Int)

// The source-level type of one field, said while the struct is being built.
// Same reason a local carries one: the registered field type is a storage key,
// and String, List<T>, [T], `T?` and every struct are all `ptr` there.
extern fn ir_debug_field_type(owner: String, field: String, typeName: String)

// A struct type and where it was declared. Emitted for every declared struct
// rather than on demand, so `p` can name a type a program only passes around.
extern fn ir_debug_struct(name: String, fileId: Int, line: Int)

// The same for an enum, which becomes a DW_TAG_enumeration_type from the variant
// map ir_register_enum_variant already holds. Nothing else is needed: the
// variants are the type.
extern fn ir_debug_enum(name: String, fileId: Int, line: Int)
