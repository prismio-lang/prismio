extern fn ir_icmp_ule(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_ugt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_icmp_uge(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_oeq(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_one(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_olt(type: String, lhs: String, rhs: String) -> Int
extern fn ir_fcmp_ole(type: String, lhs: String, rhs: String) -> Int
