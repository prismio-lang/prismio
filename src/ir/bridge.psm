extern fn ir_sitofp(fromType: String, value: String, toType: String) -> Int
extern fn ir_uitofp(fromType: String, value: String, toType: String) -> Int
extern fn ir_fptosi(fromType: String, value: String, toType: String) -> Int
extern fn ir_fptoui(fromType: String, value: String, toType: String) -> Int
