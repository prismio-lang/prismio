// Whole-module emission: functions, struct types, the release and cycle-walk
// helpers generated per struct, and the string interning pass that has to run
// before any of them.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string

// Keep the language addition inert for programs that do not use it. Runtime
// declarations are ordinary IR and therefore part of the reproducibility
// snapshot even when no call reaches them; emitting the Slice family
// unconditionally changed every program in the corpus. A written Slice type or
// a range expression is enough to select the family. Walking `next` here makes
// one call on the module's first declaration cover every child chain as well.
private fn moduleTreeUsesSlice(nodePtr: Ptr) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let node = ptr_to_node(nodePtr)
    if (node.kind == NodeKind.SLICE_EXPR) { return true }
    if (node.kind == NodeKind.TYPE_ANNOTATION and node.s1.equals("Slice")) {
        return true
    }
    if (moduleTreeUsesSlice(node.child1)) { return true }
    if (moduleTreeUsesSlice(node.child2)) { return true }
    if (moduleTreeUsesSlice(node.child3)) { return true }
    return moduleTreeUsesSlice(node.next)
}

private fn moduleTreeUsesDataView(nodePtr: Ptr) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let node = ptr_to_node(nodePtr)
    if (node.kind == NodeKind.TYPE_ANNOTATION and node.s1.equals("DataView")) {
        return true
    }
    if (node.kind == NodeKind.CALL_EXPR and nodeExists(node.child1)) {
        let callee = ptr_to_node(node.child1)
        if (callee.s1.equals("soa") or callee.s1.equals("aos")
            or callee.s1.equals("data_len")) {
            return true
        }
    }
    if (moduleTreeUsesDataView(node.child1)) { return true }
    if (moduleTreeUsesDataView(node.child2)) { return true }
    if (moduleTreeUsesDataView(node.child3)) { return true }
    return moduleTreeUsesDataView(node.next)
}

private fn generateFunction(func: ASTNode) {
    let funcName = func.s1
    let emittedName = functionSymbolName(func)

    let mut retType = "void"
    if (nodeExists(func.child3)) {
        let retNode = ptr_to_node(func.child3)
        retType = mapTypeNode(retNode)
    }

    let mut isMain = 0
    if (funcName.equals("main")) {
        retType = "i32"
        isMain = 1
    }

    let retSigType = storageType(retType)
    ir_function_begin(emittedName, retSigType)
    // The declared return, not the storage one: `struct:Point` and `String` are
    // both `ptr` by the time ir_function_begin sees them.
    debugSignature(retType, debugTypeName(func.child3, ptr_null()))

    if (isMain == 1) {
        // Real OS argc/argv only reach the C `main` symbol; stash into globals for cli_arg().
        ir_function_param("i32", "p_argc")
        ir_function_param("ptr", "p_argv")
        debugSignatureParam("i32", "Int")
        debugSignatureParam("ptr", "")
    }

    let mut paramPtr = func.child1
    while (nodeExists(paramPtr)) {
        let paramNode = ptr_to_node(paramPtr)
        let pTypeNode = ptr_to_node(paramNode.child1)
        // SPEC 5.1's `unique`, parsed into i2 by parseParameter. It already
        // asserts exactly the fact `noalias` states, so lowering it is a use of
        // an existing annotation rather than a fifth one.
        let pStore = storageType(mapTypeNode(pTypeNode))
        let pName = "p_".concat(paramNode.s1)
        if (paramNode.i2 == 1) {
            ir_function_param_unique(pStore, pName)
        } else {
            ir_function_param(pStore, pName)
        }
        debugSignatureParam(mapTypeNode(pTypeNode), debugTypeName(paramNode.child1, ptr_null()))
        paramPtr = paramNode.next
    }

    ir_function_body_start()
    // A single source callsite cannot duplicate this body, and a callsite in a
    // loop is exactly where exposing the body to the caller lets LICM and the
    // loop pipeline see invariants across the call boundary. The mark is a
    // module-wide AST fact computed below, never a function-name rule. Leave
    // debug functions alone: always-inline at -O0 would erase the frame the
    // debugger was explicitly asked to show.
    if (func.i1 == 3 and ir_debug_enabled() == 0) {
        ir_function_always_inline()
    }
    ir_clear_local_var_types()
    ir_clear_returned()

    // After ir_function_body_start, which is where the LLVM function is
    // materialised -- the subprogram's signature is read off it -- and before any
    // instruction is built, because LLVM requires every call in a function that
    // has debug info to carry a location.
    debugOpenFunction(func, emittedName)

    if (isMain == 1) {
        ir_store_global("i32", "%p_argc", "prismio_argc")
        ir_store_global("ptr", "%p_argv", "prismio_argv")
    }

    // Parameter scope, outside the body block, matching semaFunction.
    ir_scope_push()

    let mut paramPtr2 = func.child1
    let mut paramIndex = 0
    while (nodeExists(paramPtr2)) {
        let paramNode = ptr_to_node(paramPtr2)
        let pTypeNode = ptr_to_node(paramNode.child1)
        let pTypeStr = mapTypeNode(pTypeNode)
        let pStoreType = storageType(pTypeStr)

        ir_set_var_type(paramNode.s1, pTypeStr)
        let pSlot = ir_get_var_slot(paramNode.s1)
        ir_alloca(pStoreType, pSlot)
        ir_store(pStoreType, "%p_".concat(paramNode.s1), pSlot)

        // The German-string representation, resolved once in the entry block --
        // which dominates the whole body, so every byte read in it can index a
        // pointer rather than ask per character where the bytes are. Parameters
        // are borrows and cannot be reassigned, so the answer cannot go stale.
        // See `data_ptr` in runtime/ir_symbols.c.
        if (isFatStringKey(pStoreType)) {
            ir_set_var_data(paramNode.s1, ir_str_data("%p_".concat(paramNode.s1)))
        }

        // The *declared* key, not the storage one: `struct:Point` is what says
        // the slot holds a Point and not an unlabelled address. argc/argv are
        // deliberately not described -- they are main's real C parameters, which
        // the program never named and cannot see.
        paramIndex = paramIndex + 1
        debugLocal(paramNode.s1, pSlot, pTypeStr,
                   debugTypeName(paramNode.child1, ptr_null()), paramNode, paramIndex)

        paramPtr2 = paramNode.next
    }

    // Locals are created where they are declared now, rather than hoisted by a
    // separate pre-pass. The backend still places every alloca in the entry
    // block, so a `let` inside a loop body does not grow the stack per
    // iteration -- and each declaration gets its own slot, which the old
    // name-keyed pre-pass could not express.
    if (nodeExists(func.child2)) {
        irFunctionDecl = node_to_ptr(func)
        irFunctionBody = func.child2

        generateBlock(ptr_to_node(func.child2))
        irFunctionBody = ptr_null()
        irFunctionDecl = ptr_null()
    }

    ir_scope_pop()

    if (ir_has_returned() == 0) {
        if (retSigType.equals("void")) {
            ir_ret_void()
        } else {
            if (isMain == 1) {
                ir_ret("i32", "0")
            } else {
                ir_ret(retSigType, "0")
            }
        }
    }

    // After the implicit return above, so that return still carries this
    // function's location rather than none.
    debugCloseFunction()
    ir_function_end()
}

internal fn functionHasStringParam(func: ASTNode) -> Bool {
    let mut paramPtr = func.child1
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        if (isFatStringKey(storageType(mapTypeNode(ptr_to_node(param.child1))))) {
            return true
        }
        paramPtr = param.next
    }
    return false
}

internal fn taskFunctionForCall(call: ASTNode) -> Ptr {
    let callee = ptr_to_node(call.child1)
    let mut symbol = callee.s1
    if (call.s2.equals("") == false) { symbol = call.s2 }

    let count = ir_decl_count(callee.s1)
    let mut i = 0
    while (i < count) {
        let decl = ptr_to_node(ir_decl_at(callee.s1, i))
        if (decl.kind == NodeKind.FUNCTION) {
            if (functionSymbolName(decl).equals(symbol)) {
                return node_to_ptr(decl)
            }
        }
        i = i + 1
    }
    return ptr_null()
}

internal fn taskThunkName(func: ASTNode) -> String {
    return functionSymbolName(func).concat("__task")
}

// First pass: count every direct source callsite, capped at two. A unique
// callsite is the fact that prevents code duplication; recursion is deliberately
// disqualified even when there is only one syntactic self-call.
private fn countFunctionCallsitesNode(nodePtr: Ptr, callerSymbol: String) {
    if (nodeIsNull(nodePtr)) { return }
    let node = ptr_to_node(nodePtr)

    if (node.kind == NodeKind.CALL_EXPR and nodeExists(node.child1)) {
        let targetPtr = taskFunctionForCall(node)
        if (nodeExists(targetPtr)) {
            let target = ptr_to_node(targetPtr)
            let recursive = functionSymbolName(target).equals(callerSymbol)
            if (target.i1 == 0 and recursive == false) {
                target.i1 = 1
            } else {
                target.i1 = 2
            }
        }
    }

    countFunctionCallsitesChain(node.child1, callerSymbol)
    countFunctionCallsitesChain(node.child2, callerSymbol)
    countFunctionCallsitesChain(node.child3, callerSymbol)
}

private fn countFunctionCallsitesChain(head: Ptr, callerSymbol: String) {
    let mut p = head
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        countFunctionCallsitesNode(node_to_ptr(node), callerSymbol)
        p = node.next
    }
}

private fn isSourceLoop(node: ASTNode) -> Bool {
    return node.kind == NodeKind.FOR_STATEMENT
        or node.kind == NodeKind.WHILE_STATEMENT
        or node.kind == NodeKind.LOOP_STATEMENT
}

// Count source calls at this loop level. Nested loops are separate optimization
// regions: counting their calls in the parent made one inner call appear in two
// loops and made a parent's unrelated siblings consume its inline budget.
private fn directLoopCallCountNode(nodePtr: Ptr) -> Int {
    if (nodeIsNull(nodePtr)) { return 0 }
    let node = ptr_to_node(nodePtr)
    if (isSourceLoop(node)) { return 0 }

    let mut count = 0
    if (node.kind == NodeKind.CALL_EXPR and nodeExists(taskFunctionForCall(node))) {
        count = 1
    }
    return count
        + directLoopCallCountChain(node.child1)
        + directLoopCallCountChain(node.child2)
        + directLoopCallCountChain(node.child3)
}

private fn directLoopCallCountChain(head: Ptr) -> Int {
    let mut count = 0
    let mut p = head
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        count = count + directLoopCallCountNode(node_to_ptr(node))
        p = node.next
    }
    return count
}

private fn directLoopCallTargetNode(nodePtr: Ptr) -> Ptr {
    if (nodeIsNull(nodePtr)) { return ptr_null() }
    let node = ptr_to_node(nodePtr)
    if (isSourceLoop(node)) { return ptr_null() }

    if (node.kind == NodeKind.CALL_EXPR) {
        let target = taskFunctionForCall(node)
        if (nodeExists(target)) { return target }
    }

    let a = directLoopCallTargetChain(node.child1)
    if (nodeExists(a)) { return a }
    let b = directLoopCallTargetChain(node.child2)
    if (nodeExists(b)) { return b }
    return directLoopCallTargetChain(node.child3)
}

private fn directLoopCallTargetChain(head: Ptr) -> Ptr {
    let mut p = head
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        let target = directLoopCallTargetNode(node_to_ptr(node))
        if (nodeExists(target)) { return target }
        p = node.next
    }
    return ptr_null()
}

// Second pass: spend one inline budget per loop. A loop with several source
// calls (g4's four systems) keeps ordinary call boundaries; forcing all four
// into one frame body measured 1.218x and grew main from 543 to 597 mnemonics.
private fn markUniqueLoopCallsNode(nodePtr: Ptr) {
    if (nodeIsNull(nodePtr)) { return }
    let node = ptr_to_node(nodePtr)

    if (isSourceLoop(node)) {
        let count = directLoopCallCountChain(node.child1)
            + directLoopCallCountChain(node.child2)
            + directLoopCallCountChain(node.child3)
        if (count == 1) {
            let mut target = directLoopCallTargetChain(node.child1)
            if (nodeIsNull(target)) { target = directLoopCallTargetChain(node.child2) }
            if (nodeIsNull(target)) { target = directLoopCallTargetChain(node.child3) }
            if (nodeExists(target)) {
                let func = ptr_to_node(target)
                if (func.i1 == 1) { func.i1 = 3 }
            }
        }
    }

    markUniqueLoopCallsChain(node.child1)
    markUniqueLoopCallsChain(node.child2)
    markUniqueLoopCallsChain(node.child3)
}

private fn markUniqueLoopCallsChain(head: Ptr) {
    let mut p = head
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        markUniqueLoopCallsNode(node_to_ptr(node))
        p = node.next
    }
}

private fn markSingleLoopCallsiteFunctions(module: ASTNode) {
    // The same AST can be emitted first as a workload driver and then as the
    // shipped program, so no mark may survive from the earlier emission.
    let mut clearPtr = module.child1
    while (nodeExists(clearPtr)) {
        let decl = ptr_to_node(clearPtr)
        if (decl.kind == NodeKind.FUNCTION) { decl.i1 = 0 }
        clearPtr = decl.next
    }

    let mut fnPtr = module.child1
    while (nodeExists(fnPtr)) {
        let func = ptr_to_node(fnPtr)
        if (func.kind == NodeKind.FUNCTION and nodeExists(func.child2)) {
            countFunctionCallsitesNode(func.child2, functionSymbolName(func))
        }
        fnPtr = func.next
    }

    let mut markPtr = module.child1
    while (nodeExists(markPtr)) {
        let func = ptr_to_node(markPtr)
        if (func.kind == NodeKind.FUNCTION and nodeExists(func.child2)) {
            markUniqueLoopCallsNode(func.child2)
        }
        markPtr = func.next
    }
}

// A task crosses the C runtime through up to three `void*` slots. A String does
// not: its native Prismio signature is `{ptr, i64}`, and passing only its pointer
// half happened to work until code read the length. The thunk has the runtime's
// pointer-only signature and makes an ordinary, honestly typed call to the real
// function, leaving LLVM to implement both ABIs on every target.
private fn generateTaskThunk(func: ASTNode) {
    let retType = storageType(getDeclaredReturnType(func, func.child3))
    ir_function_begin(taskThunkName(func), retType)

    let mut paramPtr = func.child1
    let mut i = 0
    while (nodeExists(paramPtr)) {
        ir_function_param("ptr", "p_task".concat(strFromInt(i)))
        paramPtr = ptr_to_node(paramPtr).next
        i = i + 1
    }

    ir_function_body_start()
    ir_call_begin()
    let mut argPtr = func.child1
    let mut j = 0
    while (nodeExists(argPtr)) {
        let param = ptr_to_node(argPtr)
        let paramType = storageType(mapTypeNode(ptr_to_node(param.child1)))
        let raw = "%p_task".concat(strFromInt(j))
        if (isFatStringKey(paramType)) {
            ir_call_arg(paramType, fatFromPtr(raw))
        } else {
            ir_call_arg(paramType, raw)
        }
        argPtr = param.next
        j = j + 1
    }

    if (retType.equals("void")) {
        ir_call_end("void", functionSymbolName(func))
        ir_ret_void()
    } else {
        let result = ir_get_temp_name(ir_call_end(retType, functionSymbolName(func)))
        ir_ret(retType, result)
    }
    ir_function_end()
}

// Pre-pass: collect string literals
internal fn collectStringsExpr(expr: ASTNode) {
    if (expr.kind == NodeKind.LITERAL_EXPR) {
        if (expr.i1 == TokenType.STRING_LITERAL) {
            let strName = ".str.s".concat(strFromInt(irStringCounter))
            irStringCounter = irStringCounter + 1
            ir_global_string(strName, expr.s1)
            expr.s2 = strName
        }
    }
    if (expr.kind == NodeKind.UNARY_EXPR or expr.kind == NodeKind.CAST_EXPR) {
        if (nodeExists(expr.child1)) {
            collectStringsExpr(ptr_to_node(expr.child1))
        }
    }
    if (expr.kind == NodeKind.BINARY_EXPR) {
        if (nodeExists(expr.child1)) {
            collectStringsExpr(ptr_to_node(expr.child1))
        }
        if (nodeExists(expr.child2)) {
            collectStringsExpr(ptr_to_node(expr.child2))
        }
    }
    if (expr.kind == NodeKind.CALL_EXPR) {
        let mut argPtr = expr.child2
        while (nodeExists(argPtr)) {
            let argNode = ptr_to_node(argPtr)
            collectStringsExpr(argNode)
            argPtr = argNode.next
        }
    }
    if (expr.kind == NodeKind.SPAWN_EXPR) {
        if (nodeExists(expr.child1)) {
            let call = ptr_to_node(expr.child1)
            let target = taskFunctionForCall(call)
            if (nodeExists(target)) {
                let func = ptr_to_node(target)
                if (functionHasStringParam(func)) { func.i3 = 1 }
            }
            // The call owns the complete argument subtree, including literals.
            // Missing this case made `spawn f("text")` reach codegen unnamed.
            collectStringsExpr(call)
        }
    }
    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let mut elemPtr = expr.child1
        while (nodeExists(elemPtr)) {
            let elemNode = ptr_to_node(elemPtr)
            collectStringsExpr(elemNode)
            elemPtr = elemNode.next
        }
    }
    if (expr.kind == NodeKind.INDEX_EXPR) {
        if (nodeExists(expr.child1)) {
            collectStringsExpr(ptr_to_node(expr.child1))
        }
        if (nodeExists(expr.child2)) {
            collectStringsExpr(ptr_to_node(expr.child2))
        }
    }
    if (expr.kind == NodeKind.SLICE_EXPR) {
        if (nodeExists(expr.child1)) { collectStringsExpr(ptr_to_node(expr.child1)) }
        if (nodeExists(expr.child2)) { collectStringsExpr(ptr_to_node(expr.child2)) }
        if (nodeExists(expr.child3)) { collectStringsExpr(ptr_to_node(expr.child3)) }
    }
    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        if (nodeExists(expr.child1)) {
            collectStringsExpr(ptr_to_node(expr.child1))
        }
    }
    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        let mut fieldPtr = expr.child1
        while (nodeExists(fieldPtr)) {
            let field = ptr_to_node(fieldPtr)
            if (nodeExists(field.child1)) {
                collectStringsExpr(ptr_to_node(field.child1))
            }
            fieldPtr = field.next
        }
    }
}

private fn declareExternFunction(ext: ASTNode) {
    let mut retType = getDeclaredReturnType(ext, ext.child2)
    ir_set_fn_return_type(functionSymbolName(ext), retType)

    ir_declare_function_begin(functionSymbolName(ext), ffiType(storageType(retType)))
    let mut paramPtr = ext.child1
    while (nodeExists(paramPtr)) {
        let paramNode = ptr_to_node(paramPtr)
        let pTypeNode = ptr_to_node(paramNode.child1)
        ir_declare_function_param(ffiType(storageType(mapTypeNode(pTypeNode))))
        paramPtr = paramNode.next
    }
    ir_declare_function_end()
}

// ---------------------------------------------------------------------------
// LAYOUT 3.2 -- W3, the sandbox's half that codegen owns
//
// A workload runs at build time, so an `extern fn` it can reach is a hole in the
// build: `system`, `fopen` and `getenv` are all one declaration away, and none of
// them is reproducible. W3 says such effects "SHALL be stubbed, and their use
// SHALL warn" -- so the driver gets a *definition* whose body warns and returns
// zero, in place of a declaration the linker would resolve against libc.
//
// **The test is provenance, not a blacklist**, and that direction is the point.
// A blacklist of dangerous names is wrong the first time someone declares a
// symbol nobody listed; asking instead "does the Prismio runtime define this?"
// is closed, because the runtime is a fixed set of files this compiler ships.
// Anything outside it is stubbed whether or not anyone thought of it.
//
// The cost is that a workload cannot call a legitimate foreign library. That is
// the clause's intent read literally: a workload needing a real environment is
// not reproducible and is therefore not a workload.
private fn irRuntimeProvides(name: String) -> Bool {
    if (strStartsWith(name, "str_")) { return true }
    if (strStartsWith(name, "list_")) { return true }
    if (strStartsWith(name, "prismio_rt_")) { return true }
    if (strStartsWith(name, "rt_")) { return true }
    if (strStartsWith(name, "rc_")) { return true }
    if (strStartsWith(name, "arena_")) { return true }
    if (strStartsWith(name, "cyc_")) { return true }
    if (strStartsWith(name, "aif_verify_")) { return true }
    if (name.equals("int_to_str")) { return true }
    if (name.equals("float_to_str")) { return true }
    if (name.equals("char_code")) { return true }
    if (name.equals("malloc")) { return true }
    if (name.equals("free")) { return true }
    // `exit` is deliberately provided. A workload that exits early has measured
    // whatever ran before it, which is a smaller sample and not a broken one --
    // stubbing it would turn a program that stops into one that runs on past the
    // point its author meant it to stop, which is worse.
    if (name.equals("exit")) { return true }
    return false
}

// A stub's return is zero of whatever the declaration says. `ret void` for void;
// `ret ptr null` for anything pointer-shaped, because a stubbed producer handing
// back an integer 0 cast to a pointer is the same null but takes a cast to say
// so; and a zero of the right width otherwise.
private fn generateExternStub(ext: ASTNode) {
    let retType = getDeclaredReturnType(ext, ext.child2)
    let retSig = storageType(retType)

    ir_function_begin(functionSymbolName(ext), retSig)
    let mut paramPtr = ext.child1
    let mut i = 0
    while (nodeExists(paramPtr)) {
        let paramNode = ptr_to_node(paramPtr)
        let pTypeNode = ptr_to_node(paramNode.child1)
        ir_function_param(storageType(mapTypeNode(pTypeNode)), "p_s".concat(strFromInt(i)))
        i = i + 1
        paramPtr = paramNode.next
    }
    ir_function_body_start()

    ir_call_begin()
    ir_call_arg("ptr", ir_get_temp_name(ir_const_cstring(ext.s1)))
    ir_call_end("i64", "rt_workload_stub")

    if (retSig.equals("void")) {
        ir_ret_void()
    } else if (retSig.equals("ptr")) {
        ir_ret("ptr", "null")
    } else {
        ir_ret(retSig, "0")
    }
    ir_function_end()
}

// ---------------------------------------------------------------------------
// LAYOUT 3.2 -- the workload driver
//
// The instrumented build's `main`. It replaces the program's own, which is why
// the profile cannot be contaminated by whatever that main does: the driver runs
// `setup`, turns counting on, runs `measure` the declared number of times, turns
// it off, and writes the profile out.
//
// `setup` outside the counted region is LAYOUT 3.1's whole reason for the split
// -- "input construction must not pollute the access counts of the code under
// study" -- and it is one call either side of it rather than a flag threaded
// through codegen, so there is no site that can forget.
//
// `setup` also runs *once*, outside the repeat loop, which is the reading of
// 3.1 the wording forces: "runs once per execution and is excluded". Putting it
// inside the loop would rebuild the input for every repetition and measure a
// program nobody wrote.
private fn generateWorkloadDriver(workload: ASTNode, profilePath: String) {
    ir_function_begin("main", "i32")
    ir_function_param("i32", "p_argc")
    ir_function_param("ptr", "p_argv")
    ir_function_body_start()
    ir_clear_local_var_types()
    ir_clear_returned()

    // Deliberately *not* stored into prismio_argc/prismio_argv, which is what
    // generateFunction does for a real main. cli_arg() therefore reads the zero
    // initialisers and a workload cannot branch on the compiler's own command
    // line -- the profile is a function of the program, not of how it was built.
    ir_scope_push()

    if (nodeExists(workload.child1)) {
        irFunctionBody = workload.child1
        generateBlock(ptr_to_node(workload.child1))
    }

    ir_call_begin()
    ir_call_end("void", "rt_profile_begin")

    // `repeat` as a counted loop. Emitted here rather than by desugaring to a
    // FOR_STATEMENT because a desugar would need a loop variable name, and any
    // name it chose could collide with one the workload's own body declares.
    let counterSlot = "%wl_i"
    ir_alloca("i32", counterSlot)
    ir_store("i32", "0", counterSlot)

    let headLabel = ir_get_label()
    let bodyLabel = ir_get_label()
    let doneLabel = ir_get_label()

    ir_br_numbered(headLabel)
    ir_label_numbered(headLabel)
    let cur = ir_get_temp_name(ir_load("i32", counterSlot))
    let more = ir_get_temp_name(ir_icmp_slt("i32", cur, strFromInt(workload.i1)))
    ir_cond_br_numbered(more, bodyLabel, doneLabel)

    ir_label_numbered(bodyLabel)
    if (nodeExists(workload.child2)) {
        irFunctionBody = workload.child2
        generateBlock(ptr_to_node(workload.child2))
    }
    let cur2 = ir_get_temp_name(ir_load("i32", counterSlot))
    let next = ir_get_temp_name(ir_add("i32", cur2, "1"))
    ir_store("i32", next, counterSlot)
    ir_br_numbered(headLabel)

    ir_label_numbered(doneLabel)
    irFunctionBody = ptr_null()

    ir_call_begin()
    ir_call_end("void", "rt_profile_end")

    ir_call_begin()
    ir_call_arg("ptr", ir_get_temp_name(ir_const_cstring(profilePath)))
    ir_call_arg("ptr", ir_get_temp_name(ir_const_cstring(workload.s1)))
    ir_call_arg("i32", strFromInt(workload.i1))
    ir_call_end("i32", "rt_profile_dump")

    ir_scope_pop()
    ir_ret("i32", "0")
    ir_function_end()
}

fn findWorkload(module: ASTNode) -> ASTNode {
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.WORKLOAD_DECL) { return d }
        p = d.next
    }
    return ptr_to_node(ptr_null())
}

fn moduleWorkloadCount(module: ASTNode) -> Int {
    let mut n = 0
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.WORKLOAD_DECL) { n = n + 1 }
        p = d.next
    }
    return n
}

// Asked once per extern declaration, from a walk over every declaration, so the
// walk it used to do was the same quadratic REQUIREMENTS 16 names in sema. Same
// answer, from the index generateModule fills.
private fn moduleHasFunction(module: ASTNode, name: String) -> Bool {
    let count = ir_decl_count(name)
    let mut i = 0
    while (i < count) {
        let stmt = ptr_to_node(ir_decl_at(name, i))
        if (stmt.kind == NodeKind.FUNCTION) {
            return true
        }
        i = i + 1
    }

    return false
}

private fn registerEnumDecl(enumNode: ASTNode) {
    let mut variantPtr = enumNode.child1
    let mut value = 0
    while (nodeExists(variantPtr)) {
        let variant = ptr_to_node(variantPtr)
        ir_register_enum_variant(enumNode.s1, variant.s1, value)
        value = value + 1
        variantPtr = variant.next
    }
}

private fn registerStructName(structNode: ASTNode) {
    ir_register_struct(structNode.s1)
}

// The registered type of a field, which is what decides its physical layout:
// `struct:T` for an inline field and `ptr` for a reference. typeAnnIsPod
// (ast/types.psm) is the single definition both this and AIF's sizing ask, and
// it is decided from declarations alone -- never from AIF, because a layout that
// depended on the analysis would differ between `--debug` and a release build,
// and SPEC 7.2 requires a level to change no observable behaviour.
private fn fieldTypeFor(module: ASTNode, typeNode: ASTNode) -> String {
    let t = mapTypeNode(typeNode)
    if (isStructTypeKey(t)) {
        if (typeAnnIsPod(module, typeNode, 0)) {
            return fieldStorageType(t)
        }
        return storageType(t)
    }
    return fieldStorageType(t)
}

private fn externSignatureHasRawPtr(func: ASTNode) -> Bool {
    // EXTERN_FUNCTION stores its return annotation in child2 (an ordinary
    // FUNCTION uses child3 because child2 is its body).
    if (nodeExists(func.child2)) {
        if (mapTypeNode(ptr_to_node(func.child2)).equals("ptr")) { return true }
    }
    let mut paramPtr = func.child1
    while (nodeExists(paramPtr)) {
        let param = ptr_to_node(paramPtr)
        if (mapTypeNode(ptr_to_node(param.child1)).equals("ptr")) { return true }
        paramPtr = param.next
    }
    return false
}

private fn disableStructPathForAnnotation(typePtr: Ptr) {
    if (nodeIsNull(typePtr)) { return }
    let key = mapTypeNode(ptr_to_node(typePtr))
    if (isStructTypeKey(key) and isValueStructKey(key) == false) {
        ir_struct_disable_path_tbaa(structTypeName(key))
    }
}

// `Ptr` is the language's explicit type-punning escape hatch. If an extern
// signature converts a named struct to or from it, a distinct struct TBAA base
// would turn that unmanaged promise into C strict aliasing and could miscompile
// two typed views of the same bytes. Those structs keep scalar tags only.
private fn registerRawPtrStructs(module: ASTNode) {
    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)
        if (stmt.kind == NodeKind.EXTERN_FUNCTION and externSignatureHasRawPtr(stmt)) {
            disableStructPathForAnnotation(stmt.child2)
            let mut paramPtr = stmt.child1
            while (nodeExists(paramPtr)) {
                let param = ptr_to_node(paramPtr)
                disableStructPathForAnnotation(param.child1)
                paramPtr = param.next
            }
        }
        stmtPtr = stmt.next
    }
}

private fn generateStructDecl(structNode: ASTNode, module: ASTNode) {
    let firstFieldPtr = structNode.child1
    if (nodeExists(firstFieldPtr)) {
        let firstField = ptr_to_node(firstFieldPtr)
        if (ir_get_struct_field_index(structNode.s1, firstField.s1) >= 0) {
            return
        }
    }

    // LLVMStructSetBody needs every element type sized, so a struct that embeds
    // another has to wait for it. Declaration order does not supply that -- a
    // program may name `Transform` before `Vec3` -- so the containment edges are
    // followed first. The guard above is what makes this terminate on a diamond
    // and what keeps it linear; a containment *cycle* is rejected by
    // semaCheckStructContainment before codegen runs, so it cannot arrive here.
    let mut depPtr = structNode.child1
    while (nodeExists(depPtr)) {
        let depField = ptr_to_node(depPtr)
        let depType = fieldTypeFor(module, ptr_to_node(depField.child1))
        if (isStructTypeKey(depType)) {
            let depName = structTypeName(depType)
            if (depName.equals(structNode.s1) == false) {
                let depDecl = findStructDeclNamed(module, depName)
                if (nodeExists(node_to_ptr(depDecl))) {
                    generateStructDecl(depDecl, module)
                }
            }
        }
        depPtr = depField.next
    }

    ir_struct_type_begin(structNode.s1)

    // LAYOUT 7.2. The physical order is the search's, not the source's, and the
    // two registrations below stay in one loop so the name -> index map and the
    // LLVM body cannot disagree. Every field access in codegen goes through
    // ir_get_struct_field_index, so nothing else has to know a layout was chosen.
    //
    // Safe to permute at all only because C sees a Prismio struct as an opaque
    // `void*` -- ptr_to_node and its siblings are the identity on a pointer and
    // no runtime function reads a field. If that ever stops being true, this is
    // the line that breaks, silently.
    //
    // "" means AIF did not run, which is SPEC 7.1's zero-analysis mode: fall back
    // to declaration order, which is what this did before a layout existed.
    let mut i = 0
    let mut emitted = 0
    while (i < irFieldCountOf(structNode)) {
        let chosen = aif_layout_field(structNode.s1, i)
        if (chosen.equals("") == false) {
            let field = findStructField(structNode, chosen)
            if (nodeExists(node_to_ptr(field))) {
                let fieldType = fieldTypeFor(module, ptr_to_node(field.child1))
                ir_register_struct_field(structNode.s1, field.s1, fieldType)
                debugFieldType(structNode.s1, field.s1, field.child1)
                ir_struct_type_field(fieldType)
                emitted = emitted + 1
            }
        }
        i = i + 1
    }

    if (emitted == 0) {
        let mut fieldPtr = structNode.child1
        while (nodeExists(fieldPtr)) {
            let field = ptr_to_node(fieldPtr)
            let typeNode = ptr_to_node(field.child1)
            let fieldType = fieldTypeFor(module, typeNode)
            ir_register_struct_field(structNode.s1, field.s1, fieldType)
            debugFieldType(structNode.s1, field.s1, field.child1)
            ir_struct_type_field(fieldType)
            fieldPtr = field.next
        }
        // Only on the layout the search chose. The fallback above is declaration
        // order, which is SPEC 7.1's zero-analysis mode -- there is no cut to
        // apply, and applying one to a different order would put arbitrary fields
        // behind the cold pointer.
        ir_struct_type_end()
        return
    }

    // LAYOUT 6. The cut, in the same index space the loop above just emitted:
    // aif_layout_field hands hot fields first, so the count is where they stop.
    // 0 for every type the search left alone.
    ir_struct_type_split(aif_layout_hot_count(structNode.s1))
    ir_struct_type_end()
}

// Struct-field ownership. The generated release for a type.
//
// Named rather than numbered so the IR reads, and so two builds of the same
// program name the same function -- the manifest is diffed and so is the IR.
internal fn releaseFnName(typeName: String) -> String {
    return "__aif_release_".concat(typeName)
}

// The release disposition after applying the layout veto shared by both the
// tail-self scan and the field walk below. A user struct stored inline is part
// of its owner's allocation; a fat String is the exception because its inline
// pair still owns a separate character buffer.
private fn generatedFieldRelease(tname: String, field: ASTNode) -> Int {
    let fieldKey = ir_get_struct_field_type(tname, field.s1)
    let mut disp = aif_field_release(tname, field.s1)
    if (isStructTypeKey(fieldKey) and isFatStringKey(fieldKey) == false) {
        disp = AIF_ELEM_NONE
    }
    return disp
}

// Emits one release per owned field, then frees the object.
//
// **Reverse declaration order**, as everywhere else a scope unwinds: a later
// field may hold a reference to one declared before it, never after. And the
// object itself goes last, because every field address is computed from it.
//
// The struct's own storage goes through ir_free_object, so the seam still sees
// it: a verify build's accounting counts this free exactly as it counts a scope
// drop's, and an arena build routes it the same way.
private fn generateReleaseFn(structNode: ASTNode) {
    let tname = structNode.s1
    ir_function_begin(releaseFnName(tname), "void")
    ir_function_param("ptr", "p_obj")
    ir_function_body_start()

    let n = irFieldCountOf(structNode)

    // The field walk below is reverse declaration order. Its last direct call
    // back into this release therefore comes from the lowest-index owned field
    // of the same type. Remember that field and turn only that call into the
    // loop continuation; all earlier fields keep their ordinary recursive
    // releases, so their order and semantics do not change.
    let mut tailSelfIndex = 0 - 1
    let mut foundLastRelease = false
    let mut scan = 0
    while (scan < n and foundLastRelease == false) {
        let field = nthStructField(structNode, scan)
        if (nodeExists(node_to_ptr(field))) {
            let disp = generatedFieldRelease(tname, field)
            if (disp != AIF_ELEM_NONE) {
                // This is the last release in the reverse-order walk. Only a
                // self-typed field here is a tail call; choosing a later self
                // field would move this release across an earlier owned field.
                foundLastRelease = true
                if (disp == AIF_ELEM_TYPED) {
                    let ftype = ptr_to_node(field.child1)
                    if (ftype.s1.equals(tname)) { tailSelfIndex = scan }
                }
            }
        }
        scan = scan + 1
    }

    // A slot keeps the frontend bridge simple; mem2reg turns it into the loop
    // phi. The null test belongs inside the loop because an optional/tail enum
    // field can terminate the traversal with a null value.
    let currentSlot = "release.current"
    ir_alloca("ptr", currentSlot)
    ir_store("ptr", "%p_obj", currentSlot)
    let loopLabel = ir_get_label()
    let bodyLabel = ir_get_label()
    let doneLabel = ir_get_label()
    ir_br_numbered(loopLabel)
    ir_label_numbered(loopLabel)
    let current = ir_get_temp_name(ir_load("ptr", currentSlot))
    let isNull = ir_get_temp_name(ir_icmp_eq("ptr", current, "null"))
    ir_cond_br_numbered(isNull, doneLabel, bodyLabel)
    ir_label_numbered(bodyLabel)

    let mut tailValue = "null"
    let mut i = n - 1
    while (i >= 0) {
        let field = nthStructField(structNode, i)
        if (nodeExists(node_to_ptr(field))) {
            // An inline field is storage inside this object, not a pointer to
            // one, so there is nothing to release and the address is interior --
            // handing it to a deallocator would be a free of the middle of our
            // own allocation. The registry is asked rather than AIF because the
            // registry is what decided the layout. Inline implies plain data
            // (structIsPod), so there is never a nested release to run either.
            //
            // **A fat `String` is the exception, and excluding it is the fix for
            // a leak this veto caused.** `String` is `struct:prismio.str`, a
            // `{ptr, i64}` that does live in the object's own storage -- so it
            // matches isStructTypeKey and was vetoed with the inline structs.
            // But the half that is a pointer owns a heap buffer, so "inline
            // implies plain data" is true of a user struct and false of this one:
            // `struct Thing { name: String }` in a container leaked one buffer
            // per element, and UMS -- whose models are almost entirely `strClone`d
            // String fields -- leaked 1475 of 2112 allocations.
            let disp = generatedFieldRelease(tname, field)
            if (disp != AIF_ELEM_NONE) {
                let idx = ir_get_struct_field_index(tname, field.s1)
                let slot = ir_struct_field_ptr(tname, current, idx)
                let loaded = ir_struct_load_ptr("ptr", ir_get_temp_name(slot), tname, idx)
                let value = ir_get_temp_name(loaded)
                if (disp == AIF_ELEM_LIST) {
                    ir_free_list(value)
                } else if (disp == AIF_ELEM_RC or disp == AIF_ELEM_CYCLE) {
                    // AIF_ELEM_CYCLE pairs with AIF_ELEM_RC exactly as
                    // CYCLE_ATOMIC pairs with RC_ATOMIC below: a field on a cyclic
                    // edge gets the *count* decremented and nothing else, because
                    // collector registration is the container's business.
                    //
                    // **Unreachable until M2.1a, and it fell into the plain
                    // ir_free_object below.** A CYCLE disposition can only arise
                    // on a field that re-enters its owner's type, and
                    // field_closes_cycle vetoed every one of those -- so removing
                    // that veto turned this missing branch into a double free of
                    // a collected object. test_52 reported 8 violations, which is
                    // the whole reason its counts are asserted.
                    ir_free_rc(value)
                } else if (disp == AIF_ELEM_RC_ATOMIC or disp == AIF_ELEM_CYCLE_ATOMIC) {
                    // AIF T4a. The same decrement through the atomic entry
                    // point. CYCLE_ATOMIC lands here too and gets only the
                    // count: collector registration is a container's business
                    // (list_release drives cyc_release), and a struct field is
                    // not a container.
                    ir_free_rc_atomic(value)
                } else if (disp == AIF_ELEM_TYPED and i != tailSelfIndex) {
                    let ftype = ptr_to_node(field.child1)
                    ir_free_typed(value, releaseFnName(ftype.s1))
                } else if (disp != AIF_ELEM_TYPED) {
                    ir_free_object(value)
                }
                // Last use in source order: assigning a String transfers it,
                // and sema intentionally does not make that move path-sensitive.
                if (disp == AIF_ELEM_TYPED and i == tailSelfIndex) {
                    tailValue = value
                }
            }
        }
        i = i - 1
    }

    // LAYOUT 6's hot/cold split, the release half. A split object is two
    // allocations and ir_free_object below frees one block without knowing its
    // type; this is the one point in the program that has both the pointer and
    // the type, which is why `aif_type_releases` is forced true for every split
    // type -- so that every way a split object can die passes through here.
    //
    // Before the object's own free, not after: the cold pointer lives inside the
    // hot record. A no-op when the type is not split.
    ir_free_cold(tname, current)
    ir_free_object(current)
    if (tailSelfIndex >= 0) {
        ir_store("ptr", tailValue, currentSlot)
        ir_br_numbered(loopLabel)
    } else {
        ir_br_numbered(doneLabel)
    }
    ir_label_numbered(doneLabel)
    ir_ret_void()
    ir_function_end()
}

// CYCLES 4. The per-type function the collector is told about at construction:
// it visits exactly the fields whose type is in the owner's SCC.
//
// That restriction is the design's contribution and it is what makes the work
// bound credible. Every edge of a value cycle joins two types in one SCC, so
// walking only these still finds every cycle -- and the traversal never *leaves*
// the skeleton into the string and token graphs hanging off it, which are
// usually far larger.
internal fn cyclicChildrenFnName(typeName: String) -> String {
    return "__aif_cyclic_children_".concat(typeName)
}

private fn generateCyclicChildrenFn(structNode: ASTNode) {
    let tname = structNode.s1
    ir_function_begin(cyclicChildrenFnName(tname), "void")
    ir_function_param("ptr", "p_obj")
    ir_function_param("ptr", "p_visit")
    ir_function_body_start()

    let n = irFieldCountOf(structNode)
    let mut i = 0
    while (i < n) {
        let field = nthStructField(structNode, i)
        if (nodeExists(node_to_ptr(field))) {
            if (aif_field_is_cyclic(tname, field.s1) == 1) {
                let idx = ir_get_struct_field_index(tname, field.s1)
                let slot = ir_struct_field_ptr(tname, "%p_obj", idx)
                let loaded = ir_struct_load_ptr("ptr", ir_get_temp_name(slot), tname, idx)
                ir_call_indirect_ptr("%p_visit", ir_get_temp_name(loaded))
            }
        }
        i = i + 1
    }

    ir_ret_void()
    ir_function_end()
}

private fn nthStructField(structNode: ASTNode, want: Int) -> ASTNode {
    let mut seen = 0
    let mut p = structNode.child1
    while (nodeExists(p)) {
        let f = ptr_to_node(p)
        if (f.kind == NodeKind.STRUCT_FIELD) {
            if (seen == want) { return f }
            seen = seen + 1
        }
        p = f.next
    }
    return ptr_to_node(ptr_null())
}

private fn irFieldCountOf(structNode: ASTNode) -> Int {
    let mut n = 0
    let mut p = structNode.child1
    while (nodeExists(p)) {
        let f = ptr_to_node(p)
        if (f.kind == NodeKind.STRUCT_FIELD) { n = n + 1 }
        p = f.next
    }
    return n
}

fn findStructField(structNode: ASTNode, name: String) -> ASTNode {
    let mut p = structNode.child1
    while (nodeExists(p)) {
        let f = ptr_to_node(p)
        if (f.s1.equals(name)) { return f }
        p = f.next
    }
    return ptr_to_node(ptr_null())
}

// Walks every child of `stmt` that can contain an expression, so each string
// literal gets an @.str global allocated before codegen needs its name.
//
// This must stay exhaustive over NodeKind. A statement kind missing from here does
// not fail loudly: the literal simply never gets a name, and generateExpression
// then emits `ptr @` with an empty global, which llc rejects with "expected value
// token" pointing at generated IR rather than at the user's source. FOR/LOOP/MATCH
// were absent for exactly this reason, which made any string literal inside a for
// loop or a match arm fail to build.
//
// The helpers below take a possibly-empty child pointer so each kind reads as a
// plain list of the children it owns, rather than repeating the emptiness check.
private fn collectStringsChildExpr(child: Ptr) {
    if (nodeExists(child)) {
        collectStringsExpr(ptr_to_node(child))
    }
}

private fn collectStringsChildBlock(child: Ptr) {
    if (nodeExists(child)) {
        collectStringsBlock(ptr_to_node(child))
    }
}

private fn collectStringsStmt(stmt: ASTNode) {
    if (stmt.kind == NodeKind.VARIABLE_DECL) {
        collectStringsChildExpr(stmt.child2)
    }
    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) {
        collectStringsChildExpr(stmt.child1)
    }
    if (stmt.kind == NodeKind.RETURN_STATEMENT) {
        collectStringsChildExpr(stmt.child1)
    }
    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        // child1 is the assignment target, which can itself hold literals in an
        // index expression such as `table[key_for("a")] = 1`.
        collectStringsChildExpr(stmt.child1)
        collectStringsChildExpr(stmt.child2)
    }
    if (stmt.kind == NodeKind.IF_STATEMENT) {
        collectStringsChildExpr(stmt.child1)
        collectStringsChildBlock(stmt.child2)
        if (nodeExists(stmt.child3)) {
            let elseNode = ptr_to_node(stmt.child3)
            if (elseNode.kind == NodeKind.IF_STATEMENT) {
                collectStringsStmt(elseNode)
            } else {
                collectStringsBlock(elseNode)
            }
        }
    }
    if (stmt.kind == NodeKind.WHILE_STATEMENT) {
        collectStringsChildExpr(stmt.child1)
        collectStringsChildBlock(stmt.child2)
    }
    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        collectStringsChildBlock(stmt.child1)
    }
    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        collectStringsChildBlock(stmt.child1)
    }
    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        // child1/child2 are the range bounds, child3 the body.
        collectStringsChildExpr(stmt.child1)
        collectStringsChildExpr(stmt.child2)
        collectStringsChildBlock(stmt.child3)
    }
    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        collectStringsChildExpr(stmt.child1)
        let mut armPtr = stmt.child2
        while (nodeExists(armPtr)) {
            let arm = ptr_to_node(armPtr)
            // A non-wildcard arm's pattern is an ordinary expression.
            collectStringsChildExpr(arm.child1)
            collectStringsChildBlock(arm.child2)
            armPtr = arm.next
        }
    }
}

private fn collectStringsBlock(block: ASTNode) {
    let mut sPtr = block.child1
    while (nodeExists(sPtr)) {
        let s = ptr_to_node(sPtr)
        collectStringsStmt(s)
        sPtr = s.next
    }
}

private fn collectStringsFunction(func: ASTNode) {
    if (nodeExists(func.child2)) {
        collectStringsBlock(ptr_to_node(func.child2))
    }
}

fn generateModule(module: ASTNode) {
    ir_reset_globals()
    ir_reset_types()
    ir_clear_var_types()
    ir_reset_fn_return_types()
    // Rebuilt here rather than inherited from analyzeModule, so codegen does not
    // depend on which passes ran before it. It is one walk of the top level.
    indexModuleDeclarations(module)
    markSingleLoopCallsiteFunctions(module)
    // `i3` is otherwise unused on FUNCTION nodes. Clear the per-emission thunk
    // mark because this AST may be compiled once as a workload and again as the
    // real program in the same process.
    let mut resetPtr = module.child1
    while (nodeExists(resetPtr)) {
        let resetStmt = ptr_to_node(resetPtr)
        if (resetStmt.kind == NodeKind.FUNCTION) { resetStmt.i3 = 0 }
        resetPtr = resetStmt.next
    }
    // Tell the backend the target's pointer width -- it sizes the allocator's
    // size argument and array GEP indices.
    ir_set_pointer_int_type(irPtrIntType())
    ir_module_start("self_hosted_module")

    // T15. Declared here, defined after every function. A body that builds a
    // trait object takes the table's address while it is being generated, and
    // the entries are not knowable until the functions they name exist.
    generateVtableDeclarations(module)
    // A named target is written onto the module, so that clang (which is handed
    // the same triple) and -g (which reads member offsets from the layout) agree
    // with codegen about what is being built. The implicit host stamps nothing,
    // which is why a plain build emits what it always did.
    let target = targetCurrent()
    if (target.explicit) {
        ir_module_set_target(target.triple, target.dataLayout)
    }

    // Immediately after the module exists and before anything is built into it:
    // a DIBuilder is created from the module, and -g pins the module's data
    // layout, which has to be settled before the first struct body is laid out.
    debugBeginModule()

    let mut typeStmtPtr = module.child1
    while (nodeExists(typeStmtPtr)) {
        let typeStmt = ptr_to_node(typeStmtPtr)
        if (typeStmt.kind == NodeKind.ENUM_DECL) {
            registerEnumDecl(typeStmt)
        }
        if (typeStmt.kind == NodeKind.STRUCT_DECL) {
            registerStructName(typeStmt)
        }
        typeStmtPtr = typeStmt.next
    }

    registerRawPtrStructs(module)

    let mut structStmtPtr = module.child1
    while (nodeExists(structStmtPtr)) {
        let structStmt = ptr_to_node(structStmtPtr)
        if (structStmt.kind == NodeKind.STRUCT_DECL) {
            generateStructDecl(structStmt, module)
        }
        structStmtPtr = structStmt.next
    }

    // After every body is set, not inside the loop above: a composite's member
    // offsets come from the finished LLVM type, and generateStructDecl emits
    // dependencies before dependents, so a type visited early may still be
    // opaque at the point its own declaration is reached.
    let mut debugStructPtr = module.child1
    while (nodeExists(debugStructPtr)) {
        let debugStructStmt = ptr_to_node(debugStructPtr)
        if (debugStructStmt.kind == NodeKind.STRUCT_DECL) {
            debugStruct(debugStructStmt)
        }
        // Enums ride this walk rather than one of their own: they need no
        // finished LLVM type, but the variant map has to be registered, which
        // registerEnumDecl above has already done for the whole module.
        if (debugStructStmt.kind == NodeKind.ENUM_DECL) {
            debugEnum(debugStructStmt)
        }
        debugStructPtr = debugStructStmt.next
    }

    ir_blank_line()

    // Populated from main's real argc/argv (see generateFunction) so cli_arg()/
    // cli_arg_count() in runtime/program_support.c work the same on every platform.
    ir_global_var("prismio_argc", "i32", "0", 0)
    ir_global_var("prismio_argv", "ptr", "null", 0)

    // Declare runtime functions
    //
    // `malloc` allocates and `rt_free` releases -- see `g_alloc_fn` in
    // runtime/llvm-api-backend.c for why those are not the same family. The
    // width on the allocator is what `tests/target_cross.psm` reads to prove the
    // size argument follows the target's pointer width.
    ir_declare_function_begin("malloc", "ptr")
    ir_declare_function_param(irPtrIntType())
    ir_declare_function_end()

    ir_declare_function_begin("rt_free", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_new", "ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_new_with_capacity", "ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("list_set_elem_releaser", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    // M4.2. The element size a container stores inline, or nothing at all when
    // it is never called -- a list not stamped with one keeps the boxed layout.
    ir_declare_function_begin("list_set_elem_inline", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    // M4.2, destination passing: the address of a freshly reserved element, so a
    // pushed struct literal is built in the list instead of built and copied in.
    ir_declare_function_begin("list_push_slot", "ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    // M4.2. The inline family: the same four container ops for a list whose
    // element bodies live in it. Separate entry points rather than a branch in
    // the boxed ones -- the element type is static at every call site, and the
    // branch cost 1.159x when it was not.
    ir_declare_function_begin("list_push_inline", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("list_get_inline", "ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("list_set_inline", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    // The scalar pair, taking the element by value. A struct element already is
    // an address; a scalar is in a register, and spilling it to a stack slot so
    // the callee could load it back measured 1.76x on a write loop.
    ir_declare_function_begin("list_push_inline_scalar", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i64")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    // `__builtin_string_eq`'s target. strcmp in the C library is vectorised and
    // beats a byte loop emitted here; the Prismio-side `strEquals` remains for
    // the compilers that predate the builtin.
    ir_declare_function_begin("str_equals", "i32")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_get_inline_scalar", "i64")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("list_set_inline_scalar", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_param("i64")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    if (moduleTreeUsesSlice(module.child1)) {
        // M4.1. A Slice is a value aggregate; these helpers only validate or
        // resolve its handle at an access. The descriptor itself never crosses
        // the C boundary, which keeps its three-word representation in
        // Prismio's ABI.
        ir_declare_function_begin("prismio_slice_check", "void")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("list_slice_get", "ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("list_slice_get_inline", "ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("list_slice_set", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("ptr")
        ir_declare_function_end()

        ir_declare_function_begin("list_slice_get_inline_scalar", "i64")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("list_slice_set_inline_scalar", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i64")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("list_slice_set_inline", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("ptr")
        ir_declare_function_end()
    }

    if (moduleTreeUsesDataView(module.child1)) {
        ir_declare_function_begin("data_view_begin", "ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_add_column", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_finish", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_to_list", "ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_len", "i32")
        ir_declare_function_param("ptr")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_check_index", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_column", "ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("data_view_release", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_end()
    }

    ir_declare_function_begin("rc_release", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    // Codegen calls this at every FFI boundary that returns a String, to give
    // the incoming `const char*` its length. Declared here rather than by any
    // source, because no source mentions it.
    ir_declare_function_begin("prismio_cstr_len", "i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("prismio_expect", "ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("cyc_set_type", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("cyc_retain", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    // LAYOUT 2. Declared only in a workload driver. A shipped module carries no
    // declaration of them either, which is the strongest form of W1 available
    // here: the instrumentation is absent from the IR rather than present and
    // unreachable, so it cannot be re-enabled by a later pass or by a linker.
    if (irProfileMode) {
        ir_declare_function_begin("rt_profile_begin", "void")
        ir_declare_function_end()

        ir_declare_function_begin("rt_profile_end", "void")
        ir_declare_function_end()

        ir_declare_function_begin("rt_profile_field", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("rt_profile_range", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i64")
        ir_declare_function_end()

        ir_declare_function_begin("rt_profile_alloc", "void")
        ir_declare_function_param("ptr")
        ir_declare_function_end()

        ir_declare_function_begin("rt_profile_dump", "i32")
        ir_declare_function_param("ptr")
        ir_declare_function_param("ptr")
        ir_declare_function_param("i32")
        ir_declare_function_end()

        ir_declare_function_begin("rt_workload_stub", "i64")
        ir_declare_function_param("ptr")
        ir_declare_function_end()
    }

    ir_declare_function_begin("cyc_release", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_set_elem_owner", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("rc_alloc", "ptr")
    ir_declare_function_param(irPtrIntType())
    ir_declare_function_end()

    ir_declare_function_begin("list_push", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_get", "ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("list_set", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_set_exclusive", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_len", "i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    // Struct-field ownership. Declared before any is defined, because a type
    // whose field is another owning struct calls that type's release -- and the
    // declaration order of two structs says nothing about which needs the other.
    let mut relDeclPtr = module.child1
    while (nodeExists(relDeclPtr)) {
        let relStmt = ptr_to_node(relDeclPtr)
        if (relStmt.kind == NodeKind.STRUCT_DECL) {
            if (aif_type_releases(relStmt.s1) == 1) {
                ir_declare_function_begin(releaseFnName(relStmt.s1), "void")
                ir_declare_function_param("ptr")
                ir_declare_function_end()
            }
        }
        relDeclPtr = relStmt.next
    }

    ir_blank_line()

    let mut relDefPtr = module.child1
    while (nodeExists(relDefPtr)) {
        let relStmt = ptr_to_node(relDefPtr)
        if (relStmt.kind == NodeKind.STRUCT_DECL) {
            if (aif_type_releases(relStmt.s1) == 1) {
                generateReleaseFn(relStmt)
            }
        }
        relDefPtr = relStmt.next
    }

    // CYCLES 2. Emitted only for types in a non-trivial SCC, so a program whose
    // types have no cycle carries no collector machinery at all -- which is the
    // document's headline result and is checkable from the type declarations
    // alone, before any inference runs.
    let mut cycDefPtr = module.child1
    while (nodeExists(cycDefPtr)) {
        let cycStmt = ptr_to_node(cycDefPtr)
        if (cycStmt.kind == NodeKind.STRUCT_DECL) {
            if (aif_type_in_cycle(cycStmt.s1) == 1) {
                generateCyclicChildrenFn(cycStmt)
            }
        }
        cycDefPtr = cycStmt.next
    }

    ir_blank_line()

    // First pass: global variables + collect string literals
    let mut stmtPtr = module.child1
    while (nodeExists(stmtPtr)) {
        let stmt = ptr_to_node(stmtPtr)

        if (stmt.kind == NodeKind.EXTERN_FUNCTION) {
            if (moduleHasFunction(module, stmt.s1) == false) {
                // W3. A foreign extern gets a stub *definition* below instead of
                // this declaration. Emitting both would be a redefinition, so the
                // choice has to be made here, and it is made by the same
                // predicate the stub pass uses -- one function, asked twice.
                if (irProfileMode and irRuntimeProvides(stmt.s1) == false) {
                    // nothing here; generateExternStub defines it
                } else {
                    declareExternFunction(stmt)
                }
            }
        }

        // A workload's blocks hold string literals like any other code, and the
        // pre-pass that names their globals walks functions only. Without this a
        // driver whose `setup` prints anything fails on an unknown string global.
        if (irProfileMode) {
            if (stmt.kind == NodeKind.WORKLOAD_DECL) {
                if (nodeExists(stmt.child1)) { collectStringsBlock(ptr_to_node(stmt.child1)) }
                if (nodeExists(stmt.child2)) { collectStringsBlock(ptr_to_node(stmt.child2)) }
            }
        }

        if (stmt.kind == NodeKind.VARIABLE_DECL) {
            let mut initVal = "0"
            let mut globalStrName = ""
            let mut globalStrLen = 0
            let mut varType = "i32"
            let hasAnnotation = nodeExists(stmt.child1)
            if (hasAnnotation) {
                let typeNode = ptr_to_node(stmt.child1)
                varType = mapTypeNode(typeNode)
            }
            if (nodeExists(stmt.child2)) {
                let initNode = ptr_to_node(stmt.child2)
                // Only infer from the initializer when there is no annotation.
                // Taking the initializer's type unconditionally declared
                // `let g: I64 = 5` as an i32 global, disagreeing with sema.
                if (hasAnnotation == false) {
                    varType = getExprType(initNode)
                }
                if (initNode.kind == NodeKind.LITERAL_EXPR) {
                    if (initNode.i1 == TokenType.STRING_LITERAL) {
                        // A global initializer sits outside every function, so the
                        // per-function string pre-pass never reaches it. Give the
                        // literal its global here and point the variable at it;
                        // emitting initNode.s1 raw produced
                        // `@g =  global ptr hello world`, which llc rejects.
                        collectStringsExpr(initNode)
                        globalStrName = initNode.s2
                        globalStrLen = __builtin_string_len(initNode.s1)
                        initVal = "@".concat(initNode.s2)
                    } else {
                        initVal = initNode.s1
                    }
                } else {
                    // Unreachable: sema rejects a non-constant global initializer
                    // (see semaPredeclareGlobal) and codegen only runs when
                    // sema reported nothing. Kept as a guard because the
                    // alternative -- falling back to 0 -- made `let g = compute()`
                    // silently become a zero global with the call never emitted.
                    println("internal error: non-constant global initializer reached codegen")
                    exit(1)
                }
            }
            // A String global is a constant *pair*, which cannot be spelled in
            // the text initialiser every other type uses -- so it goes to
            // ir_global_str_var, which builds the constant instead.
            if (storageType(varType).equals("struct:prismio.str")) {
                ir_global_str_var(stmt.s1, globalStrName, globalStrLen)
            } else {
                ir_global_var(stmt.s1, storageType(varType), initVal, 0)
            }
            // `varType`, not `storageType(varType)`: the debug layer wants the
            // uncollapsed key, since `struct:T` is what tells it to describe a
            // T rather than an anonymous pointer.
            debugGlobal(stmt.s1, varType, debugTypeName(stmt.child1, stmt.child2), stmt)
            ir_register_global_name(stmt.s1)
            // Must be declared as a global, not a local: codegen asks
            // ir_var_is_global() to choose between @name and a stack slot, and
            // a global recorded as a local would be looked up as an alloca that
            // does not exist.
            ir_set_global_var_type(stmt.s1, varType)
        }

        if (stmt.kind == NodeKind.FUNCTION) {
            let mut retType = getDeclaredReturnType(stmt, stmt.child3)
            if (stmt.s1.equals("main")) {
                retType = "i32"
            }
            ir_set_fn_return_type(functionSymbolName(stmt), retType)
            collectStringsFunction(stmt)
        }

        stmtPtr = stmt.next
    }

    ir_blank_line()

    // Second pass: functions
    let mut stmtPtr2 = module.child1
    while (nodeExists(stmtPtr2)) {
        let stmt2 = ptr_to_node(stmtPtr2)

        if (stmt2.kind == NodeKind.FUNCTION) {
            // The driver supplies `main` in a profile build, so the program's own
            // is skipped rather than emitted and shadowed. Two definitions of one
            // symbol is a link error, and picking which one wins by link order is
            // exactly the kind of thing that works until it does not.
            if (irProfileMode and stmt2.s1.equals("main")) {
                // replaced by generateWorkloadDriver
            } else {
                generateFunction(stmt2)
                if (stmt2.i3 == 1) { generateTaskThunk(stmt2) }
            }
        }

        // W3's other half. Definitions, so they must come after the declaration
        // pass above has decided not to declare these.
        if (irProfileMode) {
            if (stmt2.kind == NodeKind.EXTERN_FUNCTION) {
                if (moduleHasFunction(module, stmt2.s1) == false) {
                    if (irRuntimeProvides(stmt2.s1) == false) {
                        generateExternStub(stmt2)
                    }
                }
            }
        }

        stmtPtr2 = stmt2.next
    }

    if (irProfileMode) {
        let wl = findWorkload(module)
        if (nodeExists(node_to_ptr(wl))) {
            generateWorkloadDriver(wl, irProfilePath)
        }
    }

    // T15. **After every function, and that ordering is the whole reason this is
    // here** rather than beside the impl it describes: a vtable entry is the
    // address of a compiled function, and unlike a call it carries no argument
    // types to synthesise a forward declaration from.
    generateVtables(module)

    // Before ir_module_end, and before ir_write_file's verifier runs: an
    // unfinalised DIBuilder leaves temporary metadata nodes in the module, which
    // is a verification failure rather than a missing line.
    debugEndModule()

    ir_module_end()
}

// ---------------------------------------------------------
// Trait object vtables
// ---------------------------------------------------------

// Names already emitted, joined with `;`. A program may build the same object in
// twenty places and the table is one.
let mut irEmittedVtables = ""

// One table per (trait, implementing type) the program actually builds an object
// of. A trait nobody makes an object of emits nothing, and an implementation
// never used dynamically costs no table -- which is the same "pay for what you
// use" the fat-pointer representation was chosen for.
private fn generateVtables(module: ASTNode) {
    irEmittedVtables = ""
    generateVtablesFrom(module, module.child1)
}

private fn generateVtableDeclarations(module: ASTNode) {
    irEmittedVtables = ""
    generateVtableDeclarationsFrom(module, module.child1)
    irEmittedVtables = ""
}

private fn generateVtableDeclarationsFrom(module: ASTNode, ptr: Ptr) {
    let mut p = ptr
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        if (node.kind == NodeKind.DYN_MAKE) {
            let marker = node.s2.concat(";")
            if (strContains(irEmittedVtables, marker) == false) {
                irEmittedVtables = irEmittedVtables.concat(marker)
                let traitName = strSubstring(node.s1, 4, __builtin_string_len(node.s1) - 4)
                let traitDecl = irFindTrait(module, traitName)
                if (nodeIsNull(node_to_ptr(traitDecl)) == false) {
                    ir_vtable_declare(node.s2, irTraitMethodCount(traitDecl))
                }
            }
        }
        generateVtableDeclarationsFrom(module, node.child1)
        generateVtableDeclarationsFrom(module, node.child2)
        generateVtableDeclarationsFrom(module, node.child3)
        p = node.next
    }
}

private fn irTraitMethodCount(traitDecl: ASTNode) -> Int {
    let mut count = 0
    let mut p = traitDecl.child1
    while (nodeExists(p)) {
        count = count + 1
        p = ptr_to_node(p).next
    }
    return count
}

private fn generateVtablesFrom(module: ASTNode, ptr: Ptr) {
    let mut p = ptr
    while (nodeExists(p)) {
        let node = ptr_to_node(p)
        if (node.kind == NodeKind.DYN_MAKE) { generateOneVtable(module, node) }
        generateVtablesFrom(module, node.child1)
        generateVtablesFrom(module, node.child2)
        generateVtablesFrom(module, node.child3)
        p = node.next
    }
}

private fn generateOneVtable(module: ASTNode, make: ASTNode) {
    let name = make.s2
    let marker = name.concat(";")
    if (strContains(irEmittedVtables, marker)) { return }
    irEmittedVtables = irEmittedVtables.concat(marker)

    let traitName = strSubstring(make.s1, 4, __builtin_string_len(make.s1) - 4)
    let traitDecl = irFindTrait(module, traitName)
    if (nodeIsNull(node_to_ptr(traitDecl))) { return }

    // Matched by the name the object was built with rather than by taking the
    // type apart: sema wrote that name from the trait and the target, so
    // rebuilding it here compares the two spellings instead of parsing one.
    let implNode = irFindImplForVtable(module, traitName, name)
    if (nodeIsNull(node_to_ptr(implNode))) { return }

    ir_vtable_begin()
    let mut sigPtr = traitDecl.child1
    while (nodeExists(sigPtr)) {
        let signature = ptr_to_node(sigPtr)
        ir_vtable_entry(irImplMethodSymbol(module, implNode, signature.s1))
        sigPtr = signature.next
    }
    ir_vtable_end(name)
}

private fn irFindTrait(module: ASTNode, name: String) -> ASTNode {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.TRAIT_DECL and stmt.s1.equals(name)) { return stmt }
        p = stmt.next
    }
    return ptr_to_node(ptr_null())
}

private fn irFindImplForVtable(module: ASTNode, traitName: String, vtableName: String) -> ASTNode {
    let mut p = module.child1
    while (nodeExists(p)) {
        let stmt = ptr_to_node(p)
        if (stmt.kind == NodeKind.IMPL_DECL and stmt.s2.equals(traitName)) {
            let candidate = "vtable$".concat(traitName, "$", stmt.s1)
            if (candidate.equals(vtableName)) { return stmt }
        }
        p = stmt.next
    }
    return ptr_to_node(ptr_null())
}

// The mangled symbol of this impl's method, found the way conformance finds it:
// by the source position the IMPL_METHOD record kept when the method left the
// block for the module chain.
private fn irImplMethodSymbol(module: ASTNode, implNode: ASTNode, methodName: String) -> String {
    let mut recordPtr = implNode.child2
    while (nodeExists(recordPtr)) {
        let record = ptr_to_node(recordPtr)
        if (record.kind == NodeKind.IMPL_METHOD and record.s1.equals(methodName)) {
            let mut fnPtr = module.child1
            while (nodeExists(fnPtr)) {
                let fnNode = ptr_to_node(fnPtr)
                if (fnNode.kind == NodeKind.FUNCTION
                    and fnNode.file == record.file
                    and fnNode.line == record.line
                    and fnNode.col == record.col) {
                    return strClone(fnNode.s2)
                }
                fnPtr = fnNode.next
            }
        }
        recordPtr = record.next
    }
    return ""
}
