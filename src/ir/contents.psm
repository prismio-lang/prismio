// What the elements of a local integer array can hold, so that arithmetic on one read
// from it can be proved not to wrap, and an index read from it proved in range.
// ir/nowrap.psm walks the function and asks.
//
// Edit distance's two rows are the case. Every store into `prev` and `cur` is a counter,
// a copy, or `min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)`, so a store raises
// the largest element by at most 1, and 600 x 600 of them run between two zero-fills.
// The elements stay in [0, 360600], so `prev[j] + 1` cannot wrap, and LLVM may turn
// `min(a + 1, b + 1)` into `min(a, b) + 1`, as it does for C, whose overflow is
// undefined.
//
// The bound is an invariant over one *lifetime* of an array: from its declaration, which
// zero-fills or initialises it every time it runs, to the end of its block. Arrays
// declared in one block form a family, since a store into one reads the others, and
// share one bound [L, M]; one that fails takes with it only the arrays whose stored
// values read it. A stored value is described by a form,
//
//     lo = min(loC, L + loR)        hi = max(hiC, M + hiR),
//
// a concrete part from literals and facts, and a part relative to the family's bound
// from the elements it reads. Then:
//
// - L holds if no form can go below it: every loC is at least L and every loR at least 0.
// - M grows by at most hiR per store. Over one lifetime it stays at or below the largest
//   initial or concrete value plus the sum of hiR x executions, and the counted loops
//   between the declaration and each store bound the executions.
// - A `+` or `-` inside a stored value must not wrap either, or its form is wrong, so the
//   extremes of every one are checked against the settled bound.
//
// An array qualifies only when nothing but a subscript names it, in its function and
// outside any closure, and its name is bound once there: no view, no `inout`, no copy,
// no `for x in`, no shadowing. Anything else could write it where the walk does not look.
//
// A local `Vec` of those elements qualifies the same way, with its `v[i]`, `v[i] = x`,
// `v.push(x)` and `v.length` standing for the subscript: a push is one more store, and
// what it has not pushed a read cannot reach, since the read's bounds check stops it. A
// breadth-first queue is the case: every node pushed was first a checked index into
// `seen`, so every node popped is one, and the `%` on it needs no sign and, in a checksum,
// no division.
//
// **Every store must be seen, or nothing is claimed.** The scan below counts each store
// site by node; a site the record walk did not reach takes its list's bound away, as an
// unrecorded call takes a parameter's (ir/param_ranges.psm).
//
// The same scan answers how long a `Vec<T>.filled(n, x)` is, whatever its `T`: one that
// nothing pushes or passes keeps `n`, so a checked index into it is at most `n - 1`.
//
// Its elements are `Int` or a narrower integer (ir/nowrap.psm's fact types), and a
// family's bound must lie inside every member's type, so a store that would wrap one
// leaves the family unbounded. pointer_chase's `next[at]` needs the unsigned case: every
// value its `order` and `next` arrays ever hold is an index, so `at` stays one.
//
// A value read from one of the arrays may reach a store through an immutable `let`
// bound once in the function (`let t = order[i]; ... order[j] = t`, a swap): the name
// is that read.

import ast.nodes
import ast.types
import std.string

const CONTENTS_INT_MAX = 2147483647

struct ArrayContents {
    // One slot per integer array declared in the function, with its element type's range.
    names: Vec<String>,
    internal elemLo: Vec<I64>,
    internal elemHi: Vec<I64>,
    // The block whose declaration of it ran, numbered as the walk enters blocks, or 0
    // before the walk reaches it; and how many loops were around that declaration.
    internal family: Vec<Int>,
    internal depth: Vec<Int>,
    // The hull of its initial elements and of every store's concrete part.
    concreteLo: Vec<Int>,
    concreteHi: Vec<Int>,
    // The sum of hiR x executions over its stores.
    growth: Vec<Int>,
    // The extremes of every `+`/`-` in a value stored into it: concrete, then relative.
    sumLoC: Vec<Int>,
    sumLoR: Vec<Int>,
    sumHiC: Vec<Int>,
    sumHiR: Vec<Int>,
    failed: Vec<Int>,
    // Each store's reads of its family, as (writer, read) pairs: a writer whose value
    // read an array that failed fails too, and nothing else in the family does.
    readWriter: Vec<Int>,
    readSlot: Vec<Int>,
    // The settled bound; an empty interval until settle(), and where there is none.
    internal lo: Vec<Int>,
    internal hi: Vec<Int>,
    // Each immutable `let` initialised by a subscript of a named array, that array's
    // name, and how many times the function binds the name.
    aliasNames: Vec<String>,
    aliasArrays: Vec<String>,
    aliasBindings: Vec<Int>,
    // Every store site a list's name reaches, its slot, and whether the walk recorded it.
    siteNodes: Vec<Ptr>,
    siteSlots: Vec<Int>,
    siteSeen: Vec<Bool>,
    // The `Vec<T>.filled` locals: each one's name, the smallest and largest length the
    // walk found it declared with (-1 where nothing bounds it), and whether something else
    // may resize it.
    filledNames: Vec<String>,
    filledLo: Vec<I64>,
    filledHi: Vec<I64>,
    filledFailed: Vec<Bool>
}

// A stored value's form; see the top of this file. An absent part is
// +-contentAbsent(), which min and max pass over.
struct ContentForm {
    ok: Bool,
    loC: I64,
    loR: I64,
    hiC: I64,
    hiR: I64
}

// The arrays of `func` that qualify, each still to be declared by the walk.
internal fn contentsCollect(func: ASTNode) -> ArrayContents {
    let c = ArrayContents {
        names: [], elemLo: [], elemHi: [], family: [], depth: [], concreteLo: [], concreteHi: [],
        growth: [], sumLoC: [], sumLoR: [], sumHiC: [], sumHiR: [], failed: [], readWriter: [],
        readSlot: [], lo: [], hi: [], aliasNames: [], aliasArrays: [], aliasBindings: [],
        siteNodes: [], siteSlots: [], siteSeen: [], filledNames: [], filledLo: [], filledHi: [],
        filledFailed: []
    }
    c.collect(func.child2)
    if (c.names.length == 0 and c.filledNames.length == 0) { return c }
    c.countBindings(func.child1)
    c.countBindings(func.child2)
    c.scan(func.child2, false)
    return c
}

impl ArrayContents {
    // Every `let` of an `Array<Int, N>`, whatever its block.
    private fn collect(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.VARIABLE_DECL and contentsIsIntArray(n)) {
                self.add(n.s1, ptr_to_type(nodeGetType(n).child))
            }
            if (n.kind == NodeKind.VARIABLE_DECL and contentsIsFilled(n)) { self.addFilled(n.s1) }
            if (n.kind == NodeKind.VARIABLE_DECL and n.i1 != 1 and nodeExists(n.child2)) {
                let init = ptr_to_node(n.child2)
                if (contentsSubscripted(init).equals("") == false) {
                    self.aliasNames.push(n.s1.clone())
                    self.aliasArrays.push(contentsSubscripted(init))
                    self.aliasBindings.push(0)
                }
            }
            self.collect(n.child1)
            self.collect(n.child2)
            self.collect(n.child3)
            p = n.next
        }
    }
}


impl ArrayContents {
    private fn add(self, name: String, elem: TypeInfo) {
        if (self.slotOf(name) >= 0) {
            self.failed[self.slotOf(name)] = 1
            return
        }
        self.names.push(name.clone())
        self.elemLo.push(nowrapTypeMin(elem))
        self.elemHi.push(nowrapTypeMax(elem))
        self.family.push(0)
        self.depth.push(0)
        self.concreteLo.push(CONTENTS_INT_MAX)
        self.concreteHi.push(0 - CONTENTS_INT_MAX - 1)
        self.growth.push(0)
        self.sumLoC.push(CONTENTS_INT_MAX)
        self.sumLoR.push(CONTENTS_INT_MAX)
        self.sumHiC.push(0 - CONTENTS_INT_MAX - 1)
        self.sumHiR.push(0 - CONTENTS_INT_MAX - 1)
        self.failed.push(0)
        self.lo.push(1)
        self.hi.push(0)
    }
}


// An integer element of a fact type, and either a known length, a zero-filled or
// literal-initialised local, or a `Vec`, which holds nothing it was not given.
private fn contentsIsIntArray(decl: ASTNode) -> Bool {
    if (nodeHasType(decl) == false) { return false }
    let t = nodeGetType(decl)
    if (nodeIsNull(t.child)) { return false }
    if (t.kind == TypeKind.LIST) { return nowrapTypeBits(ptr_to_type(t.child)) > 0 }
    if (t.kind != TypeKind.ARRAY or t.length <= 0) { return false }
    return nowrapTypeBits(ptr_to_type(t.child)) > 0
}

// `Vec<T>.filled(n, x)` of a scalar `T`, whatever its width.
private fn contentsIsFilled(decl: ASTNode) -> Bool {
    if (nodeHasType(decl) == false or nodeGetType(decl).kind != TypeKind.LIST) { return false }
    if (nodeIsNull(decl.child2)) { return false }
    return contentsCallee(ptr_to_node(decl.child2)).equals("list_new_filled")
}

// The name a call's callee is, or "".
private fn contentsCallee(e: ASTNode) -> String {
    if (e.kind != NodeKind.CALL_EXPR or nodeIsNull(e.child1)) { return "" }
    let callee = ptr_to_node(e.child1)
    if (callee.kind != NodeKind.IDENTIFIER_EXPR) { return "" }
    return callee.s1.clone()
}

// What a call does to the `Vec` that is its first argument, in sema's lowered spelling
// (src/sema/vec.psm): every operation a list's name may be mentioned by.
const LIST_OP_NONE = 0
const LIST_OP_READ = 1
const LIST_OP_STORE = 2
const LIST_OP_PUSH = 3
const LIST_OP_SIZE = 4

internal fn contentsListOp(e: ASTNode) -> Int {
    let name = contentsCallee(e)
    if (name.equals("") or nodeIsNull(e.child2)) { return LIST_OP_NONE }
    let list = ptr_to_node(e.child2)
    if (nodeHasType(list) == false or nodeGetType(list).kind != TypeKind.LIST) { return LIST_OP_NONE }
    if (name.equals("list_get")) { return LIST_OP_READ }
    if (name.equals("list_set")) { return LIST_OP_STORE }
    if (name.equals("list_push")) { return LIST_OP_PUSH }
    if (name.equals("list_len") or name.equals("list_capacity")) { return LIST_OP_SIZE }
    return LIST_OP_NONE
}

impl ArrayContents {
    // A second binding of a name, anywhere in the function and of any kind, makes a
    // subscript of that name ambiguous to a walk that resolves by name.
    private fn countBindings(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            let binds = n.kind == NodeKind.VARIABLE_DECL or n.kind == NodeKind.FOR_STATEMENT
                        or n.kind == NodeKind.FUNCTION_PARAMETER
            if (binds) {
                self.bindingOf(n.s1, n.kind == NodeKind.VARIABLE_DECL and contentsIsIntArray(n),
                               n.kind == NodeKind.VARIABLE_DECL and contentsIsFilled(n))
                self.aliasBound(n.s1)
                if (n.kind == NodeKind.FOR_STATEMENT) {
                    self.bindingOf(n.s2, false, false)
                    self.aliasBound(n.s2)
                }
            }
            if (n.kind == NodeKind.MATCH_ARM) { self.aliasPattern(n.child1) }
            self.countBindings(n.child1)
            self.countBindings(n.child2)
            self.countBindings(n.child3)
            p = n.next
        }
    }
}


impl ArrayContents {
    // The declaration itself is the one binding allowed, and it was collected; any
    // other binding of the name disqualifies it. Two array declarations of one name
    // already failed in add().
    private fn bindingOf(self, name: String, isTheArray: Bool, isTheFilled: Bool) {
        let filled = self.filledSlot(name)
        if (filled >= 0 and isTheFilled == false) { self.filledFailed[filled] = true }
        let slot = self.slotOf(name)
        if (slot < 0 or isTheArray) { return }
        self.failed[slot] = 1
    }
}


impl ArrayContents {
    private fn aliasBound(self, name: String) {
        for i in 0..<self.aliasNames.length {
            let known: String = self.aliasNames[i]
            if (known.equals(name)) { self.aliasBindings[i] = self.aliasBindings[i] + 1 }
        }
    }
}


impl ArrayContents {
    // A pattern may bind any name it mentions, which counts as a second binding.
    private fn aliasPattern(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.IDENTIFIER_EXPR) {
                self.aliasBound(n.s1)
                self.aliasBound(n.s1)
            }
            self.aliasPattern(n.child1)
            self.aliasPattern(n.child2)
            self.aliasPattern(n.child3)
            p = n.next
        }
    }
}


impl ArrayContents {
    // The slot of the array an alias `name` read, or -1: the name must be bound once in
    // the function, so every mention of it is that one read.
    internal fn slotOfAlias(self, name: String) -> Int {
        for i in 0..<self.aliasNames.length {
            let known: String = self.aliasNames[i]
            if (known.equals(name)) {
                if (self.aliasBindings[i] != 1) { return 0 - 1 }
                let array: String = self.aliasArrays[i]
                let slot = self.slotOf(array)
                if (slot < 0 or self.failed[slot] == 1) { return 0 - 1 }
                return slot
            }
        }
        return 0 - 1
    }
}


impl ArrayContents {
    // Every mention of a name that is not the base of a subscript, or is inside a
    // closure, could read or write the array where the walk does not look.
    private fn scan(self, head: Ptr, inClosure: Bool) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            let inner = inClosure or n.kind == NodeKind.CLOSURE_EXPR
            let op = contentsListOp(n)
            if (n.kind == NodeKind.INDEX_EXPR and inClosure == false and contentsBaseName(n).equals("") == false) {
                self.scan(n.child2, inner)
                self.scan(n.child3, inner)
            } else if (op != LIST_OP_NONE and inClosure == false
                       and ptr_to_node(n.child2).kind == NodeKind.IDENTIFIER_EXPR) {
                self.scanListOp(n, op)
                self.scan(ptr_to_node(n.child2).next, inner)
                self.scan(n.child3, inner)
            } else {
                if (n.kind == NodeKind.IDENTIFIER_EXPR) { self.failName(n.s1) }
                self.scan(n.child1, inner)
                self.scan(n.child2, inner)
                self.scan(n.child3, inner)
            }
            p = n.next
        }
    }
}


impl ArrayContents {
    // A mention of a name by anything but a subscript or a list operation.
    private fn failName(self, name: String) {
        let slot = self.slotOf(name)
        if (slot >= 0) { self.failed[slot] = 1 }
        let filled = self.filledSlot(name)
        if (filled >= 0) { self.filledFailed[filled] = true }
    }
}


impl ArrayContents {
    // A list operation on a named list: a store is a site the walk must record, and a
    // push is the one that moves the length.
    private fn scanListOp(self, n: ASTNode, op: Int) {
        let name = ptr_to_node(n.child2).s1
        if (op == LIST_OP_PUSH) {
            let filled = self.filledSlot(name)
            if (filled >= 0) { self.filledFailed[filled] = true }
        }
        let slot = self.slotOf(name)
        if (slot >= 0 and (op == LIST_OP_STORE or op == LIST_OP_PUSH)) {
            self.siteNodes.push(node_to_ptr(n))
            self.siteSlots.push(slot)
            self.siteSeen.push(false)
        }
    }
}


impl ArrayContents {
    // The walk recorded this store.
    internal fn siteRecorded(self, n: ASTNode) {
        let at = node_to_ptr(n)
        for i in 0..<self.siteNodes.length {
            if (self.siteNodes[i] == at) { self.siteSeen[i] = true }
        }
    }
}


impl ArrayContents {
    private fn filledSlot(self, name: String) -> Int {
        for i in 0..<self.filledNames.length {
            let known: String = self.filledNames[i]
            if (known.equals(name)) { return i }
        }
        return 0 - 1
    }
}


impl ArrayContents {
    private fn addFilled(self, name: String) {
        let at = self.filledSlot(name)
        if (at >= 0) {
            self.filledFailed[at] = true
            return
        }
        self.filledNames.push(name.clone())
        self.filledLo.push((0 - 1) as I64)
        self.filledHi.push((0 - 1) as I64)
        self.filledFailed.push(false)
    }
}


impl ArrayContents {
    // `name` was just declared `Vec<T>.filled(n, x)`, with `n` in [lo, hi], or -1s when
    // nothing bounds it.
    internal fn noteFilled(self, name: String, lo: I64, hi: I64) {
        let at = self.filledSlot(name)
        if (at < 0) { return }
        self.filledLo[at] = lo
        self.filledHi[at] = hi
    }
}


impl ArrayContents {
    // The largest index a checked access to the list `list` can have run with.
    internal fn lastIndexOf(self, list: ASTNode) -> I64 {
        let most = (CONTENTS_INT_MAX - 1) as I64
        if (list.kind != NodeKind.IDENTIFIER_EXPR) { return most }
        let at = self.filledSlot(list.s1)
        if (at < 0 or self.filledFailed[at] or self.filledHi[at] < 1 as I64) { return most }
        return self.filledHi[at] - 1 as I64
    }
}


impl ArrayContents {
    // The shortest the list `list` can be, or 0: an index below this needs no check.
    internal fn shortestLength(self, list: ASTNode) -> I64 {
        if (list.kind != NodeKind.IDENTIFIER_EXPR) { return 0 as I64 }
        let at = self.filledSlot(list.s1)
        if (at < 0 or self.filledFailed[at] or self.filledLo[at] < 1 as I64) { return 0 as I64 }
        return self.filledLo[at]
    }
}


// The name a subscript or a list read indexes directly, or "".
private fn contentsSubscripted(e: ASTNode) -> String {
    if (e.kind == NodeKind.INDEX_EXPR) { return contentsBaseName(e) }
    if (contentsListOp(e) != LIST_OP_READ) { return "" }
    let list = ptr_to_node(e.child2)
    if (list.kind != NodeKind.IDENTIFIER_EXPR) { return "" }
    return list.s1.clone()
}

// The name a subscript indexes directly, or "".
private fn contentsBaseName(e: ASTNode) -> String {
    if (nodeIsNull(e.child1)) { return "" }
    let base = ptr_to_node(e.child1)
    if (base.kind != NodeKind.IDENTIFIER_EXPR) { return "" }
    return base.s1.clone()
}

impl ArrayContents {
    internal fn slotOf(self, name: String) -> Int {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) { return i }
        }
        return 0 - 1
    }
}


impl ArrayContents {
    // The slot of a qualifying array that subscript or list read `e` indexes, or -1.
    internal fn slotOfIndex(self, e: ASTNode) -> Int {
        let slot = self.slotOf(contentsSubscripted(e))
        if (slot < 0 or self.failed[slot] == 1) { return 0 - 1 }
        return slot
    }
}


impl ArrayContents {
    // The slot of a qualifying list that the store or push `e` writes, or -1.
    internal fn slotOfListStore(self, e: ASTNode) -> Int {
        let op = contentsListOp(e)
        if (op != LIST_OP_STORE and op != LIST_OP_PUSH) { return 0 - 1 }
        let list = ptr_to_node(e.child2)
        if (list.kind != NodeKind.IDENTIFIER_EXPR) { return 0 - 1 }
        let slot = self.slotOf(list.s1)
        if (slot < 0 or self.failed[slot] == 1) { return 0 - 1 }
        return slot
    }
}


impl ArrayContents {
    // The declaration ran, in block `family` under `depth` loops, with its elements in
    // [lo, hi].
    internal fn declare(self, slot: Int, family: Int, depth: Int, lo: I64, hi: I64) {
        self.family[slot] = family
        self.depth[slot] = depth
        self.noteLow(slot, lo)
        self.noteHigh(slot, hi)
    }
}


impl ArrayContents {
    // A list's declaration ran, holding nothing yet.
    internal fn declareEmpty(self, slot: Int, family: Int, depth: Int) {
        self.family[slot] = family
        self.depth[slot] = depth
    }
}


impl ArrayContents {
    internal fn fail(self, slot: Int) {
        self.failed[slot] = 1
    }
}


impl ArrayContents {
    private fn noteLow(self, slot: Int, lo: I64) {
        if (contentsFitsInt(lo) == false) {
            self.failed[slot] = 1
            return
        }
        if (lo < self.concreteLo[slot] as I64) { self.concreteLo[slot] = lo as Int }
    }
}


impl ArrayContents {
    private fn noteHigh(self, slot: Int, hi: I64) {
        if (contentsFitsInt(hi) == false) {
            self.failed[slot] = 1
            return
        }
        if (hi > self.concreteHi[slot] as I64) { self.concreteHi[slot] = hi as Int }
    }
}


impl ArrayContents {
    // A store of a value of form `v` into the array, run at most `executions` times in
    // one lifetime, or an unknown number of times when it is negative.
    internal fn store(self, slot: Int, v: ContentForm, executions: I64) {
        if (v.ok == false) {
            self.failed[slot] = 1
            return
        }
        let absent = contentAbsent()
        if (v.loR < absent and v.loR < 0 as I64) {
            self.failed[slot] = 1
            return
        }
        if (v.loC < absent) { self.noteLow(slot, v.loC) }
        if (v.hiC > 0 - absent) { self.noteHigh(slot, v.hiC) }
        if (v.hiR <= 0 as I64) { return }
        if (executions < 0 as I64) {
            self.failed[slot] = 1
            return
        }
        let total = self.growth[slot] as I64 + v.hiR * executions
        if (total > CONTENTS_INT_MAX as I64) {
            self.failed[slot] = 1
            return
        }
        self.growth[slot] = total as Int
    }
}


impl ArrayContents {
    // A value stored into `writer`'s array read an element of `read`'s.
    internal fn noteRead(self, writer: Int, read: Int) {
        self.readWriter.push(writer)
        self.readSlot.push(read)
    }
}


impl ArrayContents {
    // A `+` or `-` of form `v` inside a value stored into the array.
    internal fn noteSum(self, slot: Int, v: ContentForm) {
        if (v.ok == false) { return }
        let absent = contentAbsent()
        if (v.loC < absent) { self.sumLoC[slot] = contentsNarrowLo(self.sumLoC[slot], v.loC) }
        if (v.loR < absent) { self.sumLoR[slot] = contentsNarrowLo(self.sumLoR[slot], v.loR) }
        if (v.hiC > 0 - absent) { self.sumHiC[slot] = contentsWidenHi(self.sumHiC[slot], v.hiC) }
        if (v.hiR > 0 - absent) { self.sumHiR[slot] = contentsWidenHi(self.sumHiR[slot], v.hiR) }
    }
}


// The smaller of an accumulated low extreme and `v`, which saturates rather than wraps:
// past the edge of `Int` the check in settle() fails either way.
private fn contentsNarrowLo(acc: Int, v: I64) -> Int {
    if (v >= acc as I64) { return acc }
    if (contentsFitsInt(v) == false) { return 0 - CONTENTS_INT_MAX - 1 }
    return v as Int
}

private fn contentsWidenHi(acc: Int, v: I64) -> Int {
    if (v <= acc as I64) { return acc }
    if (contentsFitsInt(v) == false) { return CONTENTS_INT_MAX }
    return v as Int
}

private fn contentsFitsInt(v: I64) -> Bool {
    return v >= (0 - CONTENTS_INT_MAX - 1) as I64 and v <= CONTENTS_INT_MAX as I64
}

impl ArrayContents {
    // Each family's bound, from everything the walk recorded, over the arrays that did
    // not fail: one the walk never declared, and one whose stores read one that failed.
    internal fn settle(self) {
        for slot in 0..<self.names.length {
            if (self.family[slot] == 0) { self.failed[slot] = 1 }
        }
        for i in 0..<self.siteNodes.length {
            if (self.siteSeen[i] == false) { self.failed[self.siteSlots[i]] = 1 }
        }
        // An array too narrow for its family's bound fails alone, and what read it
        // after it; the rest settle again without it. Each round fails one more array
        // or ends.
        loop {
            self.spreadFailures()
            let mut narrow = false
            for slot in 0..<self.names.length {
                if (self.failed[slot] == 0 and self.tooNarrow(slot)) {
                    self.failed[slot] = 1
                    narrow = true
                }
            }
            if (narrow == false) { break }
        }
        for slot in 0..<self.names.length {
            self.settleFamily(self.family[slot])
        }
    }
}


impl ArrayContents {
    // A writer whose value read an array that failed fails too.
    private fn spreadFailures(self) {
        let mut spread = true
        while (spread) {
            spread = false
            for i in 0..<self.readWriter.length {
                if (self.failed[self.readSlot[i]] == 1 and self.failed[self.readWriter[i]] == 0) {
                    self.failed[self.readWriter[i]] = 1
                    spread = true
                }
            }
        }
    }
}


impl ArrayContents {
    // Whether the bound `slot`'s family would settle on lies outside its element type,
    // which would mean a store into it wrapped.
    private fn tooNarrow(self, slot: Int) -> Bool {
        let mut low = CONTENTS_INT_MAX as I64
        let mut high = (0 - CONTENTS_INT_MAX - 1) as I64
        let mut growth = 0 as I64
        for i in 0..<self.names.length {
            if (self.family[i] == self.family[slot] and self.failed[i] == 0) {
                if ((self.concreteLo[i] as I64) < low) { low = self.concreteLo[i] as I64 }
                if ((self.concreteHi[i] as I64) > high) { high = self.concreteHi[i] as I64 }
                growth = growth + self.growth[i] as I64
            }
        }
        return low < self.elemLo[slot] or high + growth > self.elemHi[slot]
    }
}


impl ArrayContents {
    private fn settleFamily(self, family: Int) {
        if (family == 0) { return }
        let mut low = CONTENTS_INT_MAX as I64
        let mut high = (0 - CONTENTS_INT_MAX - 1) as I64
        let mut growth = 0 as I64
        let mut sound = true
        for i in 0..<self.names.length {
            if (self.family[i] == family and self.failed[i] == 0) {
                if ((self.concreteLo[i] as I64) < low) { low = self.concreteLo[i] as I64 }
                if ((self.concreteHi[i] as I64) > high) { high = self.concreteHi[i] as I64 }
                growth = growth + self.growth[i] as I64
            }
        }
        let top = high + growth
        for i in 0..<self.names.length {
            if (self.family[i] == family and self.failed[i] == 0) {
                if (self.sumsFit(i, low, top) == false) { sound = false }
            }
        }
        if (sound == false or contentsFitsInt(top) == false) { return }
        for i in 0..<self.names.length {
            if (self.family[i] == family and self.failed[i] == 0) {
                self.lo[i] = low as Int
                self.hi[i] = top as Int
            }
        }
    }
}


impl ArrayContents {
    // Whether every `+`/`-` in a value stored into `slot` stays inside `Int` with the
    // family's elements in [low, top].
    private fn sumsFit(self, slot: Int, low: I64, top: I64) -> Bool {
        let intMin = (0 - CONTENTS_INT_MAX - 1) as I64
        let intMax = CONTENTS_INT_MAX as I64
        // An extreme at the edge of `Int` may have been saturated from past it. The
        // other edges are each accumulator's empty value.
        if (self.sumLoC[slot] as I64 == intMin or self.sumHiC[slot] as I64 == intMax) { return false }
        if (self.sumLoR[slot] as I64 == intMin or self.sumHiR[slot] as I64 == intMax) { return false }
        if (self.sumLoR[slot] as I64 != intMax and low + (self.sumLoR[slot] as I64) < intMin) {
            return false
        }
        if (self.sumHiR[slot] as I64 != intMin and top + (self.sumHiR[slot] as I64) > intMax) {
            return false
        }
        return true
    }
}


impl ArrayContents {
    // Whether the elements of `slot`'s array have a settled bound.
    internal fn bounded(self, slot: Int) -> Bool {
        return slot >= 0 and self.lo[slot] <= self.hi[slot]
    }
}


// ---------------------------------------------------------------------------
// Forms
// ---------------------------------------------------------------------------

// Further from zero than any sum of two `Int` bounds.
internal fn contentAbsent() -> I64 {
    return (CONTENTS_INT_MAX as I64) * (4 as I64)
}

internal fn contentFail() -> ContentForm {
    return ContentForm { ok: false, loC: 0 as I64, loR: 0 as I64, hiC: 0 as I64, hiR: 0 as I64 }
}

// A value in [lo, hi] whatever the arrays hold.
internal fn contentConst(lo: I64, hi: I64) -> ContentForm {
    let absent = contentAbsent()
    return ContentForm { ok: true, loC: lo, loR: absent, hiC: hi, hiR: 0 - absent }
}

// An element of the family being stored into: in [L, M].
internal fn contentRead() -> ContentForm {
    let absent = contentAbsent()
    return ContentForm { ok: true, loC: absent, loR: 0 as I64, hiC: 0 - absent, hiR: 0 as I64 }
}

private fn contentHasRelative(v: ContentForm) -> Bool {
    let absent = contentAbsent()
    return v.loR < absent or v.hiR > 0 - absent
}

// `a + b`, or `a - b` when `negate`. L + L and M - M are not forms, so at most one side
// may read the family, and only the left of a `-`.
internal fn contentSum(a: ContentForm, b: ContentForm, negate: Bool) -> ContentForm {
    if (a.ok == false or b.ok == false) { return contentFail() }
    if (contentHasRelative(b)) {
        if (negate or contentHasRelative(a)) { return contentFail() }
        return contentShift(b, a.loC, a.hiC)
    }
    if (negate) { return contentShift(a, 0 - b.hiC, 0 - b.loC) }
    return contentShift(a, b.loC, b.hiC)
}

// `v` plus a value in [lo, hi]; an absent part stays absent.
private fn contentShift(v: ContentForm, lo: I64, hi: I64) -> ContentForm {
    return ContentForm {
        ok: true,
        loC: contentPlus(v.loC, lo),
        loR: contentPlus(v.loR, lo),
        hiC: contentPlus(v.hiC, hi),
        hiR: contentPlus(v.hiR, hi)
    }
}

private fn contentPlus(part: I64, by: I64) -> I64 {
    let absent = contentAbsent()
    if (part >= absent or part <= 0 - absent) { return part }
    return part + by
}

// `min(a, b)`. Its low part is exact; its high part is either operand's, since the
// minimum is at most each, and the one taken is the one that reads less of the family.
internal fn contentMin(a: ContentForm, b: ContentForm) -> ContentForm {
    if (a.ok == false or b.ok == false) { return contentFail() }
    let fromA = a.hiR < b.hiR or (a.hiR == b.hiR and a.hiC <= b.hiC)
    let mut hiC = b.hiC
    let mut hiR = b.hiR
    if (fromA) {
        hiC = a.hiC
        hiR = a.hiR
    }
    return ContentForm {
        ok: true, loC: contentLower(a.loC, b.loC), loR: contentLower(a.loR, b.loR),
        hiC: hiC, hiR: hiR
    }
}

// `max(a, b)`, the mirror of contentMin.
internal fn contentMax(a: ContentForm, b: ContentForm) -> ContentForm {
    if (a.ok == false or b.ok == false) { return contentFail() }
    let fromA = a.loR > b.loR or (a.loR == b.loR and a.loC >= b.loC)
    let mut loC = b.loC
    let mut loR = b.loR
    if (fromA) {
        loC = a.loC
        loR = a.loR
    }
    return ContentForm {
        ok: true, loC: loC, loR: loR,
        hiC: contentHigher(a.hiC, b.hiC), hiR: contentHigher(a.hiR, b.hiR)
    }
}

private fn contentLower(a: I64, b: I64) -> I64 {
    if (a < b) { return a }
    return b
}

private fn contentHigher(a: I64, b: I64) -> I64 {
    if (a > b) { return a }
    return b
}
