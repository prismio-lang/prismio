// What a counted `while` says about its counter, for ir/nowrap.psm's walk.
//
// A `while` counts when one `and` conjunct of its condition bounds a counter `x` --
// `x < e`, `x <= e`, `x > e` or `x >= e`, with `e` a literal or a name the loop does not
// assign -- its body's last statement steps `x` towards that bound by a literal, and
// nothing else in the loop assigns or binds `x`. Every iteration starts with the
// condition true and nothing moves `x` before that last statement, so the step cannot
// wrap, and `x` stays between where it entered and the bound. A `continue` skips the
// step: the bound stands, but not the count of iterations.
//
// The walk asks before it forgets what the loop assigns, so the counter's fact where the
// loop starts is still there to read; nowrapCondition applies the result from the
// bounding conjunct on, and ir/contents.psm multiplies the counts.

import ast.nodes
import ast.types
import std.string

// The counter of one loop, or none (an empty name).
struct NowrapCounter {
    name: String,
    lo: I64,
    hi: I64,
    // The bounding conjunct, numbered as w.leaf numbers them, or -1.
    conjunct: Int,
    // How many times the body can run, or -1.
    trips: I64
}

internal fn nowrapNoCounter() -> NowrapCounter {
    return NowrapCounter { name: "", lo: 0 as I64, hi: 0 as I64, conjunct: 0 - 1, trips: (0 - 1) as I64 }
}

// The loop's counter, read with the facts at its entry: before the loop's own
// assignments are forgotten.
internal fn nowrapCounter(w: NowrapWalk, f: NowrapFacts, condPtr: Ptr, bodyPtr: Ptr) -> NowrapCounter {
    if (nodeIsNull(condPtr) or nodeIsNull(bodyPtr)) { return nowrapNoCounter() }
    let mut lastPtr = ptr_null()
    let mut p = ptr_to_node(bodyPtr).child1
    while (nodeExists(p)) {
        lastPtr = p
        p = ptr_to_node(p).next
    }
    if (nodeIsNull(lastPtr)) { return nowrapNoCounter() }
    let last = ptr_to_node(lastPtr)
    if (last.kind != NodeKind.ASSIGNMENT_STATEMENT or nowrapIsUpdate(last) == false) {
        return nowrapNoCounter()
    }
    let target = ptr_to_node(last.child1)
    let rhs = ptr_to_node(last.child2)
    if (nowrapIsIntName(target) == false or nowrapIsIntName(rhs) == false) { return nowrapNoCounter() }
    if (rangeIsNamed(rhs.child1, target.s1) == false) { return nowrapNoCounter() }
    let step = nowrapLiteral(ptr_to_node(rhs.child2))
    if (step < 1) { return nowrapNoCounter() }
    let up = rhs.s1.equals("+")
    if (nowrapWrites(condPtr, target.s1) + nowrapWrites(bodyPtr, target.s1) != 1) {
        return nowrapNoCounter()
    }
    w.leaf = 0
    let conjunct = nowrapCounterBound(w, f, condPtr, target.s1, up, condPtr, bodyPtr)
    if (conjunct < 0) { return nowrapNoCounter() }
    let intMin = (0 - 2147483647 - 1) as I64
    let intMax = 2147483647 as I64
    let by = step as I64
    let entered = f.find(target.s1)
    let mut lo = intMin
    let mut hi = intMax
    let mut trips = (0 - 1) as I64
    let counts = entered >= 0 and nowrapHasContinue(bodyPtr) == false
    if (up) {
        hi = w.hi
        if (hi + by > intMax) { return nowrapNoCounter() }
        if (entered >= 0) { lo = f.los[entered] as I64 }
        if (counts) { trips = nowrapTrips(lo, hi, by) }
    } else {
        lo = w.lo
        if (lo - by < intMin) { return nowrapNoCounter() }
        if (entered >= 0) { hi = f.his[entered] as I64 }
        if (counts) { trips = nowrapTrips(lo, hi, by) }
    }
    return NowrapCounter { name: target.s1.clone(), lo: lo, hi: hi, conjunct: conjunct, trips: trips }
}

private fn nowrapTrips(lo: I64, hi: I64, by: I64) -> I64 {
    if (hi < lo) { return 0 as I64 }
    return (hi - lo) / by + 1 as I64
}

// The conjunct of `cond` that bounds `name` from the side it steps towards, numbered as
// nowrapCondition numbers them, or -1. The bound goes into w.hi when the counter counts
// up and w.lo when it counts down.
private fn nowrapCounterBound(w: NowrapWalk, f: NowrapFacts, condPtr: Ptr, name: String,
                              up: Bool, loopCond: Ptr, loopBody: Ptr) -> Int {
    if (nodeIsNull(condPtr)) { return 0 - 1 }
    let c = ptr_to_node(condPtr)
    if (c.kind == NodeKind.BINARY_EXPR and c.s1.equals("and")) {
        let left = nowrapCounterBound(w, f, c.child1, name, up, loopCond, loopBody)
        if (left >= 0) { return left }
        return nowrapCounterBound(w, f, c.child2, name, up, loopCond, loopBody)
    }
    let conjunct = w.leaf
    w.leaf = w.leaf + 1
    if (c.kind != NodeKind.BINARY_EXPR or rangeIsNamed(c.child1, name) == false) { return 0 - 1 }
    let bound = ptr_to_node(c.child2)
    if (bound.kind == NodeKind.IDENTIFIER_EXPR) {
        if (nowrapIsIntName(bound) == false) { return 0 - 1 }
        if (nowrapWrites(loopCond, bound.s1) + nowrapWrites(loopBody, bound.s1) != 0) { return 0 - 1 }
    } else if (bound.kind != NodeKind.LITERAL_EXPR and bound.kind != NodeKind.UNARY_EXPR) {
        return 0 - 1
    }
    if (nowrapInterval(w, f, c.child2) == false) { return 0 - 1 }
    if (up and c.s1.equals("<=")) { return conjunct }
    if (up and c.s1.equals("<")) {
        w.hi = w.hi - 1 as I64
        return conjunct
    }
    if (up == false and c.s1.equals(">=")) { return conjunct }
    if (up == false and c.s1.equals(">")) {
        w.lo = w.lo + 1 as I64
        return conjunct
    }
    return 0 - 1
}

// How many times the subtree assigns or binds `name`.
private fn nowrapWrites(nodePtr: Ptr, name: String) -> Int {
    if (nodeIsNull(nodePtr)) { return 0 }
    let n = ptr_to_node(nodePtr)
    let mut count = 0
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
        let target = ptr_to_node(n.child1)
        if (target.kind == NodeKind.IDENTIFIER_EXPR and target.s1.equals(name)) { count = count + 1 }
    }
    let binds = n.kind == NodeKind.VARIABLE_DECL or n.kind == NodeKind.FOR_STATEMENT
                or n.kind == NodeKind.FUNCTION_PARAMETER
    if (binds and (n.s1.equals(name) or n.s2.equals(name))) { count = count + 1 }
    if (n.kind == NodeKind.MATCH_ARM and nowrapMentions(n.child1, name)) { count = count + 1 }
    return count + nowrapWritesChain(n.child1, name) + nowrapWritesChain(n.child2, name)
           + nowrapWritesChain(n.child3, name)
}

private fn nowrapWritesChain(head: Ptr, name: String) -> Int {
    let mut count = 0
    let mut p = head
    while (nodeExists(p)) {
        count = count + nowrapWrites(p, name)
        p = ptr_to_node(p).next
    }
    return count
}

// Whether a pattern mentions `name`, which it may bind.
private fn nowrapMentions(nodePtr: Ptr, name: String) -> Bool {
    let mut p = nodePtr
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (n.kind == NodeKind.IDENTIFIER_EXPR and n.s1.equals(name)) { return true }
        if (nowrapMentions(n.child1, name) or nowrapMentions(n.child2, name)
            or nowrapMentions(n.child3, name)) { return true }
        p = n.next
    }
    return false
}

// Whether the subtree holds a `continue`, which may be this loop's. Every child is a
// chain: a match's arms follow one another, as a block's statements do.
private fn nowrapHasContinue(nodePtr: Ptr) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)
    if (n.kind == NodeKind.CONTINUE_STATEMENT) { return true }
    return nowrapChainHasContinue(n.child1) or nowrapChainHasContinue(n.child2)
           or nowrapChainHasContinue(n.child3)
}

private fn nowrapChainHasContinue(head: Ptr) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        if (nowrapHasContinue(p)) { return true }
        p = ptr_to_node(p).next
    }
    return false
}
