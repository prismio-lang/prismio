// Mapping Prismio types onto LLVM types, and the symbol names that go with them.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string

private fn mapType(t: String) -> String {
    if (t.equals("Int")) { return "i32" }
    if (t.equals("Float")) { return "double" }
    if (t.equals("Bool")) { return "i1" }
    // A String is a pointer *and* a length. The buffer stays NUL-terminated
    // (FFI 7.1), so crossing to C is still `.ptr` and still zero-copy -- see
    // ffiType below, which is what an `extern` declaration uses.
    if (t.equals("String")) { return "struct:prismio.str" }
    // The fourth and last of the type-name tables (the others are
    // typeFromAnnotation, semaAnnotationType and typeFromSemKey). Missing here,
    // `Ptr` fell through to this function's default and every extern taking one
    // was declared `i32` while its call site passed `ptr` -- which LLVM's
    // verifier catches, but only at the point of emission.
    if (t.equals("Ptr")) { return "ptr" }
    if (t.equals("Char")) { return "i8" }
    if (t.equals("I8")) { return "i8" }
    if (t.equals("I16")) { return "i16" }
    if (t.equals("I64")) { return "i64" }
    if (t.equals("Isize")) { return irPtrIntType() }
    if (t.equals("U8")) { return "i8" }
    if (t.equals("U16")) { return "i16" }
    if (t.equals("U32")) { return "i32" }
    if (t.equals("U64")) { return "i64" }
    if (t.equals("Usize")) { return irPtrIntType() }
    if (t.equals("")) { return "void" }
    return "i32"
}

private fn structTypeKey(name: String) -> String {
    return "struct:".concat(name)
}

internal fn isStructTypeKey(t: String) -> Bool {
    return strStartsWith(t, "struct:")
}

// A machine integer wide enough to overflow, which is the set the debug-mode
// overflow check applies to.
//
// `i1` is deliberately absent. It is `Bool`, and the only arithmetic that
// reaches it is a comparison's *result*, never an operand -- so a checked add on
// one would be an intrinsic that cannot exist (`llvm.sadd.with.overflow.i1`)
// rather than a check that never fires. Everything else -- `ptr`, `double`,
// `struct:` -- either has its own path above or cannot take `+`.
internal fn isIntegerStorageKey(t: String) -> Bool {
    return t.equals("i8") or t.equals("i16")
        or t.equals("i32") or t.equals("i64")
}

// The fat String is the one key that answers `isStructTypeKey` while *not* being
// storage reached by GEP: it is a pair in a register, and a field of one holds
// the pair itself. Every site that branches on `isStructTypeKey` to choose
// between a byte copy and a store has to ask this first. Skipping it memcpy's 16
// bytes out of the literal's character data -- `@.str.sN` is `[2 x i8]`, not a
// pair -- so the field receives whatever follows it in .rodata as its pointer.
// That reads as a plain segfault at the first use, a long way from here.
internal fn isFatStringKey(t: String) -> Bool {
    return t.equals("struct:prismio.str")
}

// Built-in aggregates live in registers and fields by value. User structs use
// the same `struct:` key for their pointee type, so every storage decision must
// distinguish these two before treating a struct key as an address.
private fn isSliceKey(t: String) -> Bool {
    return t.equals("struct:prismio.slice")
}

private fn isDataElementKey(t: String) -> Bool {
    return t.equals("struct:prismio.data_element")
}

internal fn isValueStructKey(t: String) -> Bool {
    return isFatStringKey(t) or isSliceKey(t) or isDataElementKey(t)
}

internal fn structTypeName(t: String) -> String {
    return strSubstring(t, 7, __builtin_string_len(t) - 7)
}

private fn llvmTypeName(t: String) -> String {
    if (isStructTypeKey(t)) {
        return "%".concat(structTypeName(t))
    }
    return t
}

internal fn mapTypeNode(tn: ASTNode) -> String {
    // Sema resolved this annotation and left the answer on the node, so use it
    // rather than re-deriving one from the syntax. The two disagree on a generic
    // *struct* annotation -- the arm below answers `ptr` for anything with type
    // arguments, which was written for `List<T>` -- and the disagreement emits a
    // release call with an empty type name. See semaAnnotationType.
    //
    // Every case below is reproduced exactly by typeIrKey, so this is the same
    // mapping asked of the resolved type instead of the written one. They are
    // kept as the fallback for a node sema never reached.
    if (nodeExists(tn.typeInfo)) {
        let resolved = typeIrKey(ptr_to_type(tn.typeInfo))
        if (resolved.equals("") == false) { return resolved }
    }
    // REQUIREMENTS 4. `T?` is one pointer and is deliberately *not* keyed as
    // `struct:T`: an optional slot must not reach ir_struct_field_ptr without an
    // unwrap, and an opaque key is what keeps that a type error rather than a
    // null dereference at run time.
    if (tn.i3 == 1) {
        return "ptr"
    }
    if (tn.i2 == 1 and tn.s1.equals("Slice")) {
        return "struct:prismio.slice"
    }
    if (tn.i2 == 1) {
        return "ptr"            // List<T>
    }
    if (tn.i1 == 1) {
        if (nodeExists(tn.child1)) {
            let elem = ptr_to_node(tn.child1)
            if (elem.i1 == 1) {
                return "ptrptr"
            }
        }
        return "ptr"
    }
    if (ir_is_struct_type_name(tn.s1) == 1) {
        return structTypeKey(tn.s1)
    }
    return mapType(tn.s1)
}

internal fn storageType(t: String) -> String {
    if (t.equals("ptrptr")) { return "ptr" }
    // The fat String is a value, not a heap object reached by pointer, so it is
    // the one struct key that must survive this collapse.
    if (isValueStructKey(t)) { return t }
    if (isStructTypeKey(t)) { return "ptr" }
    return t
}

// What C sees. Identical to `storageType` except that a String flattens to the
// pointer half, because the buffer is NUL-terminated and the length is Prismio's
// bookkeeping rather than part of the ABI.
internal fn ffiType(t: String) -> String {
    if (t.equals("struct:prismio.str")) { return "ptr" }
    return storageType(t)
}

// What a *field* of this type occupies in its owner, which is not what a local
// or a parameter of the same type occupies.
//
// A struct-typed field is storage: `struct:T` survives into the registered type,
// the LLVM body embeds %T by value, and every access reaches it by GEP instead
// of by loading an address. `storageType` collapsing it to `ptr` is what made
// `Transform { position: Vec3, rotation: Quat }` three pointers and three
// allocations rather than one contiguous object.
//
// Locals and parameters deliberately keep `storageType`. A T0 local already gets
// an alloca that SROA promotes to registers, and widening the calling convention
// to pass structs by value is a separate change with its own ABI questions.
//
// `T?` is not a containment edge -- mapTypeNode returns `ptr` for it before this
// is reached. That is what gives the language a reference edge to spell a
// recursive type with, and therefore what lets containment be required acyclic.
internal fn fieldStorageType(t: String) -> String {
    if (t.equals("ptrptr")) { return "ptr" }
    // A String field embeds the pair. Storing only the pointer would be one word
    // instead of two, but `ir_register_struct_field` records the *storage* type,
    // so a String field would come back indistinguishable from any other pointer
    // -- and a `match` binding its payload would have no way to know it must
    // rebuild the length. Keeping the pair keeps the type. The release paths are
    // unaffected: `coerce_for` in the backend hands them the pointer half.
    return t
}

internal fn countListNodes(firstPtr: Ptr) -> Int {
    let mut count = 0
    let mut curr = firstPtr
    while (nodeExists(curr)) {
        let node = ptr_to_node(curr)
        count = count + 1
        curr = node.next
    }
    return count
}

internal fn functionSymbolName(func: ASTNode) -> String {
    if (func.s2.equals("") == false) {
        return func.s2
    }
    return func.s1
}

internal fn getDeclaredReturnType(node: ASTNode, retChild: Ptr) -> String {
    if (nodeExists(retChild)) {
        let retNode = ptr_to_node(retChild)
        return mapTypeNode(retNode)
    }
    return "void"
}

internal fn getExprType(expr: ASTNode) -> String {
    if (nodeHasType(expr)) {
        return typeIrKey(nodeGetType(expr))
    }

    if (expr.kind == NodeKind.LITERAL_EXPR) {
        if (expr.i1 == TokenType.NUMBER_LITERAL) { return "i32" }
        if (expr.i1 == TokenType.FLOAT_LITERAL) { return "double" }
        if (expr.i1 == TokenType.BOOL_LITERAL) { return "i1" }
        if (expr.i1 == TokenType.CHAR_LITERAL) { return "i8" }
        if (expr.i1 == TokenType.STRING_LITERAL) { return "ptr" }
    }

    if (expr.kind == NodeKind.IDENTIFIER_EXPR) {
        return ir_get_var_type(expr.s1)
    }

    if (expr.kind == NodeKind.UNARY_EXPR) {
        if (expr.s1.equals("!")) { return "i1" }
        return getExprType(ptr_to_node(expr.child1))
    }

    if (expr.kind == NodeKind.CAST_EXPR) {
        // sema records the target type on the node; this is only the fallback.
        return mapTypeNode(ptr_to_node(expr.child2))
    }

    if (expr.kind == NodeKind.BINARY_EXPR) {
        let op = expr.s1
        if (op.equals("==") or op.equals("!=")) { return "i1" }
        if (op.equals("<") or op.equals("<=")) { return "i1" }
        if (op.equals(">") or op.equals(">=")) { return "i1" }
        if (op.equals("and") or op.equals("or")) { return "i1" }
        return getExprType(ptr_to_node(expr.child1))
    }

    if (expr.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(expr.child1)
        let funcName = callee.s1
        if (expr.s2.equals("") == false) {
            return ir_get_fn_return_type(expr.s2)
        }
        return ir_get_fn_return_type(funcName)
    }

    if (expr.kind == NodeKind.INDEX_EXPR) {
        let objType = getExprType(ptr_to_node(expr.child1))
        if (objType.equals("ptrptr")) {
            return "ptr"
        }
        return "i32"
    }

    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let objectNode = ptr_to_node(expr.child1)
        if (objectNode.kind == NodeKind.IDENTIFIER_EXPR) {
            let enumVal = ir_get_enum_variant(objectNode.s1, expr.s1)
            if (enumVal >= 0) {
                return "i32"
            }
        }
        let objectType = getExprType(objectNode)
        if (isStructTypeKey(objectType)) {
            return ir_get_struct_field_type(structTypeName(objectType), expr.s1)
        }
        return "i32"
    }

    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        return "ptr"
    }

    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        return structTypeKey(expr.s1)
    }

    return "i32"
}

// Which deallocator an expression's value needs. Read from sema's type rather
// than the storage type, which has already collapsed String, List and every
// struct to `ptr`.
// REQUIREMENTS 20. A `List<T>` stores pointer-sized slots, and a scalar element
// rides in one rather than being boxed.
//
// Boxing was the alternative and it is worse twice over: an allocation per
// element, and the container would then have something to *own* -- which is
// exactly what a scalar element is not. Nothing allocates, so the element
// registers no site, so `aif_elem_owner_at_node` answers NONE and the teardown
// steps over the whole list. The memory model needs no case for this, which is
// the property that makes the representation the right one.
//
// The integer family widens to pointer width and reinterprets. A `Float` is 64
// bits of payload rather than a number to convert, so it bitcasts first -- an
// `fptosi` here would round 0.5 to 0 and store that.
private fn scalarBitsOf(t: String) -> Int {
    if (t.equals("i1")) { return 1 }
    if (t.equals("i8")) { return 8 }
    if (t.equals("i16")) { return 16 }
    if (t.equals("i32")) { return 32 }
    if (t.equals("i64")) { return 64 }
    if (t.equals("double")) { return 64 }
    return 0
}

// The bytes a scalar occupies in an inline container row, or 0 for a key that
// is not a scalar.
//
// **In bytes, and rounded up, because a row is addressed by stride.** `i1` is
// one byte here rather than one bit: the element address is
// `data + index * elem_size`, which cannot name a bit, and a bit-packed
// `List<Bool>` is a different representation with a different access path rather
// than a smaller number in this function. One byte is still 8x what the pointer
// slot spends on it.
//
// `struct:` keys are deliberately absent -- their size is a layout question for
// ir_struct_size, which knows about padding and nested flat fields, and a second
// answer here is the disagreement the note on inlineElemSize warns about.
internal fn scalarInlineBytes(t: String) -> Int {
    let bits = scalarBitsOf(t)
    if (bits == 0) { return 0 }
    if (bits == 1) { return 1 }
    return bits / 8
}

internal fn scalarToSlot(storeType: String, value: String) -> String {
    if (storeType.equals("ptr")) { return value }
    // A String in a container slot is its pointer. The length is not stored --
    // it is recovered on the way out, from the NUL the buffer always carries
    // (FFI 7.1), which is one `strlen` per read against a word per element in
    // every container. Widening the pair into a slot is what `zext
    // %prismio.str to i64` was.
    if (storeType.equals("struct:prismio.str")) {
        // Through `str_own`, not a field read. A slot is one word and the
        // container frees what it holds, so a short string -- twelve bytes in the
        // pair, no address of its own -- has to be copied to the heap on the way
        // in. A long one passes straight through and transfers ownership as
        // before; the runtime tests the tag rather than the caller, because the
        // copy is conditional and a select would run both arms.
        let data = ir_get_temp_name(ir_str_data(value))
        let word = ir_get_temp_name(ir_extract_value("struct:prismio.str", value, 1))
        ir_call_begin()
        ir_call_arg("ptr", data)
        ir_call_arg("i64", word)
        return ir_get_temp_name(ir_call_end("ptr", "str_own"))
    }
    let pi = irPtrIntType()

    if (storeType.equals("double")) {
        let bits = ir_get_temp_name(ir_bitcast("double", value, "i64"))
        return ir_get_temp_name(ir_int_to_ptr("i64", bits))
    }

    let mut widened = value
    if (scalarBitsOf(storeType) < scalarBitsOf(pi)) {
        widened = ir_get_temp_name(ir_zext(storeType, value, pi))
    }
    return ir_get_temp_name(ir_int_to_ptr(pi, widened))
}

internal fn slotToScalar(storeType: String, value: String) -> String {
    if (storeType.equals("ptr")) { return value }
    let pi = irPtrIntType()

    if (storeType.equals("double")) {
        let bits = ir_get_temp_name(ir_ptr_to_int(value, "i64"))
        return ir_get_temp_name(ir_bitcast("i64", bits, "double"))
    }

    let raw = ir_get_temp_name(ir_ptr_to_int(value, pi))
    if (scalarBitsOf(storeType) < scalarBitsOf(pi)) {
        return ir_get_temp_name(ir_trunc(pi, raw, storeType))
    }
    return raw
}

// Which argument of a container call carries the element, or -1. The element is
// the one that has to cross into a pointer-sized slot; the list handle and the
// index are already the widths the runtime declares.
internal fn listElementArgIndex(funcName: String) -> Int {
    if (funcName.equals("list_push")) { return 1 }
    if (funcName.equals("list_set")) { return 2 }
    if (funcName.equals("list_set_exclusive")) { return 2 }
    return -1
}

internal fn dropKindOf(expr: ASTNode) -> Int {
    if (nodeGetType(expr).kind == TypeKind.LIST) { return IR_DROP_LIST }
    if (nodeGetType(expr).kind == TypeKind.DATAVIEW) { return IR_DROP_DATAVIEW }
    // Struct-field ownership. Freeing the object alone would leak every field it
    // owns, so a type the model generated a release for is reclaimed by that.
    let ty = getExprType(expr)
    if (isStructTypeKey(ty)) {
        if (aif_type_releases(structTypeName(ty)) == 1) { return IR_DROP_TYPED }
    }
    return IR_DROP_OBJECT
}
