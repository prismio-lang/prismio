// IR generation state: the tier and drop-kind constants the AIF-driven emission
// switches on, and the bridge surface every other module in this package calls
// into.

import ast.types
import common.target

// IR Generator
// Traverses the AST and emits LLVM IR via bridge.psm
// Uses C-side global registry to avoid Prismio string globals

import ast.types

let mut irStringCounter = 0
let mut irShortCircuitCounter = 0

// LAYOUT 3.2. On only while generating a workload driver -- the instrumented
// build the compiler produces, runs and discards. It gates every emission this
// feature adds, and there is exactly one place it is set (runWorkloadProfile in
// main.psm), which is what makes "a shipped binary contains no instrumentation"
// checkable by reading one assignment rather than by trusting a dozen guards.
//
// **W1 and W4 both rest on this flag being false everywhere else.** A profile is
// an input to codegen only; if this were ever true during the real build, the
// two would stop being different artifacts and the guarantee would be gone.
let mut irProfileMode = false

// Where the driver writes the profile it measures. Baked into the driver as a
// constant rather than read from argv, because the driver is run with no argv at
// all (W3: a workload must not be able to see how the build was invoked).
let mut irProfilePath = ""

fn irSetProfileMode(enabled: Bool, profilePath: String) {
    irProfileMode = enabled
    irProfilePath = profilePath
}

// The body of the function being generated, so a droppable candidate can ask
// whether the binding is ever reassigned. See nodeAssignsName.
let mut irFunctionBody = ""

// AIF's T0. The only tier codegen currently acts on -- everything else keeps
// the allocator hook it always used. Kept as a named constant here rather than
// imported so that ir.psm depends on the memory model's *answer* and not on its
// implementation; aif.psm owns the encoding.
let AIF_TIER_T0 = 0

// AIF Level 4. Which deallocator reclaims a droppable binding. Everything the
// allocator seam handed out is IR_DROP_OBJECT; a List is two allocations and
// needs the runtime's own release, so the drop list has to carry the answer --
// by the time it is read, a String and a List are both `ptr`.
let IR_DROP_OBJECT = 0
let IR_DROP_LIST = 1
// Struct-field ownership. The release is the type's own generated function, and
// the drop list already carries the declared type -- so this needs no extra
// storage, only a third case at every site that reads the kind.
let IR_DROP_TYPED = 2

// AIF item 3. What a container does with its elements when it is released, and
// what a known callee's return leaves the caller owning. One encoding for both,
// because both answer "which release does this pointer need" and both are
// decided by the same per-site disposition in aif_support.c.
let AIF_ELEM_NONE = 0
let AIF_ELEM_OBJECT = 1
let AIF_ELEM_LIST = 2
let AIF_ELEM_RC = 3
// Struct-field ownership. Not a mode the runtime can act on by itself: it names
// a release that differs per type, which is why the generated function exists.
let AIF_ELEM_TYPED = 4
// REQUIREMENTS 15. AIF_ELEM_RC and its cyclic sibling one tier up, where the
// count is one two threads can touch and the decrement has to be atomic.
//
// 5 is AIF_ELEM_CYCLE. This file named it without switching on it, because the
// only field that can carry a cyclic disposition is one that re-enters its
// owner's type and field_closes_cycle vetoed every one of them. **M2.1a removed
// that veto and generateReleaseFn switches on it now** -- it had been falling
// into the plain-object branch, which frees a collected object a second time.
let AIF_ELEM_CYCLE = 5
let AIF_ELEM_RC_ATOMIC = 6
let AIF_ELEM_CYCLE_ATOMIC = 7

// Where a value the memory model inferred lives, keyed by the AST node that
// allocates it -- both passes walk the same tree, so the node is a name for the
// expression that cannot collide. -1 means no inference ran for this node; see
// the use site in generateExpression.
extern fn aif_tier_at_node(node: String borrow) -> Int

// Whether the value this node allocates dies with the scope that allocates it,
// which is what licenses a free at that scope's exits. Not derivable from the
// tier: T1 is "some region", and it may be an enclosing one.
extern fn aif_frees_at_scope_node(node: String borrow) -> Int

// The same question at an assignment rather than at a scope exit: may the store
// release what it overwrites? Every clause of the one above holds except
// confinement, because an accumulator allocates in a loop body and binds outside
// it -- and `return out` puts E at Caller for a value no return ever carried.
extern fn aif_releases_on_overwrite_node(node: String borrow) -> Int


// Whether it may come from the enclosing `region`'s arena instead of the heap.
// Stricter than "is inside a region block": the value must also be unable to
// outlive that region, which a nested region makes a real question.
extern fn aif_arena_at_node(node: String borrow) -> Int

// Whether the cost model placed an arena at this block (LAYOUT 7.1). A `region`
// statement answers 0 here -- codegen already brackets that one by keyword, and
// bracketing it twice would push two arenas and pop one.
extern fn aif_auto_arena_at_node(node: String borrow) -> Int

// M3.2d. Which statements of that block the arena has to cover: the first that
// puts something in it, and the last that still reads something it holds, as
// indices into the block's own statement list. Both answer -1 for "the whole
// block", which is the lexical extent and what every arena got before the range
// existed -- so a compiler that cannot narrow behaves exactly as it did.
//
// Two calls rather than one, because a pair is not a thing this language can
// return; they ask the same question and are answered from one cached range.
extern fn aif_arena_range_first(node: String borrow) -> Int
extern fn aif_arena_range_last(node: String borrow) -> Int

// AIF item 3. What the container allocated at this node owns: AIF_ELEM_NONE
// unless every element site agrees on one release, because a teardown loop makes
// one call per element and cannot dispatch per element.
extern fn aif_elem_owner_at_node(node: String borrow) -> Int

// AIF Level 5. Whether this node's value carries a reference count. Reads the
// same predicate the element disposition does, because a container told its
// elements are counted decrements every one of them -- so a site that reached it
// without a header would be a write into someone else's allocation.
extern fn aif_rc_at_node(node: String borrow) -> Int

// LAYOUT 7.2. The i-th field of this struct in the physical order the search
// chose, or "" when no inference ran.
extern fn aif_layout_field(type: String, i: Int) -> String alias

// Whether binding this call's result gives the binding something to release.
// Answers the question the escape lattice structurally cannot: a returned value
// is Caller and stays Caller, however briefly the caller keeps it.
extern fn aif_owns_call_result_at_node(node: String borrow) -> Int

// Struct-field ownership. Whether this type owns anything, and what each field
// needs. Per field, because a struct mixes -- `World` is five owned Lists and an
// Int, and one answer for the whole type would have to be "nothing" for all six.
extern fn aif_type_releases(type: String) -> Int
extern fn aif_field_release(type: String, field: String) -> Int

// The element type of a container whose elements are released by type. Read from
// the sites, because `list_new()` types as `List<Invalid>` and the annotation is
// not always there to read.
extern fn aif_elem_type_at_node(node: String borrow) -> String alias

// AIF T4b (CYCLES). Whether this node's value is collected as a possible cycle
// member, and which of a type's fields are the cyclic edges the collector walks.
extern fn aif_cycle_at_node(node: String borrow) -> Int
extern fn aif_type_in_cycle(type: String) -> Int
extern fn aif_field_is_cyclic(type: String, field: String) -> Int

// Whether a store into this field moves a count. Trial deletion subtracts the
// edges it traverses, so an edge nobody counted makes it subtract a reference
// that was never added -- which reads a live object as unreachable.
extern fn aif_field_is_counted(type: String, field: String) -> Int

extern fn exit(code: Int)

// The integer the backend sizes an allocation and indexes an array GEP with:
// pointer width, in LLVM spelling. A target property, read from the target
// record -- see src/ir/target.psm.
fn irPtrIntType() -> String {
    return targetPtrIntType(targetCurrent())
}
