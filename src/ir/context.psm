// IR generation state: the tier and drop-kind constants the AIF-driven emission
// switches on, and the bridge surface every other module in this package calls
// into.

import ast.types
import common.target

// IR Generator
// Traverses the AST and emits LLVM IR via bridge.psm
// Uses C-side global registry to avoid Prismio string globals

import ast.types

let mut irStringCounter = 0
let mut irShortCircuitCounter = 0

// The hidden slots `??` gives its owned temporaries, as ";<id>=<slot>|<storage key>;"
// for each one made in the function being generated (coalesceSpillFor).
let mut irCoalesceSpills = ";"
// Names generateChannelRecvCopy's result slots, as the counter above names
// generateShortCircuit's.
let mut irChannelRecvCounter = 0
// The value of the call at the root of the member chain generateMemberAccess
// last evaluated (memberChainRoot), for the release that follows the read or
// the call it was passed to.
let mut irMemberRootValue = ""
// How many loops enclose the statement being generated.
//
// The flat push below is worth its three header loads and a branch only where a
// loop amortises them. Straight-line pushes keep the runtime call: g6's
// `world_spawn` makes three in a row, and inlining them doubled it from 37 to 74
// instructions and cost the program 1.16x -- against g2's cull loop, where the
// same change is 0.97x.
let mut irLoopDepth = 0

// Whether the function being generated contains a loop anywhere in its body. A
// String binding's data pointer is resolved once, where the binding is made, only
// when one does: see the parameter loop in generateFunction (ir/module.psm).
let mut irFunctionHasLoop = false

// The slot holding the enclosing loop's flat-List guard, or "" outside such a
// loop. One `i1` per loop rather than one test per `list_get`: see
// generateLoopFlatGuard in src/ir/stmt.psm.
let mut irLoopFlatGuard = ""
let mut irLoopFlatGuardCounter = 0

// The range proof active in the loop copy being generated, or 0 (ir/ranges.psm).
// An access whose node carries this proof drops its bounds check -- and dropping
// it is the point, because a conditional element load is one LICM will not
// hoist, which is the whole reason `data` was re-read per access. Saved and
// restored around each loop exactly as irLoopFlatGuard is.
let mut irLoopRangeProof = 0
// The proof the last range analysis produced, handed from ir/ranges.psm to the
// loop that asked for it, and whether it covers every flat access in the loop.
let mut irLoopRangeProofPending = 0
let mut irLoopRangeProofComplete = false

// The access-facts pass of the function being generated, or 0 (ir/nowrap.psm). A
// `+`/`-` node carrying it cannot wrap in any copy of any loop it is in.
let mut irNowrapPass = 0

// A narrower bounds fact for a growing-container loop:
// `while (iv < list_len(xs))`. The condition proves only `xs[iv]`, and only
// until the body assigns `iv`; unlike a range proof it says nothing about
// any other index formed by the body. generateStatement clears Active at that
// first assignment and restores the enclosing loop's fact around nested loops.
let mut irLoopHeaderBoundList = ""
let mut irLoopHeaderBoundIndex = ""
let mut irLoopHeaderBoundActive = false

// One stable List length captured in the loop preheader. This is narrower than
// a range proof: accesses still perform their unsigned bounds check, but they
// compare against the captured SSA value instead of reloading an immutable
// header field at every site in the body.
let mut irLoopHoistedBoundList = ""
let mut irLoopHoistedBoundValue = ""
let mut irLoopHoistedDataValue = ""

// E1's guard: the slot holding "every push this loop performs fits in the
// capacity the receiver already has", or "" outside such a loop. Separate from
// irLoopFlatGuard on purpose -- that one declines any loop containing a push,
// because a push can reallocate the block its readers are indexing, and folding
// the two would make a capacity miss cost the reads as well.
let mut irLoopPushGuard = ""
let mut irLoopPushGuardCounter = 0

// Names the stack slot a `spawn`'s owned temporary argument is spilled into, so
// the ordinary scope drop can reach it. Dotted like `sc.`, which no Prismio
// identifier can contain, so it cannot collide with a user variable.
let mut irSpawnArgCounter = 0

// Names the stack slot a scalar is spilled into so an inline container op has an
// address to copy from. Dotted like `sc.` for the same reason.
let mut irElemSpillCounter = 0

// Names the binding irHoistBorrowedTemporaries gives a temporary. Dotted for the
// same reason.
let mut irBorrowedTempCounter = 0

// Where irFindBorrowedTemporary found one: the node it hangs from, itself, and
// the argument before it -- null when it is the first, and then irHoistSlot
// says which child it is (1 a member access's object, 2 a call's arguments).
let mut irHoistCall: Ptr
let mut irHoistArg: Ptr
let mut irHoistPrev: Ptr
let mut irHoistSlot = 0

// The bindings one irValueAliasesName query has already chased, `;`-separated.
let mut irAliasChased = ""

// LAYOUT 3.2. On only while generating a workload driver -- the instrumented
// build the compiler produces, runs and discards. It gates every emission this
// feature adds, and there is exactly one place it is set (runWorkloadProfile in
// main.psm), which is what makes "a shipped binary contains no instrumentation"
// checkable by reading one assignment rather than by trusting a dozen guards.
//
// **W1 and W4 both rest on this flag being false everywhere else.** A profile is
// an input to codegen only; if this were ever true during the real build, the
// two would stop being different artifacts and the guarantee would be gone.
let mut irProfileMode = false

// Where the driver writes the profile it measures. Baked into the driver as a
// constant rather than read from argv, because the driver is run with no argv at
// all (W3: a workload must not be able to see how the build was invoked).
let mut irProfilePath = ""

public fn irSetProfileMode(enabled: Bool, profilePath: String) {
    irProfileMode = enabled
    irProfilePath = profilePath
}

// The body of the function being generated, so a droppable candidate can ask
// whether the binding is ever reassigned. See nodeAssignsName.
// No initializer: nothing runs before main, so a global cannot be initialized by
// a call, and `ptr_null()` is one. An uninitialized global is zero-filled, which
// for a pointer is exactly NULL -- the value this wants.
let mut irFunctionBody: Ptr

// The declaration whose body is being emitted. M2.1b's reuse eligibility needs
// the written ownership mode of a parameter; the body pointer above cannot
// answer that because parameters live outside the body block.
let mut irFunctionDecl: Ptr

// A frame-limited reuse token. It is set only while one consuming match arm is
// emitted and cleared before the next branch, so it cannot cross a call or be
// retained beyond the branch that destructured the block.
let mut irReuseValue = ""

// AIF's T0. The only tier codegen currently acts on -- everything else keeps
// the allocator hook it always used. Kept as a named constant here rather than
// imported so that ir.psm depends on the memory model's *answer* and not on its
// implementation; aif.psm owns the encoding.
let AIF_TIER_T0 = 0

// AIF Level 4. Which deallocator reclaims a droppable binding. Everything the
// allocator seam handed out is IR_DROP_OBJECT; a List is two allocations and
// needs the runtime's own release, so the drop list has to carry the answer --
// by the time it is read, a String and a List are both `ptr`.
let IR_DROP_OBJECT = 0
let IR_DROP_LIST = 1
// Struct-field ownership. The release is the type's own generated function, and
// the drop list already carries the declared type -- so this needs no extra
// storage, only a third case at every site that reads the kind.
let IR_DROP_TYPED = 2
// M4.3. A DataView is a header plus one allocation per column, so neither the
// object seam nor List's release is sufficient.
let IR_DROP_DATAVIEW = 3
// A task handle is the runtime's own struct, not an allocator-seam object, so
// only the runtime can free it -- `prismio_task_release` is what does. It is a
// separate kind rather than IR_DROP_OBJECT because freeing it through the seam
// would report a release of a pointer the verify ledger never handed out.
let IR_DROP_TASK = 4
// A struct AIF placed on the frame, of a type whose fields own what they hold.
// The slot is the frame's, so only the fields are released -- through the
// type's fields-only release, `__aif_release_fields_T`, which the drop list
// names from the declared type exactly as IR_DROP_TYPED does.
let IR_DROP_FIELDS = 5

// The struct types a frame struct's drop has named, joined with `;`. Their
// fields-only releases are defined after every function, for these and no
// others, so a program with no such struct carries none.
let mut irFrameReleaseTypes = ""

// The `scope { }` blocks open in the function being emitted, as `;level=slot;`: the
// region depth each was entered at, and the slot holding its runtime scope. An exit
// that leaves a level (return, break, continue) ends that scope instead of popping
// an arena, and a `spawn` registers with the innermost one. Empty outside any scope,
// which is every function that does not write one.
let mut irTaskScopes = ""
let mut irTaskScopeCounter = 0

// The struct an optional binding's typed drop releases, as `;slot=struct:T;`.
// A `T?` slot is keyed `ptr` (see mapTypeNode), which names no release, so a drop
// list entry for one would call `__aif_release_` -- an undefined symbol, and a
// link failure for any program that bound a recursive `Node?` it owned.
let mut irOptionalDropTypes = ";"

// Bindings initialised from a struct literal on the frame, as `;slot@floor;`:
// the slot, and the scope's drop floor it was declared at. A field assignment
// made at that same floor may give its new value the same scope-exit owner the
// literal's fields got (ir/stmt.psm, generateAssignment).
let mut irFrameStructSlots = ""

// AIF item 3. What a container does with its elements when it is released, and
// what a known callee's return leaves the caller owning. One encoding for both,
// because both answer "which release does this pointer need" and both are
// decided by the same per-site disposition in src/aifcore/.
let AIF_ELEM_NONE = 0
let AIF_ELEM_OBJECT = 1
let AIF_ELEM_LIST = 2
let AIF_ELEM_RC = 3
// Struct-field ownership. Not a mode the runtime can act on by itself: it names
// a release that differs per type, which is why the generated function exists.
let AIF_ELEM_TYPED = 4
// REQUIREMENTS 15. AIF_ELEM_RC and its cyclic sibling one tier up, where the
// count is one two threads can touch and the decrement has to be atomic.
//
// 5 is AIF_ELEM_CYCLE. This file named it without switching on it, because the
// only field that can carry a cyclic disposition is one that re-enters its
// owner's type and fieldClosesCycle vetoed every one of them. **M2.1a removed
// that veto and generateReleaseFn switches on it now** -- it had been falling
// into the plain-object branch, which frees a collected object a second time.
let AIF_ELEM_CYCLE = 5
let AIF_ELEM_RC_ATOMIC = 6
let AIF_ELEM_CYCLE_ATOMIC = 7
// Not an analysis answer: codegen stamps it in place of OBJECT on a
// `List<String>`, whose elements are pairs rather than pointers, so teardown
// frees an owned long form and skips an inline one.
let AIF_ELEM_STRING = 8

// The integer the backend sizes an allocation and indexes an array GEP with:
// pointer width, in LLVM spelling. A target property, read from the target
// record -- see src/ir/target.psm.
internal fn irPtrIntType() -> String {
    return targetPtrIntType(targetCurrent())
}
