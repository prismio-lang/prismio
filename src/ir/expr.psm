// Lowering expressions to values.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string

// `and` / `or` with the right-hand side evaluated only when it can change the
// answer. Previously both operands were generated unconditionally and combined
// with a plain `and`/`or` instruction, so `p != "" and deref(p)` evaluated
// deref(p) even when p was empty. That is a semantics bug rather than a missed
// optimisation, and the compiler's own guards in sema.psm are written assuming
// short-circuiting -- `print()` with no arguments used to segfault the compiler
// for exactly this reason.
//
// The result travels through a stack slot rather than a phi: the bridge has no
// phi primitive, and mem2reg turns this back into one anyway. The slot is named
// with a dot, which no Prismio identifier can contain, so it can never collide
// with a user variable.
private fn generateShortCircuit(expr: ASTNode) -> String {
    let isAnd = expr.s1.equals("and")

    let slot = "sc.".concat(strFromInt(irShortCircuitCounter))
    irShortCircuitCounter = irShortCircuitCounter + 1
    ir_alloca("i1", slot)

    let rhsLabel = ir_get_label()
    let doneLabel = ir_get_label()

    // Seed the slot with the left result, so the short-circuit path already has
    // the right answer: `false and _` is false, `true or _` is true.
    let leftVal = generateExpression(ptr_to_node(expr.child1))
    ir_store("i1", leftVal, slot)
    if (isAnd) {
        ir_cond_br_numbered(leftVal, rhsLabel, doneLabel)
    } else {
        ir_cond_br_numbered(leftVal, doneLabel, rhsLabel)
    }

    ir_label_numbered(rhsLabel)
    let rightVal = generateExpression(ptr_to_node(expr.child2))
    ir_store("i1", rightVal, slot)
    ir_br_numbered(doneLabel)

    ir_label_numbered(doneLabel)
    let resultId = ir_load("i1", slot)
    return ir_get_temp_name(resultId)
}

// Whether `name` is ever the target of an assignment inside the function being
// generated.
//
// A binding is droppable because its *initialiser* allocated something this
// scope owns -- but what the drop frees is the slot, and an assignment can put
// something else in it. `s = node.name` leaves a borrowed pointer where the exit
// expects an owned one, which is a free of a value the AST still holds. AIF
// Level 4 made that reachable everywhere: strings are reassigned constantly and
// a field read is a borrow.
//
// Asked at the declaration rather than at the assignment, because codegen is a
// single forward walk and the run-time order is not the source order: a `break`
// written above the assignment still executes after it on the second iteration.
//
// Deliberately syntactic and deliberately blunt. A reassigned binding is not
// droppable even when every value it receives is owned -- that case leaks today
// regardless, since there is no drop on reassignment, so the strictness costs
// nothing that is not already lost.
private fn nodeAssignsName(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        if (nodeExists(n.child1)) {
            let target = ptr_to_node(n.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR and target.s1.equals(name)) {
                return true
            }
        }
    }

    if (chainAssignsName(n.child1, name)) { return true }
    if (chainAssignsName(n.child2, name)) { return true }
    return chainAssignsName(n.child3, name)
}

internal fn chainAssignsName(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeAssignsName(p, name)) { return true }
        p = n.next
    }
    return false
}

// Whether this expression hands the enclosing scope a value it owns.
//
// The same question the declaration asks of an initialiser, asked of an
// assignment's right-hand side. `aif_frees_at_scope_node` is the fact and it
// already accounts for escape: a value pushed into a container or returned has
// its E raised, so the answer is false and the binding never qualifies as an
// accumulator. That is what keeps the release below from double-freeing a value
// ownership left through a side door.
//
// A string literal counts because the declaration clones it -- see
// generateStatement. Without that clause the accumulator idiom `let mut s = ""`
// is disqualified by its own first line, which is every one of them.
internal fn nodeProducesOwnedValue(exprPtr: Ptr) -> Bool {
    if (nodeIsNull(exprPtr)) { return false }
    if (aif_releases_on_overwrite_node(exprPtr) == 1) { return true }
    // M2.0b. A value a *callee* allocated and handed over, which the escape
    // lattice cannot express -- a returned value is Caller and stays Caller.
    //
    // The declaration guards this fact with `chainAssignsName == false` and
    // `chainReturnsName == false`, and both were re-derived before it was used
    // here rather than assumed stale. The first was there because an assignment
    // could put a *borrow* in the slot and because nothing released what an
    // assignment displaced; irOwningAccumulator rules out the borrow and M2.0
    // added the release. The second is about the *last* value only -- a returned
    // binding hands that one to the caller -- so it still guards the scope-exit
    // drop, and the branch below still applies it. Neither is about a value an
    // assignment displaced, which is what this predicate answers.
    return aif_owns_call_result_at_node(exprPtr) != AIF_ELEM_NONE
        or nodeIsStringLiteralExpr(exprPtr)
}

internal fn nodeIsStringLiteralExpr(exprPtr: Ptr) -> Bool {
    if (nodeIsNull(exprPtr)) { return false }
    let n = ptr_to_node(exprPtr)
    if (n.kind != NodeKind.LITERAL_EXPR) { return false }
    return n.i1 == TokenType.STRING_LITERAL
}

// Whether any assignment to `name` stores something this scope does not own.
//
// The complement of nodeAssignsName rather than a refinement of it: that one
// answers "is this binding ever reassigned", which disqualifies it, and this one
// answers "is any of those reassignments the reason it had to be disqualified".
// A binding reassigned only with owned values can be dropped and can release what
// it displaces; one that ever receives a borrow -- `s = node.name` -- cannot do
// either, and the difference is a free of a value the AST still holds.
private fn nodeAssignsUnowned(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        if (nodeExists(n.child1)) {
            let target = ptr_to_node(n.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR and target.s1.equals(name)) {
                if (nodeProducesOwnedValue(n.child2) == false) { return true }
            }
        }
    }

    if (chainAssignsUnowned(n.child1, name)) { return true }
    if (chainAssignsUnowned(n.child2, name)) { return true }
    return chainAssignsUnowned(n.child3, name)
}

private fn chainAssignsUnowned(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeAssignsUnowned(p, name)) { return true }
        p = n.next
    }
    return false
}

// Whether `name` is a binding whose slot holds memory it owns at every point.
//
// Two questions: it is reassigned at all -- otherwise nothing here changes -- and
// every value it receives is one this scope owns, because a release that displaces
// a borrow frees a value someone else still holds. The declaration's own
// initialiser is the caller's to ask, because only the caller has it.
//
// **There was a third, and the language had already answered it.** A value moved
// into a second binding -- `let t = s` -- has an owner the model cannot see, since
// an identifier initialiser registers no site, so releasing at the next `s = ...`
// would free what `t` names. That guard was written and then deleted: sema rejects
// assigning to a moved binding at all ("use of moved value"), in the loop form and
// the straight-line form both, so the shape never reaches codegen. Deleting it is
// worth more than keeping it, because a guard that cannot fire reads like a
// hazard that has been handled.
internal fn irOwningAccumulator(name: String) -> Bool {
    if (chainAssignsName(irFunctionBody, name) == false) { return false }
    return chainAssignsUnowned(irFunctionBody, name) == false
}

// Whether `name` is ever returned from the function being generated.
//
// Only asked of a binding made droppable by aif_owns_call_result_at_node, and it
// is the guard the escape fact supplies for every other droppable binding: for a
// value allocated *here*, `return x` raises E to Caller and the drop predicate
// declines. A value allocated in a callee is already at Caller, so that test says
// nothing and this has to say it instead.
//
// Syntactic and blunt for the same reason nodeAssignsName is -- codegen is a
// forward walk, and a `return` written above the binding's last use still runs
// after it.
private fn nodeReturnsName(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.RETURN_STATEMENT) {
        if (nodeExists(n.child1)) {
            let value = ptr_to_node(n.child1)
            if (value.kind == NodeKind.IDENTIFIER_EXPR and value.s1.equals(name)) {
                return true
            }
        }
    }

    if (chainReturnsName(n.child1, name)) { return true }
    if (chainReturnsName(n.child2, name)) { return true }
    return chainReturnsName(n.child3, name)
}

internal fn chainReturnsName(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeReturnsName(p, name)) { return true }
        p = n.next
    }
    return false
}

// Whether `name`'s allocation leaves this frame through some *other* value.
//
// The second half of nodeReturnsName, and the reason that one alone was not
// enough. Both exist because E cannot answer for a callee-allocated value: it is
// already Caller, so `return` raises nothing and the escape fact stays silent.
// nodeReturnsName supplies the syntactic guard for `return t`; this supplies it
// for the same allocation leaving through somebody else's return --
//
//     let t = band(1)          // droppable by aif_owns_call_result_at_node
//     let x = passthru(t)      // x aliases t's allocation
//     return x                 // and the drop at this scope's exit frees it
//
// which segfaulted rather than leaked (tests/test_85_passthrough_escape.psm).
// The container and global routes out of the frame need nothing here:
// `retain_in` raises `in_container` on the site and aif_owns_call_result_at_node
// already declines on it.
//
// **Driven from the `return`, not from the argument**, and the difference is
// precision rather than taste. "Is `name` ever passed to a callee that may hand
// a parameter back" is the cheaper question and it is the wrong one: it declines
// `let same = identity(items)` in test_47_aif_containers, where the alias never
// leaves the frame and `items` is this scope's to drop. Asking which values
// reach a `return` keeps that drop and still refuses the one above.
private fn nodeEscapesThroughCall(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.RETURN_STATEMENT) {
        if (nodeExists(n.child1)) {
            if (irValueAliasesName(n.child1, name, 0)) { return true }
        }
    }

    if (chainEscapesThroughCall(n.child1, name)) { return true }
    if (chainEscapesThroughCall(n.child2, name)) { return true }
    return chainEscapesThroughCall(n.child3, name)
}

internal fn chainEscapesThroughCall(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeEscapesThroughCall(p, name)) { return true }
        p = n.next
    }
    return false
}

// Whether the value `exprPtr` denotes may be the allocation `name` holds.
//
// Two expression kinds can carry it and the rest cannot. An identifier is either
// `name` or a binding that may have been given it; a call hands a parameter back
// only where aif_fn_may_return_param says so. Everything else -- arithmetic, a
// field read, a slice, a literal -- either yields a different allocation or
// yields a view, and views are the value set's own business (SPEC 8.4) rather
// than this walk's.
//
// `hops` bounds the chase through bindings, and running out answers **true**:
// the cap is a limit on how much this is willing to prove, so it has to fail
// towards the leak. Eight is far past anything in the tree; the deepest real
// chain is two.
// Whether this call's callee is an `extern fn` whose return is declared `alias`.
//
// FFI 5.2: `alias` names no argument, so the result may be any of them -- which
// is exactly the answer irValueAliasesName needs, since it goes on to ask
// whether any argument carries `name`. Read from the declaration rather than
// inferred; nothing is assumed about an extern that did not say this.
private fn irCallReturnsAlias(e: ASTNode) -> Bool {
    if (e.s2.equals("") == false) {
        return aif_extern_contract(e.s2, 0 - 1).equals("alias")
    }
    if (nodeIsNull(e.child1)) { return false }
    return aif_extern_contract(ptr_to_node(e.child1).s1, 0 - 1).equals("alias")
}

private fn irValueAliasesName(exprPtr: Ptr, name: String, hops: Int) -> Bool {
    if (nodeIsNull(exprPtr)) { return false }
    if (hops > 8) { return true }
    let e = ptr_to_node(exprPtr)

    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        if (e.s1.equals(name)) { return true }
        return chainBindingAliasesName(irFunctionBody, e.s1, name, hops + 1)
    }

    if (e.kind == NodeKind.CALL_EXPR) {
        // s2 is the mangled symbol sema resolved the call to, which is the
        // identity aif_fn_lookup is keyed on. An extern is not one of those and
        // the predicate answers no for it -- see the comment on
        // aif_fn_may_return_param for why widening there is untrue and costly.
        //
        // **A declared `alias` is the exception, and it is not that widening.**
        // The hazard this whole walk exists for reaches the FFI boundary
        // unchanged: `let t = make(); let x = <extern alias>(t); return x` freed
        // `t` at the scope exit and handed the caller the same pointer, which
        // `--verify` reports as `release of a pointer that is not live`. It is
        // the shape in the comment above, one callee kind further out.
        //
        // The distinction that makes this safe is the one fn_may_return_param
        // draws: **a declared `alias` is a stated fact about one function, and an
        // unknown symbol is an abstention about all of them.** Answering yes for
        // every unknown extern was measured and declines the drop at every
        // `print(value)` in std/io.psm, because `prismio_rt_print(text)` is
        // declared `borrow`. Reading the declaration costs nothing anywhere it
        // was not written.
        if (aif_fn_may_return_param(e.s2) == 0 and irCallReturnsAlias(e) == false) {
            return false
        }
        let mut aPtr = e.child2
        while (nodeExists(aPtr)) {
            if (irValueAliasesName(aPtr, name, hops + 1)) { return true }
            aPtr = ptr_to_node(aPtr).next
        }
        return false
    }

    return false
}

// Whether any value ever written into `boundName` may be `name`'s allocation.
//
// Both the declaration and every assignment, because a binding reassigned in a
// loop -- `out = identity(t)` -- carries the alias just as its `let` would.
private fn nodeBindingAliasesName(nodePtr: Ptr, boundName: String, name: String, hops: Int) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.VARIABLE_DECL and n.s1.equals(boundName)) {
        if (irValueAliasesName(n.child2, name, hops)) { return true }
    }

    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
        let target = ptr_to_node(n.child1)
        if (target.kind == NodeKind.IDENTIFIER_EXPR and target.s1.equals(boundName)) {
            if (irValueAliasesName(n.child2, name, hops)) { return true }
        }
    }

    if (chainBindingAliasesName(n.child1, boundName, name, hops)) { return true }
    if (chainBindingAliasesName(n.child2, boundName, name, hops)) { return true }
    return chainBindingAliasesName(n.child3, boundName, name, hops)
}

private fn chainBindingAliasesName(head: Ptr, boundName: String, name: String, hops: Int) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeBindingAliasesName(p, boundName, name, hops)) { return true }
        p = n.next
    }
    return false
}

// An owned call result consumed directly as an argument, which is the one shape
// with no binding to hang a drop on.
//
// `aif_owns_call_result_at_node` answers the ownership question wherever it is
// asked, and until this existed codegen only asked it at a **binding** --
// VARIABLE_DECL and assignment, in src/ir/stmt.psm. `simulate(band(...))` never
// binds, so nothing asked and nothing dropped: one `let` was the whole
// difference between 27/27/0 and 107/27/80 on
// tests/owned_temporary_argument.psm.
//
// The same predicate is the guard as well as the trigger. A callee that retains
// the value has already raised `in_container` or `site_in_released_field` on the
// site, and this declines on both -- which is why `list_push(l, band(...))` gets
// no release here even though it is exactly the shape that would double-free.
private fn irArgumentIsOwnedTemporary(argNode: ASTNode) -> Bool {
    if (argNode.kind != NodeKind.CALL_EXPR) { return false }
    return aif_owns_call_result_at_node(node_to_ptr(argNode)) != AIF_ELEM_NONE
}

private fn irOwnedTemporaryKind(argNode: ASTNode) -> Int {
    let owned = aif_owns_call_result_at_node(node_to_ptr(argNode))
    if (nodeGetType(argNode).kind == TypeKind.DATAVIEW) { return IR_DROP_DATAVIEW }
    if (owned == AIF_ELEM_LIST) { return IR_DROP_LIST }
    if (owned == AIF_ELEM_TYPED) { return IR_DROP_TYPED }
    return IR_DROP_OBJECT
}

// Released after the enclosing call returns, never before it: the callee borrows
// the argument for the duration of the call, which is Swift's `@guaranteed`
// convention and the one Prismio has -- a parameter is a borrow, and sema
// refuses to let a callee move one into a container ("cannot move out of
// borrowed value"). So the caller is the last owner and this is its release
// point.
private fn generateOwnedTemporaryReleases(vals: List<String>, kinds: List<Int>, types: List<String>) {
    let mut i = 0
    while (i < list_len(vals)) {
        let value: String = list_get(vals, i)
        let kind: Int = list_get(kinds, i)
        let declType: String = list_get(types, i)
        if (kind == IR_DROP_LIST) {
            ir_free_list(value)
        } else if (kind == IR_DROP_DATAVIEW) {
            ir_free_data_view(value)
        } else if (kind == IR_DROP_TYPED) {
            ir_free_typed(value, releaseFnName(structTypeName(declType)))
        } else {
            ir_free_object(value)
        }
        i = i + 1
    }
}

// Whether `name` is ever the whole initialiser of another binding -- `let u = t`.
//
// Asked only of a task handle. Every other droppable binding gets this for free:
// an identifier initialiser registers no site, so the second binding is not
// droppable and the first one's own entry still owns the value. A task handle is
// droppable because of the *spawn*, not because of a site, so that reasoning does
// not reach it and the copy has to be excluded by name. `test_69`'s
// `result_type_survives_a_binding` is the shape, and it is in the suite.
private fn nodeCopiesName(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.VARIABLE_DECL and nodeExists(n.child2)) {
        let init = ptr_to_node(n.child2)
        if (init.kind == NodeKind.IDENTIFIER_EXPR and init.s1.equals(name)) {
            return true
        }
    }

    if (chainCopiesName(n.child1, name)) { return true }
    if (chainCopiesName(n.child2, name)) { return true }
    return chainCopiesName(n.child3, name)
}

internal fn chainCopiesName(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeCopiesName(p, name)) { return true }
        p = n.next
    }
    return false
}

// Whether this function body explicitly frees `name` with `drop(name)`.
//
// The binding half of what `no_stack` used to answer for the whole site. A site
// is shared -- every `concat` result in the program comes from the one
// `str_with_capacity` inside it -- so "was this value explicitly dropped" cannot
// be asked of the site without answering for every other binding that shares it.
// It is asked of the name instead, in the same shape as chainAssignsName and
// chainReturnsName above, and for the same reason: the drop list is keyed by name
// within one function body, so a name is exactly the granularity available here.
//
// Only a direct `drop(name)` counts. An aliased binding that is dropped under
// another name keeps its scope release, which is the conservative direction:
// a missed suppression is a double free and a missed drop is a leak, so this
// fails towards the leak the way irValueAliasesName's hop cap does.
private fn nodeDropsName(nodePtr: Ptr, name: String) -> Bool {
    if (nodeIsNull(nodePtr)) { return false }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(n.child1)
        if (callee.kind == NodeKind.IDENTIFIER_EXPR and callee.s1.equals("drop")) {
            let mut argPtr = n.child2
            while (nodeExists(argPtr)) {
                let arg = ptr_to_node(argPtr)
                if (arg.kind == NodeKind.IDENTIFIER_EXPR and arg.s1.equals(name)) {
                    return true
                }
                argPtr = arg.next
            }
        }
    }

    if (chainDropsName(n.child1, name)) { return true }
    if (chainDropsName(n.child2, name)) { return true }
    return chainDropsName(n.child3, name)
}

internal fn chainDropsName(head: Ptr, name: String) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (nodeDropsName(p, name)) { return true }
        p = n.next
    }
    return false
}

// The initialisers of a struct literal, written into an object that already
// exists. Split out so an inline field can be built *in place*: its bytes belong
// to the enclosing object, so `Node { local: Transform { .. } }` writes the
// Transform's fields straight into Node's storage and allocates nothing for it.
//
// Without that, the nested literal allocates, gets copied in, and is abandoned
// -- the copy having taken ownership of nothing. That is 22 leaked allocations
// in test_49 and it is the whole reason inlining has to reach construction and
// not only layout.
// ---------------------------------------------------------------------------
// LAYOUT 2.1 -- profile instrumentation
//
// `ir_struct_field_ptr` is to field access what `ir_alloc_object` is to
// allocation: every read and every write of a struct field computes its address
// through it, so counting beside it counts everything and cannot drift.
//
// It is called *beside* rather than *inside*, and the reason is the one thing
// the backend cannot supply. A GEP is the same instruction for a read and for a
// write; only the caller knows which it is, and `read(f)`/`write(f)` are separate
// columns in LAYOUT 2.1 because the cost model needs them separately -- a
// write-only field in a traversal costs a store, not a load, and the hot/cold cut
// reads the sum. Pushing the distinction into the backend would mean passing it
// down anyway, through a parameter every other caller would have to answer.
//
// The two generated walks -- __aif_release_T and __aif_cyclic_children_T -- call
// ir_struct_field_ptr too and are deliberately NOT instrumented. They are the
// memory model's own traffic, not the program's, and counting them would let the
// layout decision be driven by the cost of the layout decision.
internal fn irProfileField(structName: String, fieldName: String, isWrite: Bool) {
    if (irProfileMode == false) { return }
    let tyName = ir_get_temp_name(ir_const_cstring(structName))
    let fName = ir_get_temp_name(ir_const_cstring(fieldName))
    ir_call_begin()
    ir_call_arg("ptr", tyName)
    ir_call_arg("ptr", fName)
    if (isWrite) {
        ir_call_arg("i32", "1")
    } else {
        ir_call_arg("i32", "0")
    }
    ir_call_end("void", "rt_profile_field")
}

// LAYOUT 2.1's `range(f)`, recorded on writes only -- a read observes a value
// some write already put there, so counting reads would weight the range by how
// often a field is looked at rather than by what it can hold.
//
// Integer fields only, which is what the table says ("observed value range, for
// integer fields"). A Float has no bit-packing story here and a pointer's range
// is an address, which is not a fact about the program.
internal fn irProfileRange(structName: String, fieldName: String, fieldType: String, value: String) {
    if (irProfileMode == false) { return }
    if (irTypeIsProfilableInt(fieldType) == false) { return }
    let tyName = ir_get_temp_name(ir_const_cstring(structName))
    let fName = ir_get_temp_name(ir_const_cstring(fieldName))
    // Widened to i64 so one runtime entry point takes every integer width. Signed
    // extension, because a negative value has to stay negative: recording -1 as
    // 4294967295 would make the observed range span the whole word and decline a
    // packing that is in fact available.
    let mut wide = value
    if (fieldType.equals("i64") == false) {
        wide = ir_get_temp_name(ir_sext(fieldType, value, "i64"))
    }
    ir_call_begin()
    ir_call_arg("ptr", tyName)
    ir_call_arg("ptr", fName)
    ir_call_arg("i64", wide)
    ir_call_end("void", "rt_profile_range")
}

private fn irProfileAlloc(structName: String) {
    if (irProfileMode == false) { return }
    ir_call_begin()
    ir_call_arg("ptr", ir_get_temp_name(ir_const_cstring(structName)))
    ir_call_end("void", "rt_profile_alloc")
}

private fn irTypeIsProfilableInt(t: String) -> Bool {
    if (t.equals("i8")) { return true }
    if (t.equals("i16")) { return true }
    if (t.equals("i32")) { return true }
    if (t.equals("i64")) { return true }
    return false
}

// M4.2. Tell a freshly constructed list to store its elements inline, when the
// element type's layout allows it.
//
// The element type is the constructing expression's own, which is the annotated
// binding's when there is one and `List<Invalid>` when there is not. A list the
// stamp misses is not lost: the push entry points stamp lazily while the list is
// still empty, and they read the same static type this does -- so the two can
// only agree.
// The element size a container stores inline for this type, or 0 when the
// type's layout forbids it. One place, so the stamp, the push slot and every
// access cannot disagree about which types are inline -- a disagreement would
// read a body as a pointer.
private fn inlineElemSize(typeName: String) -> Int {
    if (typeName.equals("")) { return 0 }
    if (ir_struct_is_flat(typeName) == 0) { return 0 }
    // A counted element cannot be inline: the count lives in a header in front
    // of the object and an inline body has neither header nor identity. See
    // aif_type_is_counted in runtime/aif_support.c, and test_48.
    if (aif_type_is_counted(typeName) == 1) { return 0 }
    return ir_struct_size(typeName)
}

// The inline element size of the list this expression denotes, or 0.
//
// **The list's own static type, at every site, and nothing else.** The stamp and
// the accesses have to agree, and the one fact both can read is the type sema
// gave the list expression: a `List<T>` reached through an identifier, a field
// or a call all carry it, and a `list_new()` with no annotation carries
// `List<Invalid>` at *every* site rather than at some of them. Deciding from the
// pushed value's type instead would be a list that one site thinks is inline and
// another does not, which is the one way this can corrupt memory rather than
// merely lose the optimisation.
private fn inlineElemSizeOfList(listExpr: ASTNode) -> Int {
    if (nodeHasType(listExpr) == false) { return 0 }
    let lt = nodeGetType(listExpr)
    if (lt.kind != TypeKind.LIST) { return 0 }
    if (nodeIsNull(lt.child)) { return 0 }
    let ekey = typeIrKey(ptr_to_type(lt.child))
    // A scalar element is inline too, and used not to be. `isStructTypeKey`
    // alone meant `List<Bool>` and `List<Int>` never reached this path at all --
    // not declined, unreached -- so both spent a pointer slot per element.
    // Measured at 4,000,000 elements: 64.0 MB against 9.2 MB for the same data
    // as a one-field struct, which passed the predicate only because it was one.
    // See aif/evidence/RESULTS-scalar-list-storage.md.
    if (isStructTypeKey(ekey) == false) { return scalarInlineBytes(ekey) }
    return inlineElemSize(structTypeName(ekey))
}

private fn inlineElemSizeOfSlice(sliceExpr: ASTNode) -> Int {
    if (nodeHasType(sliceExpr) == false) { return 0 }
    let st = nodeGetType(sliceExpr)
    if (st.kind != TypeKind.SLICE or nodeIsNull(st.child)) { return 0 }
    let ekey = typeIrKey(ptr_to_type(st.child))
    // **A slice views the list's own block, so this must agree with
    // inlineElemSizeOfList exactly.** Leaving scalars out here while the list
    // put them inline is not a lost optimisation but corruption: `list_get`
    // ignores `elem_size` and returns `l->data[index]`, so a boxed slice read
    // over a flat row hands back the first eight bytes of the row as a pointer.
    if (isStructTypeKey(ekey) == false) { return scalarInlineBytes(ekey) }
    if (isValueStructKey(ekey)) { return 0 }
    return inlineElemSize(structTypeName(ekey))
}

// The same question asked of a container call's first argument, which is the
// list for all four of `list_get`, `list_set`, `list_push` and `list_len`.
// Does this call cross into C?
//
// The answer decides marshalling: a `String` is `{ptr, i64}` inside Prismio and a
// bare `const char*` to C, so an argument crossing out is an `extractvalue` and a
// result crossing in has to be given a length. Both sides of that are wrong if
// this is wrong -- a fat value handed to a C function reads its length as the
// pointer.
//
// Read from the declaration index rather than a separate registry, because the
// index is already built (indexModuleDeclarations) and a second table is a second
// thing to keep in step.
// Does Prismio define this function itself?
//
// The complement of callIsExtern, and the one that actually decides inbound
// marshalling: a Prismio function returns the fat `{ptr, i64}`, while *everything
// else* -- a C extern, and equally the runtime builtins codegen calls by name
// like `list_get` -- returns a bare pointer that has to be given a length. Asking
// "is it extern" missed the builtins, which is a `trunc i64 to %prismio.str`.
// Give a bare `const char*` a length, producing the fat `{ptr, i64}`.
//
// Every place a String crosses in from somewhere that does not carry one: a C
// return, a container slot, a struct field. One `strlen` at the boundary, where
// the thin representation paid one per access.
//
// `prismio_cstr_len` rather than `__builtin_string_len`, which requires a fat
// String while this boundary has only the raw pointer.
internal fn fatFromPtr(raw: String) -> String {
    ir_call_begin()
    ir_call_arg("ptr", raw)
    let len = ir_get_temp_name(ir_call_end("i32", "prismio_cstr_len"))
    return fatWithLength(raw, len)
}

// The pair, from a pointer and a length the caller already knows -- no `strlen`.
//
// Separate from fatFromPtr because measuring is exactly what the caller with a
// length must not do: `str_with_capacity` returns a buffer whose interior is
// uninitialised, so a `prismio_cstr_len` on it reads a length out of whatever
// the allocator last left there.
private fn fatWithLength(raw: String, len: String) -> String {
    let wide = ir_get_temp_name(ir_sext("i32", len, "i64"))
    let u = ir_get_temp_name(ir_undef("struct:prismio.str"))
    let withPtr = ir_get_temp_name(ir_insert_value("struct:prismio.str", u, raw, "ptr", 0))
    return ir_get_temp_name(ir_insert_value("struct:prismio.str", withPtr, wide, "i64", 1))
}

private fn callIsPrismioFn(funcName: String) -> Bool {
    let n = ir_decl_count(funcName)
    let mut i = 0
    while (i < n) {
        let decl = ptr_to_node(ir_decl_at(funcName, i))
        if (decl.kind == NodeKind.FUNCTION) { return true }
        i = i + 1
    }
    return false
}

private fn callIsExtern(funcName: String) -> Bool {
    let n = ir_decl_count(funcName)
    let mut i = 0
    while (i < n) {
        let decl = ptr_to_node(ir_decl_at(funcName, i))
        if (decl.kind == NodeKind.EXTERN_FUNCTION) { return true }
        i = i + 1
    }
    return false
}

private fn inlineElemSizeOfCall(expr: ASTNode) -> Int {
    if (nodeIsNull(expr.child2)) { return 0 }
    return inlineElemSizeOfList(ptr_to_node(expr.child2))
}

// Whether this subtree's inline-body `list_get`s can all share one hoisted
// representation guard, and how many there are: -1 declines, otherwise the
// count. Statically boxed accesses are permitted but not counted: their typed
// lowering reloads the current header at the use and needs no dynamic stamp.
//
// Recursive over child1/child2/child3 through the chain walker, the same shape
// as nodeAssignsName above. **This must not follow its own `.next`** -- doing
// that as well as in the chain walker visits the tail of a k-node chain 2^k
// times, which took test_43_aif_scope_drop.psm from 0.2s to over 90s of
// 100%-CPU compile before it was caught.
//
// **Counts rather than collecting.** A `List` of receivers is the obvious way to
// write this and it puts two `list_new` sites in the compiler whose escape the
// analysis cannot bound through the recursion, so they land T3 and the compiler
// grows an `rc_alloc` -- which `run_aif_rc_test` exists to refuse, because every
// T3 site in this codebase is an opaque extern return and a refcount header in
// front of one is memory nobody allocated. Walking twice is cheaper than
// allocating once here.
private fn irFlatGuardCount(nodePtr: Ptr) -> Int {
    if (nodeIsNull(nodePtr)) { return 0 }
    let n = ptr_to_node(nodePtr)

    let mut found = 0
    if (n.kind == NodeKind.CALL_EXPR) {
        let mut fname = ""
        if (nodeExists(n.child1)) { fname = ptr_to_node(n.child1).s1 }
        let stride = flatGetStride(n, fname)
        if (stride > 0) {
            // The receiver is evaluated a second time in the preheader, so it has
            // to be something evaluating twice cannot change: a name, or a field
            // read off one. `w.velocities` is the shape every corpus loop uses.
            if (irIsPureReceiver(ptr_to_node(n.child2)) == false) { return 0 - 1 }
            found = 1
        } else if (isStaticBoxedListGet(n, fname)) {
            // The typed boxed accessor reloads the current header at its site,
            // so it needs no representation guard and does not make an
            // otherwise-flat loop ineligible for its shared guard.
            found = 0
        } else {
            // **Any other call declines the whole loop.** It could push to one of
            // these lists -- which reallocates the element block -- or free it,
            // and neither is answerable from the element type. This is what keeps
            // g2 and g6, whose loops call out, on the runtime path.
            return 0 - 1
        }
    }

    let a = irFlatGuardCountChain(n.child1)
    if (a < 0) { return 0 - 1 }
    let b = irFlatGuardCountChain(n.child2)
    if (b < 0) { return 0 - 1 }
    let c = irFlatGuardCountChain(n.child3)
    if (c < 0) { return 0 - 1 }
    return found + a + b + c
}

private fn irFlatGuardCountChain(head: Ptr) -> Int {
    let mut total = 0
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        let one = irFlatGuardCount(node_to_ptr(n))
        if (one < 0) { return 0 - 1 }
        total = total + one
        p = n.next
    }
    return total
}

private fn irIsPureReceiver(recv: ASTNode) -> Bool {
    if (recv.kind == NodeKind.IDENTIFIER_EXPR) { return true }
    if (recv.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        if (nodeIsNull(recv.child1)) { return false }
        return irIsPureReceiver(ptr_to_node(recv.child1))
    }
    return false
}

// The second walk: fold each inline-body receiver's `elem_size == stride`
// predicate into the slot. The slot is the accumulator, which is what removes
// the need to hold the receivers anywhere -- mem2reg turns the load/and/store
// chain back into one `and` tree in the preheader.
private fn irEmitFlatGuards(nodePtr: Ptr, slot: String) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)

    if (n.kind == NodeKind.CALL_EXPR) {
        let mut fname = ""
        if (nodeExists(n.child1)) { fname = ptr_to_node(n.child1).s1 }
        let stride = flatGetStride(n, fname)
        if (stride > 0) {
            let recvNode = ptr_to_node(n.child2)
            let one = ir_get_temp_name(ir_list_is_flat(
                generateExpression(recvNode), stride))
            let prev = ir_get_temp_name(ir_load("i1", slot))
            ir_store("i1", ir_get_temp_name(ir_and("i1", prev, one)), slot)
        }
    }

    irEmitFlatGuardsChain(n.child1, slot)
    irEmitFlatGuardsChain(n.child2, slot)
    irEmitFlatGuardsChain(n.child3, slot)
}

private fn irEmitFlatGuardsChain(head: Ptr, slot: String) {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        irEmitFlatGuards(node_to_ptr(n), slot)
        p = n.next
    }
}

// The loop's one flat-List guard, emitted into the preheader, or "" for a loop
// this declines to serve.
//
// **One `i1` for the loop, not one test per site.** LLVM will not clone a loop
// for 2^n independent invariant conditions; measured on g4_tuned's five-list
// fused loop it versions on one and leaves the rest per iteration, which cost
// 0.0022 -> 0.0029 ms/frame. The conjunction is the fact Prismio has and LLVM
// does not: every receiver in the loop, seen at once.
//
// Conservative in one direction only. If the guard is false at run time every
// site takes `list_get_inline`, which is exactly what they did before.
internal fn generateLoopFlatGuard(body: ASTNode) -> String {
    if (irFlatGuardCount(node_to_ptr(body)) <= 0) { return "" }

    let name = "flatguard.".concat(strFromInt(irLoopFlatGuardCounter))
    irLoopFlatGuardCounter = irLoopFlatGuardCounter + 1
    ir_set_var_type(name, "Bool")
    let slot = ir_get_var_slot(name)
    ir_alloca("i1", slot)
    ir_store("i1", "true", slot)
    irEmitFlatGuards(node_to_ptr(body), slot)
    return slot
}

// Whether this is a two-argument `list_get` on a statically known List. The
// element may still be `Invalid`: such a list can never be stamped inline, so
// its stable representation is the ordinary pointer-slot form.
private fn isTypedListGet(expr: ASTNode, funcName: String) -> Bool {
    if (funcName.equals("list_get") == false) { return false }
    if (nodeIsNull(expr.child2)) { return false }
    let listNode = ptr_to_node(expr.child2)
    if (nodeIsNull(listNode.next)) { return false }
    if (nodeExists(ptr_to_node(listNode.next).next)) { return false }
    if (nodeHasType(listNode) == false) { return false }
    return nodeGetType(listNode).kind == TypeKind.LIST
}

// A pointer-slot representation selected completely by the static element
// type. Invalid/inferred-later element types stay on the generic runtime path;
// they are the case where two call sites might not agree on representation.
private fn isStaticBoxedListGet(expr: ASTNode, funcName: String) -> Bool {
    if (isTypedListGet(expr, funcName) == false) { return false }
    let listNode = ptr_to_node(expr.child2)
    let lt = nodeGetType(listNode)
    if (nodeIsNull(lt.child)) { return false }
    if (ptr_to_type(lt.child).kind == TypeKind.INVALID) { return false }
    return inlineElemSizeOfList(listNode) == 0
}

// The static inline-body stride of a `list_get(l, i)` this can serve, or 0 for
// the pointer-slot representation.
//
// Narrow on purpose, and the narrowness is the first slice rather than a
// simplification to widen later. `list_set` writes through the pointer this
// already returns, so g4's four systems are covered by the read; a slice, a
// nested list and a receiver a call in the same loop can reallocate are all
// still the runtime's, because none of them is answered by the element type
// alone.
private fn flatGetStride(expr: ASTNode, funcName: String) -> Int {
    if (isTypedListGet(expr, funcName) == false) { return 0 }
    let listNode = ptr_to_node(expr.child2)
    return inlineElemSizeOfList(listNode)
}

// M4.2's destination-passing push: `list_push(l, T { ... })` builds the element
// **in the list**, so the push allocates nothing and copies nothing. Five of the
// six corpus programs push exactly this shape, and it is what turned inline
// storage from 1.19x slower than boxing on the frame-loop programs into faster.
//
// True when it emitted the call itself.
private fn generatePushInPlace(expr: ASTNode, funcName: String) -> Bool {
    if (funcName.equals("list_push") == false) { return false }
    if (nodeIsNull(expr.child2)) { return false }
    let listNode = ptr_to_node(expr.child2)
    if (nodeIsNull(listNode.next)) { return false }
    let valueNode = ptr_to_node(listNode.next)
    if (valueNode.kind != NodeKind.STRUCT_LITERAL_EXPR) { return false }

    let esize = inlineElemSizeOfList(listNode)
    if (esize <= 0) { return false }

    let listVal = generateExpression(listNode)
    // **The slot comes from `list_push_slot`, and an inline fast path was tried
    // and rejected here.** Emitting `if (elem_size == S && len < cap)` plus the
    // address arithmetic removes the call -- which is what Rust's inlined
    // `Vec::push` does, and it is worth 0.97x on g2's cull loop, which pushes
    // ~500 elements into one list. It costs **1.16x on g6**, whose `plan_orders`
    // builds a fresh short-lived list per squad per frame: almost every push is a
    // growth, so the check is paid and never wins. Gating on loop depth does not
    // separate the two -- both pushes are in loops. See
    // aif/evidence/RESULTS-inline-push-rejected.md.
    ir_call_begin()
    ir_call_arg("ptr", listVal)
    ir_call_arg("i32", strFromInt(esize))
    let slot = ir_get_temp_name(ir_call_end("ptr", "list_push_slot"))
    generateStructLiteralFields(valueNode, valueNode.s1, slot)
    return true
}

// Which runtime op serves this container call. The inline family is a separate
// set of entry points rather than a branch inside the boxed ones: the element
// type is static at every site, so the branch belongs here -- and a version that
// put it in `list_get` and `list_push` instead measured **1.159x on the corpus
// with no list inline at all**. See the note on `elem_size` in
// runtime/lang_runtime.c.
private fn inlineOpName(funcName: String) -> String {
    if (funcName.equals("list_get")) { return "list_get_inline" }
    if (funcName.equals("list_set")) { return "list_set_inline" }
    if (funcName.equals("list_push")) { return "list_push_inline" }
    return ""
}

// A scalar in a stack slot, so an inline container op has an address to copy
// from. One alloca per call site; LLVM's SROA removes it wherever the copy is
// visible, which on the push loops it is.
//
// **Handing a stack address to list_push_inline is safe only because a scalar
// list owns nothing**: both inline entry points end in `list_release_source`,
// which would hand `e` to a deallocator for any `elem_own` other than
// AIF_ELEM_NONE. A scalar registers no site, so its list is told NONE and the
// call returns before touching it. That is an inherited invariant rather than a
// new one -- the boxed path already passes the scalar *punned into* a pointer to
// the same function, and has always relied on the same answer.
// A scalar widened to the i64 the by-value inline entry points take.
//
// A `double` goes through a bitcast rather than a conversion: the callee stores
// the 64 bits back under the element's own width, so what has to survive is the
// pattern and not the number. `fptoui` here would round a double to an integer
// and store that.
private fn scalarToInlineBits(storeType: String, value: String) -> String {
    if (storeType.equals("double")) {
        return ir_get_temp_name(ir_bitcast("double", value, "i64"))
    }
    if (storeType.equals("i64")) { return value }
    return ir_get_temp_name(ir_zext(storeType, value, "i64"))
}

// The inverse of scalarToInlineBits: the i64 an inline scalar read returns,
// back under the element's own width.
private fn scalarFromInlineBits(storeType: String, bits: String) -> String {
    if (storeType.equals("double")) {
        return ir_get_temp_name(ir_bitcast("i64", bits, "double"))
    }
    if (storeType.equals("i64")) { return bits }
    return ir_get_temp_name(ir_trunc("i64", bits, storeType))
}

private fn scalarSpillToSlot(storeType: String, value: String) -> String {
    let slot = "elem.".concat(strFromInt(irElemSpillCounter))
    irElemSpillCounter = irElemSpillCounter + 1
    ir_alloca(storeType, slot)
    ir_store(storeType, value, slot)
    // `%name` is how resolve_value in the backend names an alloca as a *value*:
    // it looks the bare name up among the params and then the allocas. Handing
    // it the undecorated name instead falls through to const_from_text, which
    // fails the build with "non-null pointer constant".
    return "%".concat(slot)
}

private fn generateElemInlineStamp(expr: ASTNode, funcName: String, result: String) {
    if (funcName.equals("list_new") == false
        and funcName.equals("list_new_with_capacity") == false) {
        return
    }

    let esize = inlineElemSizeOfList(expr)
    if (esize <= 0) { return }

    ir_call_begin()
    ir_call_arg("ptr", result)
    ir_call_arg("i32", strFromInt(esize))
    ir_call_end("void", "list_set_elem_inline")
}

private fn generateStructLiteralFields(expr: ASTNode, structName: String, destPtr: String) {
    let mut fieldPtr = expr.child1
    while (nodeExists(fieldPtr)) {
        let field = ptr_to_node(fieldPtr)
        let fieldType = fieldStorageType(ir_get_struct_field_type(structName, field.s1))
        let fieldIndex = ir_get_struct_field_index(structName, field.s1)

        if (isStructTypeKey(fieldType) and isValueStructKey(fieldType) == false) {
            let slot = ir_struct_field_ptr(structName, destPtr, fieldIndex)
            let init = ptr_to_node(field.child1)
            let innerName = structTypeName(fieldType)
            if (init.kind == NodeKind.STRUCT_LITERAL_EXPR) {
                generateStructLiteralFields(init, innerName, ir_get_temp_name(slot))
            } else {
                // An inline field is the object's own storage, so this **copies**
                // and the source keeps whatever ownership it had. Where the source
                // is a call whose result the callee handed over, that ownership is
                // ours and nothing else will ever name it -- so it is freed here or
                // not at all.
                //
                // This is g3's residue: `Node { world: identity_transform(), ... }`
                // allocated a Transform, copied six floats out of it and dropped
                // the pointer on the floor, 2730 times. A binding gets the same
                // treatment one level up, through ir_mark_droppable; an expression
                // has no binding to hang it on and needs saying here.
                let src = generateExpression(init)
                ir_copy_struct(innerName, ir_get_temp_name(slot), src)
                let owned = aif_owns_call_result_at_node(node_to_ptr(init))
                if (owned == AIF_ELEM_TYPED) {
                    ir_free_typed(src, releaseFnName(innerName))
                } else if (owned != AIF_ELEM_NONE) {
                    ir_free_object(src)
                }
            }
        } else {
            let fieldVal = generateExpression(ptr_to_node(field.child1))
            let slot = ir_struct_field_ptr(structName, destPtr, fieldIndex)
            // CYCLES 3. A cyclic edge is an edge the collector *traverses*, so it
            // has to be one the count knows about -- trial deletion subtracts
            // internal edges and reads the remainder as "held from outside". No
            // release of the old value here: the field is uninitialised.
            if (aif_field_is_counted(structName, field.s1) == 1) {
                ir_call_begin()
                ir_call_arg("ptr", fieldVal)
                ir_call_end("void", "cyc_retain")
            }
            // A literal's field initialiser is a write, and it is the write that
            // establishes the value range every later read observes.
            irProfileField(structName, field.s1, true)
            irProfileRange(structName, field.s1, fieldType, fieldVal)
            // M6 slice 2 stops here, and the reason is measured. A struct path on
            // an initialiser tells LLVM these stores cannot alias the fields the
            // literal is being built *from*, which lets it merge them into one
            // wide store. That merge is a win when it can see the destination and
            // a 1.68x loss on g2 when it cannot: every struct literal pushed into
            // a container is written into a slot handed back by `list_push_slot`,
            // whose next call reloads the same `RtList` header, and the widened
            // store costs ~6 cycles per element against that reload.
            // `aif/evidence/RESULTS-M6-struct-path-tbaa.md` isolates it to that
            // one interaction -- the same merge measures **0.76x** when the slot
            // is computed inline -- and names curating `list_push_slot` as the
            // fix. Until that seam closes, an initialiser keeps slice 1's scalar
            // tags. Field *reads* and field *assignments* keep their paths, which
            // is where the whole measured prize is: declining only initialisers
            // leaves g1, g3, g4, g5, g6 and g9 mnemonic-identical to the full
            // slice and returns g2 to its baseline exactly.
            ir_store_ptr(fieldType, fieldVal, ir_get_temp_name(slot))
        }
        fieldPtr = field.next
    }
}

internal fn generateExpression(expr: ASTNode) -> String {
    if (expr.kind == NodeKind.LITERAL_EXPR) {
        if (expr.i1 == TokenType.NUMBER_LITERAL) {
            return expr.s1
        }
        if (expr.i1 == TokenType.FLOAT_LITERAL) {
            return expr.s1
        }
        if (expr.i1 == TokenType.BOOL_LITERAL) {
            if (expr.s1.equals("true")) { return "1" }
            return "0"
        }
        if (expr.i1 == TokenType.CHAR_LITERAL) {
            return expr.s1
        }
        if (expr.i1 == TokenType.STRING_LITERAL) {
            // The literal's global was named by the collect_strings pre-pass.
            //
            // Named by the collect_strings pre-pass -- unless that pass has no
            // case for the node this literal sits under. It enumerates node
            // kinds, and `spawn`'s argument subtree is not among them, so
            // `spawn f("x")` reached here with no global and the backend failed
            // with `unknown string global ()`. That predates the fat String; the
            // thin path handed the same empty name to `ir_string_ptr`.
            //
            // Naming it here makes the pre-pass an optimisation (it batches the
            // globals) rather than a correctness requirement, so the next node
            // kind nobody adds cannot reintroduce this.
            if (expr.s2.equals("")) {
                collectStringsExpr(expr)
            }
            // A constant pair -- `{ @.strN, <len> }` -- so a literal costs no
            // instructions at all, which is why literals do not go through the
            // insertvalue pair that `fatFromPtr` builds for an FFI return.
            //
            // `__builtin_string_len` here runs in the *compiler*, on the literal's own
            // text, so it is a compile-time count and not a call in the program.
            return ir_get_temp_name(ir_const_str(expr.s2, __builtin_string_len(expr.s1)))
        }
    }

    if (expr.kind == NodeKind.DYN_MAKE) { return generateDynMake(expr) }
    if (expr.kind == NodeKind.DYN_CALL) { return generateDynCall(expr) }

    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        let structName = expr.s1

        // M2.1b. A consuming payload match may pair its dead constructor with
        // the same-tag constructor returned by this branch. The eligibility
        // proof and the token's frame limit live in stmt.psm; the expression
        // lowering only consumes the token instead of allocating a new block.
        // i3 is otherwise unused on STRUCT_LITERAL_EXPR.
        if (expr.i3 == 2 and irReuseValue.equals("") == false) {
            let reused = irReuseValue
            irReuseValue = ""
            generateStructLiteralFields(expr, structName, reused)
            return reused
        }

        // AIF decides where this value lives. T0 means the analysis proved it
        // does not outlive the frame that creates it, so it gets a stack slot
        // and no allocation call at all; every other tier still goes through the
        // backend's allocator hook, which is what it did before AIF existed.
        //
        // A tier of -1 is "no information" -- a build that ran no inference, or
        // an expression the walk never reached. That has to keep the old
        // behaviour exactly, because it is what makes SPEC 7.1's zero-analysis
        // mode behaviourally identical rather than merely intended to be.
        let mut allocTemp = 0
        if (aif_arena_at_node(node_to_ptr(expr)) == 1) {
            // T1 inside a `region` it cannot outlive: bump from the arena, and
            // the whole block goes back at the region's exit rather than one
            // object at a time.
            allocTemp = ir_alloc_region(structName)
        } else if (aif_tier_at_node(node_to_ptr(expr)) == AIF_TIER_T0) {
            allocTemp = ir_alloc_stack(structName)
        } else if (aif_rc_at_node(node_to_ptr(expr)) == 1) {
            // AIF Level 5. T3, held by more than one container, so no single
            // teardown can decide when it dies. The count goes in a prefix header,
            // which leaves the struct's own layout -- and therefore every field
            // index below -- exactly as it was.
            allocTemp = ir_alloc_rc(structName)
        } else if (aif_cycle_at_node(node_to_ptr(expr)) == 1) {
            // AIF T4b. Shared, fully escaping, and of a type that lies in a
            // non-trivial SCC -- so a count alone cannot reclaim it and the
            // collector has to be able to walk it. Header in front, as for T3.
            allocTemp = ir_alloc_cycle(structName)
        } else {
            allocTemp = ir_alloc_object(structName)
        }
        let memName = ir_get_temp_name(allocTemp)
        // LAYOUT 2.1's alloc(tau). Counted after the tier has chosen an allocator
        // rather than inside one of the five hooks, because the profile is about
        // how many instances the program makes, not about which arena served them
        // -- and a T0 site takes an alloca and calls no hook at all, so counting
        // in the hooks would miss exactly the instances that are cheapest and
        // most numerous.
        irProfileAlloc(structName)

        // CYCLES 3. The object is told how to find its cyclic children and how
        // to release itself, for the same reason a container is told its element
        // disposition: at collection time it is a bare pointer, and reading a
        // descriptor out of it would be reading memory we did not put there.
        if (aif_cycle_at_node(node_to_ptr(expr)) == 1) {
            let childrenPtr = ir_func_addr(cyclicChildrenFnName(structName))
            ir_call_begin()
            ir_call_arg("ptr", memName)
            ir_call_arg("ptr", ir_get_temp_name(childrenPtr))
            if (aif_type_releases(structName) == 1) {
                let releasePtr = ir_func_addr(releaseFnName(structName))
                ir_call_arg("ptr", ir_get_temp_name(releasePtr))
            } else {
                ir_call_arg("ptr", "null")
            }
            ir_call_end("void", "cyc_set_type")
        }

        generateStructLiteralFields(expr, structName, memName)
        return memName
    }

    if (expr.kind == NodeKind.IDENTIFIER_EXPR) {
        let valType = ir_get_var_type(expr.s1)
        let loadType = storageType(valType)
        // Shadowing-aware: a local named the same as a global must read from
        // the local's slot. Asking a flat "is this name a global?" registry
        // instead meant writes went to the local and reads came from the global.
        if (ir_var_is_global(expr.s1) == 1) {
            return ir_get_temp_name(ir_load_global(loadType, expr.s1))
        }
        return ir_get_temp_name(ir_load(loadType, ir_get_var_slot(expr.s1)))
    }

    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let objectNode = ptr_to_node(expr.child1)
        if (objectNode.kind == NodeKind.IDENTIFIER_EXPR) {
            let enumVal = ir_get_enum_variant(objectNode.s1, expr.s1)
            if (enumVal >= 0) {
                return strFromInt(enumVal)
            }
        }

        // M4.3b. A DataElement is the stable `(view handle, index)` pair. Resolve
        // the requested column only at the field access; no interior pointer is
        // stored in the descriptor, so copying it cannot be stranded by layout
        // conversion or column allocation details.
        if (nodeHasType(objectNode) and nodeGetType(objectNode).kind == TypeKind.DATAELEMENT) {
            let elemT = nodeGetType(objectNode)
            let rowT = ptr_to_type(elemT.child)
            let structName = rowT.name
            let fieldIndex = ir_get_struct_field_index(structName, expr.s1)
            let fieldType = fieldStorageType(ir_get_struct_field_type(structName, expr.s1))
            let descriptor = generateExpression(objectNode)
            let view = ir_get_temp_name(ir_extract_value("struct:prismio.data_element",
                                                         descriptor, 0))
            let index = ir_get_temp_name(ir_extract_value("struct:prismio.data_element",
                                                          descriptor, 1))
            ir_call_begin()
            ir_call_arg("ptr", view)
            ir_call_arg("i32", strFromInt(fieldIndex))
            let column = ir_get_temp_name(ir_call_end("ptr", "data_view_column"))
            // The row type makes the stride a compile-time LLVM type rather
            // than the runtime column's dynamic byte size. That is what lets a
            // column scan vectorise instead of remaining a scalar multiply.
            let slot = ir_get_temp_name(ir_elem_ptr(fieldType, column, index))
            irProfileField(structName, expr.s1, false)
            if (isValueStructKey(fieldType)) {
                return ir_get_temp_name(ir_data_load_ptr(fieldType, slot, structName, fieldIndex))
            }
            if (isStructTypeKey(fieldType)) { return slot }
            return ir_get_temp_name(ir_data_load_ptr(fieldType, slot, structName, fieldIndex))
        }

        let objectVal = generateExpression(objectNode)
        let objectType = getExprType(objectNode)
        let structName = structTypeName(objectType)
        let fieldIndex = ir_get_struct_field_index(structName, expr.s1)
        let fieldType = fieldStorageType(ir_get_struct_field_type(structName, expr.s1))

        let slot = ir_struct_field_ptr(structName, objectVal, fieldIndex)
        irProfileField(structName, expr.s1, false)
        // An inline field *is* the storage, so the GEP already is the value and
        // loading would read the struct rather than address it. This is where the
        // interior pointer SPEC 11 item 5 forbids escaping is created, and it
        // does escape: references are raw `ptr`, so nothing downstream can tell
        // this apart from an address the allocator returned. Handles are the fix
        // and are not built -- see KNOWN_ISSUES.md.
        // A String field is a value, not storage reached by GEP, so it loads
        // like a scalar even though its key names a struct.
        if (isValueStructKey(fieldType)) {
            return ir_get_temp_name(ir_struct_load_ptr(fieldType, ir_get_temp_name(slot),
                                                       structName, fieldIndex))
        }
        if (isStructTypeKey(fieldType)) {
            return ir_get_temp_name(slot)
        }
        return ir_get_temp_name(ir_struct_load_ptr(fieldType, ir_get_temp_name(slot),
                                                   structName, fieldIndex))
    }

    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let elemCount = countListNodes(expr.child1)
        let firstElem = ptr_to_node(expr.child1)

        // The element type comes from sema, which knows what the elements
        // actually are. It used to be hardcoded to i32 (or ptr for an array of
        // arrays), so ["a", "b"] stored pointers into i32 slots -- truncating
        // them -- and [1.5, 2.5] stored doubles into i32 slots.
        let arrT = nodeGetType(expr)
        let mut elemType = "i32"
        if (nodeExists(arrT.child)) {
            elemType = storageType(typeIrKey(ptr_to_type(arrT.child)))
        } else if (firstElem.kind == NodeKind.ARRAY_LITERAL_EXPR) {
            elemType = "ptr"
        }

        let base = ir_get_temp_name(ir_array_alloca(elemType, elemCount))

        let mut elemPtr = expr.child1
        let mut elemIndex = 0
        while (nodeExists(elemPtr)) {
            let elemNode = ptr_to_node(elemPtr)
            let elemVal = generateExpression(elemNode)
            let slot = ir_elem_ptr(elemType, base, strFromInt(elemIndex))
            ir_store_ptr(elemType, elemVal, ir_get_temp_name(slot))
            elemIndex = elemIndex + 1
            elemPtr = elemNode.next
        }

        return base
    }

    if (expr.kind == NodeKind.SLICE_EXPR) {
        let baseNode = ptr_to_node(expr.child1)
        let baseType = nodeGetType(baseNode)
        // A temp name is a String and therefore affine. Park it on the AST node
        // so extracting three fields reborrows one generated value instead of
        // looking like three moves from a local binding.
        expr.s1 = generateExpression(baseNode)

        let mut handle = expr.s1
        let mut origin = "0"
        let mut available = "0"
        if (baseType.kind == TypeKind.SLICE) {
            handle = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 0))
            origin = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 1))
            available = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 2))
        } else {
            ir_call_begin()
            ir_call_arg("ptr", handle)
            available = ir_get_temp_name(ir_call_end("i32", "list_len"))
        }

        let start = generateExpression(ptr_to_node(expr.child2))
        let end = generateExpression(ptr_to_node(expr.child3))
        ir_call_begin()
        ir_call_arg("i32", available)
        ir_call_arg("i32", start)
        ir_call_arg("i32", end)
        ir_call_end("void", "prismio_slice_check")

        let offset = ir_get_temp_name(ir_add("i32", origin, start))
        let length = ir_get_temp_name(ir_sub("i32", end, start))
        let empty = ir_get_temp_name(ir_undef("struct:prismio.slice"))
        let withHandle = ir_get_temp_name(ir_insert_value("struct:prismio.slice", empty,
                                                           handle, "ptr", 0))
        let withOffset = ir_get_temp_name(ir_insert_value("struct:prismio.slice", withHandle,
                                                           offset, "i32", 1))
        return ir_get_temp_name(ir_insert_value("struct:prismio.slice", withOffset,
                                                 length, "i32", 2))
    }

    if (expr.kind == NodeKind.INDEX_EXPR) {
        let baseNode = ptr_to_node(expr.child1)
        let baseType = nodeGetType(baseNode)

        if (baseType.kind == TypeKind.LIST) {
            let arrayVal = generateExpression(baseNode)
            let indexVal = generateExpression(ptr_to_node(expr.child2))
            ir_call_begin()
            ir_call_arg("ptr", arrayVal)
            ir_call_arg("i32", indexVal)
            let listInline = inlineElemSizeOfList(baseNode)
            let retType = storageType(getExprType(expr))
            // A scalar element goes by value, through the entry point that
            // resolves the representation itself. See list_get_inline_scalar:
            // `list_get_inline` returns an address for an inline list and the
            // slot's contents for a boxed one, and only a scalar can tell those
            // apart -- so the branch belongs where `elem_size` is, not here.
            if (listInline > 0 and scalarInlineBytes(retType) > 0) {
                ir_call_arg("i32", strFromInt(listInline))
                let bits = ir_get_temp_name(ir_call_end("i64", "list_get_inline_scalar"))
                return scalarFromInlineBits(retType, bits)
            }
            let mut getName = "list_get"
            if (listInline > 0) { getName = "list_get_inline" }
            let raw = ir_get_temp_name(ir_call_end("ptr", getName))
            if (isFatStringKey(retType)) { return fatFromPtr(raw) }
            if (retType.equals("ptr") == false) { return slotToScalar(retType, raw) }
            return raw
        }

        if (baseType.kind == TypeKind.SLICE) {
            expr.s1 = generateExpression(baseNode)
            let indexVal = generateExpression(ptr_to_node(expr.child2))
            let handle = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 0))
            let offset = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 1))
            let length = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 2))
            ir_call_begin()
            ir_call_arg("ptr", handle)
            ir_call_arg("i32", offset)
            ir_call_arg("i32", length)
            ir_call_arg("i32", indexVal)
            let sliceInline = inlineElemSizeOfSlice(baseNode)
            let retType = storageType(getExprType(expr))
            // The same by-value resolution as `l[i]` above, one indirection out.
            if (sliceInline > 0 and scalarInlineBytes(retType) > 0) {
                ir_call_arg("i32", strFromInt(sliceInline))
                let bits = ir_get_temp_name(
                    ir_call_end("i64", "list_slice_get_inline_scalar"))
                return scalarFromInlineBits(retType, bits)
            }
            let mut getName = "list_slice_get"
            if (sliceInline > 0) { getName = "list_slice_get_inline" }
            let raw = ir_get_temp_name(ir_call_end("ptr", getName))
            if (isFatStringKey(retType)) { return fatFromPtr(raw) }
            if (retType.equals("ptr") == false) { return slotToScalar(retType, raw) }
            return raw
        }

        if (baseType.kind == TypeKind.DATAVIEW) {
            let view = generateExpression(baseNode)
            let index = generateExpression(ptr_to_node(expr.child2))
            ir_call_begin()
            ir_call_arg("ptr", view)
            ir_call_arg("i32", index)
            ir_call_end("void", "data_view_check_index")
            let empty = ir_get_temp_name(ir_undef("struct:prismio.data_element"))
            let withView = ir_get_temp_name(ir_insert_value("struct:prismio.data_element",
                                                            empty, view, "ptr", 0))
            return ir_get_temp_name(ir_insert_value("struct:prismio.data_element",
                                                    withView, index, "i32", 1))
        }

        let arrayVal = generateExpression(baseNode)
        let indexVal = generateExpression(ptr_to_node(expr.child2))

        // sema types the index expression as the array's element type, so this
        // reads the right width and stride. Hardcoding i32 here loaded four
        // bytes out of an array of pointers or doubles.
        let mut elemType = storageType(getExprType(expr))
        if (elemType.equals("")) {
            elemType = "i32"
        }

        let slot = ir_elem_ptr(elemType, arrayVal, indexVal)
        return ir_get_temp_name(ir_load_ptr(elemType, ir_get_temp_name(slot)))
    }

    if (expr.kind == NodeKind.CAST_EXPR) {
        let source = ptr_to_node(expr.child1)
        let val = generateExpression(source)

        let fromT = nodeGetType(source)
        let toT = nodeGetType(expr)
        let fromKey = typeIrKey(fromT)
        let toKey = typeIrKey(toT)

        // Same representation: Enum to Int, or between same-width integer types
        // of different signedness. Nothing to emit.
        if (fromKey.equals(toKey)) {
            return val
        }

        if (toKey.equals("double")) {
            if (typeIntIsUnsigned(fromT)) {
                return ir_get_temp_name(ir_uitofp(fromKey, val, toKey))
            }
            return ir_get_temp_name(ir_sitofp(fromKey, val, toKey))
        }

        if (fromKey.equals("double")) {
            if (typeIntIsUnsigned(toT)) {
                return ir_get_temp_name(ir_fptoui(fromKey, val, toKey))
            }
            return ir_get_temp_name(ir_fptosi(fromKey, val, toKey))
        }

        // Integer-shaped on both sides, so the only question is width.
        if (typeIntBits(fromT) > typeIntBits(toT)) {
            return ir_get_temp_name(ir_trunc(fromKey, val, toKey))
        }

        // Widening. Char and Bool are zero-extended: a Char is a byte value, so
        // 'A' as Int must be 65 and never a negative number.
        let zeroExtend = typeIntIsUnsigned(fromT)
                          or fromT.kind == TypeKind.CHAR
                          or fromT.kind == TypeKind.BOOL
        if (zeroExtend) {
            return ir_get_temp_name(ir_zext(fromKey, val, toKey))
        }
        return ir_get_temp_name(ir_sext(fromKey, val, toKey))
    }

    if (expr.kind == NodeKind.UNARY_EXPR) {
        let operandNode = ptr_to_node(expr.child1)
        let operandVal = generateExpression(operandNode)
        let uop = expr.s1

        if (uop.equals("!")) {
            // Logical not. Comparing against 0 rather than xor-ing with true:
            // the bridge has an icmp primitive and no xor, and the two are
            // equivalent for i1.
            let notId = ir_icmp_eq("i1", operandVal, "0")
            return ir_get_temp_name(notId)
        }

        if (uop.equals("~")) {
            let intType = getExprType(operandNode)
            return ir_get_temp_name(ir_not(intType, operandVal))
        }

        if (uop.equals("-")) {
            let operandType = getExprType(operandNode)
            // ir_neg emits an integer `sub 0, x`, which is not valid for a
            // double -- floats need fsub.
            if (operandType.equals("double")) {
                let fnegId = ir_fsub("double", "0.0", operandVal)
                return ir_get_temp_name(fnegId)
            }
            let negId = ir_neg(operandType, operandVal)
            return ir_get_temp_name(negId)
        }
    }

    // REQUIREMENTS 4. `none` is a null pointer, and that is the choice the
    // punned-slot hazard forces. This compiler already spells "empty slot" as a
    // pointer to `""`, tested with str_equals -- which reads the first byte of
    // the pointed-to object, so a live value whose first field is zero *is* an
    // empty slot (test_41, and the reason the layout search pins field 0). A
    // null comparison reads no byte of any object, so nothing can collide with
    // it. See typeOptional in types.psm.
    if (expr.kind == NodeKind.NONE_LITERAL_EXPR) {
        return "null"
    }

    // REQUIREMENTS 15. `spawn f(a, b)` -> prismio_task_spawn(&f, n, a, b, null).
    //
    // Three void* slots and an arity, rather than a per-site wrapper function
    // that unpacks a heap argument pack. The wrapper is the general answer and
    // it wants closures, which REQUIREMENTS 3a has not built; the runtime's
    // switch on `n` calls through a correctly-typed function pointer, which is
    // defined behaviour where a variadic cast would not have been.
    //
    // Nothing about the *tier* of the arguments is decided here. Codegen asks
    // aif_tier_at_node exactly as it does for any other value, so a moved-in
    // argument that landed T3 gets T3's non-atomic count and a static that
    // landed T4a gets an atomic one -- which is the entire point of putting the
    // distinction in the solver rather than in the lowering.
    if (expr.kind == NodeKind.SPAWN_EXPR) {
        let call = ptr_to_node(expr.child1)
        let callee = ptr_to_node(call.child1)
        let mut target = callee.s1
        if (call.s2.equals("") == false) { target = call.s2 }
        let taskFunc = taskFunctionForCall(call)
        if (nodeExists(taskFunc)) {
            let func = ptr_to_node(taskFunc)
            if (functionHasStringParam(func)) { target = taskThunkName(func) }
        }

        // Which of prismio_task_invoke's three families the runtime must call
        // through. Decided from the callee's declared return type, which is
        // known statically -- so the type the task produces and the type read
        // back out of the join agree by construction.
        let resultT = typeTaskResult(nodeGetType(expr))
        let mut rkind = 0
        if (resultT.kind == TypeKind.VOID) { rkind = 2 }
        else if (resultT.kind != TypeKind.INT) { rkind = 1 }

        ir_call_begin()
        ir_call_arg("ptr", ir_get_temp_name(ir_func_addr(target)))
        ir_call_arg("i32", strFromInt(rkind))

        // The arity is counted before the arguments are emitted, because
        // ir_call_arg wants them in order and the count comes first.
        let mut countPtr = call.child2
        let mut argc = 0
        while (nodeExists(countPtr)) {
            argc = argc + 1
            countPtr = ptr_to_node(countPtr).next
        }
        ir_call_arg("i32", strFromInt(argc))

        // An owned temporary handed straight to `spawn` had no owner at all:
        // `spawn f(g(x))` leaks what `g` produced, which is 80 of
        // g9_helper_leak.psm's 107 allocations, one per spawn per frame. The
        // ordinary call's argument-position release cannot be reused, and the
        // note above says why -- a spawned task may still be running, so a
        // release after `prismio_task_spawn` returns would free memory the task
        // is reading.
        //
        // **The release point is the scope exit, and the licence is the one the
        // task handle already uses.** `i1` is set only when INFERENCE 4.1's
        // E-SPAWN-J proved the task is joined on every path before this scope
        // exits, so at the exit the thread has finished and the argument is
        // dead. A spawn that was not proved joined keeps leaking, which is the
        // conservative direction -- exactly as `IR_DROP_TASK` in src/ir/stmt.psm
        // is gated, and for the same failure.
        //
        // Spilling to a slot rather than releasing here is what lets the
        // existing drop list do the work: it is keyed on bindings, and a binding
        // in a loop body is dropped once per iteration, which is what g9's four
        // spawns per frame need.
        let spawnJoined = expr.i1 == 1
        let mut argPtr = call.child2
        let mut emitted = 0
        while (nodeExists(argPtr)) {
            let argNode = ptr_to_node(argPtr)
            let argVal = generateExpression(argNode)
            if (spawnJoined and irArgumentIsOwnedTemporary(argNode)) {
                let declType = getExprType(argNode)
                let store = storageType(declType)
                let name = "spawnarg.".concat(strFromInt(irSpawnArgCounter))
                irSpawnArgCounter = irSpawnArgCounter + 1
                // Same order as an ordinary binding in src/ir/stmt.psm, and it
                // is load-bearing: the binding is what assigns the slot its
                // serial, so an alloca made before this one is named `x` where
                // the drop list will look for `x.N`.
                ir_set_var_type(name, declType)
                let slot = ir_get_var_slot(name)
                ir_alloca(store, slot)
                ir_store(store, argVal, slot)
                ir_mark_droppable(name, irOwnedTemporaryKind(argNode))
                ir_call_arg("ptr", ir_get_temp_name(ir_load(store, slot)))
            } else {
                ir_call_arg("ptr", argVal)
            }
            emitted = emitted + 1
            argPtr = argNode.next
        }
        // The unused slots are still passed. prismio_task_spawn has one
        // signature, and a call that supplied fewer arguments than the
        // declaration would fail module verification -- the backend synthesises
        // the declaration from the *first* call site it sees, so two spawns of
        // different arity in one module would otherwise disagree about the
        // callee's type.
        while (emitted < 3) {
            ir_call_arg("ptr", "null")
            emitted = emitted + 1
        }

        return ir_get_temp_name(ir_call_end("ptr", "prismio_task_spawn"))
    }

    if (expr.kind == NodeKind.JOIN_EXPR) {
        let handle = generateExpression(ptr_to_node(expr.child1))
        let resultT = nodeGetType(expr)
        ir_call_begin()
        ir_call_arg("ptr", handle)
        if (resultT.kind == TypeKind.VOID) {
            return ir_get_temp_name(ir_call_end("void", "prismio_task_join_v"))
        }
        if (resultT.kind == TypeKind.INT) {
            return ir_get_temp_name(ir_call_end("i32", "prismio_task_join"))
        }
        // A task's result crosses back through `void*`, so a `Task<String>`
        // yields a bare pointer that has to be given a length -- the same
        // boundary as any other value arriving from the runtime.
        if (typeIrKey(resultT).equals("struct:prismio.str")) {
            return fatFromPtr(ir_get_temp_name(ir_call_end("ptr", "prismio_task_join_p")))
        }
        return ir_get_temp_name(ir_call_end("ptr", "prismio_task_join_p"))
    }

    if (expr.kind == NodeKind.BINARY_EXPR) {
        // Handled before either operand is generated -- that is the whole point.
        if (expr.s1.equals("and") or expr.s1.equals("or")) {
            return generateShortCircuit(expr)
        }

        let leftVal = generateExpression(ptr_to_node(expr.child1))
        let rightVal = generateExpression(ptr_to_node(expr.child2))

        let op = expr.s1
        let mut tempId = 0
        let leftNode = ptr_to_node(expr.child1)
        let opType = getExprType(leftNode)
        let mut isUnsigned = false
        if (nodeHasType(leftNode)) {
            isUnsigned = typeIntIsUnsigned(nodeGetType(leftNode))
        }
        if (opType.equals("double")) {
            if (op.equals("+")) { tempId = ir_fadd(opType, leftVal, rightVal) }
            if (op.equals("-")) { tempId = ir_fsub(opType, leftVal, rightVal) }
            if (op.equals("*")) { tempId = ir_fmul(opType, leftVal, rightVal) }
            if (op.equals("/")) { tempId = ir_fdiv(opType, leftVal, rightVal) }
            if (op.equals("==")) { tempId = ir_fcmp_oeq(opType, leftVal, rightVal) }
            if (op.equals("!=")) { tempId = ir_fcmp_one(opType, leftVal, rightVal) }
            if (op.equals("<")) { tempId = ir_fcmp_olt(opType, leftVal, rightVal) }
            if (op.equals("<=")) { tempId = ir_fcmp_ole(opType, leftVal, rightVal) }
            if (op.equals(">")) { tempId = ir_fcmp_ogt(opType, leftVal, rightVal) }
            if (op.equals(">=")) { tempId = ir_fcmp_oge(opType, leftVal, rightVal) }
        } else {
            // RFC 0560, the debug half. `+ - *` are the three that can overflow;
            // `/` cannot except at INT_MIN/-1, which is a different trap and is
            // not this item. Comparisons and bitwise ops never can.
            //
            // Gated on the whole-build bit rather than on anything about this
            // expression, because "check in debug, wrap in release" is a build
            // mode and not a property of an operand. A checked op is 5.4x-6.0x
            // the plain one -- it defeats vectorization -- so the default is off
            // and the flag is what turns it on.
            let checked = ir_overflow_checks() == 1 and isIntegerStorageKey(opType)
            if (checked) {
                let file = diag_file_path(expr.file)
                if (isUnsigned) {
                    if (op.equals("+")) { tempId = ir_uadd_checked(opType, leftVal, rightVal, file, expr.line) }
                    if (op.equals("-")) { tempId = ir_usub_checked(opType, leftVal, rightVal, file, expr.line) }
                    if (op.equals("*")) { tempId = ir_umul_checked(opType, leftVal, rightVal, file, expr.line) }
                } else {
                    if (op.equals("+")) { tempId = ir_add_checked(opType, leftVal, rightVal, file, expr.line) }
                    if (op.equals("-")) { tempId = ir_sub_checked(opType, leftVal, rightVal, file, expr.line) }
                    if (op.equals("*")) { tempId = ir_mul_checked(opType, leftVal, rightVal, file, expr.line) }
                }
            } else {
                if (op.equals("+")) { tempId = ir_add(opType, leftVal, rightVal) }
                if (op.equals("-")) { tempId = ir_sub(opType, leftVal, rightVal) }
                if (op.equals("*")) { tempId = ir_mul(opType, leftVal, rightVal) }
            }
            if (op.equals("==")) { tempId = ir_icmp_eq(opType, leftVal, rightVal) }
            if (op.equals("!=")) { tempId = ir_icmp_ne(opType, leftVal, rightVal) }
            if (isUnsigned) {
                if (op.equals("/")) { tempId = ir_udiv(opType, leftVal, rightVal) }
                if (op.equals("<")) { tempId = ir_icmp_ult(opType, leftVal, rightVal) }
                if (op.equals("<=")) { tempId = ir_icmp_ule(opType, leftVal, rightVal) }
                if (op.equals(">")) { tempId = ir_icmp_ugt(opType, leftVal, rightVal) }
                if (op.equals(">=")) { tempId = ir_icmp_uge(opType, leftVal, rightVal) }
            } else {
                if (op.equals("/")) { tempId = ir_sdiv(opType, leftVal, rightVal) }
                if (op.equals("<")) { tempId = ir_icmp_slt(opType, leftVal, rightVal) }
                if (op.equals("<=")) { tempId = ir_icmp_sle(opType, leftVal, rightVal) }
                if (op.equals(">")) { tempId = ir_icmp_sgt(opType, leftVal, rightVal) }
                if (op.equals(">=")) { tempId = ir_icmp_sge(opType, leftVal, rightVal) }
            }
        }
        if (op.equals("%")) {
            if (isUnsigned) { tempId = ir_urem(opType, leftVal, rightVal) }
            else { tempId = ir_srem(opType, leftVal, rightVal) }
        }

        if (op.equals("&")) { tempId = ir_and(opType, leftVal, rightVal) }
        if (op.equals("|")) { tempId = ir_or(opType, leftVal, rightVal) }
        if (op.equals("^")) { tempId = ir_xor(opType, leftVal, rightVal) }
        if (op.equals("<<")) { tempId = ir_shl(opType, leftVal, rightVal) }
        // Right shift follows the left operand's signedness: logical for
        // unsigned so the sign bit is not smeared, arithmetic for signed.
        if (op.equals(">>")) {
            if (isUnsigned) { tempId = ir_lshr(opType, leftVal, rightVal) }
            else { tempId = ir_ashr(opType, leftVal, rightVal) }
        }
        // `and`/`or` never reach here -- generateShortCircuit handles them
        // above, before either operand has been evaluated.

        return ir_get_temp_name(tempId)
    }

    if (expr.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(expr.child1)
        let funcName = callee.s1

        // drop(x): release the owned heap value. Ownership/move checking in sema
        // guarantees this runs at most once per value.
        //
        // Through ir_free_object rather than a call to `free` by name, because
        // the deallocator is policy: a verify build routes it to a shim that
        // checks the value was live, and an arena build will not be able to use
        // libc free at all. Calling `free` directly here made explicit drops
        // invisible to both.
        if (funcName.equals("drop")) {
            let dropArg = expr.child2
            if (nodeExists(dropArg)) {
                let argNode = ptr_to_node(dropArg)
                let value = generateExpression(argNode)
                let kind = dropKindOf(argNode)
                if (kind == IR_DROP_LIST) {
                    ir_free_list(value)
                } else if (kind == IR_DROP_DATAVIEW) {
                    ir_free_data_view(value)
                } else if (kind == IR_DROP_TYPED) {
                    ir_free_typed(value, releaseFnName(structTypeName(getExprType(argNode))))
                } else {
                    ir_free_object(value)
                }
            }
            return ""
        }

        // M4.3a. Build real per-field storage from an ordinary AoS list. The
        // layout queries are target-aware constants, so padding and nested flat
        // fields are copied exactly as LLVM laid the row out.
        if (funcName.equals("soa") and nodeExists(expr.child2)) {
            let sourceNode = ptr_to_node(expr.child2)
            if (nodeIsNull(sourceNode.next)) {
                let sourceT = nodeGetType(sourceNode)
                let elemT = ptr_to_type(sourceT.child)
                let structName = elemT.name
                let fieldCount = ir_get_struct_field_count(structName)
                let elemSize = ir_struct_size(structName)
                let source = generateExpression(sourceNode)

                ir_call_begin()
                ir_call_arg("ptr", source)
                ir_call_arg("i32", strFromInt(fieldCount))
                ir_call_arg("i32", strFromInt(elemSize))
                expr.s1 = ir_get_temp_name(ir_call_end("ptr", "data_view_begin"))

                let mut field = 0
                while (field < fieldCount) {
                    ir_call_begin()
                    ir_call_arg("ptr", expr.s1)
                    ir_call_arg("i32", strFromInt(field))
                    ir_call_arg("i32", strFromInt(ir_struct_field_offset(structName, field)))
                    ir_call_arg("i32", strFromInt(ir_struct_field_size(structName, field)))
                    ir_call_end("void", "data_view_add_column")
                    field = field + 1
                }
                ir_call_begin()
                ir_call_arg("ptr", expr.s1)
                ir_call_end("void", "data_view_finish")
                return expr.s1
            }
        }

        if (funcName.equals("aos") and nodeExists(expr.child2)) {
            let viewNode = ptr_to_node(expr.child2)
            if (nodeIsNull(viewNode.next)) {
                let view = generateExpression(viewNode)
                ir_call_begin()
                ir_call_arg("ptr", view)
                return ir_get_temp_name(ir_call_end("ptr", "data_view_to_list"))
            }
        }

        if (funcName.equals("data_len") and nodeExists(expr.child2)) {
            let viewNode = ptr_to_node(expr.child2)
            if (nodeIsNull(viewNode.next)) {
                let view = generateExpression(viewNode)
                ir_call_begin()
                ir_call_arg("ptr", view)
                return ir_get_temp_name(ir_call_end("i32", "data_view_len"))
            }
        }

        if (funcName.equals("slice_len") and nodeExists(expr.child2)) {
            let sliceNode = ptr_to_node(expr.child2)
            if (nodeIsNull(sliceNode.next)) {
                let slice = generateExpression(sliceNode)
                return ir_get_temp_name(ir_extract_value("struct:prismio.slice", slice, 2))
            }
        }

        if (funcName.equals("slice_set") and nodeExists(expr.child2)) {
            let sliceNode = ptr_to_node(expr.child2)
            if (nodeExists(sliceNode.next)) {
                let indexNode = ptr_to_node(sliceNode.next)
                if (nodeExists(indexNode.next)) {
                    let valueNode = ptr_to_node(indexNode.next)
                    expr.s1 = generateExpression(sliceNode)
                    let handle = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 0))
                    let offset = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 1))
                    let length = ir_get_temp_name(ir_extract_value("struct:prismio.slice", expr.s1, 2))
                    let index = generateExpression(indexNode)
                    let valueType = storageType(getExprType(valueNode))
                    let sliceSetInline = inlineElemSizeOfSlice(sliceNode)
                    let mut passed = ""
                    if (isFatStringKey(valueType)) {
                        let value = generateExpression(valueNode)
                        // A slice slot owns its word for the same reason a list
                        // element does, so this is `scalarToSlot` on the pair.
                        passed = scalarToSlot("struct:prismio.str", value)
                    } else if (valueType.equals("ptr") == false) {
                        let value = generateExpression(valueNode)
                        // Widened for the by-value setter, punned for the boxed
                        // one. `value` is affine, so exactly one of these runs.
                        if (sliceSetInline > 0 and scalarInlineBytes(valueType) > 0) {
                            passed = scalarToInlineBits(valueType, value)
                        } else {
                            passed = scalarToSlot(valueType, value)
                        }
                    } else {
                        passed = generateExpression(valueNode)
                    }

                    ir_call_begin()
                    ir_call_arg("ptr", handle)
                    ir_call_arg("i32", offset)
                    ir_call_arg("i32", length)
                    ir_call_arg("i32", index)
                    // A scalar goes by value here too. Reaching
                    // `list_slice_set_inline` with an address means
                    // `list_set_inline` stores that address as the element when
                    // the list turns out boxed -- a stack pointer written where
                    // an Int belongs, which is the write-direction twin of what
                    // list_get_inline_scalar exists to prevent.
                    let mut setName = "list_slice_set"
                    if (sliceSetInline > 0 and scalarInlineBytes(valueType) > 0) {
                        ir_call_arg("i64", passed)
                        ir_call_arg("i32", strFromInt(sliceSetInline))
                        setName = "list_slice_set_inline_scalar"
                    } else {
                        ir_call_arg("ptr", passed)
                        if (sliceSetInline > 0) { setName = "list_slice_set_inline" }
                    }
                    ir_call_end("void", setName)
                    return ""
                }
            }
        }

        // M4.2, destination passing. `list_push(l, Thing { ... })` where the
        // element type is stored inline builds the element **in the list**: the
        // runtime reserves the slot and the literal's field stores are emitted
        // against that address, so the push allocates nothing and copies
        // nothing.
        //
        // The whole of inline storage's cost on the frame-loop programs was
        // here -- a temporary object per push, memcpy'd in and freed -- and this
        // is the shape five of the six corpus programs push in.
        if (generatePushInPlace(expr, funcName)) { return "" }

        // M4.2, the read end. `list_get` on a flat element type is address
        // arithmetic from a stride this compiler already knows, so it is emitted
        // here rather than called for -- see ir_list_flat_elem in
        // runtime/llvm-api-backend.c for why the guard is `== stride` and why
        // the boxed arm is still the runtime's.
        //
        // The `ptr` test is not belt and braces: a flat, uncounted element type
        // is a value struct, whose storage type is `ptr`, and every other
        // element reaches the slot-to-scalar conversion below instead. Making
        // that a condition rather than an assumption is what keeps a future
        // flat-but-scalar element from silently taking an address where it
        // wants a value.
        // Only inside a loop whose guard was proved, which is what makes this
        // pay. A single `list_get` outside one is left on `list_get_inline`: the
        // three blocks this expands into are worth their code only when a loop
        // amortises them, and emitting them everywhere cost g2 and g6 +58%
        // compile time and +34% binary for 4.9% and 2.0%.
        let flatStride = flatGetStride(expr, funcName)
        if (flatStride == 0 and isStaticBoxedListGet(expr, funcName)
                and irLoopDepth > 0) {
            let listNode = ptr_to_node(expr.child2)
            let listVal = generateExpression(listNode)
            let indexVal = generateExpression(ptr_to_node(listNode.next))
            let raw = ir_get_temp_name(ir_list_boxed_elem(listVal, indexVal))
            let retType = storageType(getExprType(expr))
            if (isFatStringKey(retType)) { return fatFromPtr(raw) }
            if (retType.equals("ptr") == false) {
                return slotToScalar(retType, raw)
            }
            return raw
        }
        // **A scalar element belongs here too, and leaving it out was a real
        // regression.** Putting scalars inline takes them out of
        // `isStaticBoxedListGet` above; falling through to the curated
        // `list_get_inline_scalar` call measured 2.31x slower on a 20M-read loop
        // because the old ir_list_boxed_elem body was visible and vectorised.
        //
        // The pointer and scalar intrinsics stay separate because their result
        // conventions differ. ir_list_flat_elem joins two addresses: the flat
        // row address and list_get_inline's result. Its scalar twin joins two
        // values: a typed load from the flat row and list_get_inline_scalar's
        // i64 carrier converted back to the element type. Merging first and
        // loading afterwards would load through a boxed scalar value as though
        // it were an address whenever inline storage is disabled.
        //
        // The fat String stays out, and not by accident: it is a `struct:` key
        // that is a pair in a register rather than storage reached by GEP, so it
        // has neither a scalar load type nor an address to load from here.
        let flatRet = storageType(getExprType(expr))
        if (flatStride > 0 and irLoopFlatGuard.equals("") == false) {
            let listNode = ptr_to_node(expr.child2)
            let listVal = generateExpression(listNode)
            let indexVal = generateExpression(ptr_to_node(listNode.next))
            let guard = ir_get_temp_name(ir_load("i1", irLoopFlatGuard))
            if (flatRet.equals("ptr")) {
                return ir_get_temp_name(ir_list_flat_elem(
                    listVal, indexVal, flatStride, guard))
            }
            if (scalarInlineBytes(flatRet) > 0) {
                return ir_get_temp_name(ir_list_flat_scalar_elem(
                    listVal, indexVal, flatRet, flatStride, guard))
            }
        }

        // Byte length is the pair's second field. This is a reserved compiler
        // builtin, not an extern: its source spelling carries no declaration,
        // LLVM symbol or link requirement.
        if (funcName.equals("__builtin_string_len")
            and nodeExists(expr.child2)) {
            let a0 = ptr_to_node(expr.child2)
            if (nodeExists(a0.next) == false) {
                let value = generateExpression(a0)
                let wide = ir_get_temp_name(ir_extract_value("struct:prismio.str", value, 1))
                let narrow = ir_get_temp_name(ir_trunc("i64", wide, "i32"))
                // Bit 31 is the inline tag, not part of the length. This `and` is
                // the entire per-read cost of the German-string representation --
                // see the layout note over `str_data_ptr` in
                // runtime/llvm-api-backend.c for why the tag sits there rather
                // than at bit 63, where it would have cost an inline byte instead.
                return ir_get_temp_name(ir_and("i32", narrow, "2147483647"))
            }
        }

        // The one allocation whose length the caller states rather than the
        // buffer carrying it.
        //
        // Intercepted here because the general path would build the pair with
        // `fatFromPtr`, and measuring this buffer is meaningless: the C writes
        // only the terminator and leaves the interior uninitialised. Every other
        // String arriving from C is already filled, which is what makes
        // `fatFromPtr` right for those and wrong for this one.
        //
        // This is also what makes the length builtin above sound. The pair is
        // only worth reading if every producer puts a true length in it, and
        // this is the one producer that could not.
        //
        // The arena bracket is repeated rather than shared: this returns before
        // the general path's copy of it, and this call allocates.
        if (funcName.equals("str_with_capacity") and nodeExists(expr.child2)) {
            let a0 = ptr_to_node(expr.child2)
            if (nodeExists(a0.next) == false) {
                let n = generateExpression(a0)
                let placed = aif_arena_at_node(node_to_ptr(expr)) == 1
                if (placed) { ir_arena_hint_begin() }
                ir_call_begin()
                ir_call_arg("i32", n)
                let raw = ir_get_temp_name(ir_call_end("ptr", "str_with_capacity"))
                if (placed) { ir_arena_hint_end() }
                return fatWithLength(raw, n)
            }
        }

        // Byte access, emitted rather than called.
        //
        // A string loop runs each byte operation once per byte. When the old
        // spellings were ordinary externs, each iteration paid a call LLVM could
        // not inline -- lang_runtime.c is a separate translation unit and user
        // programs do not link with LTO. Measured on 40 000 searches of a
        // 40 000-byte string: 1.85s calling out per byte against 0.38s for the
        // identical loop in C at -O2, so **4.9x of that gap was call overhead
        // alone**.
        //
        // The lowering is the same GEP-plus-load the array index above emits;
        // String's data field is a machine pointer and a byte is an `i8`, so
        // there is nothing string-specific about it beyond the element type.
        //
        // **No bounds check, deliberately.** Checking the upper bound by calling
        // `strlen` on every access is what made `str_char_at` loops quadratic.
        // The builtin's contract is "the
        // index is in [0, len)" and std/string.psm establishes that bound before
        // every use. `String.charAt` remains the checked accessor for callers who
        // want one.
        if (funcName.equals("__builtin_string_byte_at")
            and nodeExists(expr.child2)) {
            let a0 = ptr_to_node(expr.child2)
            if (nodeExists(a0.next)) {
                let base = generateExpression(a0)
                let idx = generateExpression(ptr_to_node(a0.next))
                // **The resolved pointer first, if this operand is a binding
                // that has one.** A String's bytes are behind its pointer or
                // inside the pair, and `ir_str_byte_at` answers that per access
                // -- five instructions per character, which the tokenizer paid
                // 204 000 times because its loop is too large for LLVM to
                // unswitch. A binding resolves it once where it is made
                // (stmt.psm, module.psm), and then this is the GEP and load it
                // has always been.
                //
                // Only for a plain variable reference: anything else has no
                // binding to have resolved, and the per-access form is correct
                // for all of them.
                let a0node = ptr_to_node(expr.child2)
                if (a0node.kind == NodeKind.IDENTIFIER_EXPR) {
                    let resolved = ir_get_var_data(a0node.s1)
                    if (resolved >= 0) {
                        let slot = ir_elem_ptr("i8", ir_get_temp_name(resolved), idx)
                        return ir_get_temp_name(ir_load_ptr("i8", ir_get_temp_name(slot)))
                    }
                }
                return ir_get_temp_name(ir_str_byte_at(base, idx))
            }
        }

        // The German short form, built from a range of another string.
        //
        // This is the producer the whole representation exists for. `strSubstring`
        // takes it whenever the result is twelve bytes or fewer, which on the
        // tokenizer benchmark is every token and across `prismio check src/main.psm`
        // is 81.3% of every string allocated -- and it allocates nothing, frees
        // nothing, and hands back sixteen bytes of value.
        //
        // Straight-line by construction: the size test lives in std/string.psm, so
        // there is no branch here and nothing for the caller's loop to mispredict.
        if (funcName.equals("__builtin_string_inline")
            and nodeExists(expr.child2)) {
            let a0 = ptr_to_node(expr.child2)
            if (nodeExists(a0.next)) {
                let a1 = ptr_to_node(a0.next)
                if (nodeExists(a1.next)) {
                    let base = generateExpression(a0)
                    let from = generateExpression(a1)
                    let count = generateExpression(ptr_to_node(a1.next))
                    return ir_get_temp_name(ir_str_inline(base, from, count))
                }
            }
        }

        // `a == b` on String. The pointer half of each fat pair goes to the
        // runtime's str_equals, whose strcmp the C library vectorises; the i32 it
        // answers becomes the i1 the language wants.
        if (funcName.equals("__builtin_string_eq")
            and nodeExists(expr.child2)) {
            let e0 = ptr_to_node(expr.child2)
            if (nodeExists(e0.next)) {
                let lhsVal = generateExpression(e0)
                let rhsVal = generateExpression(ptr_to_node(e0.next))
                // Canonicalised, not field 0: a short string's first field is
                // twelve bytes of text, and strcmp on it compares the characters
                // as if they were an address.
                let lhsPtr = ir_get_temp_name(ir_str_data(lhsVal))
                let rhsPtr = ir_get_temp_name(ir_str_data(rhsVal))
                ir_call_begin()
                ir_call_arg("ptr", lhsPtr)
                ir_call_arg("ptr", rhsPtr)
                let same = ir_get_temp_name(ir_call_end("i32", "str_equals"))
                return ir_get_temp_name(ir_icmp_ne("i32", same, "0"))
            }
        }

        // **Writes go to the long form only, and every caller obeys that.** Every
        // `__builtin_string_put_byte` in std/string.psm writes into a buffer that
        // came from `str_with_capacity` two lines above, which always allocates;
        // the short form is built whole by `__builtin_string_inline` and never
        // written into. A write to a short string would land in the scratch copy
        // the coercion makes and be lost, so the rule is the same one the index
        // has: established at the call site, not checked here.
        if (funcName.equals("__builtin_string_put_byte")
            and nodeExists(expr.child2)) {
            let a0 = ptr_to_node(expr.child2)
            if (nodeExists(a0.next)) {
                let a1 = ptr_to_node(a0.next)
                if (nodeExists(a1.next)) {
                    let base = generateExpression(a0)
                    let idx = generateExpression(a1)
                    let value = generateExpression(ptr_to_node(a1.next))
                    let slot = ir_elem_ptr("i8", base, idx)
                    ir_store_ptr("i8", value, ir_get_temp_name(slot))
                    return ""
                }
            }
        }

        // Regular function call
        let inlineSize = inlineElemSizeOfCall(expr)
        // Foreign iff Prismio does not define a function of this name.
        //
        // One test for both directions, and it has to be this one. Asking "is
        // there an extern called this" is not the same question: a program may
        // declare `extern fn print(s: String)` while std.io also defines `print`,
        // and both are true at once. Overload resolution then picks the Prismio
        // one, so extracting the pointer half on the argument side handed a bare
        // pointer to `@print__String`, which wants the pair.
        let isForeign = callIsPrismioFn(funcName) == false
        ir_call_begin()
        // REQUIREMENTS 20. `list_push` and `list_set` take the element as `ptr`,
        // so a scalar has to reach the slot as one -- without this the call
        // disagrees with its own declaration and the module fails verification.
        let elemArg = listElementArgIndex(funcName)

        // The owned temporaries this call is about to consume, released once it
        // returns. Collected here because this is the only point where the
        // generated value and the argument node are both in hand.
        let mut ownedTempVals: List<String> = list_new()
        let mut ownedTempKinds: List<Int> = list_new()
        let mut ownedTempTypes: List<String> = list_new()

        // Which storage key the element argument carried, so the entry-point
        // choice below can tell a scalar from a struct without re-deriving it.
        let mut elemStoreKey = ""
        let mut argPtr = expr.child2
        let mut argIndex = 0
        while (nodeExists(argPtr)) {
            let argNode = ptr_to_node(argPtr)
            let argVal = generateExpression(argNode)
            let argStore = storageType(getExprType(argNode))
            // Cloned: `argStore` is affine and the branches below still name it.
            if (argIndex == elemArg) { elemStoreKey = strClone(argStore) }
            // Cloned because `argVal` is affine and the argument itself still
            // has to consume it below -- the same reason the two branches under
            // this one each name it exactly once.
            if (irArgumentIsOwnedTemporary(argNode)) {
                list_push(ownedTempVals, strClone(argVal))
                list_push(ownedTempKinds, irOwnedTemporaryKind(argNode))
                list_push(ownedTempTypes, getExprType(argNode))
            }
            // Crossing into C: a String is `{ptr, i64}` here and `const char*`
            // there, so the pointer half goes and the length stays. The buffer is
            // NUL-terminated (FFI 7.1), which is what keeps this a field read
            // rather than a copy.
            //
            // The two branches each name `argVal` once and never both -- a String
            // is affine, so hoisting the common tail out would move it twice.
            if (isForeign and argStore.equals("struct:prismio.str")) {
                if (argIndex == elemArg) {
                    // Into a container slot, which owns one word and frees it
                    // later -- so `scalarToSlot` is handed the *pair*, not the
                    // pointer half, and copies a short string out to the heap on
                    // the way in. Handing it the coerced pointer instead stored
                    // the scratch buffer's address in the list, and the release at
                    // teardown was a free of the stack.
                    ir_call_arg("ptr", scalarToSlot("struct:prismio.str", argVal))
                } else {
                    ir_call_arg("ptr", ir_get_temp_name(ir_str_data(argVal)))
                }
            } else {
                if (argIndex == elemArg) {
                    // **Two conventions, and they are not interchangeable.**
                    // `list_push`/`list_set` take the element *punned into* a
                    // pointer slot; `list_push_inline`/`list_set_inline` take a
                    // pointer to the bytes and memcpy `elem_size` of them. Give
                    // the inline pair a punned scalar and it copies from the
                    // address numerically equal to the value -- which is the
                    // "read a body as a pointer" the notes on inlineElemSize
                    // warn about, and it is a wild read rather than a wrong
                    // answer. A struct element needs nothing here: it already
                    // *is* the address of its bytes.
                    // **`scalarInlineBytes`, not "is it a struct key".** A
                    // struct element reaches here as a bare `ptr` for a generic
                    // or a boxed layout, which is not a struct key and is not a
                    // scalar either -- and `zext ptr to i64` fails module
                    // verification. Asking for the width answers 0 for `ptr` and
                    // for anything else this does not know how to widen.
                    if (inlineSize > 0 and scalarInlineBytes(argStore) > 0) {
                        ir_call_arg("i64", scalarToInlineBits(argStore, argVal))
                    } else {
                        ir_call_arg("ptr", scalarToSlot(argStore, argVal))
                    }
                } else {
                    ir_call_arg(argStore, argVal)
                }
            }
            argPtr = argNode.next
            argIndex = argIndex + 1
        }

        let mut callName = funcName
        if (expr.s2.equals("") == false) {
            callName = expr.s2
        }
        // M4.2. The inline family, chosen from the list's static element type.
        // `list_push_inline` takes the size as well, so an unstamped-but-empty
        // list can stamp itself: a `let mut xs = list_new()` with no annotation
        // reaches the push with `List<Invalid>` and is boxed, and one with an
        // annotation reaches it already stamped.
        if (inlineSize > 0) {
            let mut inlineName = inlineOpName(funcName)
            // A scalar element takes the by-value pair. `list_get` is unaffected:
            // it returns the slot's address either way and the load above is what
            // reads it.
            let mut scalarElem = false
            if (scalarInlineBytes(elemStoreKey) > 0) {
                scalarElem = true
                if (funcName.equals("list_push")) { inlineName = "list_push_inline_scalar" }
                if (funcName.equals("list_set")) { inlineName = "list_set_inline_scalar" }
            }
            if (inlineName.equals("") == false) {
                callName = inlineName
                // `list_push_inline` has always taken the size so an unstamped
                // empty list can stamp itself. The scalar pair takes it as well,
                // and `list_set_inline` -- the struct one -- still does not.
                if (funcName.equals("list_push")
                        or (scalarElem and funcName.equals("list_set"))) {
                    ir_call_arg("i32", strFromInt(inlineSize))
                }
            }
        }
        // REQUIREMENTS 4. The checked unwrap is an ordinary call that returns
        // its argument, which is why it needs no new control flow here: the
        // runtime aborts on a null rather than codegen branching around one.
        if (funcName.equals("expect")) {
            callName = "prismio_expect"
        }

        let mut retType = storageType(getExprType(expr))

        // Whether the temporaries above may be released once this call returns.
        //
        // Three conditions, and each one is a hazard that was reachable:
        //
        //  * **A known Prismio callee.** An extern's result is described by its
        //    FFI contract and `alias` hands an argument back; aif_fn_may_return_param
        //    answers no for a symbol it does not know, so widening here would be
        //    reading that answer as a fact when it is an abstention.
        //  * **The callee does not return one of its parameters.** Otherwise the
        //    result aliases the temporary and freeing it here is a use-after-free
        //    in the expression that still reads it -- the same defect as
        //    tests/test_85_passthrough_escape.psm, one scope earlier.
        //  * **The result carries no pointer.** A scalar cannot alias the
        //    argument at all, which closes the case the fact above can miss: a
        //    callee returning a *view* of a parameter carries provenance rather
        //    than the parameter's sites (SPEC 8.4), so the set intersection is
        //    silent about it.
        //
        // `spawn` needs no clause and gets none: SPEC's spawn lowers through its
        // own path in this function, which emits its arguments itself and never
        // reaches here. That matters -- a spawned task may still be running, so
        // this release point would be wrong for it, and
        // aif/evidence/xlang/prismio/g9_helper_leak.psm is exactly that shape.
        // **The third clause used to be the return's kind, and it was far too
        // wide.** "Any pointer or struct result may alias an argument" withheld
        // the release from every call that returns anything reference-shaped:
        // `wrap(make())` returning a fresh `Box` cannot be the `String` it was
        // handed, and leaked 100 of 100 allocations for it. The kind was standing
        // in for the case the points-to fact genuinely misses -- a callee
        // returning a *view* of a parameter, which carries provenance rather than
        // sites -- and that case now has its own fact, so the stand-in can go.
        let releaseTemps = isForeign == false
            and aif_fn_may_return_param(callName) == 0
            and aif_fn_may_return_view_of_param(callName) == 0

        if (retType.equals("void")) {
            ir_call_end("void", callName)
            if (releaseTemps) {
                generateOwnedTemporaryReleases(ownedTempVals, ownedTempKinds, ownedTempTypes)
            }
            return ""
        }

        // AIF Level 4. The value this call produces may belong to an enclosing
        // `region`, and it is allocated inside the runtime rather than through
        // ir_alloc_region -- so the arena is chosen here, around the call, and
        // the runtime bumps instead of calling malloc.
        //
        // aif_arena_at_node is the whole gate, and it is sufficient rather than
        // merely convenient. A site exists on a call node only when the callee is
        // opaque to this compilation; the analysis raised it to T1 with an escape
        // at or below the region, which an `alias` return or an undeclared one
        // never gets. So this fires exactly on FFI `produce` calls inside a region
        // whose result cannot outlive it.
        //
        // Bound here rather than at its second use below, because the String
        // return just underneath is an *early* one and needs the same bracket.
        let arenaPlaced = aif_arena_at_node(node_to_ptr(expr)) == 1

        // Crossing back in from C. The callee is declared to return `ptr`, so the
        // length has to be supplied here -- one `strlen` at the boundary, where
        // the thin representation used to pay one per access.
        //
        // `prismio_cstr_len` rather than `__builtin_string_len`, which requires a
        // fat String while this boundary has only the raw pointer.
        //
        // The bracket goes around the *call*, not around the pair built from its
        // result: the hint steers an allocation, and `prismio_cstr_len` makes
        // none. Returning above the gate is what made every `str_concat` inside a
        // `region` come from malloc -- the arena served nothing, silently, and
        // the program still printed the right answer.
        if (isForeign and retType.equals("struct:prismio.str")) {
            if (arenaPlaced) { ir_arena_hint_begin() }
            let raw = ir_get_temp_name(ir_call_end("ptr", callName))
            if (arenaPlaced) { ir_arena_hint_end() }
            return fatFromPtr(raw)
        }

        // REQUIREMENTS 20, the other end. `list_get` is declared to return `ptr`
        // and sema types it as the element type, so for a scalar element the two
        // disagree and the value has to come back out of the slot. Handled here
        // rather than below because the call's own type is `ptr` whatever the
        // element is -- and a scalar element is never arena-placed or refcounted,
        // since it registers no site to place or count.
        if (funcName.equals("list_get") and retType.equals("ptr") == false
            and retType.equals("struct:prismio.str") == false) {
            // Resolved by value, for the reason list_get_inline_scalar gives:
            // the inline entry point returns an address and the boxed one the
            // slot's contents, and only a scalar can tell them apart.
            if (inlineSize > 0 and scalarInlineBytes(retType) > 0) {
                ir_call_arg("i32", strFromInt(inlineSize))
                let bits = ir_get_temp_name(ir_call_end("i64", "list_get_inline_scalar"))
                return scalarFromInlineBits(retType, bits)
            }
            let slot = ir_get_temp_name(ir_call_end("ptr", callName))
            return slotToScalar(retType, slot)
        }

        if (arenaPlaced) { ir_arena_hint_begin() }
        let mut tempId = ir_call_end(retType, callName)
        if (arenaPlaced) { ir_arena_hint_end() }
        let result = ir_get_temp_name(tempId)

        // After the call and before anything reads `result`, which is the whole
        // of the ordering requirement: the callee borrowed these for the call's
        // duration and `releaseTemps` has already established that none of them
        // is what came back.
        if (releaseTemps) {
            generateOwnedTemporaryReleases(ownedTempVals, ownedTempKinds, ownedTempTypes)
        }

        // AIF item 3. A container is told what it owns at construction, because
        // at teardown its elements are bare pointers and reading a header in
        // front of one would be reading memory this compilation did not allocate.
        // Stamped on the allocating call, which is the only place the site -- and
        // therefore the disposition -- is named.
        let elemOwn = aif_elem_owner_at_node(node_to_ptr(expr))
        if (elemOwn != AIF_ELEM_NONE) {
            ir_call_begin()
            ir_call_arg("ptr", result)
            ir_call_arg("i32", strFromInt(elemOwn))
            ir_call_end("void", "list_set_elem_owner")

            // Struct-field ownership. An int cannot name a type, and a container
            // of structs that own their fields needs one release per element
            // type -- so this one is told the function as well as the mode.
            if (elemOwn == AIF_ELEM_TYPED) {
                let etype = aif_elem_type_at_node(node_to_ptr(expr))
                if (etype.equals("") == false) {
                    let fnPtr = ir_func_addr(releaseFnName(etype))
                    ir_call_begin()
                    ir_call_arg("ptr", result)
                    ir_call_arg("ptr", ir_get_temp_name(fnPtr))
                    ir_call_end("void", "list_set_elem_releaser")
                }
            }
        }

        // M4.2. Inline element storage, stamped at the same place and for the
        // same reason the disposition above is: construction is the only point
        // that names the element type, and the container has to be told before
        // its first push.
        //
        // The decision is a function of the **type**, not of the list, and that
        // is deliberate. `list_get` on an inline list hands back the address of
        // an element body; pushing that address into a second list of the same
        // type must copy bytes rather than store a pointer, and it does exactly
        // that as long as both lists agree. Keying on the type is what makes
        // them agree.
        generateElemInlineStamp(expr, funcName, result)
        return result
    }

    return "0"
}

// ---------------------------------------------------------
// Trait objects
// ---------------------------------------------------------

// Building one: a pair of the value and its method table.
//
// **On the stack, unconditionally, with no AIF query.** A trait object is a
// borrow -- it cannot be stored in a field, returned, or outlive the call it is
// an argument to -- so it can never outlive the frame that builds it. That is
// exactly the condition a T0 placement states, and here it is a property of the
// language rather than something inference has to prove.
//
// The value itself is not copied and not owned. What goes in the first word is
// the pointer the argument already was.
private fn generateDynMake(e: ASTNode) -> String {
    let structName = e.s1
    let value = generateExpression(ptr_to_node(e.child1))
    let object = ir_get_temp_name(ir_alloc_stack(structName))

    ir_store_ptr("ptr", value, ir_get_temp_name(ir_struct_field_ptr(structName, object, 0)))
    let table = ir_get_temp_name(ir_vtable_addr(e.s2))
    ir_store_ptr("ptr", table, ir_get_temp_name(ir_struct_field_ptr(structName, object, 1)))
    return object
}

// Dispatching through one: read the table out of the object, take the method's
// row, and call it with the object's value standing in for the receiver.
//
// The callee is an ordinary implementation compiled against its own concrete
// type. Nothing about it knows it was reached dynamically, which is what keeps
// one implementation serving both call forms.
private fn generateDynCall(e: ASTNode) -> String {
    let object = generateExpression(ptr_to_node(e.child1))
    let value = ir_get_temp_name(ir_ptr_slot(object, 0))
    let table = ir_get_temp_name(ir_ptr_slot(object, 1))
    let method = ir_get_temp_name(ir_ptr_slot(table, e.i1))

    ir_call_begin()
    ir_call_arg("ptr", value)
    let mut argPtr = e.child2
    while (nodeExists(argPtr)) {
        let argNode = ptr_to_node(argPtr)
        let argStore = storageType(getExprType(argNode))
        ir_call_arg(argStore, generateExpression(argNode))
        argPtr = argNode.next
    }

    // **The IR storage key, not the sema key sema parked on `s2`.** The backend
    // resolves a type by its storage spelling; handing it `Int` fails with
    // "unknown type key", which is the same distinction `storageType` exists to
    // draw everywhere else in this file.
    let temp = ir_call_end_indirect(storageType(getExprType(e)), method)
    if (temp < 0) { return "" }
    return ir_get_temp_name(temp)
}
