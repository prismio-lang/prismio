// Remainders by a literal, for ir/nowrap.psm's walk: which `Int` locals a loop keeps
// inside a remainder's range, and which `%` the facts let codegen replace with a
// conditional add or subtract.
//
// `x % m` for a literal `m >= 1` is a signed remainder: it has the dividend's sign and
// a magnitude below `m`, so it lies in [-(m - 1), m - 1] whatever `x` was. A local
// every assignment in a loop sets to such a remainder, and which entered the loop
// inside that range, is inside it at the head of every iteration -- no induction over
// the body is needed, because no assignment can leave the range. That is the fact the
// head would otherwise lose. A checksum is the case:
//
//     checksum = (checksum + value) % 1000000007
//
// With `checksum` in (-m, m) and `value` a remainder by 997, the dividend lies in
// (-2m, 2m). On that range the remainder is one step: `x >= m` subtracts `m`,
// `x <= -m` adds it, anything else is already the result. LLVM cannot see it -- the
// range of a loop-carried value is not one it tracks -- and emits the remainder as a
// multiply by a magic constant: `smull; asr; add; msub`, about eleven cycles on the
// loop-carried chain. Measured in C, 4M iterations of the loop above: `%` 9.71 ms,
// the two-sided select 4.03 ms, the one-sided one (dividend known non-negative)
// 3.04 ms.
//
// The forms are exact, not approximations: each is the remainder for every dividend
// in its range, and a dividend outside every range keeps the `srem`. Neither the add
// nor the subtract is `nsw`; the one whose condition is false may wrap, and the
// select discards it.

import ast.nodes
import ast.types
import std.string

// What a `%` by `m` is, given the range of its dividend.
const REM_KEEP = 0
// The dividend is in (-m, m): it is its own remainder.
const REM_IDENTITY = 1
// In (-m, 2m): subtract `m` from one at or above it.
const REM_SUBTRACT = 2
// In (-2m, m): add `m` to one at or below -m.
const REM_ADD = 3
// In (-2m, 2m): both.
const REM_BOTH = 4
// At zero or above, over a divisor above zero, and too far from the result for a step:
// a `%` or `/` that may ignore signs, `urem`'s or `udiv`'s answer being the same.
const REM_UNSIGNED = 5
// A divisor `2^k - 1` and a dividend within 2^(2k - 1) of zero; see mersenneForm.
const REM_MERSENNE = 6
const REM_MERSENNE_SIGNED = 7
// A divisor the facts put clear of 0 and -1: a plain `srem` or `sdiv`, with no check.
const REM_SAFE_DIVISOR = 8

// The form a remainder by `m` takes on a dividend in [lo, hi].
internal fn remainderForm(lo: I64, hi: I64, m: Int) -> Int {
    if (m < 2) { return REM_KEEP }
    let one = m as I64
    let two = one + one
    if (lo > 0 - one and hi < one) { return REM_IDENTITY }
    if (lo > 0 - one and hi < two) { return REM_SUBTRACT }
    if (lo > 0 - two and hi < one) { return REM_ADD }
    if (lo > 0 - two and hi < two) { return REM_BOTH }
    return REM_KEEP
}

// A remainder by a Mersenne number needs no multiply. `2^k` is 1 more than `m`, so for
// `x = q * 2^k + r`, `x` and `q + r` have the same remainder, and `q` and `r` are a shift
// and a mask:
//
//     t = (x >> k) + (x & m)
//
// With `x` within 2^(2k - 1) of zero that puts `t` within one step of the answer, and the
// step depends only on the side of zero `x` is on, since a signed remainder has the
// dividend's sign: at zero or above `t >= m` subtracts `m`, and below zero `t >= 1` does.
// Four cycles from `x` to the answer, against nine for `smulh; asr; add; msub`, and the
// MINSTD generator's state goes round a loop through exactly this. Measured in C on
// graph_churn_single, whose generator is the benchmark's critical path: 0.87x.
//
// The dividend's sign costs a compare and a select where a fact does not settle it, which
// is why this does not need one: a generator's state starts positive, but no interval walk
// can see that across the calls it goes through.
internal fn mersenneForm(lo: I64, hi: I64, m: Int) -> Int {
    let k = mersenneBits(m)
    if (k == 0) { return REM_KEEP }
    let reach = (1 as I64) << ((2 * k - 1) as I64)
    if (lo >= 0 as I64 and hi <= reach) { return REM_MERSENNE }
    if (lo >= 0 - reach and hi <= reach) { return REM_MERSENNE_SIGNED }
    return REM_KEEP
}

// `k` when `m` is `2^k - 1` with `k` at least 2, otherwise 0.
internal fn mersenneBits(m: Int) -> Int {
    if (m < 3) { return 0 }
    let mut k = 0
    let mut rest = m
    while (rest > 0) {
        if (rest % 2 == 0) { return 0 }
        rest = rest / 2
        k = k + 1
    }
    return k
}

// The divisor of `x % m` with a literal `m >= 1` on a signed `Int` or `I64`, or 0.
internal fn remainderDivisor(e: ASTNode) -> Int {
    if (e.kind != NodeKind.BINARY_EXPR or e.s1.equals("%") == false) { return 0 }
    if (nodeIsNull(e.child1) or nodeIsNull(e.child2)) { return 0 }
    if (nowrapIsSignedDivision(e) == false) { return 0 }
    return remainderLiteral(ptr_to_node(e.child2))
}

// A positive `Int` literal, or 0. Wider than nowrapLiteral's nine digits, because a
// divisor is never added to anything here: the steps compare with `m` and `-m`, and
// the ranges reach `2m`, which an i64 holds for every `Int`. The usual checksum
// modulus, 1000000007, is ten.
private fn remainderLiteral(n: ASTNode) -> Int {
    if (n.kind != NodeKind.LITERAL_EXPR or n.i1 != TokenType.NUMBER_LITERAL as Int) { return 0 }
    if (n.s1.length > 10) { return 0 }
    let value = n.s1.parseIntOr(0)
    if (value < 1 or value != n.s1.parseIntOr(1)) { return 0 }
    return value
}

// The locals a loop keeps inside a remainder's range, with that range: every name
// the condition and body assign only remainders by a literal, read before the head
// forgets what the loop assigns.
struct LoopResidues {
    internal names: Vec<String>,
    // The largest divisor any of the name's assignments uses, or -1 once something
    // else assigns or binds it.
    internal divisors: Vec<Int>
}

internal fn loopResidues(condPtr: Ptr, bodyPtr: Ptr) -> LoopResidues {
    let r = LoopResidues { names: [], divisors: [] }
    r.scan(condPtr)
    r.scan(bodyPtr)
    return r
}

impl LoopResidues {
    private fn slot(self, name: String) -> Int {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) { return i }
        }
        self.names.push(name.clone())
        self.divisors.push(0)
        return self.names.length - 1
    }
}

impl LoopResidues {
    private fn note(self, name: String, divisor: Int) {
        let at = self.slot(name)
        if (self.divisors[at] < 0) { return }
        if (divisor < 1) {
            self.divisors[at] = 0 - 1
            return
        }
        if (divisor > self.divisors[at]) { self.divisors[at] = divisor }
    }
}

impl LoopResidues {
    // Every assignment and binding under one node, as nowrapKillBound finds them: a
    // closure assigns nothing outside itself, since it captures by value.
    private fn scan(self, nodePtr: Ptr) {
        if (nodeIsNull(nodePtr)) { return }
        let n = ptr_to_node(nodePtr)
        if (n.kind == NodeKind.CLOSURE_EXPR) { return }
        if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
            let target = ptr_to_node(n.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR) {
                let mut divisor = 0
                if (nodeExists(n.child2)) { divisor = remainderDivisor(ptr_to_node(n.child2)) }
                self.note(target.s1, divisor)
            }
        }
        if (n.kind == NodeKind.VARIABLE_DECL) { self.note(n.s1, 0) }
        if (n.kind == NodeKind.FOR_STATEMENT) {
            self.note(n.s1, 0)
            self.note(n.s2, 0)
        }
        if (n.kind == NodeKind.MATCH_ARM) { self.bindAll(n.child1) }
        self.scanChain(n.child1)
        self.scanChain(n.child2)
        self.scanChain(n.child3)
    }
}

impl LoopResidues {
    private fn scanChain(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            self.scan(p)
            p = ptr_to_node(p).next
        }
    }
}

impl LoopResidues {
    // Every name a pattern mentions, any of which it may bind.
    private fn bindAll(self, nodePtr: Ptr) {
        let mut p = nodePtr
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.IDENTIFIER_EXPR) { self.note(n.s1, 0) }
            self.bindAll(n.child1)
            self.bindAll(n.child2)
            self.bindAll(n.child3)
            p = n.next
        }
    }
}

impl LoopResidues {
    // The range `name` keeps at the loop's head given its range [lo, hi] where the
    // loop is entered, into `out` as [lo, hi]; false when the loop does not keep it.
    internal fn headRange(self, name: String, lo: I64, hi: I64, out: ResidueRange) -> Bool {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) {
                let m = self.divisors[i]
                if (m < 1) { return false }
                let bound = (m - 1) as I64
                out.lo = lo
                out.hi = hi
                if (0 - bound < out.lo) { out.lo = 0 - bound }
                if (bound > out.hi) { out.hi = bound }
                return true
            }
        }
        return false
    }
}

// The immutable `let`s a division names: `let x = a % c` and `let y = a / c`, with `a` an
// immutable `let` and `c` a literal or one. Each name's value is tied to `a`'s for as long
// as the name is in scope, so what a comparison says of `x` or `y` it says of `a`:
//
//     let node = queue[head]; let x = node % width; let y = node / width
//     if (x > 0) { next = node - 1 }                 // node >= 1
//     if (x + 1 < width) { next = node + 1 }         // node is not the last of its row
//     if (y > 0) { next = node - width }             // node >= width
//     if (y + 1 < width) { next = node + width }     // node is not in the last row
//
// Every name involved must be bound once in the function, which is what lets a walk that
// resolves by name read the tie at any mention.
struct DivisionLets {
    internal names: Vec<String>,
    internal bases: Vec<String>,
    internal divisors: Vec<Ptr>,
    internal remainders: Vec<Bool>
}

internal fn divisionLetsCollect(func: ASTNode) -> DivisionLets {
    let d = DivisionLets { names: [], bases: [], divisors: [], remainders: [] }
    let c = LetCensus { names: [], counts: [], immutable: [] }
    c.scan(func.child1)
    c.scan(func.child2)
    d.collect(func.child2, c)
    return d
}

// How many times the function binds each name, and whether its one binding is a `let`.
struct LetCensus {
    internal names: Vec<String>,
    internal counts: Vec<Int>,
    internal immutable: Vec<Bool>
}

impl LetCensus {
    private fn note(self, name: String, immutable: Bool) {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) {
                self.counts[i] = self.counts[i] + 1
                return
            }
        }
        self.names.push(name.clone())
        self.counts.push(1)
        self.immutable.push(immutable)
    }
}

impl LetCensus {
    private fn scan(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.VARIABLE_DECL) { self.note(n.s1, n.i1 != 1) }
            if (n.kind == NodeKind.FUNCTION_PARAMETER) { self.note(n.s1, false) }
            if (n.kind == NodeKind.FOR_STATEMENT) {
                self.note(n.s1, false)
                self.note(n.s2, false)
            }
            if (n.kind == NodeKind.MATCH_ARM) { self.scanPattern(n.child1) }
            self.scan(n.child1)
            self.scan(n.child2)
            self.scan(n.child3)
            p = n.next
        }
    }
}

impl LetCensus {
    // A pattern may bind any name it mentions.
    private fn scanPattern(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.IDENTIFIER_EXPR) {
                self.note(n.s1, false)
                self.note(n.s1, false)
            }
            self.scanPattern(n.child1)
            self.scanPattern(n.child2)
            self.scanPattern(n.child3)
            p = n.next
        }
    }
}

impl LetCensus {
    // Bound once in the function, as an immutable `let`.
    private fn fixed(self, name: String) -> Bool {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) { return self.counts[i] == 1 and self.immutable[i] }
        }
        return false
    }
}

impl DivisionLets {
    private fn collect(self, head: Ptr, c: LetCensus) {
        let mut p = head
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.VARIABLE_DECL and nodeExists(n.child2)) { self.consider(n, c) }
            self.collect(n.child1, c)
            self.collect(n.child2, c)
            self.collect(n.child3, c)
            p = n.next
        }
    }
}

impl DivisionLets {
    private fn consider(self, decl: ASTNode, c: LetCensus) {
        let init = ptr_to_node(decl.child2)
        if (init.kind != NodeKind.BINARY_EXPR or nodeIsNull(init.child1) or nodeIsNull(init.child2)) { return }
        let isRemainder = init.s1.equals("%")
        if (isRemainder == false and init.s1.equals("/") == false) { return }
        if (nowrapIsIntName(init) == false or c.fixed(decl.s1) == false) { return }
        let base = ptr_to_node(init.child1)
        if (base.kind != NodeKind.IDENTIFIER_EXPR or c.fixed(base.s1) == false) { return }
        let divisor = ptr_to_node(init.child2)
        if (divisor.kind == NodeKind.IDENTIFIER_EXPR) {
            if (c.fixed(divisor.s1) == false) { return }
        } else if (divisor.kind != NodeKind.LITERAL_EXPR) {
            return
        }
        self.names.push(decl.s1.clone())
        self.bases.push(base.s1.clone())
        self.divisors.push(init.child2)
        self.remainders.push(isRemainder)
    }
}

impl DivisionLets {
    internal fn find(self, name: String) -> Int {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) { return i }
        }
        return 0 - 1
    }
}

struct ResidueRange {
    internal lo: I64,
    internal hi: I64
}

internal fn residueRangeNew() -> ResidueRange {
    return ResidueRange { lo: 0 as I64, hi: 0 as I64 }
}
