// Remainders by a literal, for ir/nowrap.psm's walk: which `Int` locals a loop keeps
// inside a remainder's range, and which `%` the facts let codegen replace with a
// conditional add or subtract.
//
// `x % m` for a literal `m >= 1` is a signed remainder: it has the dividend's sign and
// a magnitude below `m`, so it lies in [-(m - 1), m - 1] whatever `x` was. A local
// every assignment in a loop sets to such a remainder, and which entered the loop
// inside that range, is inside it at the head of every iteration -- no induction over
// the body is needed, because no assignment can leave the range. That is the fact the
// head would otherwise lose. A checksum is the case:
//
//     checksum = (checksum + value) % 1000000007
//
// With `checksum` in (-m, m) and `value` a remainder by 997, the dividend lies in
// (-2m, 2m). On that range the remainder is one step: `x >= m` subtracts `m`,
// `x <= -m` adds it, anything else is already the result. LLVM cannot see it -- the
// range of a loop-carried value is not one it tracks -- and emits the remainder as a
// multiply by a magic constant: `smull; asr; add; msub`, about eleven cycles on the
// loop-carried chain. Measured in C, 4M iterations of the loop above: `%` 9.71 ms,
// the two-sided select 4.03 ms, the one-sided one (dividend known non-negative)
// 3.04 ms.
//
// The forms are exact, not approximations: each is the remainder for every dividend
// in its range, and a dividend outside every range keeps the `srem`. Neither the add
// nor the subtract is `nsw`; the one whose condition is false may wrap, and the
// select discards it.

import ast.nodes
import ast.types
import std.string

// What a `%` by `m` is, given the range of its dividend.
let REM_KEEP = 0
// The dividend is in (-m, m): it is its own remainder.
let REM_IDENTITY = 1
// In (-m, 2m): subtract `m` from one at or above it.
let REM_SUBTRACT = 2
// In (-2m, m): add `m` to one at or below -m.
let REM_ADD = 3
// In (-2m, 2m): both.
let REM_BOTH = 4

// The form a remainder by `m` takes on a dividend in [lo, hi].
internal fn remainderForm(lo: I64, hi: I64, m: Int) -> Int {
    if (m < 2) { return REM_KEEP }
    let one = m as I64
    let two = one + one
    if (lo > 0 - one and hi < one) { return REM_IDENTITY }
    if (lo > 0 - one and hi < two) { return REM_SUBTRACT }
    if (lo > 0 - two and hi < one) { return REM_ADD }
    if (lo > 0 - two and hi < two) { return REM_BOTH }
    return REM_KEEP
}

// The divisor of `x % m` with a literal `m >= 1` on signed `Int`, or 0.
internal fn remainderDivisor(e: ASTNode) -> Int {
    if (e.kind != NodeKind.BINARY_EXPR or e.s1.equals("%") == false) { return 0 }
    if (nodeIsNull(e.child1) or nodeIsNull(e.child2)) { return 0 }
    if (nowrapIsIntName(e) == false) { return 0 }
    return remainderLiteral(ptr_to_node(e.child2))
}

// A positive `Int` literal, or 0. Wider than nowrapLiteral's nine digits, because a
// divisor is never added to anything here: the steps compare with `m` and `-m`, and
// the ranges reach `2m`, which an i64 holds for every `Int`. The usual checksum
// modulus, 1000000007, is ten.
private fn remainderLiteral(n: ASTNode) -> Int {
    if (n.kind != NodeKind.LITERAL_EXPR or n.i1 != TokenType.NUMBER_LITERAL as Int) { return 0 }
    if (n.s1.length > 10) { return 0 }
    let value = n.s1.parseIntOr(0)
    if (value < 1 or value != n.s1.parseIntOr(1)) { return 0 }
    return value
}

// The locals a loop keeps inside a remainder's range, with that range: every name
// the condition and body assign only remainders by a literal, read before the head
// forgets what the loop assigns.
struct LoopResidues {
    internal names: Vec<String>,
    // The largest divisor any of the name's assignments uses, or -1 once something
    // else assigns or binds it.
    internal divisors: Vec<Int>
}

internal fn loopResidues(condPtr: Ptr, bodyPtr: Ptr) -> LoopResidues {
    let r = LoopResidues { names: [], divisors: [] }
    r.scan(condPtr)
    r.scan(bodyPtr)
    return r
}

impl LoopResidues {
    private fn slot(self, name: String) -> Int {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) { return i }
        }
        self.names.push(name.clone())
        self.divisors.push(0)
        return self.names.length - 1
    }
}

impl LoopResidues {
    private fn note(self, name: String, divisor: Int) {
        let at = self.slot(name)
        if (self.divisors[at] < 0) { return }
        if (divisor < 1) {
            self.divisors[at] = 0 - 1
            return
        }
        if (divisor > self.divisors[at]) { self.divisors[at] = divisor }
    }
}

impl LoopResidues {
    // Every assignment and binding under one node, as nowrapKillBound finds them: a
    // closure assigns nothing outside itself, since it captures by value.
    private fn scan(self, nodePtr: Ptr) {
        if (nodeIsNull(nodePtr)) { return }
        let n = ptr_to_node(nodePtr)
        if (n.kind == NodeKind.CLOSURE_EXPR) { return }
        if (n.kind == NodeKind.ASSIGNMENT_STATEMENT and nodeExists(n.child1)) {
            let target = ptr_to_node(n.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR) {
                let mut divisor = 0
                if (nodeExists(n.child2)) { divisor = remainderDivisor(ptr_to_node(n.child2)) }
                self.note(target.s1, divisor)
            }
        }
        if (n.kind == NodeKind.VARIABLE_DECL) { self.note(n.s1, 0) }
        if (n.kind == NodeKind.FOR_STATEMENT) {
            self.note(n.s1, 0)
            self.note(n.s2, 0)
        }
        if (n.kind == NodeKind.MATCH_ARM) { self.bindAll(n.child1) }
        self.scanChain(n.child1)
        self.scanChain(n.child2)
        self.scanChain(n.child3)
    }
}

impl LoopResidues {
    private fn scanChain(self, head: Ptr) {
        let mut p = head
        while (nodeExists(p)) {
            self.scan(p)
            p = ptr_to_node(p).next
        }
    }
}

impl LoopResidues {
    // Every name a pattern mentions, any of which it may bind.
    private fn bindAll(self, nodePtr: Ptr) {
        let mut p = nodePtr
        while (nodeExists(p)) {
            let n = ptr_to_node(p)
            if (n.kind == NodeKind.IDENTIFIER_EXPR) { self.note(n.s1, 0) }
            self.bindAll(n.child1)
            self.bindAll(n.child2)
            self.bindAll(n.child3)
            p = n.next
        }
    }
}

impl LoopResidues {
    // The range `name` keeps at the loop's head given its range [lo, hi] where the
    // loop is entered, into `out` as [lo, hi]; false when the loop does not keep it.
    internal fn headRange(self, name: String, lo: I64, hi: I64, out: ResidueRange) -> Bool {
        for i in 0..<self.names.length {
            let known: String = self.names[i]
            if (known.equals(name)) {
                let m = self.divisors[i]
                if (m < 1) { return false }
                let bound = (m - 1) as I64
                out.lo = lo
                out.hi = hi
                if (0 - bound < out.lo) { out.lo = 0 - bound }
                if (bound > out.hi) { out.hi = bound }
                return true
            }
        }
        return false
    }
}

struct ResidueRange {
    internal lo: I64,
    internal hi: I64
}

internal fn residueRangeNew() -> ResidueRange {
    return ResidueRange { lo: 0 as I64, hi: 0 as I64 }
}
