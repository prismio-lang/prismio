// IR Generator
// Traverses the AST and emits LLVM IR via bridge.psm
// Uses C-side global registry to avoid Prismio string globals

import types

let mut ir_string_counter = 0
let mut ir_target_wasm = false
let mut ir_short_circuit_counter = 0

// The body of the function being generated, so a droppable candidate can ask
// whether the binding is ever reassigned. See node_assigns_name.
let mut ir_function_body = ""

// AIF's T0. The only tier codegen currently acts on -- everything else keeps
// the allocator hook it always used. Kept as a named constant here rather than
// imported so that ir.psm depends on the memory model's *answer* and not on its
// implementation; aif.psm owns the encoding.
let AIF_TIER_T0 = 0

// AIF Level 4. Which deallocator reclaims a droppable binding. Everything the
// allocator seam handed out is IR_DROP_OBJECT; a List is two allocations and
// needs the runtime's own release, so the drop list has to carry the answer --
// by the time it is read, a String and a List are both `ptr`.
let IR_DROP_OBJECT = 0
let IR_DROP_LIST = 1

// Where a value the memory model inferred lives, keyed by the AST node that
// allocates it -- both passes walk the same tree, so the node is a name for the
// expression that cannot collide. -1 means no inference ran for this node; see
// the use site in generate_expression.
extern fn aif_tier_at_node(node: String borrow) -> Int

// Whether the value this node allocates dies with the scope that allocates it,
// which is what licenses a free at that scope's exits. Not derivable from the
// tier: T1 is "some region", and it may be an enclosing one.
extern fn aif_frees_at_scope_node(node: String borrow) -> Int

// Whether it may come from the enclosing `region`'s arena instead of the heap.
// Stricter than "is inside a region block": the value must also be unable to
// outlive that region, which a nested region makes a real question.
extern fn aif_arena_at_node(node: String borrow) -> Int

// Whether the cost model placed an arena at this block (LAYOUT 7.1). A `region`
// statement answers 0 here -- codegen already brackets that one by keyword, and
// bracketing it twice would push two arenas and pop one.
extern fn aif_auto_arena_at_node(node: String borrow) -> Int

extern fn exit(code: Int)

// Forward declarations for mutual recursion
extern fn generate_short_circuit(expr: ASTNode) -> String
extern fn generate_statement(stmt: ASTNode)
extern fn generate_block(block: ASTNode)
extern fn collect_strings_stmt(stmt: ASTNode)
extern fn collect_strings_block(block: ASTNode)
extern fn chain_assigns_name(head: String, name: String) -> Bool

fn ir_set_target_wasm(enabled: Bool) {
    ir_target_wasm = enabled
}

fn ir_ptr_int_type() -> String {
    if (ir_target_wasm) { return "i32" }
    return "i64"
}

fn map_type(t: String) -> String {
    if (str_equals(t, "Int") == 1) { return "i32" }
    if (str_equals(t, "Float") == 1) { return "double" }
    if (str_equals(t, "Bool") == 1) { return "i1" }
    if (str_equals(t, "String") == 1) { return "ptr" }
    if (str_equals(t, "Char") == 1) { return "i8" }
    if (str_equals(t, "I8") == 1) { return "i8" }
    if (str_equals(t, "I16") == 1) { return "i16" }
    if (str_equals(t, "I64") == 1) { return "i64" }
    if (str_equals(t, "Isize") == 1) { return ir_ptr_int_type() }
    if (str_equals(t, "U8") == 1) { return "i8" }
    if (str_equals(t, "U16") == 1) { return "i16" }
    if (str_equals(t, "U32") == 1) { return "i32" }
    if (str_equals(t, "U64") == 1) { return "i64" }
    if (str_equals(t, "Usize") == 1) { return ir_ptr_int_type() }
    if (str_equals(t, "") == 1) { return "void" }
    return "i32"
}

fn struct_type_key(name: String) -> String {
    return str_concat("struct:", name)
}

fn is_struct_type_key(t: String) -> Bool {
    return str_starts_with(t, "struct:") == 1
}

fn struct_type_name(t: String) -> String {
    return str_substring(t, 7, str_length(t) - 7)
}

fn llvm_type_name(t: String) -> String {
    if (is_struct_type_key(t)) {
        return str_concat("%", struct_type_name(t))
    }
    return t
}

fn map_type_node(tn: ASTNode) -> String {
    if (tn.i2 == 1) {
        return "ptr"            // List<T>
    }
    if (tn.i1 == 1) {
        if (str_equals(tn.child1, "") == 0) {
            let elem = ptr_to_node(tn.child1)
            if (elem.i1 == 1) {
                return "ptrptr"
            }
        }
        return "ptr"
    }
    if (ir_is_struct_type_name(tn.s1) == 1) {
        return struct_type_key(tn.s1)
    }
    return map_type(tn.s1)
}

fn storage_type(t: String) -> String {
    if (str_equals(t, "ptrptr") == 1) { return "ptr" }
    if (is_struct_type_key(t)) { return "ptr" }
    return t
}

fn count_list_nodes(first_ptr: String) -> Int {
    let mut count = 0
    let mut curr = first_ptr
    while (str_equals(curr, "") == 0) {
        let node = ptr_to_node(curr)
        count = count + 1
        curr = node.next
    }
    return count
}

fn fn_key(name: String) -> String {
    return str_concat("$fn$", name)
}

fn function_symbol_name(func: ASTNode) -> String {
    if (str_equals(func.s2, "") == 0) {
        return func.s2
    }
    return func.s1
}

fn get_declared_return_type(node: ASTNode, ret_child: String) -> String {
    if (str_equals(ret_child, "") == 0) {
        let ret_node = ptr_to_node(ret_child)
        return map_type_node(ret_node)
    }
    return "void"
}

fn get_expr_type(expr: ASTNode) -> String {
    if (node_has_type(expr)) {
        return type_ir_key(node_get_type(expr))
    }

    if (expr.kind == NodeKind.LITERAL_EXPR) {
        if (expr.i1 == TokenType.NUMBER_LITERAL) { return "i32" }
        if (expr.i1 == TokenType.FLOAT_LITERAL) { return "double" }
        if (expr.i1 == TokenType.BOOL_LITERAL) { return "i1" }
        if (expr.i1 == TokenType.CHAR_LITERAL) { return "i8" }
        if (expr.i1 == TokenType.STRING_LITERAL) { return "ptr" }
    }

    if (expr.kind == NodeKind.IDENTIFIER_EXPR) {
        return ir_get_var_type(expr.s1)
    }

    if (expr.kind == NodeKind.UNARY_EXPR) {
        if (str_equals(expr.s1, "!") == 1) { return "i1" }
        return get_expr_type(ptr_to_node(expr.child1))
    }

    if (expr.kind == NodeKind.CAST_EXPR) {
        // sema records the target type on the node; this is only the fallback.
        return map_type_node(ptr_to_node(expr.child2))
    }

    if (expr.kind == NodeKind.BINARY_EXPR) {
        let op = expr.s1
        if (str_equals(op, "==") == 1 or str_equals(op, "!=") == 1) { return "i1" }
        if (str_equals(op, "<") == 1 or str_equals(op, "<=") == 1) { return "i1" }
        if (str_equals(op, ">") == 1 or str_equals(op, ">=") == 1) { return "i1" }
        if (str_equals(op, "and") == 1 or str_equals(op, "or") == 1) { return "i1" }
        return get_expr_type(ptr_to_node(expr.child1))
    }

    if (expr.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(expr.child1)
        let func_name = callee.s1
        if (str_equals(func_name, "print") == 1 or str_equals(func_name, "println") == 1) {
            return "void"
        }
        if (str_equals(func_name, "print_int") == 1 or str_equals(func_name, "println_int") == 1) {
            return "void"
        }
        if (str_equals(func_name, "print_float") == 1 or str_equals(func_name, "println_float") == 1) {
            return "void"
        }
        if (str_equals(func_name, "println_char") == 1 or str_equals(func_name, "print_char") == 1) {
            return "void"
        }
        if (str_equals(func_name, "println_bool") == 1 or str_equals(func_name, "print_bool") == 1) {
            return "void"
        }
        if (str_equals(expr.s2, "") == 0) {
            return ir_get_var_type(fn_key(expr.s2))
        }
        return ir_get_var_type(fn_key(func_name))
    }

    if (expr.kind == NodeKind.INDEX_EXPR) {
        let obj_type = get_expr_type(ptr_to_node(expr.child1))
        if (str_equals(obj_type, "ptrptr") == 1) {
            return "ptr"
        }
        return "i32"
    }

    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let object_node = ptr_to_node(expr.child1)
        if (object_node.kind == NodeKind.IDENTIFIER_EXPR) {
            let enum_val = ir_get_enum_variant(object_node.s1, expr.s1)
            if (enum_val >= 0) {
                return "i32"
            }
        }
        let object_type = get_expr_type(object_node)
        if (is_struct_type_key(object_type)) {
            return ir_get_struct_field_type(struct_type_name(object_type), expr.s1)
        }
        return "i32"
    }

    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        return "ptr"
    }

    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        return struct_type_key(expr.s1)
    }

    return "i32"
}

// `and` / `or` with the right-hand side evaluated only when it can change the
// answer. Previously both operands were generated unconditionally and combined
// with a plain `and`/`or` instruction, so `p != "" and deref(p)` evaluated
// deref(p) even when p was empty. That is a semantics bug rather than a missed
// optimisation, and the compiler's own guards in sema.psm are written assuming
// short-circuiting -- `print()` with no arguments used to segfault the compiler
// for exactly this reason.
//
// The result travels through a stack slot rather than a phi: the bridge has no
// phi primitive, and mem2reg turns this back into one anyway. The slot is named
// with a dot, which no Prismio identifier can contain, so it can never collide
// with a user variable.
fn generate_short_circuit(expr: ASTNode) -> String {
    let is_and = str_equals(expr.s1, "and") == 1

    let slot = str_concat("sc.", int_to_str(ir_short_circuit_counter))
    ir_short_circuit_counter = ir_short_circuit_counter + 1
    ir_alloca("i1", slot)

    let rhs_label = ir_get_label()
    let done_label = ir_get_label()

    // Seed the slot with the left result, so the short-circuit path already has
    // the right answer: `false and _` is false, `true or _` is true.
    let left_val = generate_expression(ptr_to_node(expr.child1))
    ir_store("i1", left_val, slot)
    if (is_and) {
        ir_cond_br_numbered(left_val, rhs_label, done_label)
    } else {
        ir_cond_br_numbered(left_val, done_label, rhs_label)
    }

    ir_label_numbered(rhs_label)
    let right_val = generate_expression(ptr_to_node(expr.child2))
    ir_store("i1", right_val, slot)
    ir_br_numbered(done_label)

    ir_label_numbered(done_label)
    let result_id = ir_load("i1", slot)
    return ir_get_temp_name(result_id)
}

// Whether `name` is ever the target of an assignment inside the function being
// generated.
//
// A binding is droppable because its *initialiser* allocated something this
// scope owns -- but what the drop frees is the slot, and an assignment can put
// something else in it. `s = node.name` leaves a borrowed pointer where the exit
// expects an owned one, which is a free of a value the AST still holds. AIF
// Level 4 made that reachable everywhere: strings are reassigned constantly and
// a field read is a borrow.
//
// Asked at the declaration rather than at the assignment, because codegen is a
// single forward walk and the run-time order is not the source order: a `break`
// written above the assignment still executes after it on the second iteration.
//
// Deliberately syntactic and deliberately blunt. A reassigned binding is not
// droppable even when every value it receives is owned -- that case leaks today
// regardless, since there is no drop on reassignment, so the strictness costs
// nothing that is not already lost.
fn node_assigns_name(node_ptr: String, name: String) -> Bool {
    if (str_equals(node_ptr, "") == 1) { return false }
    let n = ptr_to_node(node_ptr)

    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        if (str_equals(n.child1, "") == 0) {
            let target = ptr_to_node(n.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR and str_equals(target.s1, name) == 1) {
                return true
            }
        }
    }

    if (chain_assigns_name(n.child1, name)) { return true }
    if (chain_assigns_name(n.child2, name)) { return true }
    return chain_assigns_name(n.child3, name)
}

fn chain_assigns_name(head: String, name: String) -> Bool {
    let mut p = head
    while (str_equals(p, "") == 0) {
        let n = ptr_to_node(p)
        if (node_assigns_name(p, name)) { return true }
        p = n.next
    }
    return false
}

// Which deallocator an expression's value needs. Read from sema's type rather
// than the storage type, which has already collapsed String, List and every
// struct to `ptr`.
fn drop_kind_of(expr: ASTNode) -> Int {
    if (node_get_type(expr).kind == TypeKind.LIST) { return IR_DROP_LIST }
    return IR_DROP_OBJECT
}

fn generate_expression(expr: ASTNode) -> String {
    if (expr.kind == NodeKind.LITERAL_EXPR) {
        if (expr.i1 == TokenType.NUMBER_LITERAL) {
            return expr.s1
        }
        if (expr.i1 == TokenType.FLOAT_LITERAL) {
            return expr.s1
        }
        if (expr.i1 == TokenType.BOOL_LITERAL) {
            if (str_equals(expr.s1, "true") == 1) { return "1" }
            return "0"
        }
        if (expr.i1 == TokenType.CHAR_LITERAL) {
            return expr.s1
        }
        if (expr.i1 == TokenType.STRING_LITERAL) {
            // The literal's global was named by the collect_strings pre-pass.
            return ir_get_temp_name(ir_string_ptr(expr.s2))
        }
    }

    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        let struct_name = expr.s1

        // AIF decides where this value lives. T0 means the analysis proved it
        // does not outlive the frame that creates it, so it gets a stack slot
        // and no allocation call at all; every other tier still goes through the
        // backend's allocator hook, which is what it did before AIF existed.
        //
        // A tier of -1 is "no information" -- a build that ran no inference, or
        // an expression the walk never reached. That has to keep the old
        // behaviour exactly, because it is what makes SPEC 7.1's zero-analysis
        // mode behaviourally identical rather than merely intended to be.
        let mut alloc_temp = 0
        if (aif_arena_at_node(node_to_ptr(expr)) == 1) {
            // T1 inside a `region` it cannot outlive: bump from the arena, and
            // the whole block goes back at the region's exit rather than one
            // object at a time.
            alloc_temp = ir_alloc_region(struct_name)
        } else if (aif_tier_at_node(node_to_ptr(expr)) == AIF_TIER_T0) {
            alloc_temp = ir_alloc_stack(struct_name)
        } else {
            alloc_temp = ir_alloc_object(struct_name)
        }
        let mem_name = ir_get_temp_name(alloc_temp)

        let mut field_ptr = expr.child1
        while (str_equals(field_ptr, "") == 0) {
            let field = ptr_to_node(field_ptr)
            let field_val = generate_expression(ptr_to_node(field.child1))
            let field_type = storage_type(ir_get_struct_field_type(struct_name, field.s1))
            let field_index = ir_get_struct_field_index(struct_name, field.s1)
            let slot = ir_struct_field_ptr(struct_name, mem_name, field_index)
            ir_store_ptr(field_type, field_val, ir_get_temp_name(slot))
            field_ptr = field.next
        }

        return mem_name
    }
    
    if (expr.kind == NodeKind.IDENTIFIER_EXPR) {
        let val_type = ir_get_var_type(expr.s1)
        let load_type = storage_type(val_type)
        // Shadowing-aware: a local named the same as a global must read from
        // the local's slot. Asking a flat "is this name a global?" registry
        // instead meant writes went to the local and reads came from the global.
        if (ir_var_is_global(expr.s1) == 1) {
            return ir_get_temp_name(ir_load_global(load_type, expr.s1))
        }
        return ir_get_temp_name(ir_load(load_type, ir_get_var_slot(expr.s1)))
    }

    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        let object_node = ptr_to_node(expr.child1)
        if (object_node.kind == NodeKind.IDENTIFIER_EXPR) {
            let enum_val = ir_get_enum_variant(object_node.s1, expr.s1)
            if (enum_val >= 0) {
                return int_to_str(enum_val)
            }
        }

        let object_val = generate_expression(object_node)
        let object_type = get_expr_type(object_node)
        let struct_name = struct_type_name(object_type)
        let field_index = ir_get_struct_field_index(struct_name, expr.s1)
        let field_type = storage_type(ir_get_struct_field_type(struct_name, expr.s1))

        let slot = ir_struct_field_ptr(struct_name, object_val, field_index)
        return ir_get_temp_name(ir_load_ptr(field_type, ir_get_temp_name(slot)))
    }

    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let elem_count = count_list_nodes(expr.child1)
        let first_elem = ptr_to_node(expr.child1)

        // The element type comes from sema, which knows what the elements
        // actually are. It used to be hardcoded to i32 (or ptr for an array of
        // arrays), so ["a", "b"] stored pointers into i32 slots -- truncating
        // them -- and [1.5, 2.5] stored doubles into i32 slots.
        let arr_t = node_get_type(expr)
        let mut elem_type = "i32"
        if (str_equals(arr_t.child, "") == 0) {
            elem_type = storage_type(type_ir_key(ptr_to_type(arr_t.child)))
        } else if (first_elem.kind == NodeKind.ARRAY_LITERAL_EXPR) {
            elem_type = "ptr"
        }

        let base = ir_get_temp_name(ir_array_alloca(elem_type, elem_count))

        let mut elem_ptr = expr.child1
        let mut elem_index = 0
        while (str_equals(elem_ptr, "") == 0) {
            let elem_node = ptr_to_node(elem_ptr)
            let elem_val = generate_expression(elem_node)
            let slot = ir_elem_ptr(elem_type, base, int_to_str(elem_index))
            ir_store_ptr(elem_type, elem_val, ir_get_temp_name(slot))
            elem_index = elem_index + 1
            elem_ptr = elem_node.next
        }

        return base
    }

    if (expr.kind == NodeKind.INDEX_EXPR) {
        let array_val = generate_expression(ptr_to_node(expr.child1))
        let index_val = generate_expression(ptr_to_node(expr.child2))

        // sema types the index expression as the array's element type, so this
        // reads the right width and stride. Hardcoding i32 here loaded four
        // bytes out of an array of pointers or doubles.
        let mut elem_type = storage_type(get_expr_type(expr))
        if (str_equals(elem_type, "") == 1) {
            elem_type = "i32"
        }

        let slot = ir_elem_ptr(elem_type, array_val, index_val)
        return ir_get_temp_name(ir_load_ptr(elem_type, ir_get_temp_name(slot)))
    }
    
    if (expr.kind == NodeKind.CAST_EXPR) {
        let source = ptr_to_node(expr.child1)
        let val = generate_expression(source)

        let from_t = node_get_type(source)
        let to_t = node_get_type(expr)
        let from_key = type_ir_key(from_t)
        let to_key = type_ir_key(to_t)

        // Same representation: Enum to Int, or between same-width integer types
        // of different signedness. Nothing to emit.
        if (str_equals(from_key, to_key) == 1) {
            return val
        }

        if (str_equals(to_key, "double") == 1) {
            if (type_int_is_unsigned(from_t)) {
                return ir_get_temp_name(ir_uitofp(from_key, val, to_key))
            }
            return ir_get_temp_name(ir_sitofp(from_key, val, to_key))
        }

        if (str_equals(from_key, "double") == 1) {
            if (type_int_is_unsigned(to_t)) {
                return ir_get_temp_name(ir_fptoui(from_key, val, to_key))
            }
            return ir_get_temp_name(ir_fptosi(from_key, val, to_key))
        }

        // Integer-shaped on both sides, so the only question is width.
        if (type_int_bits(from_t) > type_int_bits(to_t)) {
            return ir_get_temp_name(ir_trunc(from_key, val, to_key))
        }

        // Widening. Char and Bool are zero-extended: a Char is a byte value, so
        // 'A' as Int must be 65 and never a negative number.
        let zero_extend = type_int_is_unsigned(from_t)
                          or from_t.kind == TypeKind.CHAR
                          or from_t.kind == TypeKind.BOOL
        if (zero_extend) {
            return ir_get_temp_name(ir_zext(from_key, val, to_key))
        }
        return ir_get_temp_name(ir_sext(from_key, val, to_key))
    }

    if (expr.kind == NodeKind.UNARY_EXPR) {
        let operand_node = ptr_to_node(expr.child1)
        let operand_val = generate_expression(operand_node)
        let uop = expr.s1

        if (str_equals(uop, "!") == 1) {
            // Logical not. Comparing against 0 rather than xor-ing with true:
            // the bridge has an icmp primitive and no xor, and the two are
            // equivalent for i1.
            let not_id = ir_icmp_eq("i1", operand_val, "0")
            return ir_get_temp_name(not_id)
        }

        if (str_equals(uop, "~") == 1) {
            let int_type = get_expr_type(operand_node)
            return ir_get_temp_name(ir_not(int_type, operand_val))
        }

        if (str_equals(uop, "-") == 1) {
            let operand_type = get_expr_type(operand_node)
            // ir_neg emits an integer `sub 0, x`, which is not valid for a
            // double -- floats need fsub.
            if (str_equals(operand_type, "double") == 1) {
                let fneg_id = ir_fsub("double", "0.0", operand_val)
                return ir_get_temp_name(fneg_id)
            }
            let neg_id = ir_neg(operand_type, operand_val)
            return ir_get_temp_name(neg_id)
        }
    }

    if (expr.kind == NodeKind.BINARY_EXPR) {
        // Handled before either operand is generated -- that is the whole point.
        if (str_equals(expr.s1, "and") == 1 or str_equals(expr.s1, "or") == 1) {
            return generate_short_circuit(expr)
        }

        let left_val = generate_expression(ptr_to_node(expr.child1))
        let right_val = generate_expression(ptr_to_node(expr.child2))

        let op = expr.s1
        let mut temp_id = 0
        let left_node = ptr_to_node(expr.child1)
        let op_type = get_expr_type(left_node)
        let mut is_unsigned = false
        if (node_has_type(left_node)) {
            is_unsigned = type_int_is_unsigned(node_get_type(left_node))
        }
        if (str_equals(op_type, "double") == 1) {
            if (str_equals(op, "+") == 1) { temp_id = ir_fadd(op_type, left_val, right_val) }
            if (str_equals(op, "-") == 1) { temp_id = ir_fsub(op_type, left_val, right_val) }
            if (str_equals(op, "*") == 1) { temp_id = ir_fmul(op_type, left_val, right_val) }
            if (str_equals(op, "/") == 1) { temp_id = ir_fdiv(op_type, left_val, right_val) }
            if (str_equals(op, "==") == 1) { temp_id = ir_fcmp_oeq(op_type, left_val, right_val) }
            if (str_equals(op, "!=") == 1) { temp_id = ir_fcmp_one(op_type, left_val, right_val) }
            if (str_equals(op, "<") == 1) { temp_id = ir_fcmp_olt(op_type, left_val, right_val) }
            if (str_equals(op, "<=") == 1) { temp_id = ir_fcmp_ole(op_type, left_val, right_val) }
            if (str_equals(op, ">") == 1) { temp_id = ir_fcmp_ogt(op_type, left_val, right_val) }
            if (str_equals(op, ">=") == 1) { temp_id = ir_fcmp_oge(op_type, left_val, right_val) }
        } else {
            if (str_equals(op, "+") == 1) { temp_id = ir_add(op_type, left_val, right_val) }
            if (str_equals(op, "-") == 1) { temp_id = ir_sub(op_type, left_val, right_val) }
            if (str_equals(op, "*") == 1) { temp_id = ir_mul(op_type, left_val, right_val) }
            if (str_equals(op, "==") == 1) { temp_id = ir_icmp_eq(op_type, left_val, right_val) }
            if (str_equals(op, "!=") == 1) { temp_id = ir_icmp_ne(op_type, left_val, right_val) }
            if (is_unsigned) {
                if (str_equals(op, "/") == 1) { temp_id = ir_udiv(op_type, left_val, right_val) }
                if (str_equals(op, "<") == 1) { temp_id = ir_icmp_ult(op_type, left_val, right_val) }
                if (str_equals(op, "<=") == 1) { temp_id = ir_icmp_ule(op_type, left_val, right_val) }
                if (str_equals(op, ">") == 1) { temp_id = ir_icmp_ugt(op_type, left_val, right_val) }
                if (str_equals(op, ">=") == 1) { temp_id = ir_icmp_uge(op_type, left_val, right_val) }
            } else {
                if (str_equals(op, "/") == 1) { temp_id = ir_sdiv(op_type, left_val, right_val) }
                if (str_equals(op, "<") == 1) { temp_id = ir_icmp_slt(op_type, left_val, right_val) }
                if (str_equals(op, "<=") == 1) { temp_id = ir_icmp_sle(op_type, left_val, right_val) }
                if (str_equals(op, ">") == 1) { temp_id = ir_icmp_sgt(op_type, left_val, right_val) }
                if (str_equals(op, ">=") == 1) { temp_id = ir_icmp_sge(op_type, left_val, right_val) }
            }
        }
        if (str_equals(op, "%") == 1) {
            if (is_unsigned) { temp_id = ir_urem(op_type, left_val, right_val) }
            else { temp_id = ir_srem(op_type, left_val, right_val) }
        }

        if (str_equals(op, "&") == 1) { temp_id = ir_and(op_type, left_val, right_val) }
        if (str_equals(op, "|") == 1) { temp_id = ir_or(op_type, left_val, right_val) }
        if (str_equals(op, "^") == 1) { temp_id = ir_xor(op_type, left_val, right_val) }
        if (str_equals(op, "<<") == 1) { temp_id = ir_shl(op_type, left_val, right_val) }
        // Right shift follows the left operand's signedness: logical for
        // unsigned so the sign bit is not smeared, arithmetic for signed.
        if (str_equals(op, ">>") == 1) {
            if (is_unsigned) { temp_id = ir_lshr(op_type, left_val, right_val) }
            else { temp_id = ir_ashr(op_type, left_val, right_val) }
        }
        // `and`/`or` never reach here -- generate_short_circuit handles them
        // above, before either operand has been evaluated.

        return ir_get_temp_name(temp_id)
    }
    
    if (expr.kind == NodeKind.CALL_EXPR) {
        let callee = ptr_to_node(expr.child1)
        let func_name = callee.s1

        // drop(x): release the owned heap value. Ownership/move checking in sema
        // guarantees this runs at most once per value.
        //
        // Through ir_free_object rather than a call to `free` by name, because
        // the deallocator is policy: a verify build routes it to a shim that
        // checks the value was live, and an arena build will not be able to use
        // libc free at all. Calling `free` directly here made explicit drops
        // invisible to both.
        if (str_equals(func_name, "drop") == 1) {
            let drop_arg = expr.child2
            if (str_equals(drop_arg, "") == 0) {
                let arg_node = ptr_to_node(drop_arg)
                let value = generate_expression(arg_node)
                if (drop_kind_of(arg_node) == IR_DROP_LIST) {
                    ir_free_list(value)
                } else {
                    ir_free_object(value)
                }
            }
            return ""
        }

        // Bool lowers to i1, but the C runtime declares print_bool(int) and the
        // module declares it as taking i32. Passing the i1 straight through left
        // the call disagreeing with its own declaration and the upper bits of the
        // argument register undefined -- it only worked by luck. Widen explicitly.
        let mut is_print_bool = 0
        if (str_equals(func_name, "print_bool") == 1) { is_print_bool = 1 }
        if (str_equals(func_name, "println_bool") == 1) { is_print_bool = 2 }

        if (is_print_bool > 0) {
            let bool_arg_ptr = expr.child2
            if (str_equals(bool_arg_ptr, "") == 0) {
                let bool_arg = ptr_to_node(bool_arg_ptr)
                let bool_val = generate_expression(bool_arg)
                let widened = ir_zext("i1", bool_val, "i32")
                ir_call_begin()
                ir_call_arg("i32", ir_get_temp_name(widened))
                if (is_print_bool == 1) {
                    ir_call_end("void", "print_bool")
                } else {
                    ir_call_end("void", "println_bool")
                }
            }
            return ""
        }

        let mut is_print = 0
        if (str_equals(func_name, "print") == 1) { is_print = 1 }
        if (str_equals(func_name, "println") == 1) { is_print = 2 }
        
        if (is_print > 0) {
            let mut arg_ptr = expr.child2
            if (str_equals(arg_ptr, "") == 0) {
                let arg_node = ptr_to_node(arg_ptr)
                let arg_val = generate_expression(arg_node)
                let arg_type = get_expr_type(arg_node)
                
                ir_call_begin()
                if (str_equals(arg_type, "ptr") == 1) {
                    ir_call_arg("ptr", arg_val)
                    if (is_print == 1) {
                        ir_call_end("void", "print")
                    } else {
                        ir_call_end("void", "println")
                    }
                } else if (str_equals(arg_type, "double") == 1) {
                    ir_call_arg("double", arg_val)
                    if (is_print == 1) {
                        ir_call_end("void", "print_float")
                    } else {
                        ir_call_end("void", "println_float")
                    }
                } else {
                    ir_call_arg(storage_type(arg_type), arg_val)
                    if (is_print == 1) {
                        ir_call_end("void", "print_int")
                    } else {
                        ir_call_end("void", "println_int")
                    }
                }
            }
            return ""
        }
        
        // Regular function call
        ir_call_begin()
        let mut arg_ptr = expr.child2
        while (str_equals(arg_ptr, "") == 0) {
            let arg_node = ptr_to_node(arg_ptr)
            let arg_val = generate_expression(arg_node)
            ir_call_arg(storage_type(get_expr_type(arg_node)), arg_val)
            arg_ptr = arg_node.next
        }
        
        let mut call_name = func_name
        if (str_equals(expr.s2, "") == 0) {
            call_name = expr.s2
        }

        let mut ret_type = storage_type(get_expr_type(expr))
        if (str_equals(ret_type, "void") == 1) {
            ir_call_end("void", call_name)
            return ""
        }

        // AIF Level 4. The value this call produces may belong to an enclosing
        // `region`, and it is allocated inside the runtime rather than through
        // ir_alloc_region -- so the arena is chosen here, around the call, and
        // the runtime bumps instead of calling malloc.
        //
        // aif_arena_at_node is the whole gate, and it is sufficient rather than
        // merely convenient. A site exists on a call node only when the callee is
        // opaque to this compilation; the analysis raised it to T1 with an escape
        // at or below the region, which an `alias` return or an undeclared one
        // never gets. So this fires exactly on FFI `produce` calls inside a region
        // whose result cannot outlive it.
        let arena_placed = aif_arena_at_node(node_to_ptr(expr)) == 1
        if (arena_placed) { ir_arena_hint_begin() }
        let mut temp_id = ir_call_end(ret_type, call_name)
        if (arena_placed) { ir_arena_hint_end() }
        return ir_get_temp_name(temp_id)
    }
    
    return "0"
}

fn generate_statement(stmt: ASTNode) {
    if (stmt.kind == NodeKind.VARIABLE_DECL) {
        let var_name = stmt.s1
        let mut var_type = "i32"
        if (str_equals(stmt.child1, "") == 0) {
            let type_node = ptr_to_node(stmt.child1)
            var_type = map_type_node(type_node)
        } else {
            if (str_equals(stmt.child2, "") == 0) {
                var_type = get_expr_type(ptr_to_node(stmt.child2))
            }
        }

        // The initializer is generated before the binding is declared, so that
        // `let x = x + 1` reads the *outer* x rather than the one being defined.
        let mut init_val = ""
        let has_init = str_equals(stmt.child2, "") == 0
        if (has_init) {
            init_val = generate_expression(ptr_to_node(stmt.child2))
        }

        // A fresh binding with its own slot. Two `let x` in sibling blocks get
        // separate stack slots, so they can hold different types without one
        // being written through a slot sized for the other.
        ir_set_var_type(var_name, var_type)
        let slot = ir_get_var_slot(var_name)
        let store_type = storage_type(var_type)
        ir_alloca(store_type, slot)

        if (has_init) {
            ir_store(store_type, init_val, slot)

            // AIF Level 2. Only a binding whose initialiser *is* the allocation
            // is droppable: `let b = a` has an identifier for an initialiser,
            // so it registers no site and gets no entry -- and `a` is moved by
            // it, so `a` gets skipped too. That leaks rather than double-frees,
            // and it is what an ownership-transferring move would fix.
            if (aif_frees_at_scope_node(stmt.child2) == 1
                and chain_assigns_name(ir_function_body, var_name) == false) {
                ir_mark_droppable(var_name, drop_kind_of(ptr_to_node(stmt.child2)))
            }
        }
    }
    
    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        let target_node = ptr_to_node(stmt.child1)
        if (target_node.kind == NodeKind.IDENTIFIER_EXPR) {
            let var_name = target_node.s1
            let mut var_type = ir_get_var_type(var_name)
            let store_type = storage_type(var_type)
            let val = generate_expression(ptr_to_node(stmt.child2))
            if (ir_var_is_global(var_name) == 1) {
                ir_store_global(store_type, val, var_name)
            } else {
                ir_store(store_type, val, ir_get_var_slot(var_name))
            }
        }
        if (target_node.kind == NodeKind.MEMBER_ACCESS_EXPR) {
            let object_node = ptr_to_node(target_node.child1)
            let object_val = generate_expression(object_node)
            let object_type = get_expr_type(object_node)
            let struct_name = struct_type_name(object_type)
            let field_index = ir_get_struct_field_index(struct_name, target_node.s1)
            let field_type = storage_type(ir_get_struct_field_type(struct_name, target_node.s1))
            let val = generate_expression(ptr_to_node(stmt.child2))

            let slot = ir_struct_field_ptr(struct_name, object_val, field_index)
            ir_store_ptr(field_type, val, ir_get_temp_name(slot))
        }
    }
    
    if (stmt.kind == NodeKind.RETURN_STATEMENT) {
        // Every scope in the function unwinds at once, so the floor is 0. The
        // returned value is never among them: returning it puts its escape at
        // Caller, and nothing with that escape is droppable here.
        if (str_equals(stmt.child1, "") == 0) {
            let ret_val = generate_expression(ptr_to_node(stmt.child1))
            let ret_type = storage_type(get_expr_type(ptr_to_node(stmt.child1)))
            generate_scope_drops(0)
            generate_region_exits(ir_region_depth())
            ir_ret(ret_type, ret_val)
        } else {
            generate_scope_drops(0)
            generate_region_exits(ir_region_depth())
            ir_ret_void()
        }
        ir_set_returned()
    }
    
    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) {
        if (str_equals(stmt.child1, "") == 0) {
            generate_expression(ptr_to_node(stmt.child1))
        }
    }
    
    if (stmt.kind == NodeKind.IF_STATEMENT) {
        let cond_val = generate_expression(ptr_to_node(stmt.child1))
        
        let then_label = ir_get_label()
        let else_label = ir_get_label()
        let end_label = ir_get_label()
        
        if (str_equals(stmt.child3, "") == 0) {
            ir_cond_br_numbered(cond_val, then_label, else_label)
        } else {
            ir_cond_br_numbered(cond_val, then_label, end_label)
        }
        
        ir_label_numbered(then_label)
        generate_block(ptr_to_node(stmt.child2))
        if (ir_has_returned() == 0) { ir_br_numbered(end_label) }
        ir_clear_returned()
        
        if (str_equals(stmt.child3, "") == 0) {
            ir_label_numbered(else_label)
            
            let else_node = ptr_to_node(stmt.child3)
            if (else_node.kind == NodeKind.IF_STATEMENT) {
                generate_statement(else_node)
            } else {
                generate_block(else_node)
            }
            if (ir_has_returned() == 0) { ir_br_numbered(end_label) }
            ir_clear_returned()
        }
        
        ir_label_numbered(end_label)
    }
    
    if (stmt.kind == NodeKind.WHILE_STATEMENT) {
        let cond_label = ir_get_label()
        let body_label = ir_get_label()
        let end_label = ir_get_label()

        ir_br_numbered(cond_label)
        ir_label_numbered(cond_label)

        let cond_val = generate_expression(ptr_to_node(stmt.child1))
        ir_cond_br_numbered(cond_val, body_label, end_label)

        ir_label_numbered(body_label)
        ir_loop_push(cond_label, end_label)
        ir_drop_barrier_push()
        generate_block(ptr_to_node(stmt.child2))
        ir_drop_barrier_pop()
        ir_loop_pop()

        if (ir_has_returned() == 0) { ir_br_numbered(cond_label) }
        ir_clear_returned()

        ir_label_numbered(end_label)
    }

    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        let body_label = ir_get_label()
        let end_label = ir_get_label()

        ir_br_numbered(body_label)
        ir_label_numbered(body_label)
        ir_loop_push(body_label, end_label)
        ir_drop_barrier_push()
        generate_block(ptr_to_node(stmt.child1))
        ir_drop_barrier_pop()
        ir_loop_pop()

        if (ir_has_returned() == 0) { ir_br_numbered(body_label) }
        ir_clear_returned()

        ir_label_numbered(end_label)
    }

    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        // Scoped to the loop, matching sema.
        ir_scope_push()
        ir_set_var_type(stmt.s1, "i32")
        let loop_var = ir_get_var_slot(stmt.s1)
        ir_alloca("i32", loop_var)

        let start_val = generate_expression(ptr_to_node(stmt.child1))
        ir_store("i32", start_val, loop_var)

        let cond_label = ir_get_label()
        let body_label = ir_get_label()
        let incr_label = ir_get_label()
        let end_label = ir_get_label()

        ir_br_numbered(cond_label)
        ir_label_numbered(cond_label)
        let iv = ir_load("i32", loop_var)
        let end_val = generate_expression(ptr_to_node(stmt.child2))
        let cmp = ir_icmp_slt("i32", ir_get_temp_name(iv), end_val)
        ir_cond_br_numbered(ir_get_temp_name(cmp), body_label, end_label)

        ir_label_numbered(body_label)
        ir_loop_push(incr_label, end_label)   // continue jumps to the increment step
        ir_drop_barrier_push()
        generate_block(ptr_to_node(stmt.child3))
        ir_drop_barrier_pop()
        ir_loop_pop()
        if (ir_has_returned() == 0) { ir_br_numbered(incr_label) }
        ir_clear_returned()

        ir_label_numbered(incr_label)
        let iv2 = ir_load("i32", loop_var)
        let next = ir_add("i32", ir_get_temp_name(iv2), "1")
        ir_store("i32", ir_get_temp_name(next), loop_var)
        ir_br_numbered(cond_label)

        ir_label_numbered(end_label)
        ir_scope_pop()
    }

    // SPEC 5.2. The arena is pushed on entry and popped on every exit; the
    // block inside is otherwise ordinary, and the escape facts that decide what
    // it serves were the same before the keyword was written.
    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        ir_region_begin()
        ir_region_enter()
        generate_block(ptr_to_node(stmt.child1))
        // Only on fall-through -- a `return` or `break` inside already popped it
        // on its way out, and popping twice releases the caller's arena.
        if (ir_has_returned() == 0) { ir_region_end() }
        ir_region_exit()
    }

    // Both leave every scope between here and the loop body, so the loop's
    // watermark is the floor. Bindings the loop inherited are above it and stay.
    if (stmt.kind == NodeKind.BREAK_STATEMENT) {
        let target = ir_loop_break_label()
        if (target >= 0) {
            generate_scope_drops(ir_loop_drop_floor())
            generate_region_exits(ir_region_depth() - ir_loop_region_depth())
            ir_br_numbered(target)
            ir_set_returned()
        }
    }

    if (stmt.kind == NodeKind.CONTINUE_STATEMENT) {
        let target = ir_loop_continue_label()
        if (target >= 0) {
            generate_scope_drops(ir_loop_drop_floor())
            generate_region_exits(ir_region_depth() - ir_loop_region_depth())
            ir_br_numbered(target)
            ir_set_returned()
        }
    }

    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        let scrut_val = generate_expression(ptr_to_node(stmt.child1))
        let scrut_type = get_expr_type(ptr_to_node(stmt.child1))
        let end_label = ir_get_label()
        let mut needs_final_br = true

        let mut arm_ptr = stmt.child2
        while (str_equals(arm_ptr, "") == 0) {
            let arm = ptr_to_node(arm_ptr)
            if (str_equals(arm.s1, "_") == 1) {
                // wildcard: runs in the current fall-through block
                generate_block(ptr_to_node(arm.child2))
                if (ir_has_returned() == 0) { ir_br_numbered(end_label) }
                ir_clear_returned()
                needs_final_br = false
            } else {
                let pat_val = generate_expression(ptr_to_node(arm.child1))
                let cmp = ir_icmp_eq(scrut_type, scrut_val, pat_val)
                let arm_label = ir_get_label()
                let next_label = ir_get_label()
                ir_cond_br_numbered(ir_get_temp_name(cmp), arm_label, next_label)

                ir_label_numbered(arm_label)
                generate_block(ptr_to_node(arm.child2))
                if (ir_has_returned() == 0) { ir_br_numbered(end_label) }
                ir_clear_returned()

                ir_label_numbered(next_label)
                needs_final_br = true
            }
            arm_ptr = arm.next
        }

        if (needs_final_br) { ir_br_numbered(end_label) }
        ir_label_numbered(end_label)
    }
}

// AIF Level 2. Frees every droppable binding at or above `floor`, newest first.
//
// There is deliberately no "was it moved?" test here. Move state belongs to
// sema, which clears it per function long before codegen runs, so asking
// ir_is_moved at this point reads an answer about some other function. Every
// case it would have caught is a fact instead: moving a value outward raises its
// escape past this scope, and an explicit `drop` marks the site, so neither
// reaches this list. A binding that merely receives a move (`let b = a`) never
// enters it, because its initialiser allocates nothing -- so the value is still
// freed exactly once, through `a`.
// Closes `count` open regions. Emitted at every exit that leaves them, in the
// same places and for the same reason as the drops -- an arena that is never
// popped holds its chunks for the rest of the program.
fn generate_region_exits(count: Int) {
    let mut i = 0
    while (i < count) {
        ir_region_end()
        i = i + 1
    }
}

fn generate_scope_drops(floor: Int) {
    let n = ir_drop_count(floor)
    let mut i = 0
    while (i < n) {
        let store_type = storage_type(ir_drop_type(floor, i))
        let loaded = ir_load(store_type, ir_drop_slot(floor, i))
        let value = ir_get_temp_name(loaded)
        if (ir_drop_kind(floor, i) == IR_DROP_LIST) {
            ir_free_list(value)
        } else {
            ir_free_object(value)
        }
        i = i + 1
    }
}

fn generate_block(block: ASTNode) {
    // LAYOUT 7.1. The cost model may have placed an arena here, in which case
    // the block is bracketed exactly as a `region` statement is -- same runtime,
    // same early-exit handling through ir_region_depth. The only difference is
    // who decided.
    let arena = aif_auto_arena_at_node(node_to_ptr(block)) == 1
    if (arena) {
        ir_region_begin()
        ir_region_enter()
    }

    // Mirrors sema_block: the same scopes must be pushed and popped in the same
    // order, so that a name resolves to the same binding -- and therefore the
    // same slot -- in both passes.
    ir_scope_push()

    let mut stmt_ptr = block.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        generate_statement(stmt)
        stmt_ptr = stmt.next
    }

    // Only on fall-through. A block that returned or branched away already
    // emitted its drops at that statement, and emitting them again here would
    // be unreachable code after a terminator -- or, worse, reachable and a
    // double free.
    if (ir_has_returned() == 0) {
        generate_scope_drops(ir_scope_drop_floor())
    }

    ir_scope_pop()

    if (arena) {
        // Only on fall-through, for the same reason the drops are: a `return` or
        // `break` inside already popped every arena between itself and its
        // target, and popping twice releases the caller's.
        if (ir_has_returned() == 0) { ir_region_end() }
        ir_region_exit()
    }
}

fn generate_function(func: ASTNode) {
    let func_name = func.s1
    let emitted_name = function_symbol_name(func)
    
    let mut ret_type = "void"
    if (str_equals(func.child3, "") == 0) {
        let ret_node = ptr_to_node(func.child3)
        ret_type = map_type_node(ret_node)
    }
    
    let mut is_main = 0
    if (str_equals(func_name, "main") == 1) {
        ret_type = "i32"
        is_main = 1
    }
    
    let ret_sig_type = storage_type(ret_type)
    ir_function_begin(emitted_name, ret_sig_type)

    if (is_main == 1) {
        // Real OS argc/argv only reach the C `main` symbol; stash into globals for cli_arg().
        ir_function_param("i32", "p_argc")
        ir_function_param("ptr", "p_argv")
    }

    let mut param_ptr = func.child1
    while (str_equals(param_ptr, "") == 0) {
        let param_node = ptr_to_node(param_ptr)
        let p_type_node = ptr_to_node(param_node.child1)
        ir_function_param(storage_type(map_type_node(p_type_node)), str_concat("p_", param_node.s1))
        param_ptr = param_node.next
    }

    ir_function_body_start()
    ir_clear_local_var_types()
    ir_clear_returned()

    if (is_main == 1) {
        ir_store_global("i32", "%p_argc", "prismio_argc")
        ir_store_global("ptr", "%p_argv", "prismio_argv")
    }

    // Parameter scope, outside the body block, matching sema_function.
    ir_scope_push()

    let mut param_ptr2 = func.child1
    while (str_equals(param_ptr2, "") == 0) {
        let param_node = ptr_to_node(param_ptr2)
        let p_type_node = ptr_to_node(param_node.child1)
        let p_type_str = map_type_node(p_type_node)
        let p_store_type = storage_type(p_type_str)

        ir_set_var_type(param_node.s1, p_type_str)
        let p_slot = ir_get_var_slot(param_node.s1)
        ir_alloca(p_store_type, p_slot)
        ir_store(p_store_type, str_concat("%p_", param_node.s1), p_slot)

        param_ptr2 = param_node.next
    }

    // Locals are created where they are declared now, rather than hoisted by a
    // separate pre-pass. The backend still places every alloca in the entry
    // block, so a `let` inside a loop body does not grow the stack per
    // iteration -- and each declaration gets its own slot, which the old
    // name-keyed pre-pass could not express.
    if (str_equals(func.child2, "") == 0) {
        ir_function_body = func.child2
        generate_block(ptr_to_node(func.child2))
        ir_function_body = ""
    }

    ir_scope_pop()
    
    if (ir_has_returned() == 0) {
        if (str_equals(ret_sig_type, "void") == 1) {
            ir_ret_void()
        } else {
            if (is_main == 1) {
                ir_ret("i32", "0")
            } else {
                ir_ret(ret_sig_type, "0")
            }
        }
    }
    
    ir_function_end()
}

// Pre-pass: collect string literals
fn collect_strings_expr(expr: ASTNode) {
    if (expr.kind == NodeKind.LITERAL_EXPR) {
        if (expr.i1 == TokenType.STRING_LITERAL) {
            let str_name = str_concat(".str.s", int_to_str(ir_string_counter))
            ir_string_counter = ir_string_counter + 1
            ir_global_string(str_name, expr.s1)
            expr.s2 = str_name
        }
    }
    if (expr.kind == NodeKind.UNARY_EXPR or expr.kind == NodeKind.CAST_EXPR) {
        if (str_equals(expr.child1, "") == 0) {
            collect_strings_expr(ptr_to_node(expr.child1))
        }
    }
    if (expr.kind == NodeKind.BINARY_EXPR) {
        if (str_equals(expr.child1, "") == 0) {
            collect_strings_expr(ptr_to_node(expr.child1))
        }
        if (str_equals(expr.child2, "") == 0) {
            collect_strings_expr(ptr_to_node(expr.child2))
        }
    }
    if (expr.kind == NodeKind.CALL_EXPR) {
        let mut arg_ptr = expr.child2
        while (str_equals(arg_ptr, "") == 0) {
            let arg_node = ptr_to_node(arg_ptr)
            collect_strings_expr(arg_node)
            arg_ptr = arg_node.next
        }
    }
    if (expr.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let mut elem_ptr = expr.child1
        while (str_equals(elem_ptr, "") == 0) {
            let elem_node = ptr_to_node(elem_ptr)
            collect_strings_expr(elem_node)
            elem_ptr = elem_node.next
        }
    }
    if (expr.kind == NodeKind.INDEX_EXPR) {
        if (str_equals(expr.child1, "") == 0) {
            collect_strings_expr(ptr_to_node(expr.child1))
        }
        if (str_equals(expr.child2, "") == 0) {
            collect_strings_expr(ptr_to_node(expr.child2))
        }
    }
    if (expr.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        if (str_equals(expr.child1, "") == 0) {
            collect_strings_expr(ptr_to_node(expr.child1))
        }
    }
    if (expr.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        let mut field_ptr = expr.child1
        while (str_equals(field_ptr, "") == 0) {
            let field = ptr_to_node(field_ptr)
            if (str_equals(field.child1, "") == 0) {
                collect_strings_expr(ptr_to_node(field.child1))
            }
            field_ptr = field.next
        }
    }
}

fn declare_extern_function(ext: ASTNode) {
    let mut ret_type = get_declared_return_type(ext, ext.child2)
    ir_set_var_type(fn_key(function_symbol_name(ext)), ret_type)

    ir_declare_function_begin(function_symbol_name(ext), storage_type(ret_type))
    let mut param_ptr = ext.child1
    while (str_equals(param_ptr, "") == 0) {
        let param_node = ptr_to_node(param_ptr)
        let p_type_node = ptr_to_node(param_node.child1)
        ir_declare_function_param(storage_type(map_type_node(p_type_node)))
        param_ptr = param_node.next
    }
    ir_declare_function_end()
}

fn module_has_function(module: ASTNode, name: String) -> Bool {
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        if (stmt.kind == NodeKind.FUNCTION and str_equals(stmt.s1, name) == 1) {
            return true
        }
        stmt_ptr = stmt.next
    }

    return false
}

fn register_enum_decl(enum_node: ASTNode) {
    let mut variant_ptr = enum_node.child1
    let mut value = 0
    while (str_equals(variant_ptr, "") == 0) {
        let variant = ptr_to_node(variant_ptr)
        ir_register_enum_variant(enum_node.s1, variant.s1, value)
        value = value + 1
        variant_ptr = variant.next
    }
}

fn register_struct_name(struct_node: ASTNode) {
    ir_register_struct(struct_node.s1)
}

fn generate_struct_decl(struct_node: ASTNode) {
    let first_field_ptr = struct_node.child1
    if (str_equals(first_field_ptr, "") == 0) {
        let first_field = ptr_to_node(first_field_ptr)
        if (ir_get_struct_field_index(struct_node.s1, first_field.s1) >= 0) {
            return
        }
    }

    ir_struct_type_begin(struct_node.s1)

    let mut field_ptr = struct_node.child1
    while (str_equals(field_ptr, "") == 0) {
        let field = ptr_to_node(field_ptr)
        let type_node = ptr_to_node(field.child1)
        let field_type = storage_type(map_type_node(type_node))
        ir_register_struct_field(struct_node.s1, field.s1, field_type)
        ir_struct_type_field(field_type)
        field_ptr = field.next
    }

    ir_struct_type_end()
}

// Walks every child of `stmt` that can contain an expression, so each string
// literal gets an @.str global allocated before codegen needs its name.
//
// This must stay exhaustive over NodeKind. A statement kind missing from here does
// not fail loudly: the literal simply never gets a name, and generate_expression
// then emits `ptr @` with an empty global, which llc rejects with "expected value
// token" pointing at generated IR rather than at the user's source. FOR/LOOP/MATCH
// were absent for exactly this reason, which made any string literal inside a for
// loop or a match arm fail to build.
//
// The helpers below take a possibly-empty child pointer so each kind reads as a
// plain list of the children it owns, rather than repeating the emptiness check.
fn collect_strings_child_expr(child: String) {
    if (str_equals(child, "") == 0) {
        collect_strings_expr(ptr_to_node(child))
    }
}

fn collect_strings_child_block(child: String) {
    if (str_equals(child, "") == 0) {
        collect_strings_block(ptr_to_node(child))
    }
}

fn collect_strings_stmt(stmt: ASTNode) {
    if (stmt.kind == NodeKind.VARIABLE_DECL) {
        collect_strings_child_expr(stmt.child2)
    }
    if (stmt.kind == NodeKind.EXPRESSION_STATEMENT) {
        collect_strings_child_expr(stmt.child1)
    }
    if (stmt.kind == NodeKind.RETURN_STATEMENT) {
        collect_strings_child_expr(stmt.child1)
    }
    if (stmt.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        // child1 is the assignment target, which can itself hold literals in an
        // index expression such as `table[key_for("a")] = 1`.
        collect_strings_child_expr(stmt.child1)
        collect_strings_child_expr(stmt.child2)
    }
    if (stmt.kind == NodeKind.IF_STATEMENT) {
        collect_strings_child_expr(stmt.child1)
        collect_strings_child_block(stmt.child2)
        if (str_equals(stmt.child3, "") == 0) {
            let else_node = ptr_to_node(stmt.child3)
            if (else_node.kind == NodeKind.IF_STATEMENT) {
                collect_strings_stmt(else_node)
            } else {
                collect_strings_block(else_node)
            }
        }
    }
    if (stmt.kind == NodeKind.WHILE_STATEMENT) {
        collect_strings_child_expr(stmt.child1)
        collect_strings_child_block(stmt.child2)
    }
    if (stmt.kind == NodeKind.LOOP_STATEMENT) {
        collect_strings_child_block(stmt.child1)
    }
    if (stmt.kind == NodeKind.REGION_STATEMENT) {
        collect_strings_child_block(stmt.child1)
    }
    if (stmt.kind == NodeKind.FOR_STATEMENT) {
        // child1/child2 are the range bounds, child3 the body.
        collect_strings_child_expr(stmt.child1)
        collect_strings_child_expr(stmt.child2)
        collect_strings_child_block(stmt.child3)
    }
    if (stmt.kind == NodeKind.MATCH_STATEMENT) {
        collect_strings_child_expr(stmt.child1)
        let mut arm_ptr = stmt.child2
        while (str_equals(arm_ptr, "") == 0) {
            let arm = ptr_to_node(arm_ptr)
            // A non-wildcard arm's pattern is an ordinary expression.
            collect_strings_child_expr(arm.child1)
            collect_strings_child_block(arm.child2)
            arm_ptr = arm.next
        }
    }
}

fn collect_strings_block(block: ASTNode) {
    let mut s_ptr = block.child1
    while (str_equals(s_ptr, "") == 0) {
        let s = ptr_to_node(s_ptr)
        collect_strings_stmt(s)
        s_ptr = s.next
    }
}

fn collect_strings_function(func: ASTNode) {
    if (str_equals(func.child2, "") == 0) {
        collect_strings_block(ptr_to_node(func.child2))
    }
}

fn generate_module(module: ASTNode) {
    ir_reset_globals()
    ir_reset_types()
    ir_clear_var_types()
    // Tell the backend the target's pointer width -- it sizes the allocator's
    // size argument and array GEP indices.
    ir_set_pointer_int_type(ir_ptr_int_type())
    if (ir_target_wasm) {
        ir_module_start_wasm("self_hosted_module")
    } else {
        ir_module_start("self_hosted_module")
    }

    let mut type_stmt_ptr = module.child1
    while (str_equals(type_stmt_ptr, "") == 0) {
        let type_stmt = ptr_to_node(type_stmt_ptr)
        if (type_stmt.kind == NodeKind.ENUM_DECL) {
            register_enum_decl(type_stmt)
        }
        if (type_stmt.kind == NodeKind.STRUCT_DECL) {
            register_struct_name(type_stmt)
        }
        type_stmt_ptr = type_stmt.next
    }

    let mut struct_stmt_ptr = module.child1
    while (str_equals(struct_stmt_ptr, "") == 0) {
        let struct_stmt = ptr_to_node(struct_stmt_ptr)
        if (struct_stmt.kind == NodeKind.STRUCT_DECL) {
            generate_struct_decl(struct_stmt)
        }
        struct_stmt_ptr = struct_stmt.next
    }

    ir_blank_line()

    // Populated from main's real argc/argv (see generate_function) so cli_arg()/
    // cli_arg_count() in runtime/program_support.c work the same on every platform.
    ir_global_var("prismio_argc", "i32", "0", 0)
    ir_global_var("prismio_argv", "ptr", "null", 0)

    // Declare runtime functions
    ir_declare_function_begin("malloc", "ptr")
    ir_declare_function_param(ir_ptr_int_type())
    ir_declare_function_end()

    ir_declare_function_begin("free", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_new", "ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_push", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_get", "ptr")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("list_set", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_param("i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()

    ir_declare_function_begin("list_len", "i32")
    ir_declare_function_param("ptr")
    ir_declare_function_end()
    
    ir_declare_function_begin("println", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()
    
    ir_declare_function_begin("print", "void")
    ir_declare_function_param("ptr")
    ir_declare_function_end()
    
    ir_declare_function_begin("println_int", "void")
    ir_declare_function_param("i32")
    ir_declare_function_end()
    
    ir_declare_function_begin("print_int", "void")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("println_float", "void")
    ir_declare_function_param("double")
    ir_declare_function_end()
    
    ir_declare_function_begin("print_float", "void")
    ir_declare_function_param("double")
    ir_declare_function_end()

    ir_declare_function_begin("println_bool", "void")
    ir_declare_function_param("i32")
    ir_declare_function_end()
    
    ir_declare_function_begin("print_bool", "void")
    ir_declare_function_param("i32")
    ir_declare_function_end()

    ir_declare_function_begin("println_char", "void")
    ir_declare_function_param("i8")
    ir_declare_function_end()
    
    ir_declare_function_begin("print_char", "void")
    ir_declare_function_param("i8")
    ir_declare_function_end()
    
    ir_blank_line()
    
    // First pass: global variables + collect string literals
    let mut stmt_ptr = module.child1
    while (str_equals(stmt_ptr, "") == 0) {
        let stmt = ptr_to_node(stmt_ptr)
        
        if (stmt.kind == NodeKind.EXTERN_FUNCTION) {
            if (module_has_function(module, stmt.s1) == false) {
                declare_extern_function(stmt)
            }
        }
        
        if (stmt.kind == NodeKind.VARIABLE_DECL) {
            let mut init_val = "0"
            let mut var_type = "i32"
            let has_annotation = str_equals(stmt.child1, "") == 0
            if (has_annotation) {
                let type_node = ptr_to_node(stmt.child1)
                var_type = map_type_node(type_node)
            }
            if (str_equals(stmt.child2, "") == 0) {
                let init_node = ptr_to_node(stmt.child2)
                // Only infer from the initializer when there is no annotation.
                // Taking the initializer's type unconditionally declared
                // `let g: I64 = 5` as an i32 global, disagreeing with sema.
                if (has_annotation == false) {
                    var_type = get_expr_type(init_node)
                }
                if (init_node.kind == NodeKind.LITERAL_EXPR) {
                    if (init_node.i1 == TokenType.STRING_LITERAL) {
                        // A global initializer sits outside every function, so the
                        // per-function string pre-pass never reaches it. Give the
                        // literal its global here and point the variable at it;
                        // emitting init_node.s1 raw produced
                        // `@g =  global ptr hello world`, which llc rejects.
                        collect_strings_expr(init_node)
                        init_val = str_concat("@", init_node.s2)
                    } else {
                        init_val = init_node.s1
                    }
                } else {
                    // Unreachable: sema rejects a non-constant global initializer
                    // (see sema_predeclare_global) and codegen only runs when
                    // sema reported nothing. Kept as a guard because the
                    // alternative -- falling back to 0 -- made `let g = compute()`
                    // silently become a zero global with the call never emitted.
                    println("internal error: non-constant global initializer reached codegen")
                    exit(1)
                }
            }
            ir_global_var(stmt.s1, storage_type(var_type), init_val, 0)
            ir_register_global_name(stmt.s1)
            // Must be declared as a global, not a local: codegen asks
            // ir_var_is_global() to choose between @name and a stack slot, and
            // a global recorded as a local would be looked up as an alloca that
            // does not exist.
            ir_set_global_var_type(stmt.s1, var_type)
        }
        
        if (stmt.kind == NodeKind.FUNCTION) {
            let mut ret_type = get_declared_return_type(stmt, stmt.child3)
            if (str_equals(stmt.s1, "main") == 1) {
                ret_type = "i32"
            }
            ir_set_var_type(fn_key(function_symbol_name(stmt)), ret_type)
            collect_strings_function(stmt)
        }
        
        stmt_ptr = stmt.next
    }
    
    ir_blank_line()
    
    // Second pass: functions
    let mut stmt_ptr2 = module.child1
    while (str_equals(stmt_ptr2, "") == 0) {
        let stmt2 = ptr_to_node(stmt_ptr2)
        
        if (stmt2.kind == NodeKind.FUNCTION) {
            generate_function(stmt2)
        }
        
        stmt_ptr2 = stmt2.next
    }
    
    ir_module_end()
}
