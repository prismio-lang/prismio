import token
import utils
import keywords

extern fn exit(code: Int)
extern fn str_from_char(c: Char) -> String

struct Lexer {
    input: String,
    pos: Int,
    line: Int,
    col: Int
}

fn create_lexer(input: String) -> Lexer {
    return Lexer {
        input: input,
        pos: 0,
        line: 1,
        col: 1
    }
}

// Free functions instead of methods
fn lexer_peek(lex: Lexer, offset: Int) -> Char {
    return str_char_at(lex.input, lex.pos + offset)
}

fn lexer_current(lex: Lexer) -> Char {
    return str_char_at(lex.input, lex.pos)
}

fn lexer_advance(lex: Lexer) {
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
}

fn lexer_skip_whitespace(lex: Lexer) {
    let is_looping = true
    while (is_looping) {
        if (is_space(lexer_current(lex))) {
            if (lexer_current(lex) == '\n') {
                lex.line = lex.line + 1
                lex.col = 0
            }
            lexer_advance(lex)
        } else if (lexer_current(lex) == '/' and lexer_peek(lex, 1) == '/') {
            while (lexer_current(lex) != '\n' and lexer_current(lex) != '\0') {
                lexer_advance(lex)
            }
        } else {
            is_looping = false
        }
    }
}

// Turns the raw text between the quotes into the string's actual value. Char
// literals have always decoded their escapes; string literals did not, so the
// two disagreed and there was no way at all to put a newline, a tab or a quote
// inside a string -- the backslash simply survived into the output.
//
// A NUL escape is rejected rather than supported: String is a NUL-terminated C
// pointer, so an embedded NUL would silently truncate the value instead of
// storing it. Better to say so than to lose half the string.
fn lexer_decode_escapes(raw: String, line: Int) -> String {
    let mut out = ""
    let mut i = 0
    let n = str_length(raw)

    while (i < n) {
        let ch = str_char_at(raw, i)

        if (ch == '\\' and i + 1 < n) {
            let esc = str_char_at(raw, i + 1)
            let mut decoded = esc
            let mut known = true

            if (esc == 'n') { decoded = '\n' }
            else if (esc == 't') { decoded = '\t' }
            else if (esc == 'r') { decoded = '\r' }
            else if (esc == '\\') { decoded = '\\' }
            else if (esc == '"') { decoded = '"' }
            else if (esc == '\'') { decoded = '\'' }
            else if (esc == '0') {
                print("error: line ")
                print_int(line)
                println(": a NUL escape cannot appear in a string literal, because String is NUL-terminated")
                exit(1)
            }
            else { known = false }

            if (known == false) {
                print("error: line ")
                print_int(line)
                print(": unknown escape sequence ")
                print_char('\\')
                println_char(esc)
                exit(1)
            }

            out = str_concat(out, str_from_char(decoded))
            i = i + 2
        } else {
            out = str_concat(out, str_from_char(ch))
            i = i + 1
        }
    }

    return out
}

fn lexer_next_token(lex: Lexer) -> Token {
    lexer_skip_whitespace(lex)

    // Check EOF
    if (lex.pos >= str_length(lex.input)) {
        return Token {
            type: TokenType.EOF,
            value: "EOF",
            line: lex.line,
            tok_next: ""
        }
    }

    let c = lexer_current(lex)

    // Identifiers and Keywords
    if (is_alpha(c)) {
        let start = lex.pos
        while (is_alnum(lexer_current(lex))) {
            lexer_advance(lex)
        }
        let length = lex.pos - start
        let value = str_substring(lex.input, start, length)
        
        if (is_keyword(value)) {
            if (is_boolean(value)) {
                return Token { type: TokenType.BOOL_LITERAL, value: value, line: lex.line, tok_next: "" }
            }
            return Token { type: TokenType.KEYWORD, value: value, line: lex.line, tok_next: "" }
        }
        
        return Token { type: TokenType.IDENTIFIER, value: value, line: lex.line, tok_next: "" }
    }

    // Numbers
    if (is_digit(c)) {
        let start = lex.pos
        let is_float = 0
        while (is_digit(lexer_current(lex))) {
            lexer_advance(lex)
        }
        if (lexer_current(lex) == '.' and is_digit(lexer_peek(lex, 1))) {
            is_float = 1
            lexer_advance(lex)
            while (is_digit(lexer_current(lex))) {
                lexer_advance(lex)
            }
        }
        
        let length = lex.pos - start
        let value = str_substring(lex.input, start, length)
        if (is_float == 1) {
            return Token { type: TokenType.FLOAT_LITERAL, value: value, line: lex.line, tok_next: "" }
        }
        return Token { type: TokenType.NUMBER_LITERAL, value: value, line: lex.line, tok_next: "" }
    }

    // String Literal
    //
    // Two passes. The first finds the closing quote, stepping over backslash
    // pairs so an escaped quote does not end the literal. Escapes are then
    // decoded only if the literal actually contains one, which keeps the common
    // case on the cheap str_substring path instead of concatenating per
    // character.
    if (c == '"') {
        lexer_advance(lex) // Skip opening quote
        let start = lex.pos
        let mut has_escape = false
        while (lexer_current(lex) != '"' and lex.pos < str_length(lex.input)) {
            if (lexer_current(lex) == '\\') {
                has_escape = true
                lexer_advance(lex) // consume the backslash; the pair is skipped below
            }
            lexer_advance(lex)
        }

        let length = lex.pos - start
        let raw = str_substring(lex.input, start, length)

        if (lexer_current(lex) == '"') {
            lexer_advance(lex) // Skip closing quote
        } else {
            print("error: line ")
            print_int(lex.line)
            println(": unterminated string literal")
            exit(1)
        }

        let mut value = raw
        if (has_escape) {
            value = lexer_decode_escapes(raw, lex.line)
        }

        return Token { type: TokenType.STRING_LITERAL, value: value, line: lex.line, tok_next: "" }
    }

    // Character Literal
    if (c == '\'') {
        lexer_advance(lex) // Skip opening quote
        let value_char = lexer_current(lex)
        
        if (value_char == '\\') {
            lexer_advance(lex)
            let esc = lexer_current(lex)
            if (esc == 'n') { value_char = '\n' }
            if (esc == 't') { value_char = '\t' }
            if (esc == 'r') { value_char = '\r' }
            if (esc == '0') { value_char = '\0' }
            if (esc == '\\') { value_char = '\\' }
            if (esc == '\'') { value_char = '\'' }
            if (esc == '"') { value_char = '"' }
        }
        
        lexer_advance(lex)
        if (lexer_current(lex) == '\'') {
            lexer_advance(lex)
        }
        
        return Token { type: TokenType.CHAR_LITERAL, value: int_to_str(char_code(value_char)), line: lex.line, tok_next: "" }
    }

    // Operators
    if (is_operator(c)) {
        let start = lex.pos
        lexer_advance(lex)

        // Check for 2-char operators
        let next = lexer_current(lex)
        if (c == '=' and next == '=') { lexer_advance(lex) }
        if (c == '!' and next == '=') { lexer_advance(lex) }
        if (c == '<' and next == '=') { lexer_advance(lex) }
        if (c == '>' and next == '=') { lexer_advance(lex) }
        if (c == '&' and next == '&') { lexer_advance(lex) }
        if (c == '|' and next == '|') { lexer_advance(lex) }
        if (c == '-' and next == '>') { lexer_advance(lex) }
        if (c == '=' and next == '>') { lexer_advance(lex) }
        // Shifts. `>>` also closes two nested generic arguments, which
        // parse_type_annotation splits back apart when it expects a single '>'.
        if (c == '<' and next == '<') { lexer_advance(lex) }
        if (c == '>' and next == '>') { lexer_advance(lex) }
        // Compound assignment. Desugared by the parser into a read-modify-write.
        if (next == '=') {
            if (c == '+' or c == '-' or c == '*' or c == '/' or c == '%') { lexer_advance(lex) }
            if (c == '&' or c == '|' or c == '^') { lexer_advance(lex) }
        }

        let length = lex.pos - start
        let value = str_substring(lex.input, start, length)

        // Refine type
        let mut type = TokenType.ARITHMETIC_OPERATOR
        if (length == 2) {
            if (str_equals(value, "==") == 1 or str_equals(value, "!=") == 1 or str_equals(value, "<=") == 1 or str_equals(value, ">=") == 1) {
                type = TokenType.RELATIONAL_OPERATOR
            }
            if (str_equals(value, "->") == 1 or str_equals(value, "=>") == 1) {
                type = TokenType.ARROW
                if (str_equals(value, "=>") == 1) { type = TokenType.FAT_ARROW }
            }
            // `x op= y` is an assignment, not an arithmetic operator: the second
            // character is '=' and the first is not, which distinguishes it from
            // ==, !=, <= and >= already handled above.
            if (str_char_at(value, 1) == '=' and str_char_at(value, 0) != '=') {
                if (str_equals(value, "!=") == 0 and str_equals(value, "<=") == 0 and str_equals(value, ">=") == 0) {
                    type = TokenType.ASSIGNMENT_OPERATOR
                }
            }
        } else {
            if (c == '<' or c == '>') { type = TokenType.RELATIONAL_OPERATOR }
            if (c == '=') { type = TokenType.ASSIGNMENT_OPERATOR }
            if (c == '!') { type = TokenType.NEGATION }
        }

        return Token { type: type, value: value, line: lex.line, tok_next: "" }
    }

    // Range operator '..'
    if (c == '.' and lexer_peek(lex, 1) == '.') {
        lexer_advance(lex)
        lexer_advance(lex)
        return Token { type: TokenType.RANGE, value: "..", line: lex.line, tok_next: "" }
    }

    // Separators
    if (is_separator(c)) {
        let val = str_substring(lex.input, lex.pos, 1)
        lexer_advance(lex)
        return Token { type: TokenType.SEPARATOR, value: val, line: lex.line, tok_next: "" }
    }

    // Unknown
    lexer_advance(lex)
    return Token { type: TokenType.UNKNOWN, value: "?", line: lex.line, tok_next: "" }
}

// Lexes all tokens and returns the head of a linked list of Tokens
extern fn ptr_to_token(ptr: String) -> Token
extern fn token_to_ptr(tok: Token) -> String

// Token is a struct and therefore move-only, so walking the list with a second
// Token binding (`let current = head`) would move `head` and make the final
// `return head` a use-after-move. Thread the list through pointers instead: the
// bindings stay local to one iteration and the chain itself is built the same way.
fn lex_all_tokens(lex: Lexer) -> Token {
    let head_ptr = token_to_ptr(lexer_next_token(lex))
    let current_ptr = head_ptr

    let scanning = true
    while (scanning) {
        let current = ptr_to_token(current_ptr)
        if (current.type == TokenType.EOF) {
            scanning = false
        } else {
            let next_ptr = token_to_ptr(lexer_next_token(lex))
            current.tok_next = next_ptr
            current_ptr = next_ptr
        }
    }

    return ptr_to_token(head_ptr)
}
