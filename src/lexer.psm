import token
import utils
import keywords
import diag

extern fn exit(code: Int)
extern fn str_from_char(c: Char) -> String
extern fn str_byte_at(s: String, index: Int) -> Char

// `length` is the input's size, measured once. Every character read used to go
// through str_char_at, which calls strlen -- so scanning a file cost O(n) per
// character and O(n^2) overall. Holding the length here lets the reads below
// bound-check in constant time and use str_byte_at instead.
struct Lexer {
    input: String,
    pos: Int,
    line: Int,
    col: Int,
    file: Int,
    length: Int
}

fn create_lexer(input: String, file: Int) -> Lexer {
    // Skip a UTF-8 byte order mark. Most Windows editors write one by default
    // (PowerShell's -Encoding utf8 among them), and without this the first
    // token is garbage and the file fails with "Unknown declaration" -- a
    // baffling error for a file that looks perfectly fine.
    let mut start = 0
    if (char_code(str_char_at(input, 0)) == 239) {
        if (char_code(str_char_at(input, 1)) == 187 and char_code(str_char_at(input, 2)) == 191) {
            start = 3
        }
    }

    return Lexer {
        input: input,
        pos: start,
        line: 1,
        col: 1,
        file: file,
        length: str_length(input)
    }
}

// Every token is built here, so none can be produced without a span. `start_pos`
// is where the token began, which is what makes `len` the token's real source
// width -- including the quotes of a string literal and any escape that decoded
// to a shorter value.
fn lexer_token(lex: Lexer, t: TokenType, value: String, start_line: Int, start_col: Int, start_pos: Int) -> Token {
    return Token {
        type: t,
        value: value,
        line: start_line,
        col: start_col,
        len: lex.pos - start_pos,
        file: lex.file,
        tok_next: ""
    }
}

// A lexer error, reported against the span that is open at the time. The lexer
// has no way to resynchronise -- it cannot know what the malformed text was meant
// to be -- so this is the one place in the frontend that still stops at the first
// error rather than recovering.
fn lexer_fatal(lex: Lexer, line: Int, col: Int, message: String) {
    diag_error_at(lex.file, line, col, 1, message)
    diag_finish()
    exit(1)
}

// Free functions instead of methods
fn lexer_peek(lex: Lexer, offset: Int) -> Char {
    let at = lex.pos + offset
    if (at < 0 or at > lex.length) { return '\0' }
    return str_byte_at(lex.input, at)
}

fn lexer_current(lex: Lexer) -> Char {
    if (lex.pos < 0 or lex.pos > lex.length) { return '\0' }
    return str_byte_at(lex.input, lex.pos)
}

fn lexer_advance(lex: Lexer) {
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
}

fn lexer_skip_whitespace(lex: Lexer) {
    let mut is_looping = true
    while (is_looping) {
        if (is_space(lexer_current(lex))) {
            if (lexer_current(lex) == '\n') {
                lex.line = lex.line + 1
                lex.col = 0
            }
            lexer_advance(lex)
        } else if (lexer_current(lex) == '/' and lexer_peek(lex, 1) == '/') {
            while (lexer_current(lex) != '\n' and lexer_current(lex) != '\0') {
                lexer_advance(lex)
            }
        } else {
            is_looping = false
        }
    }
}

// Turns the raw text between the quotes into the string's actual value. Char
// literals have always decoded their escapes; string literals did not, so the
// two disagreed and there was no way at all to put a newline, a tab or a quote
// inside a string -- the backslash simply survived into the output.
//
// A NUL escape is rejected rather than supported: String is a NUL-terminated C
// pointer, so an embedded NUL would silently truncate the value instead of
// storing it. Better to say so than to lose half the string.
// `base_col` is the column of the first character inside the quotes, so an
// offending escape can be pointed at exactly rather than blamed on the literal
// as a whole.
fn lexer_decode_escapes(lex: Lexer, raw: String, line: Int, base_col: Int) -> String {
    let mut out = ""
    let mut i = 0
    let n = str_length(raw)

    while (i < n) {
        let ch = str_char_at(raw, i)

        if (ch == '\\' and i + 1 < n) {
            let esc = str_char_at(raw, i + 1)
            let mut decoded = esc
            let mut known = true

            if (esc == 'n') { decoded = '\n' }
            else if (esc == 't') { decoded = '\t' }
            else if (esc == 'r') { decoded = '\r' }
            else if (esc == '\\') { decoded = '\\' }
            else if (esc == '"') { decoded = '"' }
            else if (esc == '\'') { decoded = '\'' }
            else if (esc == '0') {
                lexer_fatal(lex, line, base_col + i,
                    "a NUL escape cannot appear in a string literal, because String is NUL-terminated")
            }
            else { known = false }

            if (known == false) {
                lexer_fatal(lex, line, base_col + i,
                    str_concat("unknown escape sequence \\", str_from_char(esc)))
            }

            out = str_concat(out, str_from_char(decoded))
            i = i + 2
        } else {
            out = str_concat(out, str_from_char(ch))
            i = i + 1
        }
    }

    return out
}

fn lexer_next_token(lex: Lexer) -> Token {
    lexer_skip_whitespace(lex)

    // Captured before anything is consumed. `lex.line` can move on inside a token
    // -- a string literal may contain a newline -- so the span has to be taken
    // here rather than read back off the lexer when the token is built.
    let start_line = lex.line
    let start_col = lex.col
    let start_pos = lex.pos

    // Check EOF
    if (lex.pos >= lex.length) {
        return lexer_token(lex, TokenType.EOF, "EOF", start_line, start_col, start_pos)
    }

    let c = lexer_current(lex)

    // Identifiers and Keywords
    if (is_alpha(c)) {
        let start = lex.pos
        while (is_alnum(lexer_current(lex))) {
            lexer_advance(lex)
        }
        let length = lex.pos - start
        let mut value = str_substring(lex.input, start, length)

        if (is_keyword(value)) {
            if (is_boolean(value)) {
                return lexer_token(lex, TokenType.BOOL_LITERAL, value, start_line, start_col, start_pos)
            }
            return lexer_token(lex, TokenType.KEYWORD, value, start_line, start_col, start_pos)
        }

        return lexer_token(lex, TokenType.IDENTIFIER, value, start_line, start_col, start_pos)
    }

    // Numbers
    if (is_digit(c)) {
        let start = lex.pos
        let mut is_float = 0
        while (is_digit(lexer_current(lex))) {
            lexer_advance(lex)
        }
        if (lexer_current(lex) == '.' and is_digit(lexer_peek(lex, 1))) {
            is_float = 1
            lexer_advance(lex)
            while (is_digit(lexer_current(lex))) {
                lexer_advance(lex)
            }
        }

        let length = lex.pos - start
        let mut value = str_substring(lex.input, start, length)
        if (is_float == 1) {
            return lexer_token(lex, TokenType.FLOAT_LITERAL, value, start_line, start_col, start_pos)
        }
        return lexer_token(lex, TokenType.NUMBER_LITERAL, value, start_line, start_col, start_pos)
    }

    // String Literal
    //
    // Two passes. The first finds the closing quote, stepping over backslash
    // pairs so an escaped quote does not end the literal. Escapes are then
    // decoded only if the literal actually contains one, which keeps the common
    // case on the cheap str_substring path instead of concatenating per
    // character.
    if (c == '"') {
        lexer_advance(lex) // Skip opening quote
        let start = lex.pos
        let body_col = lex.col
        let mut has_escape = false
        while (lexer_current(lex) != '"' and lex.pos < lex.length) {
            if (lexer_current(lex) == '\\') {
                has_escape = true
                lexer_advance(lex) // consume the backslash; the pair is skipped below
            }
            // A raw newline inside a literal is unusual but the loop accepts it,
            // and without this the line counter silently falls behind for the
            // rest of the file -- so every diagnostic after it would point at the
            // wrong line.
            if (lexer_current(lex) == '\n') {
                lex.line = lex.line + 1
                lex.col = 0
            }
            lexer_advance(lex)
        }

        let length = lex.pos - start
        let raw = str_substring(lex.input, start, length)

        if (lexer_current(lex) == '"') {
            lexer_advance(lex) // Skip closing quote
        } else {
            lexer_fatal(lex, start_line, start_col, "unterminated string literal")
        }

        let mut value = raw
        if (has_escape) {
            value = lexer_decode_escapes(lex, raw, start_line, body_col)
        }

        return lexer_token(lex, TokenType.STRING_LITERAL, value, start_line, start_col, start_pos)
    }

    // Character Literal
    if (c == '\'') {
        lexer_advance(lex) // Skip opening quote
        let mut value_char = lexer_current(lex)
        
        if (value_char == '\\') {
            lexer_advance(lex)
            let esc = lexer_current(lex)
            if (esc == 'n') { value_char = '\n' }
            if (esc == 't') { value_char = '\t' }
            if (esc == 'r') { value_char = '\r' }
            if (esc == '0') { value_char = '\0' }
            if (esc == '\\') { value_char = '\\' }
            if (esc == '\'') { value_char = '\'' }
            if (esc == '"') { value_char = '"' }
        }
        
        lexer_advance(lex)
        if (lexer_current(lex) == '\'') {
            lexer_advance(lex)
        } else {
            lexer_fatal(lex, start_line, start_col,
                "unterminated character literal (a Char holds exactly one character)")
        }

        return lexer_token(lex, TokenType.CHAR_LITERAL, int_to_str(char_code(value_char)),
                           start_line, start_col, start_pos)
    }

    // Operators
    if (is_operator(c)) {
        let start = lex.pos
        lexer_advance(lex)

        // Check for 2-char operators
        let next = lexer_current(lex)
        if (c == '=' and next == '=') { lexer_advance(lex) }
        if (c == '!' and next == '=') { lexer_advance(lex) }
        if (c == '<' and next == '=') { lexer_advance(lex) }
        if (c == '>' and next == '=') { lexer_advance(lex) }
        if (c == '&' and next == '&') { lexer_advance(lex) }
        if (c == '|' and next == '|') { lexer_advance(lex) }
        if (c == '-' and next == '>') { lexer_advance(lex) }
        if (c == '=' and next == '>') { lexer_advance(lex) }
        // Shifts. `>>` also closes two nested generic arguments, which
        // parse_type_annotation splits back apart when it expects a single '>'.
        if (c == '<' and next == '<') { lexer_advance(lex) }
        if (c == '>' and next == '>') { lexer_advance(lex) }
        // Compound assignment. Desugared by the parser into a read-modify-write.
        if (next == '=') {
            if (c == '+' or c == '-' or c == '*' or c == '/' or c == '%') { lexer_advance(lex) }
            if (c == '&' or c == '|' or c == '^') { lexer_advance(lex) }
        }

        let length = lex.pos - start
        let mut value = str_substring(lex.input, start, length)

        // Refine type
        let mut type = TokenType.ARITHMETIC_OPERATOR
        if (length == 2) {
            if (str_equals(value, "==") == 1 or str_equals(value, "!=") == 1 or str_equals(value, "<=") == 1 or str_equals(value, ">=") == 1) {
                type = TokenType.RELATIONAL_OPERATOR
            }
            if (str_equals(value, "->") == 1 or str_equals(value, "=>") == 1) {
                type = TokenType.ARROW
                if (str_equals(value, "=>") == 1) { type = TokenType.FAT_ARROW }
            }
            // `x op= y` is an assignment, not an arithmetic operator: the second
            // character is '=' and the first is not, which distinguishes it from
            // ==, !=, <= and >= already handled above.
            if (str_char_at(value, 1) == '=' and str_char_at(value, 0) != '=') {
                if (str_equals(value, "!=") == 0 and str_equals(value, "<=") == 0 and str_equals(value, ">=") == 0) {
                    type = TokenType.ASSIGNMENT_OPERATOR
                }
            }
        } else {
            if (c == '<' or c == '>') { type = TokenType.RELATIONAL_OPERATOR }
            if (c == '=') { type = TokenType.ASSIGNMENT_OPERATOR }
            if (c == '!') { type = TokenType.NEGATION }
        }

        return lexer_token(lex, type, value, start_line, start_col, start_pos)
    }

    // Range operator '..'
    if (c == '.' and lexer_peek(lex, 1) == '.') {
        lexer_advance(lex)
        lexer_advance(lex)
        return lexer_token(lex, TokenType.RANGE, "..", start_line, start_col, start_pos)
    }

    // Separators
    if (is_separator(c)) {
        let val = str_substring(lex.input, lex.pos, 1)
        lexer_advance(lex)
        return lexer_token(lex, TokenType.SEPARATOR, val, start_line, start_col, start_pos)
    }

    // Anything else. This used to produce an UNKNOWN token and carry on, which
    // meant a stray character surfaced much later as "Unknown declaration"
    // pointing at something entirely innocent. Say what was actually wrong,
    // where.
    lexer_advance(lex)
    lexer_fatal(lex, start_line, start_col,
        str_concat("unexpected character ", diag_quote(str_from_char(c))))
    return lexer_token(lex, TokenType.UNKNOWN, "?", start_line, start_col, start_pos)
}

// Lexes all tokens and returns the head of a linked list of Tokens.
// Both are `void* f(void* p) { return p; }` in lang_runtime.c, so the result is
// the argument; without the contracts every Token reads as an opaque extern.
extern fn ptr_to_token(ptr: String borrow) -> Token alias
extern fn token_to_ptr(tok: Token borrow) -> String alias

// Token is a struct and therefore move-only, so walking the list with a second
// Token binding (`let current = head`) would move `head` and make the final
// `return head` a use-after-move. Thread the list through pointers instead: the
// bindings stay local to one iteration and the chain itself is built the same way.
fn lex_all_tokens(lex: Lexer) -> Token {
    let head_ptr = token_to_ptr(lexer_next_token(lex))
    let mut current_ptr = head_ptr

    let mut scanning = true
    while (scanning) {
        let current = ptr_to_token(current_ptr)
        if (current.type == TokenType.EOF) {
            scanning = false
        } else {
            let next_ptr = token_to_ptr(lexer_next_token(lex))
            current.tok_next = next_ptr
            current_ptr = next_ptr
        }
    }

    return ptr_to_token(head_ptr)
}
