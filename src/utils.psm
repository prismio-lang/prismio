extern fn str_equals(s1: String, s2: String) -> Int
extern fn str_length(s: String) -> Int
extern fn str_concat(s1: String, s2: String) -> String
extern fn str_substring(s: String, start: Int, length: Int) -> String
extern fn str_char_at(s: String, index: Int) -> Char
extern fn str_contains(haystack: String, needle: String) -> Int
extern fn str_starts_with(s: String, prefix: String) -> Int
extern fn str_index_of(haystack: String, needle: String) -> Int
extern fn int_to_str(n: Int) -> String
extern fn str_to_int(s: String) -> Int

fn is_digit(c: Char) -> Bool {
    return c >= '0' and c <= '9'
}

fn is_alpha(c: Char) -> Bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn is_alnum(c: Char) -> Bool {
    return is_alpha(c) or is_digit(c)
}

fn is_space(c: Char) -> Bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

fn is_separator(c: Char) -> Bool {
    if (c == '(') { return true }
    if (c == ')') { return true }
    if (c == '{') { return true }
    if (c == '}') { return true }
    if (c == '[') { return true }
    if (c == ']') { return true }
    if (c == ',') { return true }
    if (c == '.') { return true }
    if (c == ':') { return true }
    return false
}

fn is_operator(c: Char) -> Bool {
    if (c == '+') { return true }
    if (c == '-') { return true }
    if (c == '*') { return true }
    if (c == '/') { return true }
    if (c == '%') { return true }
    if (c == '<') { return true }
    if (c == '>') { return true }
    if (c == '!') { return true }
    if (c == '&') { return true }
    if (c == '|') { return true }
    if (c == '^') { return true }
    if (c == '~') { return true }
    if (c == '=') { return true }
    return false
}

// This was once an if-chain over every ASCII character, because the language had
// no way to convert a Char to its numeric value. It was also silently wrong: any
// character it had no branch for -- '^' (94), '~' (126), '@', '#', '?' and the
// whole range above 126 -- came back as 0, so a char literal for one of those
// compared equal to '\0'. That is precisely how '^' and '~' failed to lex when
// they were first added as operators.
//
// `as` makes the whole thing a zero-extension. Kept as a named function because
// it reads better at the call sites and is the documented spelling.
fn char_code(c: Char) -> Int {
    return c as Int
}
