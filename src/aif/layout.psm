// Struct sizes and the type graph they are computed over. Layout is what turns a
// tier into a byte figure, which is what a region budget is checked against.

import ast.nodes
import ast.types
import common.text
import common.diagnostics

// ---------------------------------------------------------------------------
// Building the fact graph
// ---------------------------------------------------------------------------

// The type reference graph (INFERENCE 4.4 stage 1) needs an edge from a struct
// to every nominal type its fields can reach. A missing edge is the one
// direction here that is unsound rather than merely imprecise: it makes a
// genuine cycle look acyclic, and a T3 refcount on a cycle leaks.
// ---------------------------------------------------------------------------
// Struct layout
//
// SPEC 4.2's T0 clause tests `size(s) <= Theta_stack`, in bytes. The prototype
// approximates it with field count because a JSON AST dump carries no layout
// (its A5); in the compiler that approximation is not merely imprecise, it is
// the difference between Level 1 doing something and doing nothing. ASTNode is
// 14 fields and about 88 bytes: over a threshold of 8 fields, comfortably under
// one of 256 bytes.
//
// AIF-1's layout is declaration order with natural alignment (SPEC 8.2 grants
// layout freedom; AIF-1 does not use it), so this is not an estimate of what the
// backend will do -- it is the same rule the backend follows.
// ---------------------------------------------------------------------------

// What a field of this type occupies. Size equals alignment for every type
// Prismio has, because every one of them is a scalar or a pointer; the day a
// struct is stored by value that stops being true and this needs the real rule.
// Struct-field ownership. A field's declared type, base-named, which the release
// derivation compares against what the sites say is in the slot. Answers "" when
// the field has no annotation, and the comparison is then skipped.
//
// Base-named for the reason aifBaseType exists: a container made by
// `list_new()` types as `List<Invalid>` and an annotated field as `List<Node>`,
// so comparing the spellings would reject every container field there is.
fn aifFieldTypeName(field: ASTNode) -> String {
    if (nodeExists(field.child1) == false) { return "" }
    let ann = ptr_to_node(field.child1)
    if (ann.i2 == 1) { return "List" }
    if (ann.i1 == 1) { return "Array" }
    return aifBaseType(ann.s1)
}

fn aifTypeBytes(ann: ASTNode) -> Int {
    // `[T]` and `List<T>` are both a pointer to elements held elsewhere.
    if (ann.i1 == 1) { return 8 }
    if (ann.i2 == 1) { return 8 }

    let n = ann.s1
    if (str_equals(n, "I8") == 1) { return 1 }
    if (str_equals(n, "U8") == 1) { return 1 }
    if (str_equals(n, "Char") == 1) { return 1 }
    if (str_equals(n, "Bool") == 1) { return 1 }
    if (str_equals(n, "I16") == 1) { return 2 }
    if (str_equals(n, "U16") == 1) { return 2 }
    if (str_equals(n, "Int") == 1) { return 4 }
    if (str_equals(n, "I32") == 1) { return 4 }
    if (str_equals(n, "U32") == 1) { return 4 }
    if (str_equals(n, "I64") == 1) { return 8 }
    if (str_equals(n, "U64") == 1) { return 8 }
    if (str_equals(n, "Isize") == 1) { return 8 }
    if (str_equals(n, "Usize") == 1) { return 8 }
    if (str_equals(n, "Float") == 1) { return 8 }
    if (aif_is_enum(n) == 1) { return 4 }

    // String, Ptr, and a struct field that is a reference edge: one pointer.
    // A struct field that is a *containment* edge is its own size instead, and
    // aifStructFieldBytes is where that is asked -- this function has no module
    // to resolve the name against.
    return 8
}

// The bytes a field occupies in its owner. An inline field contributes the whole
// nested layout; everything else contributes what aifTypeBytes says.
//
// aif_struct_size is read back rather than recomputed, which is why
// aifComputeSizes has to size a nested struct before its container.
fn aifStructFieldBytes(module: ASTNode, ann: ASTNode) -> Int {
    if (typeAnnIsPod(module, ann, 0)) {
        if (ir_is_struct_type_name(ann.s1) == 1) {
            let inner = aif_struct_size(ann.s1)
            if (inner > 0) { return inner }
        }
    }
    return aifTypeBytes(ann)
}

// A struct aligns to its widest scalar, not to its size: three i32 inline is 12
// bytes aligned to 4, and the next field lands at 12. Using the size as the
// alignment would put it at 16 and disagree with what LLVM lays out.
fn aifTypeAlign(module: ASTNode, ann: ASTNode) -> Int {
    if (typeAnnIsPod(module, ann, 0)) {
        if (ir_is_struct_type_name(ann.s1) == 1) {
            let decl = findStructDeclNamed(module, ann.s1)
            let mut best = 1
            if (nodeExists(node_to_ptr(decl))) {
                let mut p = decl.child1
                while (str_equals(p, "") == 0) {
                    let f = ptr_to_node(p)
                    if (f.kind == NodeKind.STRUCT_FIELD) {
                        if (nodeExists(f.child1)) {
                            let a = aifTypeAlign(module, ptr_to_node(f.child1))
                            if (a > best) { best = a }
                        }
                    }
                    p = f.next
                }
            }
            return best
        }
    }
    return aifTypeBytes(ann)
}

fn aifAlignUp(offset: Int, align: Int) -> Int {
    let slack = offset % align
    if (slack == 0) { return offset }
    return offset + align - slack
}

// LAYOUT 7.2 runs before this, so the widths are summed in the order codegen will
// emit rather than in declaration order. That is the whole measurable effect of
// the search on this compiler: sorting by descending width removes interior
// padding, and the size it removes feeds Theta_stack, which is what decides T0.
fn aifComputeStructSize(decl: ASTNode, module: ASTNode) {
    let mut offset = 0
    let mut maxAlign = 1

    let n = aif_struct_nfields(decl.s1)
    let mut i = 0
    while (i < n) {
        // The physical order is the search's, so the field at position i is
        // named by aif_layout_field. Its declaration is what carries the type,
        // and an inline field's width is the nested size rather than a word.
        let mut width = aif_layout_field_bytes(decl.s1, i)
        let mut align = width
        let chosen = aif_layout_field(decl.s1, i)
        if (str_equals(chosen, "") == 0) {
            let f = findStructField(decl, chosen)
            if (nodeExists(node_to_ptr(f))) {
                if (nodeExists(f.child1)) {
                    let ann = ptr_to_node(f.child1)
                    width = aifStructFieldBytes(module, ann)
                    align = aifTypeAlign(module, ann)
                }
            }
        }
        if (width > 0) {
            offset = aifAlignUp(offset, align) + width
            if (align > maxAlign) { maxAlign = align }
        }
        i = i + 1
    }

    // Trailing padding, so an array of these would be correctly strided. A
    // zero-field struct still occupies a byte.
    let mut total = aifAlignUp(offset, maxAlign)
    if (total == 0) { total = 1 }
    aif_struct_set_size(decl.s1, total)
}

// `[T]` and `List<T>` both hang T off child1, so descending finds the type the
// field actually refers to; the annotation's own name is `` or `List`.
fn aifAnnotationLeafName(ann: ASTNode) -> String {
    let mut name = ann.s1
    let mut childPtr = ann.child1
    while (nodeExists(childPtr)) {
        let c = ptr_to_node(childPtr)
        name = c.s1
        childPtr = c.child1
    }
    return name
}

fn aifRegisterTypeEdges(decl: ASTNode) {
    let mut fPtr = decl.child1
    while (nodeExists(fPtr)) {
        let f = ptr_to_node(fPtr)
        if (f.kind == NodeKind.STRUCT_FIELD) {
            if (nodeExists(f.child1)) {
                let ann = ptr_to_node(f.child1)
                let reached = aifAnnotationLeafName(ann)
                if (aif_is_struct(reached) == 1) {
                    aif_type_edge(decl.s1, reached)
                }
            }
        }
        fPtr = f.next
    }
}

// Sizes are computed after the layout search, because the search decides the
// order the widths are summed in and therefore the padding. It used to run at the
// top of aifBuild, which is before the walk that builds the access profile --
// too early for a size that depends on it.
//
// Still after the declaration pass, for the reason that placement already had: a
// field typed by an enum declared later in the file must be sized as an i32
// rather than as a pointer.
// An inline field contributes the nested size, so the nested struct has to be
// sized first and declaration order does not supply that. Containment edges are
// followed first, exactly as generateStructDecl follows them to order
// LLVMStructSetBody -- the two walks have to agree, and they agree because both
// ask typeAnnIsPod which edges exist.
fn aifComputeSizesOf(module: ASTNode, d: ASTNode) {
    if (aif_struct_size(d.s1) > 0) { return }
    let mut dp = d.child1
    while (str_equals(dp, "") == 0) {
        let f = ptr_to_node(dp)
        if (f.kind == NodeKind.STRUCT_FIELD) {
            if (nodeExists(f.child1)) {
                let ann = ptr_to_node(f.child1)
                if (typeAnnIsPod(module, ann, 0)) {
                    if (ir_is_struct_type_name(ann.s1) == 1) {
                        if (str_equals(ann.s1, d.s1) == 0) {
                            let dep = findStructDeclNamed(module, ann.s1)
                            if (nodeExists(node_to_ptr(dep))) {
                                aifComputeSizesOf(module, dep)
                            }
                        }
                    }
                }
            }
        }
        dp = f.next
    }
    aifComputeStructSize(d, module)
}

fn aifComputeSizes(module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            aifComputeSizesOf(module, d)
        }
        p = d.next
    }
}

// LAYOUT 6's hot/cold split, the one veto only the frontend can supply.
//
// A split object is two allocations: the hot record holds a pointer to a cold
// block that some allocator hook has to create. **An inline struct field is
// storage inside its owner** -- no hook runs for it, nothing writes its link, and
// the first cold read would be a load through whatever the owner's allocation
// left in those eight bytes. So a type that appears as an inline field is not
// splittable, and the search has to be told before it chooses.
//
// **The registry is empty here, and that is the trap.** `fieldTypeFor` decides
// inline-ness with `ir_is_struct_type_name` + `typeAnnIsPod`, but the struct
// registry is filled by codegen and this runs during the analysis -- so asking
// `ir_is_struct_type_name` here answers 0 for every struct in the program and the
// veto fires for nothing. That is not hypothetical: it is what the first version
// of this function did, and `aif/corpus/g3_scene_graph.psm` stopped building with
// "byte-copy of a split struct (Transform)" from the backend assertion that
// exists for exactly this. A silent version of the same hole is two Nodes sharing
// one Transform's cold block and a double free at the second teardown.
//
// So the registry half is asked of the **AST** instead -- `findStructDeclNamed`,
// which is what the registry is built from and therefore agrees with it by
// construction. The POD half stays `typeAnnIsPod`, and with an empty registry it
// **over**-approximates: a struct-typed field of a struct reads as POD rather
// than recursing, so `structDeclIsPod` can only answer true more often. More true
// means more vetoes means fewer splits, which is the safe direction, and it is
// the only direction the imprecision can go.
fn aifFieldIsInlineStruct(module: ASTNode, ann: ASTNode) -> Bool {
    if (ann.i1 == 1) { return false }
    if (ann.i2 == 1) { return false }
    if (ann.i3 == 1) { return false }
    if (nodeExists(node_to_ptr(findStructDeclNamed(module, ann.s1))) == false) {
        return false
    }
    return typeAnnIsPod(module, ann, 0)
}

fn aifLayoutVetoInline(module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            let mut fp = d.child1
            while (str_equals(fp, "") == 0) {
                let f = ptr_to_node(fp)
                if (f.kind == NodeKind.STRUCT_FIELD) {
                    if (nodeExists(f.child1)) {
                        let ann = ptr_to_node(f.child1)
                        if (aifFieldIsInlineStruct(module, ann)) {
                            // The field's type: it is storage inside `d`, so no
                            // allocator hook ever writes its link word.
                            aif_layout_no_split(ann.s1)
                            // And `d` itself, for a different reason: the cost
                            // model sizes this field as one pointer, because
                            // `aifDeclare` asks `aifTypeBytes` and the struct
                            // registry is empty during the analysis. g3's `Node`
                            // is modelled at 40 bytes and is really 112 -- two
                            // inline `Transform`s at 48 each. A cut chosen from a
                            // shape that wrong is not a choice, and it measured
                            // 1.11x. Declining is cheap; sizing inline fields
                            // properly moves Theta_stack and therefore tiers,
                            // which is a separate change.
                            //
                            // Separate entry point from the line above, and the
                            // distinction is load-bearing: `ann.s1` cannot be
                            // split at all, while `d.s1` merely cannot be
                            // *modelled*. LAYOUT 8 measures instead of modelling,
                            // so a forced candidate clears this veto and never
                            // that one.
                            aif_layout_no_split_unmodelled(d.s1)
                        }
                    }
                }
                fp = f.next
            }
        }
        p = d.next
    }
}
