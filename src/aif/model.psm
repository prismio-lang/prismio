extern fn ir_llvm_version() -> String alias

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// Site kinds, mirroring runtime/aif_support.c. Only "struct" is load-bearing --
// the T0 clause and the copy rule test it -- but the manifest reports the split
// because it is where the residue turns out to live.
let AIF_KIND_STRUCT = 0
let AIF_KIND_STRING = 1
let AIF_KIND_ARRAY = 2
let AIF_KIND_LIST = 3
let AIF_KIND_OPAQUE = 4

// Default round budget. INFERENCE 5.7 makes the budget the only difference
// between optimisation levels; 200 is far past what any observed program needs
// (the compiler's own source converges in single digits), so exhausting it is a
// signal rather than a routine outcome.
let AIF_DEFAULT_ROUNDS = 200

// FFI contract codes. 0 and 1 are FFI 5.1's `borrow` and `retain`; anything >= 2
// is `retain_in(k)` with k = code - 2, which says the callee stores this
// argument into argument k, so it escapes exactly as far as that container does
// and no further.
let AIF_FFI_BORROW = 0
let AIF_FFI_RETAIN = 1
// The callee takes ownership and frees it. Nothing on a stack or in an arena can
// be handed to a free, so this bars T0 the way an explicit `drop` does, and the
// value leaves this frame's control so its escape rises with it.
let AIF_FFI_CONSUME = 2
// The callee writes through the pointer and does not read what was there. No
// ownership consequence at all, so it behaves as `borrow`.
let AIF_FFI_OUT = 3
let AIF_FFI_RETAIN_IN_BASE = 100

// Counters the manifest reports. They exist so that what the model *excludes*
// is visible rather than silent -- an exclusion nobody can see is indistinguish-
// able from a bug.
let mut aifLiteralStrings = 0
let mut aifExternAlloc = 0
let mut aifOpaqueReturns = 0
let mut aifStaticReturns = 0

// The budget this run was given, so the manifest header reports what was
// actually enforced rather than the default.
let mut aifBudget = 200

// How many loops enclose the statement being walked. LAYOUT 7.1 weights a site's
// contribution to an arena's benefit by the loops between them.
let mut aifLoopDepth = 0

// SPEC 5.4's verdicts, mirroring AIF_PIN_* in runtime/aif_support.c.
let AIF_PIN_NONE = 0
let AIF_PIN_HONOURED = 1
let AIF_PIN_REFUTED = 2
let AIF_PIN_UNPROVEN = 3

// The derivation's root, mirroring AIF_RULE_ALLOC in runtime/aif_support.c: the
// fact was never raised and is still where the allocation put it.
let AIF_RULE_ALLOC = 14

// FFI 5.4: the default contract for an extern nobody declared one for. `borrow`
// is optimistic, `retain` costs 33 points of tier distribution on this
// compiler's own source (RESULTS-L0 4.1). Kept switchable because that
// measurement is the argument for the default.
let mut aifFfiDefault = 0

// The empty value set. -1 rather than an allocated empty one, because
// aif_support.c reads any out-of-range value set as empty and the walk produces
// a great many of these.
fn aifVsEmpty() -> Int {
    return 0 - 1
}

// ---------------------------------------------------------------------------
// Type classification
// ---------------------------------------------------------------------------

// The type a node was given by sema, spelled the way diagnostics spell it.
// Empty for nodes sema does not type -- statements and declarations.
fn aifNodeType(node: ASTNode) -> String {
    if (nodeExists(node.typeInfo)) {
        return typeDisplay(ptr_to_type(node.typeInfo))
    }
    return ""
}

// `List<Token>` -> `List`. Field keys are per nominal type, so a generic
// container's fields are shared across its instantiations -- object-insensitive
// in the type argument as well as in the object (INFERENCE 11.1).
fn aifBaseType(ty: String) -> String {
    let at = str_index_of(ty, "<")
    if (at < 0) {
        return ty
    }
    return str_substring(ty, 0, at)
}

// Does a value of this type participate in the memory model at all? Scalars and
// enums do not: they are registers, they are copied, and there is nothing to
// reclaim.
fn aifIsRef(ty: String) -> Bool {
    if (str_equals(ty, "") == 1) { return false }
    if (str_equals(ty, "Int") == 1) { return false }
    if (str_equals(ty, "I8") == 1) { return false }
    if (str_equals(ty, "I16") == 1) { return false }
    if (str_equals(ty, "I32") == 1) { return false }
    if (str_equals(ty, "I64") == 1) { return false }
    if (str_equals(ty, "U8") == 1) { return false }
    if (str_equals(ty, "U16") == 1) { return false }
    if (str_equals(ty, "U32") == 1) { return false }
    if (str_equals(ty, "U64") == 1) { return false }
    if (str_equals(ty, "Isize") == 1) { return false }
    if (str_equals(ty, "Usize") == 1) { return false }
    if (str_equals(ty, "Float") == 1) { return false }
    if (str_equals(ty, "Bool") == 1) { return false }
    if (str_equals(ty, "Char") == 1) { return false }
    if (str_equals(ty, "Void") == 1) { return false }
    if (aif_is_enum(ty) == 1) { return false }
    return true
}

fn aifKindOf(ty: String) -> Int {
    if (aif_is_struct(ty) == 1) { return AIF_KIND_STRUCT }
    if (str_equals(ty, "String") == 1) { return AIF_KIND_STRING }
    if (str_equals(aifBaseType(ty), "List") == 1) { return AIF_KIND_LIST }
    if (str_starts_with(ty, "[") == 1) { return AIF_KIND_ARRAY }
    if (str_equals(ty, "Array") == 1) { return AIF_KIND_ARRAY }
    return AIF_KIND_OPAQUE
}

fn aifKindName(kind: Int) -> String {
    if (kind == AIF_KIND_STRUCT) { return "struct" }
    if (kind == AIF_KIND_STRING) { return "string" }
    if (kind == AIF_KIND_ARRAY) { return "array" }
    if (kind == AIF_KIND_LIST) { return "list" }
    return "opaque"
}

// A container's contents, as a field key.
//
// Elements are a field of the container, and treating them as one gets the whole
// of INFERENCE 3.1's field-sensitivity for free: object-insensitive, so every
// `List` shares an element key, exactly as `Lexer.source` is one key across every
// Lexer. Through aifBaseType for the same reason its own comment gives --
// merging `List<Token>` with `List<Node>` is imprecise and sound, and keying on
// the spelled type would be neither, because `list_new()` types as `List<Invalid>`
// and an annotated binding does not. Two spellings of one container that did not
// share a key would lose edges, and a lost edge is the unsound direction.
fn aifElemKey(containerType: String) -> Int {
    return aif_key_field(aifBaseType(containerType), "@elem")
}

// ---------------------------------------------------------------------------
// Value-set helpers
// ---------------------------------------------------------------------------

fn aifVsOfSite(site: Int) -> Int {
    let v = aif_vs_new()
    aif_vs_site(v, site)
    return v
}

fn aifVsOfKey(key: Int) -> Int {
    let v = aif_vs_new()
    aif_vs_key(v, key)
    return v
}

// The node pointer is what codegen later looks the tier up by, so it is
// registered here rather than derived: the two passes walk the same tree in the
// same process, and one node names one site exactly.
fn aifNewSite(ty: String, fnId: Int, scope: Int, nodePtr: String) -> Int {
    let node = ptr_to_node(nodePtr)
    let sid = aif_site_new(ty, aifKindOf(ty), fnId, scope,
                           node.file, node.line, node.col, aif_struct_nfields(ty))
    aif_site_note_node(sid, nodePtr)
    return sid
}
