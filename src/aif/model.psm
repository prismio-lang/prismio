// The AIF model: tier and rule constants, how a type is classified, and the
// value sets and allocation sites the solver works over.

import ast.nodes
import ast.types
import ast.int_width
import ast.float_width
import common.text
import common.diagnostics

// AIF — the Adaptive Inference Framework, Prismio's memory model.
//
// This is the pass docs/aif/implementation/COMPILER-AUDIT.md 4.1 says the compiler
// does not have and needs first:
//
//     sema  ->  [ fact graph -> inference -> tier assignment -> manifest ]  ->  ir
//
// It runs after analyzeModule and before generateModule, and at this level it
// **changes no codegen**. Every allocation still goes through ir_alloc_object;
// what this produces is the manifest (SPEC 6), which is the artifact that makes
// the tier distribution measurable before any of it is risked on the self-host.
// That is COMPILER-AUDIT 5's Level 0, and it is deliberately the whole scope:
// if the distribution is bad, the model is falsified cheaply and no codegen was
// written against it.
//
// WHAT IT IMPLEMENTS
//   INFERENCE 2      the E / A / T / C lattices
//   INFERENCE 3-4    the fact graph and the escape, aliasing and cyclicity
//                    transfer rules
//   INFERENCE 5      round iteration to a fixed point, with the mandatory
//                    widening on budget exhaustion
//   SPEC 4.2         tier derivation, clause for clause
//   SPEC 6.2         the manifest, in the normative sorted line-oriented form
//   FFI 5            ownership contracts for the runtime surface
//
// APPROXIMATIONS. Each makes the answer more conservative -- a higher tier --
// never less, so a good number here is trustworthy and a bad one may be
// pessimistic. They are the prototype's, kept identical on purpose (see
// "THE ORACLE" below).
//
//   A1  Flow-insensitive: a value's facts are the join over all program points.
//       INFERENCE 11.3 already accepts this for loops; here it is everywhere.
//   A2  Field-sensitive, object-insensitive -- one node per (struct, field),
//       as INFERENCE 3.1 specifies. INFERENCE 11.1 is the known cost.
//   A3  Context-insensitive: every function is analysed at the TOP context.
//       Ownership contexts (SPEC 2.2) are AIF-2 work and contributed zero to
//       every measured tier number.
//   A4  Thread affinity is modelled (REQUIREMENTS 15, 2026-08-19). It was
//       vacuous before that: the language had no tasks, every value was
//       Isolated, and T4a was unreachable by construction. Two decisions are
//       shared with tools/aif_oracle/aif.py and so cannot be checked by the
//       differential -- T-SPAWN-SHARE's premise is read as `A = Shared`, and
//       E-SPAWN-J's "joined on every path" is decided syntactically. Both are
//       argued at the rule in src/aifcore/solver.psm.
//   A5  Struct size is approximated by field count for the T0/T1 split. The
//       AST carries no layout, and SPEC 4.2 leaves Theta_stack implementation-
//       defined and requires only that it be documented -- it is, in the
//       manifest header.
//
// THE ORACLE. tools/aif_oracle/aif.py implements the same rules against the JSON
// from `prismio dump-ast`. Both must produce the same distribution over the
// same source. That is differential testing against an independent
// implementation, and it is the only reliable defence against a transfer
// function that is subtly wrong and yields a silently wrong tier rather than a
// crash. Where the prototype approximates, this file approximates identically
// and says so at the site -- a deliberate, documented divergence would be fine;
// an accidental one would destroy the test.
//
// The engine itself -- the containers, the solver and the queries codegen asks -- is the `aifcore` package.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string
import aifcore.call_graph
import aifcore.constraints
import aifcore.keys
import aifcore.nominals
import aifcore.sites

// A mask, not an enum: the gate reports every clause that rejected, because the
// first one is reliably the wrong thing to act on. See src/aifcore/.
let AIF_ARENA_B_NOT_T1 = 1
let AIF_ARENA_B_NO_STACK = 2
let AIF_ARENA_B_IN_CONTAINER = 4
let AIF_ARENA_B_IS_LIST = 8
let AIF_ARENA_B_NO_REGION = 16
let AIF_ARENA_B_ESCAPES = 32
let AIF_ARENA_B_OUTLIVES = 64

// The obligations `aif_fn_bracket_blockers` reports, as a mask. Every failing
// one is reported, not the first -- the same decision as AIF_ARENA_B_*, for the
// same reason: three sessions acted on a gate's first clause and each time the
// site was rejected by two more.
let AIF_BR_B_GLOBAL = 1
let AIF_BR_B_PARAM_STORE = 2
let AIF_BR_B_OPAQUE = 4
let AIF_BR_B_DROP = 8
let AIF_BR_B_SHARED_BODY = 16
// Regime (a)'s call-site half, split out from SHARED_BODY 2026-08-28. Reported
// separately because the repair is different: SHARED_BODY needs specialisation
// (regime (b)), while this one needs only that the callers agree on a region,
// which `bracketRegimeOk` asks and often finds they already do.
let AIF_BR_B_MULTI_CALL = 32

// The string surface comes from utils.psm; only what it does not declare is
// declared here. Redeclaring one with a different signature would be merged
// away silently by resolveImports -- whichever module was reached first wins.
public extern fn ir_llvm_version() -> String alias

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// Site kinds, mirroring src/aifcore/. Only "struct" is load-bearing --
// the T0 clause and the copy rule test it -- but the manifest reports the split
// because it is where the residue turns out to live.
let AIF_KIND_STRUCT = 0
let AIF_KIND_STRING = 1
let AIF_KIND_ARRAY = 2
let AIF_KIND_LIST = 3
let AIF_KIND_OPAQUE = 4

// Default round budget. INFERENCE 5.7 makes the budget the only difference
// between optimisation levels; 200 is far past what any observed program needs
// (the compiler's own source converges in single digits), so exhausting it is a
// signal rather than a routine outcome.
let AIF_DEFAULT_ROUNDS = 200

// FFI contract codes. 0 and 1 are FFI 5.1's `borrow` and `retain`; anything >= 2
// is `retain_in(k)` with k = code - 2, which says the callee stores this
// argument into argument k, so it escapes exactly as far as that container does
// and no further.
let AIF_FFI_BORROW = 0
let AIF_FFI_RETAIN = 1
// The callee takes ownership and frees it. Nothing on a stack or in an arena can
// be handed to a free, so this bars T0 the way an explicit `drop` does, and the
// value leaves this frame's control so its escape rises with it.
let AIF_FFI_CONSUME = 2
// The callee writes through the pointer and does not read what was there. No
// ownership consequence at all, so it behaves as `borrow`.
let AIF_FFI_OUT = 3
let AIF_FFI_RETAIN_IN_BASE = 100
// Not a contract: "the runtime table has never heard of this name". It has to be
// distinguishable from a declared `borrow`, because FFI 5.1's default *is*
// `borrow` and a bracketing decision must not read a guess as a description.
// aifFfiContract maps it to the default, so no transfer rule sees it.
//
// 99 rather than -1: a global initializer must be a literal (nothing runs before
// main), and the language has no negative literal. It sits in the gap between
// the four contract codes and RETAIN_IN_BASE, so it collides with nothing.
let AIF_FFI_UNKNOWN = 99

// Counters the manifest reports. They exist so that what the model *excludes*
// is visible rather than silent -- an exclusion nobody can see is indistinguish-
// able from a bug.
let mut aifLiteralStrings = 0
let mut aifExternAlloc = 0
let mut aifOpaqueReturns = 0
let mut aifStaticReturns = 0

// The budget this run was given, so the manifest header reports what was
// actually enforced rather than the default.
let mut aifBudget = 200

// How many loops enclose the statement being walked. LAYOUT 7.1 weights a site's
// contribution to an arena's benefit by the loops between them.
let mut aifLoopDepth = 0
// M3.2. Which statement of its block the walk is on, **one-based**: 0 means
// "not in a statement list" and n means statement n-1. A global needs a constant
// initializer and the language has no negative literal, so the off-by-one buys
// the sentinel. Saved and restored around a nested block rather than reset
// globally: a block numbers its own statements on the way down and the
// enclosing chain has to resume its own on the way back out.
let mut aifStmtCursor = 0

// SPEC 5.4's verdicts, mirroring AIF_PIN_* in src/aifcore/.
let AIF_PIN_NONE = 0
let AIF_PIN_HONOURED = 1
let AIF_PIN_REFUTED = 2
let AIF_PIN_UNPROVEN = 3

// The derivation's root, mirroring AIF_RULE_ALLOC in src/aifcore/: the
// fact was never raised and is still where the allocation put it.
let AIF_RULE_ALLOC = 14

// FFI 5.4: the default contract for an extern nobody declared one for. `borrow`
// is optimistic, `retain` costs 33 points of tier distribution on this
// compiler's own source (RESULTS-L0 4.1). Kept switchable because that
// measurement is the argument for the default.
let mut aifFfiDefault = 0

// The empty value set. -1 rather than an allocated empty one, because
// src/aifcore/ reads any out-of-range value set as empty and the walk produces
// a great many of these.
internal fn aifVsEmpty() -> Int {
    return 0 - 1
}

// Empty, and saying so: static storage a release cannot tell from an allocation
// -- what an `alias` extern hands back, a module global's value. It resolves to
// no site like aifVsEmpty, and a field that may be handed one is released by
// nobody. Allocated, unlike aifVsEmpty, because the flag has to live somewhere.
// A string literal is aifVsLiteral: its pair says what it is.
internal fn aifVsUntracked() -> Int {
    let vs = aif_vs_new()
    aif_vs_mark_untracked(vs)
    return vs
}

// A string literal's value set: no site, untracked, and not a hazard.
internal fn aifVsLiteral() -> Int {
    let vs = aif_vs_new()
    aif_vs_mark_literal(vs)
    return vs
}

// ---------------------------------------------------------------------------
// Type classification
// ---------------------------------------------------------------------------

// The type a node was given by sema, spelled the way diagnostics spell it.
// Empty for nodes sema does not type -- statements and declarations.
internal fn aifNodeType(node: ASTNode) -> String {
    if (nodeExists(node.typeInfo)) {
        return typeKeyName(ptr_to_type(node.typeInfo))
    }
    return ""
}

// `List<Token>` -> `List`. Field keys are per nominal type, so a generic
// container's fields are shared across its instantiations -- object-insensitive
// in the type argument as well as in the object (INFERENCE 11.1).
internal fn aifBaseType(ty: String) -> String {
    let at = ty.indexOf("<")
    if (at < 0) {
        return ty
    }
    return ty.substring(0, at)
}

// Does a value of this type participate in the memory model at all? Scalars and
// enums do not: they are registers, they are copied, and there is nothing to
// reclaim.
internal fn aifIsRef(ty: String) -> Bool {
    if (ty.equals("")) { return false }
    if (ty.equals("Int")) { return false }
    if (ty.equals("I8")) { return false }
    if (ty.equals("I16")) { return false }
    if (ty.equals("I32")) { return false }
    if (ty.equals("I64")) { return false }
    if (ty.equals("U8")) { return false }
    if (ty.equals("U16")) { return false }
    if (ty.equals("U32")) { return false }
    if (ty.equals("U64")) { return false }
    if (ty.equals("Isize")) { return false }
    if (ty.equals("Usize")) { return false }
    if (ty.equals("Float")) { return false }
    if (floatKeyOfName(ty).equals("") == false) { return false }
    if (intWidthOfName(ty) > 0) { return false }
    if (ty.equals("Bool")) { return false }
    if (ty.equals("Char")) { return false }
    if (ty.equals("Void")) { return false }
    if (aif_is_enum(ty) == 1) { return false }
    return true
}

private fn aifKindOf(ty: String) -> Int {
    if (aif_is_struct(ty) == 1) { return AIF_KIND_STRUCT }
    if (ty.equals("String")) { return AIF_KIND_STRING }
    if (aifBaseType(ty).equals("List")) { return AIF_KIND_LIST }
    // A DataView has the same analysis-relevant resource shape as a List: it is
    // affine, dynamically sized, owns subordinate storage, cannot become T0,
    // and is not arena-placed. Codegen still selects its distinct release from
    // the semantic TypeKind.
    if (aifBaseType(ty).equals("DataView")) { return AIF_KIND_LIST }
    if (ty.startsWith("[")) { return AIF_KIND_ARRAY }
    if (ty.equals("Array")) { return AIF_KIND_ARRAY }
    return AIF_KIND_OPAQUE
}

internal fn aifKindName(kind: Int) -> String {
    if (kind == AIF_KIND_STRUCT) { return "struct" }
    if (kind == AIF_KIND_STRING) { return "string" }
    if (kind == AIF_KIND_ARRAY) { return "array" }
    if (kind == AIF_KIND_LIST) { return "list" }
    return "opaque"
}

// A container's contents, as a field key.
//
// Elements are a field of the container, and treating them as one gets the whole
// of INFERENCE 3.1's field-sensitivity for free: object-insensitive, so every
// `List` shares an element key, exactly as `Lexer.source` is one key across every
// Lexer. Through aifBaseType for the same reason its own comment gives --
// merging `List<Token>` with `List<Node>` is imprecise and sound, and keying on
// the spelled type would be neither, because `list_new()` types as `List<Invalid>`
// and an annotated binding does not. Two spellings of one container that did not
// share a key would lose edges, and a lost edge is the unsound direction.
// INFERENCE 3.1. Keyed on the container's *full* type rather than its base, so
// `List<Actor>` and `List<Order>` are different sets -- see aif_elem_key in
// src/aifcore/ for why that is sound and for the guard that restores
// the base-keyed answer where a spelling is not resolved.
internal fn aifElemKey(containerType: String) -> Int {
    return aif_elem_key(containerType)
}

// A Slice<T> resolves through the List<T> handle it carries. Element points-to
// facts therefore belong to the List key, not to a parallel Slice key that no
// store ever populates.
internal fn aifElementContainerType(ty: String) -> String {
    if (ty.startsWith("Slice<")) {
        return "List".concat(ty.substring(5, ty.length - 5))
    }
    return ty
}

// ---------------------------------------------------------------------------
// Value-set helpers
// ---------------------------------------------------------------------------

internal fn aifVsOfSite(site: Int) -> Int {
    let v = aif_vs_new()
    aif_vs_site(v, site)
    return v
}

internal fn aifVsOfKey(key: Int) -> Int {
    let v = aif_vs_new()
    aif_vs_key(v, key)
    return v
}

// The node pointer is what codegen later looks the tier up by, so it is
// registered here rather than derived: the two passes walk the same tree in the
// same process, and one node names one site exactly.
// REQUIREMENTS 4. A site whose static type is `T?` allocates a `T`: optionality
// is a state of the slot, not a different kind of allocation, which is exactly
// what typeIsMoveOnly already says on the type side. Without this the site's kind
// is `opaque` -- `aif_is_struct("Job?")` is 0 -- so nothing releases it and every
// value that reaches a binding through an optional leaks.
//
// Inert on everything that existed before v0.1's channels: a `Node?` field is
// filled from a `Node` literal, so no site had an optional type until `chan_recv`
// became the first call whose *return* is one. Verified by the AIF manifests over
// tests/ and the retired corpus being unchanged across this edit.
private fn aifSiteType(ty: String) -> String {
    let n = ty.length
    if (n > 1 and ty.endsWith("?")) { return ty.substring(0, n - 1) }
    return ty
}

internal fn aifNewSite(rawTy: String, fnId: Int, scope: Int, nodePtr: Ptr) -> Int {
    let node = ptr_to_node(nodePtr)
    let ty = aifSiteType(rawTy)
    let sid = aif_site_new(ty, aifKindOf(ty), fnId, scope,
                           node.file, node.line, node.col, aif_struct_nfields(ty))
    aif_site_note_node(sid, nodePtr)
    return sid
}
