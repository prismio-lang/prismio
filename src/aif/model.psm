extern fn aif_fn_name(f: Int) -> String
extern fn aif_fn_is_sealed(f: Int) -> Int

// SPEC 5.2.1's first named repair, in its report-only half. The call graph is
// recorded here rather than reconstructed later because the walk is the only
// place that knows which function a call expression sits in *and* which scope --
// and both are needed: the closure needs the caller, the "calls in a region"
// count needs the scope.
extern fn aif_call_edge(caller: Int, callee: Int, scope: Int)
extern fn aif_call_opaque(caller: Int, scope: Int)
extern fn aif_note_owner_use(fnId: Int, vs: Int)
extern fn aif_fn_bracket_blockers(f: Int) -> Int
extern fn aif_fn_call_sites(f: Int) -> Int
extern fn aif_fn_calls_in_region(f: Int) -> Int
extern fn aif_region_call_sites() -> Int
extern fn aif_bracketable_region_call_sites() -> Int
extern fn aif_call_edge_count() -> Int

// SPEC 5.2.1.1's placement half. One entry per call the compiler bracketed, and
// the manifest is required to print them: regime (a) is fragile as a language
// guarantee -- a second call to a bracketed callee silently removes the
// placement -- so the loss has to appear as a diff rather than as a slowdown.
extern fn aif_bracket_count() -> Int
extern fn aif_bracket_callee(i: Int) -> Int
extern fn aif_bracket_scope(i: Int) -> Int
extern fn aif_bracket_served(i: Int) -> Int
extern fn aif_site_is_bracketed(id: Int) -> Int

// The obligations `aif_fn_bracket_blockers` reports, as a mask. Every failing
// one is reported, not the first -- the same decision as AIF_ARENA_B_*, for the
// same reason: three sessions acted on a gate's first clause and each time the
// site was rejected by two more.
let AIF_BR_B_GLOBAL = 1
let AIF_BR_B_PARAM_STORE = 2
let AIF_BR_B_OPAQUE = 4
let AIF_BR_B_DROP = 8
let AIF_BR_B_SHARED_BODY = 16
// Regime (a)'s call-site half, split out from SHARED_BODY 2026-08-28. Reported
// separately because the repair is different: SHARED_BODY needs specialisation
// (regime (b)), while this one needs only that the callers agree on a region,
// which `bracket_regime_ok` asks and often finds they already do.
let AIF_BR_B_MULTI_CALL = 32

extern fn aif_struct_new(name: String)
extern fn aif_enum_new(name: String)
extern fn aif_struct_add_field(name: String, field: String, type: String, bytes: Int)
// The layout half of a field: 1 when its storage is the object's own -- a struct
// value copied in rather than a pointer stored. A separate call rather than a
// fifth argument above, because the committed seed's IR calls the four-argument
// form and changing an FFI signature is a two-step change.
extern fn aif_struct_field_inline(name: String, field: String, inlined: Int)

// LAYOUT 2.1's access profile, statically estimated, and 7.2's search over it.
// `weight` is AIF_LOOP_ITERS per enclosing loop -- the same estimator automatic
// arena placement uses for allocs_in(s).
extern fn aif_field_access(type: String, field: String, weight: Int)
extern fn aif_layout_select()

// LAYOUT 5's cost model needs which fields are touched *together*, which a
// per-field count cannot express: two fields with equal counts touched by
// different loops want opposite sides of a hot/cold cut. These bracket a loop so
// every aif_field_access inside it lands in the same traversal.
extern fn aif_traversal_begin()
extern fn aif_traversal_end()
// `let p = list_get(ps, i)` -- the loop walks a container in order, which is what
// makes a smaller hot record worth anything. Without this a traversal is treated
// as a pointer chase.
extern fn aif_traversal_elem(type: String, sequential: Int)

// LAYOUT 7.2's `argmin over candidates(tau)`, and 8's "ranked by modelled cost".
extern fn aif_layout_rank(type: String) -> Int
extern fn aif_layout_candidates() -> Int
extern fn aif_layout_best() -> Int
extern fn aif_layout_cand_hot(i: Int) -> Int
extern fn aif_layout_cand_ratio(i: Int) -> Int
extern fn aif_layout_cand_field_hot(i: Int, f: Int) -> Int
extern fn aif_layout_cand_bytes(i: Int, cold: Int) -> Int
extern fn aif_layout_traversals(type: String) -> Int
// 8's top-k, in cost order. `k = 0` is the argmin `aif_layout_best` reports; -1
// means k is past the last candidate. Ties break on the candidate index, which is
// 9.1's total order, so the k-th candidate is the same on every host.
extern fn aif_layout_cand_at_rank(k: Int) -> Int

// LAYOUT 6's hot/cold split, taken rather than reported.
//
// `aif_layout_split_select` runs the ranking above over every type and keeps the
// winning cut when it beats not splitting. It has to run **after** aifComputeSizes
// -- so a split cannot change the sizes the solve reads -- and **before** the
// solve, because forcing `aif_type_releases` for a split type is what routes its
// cold block to a release at all.
//
// `aif_layout_no_split` is the veto, and it is pushed in before the decision, not
// after: a type embedded *inline* in another struct is storage inside its owner,
// so nothing ever calls an allocator for it and its link word would be whatever
// the owner's allocation left behind.
extern fn aif_layout_no_split(type: String)
extern fn aif_layout_split_select()
extern fn aif_layout_hot_count(type: String) -> Int

// Veto 5, on its own channel because LAYOUT 8 may override this one and must never
// override `aif_layout_no_split`. Both come from the same discovery -- a struct
// with an inline struct field -- but the field's *type* cannot be split at all,
// while its *owner* is merely unmodellable: `aifTypeBytes` sizes that field as one
// pointer, so g3's `Node` is modelled at 40 bytes and is really 112. The owner's
// split is sound, it just has no basis for being chosen.
extern fn aif_layout_no_split_unmodelled(type: String)

// LAYOUT 8's forced candidate: emit this cut rather than the model's argmin.
//
// A candidate is named by its hot-field count, not its rank, because ranks move
// when the model is retuned and `hot_count` is a property of the layout -- so the
// `split 8/12` a human reads off `--layout` is what they can force. The force is
// checked against the enumerated candidates and is *not* silently dropped when it
// matches nothing: `aif_layout_force_applied` is how this compiler avoids adding
// another instrument that reports success while matching nothing.
extern fn aif_layout_force(type: String, hotCount: Int)
extern fn aif_layout_forced_count() -> Int
extern fn aif_layout_forced_type(i: Int) -> String alias
extern fn aif_layout_forced_hot(i: Int) -> Int
extern fn aif_layout_force_applied(i: Int) -> Int

// LAYOUT 2.2. A measured profile, replacing the static estimate above. Answers 1
// when it read at least one record; 0 means no file, or a file naming nothing
// this module declares, and the caller falls back (W2).
extern fn aif_profile_load(path: String) -> Int
// `static`, or `workload:NAME`. A `static char*` from the intern table.
extern fn aif_profile_source() -> String alias
extern fn aif_profile_is_measured() -> Int

// LAYOUT 2.1's `range(f)`. Dynamic only, so these answer 0 under a static
// profile -- which is why bit-packing declines without a workload rather than
// packing against a range it invented.
extern fn aif_field_has_range(type: String, field: String) -> Int
extern fn aif_field_range_lo(type: String, field: String) -> I64
extern fn aif_field_range_hi(type: String, field: String) -> I64
// The narrowest signed width that holds the range, in bytes; 8 when there is
// no range. In C because the comparison needs I64 literals -- see the note at
// the definition.
extern fn aif_field_range_bytes(type: String, field: String) -> Int
extern fn aif_layout_field(type: String, i: Int) -> String alias
extern fn aif_layout_field_bytes(type: String, i: Int) -> Int
extern fn aif_layout_reordered(type: String) -> Int
extern fn aif_struct_set_size(name: String, bytes: Int)
extern fn aif_struct_size(name: String) -> Int
extern fn aif_is_struct(name: String) -> Int
extern fn aif_is_enum(name: String) -> Int
extern fn aif_struct_nfields(name: String) -> Int
extern fn aif_type_edge(from: String, to: String)
extern fn aif_compute_type_acyclic()
extern fn aif_nominal_count() -> Int
extern fn aif_nominal_name(i: Int) -> String
extern fn aif_nominal_is_struct(i: Int) -> Int
extern fn aif_nominal_acyclic(i: Int) -> Int

