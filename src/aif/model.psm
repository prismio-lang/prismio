// The AIF model: tier and rule constants, how a type is classified, and the
// value sets and allocation sites the solver works over.

import ast.nodes
import ast.types
import common.text
import common.diagnostics

// AIF — the Adaptive Inference Framework, Prismio's memory model.
//
// This is the pass aif/implementation/COMPILER-AUDIT.md 4.1 says the compiler
// does not have and needs first:
//
//     sema  ->  [ fact graph -> inference -> tier assignment -> manifest ]  ->  ir
//
// It runs after analyzeModule and before generateModule, and at this level it
// **changes no codegen**. Every allocation still goes through ir_alloc_object;
// what this produces is the manifest (SPEC 6), which is the artifact that makes
// the tier distribution measurable before any of it is risked on the self-host.
// That is COMPILER-AUDIT 5's Level 0, and it is deliberately the whole scope:
// if the distribution is bad, the model is falsified cheaply and no codegen was
// written against it.
//
// WHAT IT IMPLEMENTS
//   INFERENCE 2      the E / A / T / C lattices
//   INFERENCE 3-4    the fact graph and the escape, aliasing and cyclicity
//                    transfer rules
//   INFERENCE 5      round iteration to a fixed point, with the mandatory
//                    widening on budget exhaustion
//   SPEC 4.2         tier derivation, clause for clause
//   SPEC 6.2         the manifest, in the normative sorted line-oriented form
//   FFI 5            ownership contracts for the runtime surface
//
// APPROXIMATIONS. Each makes the answer more conservative -- a higher tier --
// never less, so a good number here is trustworthy and a bad one may be
// pessimistic. They are the prototype's, kept identical on purpose (see
// "THE ORACLE" below).
//
//   A1  Flow-insensitive: a value's facts are the join over all program points.
//       INFERENCE 11.3 already accepts this for loops; here it is everywhere.
//   A2  Field-sensitive, object-insensitive -- one node per (struct, field),
//       as INFERENCE 3.1 specifies. INFERENCE 11.1 is the known cost.
//   A3  Context-insensitive: every function is analysed at the TOP context.
//       Ownership contexts (SPEC 2.2) are AIF-2 work and contributed zero to
//       every measured tier number.
//   A4  Thread affinity is modelled (REQUIREMENTS 15, 2026-08-19). It was
//       vacuous before that: the language had no tasks, every value was
//       Isolated, and T4a was unreachable by construction. Two decisions are
//       shared with aif/prototype/aif.py and so cannot be checked by the
//       differential -- T-SPAWN-SHARE's premise is read as `A = Shared`, and
//       E-SPAWN-J's "joined on every path" is decided syntactically. Both are
//       argued at the rule in runtime/aif_support.c.
//   A5  Struct size is approximated by field count for the T0/T1 split. The
//       AST carries no layout, and SPEC 4.2 leaves Theta_stack implementation-
//       defined and requires only that it be documented -- it is, in the
//       manifest header.
//
// THE ORACLE. aif/prototype/aif.py implements the same rules against the JSON
// from `prismio dump-ast`. Both must produce the same distribution over the
// same source. That is differential testing against an independent
// implementation, and it is the only reliable defence against a transfer
// function that is subtly wrong and yields a silently wrong tier rather than a
// crash. Where the prototype approximates, this file approximates identically
// and says so at the site -- a deliberate, documented divergence would be fine;
// an accidental one would destroy the test.
//
// The containers live in runtime/aif_support.c. That file's header says why.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string

// ---------------------------------------------------------------------------
// runtime/aif_support.c
// ---------------------------------------------------------------------------

extern fn aif_reset()

extern fn aif_scope_new(parent: Int, owner: Int) -> Int
extern fn aif_scope_set_region(scope: Int, name: String borrow)
extern fn aif_region_name_at_site(id: Int) -> String alias
extern fn aif_site_arena_is_pinned(id: Int) -> Int

// SPEC 5.2's diagnostic. How many sites the arena at this scope actually serves,
// by the codegen gate, and where to underline when the answer is zero.
extern fn aif_scope_set_region_span(scope: Int, file: Int, line: Int, col: Int)
extern fn aif_region_serves(scope: Int) -> Int
extern fn aif_scope_region_file(s: Int) -> Int
extern fn aif_scope_region_line(s: Int) -> Int
extern fn aif_scope_region_col(s: Int) -> Int

// SPEC 6.3's witness path for placement. Which clause of the arena gate declined
// this site, and the region it would otherwise have been served by.
extern fn aif_arena_blockers(id: Int) -> Int
extern fn aif_nearest_region_name(id: Int) -> String alias

// A mask, not an enum: the gate reports every clause that rejected, because the
// first one is reliably the wrong thing to act on. See runtime/aif_support.c.
let AIF_ARENA_B_NOT_T1 = 1
let AIF_ARENA_B_NO_STACK = 2
let AIF_ARENA_B_IN_CONTAINER = 4
let AIF_ARENA_B_IS_LIST = 8
let AIF_ARENA_B_NO_REGION = 16
let AIF_ARENA_B_ESCAPES = 32
let AIF_ARENA_B_OUTLIVES = 64

// SPEC 5's annotations. `unique` cuts the aliasing graph at a site; `pin`
// constrains the tier after convergence, and its verdict is one of AIF_PIN_*.
extern fn aif_con_unique(vs: Int)
extern fn aif_con_pin(vs: Int, tier: Int)
extern fn aif_check_pins(converged: Int)
extern fn aif_site_pin_verdict(id: Int) -> Int
extern fn aif_site_pin_tier(id: Int) -> Int
extern fn aif_site_derived_tier(id: Int) -> Int
extern fn aif_site_alias_axiom(id: Int) -> Int

// SPEC 5.4 applied to *placement* rather than to the tier: `pin(<region-name>)`
// asserts that this allocation is served by the arena of the `region` with that
// name, and a converged analysis that says otherwise refutes it (SPEC 5.4.1).
//
// It exists because of SPEC 5.2.1.1's own admission. Regime (a) brackets a call
// only while its callee has exactly one call site, so **adding a second call
// silently removes the placement** -- the program still compiles, still runs,
// and gets slower with no diagnostic and no failing test. The manifest is
// required to record every bracket for exactly that reason; this turns the
// record into an assertion a build can fail on.
//
// It reads `aif_region_name_at_site` and nothing else, which is the one arena
// gate every other consumer reads. A second copy of that predicate is the defect
// this file's neighbours have already paid for having four of.
extern fn aif_con_pin_region(vs: Int, name: String borrow)
extern fn aif_check_placement_pins(converged: Int)
extern fn aif_site_pin_region_verdict(id: Int) -> Int
extern fn aif_site_pin_region(id: Int) -> String alias

// REQUIREMENTS 15, INFERENCE 4.1 and 4.3. One `spawn`, and both boundary rules
// ride it: E-SPAWN vs E-SPAWN-J is chosen by `joined`, and T-SPAWN-MOVE vs
// T-SPAWN-SHARE is chosen inside the solver from the aliasing fact rather than
// from anything the walk can see.
//
// `scope` is what E-SPAWN-J binds the arguments to when the task is joined
// before that scope exits. It is ignored when `joined` is 0, because E-SPAWN's
// conclusion is Global and has no scope to name.
extern fn aif_con_spawn(vs: Int, scope: Int, joined: Int)

// INFERENCE 2.3, read back per site: 0 Isolated, 1 Transferred, 2 CrossThread.
// The manifest prints it and the drop path reads it to choose between a plain
// decrement and an atomic one.
extern fn aif_site_thread(id: Int) -> Int

// INFERENCE 4.3's T-STATIC premise: does this program create any task at all?
// A whole-program property, so it is asked of the module and not of a site.
extern fn aif_program_has_tasks() -> Int

// INFERENCE 5.6 / SPEC 6.3. The derivation, read back as a witness path.
extern fn aif_con_at(file: Int, line: Int, col: Int)
// M3.2. Where in its block a statement sits. A scope is a set of statements and
// carries no order, so an extent that ends at last use has nothing to end at
// without this. Set as the walk goes, read by the next site or call edge made.
extern fn aif_stmt_at(scope: Int, index: Int)
// M3.2b. A read of a binding. Recorded against the statement of the binding's
// *declaring* scope that encloses the read, which is what makes a use inside a
// nested block still pin the enclosing region's extent open.
extern fn aif_var_note_use(fnId: Int, name: String, scope: Int)
extern fn aif_cause_domain_for(id: Int) -> Int
extern fn aif_cause_build(id: Int, domain: Int) -> Int
extern fn aif_cause_site(i: Int) -> Int
extern fn aif_cause_rule(i: Int) -> Int
extern fn aif_cause_value(i: Int) -> Int
extern fn aif_cause_file(i: Int) -> Int
extern fn aif_cause_line(i: Int) -> Int
extern fn aif_cause_col(i: Int) -> Int
extern fn aif_rule_name(rule: Int) -> String alias
extern fn aif_escape_name(value: Int) -> String alias
extern fn aif_alias_name(value: Int) -> String alias

// LAYOUT 7.1. The scope carries the block it came from, so codegen can ask a
// block whether an arena was placed there, and its loop depth, which is what
// weights a site's contribution to the benefit.
extern fn aif_scope_note_node(scope: Int, node: Ptr)
extern fn aif_scope_set_loop_depth(scope: Int, depth: Int)
extern fn aif_place_arenas()

extern fn aif_fn_new(symbol: String, name: String, file: Int) -> Int
