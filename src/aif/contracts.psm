// FFI ownership contracts, as declared on an extern and as the runtime is known
// to behave. What a foreign call does to provenance is the single largest source
// of imprecision, so both halves are read here rather than assumed.

import ast.nodes
import ast.types
import common.text
import common.diagnostics
import std.string
import std.option

// ---------------------------------------------------------------------------
// FFI ownership contracts (FFI 5)
//
// These describe the Prismio runtime surface. They cannot be inferred -- the
// callee is C -- and both available guesses are wrong: `borrow` everywhere is
// unsound where a callee does retain, and `retain` everywhere sinks every value
// that ever touches a runtime call.
//
// `retain_in(k)` is the entry that matters and it is not in FFI.md's vocabulary
// yet: `list_push` is neither `borrow` nor `retain`, and collections are the
// most common FFI shape in a systems language. Without it every element pushed
// into a list looks like it never escapes, which is optimistic, i.e. unsound.
// ---------------------------------------------------------------------------

// Decodes what an `extern` declaration said, if it said anything.
// Returns -1 when there is no declared contract, so the caller can fall through
// to the runtime table and then to the default.
private fn aifDeclaredContract(name: String, index: Int) -> Int {
    let text = aif_extern_contract(name, index)
    if (strEquals(text, "")) { return 0 - 1 }

    if (strEquals(text, "borrow")) { return AIF_FFI_BORROW }
    if (strEquals(text, "retain")) { return AIF_FFI_RETAIN }
    if (strEquals(text, "consume")) { return AIF_FFI_CONSUME }
    if (strEquals(text, "out")) { return AIF_FFI_OUT }

    if (strStartsWith(text, "retain_in:")) {
        let k = optionOr(strParseInt(strSubstring(text, 10, __builtin_string_len(text) - 10)), 0)
        return AIF_FFI_RETAIN_IN_BASE + k
    }

    // `alias` and `produce` are return contracts and sema has already rejected
    // them on a parameter, so reaching here means the declaration was malformed
    // and never got past the checker. Default rather than guess.
    return 0 - 1
}

// Compiler builtins are visible to AIF as call-shaped AST nodes but disappear
// before LLVM. Their effects therefore belong here, separately from the foreign
// runtime table below: all three inspect or modify storage only for the duration
// of the operation and retain nothing.
private fn aifCompilerBuiltinContract(name: String, index: Int) -> Int {
    if (strEquals(name, "__builtin_string_len")) { return AIF_FFI_BORROW }
    if (strEquals(name, "__builtin_string_byte_at")) { return AIF_FFI_BORROW }
    if (strEquals(name, "__builtin_string_put_byte")) { return AIF_FFI_BORROW }
    if (strEquals(name, "slice_len")) { return AIF_FFI_BORROW }
    if (strEquals(name, "slice_set")) {
        if (index == 2) { return AIF_FFI_RETAIN_IN_BASE + 0 }
        return AIF_FFI_BORROW
    }
    if (strEquals(name, "soa")) { return AIF_FFI_CONSUME }
    if (strEquals(name, "aos")) { return AIF_FFI_CONSUME }
    if (strEquals(name, "data_len")) { return AIF_FFI_BORROW }
    return AIF_FFI_UNKNOWN
}

// The ownership semantics of the Prismio runtime's own surface.
//
// **This is a fallback, not the source of truth.** A declared contract wins;
// this only answers for a call whose `extern` says nothing, and it exists
// because these functions' semantics are a property of the runtime rather than
// of any one program's declaration of it -- every corpus program declares
// `list_push` itself, and none of them should have to get it right for the
// analysis to be sound. FFI 5.3a is the measurement that made `retain_in`
// necessary in the first place.
//
// It should shrink as declarations gain contracts, and the entry that matters is
// `list_push`: without it every element pushed into a list appears never to
// escape, which is optimistic and therefore unsound.
private fn aifRuntimeContract(name: String, index: Int) -> Int {
    if (strEquals(name, "list_push")) {
        if (index == 1) { return AIF_FFI_RETAIN_IN_BASE + 0 }
        return AIF_FFI_BORROW
    }
    // `list_set(list, index, value)` -- the stored value is argument **2**.
    // Argument 1 is the integer index, and naming it here said the *index*
    // escapes into the container while the value only borrows: optimistic, and
    // therefore exactly the unsoundness the comment above warns about. Both this
    // and the oracle had it, identically, which is how a differential test agrees
    // on a wrong answer. Latent until Level 5, when a stored value that appeared
    // not to escape took a stack slot and list_set wrote a frame pointer into a
    // container that outlives the frame.
    if (strEquals(name, "list_set")
        or strEquals(name, "list_set_exclusive")) {
        if (index == 2) { return AIF_FFI_RETAIN_IN_BASE + 0 }
        return AIF_FFI_BORROW
    }
    if (strEquals(name, "list_get")) { return AIF_FFI_BORROW }
    if (strEquals(name, "list_len")) { return AIF_FFI_BORROW }
    // The C string layer is native Prismio now, so only the calls that are still
    // real runtime boundaries have contracts here. str_char_at, str_contains,
    // str_starts_with, str_ends_with, str_index_of and str_from_char were removed
    // from lang_runtime.c in 2026-08 and their contracts went with them: a
    // contract for a symbol nothing can link is a rule that can only ever fire on
    // a typo.
    if (strEquals(name, "str_concat")) { return AIF_FFI_BORROW }
    if (strEquals(name, "str_equals")) { return AIF_FFI_BORROW }
    if (strEquals(name, "str_substring")) { return AIF_FFI_BORROW }
    if (strEquals(name, "str_slice")) { return AIF_FFI_BORROW }
    if (strEquals(name, "print")) { return AIF_FFI_BORROW }
    if (strEquals(name, "println")) { return AIF_FFI_BORROW }
    // AIF_FFI_UNKNOWN rather than the default, and the distinction is the whole
    // point: FFI 5.1's default is a *guess* that the callee does not retain, and
    // a guess is exactly what call-site bracketing must not build on. Every
    // caller that only wants a contract maps this back to the default one line
    // below, so nothing about the tier analysis moves.
    return AIF_FFI_UNKNOWN
}

// Declared contract, compiler builtin, runtime table, then FFI 5.1's default.
internal fn aifFfiContract(name: String, index: Int) -> Int {
    let declared = aifDeclaredContract(name, index)
    if (declared >= 0) {
        return declared
    }
    let builtin = aifCompilerBuiltinContract(name, index)
    if (builtin != AIF_FFI_UNKNOWN) {
        return builtin
    }
    let table = aifRuntimeContract(name, index)
    if (table == AIF_FFI_UNKNOWN) {
        return aifFfiDefault
    }
    return table
}

// SPEC 5.2.1's bracketing question, at a call: is what this callee does to the
// values it is handed *described*, or assumed?
//
// A described call can be summarised, because the contract says what it retains
// and the solver has already applied it. An assumed one cannot: FFI 5.1's
// `borrow` default is sound enough for a tier (a wrong guess there is caught by
// the same widening that catches everything else) but bracketing hands the
// callee arena memory, and an undescribed callee that retains it turns the
// annotation into a use-after-free.
//
// A declaration counts only when it is **complete** -- every parameter and the
// return. A partial one leaves undescribed exactly the argument nobody thought
// about, which is the one that retains.
internal fn aifCallIsSummarised(name: String, argc: Int) -> Bool {
    if (aifCompilerBuiltinContract(name, 0) != AIF_FFI_UNKNOWN) { return true }
    if (aifRuntimeContract(name, 0) != AIF_FFI_UNKNOWN) { return true }
    if (aifFfiProduces(name)) { return true }
    if (strEquals(aif_extern_contract(name, 0 - 1), "")) { return false }
    let mut i = 0
    while (i < argc) {
        if (aifDeclaredContract(name, i) < 0) { return false }
        i = i + 1
    }
    return true
}

// FFI 5.2 `alias`: the return is an existing value reached through an argument,
// not a fresh allocation. Modelled by returning that argument's own sites.
//
// `list_get` is deliberately NOT here any more, and the reason is a soundness
// bug this comment used to describe as fixed: it claimed "an element read back
// out of a list is the element rather than a new object", and returning the
// argument's value set does not do that -- it returns *the list*. Reading an
// element and pushing it into a second container then recorded the container as
// the element, so A-CONTAIN never saw the sharing and the second container was
// told its elements were lists when they were structs. Elements go through
// aifElemKey now, which is what makes that sentence true.
internal fn aifFfiAliasOf(name: String) -> Int {
    // REQUIREMENTS 4. `expect(x)` is the identity on a pointer -- it checks and
    // hands back the same one -- so its result is argument 0's sites. Without
    // this it reads as an opaque extern return: a fresh site, escape raised to
    // Caller, and the unwrapped value would stop being reclaimable by whatever
    // owned the optional.
    if (strEquals(name, "expect")) { return 0 }
    return 0 - 1
}

// Which argument's element field a call reads, or -1. The counterpart of
// `retain_in(k)` on the way out: one says a value was stored into the container
// at k, this says the result came back out of it.
internal fn aifFfiReadsElement(name: String) -> Int {
    if (strEquals(name, "list_get")) { return 0 }
    return 0 - 1
}

// The static type of a call's k-th argument. Walking the argument list again is
// safe only because reading a type creates nothing; evaluating one creates sites,
// which is why the values go through the argv stack instead.
internal fn aifArgTypeAt(call: ASTNode, index: Int) -> String {
    let mut i = 0
    let mut aPtr = call.child2
    while (nodeExists(aPtr)) {
        let a = ptr_to_node(aPtr)
        if (i == index) { return aifNodeType(a) }
        i = i + 1
        aPtr = a.next
    }
    return ""
}

// FFI 5.2's return contracts, read off the declaration. `alias` says the return
// borrows from an argument or from static storage rather than being a fresh
// allocation, so it must not be modelled as one; `produce` says the caller owns
// it, which is exactly what the undeclared case cannot assume.
internal fn aifDeclaredReturnIsProduce(name: String) -> Bool {
    return strStartsWith(aif_extern_contract(name, 0 - 1), "produce")
}

internal fn aifDeclaredReturnIsAlias(name: String) -> Bool {
    return strEquals(aif_extern_contract(name, 0 - 1), "alias")
}

// FFI 5.2 `produce`: a fresh owned value the caller must release. Anything
// undeclared has unknown provenance -- it may already be shared and may already
// outlive this frame -- and is handled by the `opaque` constraint instead.
internal fn aifFfiProduces(name: String) -> Bool {
    if (strEquals(name, "list_new")) { return true }
    if (strEquals(name, "list_new_with_capacity")) { return true }
    if (strEquals(name, "soa")) { return true }
    if (strEquals(name, "aos")) { return true }
    if (strEquals(name, "str_concat")) { return true }
    if (strEquals(name, "str_substring")) { return true }
    // Same contract as str_substring, and for the same reason: **every**
    // path allocates, including the out-of-range one, which returns an
    // owned one-byte string rather than the literal "".
    if (strEquals(name, "str_slice")) { return true }
    if (strEquals(name, "int_to_str")) { return true }
    if (strEquals(name, "read_file")) { return true }
    if (strEquals(name, "get_directory")) { return true }
    if (strEquals(name, "join_path")) { return true }
    return false
}
