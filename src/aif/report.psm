// Everything the `aif` subcommand prints: the manifest, the summary tables, the
// minimal-cause derivation, and the pin and budget reports.

import ast.nodes
import ast.types
import common.text
import common.diagnostics

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

fn aifTierName(tier: Int) -> String {
    if (tier == 0) { return "T0" }
    if (tier == 1) { return "T1" }
    if (tier == 2) { return "T2" }
    if (tier == 3) { return "T3" }
    // SPEC 3: T4 is one tier with two sub-classes, and they are ordered here
    // with T4a on top -- see AIF_T4A in runtime/aif_support.c for why that
    // ordinal rather than the other. The consequence a reader meets first is
    // that the tables below print T4b before T4a, which is ordinal order and
    // not a mistake.
    if (tier == 4) { return "T4b" }
    return "T4a"
}

// SPEC 6.2's `placement` column, which is SPEC 3's codegen contract per tier.
// T1 names the region it is bound to: a `region` statement's name when one
// encloses it and the value cannot outlive it, otherwise the implicit region of
// its own scope, which has no arena and is served by the heap.
// INFERENCE 2.3's lattice, for the manifest's `thread` column.
fn aifThreadName(t: Int) -> String {
    if (t == 0) { return "Isolated" }
    if (t == 1) { return "Transferred" }
    return "CrossThread"
}

fn aifPlacement(tier: Int, site: Int) -> String {
    if (tier == 0) { return "stack" }

    // SPEC 5.2.1.1. Asked before the tier ladder, because an arena can now serve
    // a site whose tier is not T1. A bracketed call's allocations keep the tier
    // they derived -- T2, since a value that crossed a function boundary has
    // E = Caller by construction -- while the arena serving them is the caller's
    // `region`. SPEC 5.2 says why they are separable: the tier is the derived
    // fact and the placement is the codegen decision. Printing `owned` for a
    // value the arena bump-allocates would be the manifest describing a build
    // that did not happen, which is the whole reason `rc:none` exists below.
    let placed = aif_region_name_at_site(site)
    if (str_equals(placed, "") == 0) { return str_concat("region:", placed) }

    if (tier == 1) {
        // `region:none`, not `region:scope`, and the rename is the whole point.
        // T1 with no arena is a value the heap serves and free() reclaims one at
        // a time -- the ordinary path, not a region. `region:scope` was true in
        // the sense that every scope is an implicit region (SPEC 4.1) and read as
        // confirmation that a `region` annotation had worked: on g2_region.psm
        // the manifest showed `region:` on every T1 line while the arena served 0
        // of 10,201,215 allocations. Same discipline as `rc:none` below -- the
        // manifest states the mechanism the binary contains.
        return "region:none"
    }
    if (tier == 2) { return "owned" }
    // T3 says the facts permit a count; whether one was emitted is a separate
    // question, and reporting "rc" for a site nothing counts would make the
    // manifest assert a mechanism the binary does not contain. `rc:none` is a
    // value that leaks: an opaque pointer with no header of ours in front of it,
    // a string or list allocated past the seam, or one held by no container.
    if (tier == 3) {
        if (aif_site_is_rc(site) == 1) { return "rc" }
        return "rc:none"
    }
    // T4b, and the same distinction one tier up. `rc+cycle` was printed for every
    // T4b site while the collector did not exist -- the manifest asserting a
    // mechanism the binary did not contain, which is exactly what the `rc`/
    // `rc:none` split was introduced to stop. `cycle:none` is a value the
    // collector cannot take: an opaque pointer, one allocated past the seam, or
    // one no container holds, so nothing ever decrements it into a candidate.
    if (tier == 4) {
        if (aif_site_is_cyclic(site) == 1) { return "rc+cycle" }
        return "cycle:none"
    }
    // T4a. SPEC 3's cost table calls this an atomic count word, and SPEC 6.2's
    // own worked example prints `rc-atomic` in this column. The same
    // does-the-binary-contain-it discipline applies as one tier down: a site
    // nothing counts gets `rc:none` whatever its thread affinity, because an
    // atomic increment that is never emitted is not a mechanism the binary has.
    //
    // "a value meeting both conditions pays both" (SPEC 3) is why the cyclic
    // case is spelled out rather than folded away: a T4a site whose type is in
    // a non-trivial SCC needs the collector too, and the manifest has to say so.
    if (aif_site_is_rc(site) == 0) { return "rc:none" }
    if (aif_site_is_cyclic(site) == 1) { return "rc-atomic+cycle" }
    return "rc-atomic"
}

fn aifCountTier(tier: Int) -> Int {
    let mut n = 0
    let mut i = 0
    let total = aif_site_count()
    while (i < total) {
        if (aif_tier_of(i) == tier) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn aifCountKind(kind: Int) -> Int {
    let mut n = 0
    let mut i = 0
    let total = aif_site_count()
    while (i < total) {
        if (aif_site_kind(i) == kind) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn aifCountKindTier(kind: Int, tier: Int) -> Int {
    let mut n = 0
    let mut i = 0
    let total = aif_site_count()
    while (i < total) {
        if (aif_site_kind(i) == kind and aif_tier_of(i) == tier) { n = n + 1 }
        i = i + 1
    }
    return n
}

// Pads to `width`, and **always leaves at least one trailing space**.
//
// The second half is the whole point and it was missing. A field wider than its
// column used to be emitted unpadded, so it ran straight into the next one with
// no separator -- and SPEC 6.2's record table is whitespace-separated, so such a
// line stops being a record. `tools/aif_manifest_diff.py` ignores what it cannot
// parse, which made this silent: `g5_asset_cache.psm` emits 14 records and the
// differ read 13, because `load_material__Struct_AssetCache_Int_Int_Float#0` is
// 45 characters against a 44-wide column and merged with its own tier. **A tier
// regression on that site could not have failed the gate** -- SPEC 11 item 8's
// check, unable to fail, on a symbol in this project's own corpus.
//
// Every caller prints something after this on the same line, so the guaranteed
// space never becomes trailing whitespace at end of line.
fn aifPad(s: String, width: Int) -> String {
    let mut n = str_length(s)
    // Already at or past the column: one space, so the fields stay separable.
    // Tested before the loop, because after it `n >= width` always holds and
    // padding every field by one more character would shift the whole table.
    if (n >= width) { return str_concat(s, " ") }
    let mut out = s
    while (n < width) {
        out = str_concat(out, " ")
        n = n + 1
    }
    return out
}

fn aifKv(key: String, value: String) {
    print(aifPad(key, 12))
    println(value)
}

fn aifSitePosition(site: Int) -> String {
    let path = diag_file_path(aif_site_file(site))
    return str_concat(str_concat(path, ":"), str_concat(int_to_str(aif_site_line(site)),
           str_concat(":", int_to_str(aif_site_col(site)))))
}

// The manifest's record name. Numbering within the declaring function rather
// than by source position is what keeps a diff readable: an edit shows up on the
// function it changed, and adding a line at the top of a file does not rewrite
// every record below it.
fn aifSymbolOf(site: Int) -> String {
    let owner = aif_site_fn(site)
    let mut base = "<module>"
    if (owner >= 0) { base = aif_fn_symbol(owner) }
    return str_concat(str_concat(base, "#"), int_to_str(aif_site_ordinal(site)))
}

// SPEC 6.2. Line-oriented UTF-8, records sorted byte-wise ascending by symbol --
// the sort is normative, because an unstable order makes every diff useless.
fn aifEmitManifest(module: ASTNode, sourcePath: String, version: String, converged: Bool) {
    let total = aif_site_count()

    println("aif-manifest 1")
    aifKv("level", "AIF-1")
    // SPEC 11.0 requires a level and forbids claiming one whose requirements
    // are not met; it says nothing about exceeding one, and exceeding is not a
    // conformance violation. But a bare `AIF-1` had become misleading in one
    // direction that matters to a reader deciding what this build can be
    // trusted to have analysed.
    //
    // REQUIREMENTS 15 put a working thread domain and a reachable T4a into a
    // build that meets none of AIF-2's other seven rows -- no layout search, no
    // cost-placed arenas, no T3 elision, no collector. Inflating the
    // declaration to AIF-2 would claim all of those. Recording the two rows
    // that are genuinely ahead says the true thing and claims nothing else.
    aifKv("exceeds", "inference:thread concurrency:isolation")
    // `prismio aif` never runs codegen, so the manifest it prints describes an
    // analysis, not a build. SPEC 7.3's verify mode changes the allocator names
    // and nothing the inference does, so the facts here are the same either way.
    aifKv("build", "release")
    aifKv("budget", str_concat(int_to_str(aifBudget), " rounds"))
    if (converged) {
        aifKv("converged", "yes")
    } else {
        aifKv("converged", "no")
    }
    // Split because the two phases truncate very differently: a budget that
    // stops the points-to phase leaves the whole graph unproven, one that stops
    // the fact phase leaves only a frontier.
    aifKv("rounds", str_concat(str_concat(int_to_str(aif_rounds()), " (points-to "),
                                str_concat(int_to_str(aif_pt_rounds()), ")")))
    // SPEC 4.2 requires the implementation document its Theta_stack. This is
    // where it does it.
    let mut thetaUnit = " bytes"
    if (aif_theta_mode() == 1) { thetaUnit = " fields (oracle-parity mode)" }
    aifKv("theta-stack", str_concat(int_to_str(aif_theta_stack()), thetaUnit))
    aifKv("ffi-default", "borrow")
    aifKv("compiler", str_concat("prismio ", version))
    aifKv("llvm", ir_llvm_version())
    aifKv("source", sourcePath)
    aifKv("sites", int_to_str(total))
    // CYCLES 2's headline result, and it costs one line: a program whose types
    // have no non-trivial SCC needs no cycle collector, and this is where the
    // compiler says so. It is a property of the type declarations, checkable
    // before any inference runs -- not a tuning outcome and not a heuristic.
    // REQUIREMENTS 19. The arena high-water mark, which is what a fixed-budget
    // target needs from a build artifact. An estimate, and it names the part it
    // cannot see rather than guessing at it: a struct's size comes from its
    // layout, a string's is its length, and a fabricated per-string constant
    // would make the `pin` gate turn on a number nobody computed.
    let unsized = aif_arena_unsized_sites()
    let mut budgetNote = str_concat(int_to_str(aif_arena_high_water()), " bytes peak arena (est.)")
    if (unsized > 0) {
        budgetNote = str_concat(budgetNote,
                                 str_concat(str_concat(", ", int_to_str(unsized)),
                                            " dynamically-sized site(s) excluded"))
    }
    aifKv("peak-bytes", budgetNote)

    // LAYOUT 2.2: "An implementation SHALL treat a missing profile as the static
    // profile, and SHALL record in the manifest which was used." Both halves are
    // load-bearing -- a manifest is how a build is made describable (SPEC item
    // 8), and a layout chosen from measured counts is not reproducible from the
    // source alone. Without this line a reader cannot tell whether the `layout`
    // column below is a fact about the program or about a machine.
    aifKv("profile", aif_profile_source())

    let sccTypes = aif_scc_type_count()
    if (sccTypes == 0) {
        aifKv("cycles", "none")
    } else {
        aifKv("cycles", str_concat(str_concat("collector (", int_to_str(sccTypes)),
                                    str_concat(" cyclic type(s), ",
                                    str_concat(int_to_str(aif_t4b_site_count()), " T4b site(s))"))))
    }
    println("#")
    println("# symbol                                      tier  thread       placement         type            layout      origin            site")

    let mut i = 0
    while (i < total) {
        aif_order_add(aifSymbolOf(i), i)
        i = i + 1
    }
    aif_order_sort()

    // A record whose facts came from a truncated iteration is not a settled
    // proof, and SPEC 6.2 makes that visible: a reviewer should read a large
    // budget-exhausted population as a signal to raise the budget, not as a
    // result. Only the widened frontier is marked -- the rest of a truncated
    // build converged, and calling those records exhausted too would make the
    // signal useless for deciding whether to raise the budget.
    let n = aif_order_count()
    let mut r = 0
    while (r < n) {
        let site = aif_order_site(r)
        let tier = aif_tier_of(site)
        // SPEC 6.2's vocabulary. `region` means the arena serving this site was
        // pinned by a `region` statement rather than chosen by LAYOUT 7.1's cost
        // model -- a pin that stops being honoured is a gate regression and an
        // inferred placement moving is not, so the two have to be tellable apart.
        let mut origin = "inferred"
        if (aif_site_arena_is_pinned(site) == 1) { origin = "region" }
        if (aif_site_alias_axiom(site) == 1) { origin = "unique" }
        if (aif_site_pin_verdict(site) == AIF_PIN_HONOURED) { origin = "pin" }
        // SPEC 5.4: "A `pin` that is honoured SHALL be recorded in the manifest
        // as honoured." A placement pin reads `pin` for the same reason a tier
        // pin does, and loses nothing by it -- the `placement` column three to
        // the left already names the region, so the pair says which arena was
        // asserted *and* that it was asserted rather than inferred.
        if (aif_site_pin_region_verdict(site) == AIF_PIN_HONOURED) { origin = "pin" }
        if (aif_site_widened(site) == 1) { origin = "budget-exhausted" }
        print(aifPad(aif_order_symbol(r), 44))
        print(aifPad(aifTierName(tier), 6))
        // INFERENCE 2.3, recorded because a manifest that omits it cannot gate
        // the one regression this domain has.
        //
        // A value moving Transferred -> CrossThread is a non-atomic count
        // becoming an atomic one. That is exactly what SPEC 11 item 10 forbids
        // on the common path -- and for a T4a site it moves no tier, for a T1
        // site it moves no tier either, so without this column the CI differ
        // sees an identical manifest and passes. SPEC 6.2 asks the manifest to
        // make a build describable; an undescribed fact is one nothing can
        // regress against.
        print(aifPad(aifThreadName(aif_site_thread(site)), 13))
        print(aifPad(aifPlacement(tier, site), 18))
        print(aifPad(aif_site_type(site), 16))
        // LAYOUT 6's grouping dimension is always AoS -- SoA needs handles, which
        // is RESULTS-layout 1's finding -- so what this column reports is the two
        // dimensions that *are* emitted. `AoS*` is a struct whose physical order is
        // not its declaration order; `+h/n` is a hot/cold split keeping `h` of `n`
        // fields in the hot record, with the rest behind the link pointer.
        //
        // The column is 12 wide rather than 8 because `AoS*+13/15` is 10. A field
        // wider than its column runs into the next one, the CI differ ignores what
        // it cannot parse, and a tier regression then cannot fail the gate --
        // which has happened here once already.
        let mut grouping = "AoS"
        if (aif_layout_reordered(aif_site_type(site)) == 1) { grouping = "AoS*" }
        let hotCount = aif_layout_hot_count(aif_site_type(site))
        if (hotCount > 0) {
            grouping = str_concat(grouping, str_concat("+", str_concat(int_to_str(hotCount),
                        str_concat("/", int_to_str(aif_struct_nfields(aif_site_type(site)))))))
        }
        print(aifPad(grouping, 12))
        print(aifPad(origin, 18))
        println(aifSitePosition(site))
        r = r + 1
    }

    aifEmitBrackets()
    aifEmitPackingAdvice(module)
}

// SPEC 5.2.1.1: "an implementation using [regime (a)] SHALL record in the
// manifest which call sites it bracketed."
//
// The requirement exists because regime (a) is fragile *as a language
// guarantee*, not because it is unsound: adding a second call to a bracketed
// callee removes the placement, and the program still compiles and still runs.
// Without this section that shows up as a slowdown nobody can attribute; with
// it, it is a line that disappears from a diff.
//
// Printed only when something was bracketed, so every program that brackets
// nothing keeps a byte-identical manifest.
fn aifEmitBrackets() {
    let n = aif_bracket_count()
    if (n == 0) { return }

    println("#")
    println("# bracketed calls (SPEC 5.2.1.1 regime (a)) -- a second call to one of these removes the placement")
    let mut i = 0
    while (i < n) {
        let scope = aif_bracket_scope(i)
        print("#   ")
        print(aifPad(aif_fn_name(aif_bracket_callee(i)), 30))
        print(aifPad(str_concat("region:", aif_scope_region(scope)), 24))
        print(aifPad(str_concat(int_to_str(aif_bracket_served(i)), " site(s) served"), 20))
        let path = diag_file_path(aif_scope_region_file(scope))
        println(str_concat(str_concat(path, ":"),
                str_concat(int_to_str(aif_scope_region_line(scope)),
                str_concat(":", int_to_str(aif_scope_region_col(scope))))))
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// LAYOUT 6's packing dimension, reported rather than performed -- and the reason
// is a conflict between two clauses of this specification, not caution.
//
// LAYOUT 2.1 makes `range(f)` dynamic-only and says it "enables bit-packing".
// LAYOUT 3.2's W4 says two builds with different profiles SHALL produce
// behaviourally identical programs. Those cannot both hold for a narrowing
// driven by an observed range: a workload that only ever stores 0..40 in an
// `Int` field authorises an i8, and the *next* input that stores 300 gets 44 in
// the packed build and 300 in the unpacked one. That is a behavioural difference
// between two builds differing only in their profile, which is exactly what W4
// forbids -- and it is a miscompile, not a lost optimisation, so SPEC 1 forbids
// it independently.
//
// An observed range is not a bound. Making it one needs either a value analysis
// that proves the bound, or a programmer annotation asserting it -- and a fifth
// annotation is a governance change (SPEC 11 item 7 fixes the count at four),
// which is not a decision an implementation gets to take on its own.
//
// So what is emitted is the measurement and the saving it would buy, as advice.
// This is not the packing dimension implemented; it is the input to it, made
// visible so it is not measured and thrown away. What it would be worth on this
// corpus is in RESULTS-layout.md: an upper bound of 9.4% of struct bytes,
// assuming every narrowing were free and legal.
fn aifEmitPackingAdvice(module: ASTNode) {
    if (aif_profile_is_measured() == 0) { return }

    let mut shown = 0
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            let mut fPtr = d.child1
            let mut index = 0
            while (nodeExists(fPtr)) {
                let f = ptr_to_node(fPtr)
                if (f.kind == NodeKind.STRUCT_FIELD) {
                    // Field 0 is pinned by the punned-slot invariant and is never
                    // a packing candidate, so advising on it would be advice the
                    // compiler could not take even with a proof.
                    if (index > 0) {
                        if (aif_field_has_range(d.s1, f.s1) == 1) {
                            let declared = aifTypeBytes(ptr_to_node(f.child1))
                            let lo = aif_field_range_lo(d.s1, f.s1)
                            let hi = aif_field_range_hi(d.s1, f.s1)
                            let needed = aif_field_range_bytes(d.s1, f.s1)
                            if (needed < declared) {
                                if (shown == 0) {
                                    println("#")
                                    println("# measured field ranges narrower than their declared type. Advice only:")
                                    println("#   an observed range is not a bound, and narrowing on one would break W4.")
                                    println("# type.field                    declared  observed range        fits in")
                                }
                                print("# ")
                                print(aifPad(str_concat(str_concat(d.s1, "."), f.s1), 30))
                                print(aifPad(str_concat(int_to_str(declared), " bytes"), 10))
                                // Narrowed to Int for printing, which is exact
                                // here and only here: this branch runs when the
                                // range fits in 1 or 2 bytes, so both ends are
                                // inside i32 by the test just above.
                                print(aifPad(str_concat(str_concat(int_to_str(lo as Int), ".."),
                                                         int_to_str(hi as Int)), 22))
                                println(str_concat(int_to_str(needed), " bytes"))
                                shown = shown + 1
                            }
                        }
                    }
                    index = index + 1
                }
                fPtr = f.next
            }
        }
        p = d.next
    }
}

fn aifEmitKindRow(kind: Int) {
    let n = aifCountKind(kind)
    if (n == 0) { return }
    print("  ")
    print(aifPad(aifKindName(kind), 9))
    print(aifPad(int_to_str(n), 8))
    let mut t = 0
    while (t < 6) {
        print(aifPad(int_to_str(aifCountKindTier(kind, t)), 7))
        t = t + 1
    }
    println("")
}

// The distribution, in the form the oracle prints it. This is what gets compared
// against aif/prototype/aif.py, so it reports the same quantities under the same
// names -- including the exclusions, because a site the model declines to count
// is exactly the kind of difference that would otherwise hide a real one.
fn aifEmitSummary(sourcePath: String, converged: Bool) {
    let total = aif_site_count()
    let mut denom = total
    if (denom == 0) { denom = 1 }

    print("# ")
    print(sourcePath)
    print("  (")
    print(int_to_str(aif_fn_count()))
    print(" functions, ")
    print(int_to_str(aif_nominal_count()))
    println(" nominal types)")

    print("aif-manifest 1 (in-compiler)  rounds=")
    print(int_to_str(aif_rounds()))
    print("  converged=")
    if (converged) { print("yes") } else { print("no") }
    print("  constraints=")
    println(int_to_str(aif_con_count()))

    print("sites        ")
    print(int_to_str(total))
    print("   (excluded: ")
    print(int_to_str(aifLiteralStrings))
    println(" string literals -- static, not allocated)")

    print("opaque-ret   ")
    print(int_to_str(aifOpaqueReturns))
    println("  (undeclared extern/sealed returns -- provenance unknown)")

    print("extern-alloc ")
    print(int_to_str(aifExternAlloc))
    println("  (values produced by runtime calls, e.g. str_concat)")

    print("static-ret   ")
    print(int_to_str(aifStaticReturns))
    println("  (declared `alias` with nothing to alias -- static, not allocated)")

    println("#")
    println("# tier distribution  (BENCHMARKS H1: static D over abstract values)")

    let mut cheap = 0
    let mut t = 0
    while (t < 6) {
        let n = aifCountTier(t)
        if (t < 3) { cheap = cheap + n }
        print("  ")
        print(aifPad(aifTierName(t), 5))
        print(aifPad(int_to_str(n), 8))
        print(aifPad(str_concat(int_to_str(100 * n / denom), "%"), 6))
        let mut bar = ""
        let mut b = 0
        let width = 60 * n / denom
        while (b < width) {
            bar = str_concat(bar, "#")
            b = b + 1
        }
        println(bar)
        t = t + 1
    }

    println("")
    print("  T0-T2 (no runtime bookkeeping): ")
    print(int_to_str(cheap))
    print(" / ")
    print(int_to_str(total))
    print(" = ")
    print(int_to_str(100 * cheap / denom))
    println("%")
    print("  H1 kill criterion is < 70%.  ")
    if (100 * cheap / denom >= 70) { println("PASS") } else { println("FAIL") }

    println("")
    println("# by allocation kind -- where the residue actually lives")
    println("  kind     sites   T0     T1     T2     T3     T4b    T4a")
    let mut k = 0
    while (k < 5) {
        aifEmitKindRow(k)
        k = k + 1
    }

    println("")
    // INFERENCE 2.3, as a distribution. Compared by tools/aif_differential.py,
    // and that is what it is here for: tier counts alone cannot tell "the two
    // thread modules agree" from "neither implementation has one", which is
    // what they agreed on for six sessions.
    println("# thread affinity (INFERENCE 2.3)")
    let mut ti = 0
    while (ti < 3) {
        let mut n = 0
        let mut si = 0
        while (si < total) {
            if (aif_site_thread(si) == ti) { n = n + 1 }
            si = si + 1
        }
        print("  ")
        print(aifPad(aifThreadName(ti), 12))
        println(int_to_str(n))
        ti = ti + 1
    }

    println("")
    println("# cyclicity (CYCLES 1-2)")
    let mut cyclic = 0
    let mut structs = 0
    let mut i = 0
    while (i < aif_nominal_count()) {
        if (aif_nominal_is_struct(i) == 1) {
            structs = structs + 1
            if (aif_nominal_acyclic(i) == 0) { cyclic = cyclic + 1 }
        }
        i = i + 1
    }
    if (cyclic == 0) {
        print("  none -- no struct type lies in a non-trivial SCC, of ")
        print(int_to_str(structs))
        println(" struct types.")
        println("  The collector can be omitted from the binary entirely.")
    } else {
        print("  collector needed: ")
        print(int_to_str(cyclic))
        print(" of ")
        print(int_to_str(structs))
        println(" struct types lie in or reach a non-trivial SCC")
    }

    aifEmitBracketing()
}

// SPEC 5.2.1's first repair, measured before it is built.
//
// The census says 196 of 196 blocked sites fail `no_region` -- the allocation is
// in a callee and the arena is in the caller. The repair is to bracket the
// *call*. This reports how far that could reach, and it reports it as counts
// rather than as a verdict so the answer can be read before any placement code
// exists: **if almost no function qualifies, the rest of that work is not worth
// doing, and that is a result rather than a failure.**
//
// Nothing here decides anything. It reads the converged facts and the call
// graph, and prints. The binary is byte-identical with and without it.
fn aifEmitBracketing() {
    let fnCount = aif_fn_count()
    let mut ok = 0
    let mut sole = 0
    let mut nGlobal = 0
    let mut nParam = 0
    let mut nOpaque = 0
    let mut nDrop = 0
    let mut nShared = 0

    let mut f = 0
    while (f < fnCount) {
        let mask = aif_fn_bracket_blockers(f)
        if (mask / AIF_BR_B_GLOBAL % 2 == 1) { nGlobal = nGlobal + 1 }
        if (mask / AIF_BR_B_PARAM_STORE % 2 == 1) { nParam = nParam + 1 }
        if (mask / AIF_BR_B_OPAQUE % 2 == 1) { nOpaque = nOpaque + 1 }
        if (mask / AIF_BR_B_DROP % 2 == 1) { nDrop = nDrop + 1 }
        if (mask / AIF_BR_B_SHARED_BODY % 2 == 1) { nShared = nShared + 1 }
        // The allocation obligations alone. SHARED_BODY is not one of them --
        // it is regime (a)'s restriction on *codegen*, reported beside the
        // safety answer rather than folded into it, because the two would
        // otherwise be indistinguishable in one number and they call for
        // different work: specialisation lifts the second and nothing lifts
        // the first.
        if (mask - (mask / AIF_BR_B_SHARED_BODY % 2) * AIF_BR_B_SHARED_BODY == 0) {
            ok = ok + 1
            if (mask == 0) { sole = sole + 1 }
        }
        f = f + 1
    }

    println("")
    println("# call-site bracketing (SPEC 5.2.1) -- may a caller's region reach a callee's allocations?")

    print("bracketable  ")
    print(int_to_str(ok))
    print(" / ")
    print(int_to_str(fnCount))
    println("  (obligations 1, 2, 4: nothing the extent allocates outlives the call)")

    print("sole-regime  ")
    print(int_to_str(sole))
    println("  (of those: one body, one placement regime -- SPEC 5.2.1 (a))")

    print("region-calls ")
    print(int_to_str(aif_region_call_sites()))
    print(" / ")
    print(int_to_str(aif_call_edge_count()))
    print("  call sites lie inside a region; ")
    print(int_to_str(aif_bracketable_region_call_sites()))
    println(" of them reach a bracketable callee")

    print("br-global    ")
    println(int_to_str(nGlobal))
    print("br-param     ")
    println(int_to_str(nParam))
    print("br-opaque    ")
    println(int_to_str(nOpaque))
    print("br-drop      ")
    println(int_to_str(nDrop))
    print("br-shared    ")
    println(int_to_str(nShared))

    // The placement itself (SPEC 5.2.1.1), and the two numbers are deliberately
    // separate. `bracketed` is how many calls the compiler took; `br-served` is
    // how many allocation sites that actually moved into an arena. They come
    // apart, and the gap is the honest one: bracketing says the *call* may be
    // placed, and each site in the extent still faces the per-site gate -- a T0
    // site already has the frame and a T3 one has a count in front of it. A
    // bracket with 0 served is the call-site form of the inert `region`.
    print("bracketed    ")
    print(int_to_str(aif_bracket_count()))
    print("  call site(s) placed; ")
    let mut served = 0
    let mut b = 0
    while (b < aif_bracket_count()) {
        served = served + aif_bracket_served(b)
        b = b + 1
    }
    print(int_to_str(served))
    println(" site(s) now arena-served")
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

// Runs the whole engine over a merged, type-checked module and reports.
//
// Called after analyzeModule and before generateModule. It reads the AST and
// writes nothing back to it.
//
// **This used to claim that SPEC 7.1's zero-analysis mode was true by
// construction, "because nothing it produces is an input to codegen yet". That
// was true at Level 0 and has been false since Level 1.** Inference now drives
// codegen at eight points -- stack promotion, arena placement, scope drops,
// container element disposition, refcounting, struct-field release, cycle
// collection, and field order -- so the invariant is a property that has to be
// *tested*, not asserted. `--debug` and run_no_inference_test are what make it
// falsifiable; see SPEC 7.2's level table for what the budget of zero means.
// Build the graph and solve. Reports nothing -- `build` runs this and then asks
// aif_tier_at() per allocation site, while the `aif` command runs it and prints.
//
// Returns whether inference converged. A false return is not a failure: SPEC 1
// makes giving up a performance outcome, and aif_widen has already raised the
// unproven facts to the conservative end, so every tier that follows is at or
// above the true one.
fn aifRun(module: ASTNode, ownedCollections: Bool, thetaFields: Bool,
           budget: Int) -> Bool {
    return aifRunProfiled(module, ownedCollections, thetaFields, budget, "")
}

// LAYOUT 2's two paths into one profile. `profilePath` empty is the static
// estimate -- what every caller but the build path wants, and what the build
// path itself gets when no workload is declared or the run failed (W2).
fn aifRunProfiled(module: ASTNode, ownedCollections: Bool, thetaFields: Bool,
                   budget: Int, profilePath: String) -> Bool {
    aif_reset()
    aifLiteralStrings = 0
    aifExternAlloc = 0
    aifOpaqueReturns = 0
    aifStaticReturns = 0
    aifBudget = budget
    aifLoopDepth = 0
    aifStmtCursor = 0

    if (ownedCollections) {
        aif_set_owned_collections(1)
    } else {
        aif_set_owned_collections(0)
    }
    if (thetaFields) {
        aif_set_theta_mode(1)
    } else {
        aif_set_theta_mode(0)
    }

    aifDeclare(module)
    aifBuild(module)

    // LAYOUT 7.2, and it has to sit exactly here. The access profile is built by
    // the walk above, and the sizes below are summed in the order this chooses --
    // which is what feeds Theta_stack, which is what the T0 clause reads. Before
    // the walk there is no profile; after the solve the sizes are already stamped
    // onto every site.
    // SPEC 7.2's `debug` level is a budget of **zero rounds**, and its row also
    // says "layout search: none". Gated on the budget rather than on a separate
    // flag because 7.2 is explicit that the levels are budgets and not different
    // algorithms -- the same engine runs at every one of them. `--budget=` on the
    // `aif` command refuses anything below 1, so zero means this and only this.
    //
    // LAYOUT 2's measured profile replaces the estimate the walk just built, and
    // it has to land in this gap: after aifBuild has registered every type and
    // field (there is nothing to load counts *into* before that) and before the
    // search reads them. Loading it earlier would write into a table aif_reset
    // has emptied; later would search the estimate and then change the numbers
    // underneath the answer.
    if (str_equals(profilePath, "") == 0) {
        if (aif_profile_load(profilePath) == 0) {
            // A file that exists but names nothing this module declares. Stale
            // against a rename, most likely (LAYOUT 10.3). W2's fallback, and it
            // warns for the same reason the other three failures do -- a silent
            // fallback is how a workload comes to be believed in and never run.
            diag_warning("the workload profile matched no type in this module; using the static estimate")
        }
    }

    if (budget > 0) {
        aif_layout_select()
    }
    aifComputeSizes(module)

    // LAYOUT 6's hot/cold split, and it has to sit exactly here -- between the
    // sizes and the solve.
    //
    // **After the sizes**, because a split must not change what the analysis
    // concludes. aifComputeSizes feeds Theta_stack, which the T0 clause reads, so
    // sizing a split record would be a layout decision feeding back into the solve
    // that layout is chosen ahead of (SPEC 7.2, test_49's note). The sizes stay
    // the unsplit ones, deliberately.
    //
    // **Before the solve**, because the release half *is* `aif_type_releases` and
    // the solve is what reads it -- through elem_disposition_of, which is how a
    // container learns to reclaim a split element. A split decided afterwards is a
    // type whose cold block nothing ever frees.
    //
    // Gated on the same budget as the search above: SPEC 7.2's `debug` level is a
    // budget of zero rounds and its row also says "layout search: none".
    if (budget > 0) {
        aifLayoutVetoInline(module)
        aif_layout_split_select()
    }

    let converged = aif_solve(budget) == 1
    if (converged == false) {
        // INFERENCE 5.3: a truncated ascending iteration is a pre-fixed point,
        // so its facts are too optimistic. Widening to a post-fixed point is
        // mandatory, not an optimisation.
        aif_widen()
    }

    // SPEC 5.4, before the arenas: a pin freezes a tier and the cost model ranks
    // scopes by tiers, so the pins have to be settled first or an arena could be
    // placed for a site whose tier is about to change.
    if (converged) {
        aif_check_pins(1)
    } else {
        aif_check_pins(0)
    }

    // LAYOUT 7.1, after the facts and after widening: every input to the cost
    // model is a converged (or conservatively raised) tier, so placing arenas
    // earlier would be ranking scopes by numbers still in motion.
    aif_place_arenas()

    // SPEC 5.4 on placement, and the ordering is the whole difference from the
    // tier pins above. A tier pin is settled *before* the cost model, because
    // the model ranks scopes by tiers. A placement pin asserts what the model
    // and SPEC 5.2.1.1's bracketing then decided, so it can only be adjudicated
    // once both have run -- asking earlier would read an arena table that is
    // still empty and refute every pin in the program.
    if (converged) {
        aif_check_placement_pins(1)
    } else {
        aif_check_placement_pins(0)
    }
    return converged
}

// ---------------------------------------------------------------------------
// Minimal cause and ranked repairs -- SPEC 6.3, INFERENCE 5.6
//
// `prismio aif <src> --why <symbol>` prints the witness path for one manifest
// record, in the layout SPEC 6.3 specifies: the tier, the fact that moved, the
// edges that moved it innermost-first, and the repairs that would undo it.
//
// The split between here and tools/aif_manifest_diff.py is deliberate: only the
// compiler has the derivation, and only the differ knows what changed. The differ
// finds the regressed symbols and asks for each one.
// ---------------------------------------------------------------------------

// The repair for an edge is a property of the rule that fired, because breaking
// the edge is what restores the tier and the rule says what breaking it means.
// Cost is stated in the units a reader can act on -- a copy, a declaration, or
// nothing -- rather than in cycles, which would be a modelled number pretending
// to be a measured one.
fn aifRepairFor(rule: Int) -> String {
    if (str_equals(aif_rule_name(rule), "E-STATIC") == 1) {
        return "make the destination region-scoped instead of static     restores T1, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "E-RETURN") == 1) {
        return "have the caller allocate and pass it in                  restores T1, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "E-OPAQUE") == 1) {
        return "declare the extern's return contract (FFI 5.2)           restores T2, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "A-STORE") == 1) {
        return "store a copy instead of the value                        restores T2, +1 copy per store"
    }
    if (str_equals(aif_rule_name(rule), "A-RETAIN") == 1) {
        return "declare the parameter `borrow` if the callee keeps nothing  restores T2, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "A-COPY") == 1) {
        return "make the type move-only so a second holder is a move     restores T2, no runtime cost"
    }
    if (str_equals(aif_rule_name(rule), "E-BIND") == 1) {
        return "declare the binding inside the scope that uses it        restores T1, no runtime cost"
    }
    return ""
}

// SPEC 6.3, for placement rather than for the tier.
//
// A tier and a placement are two different questions and `--why` only answered
// the first. "T1" says a value *may* live in a region; whether an arena actually
// serves it is seven further clauses, and reading them off the source is exactly
// what three consecutive sessions got wrong -- each stopped at the clause that
// had explained the previous failure. The mask comes from the gate itself, so
// this cannot drift from what codegen does, and it lists **every** obstacle
// rather than the first: the first one is reliably the wrong thing to act on.
fn aifArenaBlockerText(bit: Int) -> String {
    if (bit == AIF_ARENA_B_NOT_T1) {
        return "the tier is not T1 -- see the cause above"
    }
    if (bit == AIF_ARENA_B_NO_STACK) {
        return "an explicit `drop` frees this value, and a deallocator cannot take an arena pointer"
    }
    if (bit == AIF_ARENA_B_IN_CONTAINER) {
        return "a container owns this value and tears it down through the deallocator"
    }
    if (bit == AIF_ARENA_B_IS_LIST) {
        return "a List reallocates its element block after this site returned"
    }
    if (bit == AIF_ARENA_B_NO_REGION) {
        return "no `region` encloses this allocation *in its own function*"
    }
    if (bit == AIF_ARENA_B_ESCAPES) {
        return "the value escapes to its caller or to static storage"
    }
    return "the value outlives the enclosing region"
}

fn aifEmitBlocker(mask: Int, bit: Int, shown: Int) -> Int {
    if (mask / bit % 2 == 0) { return shown }
    if (shown == 0) { print("      because  ") } else { print("      and      ") }
    println(aifArenaBlockerText(bit))
    return shown + 1
}

fn aifEmitPlacement(site: Int) {
    println("")
    println("  placement")

    let where = aif_region_name_at_site(site)
    if (str_equals(where, "") == 0) {
        print("    region:")
        print(where)
        println("  -- bump-allocated, and released in bulk when the region exits")
        // The two ways to be served are not the same fact, and a reader acting on
        // this needs to know which one this is. A lexical region is what the
        // programmer wrote; a bracketed one is a decision the compiler made about
        // a *caller*, and SPEC 5.2.1.1 makes it conditional on that caller being
        // the only one -- so it is the placement that can vanish from an edit
        // somewhere else in the file.
        if (aif_site_is_bracketed(site) == 1) {
            println("      note     the `region` is in a caller and this call was bracketed")
            println("               (SPEC 5.2.1.1 regime (a)). A second call to this function")
            println("               removes the placement; the manifest lists the bracket.")
        }
        return
    }

    println("    heap  -- no arena serves this site")

    let mask = aif_arena_blockers(site)
    let mut shown = 0
    shown = aifEmitBlocker(mask, AIF_ARENA_B_NOT_T1, shown)
    shown = aifEmitBlocker(mask, AIF_ARENA_B_NO_STACK, shown)
    shown = aifEmitBlocker(mask, AIF_ARENA_B_IN_CONTAINER, shown)
    shown = aifEmitBlocker(mask, AIF_ARENA_B_IS_LIST, shown)
    shown = aifEmitBlocker(mask, AIF_ARENA_B_NO_REGION, shown)
    shown = aifEmitBlocker(mask, AIF_ARENA_B_ESCAPES, shown)
    shown = aifEmitBlocker(mask, AIF_ARENA_B_OUTLIVES, shown)

    // The one rejection a reader cannot act on from the message alone, and the
    // one that decides almost every site in the corpus.
    if (mask / AIF_ARENA_B_NO_REGION % 2 == 1) {
        println("      note     an arena is a lexical scope (SPEC 5.2.1). A `region` in a")
        println("               caller cannot reach an allocation made in a callee, so no")
        println("               change to the escape lattice moves this site.")
    }

    // Naming the arena the value escaped past is the difference between "move
    // the region" and "move the binding", and a reader cannot tell which without
    // it.
    if (mask / AIF_ARENA_B_OUTLIVES % 2 == 1) {
        print("      note     the nearest region is `")
        print(aif_nearest_region_name(site))
        println("`; the value is still live after it exits")
    }

    if (mask / AIF_ARENA_B_NO_REGION % 2 == 1) {
        aifEmitBracketing(site)
    }
}

fn aifBracketBlockerText(bit: Int) -> String {
    if (bit == AIF_BR_B_GLOBAL) {
        return "something the extent allocates escapes to static storage"
    }
    if (bit == AIF_BR_B_PARAM_STORE) {
        return "the extent stores into a container or field it did not allocate"
    }
    if (bit == AIF_BR_B_OPAQUE) {
        return "the extent calls a body with no source and no complete FFI contract"
    }
    if (bit == AIF_BR_B_DROP) {
        return "an explicit `drop` inside the extent frees one of its allocations"
    }
    return "the body is reachable from outside the bracket, so it would serve two placement regimes"
}

fn aifEmitBracketBlocker(mask: Int, bit: Int, shown: Int) -> Int {
    if (mask / bit % 2 == 0) { return shown }
    if (shown == 0) { print("        because  ") } else { print("        and      ") }
    println(aifBracketBlockerText(bit))
    return shown + 1
}

// SPEC 5.2.1's repair, answered for this site rather than described.
//
// `no_region` is the clause on 196 of 196 blocked sites in the corpus, and its
// note says an escape-lattice change does not move it. That is true and it is
// only half an answer: the *other* half is whether this site's function could be
// bracketed by a caller's region, which is a different question with a different
// repair. A reader who got the note and nothing else knew what would not work.
//
// Reports every failing obligation, not the first -- the same discipline as the
// placement mask above, and for the same reason: three sessions acted on a
// gate's first clause while two more clauses rejected the same site.
fn aifEmitBracketing(site: Int) {
    let f = aif_site_fn(site)
    if (f < 0) { return }

    let mask = aif_fn_bracket_blockers(f)
    let inRegion = aif_fn_calls_in_region(f)
    let calls = aif_fn_call_sites(f)

    // The allocation obligations without regime (a)'s restriction, which is
    // reported separately below because it calls for different work: SPEC
    // 5.2.1.1's regime (b) lifts it and nothing lifts the others.
    let unsafeMask = mask - (mask / AIF_BR_B_SHARED_BODY % 2) * AIF_BR_B_SHARED_BODY

    println("")
    println("    bracketing (SPEC 5.2.1.1) -- may a caller's region reach this function?")

    if (unsafeMask == 0) {
        if (mask == 0) {
            print("      yes  -- every obligation holds, and the body serves one regime (")
            print(int_to_str(calls))
            println(" call site)")
        } else {
            print("      no   -- the obligations hold, but the body has ")
            print(int_to_str(calls))
            println(" call sites, so it would serve two placement regimes")
            println("      note     SPEC 5.2.1.1 regime (b) -- specialisation -- is what lifts this")
        }
    } else {
        println("      no   -- bracketing this call would outlive the region")
        let mut shown = 0
        shown = aifEmitBracketBlocker(mask, AIF_BR_B_GLOBAL, shown)
        shown = aifEmitBracketBlocker(mask, AIF_BR_B_PARAM_STORE, shown)
        shown = aifEmitBracketBlocker(mask, AIF_BR_B_OPAQUE, shown)
        shown = aifEmitBracketBlocker(mask, AIF_BR_B_DROP, shown)
        shown = aifEmitBracketBlocker(mask, AIF_BR_B_SHARED_BODY, shown)
    }

    // The half the obligations do not carry. A function that clears every one of
    // them is still never placed if nothing calls it from a region, and saying
    // "yes" without this would report a property that reads as a placement.
    print("      callers  ")
    print(int_to_str(inRegion))
    print(" of ")
    print(int_to_str(calls))
    if (inRegion == 0) {
        println(" call sites lie inside a region -- so no arena would serve it either way")
    } else {
        println(" call sites lie inside a region")
    }
}

fn aifEmitCause(site: Int, converged: Bool) {
    let domain = aif_cause_domain_for(site)
    let n = aif_cause_build(site, domain)

    print(aifPad(aifSymbolOf(site), 32))
    print("  ")
    println(aifTierName(aif_tier_of(site)))
    println("")

    println("  minimal cause")

    // A path of one edge whose rule is ALLOC means nothing ever raised the fact:
    // it is still at the bottom the site was created with. Saying "rose to" there
    // would describe a propagation that did not happen.
    let mut fact = aif_escape_name(aif_cause_value(0))
    if (domain == 1) { fact = aif_alias_name(aif_cause_value(0)) }
    let mut label = "    E rose to "
    if (domain == 1) { label = "    A rose to " }
    if (aif_cause_rule(0) == AIF_RULE_ALLOC) {
        label = "    E is still "
        if (domain == 1) { label = "    A is still " }
    }
    print(label)
    println(fact)

    let mut i = 0
    while (i < n) {
        let rule = aif_cause_rule(i)
        print("      <- ")
        print(aifPad(aif_rule_name(rule), 10))
        print(aifPad(diag_file_path(aif_cause_file(i)), 36))
        print(" ")
        print(int_to_str(aif_cause_line(i)))
        print(":")
        println(int_to_str(aif_cause_col(i)))
        i = i + 1
    }

    aifEmitPlacement(site)

    println("")
    println("  repairs, cheapest first")

    // Walked outermost-first: the root cause is the cheapest thing to change,
    // because everything downstream of it follows. An edge with no repair is one
    // whose rule is not a choice the programmer made -- ALLOC, or a propagation
    // step -- and listing "no action available" for it would be noise.
    let mut rank = 1
    let mut j = n - 1
    while (j >= 0) {
        let repair = aifRepairFor(aif_cause_rule(j))
        if (str_equals(repair, "") == 0) {
            print("    ")
            print(int_to_str(rank))
            print(". ")
            println(repair)
            rank = rank + 1
        }
        j = j - 1
    }

    // SPEC 6.3: a repair that is unsound SHALL be listed as rejected with its
    // reason. Pinning the tier back is the one every reader reaches for first,
    // and it is exactly the one a converged analysis refuses (SPEC 5.4.1) --
    // which is also why the reason has to distinguish the two cases. On a
    // truncated run the same pin is unproven rather than disproven, and SPEC
    // 5.4.2 makes it a warning that raising the budget may clear.
    print("    ")
    print(int_to_str(rank))
    print(". pin(")
    print(aifTierName(aif_tier_of(site) - 1))
    if (converged) {
        println(") on the binding                     rejected -- inference converged, so this is proven false")
    } else {
        println(") on the binding                     unproven -- the budget ran out; raising it may settle this")
    }

    if (rank == 1) {
        println("")
        println("  no repair is derivable: the path ends at the allocation itself.")
    }
}

// Finds the record by the symbol the manifest prints, so a reader can copy one
// out of a diff and paste it back. Returns 1 when it found one.
fn aifExplain(symbol: String, converged: Bool) -> Int {
    let total = aif_site_count()
    let mut i = 0
    while (i < total) {
        if (str_equals(aifSymbolOf(i), symbol) == 1) {
            aifEmitCause(i, converged)
            return 1
        }
        i = i + 1
    }
    print("no manifest record named ")
    println(symbol)
    return 0
}

// SPEC 5.4's diagnostics, and the one place AIF reports anything.
//
// That is not a contradiction of SPEC 1. The invariant governs *inference
// failure* -- the analysis being unable to prove a value cheap -- and says that
// degrades performance and never compilation. A pin a converged analysis refutes
// is the other thing: a programmer assertion that is false about their own
// program, in the same category as `use of moved value`. SPEC 5.4.1 spells that
// distinction out and makes this one an error.
//
// Returns the number of errors reported, so the caller can stop before codegen.
fn aifReportPins() -> Int {
    let n = aif_site_count()
    let mut i = 0
    let mut errors = 0
    while (i < n) {
        let verdict = aif_site_pin_verdict(i)

        if (verdict == AIF_PIN_REFUTED) {
            let want = aifTierName(aif_site_pin_tier(i))
            let got = aifTierName(aif_site_derived_tier(i))
            diag_error_at(aif_site_file(i), aif_site_line(i), aif_site_col(i), 0,
                          str_concat(str_concat(str_concat("pin(", want), ") cannot hold: this value is "), got))
            diag_note("inference converged, so this is a proven-false assertion rather than a limit of the analysis")
            errors = errors + 1
        }

        if (verdict == AIF_PIN_UNPROVEN) {
            let want = aifTierName(aif_site_pin_tier(i))
            diag_warning_at(aif_site_file(i), aif_site_line(i), aif_site_col(i), 0,
                            str_concat(str_concat("pin(", want), ") is unproven: the analysis budget ran out"))
            diag_note("raising --budget may settle it; the derived tier is used meanwhile")
        }

        errors = errors + aifReportPlacementPin(i)
        i = i + 1
    }
    return errors
}

// Is any `region` in this program named `name`? Only for the diagnostic: it is
// what separates "you misspelled the region" from "the placement went away", and
// those two call for opposite repairs.
fn aifRegionExists(name: String) -> Bool {
    let n = aif_budget_count()
    let mut s = 0
    while (s < n) {
        if (str_equals(aif_scope_region(s), name) == 1) { return true }
        s = s + 1
    }
    return false
}

// SPEC 5.4 on placement, reported. Returns 1 when it raised an error.
//
// **This is the assertion SPEC 5.2.1.1 asked for and could not make.** That
// section requires the manifest to record every bracketed call, because regime
// (a) drops the placement the moment a bracketed callee acquires a second call
// site -- silently, with the program still correct and merely slower. A record
// only helps a reader who diffs it. `pin(<region-name>)` on the binding is the
// same fact asserted, so the build stops instead.
//
// The verdict comes from aif_check_placement_pins, which reads
// aif_region_name_at_site -- the one arena gate. Nothing here re-decides
// placement; this only phrases the answer that gate already gave.
fn aifReportPlacementPin(i: Int) -> Int {
    let verdict = aif_site_pin_region_verdict(i)
    if (verdict == AIF_PIN_NONE) { return 0 }
    if (verdict == AIF_PIN_HONOURED) { return 0 }

    let want = aif_site_pin_region(i)
    let got = aif_region_name_at_site(i)

    if (verdict == AIF_PIN_UNPROVEN) {
        // SPEC 5.4.2, and it bites harder here than for a tier pin: a truncated
        // analysis widens every unproven site to its top tier, which takes the
        // arena away from sites a converged run keeps it for. Refusing the build
        // on that would fail a program for the budget it was given.
        diag_warning_at(aif_site_file(i), aif_site_line(i), aif_site_col(i), 0,
                        str_concat(str_concat("pin(", want), ") is unproven: the analysis budget ran out"))
        diag_note("raising --budget may settle it; placement is unchanged meanwhile")
        return 0
    }

    diag_error_at(aif_site_file(i), aif_site_line(i), aif_site_col(i), 0,
                  str_concat(str_concat("pin(", want), ") cannot hold: this value is not served by that arena"))

    if (aifRegionExists(want) == false) {
        diag_note(str_concat(str_concat("no `region` in this program is named ", diagQuote(want)),
                             "; a tier pin is one of T0, T1, T2, T3, T4b, T4a"))
        return 1
    }

    if (str_equals(got, "") == 0) {
        diag_note(str_concat(str_concat("it is served by region:", got),
                             " -- a nested region takes the values that die earlier"))
        return 1
    }

    // The case this annotation exists for. The site has no region in its own
    // function, so the only way it was ever served is a caller's `region`
    // reaching it through a bracketed call -- and SPEC 5.2.1.1 regime (a) drops
    // that bracket as soon as the callee has a second call site. Naming the
    // obligation that failed is the difference between a diagnostic and a
    // riddle, and aif_fn_bracket_blockers already answers it.
    let f = aif_site_fn(i)
    if (f >= 0 and aif_fn_bracket_blockers(f) / AIF_BR_B_SHARED_BODY % 2 == 1) {
        diag_note(str_concat(str_concat("the call that reached it was bracketed into ", want),
                             " (SPEC 5.2.1.1 regime (a)) and no longer is:"))
        diag_note(str_concat(str_concat(aif_fn_name(f), " now has "),
                  str_concat(int_to_str(aif_fn_call_sites(f)),
                             " call sites, and a bracketed callee may have exactly one")))
        return 1
    }

    diag_note("no arena serves this site; `prismio aif <file> --why=<symbol>` prints every clause that declined it")
    return 1
}

// REQUIREMENTS 19's gate. A `region name pin(N)` whose arena is estimated to
// serve more than N bytes is a false assertion about one's own program, in the
// same category as a refuted tier pin -- so it is an error, and SPEC 1's
// invariant is untouched for the same reason SPEC 5.4.1 gives.
//
// Only checked when the analysis converged. A truncated one has raised the
// unproven facts to the conservative end, which *lowers* the arena's estimated
// load -- fewer sites stay T1 -- so a budget could pass for want of analysis and
// fail on the next build. Silence is the honest answer there.
fn aifReportBudgets(converged: Bool) -> Int {
    if (converged == false) { return 0 }

    let n = aif_budget_count()
    let mut s = 0
    let mut errors = 0
    while (s < n) {
        let cap = aif_scope_budget(s)
        if (cap > 0) {
            let served = aif_scope_served(s)
            if (served > cap) {
                diag_error_at(aif_scope_budget_file(s), aif_scope_budget_line(s),
                              aif_scope_budget_col(s), 0,
                              str_concat(str_concat(str_concat("region ", aif_scope_region(s)),
                                         str_concat(" exceeds its budget: ", int_to_str(served))),
                                         str_concat(" bytes estimated, ", str_concat(int_to_str(cap), " asserted"))))
                diag_note("the estimate counts statically sized allocations only; a string's length is a run-time value")
                errors = errors + 1
            }
        }
        s = s + 1
    }
    return errors
}

// SPEC 5.2. A `region` that serves no allocation is a pessimisation the compiler
// used to perform in silence: the block still pushes and pops an arena at every
// entry, and nothing is bump-allocated from it. Measured on
// `aif/evidence/xlang/prismio/g2_region.psm` -- 20 000 regions entered, 0 of
// 10 201 215 allocations served, and the frame loop 1.67x slower than the same
// program without the annotation.
//
// A warning rather than an error, because SPEC 5's rule for an axiom is that
// being wrong about it is recoverable: the region is still a legal scope and the
// program still runs. What is not acceptable is the silence -- SPEC 5.0.1 makes
// an annotation a verified assertion, and an assertion nobody checks is
// decoration.
//
// The count comes from aif_region_serves, which reads the codegen gate rather
// than the cost model's estimate. Those two disagreed until 2026-08-14, and the
// estimate is the wrong one to warn from: it counts container elements that
// codegen will not place, so a region serving nothing would have looked busy.
fn aifReportInertRegions() {
    // aif_budget_count() is scope_count under a name it outgrew -- aifReportBudgets
    // above walks the same range for the same reason. Kept rather than renamed
    // because the name is on the FFI surface the committed seed links against.
    let n = aif_budget_count()
    let mut s = 0
    while (s < n) {
        let name = aif_scope_region(s)
        if (str_equals(name, "") == 0 and aif_region_serves(s) == 0) {
            diag_warning_at(aif_scope_region_file(s), aif_scope_region_line(s),
                            aif_scope_region_col(s), 0,
                            str_concat(str_concat("region ", name),
                                       " serves no allocation; it costs an arena push and pop per entry and reclaims nothing"))
            diag_note("an arena serves a value allocated in the same function, or one in a callee whose call this region brackets; a callee called from more than one place, or a region holding a call this compilation cannot see through, cannot reach it")
        }
        s = s + 1
    }
}

// ---------------------------------------------------------------------------
// `prismio aif <src> --layout` -- LAYOUT 7.2's argmin, made visible.
//
// SPEC 7.2 specifies selection as `best := argmin over candidates(tau) of
// Cost(...)` and LAYOUT 8 wants "the top-k candidates ranked by modelled cost".
// Until the cost model landed this compiler had neither: one greedy placement,
// never scored. This prints the whole ranked candidate set, which is what makes
// the hot/cold cut auditable *before* anything emits one.
//
// **Nothing here changes codegen.** The chosen row is marked, and the compiler
// still emits the unsplit record for every type. A split object is two
// allocations and needs the release path (RESULTS-layout 5) first; printing the
// ranking before building the transform is the same discipline as pricing
// `list_new_with_capacity` against a raised default before shipping it.
//
// The `modelled` column is a ratio against the unsplit record, x100 -- 100 is
// "no better than not splitting". It is a *model*, and the model is calibrated
// for contiguous records while this runtime boxes each one; on Particle it says
// 69 where layout_repr.c measures 87. It ranks correctly and it overstates, and
// both halves of that are worth knowing before trusting a number from it.
// ---------------------------------------------------------------------------
fn aifEmitLayout(module: ASTNode, sourcePath: String) {
    println("aif-layout 1")
    aifKv("source", sourcePath)
    aifKv("profile", aif_profile_source())
    println("#")
    println("# LAYOUT 7.2 argmin over candidates(tau). `*` is the model's choice;")
    println("# `emitted` is what codegen actually produced. The two differ when a")
    println("# type is vetoed -- embedded inline in another struct, or in a")
    println("# non-trivial SCC (see aif_layout_split_select) -- and when")
    println("# --force-layout names a different candidate (LAYOUT 8).")
    println("#")
    println("# type                      fields  trav  candidate      hot B  cold B  modelled  emitted")

    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            let n = aif_layout_rank(d.s1)
            if (n > 0) {
                let trav = aif_layout_traversals(d.s1)
                let best = aif_layout_best()
                // 0 means codegen emitted the unsplit record for this type,
                // whether because the model preferred it or because a veto took
                // the cut away. The row marked `emitted` is the one the binary has.
                let emittedHot = aif_layout_hot_count(d.s1)
                let mut i = 0
                while (i < n) {
                    let hot = aif_layout_cand_hot(i)
                    let total = aif_struct_nfields(d.s1)
                    let mut label = "unsplit"
                    if (hot < total) {
                        label = str_concat("split ", str_concat(int_to_str(hot),
                                 str_concat("/", int_to_str(total))))
                    }
                    if (i == best) { label = str_concat(label, " *") }
                    let mut emitted = ""
                    if (emittedHot == 0) {
                        if (hot == total) { emitted = "emitted" }
                    } else {
                        if (hot == emittedHot) {
                            if (hot < total) { emitted = "emitted" }
                        }
                    }
                    print("  ")
                    print(aifPad(d.s1, 24))
                    print(aifPad(int_to_str(total), 8))
                    print(aifPad(int_to_str(trav), 6))
                    print(aifPad(label, 15))
                    print(aifPad(int_to_str(aif_layout_cand_bytes(i, 0)), 7))
                    print(aifPad(int_to_str(aif_layout_cand_bytes(i, 1)), 8))
                    print(aifPad(int_to_str(aif_layout_cand_ratio(i)), 10))
                    println(emitted)
                    i = i + 1
                }
                // A type nothing traverses has no evidence behind its ranking:
                // every candidate scores on the footprint term alone. Saying so
                // is the difference between "the model prefers unsplit" and "the
                // model was never given anything to prefer it for".
                if (trav == 0) {
                    println("#   ^ no traversal recorded: ranked on footprint alone")
                }
            }
        }
        p = d.next
    }
}

fn aifAnalyze(module: ASTNode, sourcePath: String, version: String,
               ownedCollections: Bool, summary: Bool, thetaFields: Bool,
               budget: Int) {
    aifAnalyzeProfiled(module, sourcePath, version, ownedCollections, summary,
                        thetaFields, budget, "", false)
}

fn aifAnalyzeProfiled(module: ASTNode, sourcePath: String, version: String,
                       ownedCollections: Bool, summary: Bool, thetaFields: Bool,
                       budget: Int, profilePath: String, layout: Bool) {
    let converged = aifRunProfiled(module, ownedCollections, thetaFields, budget,
                                    profilePath)

    // The reporting command has to describe the build, which is the same reason
    // `prismio aif` runs a declared workload. A manifest that shows no arena for
    // a named region while the build warns about it would be two answers to one
    // question -- the `owned_collections` trap in a new place.
    aifReportInertRegions()

    if (layout) {
        aifEmitLayout(module, sourcePath)
    } else if (summary) {
        aifEmitSummary(sourcePath, converged)
    } else {
        aifEmitManifest(module, sourcePath, version, converged)
    }
}
