// The AST walk that discovers allocation sites and the constraints between them,
// and the fixpoint that turns those constraints into tiers.

import ast.nodes
import ast.types
import sema.enums
import common.text
import common.diagnostics
import std.string

// ---------------------------------------------------------------------------
// Abstract evaluation
//
// The set of allocation sites an expression may denote, creating a site where
// the expression allocates. Takes a node pointer rather than a node so that the
// recursion never has to reason about who owns the ASTNode it is looking at --
// the same idiom dumpast.psm uses.
// ---------------------------------------------------------------------------

private fn aifSitesOf(nodePtr: Ptr, fnId: Int, scope: Int) -> Int {
    if (nodeIsNull(nodePtr)) {
        return aifVsEmpty()
    }

    let e = ptr_to_node(nodePtr)
    // Narrower than the statement's position, and it is the one a reader wants:
    // a store's cause is the expression that did the storing, not the line the
    // statement began on.
    aif_con_at(e.file, e.line, e.col)
    let ty = aifNodeType(e)

    if (e.kind == NodeKind.STRUCT_LITERAL_EXPR) {
        // Re-derived rather than `sname = ty`. Strings are affine, and `ty` is
        // read again by the branches below -- a move here would poison it for
        // every one of them, because move state is per name over the whole body.
        let mut sname = e.s1
        if (strEquals(sname, "")) { sname = aifNodeType(e) }

        let sid = aifNewSite(sname, fnId, scope, nodePtr)
        let owner = aifVsOfSite(sid)

        let mut fPtr = e.child1
        while (nodeExists(fPtr)) {
            let f = ptr_to_node(fPtr)
            if (nodeExists(f.child1)) {
                // E-STORE / A-STORE: a field initialiser is a store into the
                // field, and the literal is the container it is stored into.
                aif_field_access(sname, f.s1, aifLoopDepth)
                aif_con_store(aif_key_field(sname, f.s1),
                              aifSitesOf(f.child1, fnId, scope), owner)
                // SPEC 5.2.1's obligation 2. The owner here is this literal's
                // own site and so is provably local -- recorded anyway, because
                // a clause that is exempted by an argument in a comment is a
                // clause that stops being checked the moment the argument stops
                // holding.
                aif_note_owner_use(fnId, owner)
            }
            fPtr = f.next
        }
        return aifVsOfSite(sid)
    }

    if (e.kind == NodeKind.ARRAY_LITERAL_EXPR) {
        let mut aname = aifNodeType(e)
        if (strEquals(aname, "")) { aname = "Array" }

        let sid = aifNewSite(aname, fnId, scope, nodePtr)
        let owner = aifVsOfSite(sid)

        // Elements are stored into the array, exactly as a struct literal's
        // initialisers are stored into its fields. There is no field name to
        // key on, so all elements share one -- field-insensitive within the
        // array type, which is the same granularity the struct case uses.
        let mut elPtr = e.child1
        while (nodeExists(elPtr)) {
            let el = ptr_to_node(elPtr)
            aif_con_store(aif_key_field(aname, "[]"),
                          aifSitesOf(elPtr, fnId, scope), owner)
            aif_note_owner_use(fnId, owner)
            elPtr = el.next
        }
        return aifVsOfSite(sid)
    }

    if (e.kind == NodeKind.LITERAL_EXPR) {
        // A string literal is not an allocation. It lowers to an LLVM global --
        // static, immortal, zero cost -- so it has no place on a ladder that
        // ranks ways of reclaiming heap memory. Counted so the exclusion is
        // visible in the manifest rather than silent.
        if (strEquals(ty, "String")) {
            aifLiteralStrings = aifLiteralStrings + 1
        }
        return aifVsEmpty()
    }

    if (e.kind == NodeKind.IDENTIFIER_EXPR) {
        if (aifIsRef(ty)) {
            // M3.2b. Every read of a reference passes through here, which is what
            // makes this the one place a last use can be counted without a second
            // traversal disagreeing with this one about what a use is.
            aif_var_note_use(fnId, e.s1, scope)
            return aifVsOfKey(aif_key_var(fnId, e.s1))
        }
        return aifVsEmpty()
    }

    // M4.1 / SPEC 8.4. A slice allocates nothing: it is three words describing
    // a view. Its value set exists only to carry provenance to E-VIEW, which
    // raises the List's escape whenever the slice is bound, returned, stored or
    // passed on. A nested slice points at the previous view; resolve_views
    // follows that chain back to the original List sites.
    if (e.kind == NodeKind.SLICE_EXPR) {
        let collection = aifSitesOf(e.child1, fnId, scope)
        aifSitesOf(e.child2, fnId, scope)
        aifSitesOf(e.child3, fnId, scope)
        let view = aif_vs_new()
        aif_vs_view_of(view, collection)
        return view
    }

    // `List[i]` and `Slice[i]` both read the List element field. References are
    // views and scalars are copies, matching the list_get rule below.
    if (e.kind == NodeKind.INDEX_EXPR and nodeExists(e.child1)) {
        let baseNode = ptr_to_node(e.child1)
        let baseTy = aifNodeType(baseNode)
        let baseKind = aifBaseType(baseTy)
        if (strEquals(baseKind, "List") or strEquals(baseKind, "Slice")) {
            let collection = aifSitesOf(e.child1, fnId, scope)
            aifSitesOf(e.child2, fnId, scope)
            let element = aifVsOfKey(aifElemKey(aifElementContainerType(baseTy)))
            if (aifIsRef(ty)) { aif_vs_view_of(element, collection) }
            return element
        }
    }

    if (e.kind == NodeKind.MEMBER_ACCESS_EXPR) {
        if (nodeExists(e.child1)) {
            let obj = ptr_to_node(e.child1)
            let objTy = aifNodeType(obj)
            if (aifIsRef(objTy)) {
                // LAYOUT 2.1's profile, statically estimated. Every field access
                // in the program passes through here or through the assignment
                // case, so one count per syntactic access is the whole profile.
                // Reads and writes are not separated: the only thing this
                // compiler can act on is field *order*, and order is decided by
                // how often a field is touched, not by which way.
                aif_field_access(aifBaseType(objTy), e.s1, aifLoopDepth)
                // The value of the access is the field's key, not the object's
                // sites -- but a *reference*-shaped field is a *view* of the
                // object it was read out of, exactly as a `List` element is a
                // view of the List above. Recording that is what lets
                // `fn_may_return_view_of_param` see a function that returns a
                // field of a parameter.
                //
                // **Without it the caller frees the argument before reading the
                // result.** `optionOr(maybeName(), "!")` returns the String
                // inside the Option it was handed; the release for that unbound
                // temporary was emitted immediately after the call and before
                // the `println` that reads it, so the value came back empty.
                // Neither existing fact could see it: the return is not the
                // parameter (`fn_may_return_param` compares sites, and a field's
                // sites are not the struct's), and with no view edge here
                // `key_views` was empty. `--verify` could not see it either --
                // both releases are ledger-legal, so the run reported
                // `4 allocated, 4 released, 0 violation(s)` and the wrong answer.
                //
                // A scalar field is a copy and gets no edge, which is the same
                // split the element rule above makes. The value set is fresh per
                // read (aifVsOfKey allocates one), so the edge belongs to this
                // access rather than to every read of the field everywhere.
                let container = aifSitesOf(e.child1, fnId, scope)
                let field = aifVsOfKey(aif_key_field(aifBaseType(objTy), e.s1))
                if (aifIsRef(ty)) { aif_vs_view_of(field, container) }
                return field
            }
        }
        return aifVsEmpty()
    }

    // REQUIREMENTS 4. `none` denotes nothing, so it contributes no site. It
    // would fall through to the child walk below and reach the same answer, but
    // the property is load-bearing enough to say out loud: a `T?` field holding
    // `none` puts no site in that field's points-to set, which is what keeps a
    // sometimes-absent field's release derived from the sites that *are* there.
    //
    // The release it derives has to tolerate a null, and all four dispositions
    // now do -- `free(NULL)` is a no-op, list_release and rc_release guard, and
    // the generated release opens with a null test.
    if (e.kind == NodeKind.NONE_LITERAL_EXPR) {
        return aifVsEmpty()
    }

    if (e.kind == NodeKind.CALL_EXPR) {
        return aifCallSites(nodePtr, fnId, scope)
    }

    // REQUIREMENTS 15. `spawn f(a, b)`.
    //
    // The inner CALL_EXPR is walked as an ordinary call first, and that is not a
    // shortcut: the callee really is called, so E-CALL, A-CALL and every FFI
    // contract on its parameters apply exactly as they would on this thread.
    // What a spawn adds is one constraint on top, carrying the two rules that
    // are about the boundary rather than about the call -- INFERENCE 4.1's
    // E-SPAWN/E-SPAWN-J and 4.3's T-SPAWN-MOVE/T-SPAWN-SHARE.
    //
    // The task handle contributes no site. It is a runtime object this
    // compilation did not allocate, so there is nothing to place, count or
    // release -- the same reason `none` returns empty two cases up.
    if (e.kind == NodeKind.SPAWN_EXPR) {
        if (nodeIsNull(e.child1)) { return aifVsEmpty() }
        let call = ptr_to_node(e.child1)
        aifCallSites(e.child1, fnId, scope)

        let mut args = aifVsEmpty()
        let mut argPtr = call.child2
        while (nodeExists(argPtr)) {
            let argNode = ptr_to_node(argPtr)
            args = aif_vs_union(args, aifSitesOf(argPtr, fnId, scope))
            argPtr = argNode.next
        }
        aif_con_spawn(args, scope, e.i1)
        return aifVsEmpty()
    }

    // `join t` yields an Int. Nothing allocates, and the handle it consumes was
    // never a site -- so like `none`, this is empty rather than falling through
    // to the child walk that would reach the same answer more slowly.
    if (e.kind == NodeKind.JOIN_EXPR) {
        return aifVsEmpty()
    }

    // Everything else contributes whatever its children do.
    let mut out = aifVsEmpty()
    out = aif_vs_union(out, aifSitesOfChain(e.child1, fnId, scope))
    out = aif_vs_union(out, aifSitesOfChain(e.child2, fnId, scope))
    out = aif_vs_union(out, aifSitesOfChain(e.child3, fnId, scope))
    return out
}

private fn aifSitesOfChain(head: Ptr, fnId: Int, scope: Int) -> Int {
    let mut out = aifVsEmpty()
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        out = aif_vs_union(out, aifSitesOf(p, fnId, scope))
        p = n.next
    }
    return out
}

// A call is where interprocedural flow happens, and where it stops: a function
// whose body this compilation can see gets real parameter and return edges,
// while an extern -- or a sealed function, which is the same situation (PIR 5)
// -- gets its contracts and nothing more.
private fn aifCallSites(callPtr: Ptr, fnId: Int, scope: Int) -> Int {
    let e = ptr_to_node(callPtr)
    let ty = aifNodeType(e)

    // s2 is the mangled symbol sema resolved this call to; the callee node's s1
    // is the name as written, which is what an FFI contract is keyed on.
    let mut callee = e.s2
    let mut plain = callee
    if (nodeExists(e.child1)) {
        let target = ptr_to_node(e.child1)
        plain = target.s1
        if (strEquals(callee, "")) { callee = target.s1 }
    }

    let calleeId = aif_fn_lookup(callee)
    let mut known = false
    if (calleeId >= 0) {
        if (aif_fn_is_sealed(calleeId) == 0) { known = true }
    }

    // Arguments are evaluated exactly once, into a frame, because evaluating one
    // creates allocation sites and a contract may name another argument by
    // index. Re-walking to find argument k would duplicate every site inside it.
    let base = aif_argv_begin()
    let mut aPtr = e.child2
    while (nodeExists(aPtr)) {
        let a = ptr_to_node(aPtr)
        aif_argv_push(aifSitesOf(aPtr, fnId, scope))
        aPtr = a.next
    }
    let argc = aif_argv_count(base)

    // SPEC 5.2.1's call graph, recorded here because this is the only place that
    // knows the caller, the callee and the scope at once. A callee whose body
    // this compilation cannot see -- sealed, or an extern no contract describes
    // -- is an edge to nothing: it makes its caller unsummarisable rather than
    // contributing a node the closure could walk into.
    //
    // `drop` is excluded from the opaque case. It is fully modelled, by
    // aif_con_no_stack, and the DROP obligation reports it in the terms a reader
    // can act on; calling it opaque as well would answer "a body nobody can see"
    // about the one builtin whose effect the model knows exactly.
    if (known) {
        aif_call_edge(fnId, calleeId, scope)
    } else if (strEquals(plain, "drop") == false) {
        if (aifCallIsSummarised(plain, argc) == false) {
            aif_call_opaque(fnId, scope)
        }
    }

    // `drop(x)` lowers to a free, and a stack slot cannot be freed. Suppress T0
    // for whatever it names -- see aif_con_no_stack for why this is a codegen
    // constraint rather than a fact.
    if (strEquals(plain, "drop")) {
        if (argc > 0) {
            aif_con_no_stack(aif_argv_get(base, 0))
        }
    }

    let mut i = 0
    while (i < argc) {
        let av = aif_argv_get(base, i)
        if (known) {
            aif_con_arg(aif_key_param(calleeId, i), av)
        } else {
            let contract = aifFfiContract(plain, i)
            if (contract >= AIF_FFI_RETAIN_IN_BASE) {
                let holderIndex = contract - AIF_FFI_RETAIN_IN_BASE
                aif_con_retain_in(av, aif_argv_get(base, holderIndex))
                // SPEC 5.2.1's obligation 2, container form. `list_push(dest, x)`
                // on a `dest` this function did not allocate is the counter-
                // example the summary exists to catch -- and it has to be
                // recorded on the *holder*, not on `x`, because the element
                // block reallocates whether or not the pushed value has a site.
                aif_note_owner_use(fnId, aif_argv_get(base, holderIndex))
                // ...and the container's element field now points at it, so a
                // later read gets the element back rather than the container.
                aif_con_bind(aifElemKey(aifElementContainerType(aifArgTypeAt(e, holderIndex))), av)
            } else if (contract == AIF_FFI_RETAIN) {
                aif_con_escape_global(av)
            } else if (contract == AIF_FFI_CONSUME) {
                // The callee frees it, so it must be something a free can take:
                // never a stack slot, and no longer this frame's to reclaim.
                // The second constraint is the half `no_stack` cannot carry: a
                // `drop` sets that flag too, and only a transfer means somebody
                // else performs the free.
                aif_con_no_stack(av)
                aif_con_transferred(av)
                aif_con_escape_caller(av)
            } else {
                // FFI 5.1: the callee may read and write during the call but does
                // not retain, so it cannot extend a lifetime. Only A rises.
                aif_con_borrow(av)
            }
        }
        i = i + 1
    }

    let aliasOf = aifFfiAliasOf(plain)
    let mut aliased = aifVsEmpty()
    if (aliasOf >= 0 and aliasOf < argc) {
        aliased = aif_argv_get(base, aliasOf)
    }

    // Reading an element out of a container yields what was stored into it, which
    // is the element field rather than the container. Resolved at the fixed point
    // like any other key, so it does not matter that the pushes may be walked
    // after this read.
    let elemReadOf = aifFfiReadsElement(plain)
    let mut element = aifVsEmpty()
    let mut readsElement = false
    if (elemReadOf >= 0 and elemReadOf < argc) {
        element = aifVsOfKey(aifElemKey(aifElementContainerType(aifArgTypeAt(e, elemReadOf))))
        readsElement = true

        // SPEC 8.4: an element reference IS a view, so this read produces one.
        //
        // The element key stays exactly what it was -- a points-to edge saying
        // *which values* can come back. Provenance is attached beside it, and
        // says the thing the points-to graph cannot: *how long the container
        // must live* for that reference to be legal.
        //
        // Both are needed, and merging them is the bug this reconciles. Without
        // the points-to edge a read returns nothing and every store through the
        // result is a no-op. Without provenance the result can outlive the
        // container that owns it and nothing notices. Putting the container
        // *into* the element set -- which is what list_get used to do -- makes a
        // receiving container call list_release on a struct.
        //
        // Only a reference is a view. Reading an `Int` out of a `List<Int>`
        // copies it into a register, and a copy that leaves the function keeps
        // nothing alive -- `return list_get(nums, 0)` in test_50 demoted the
        // whole list until this guard existed. SPEC 8.4 says a view is a
        // *reference* to part of a collection, and aifIsRef is already the
        // model's word for which values are references at all.
        if (aifIsRef(ty)) {
            aif_vs_view_of(element, aif_argv_get(base, elemReadOf))
        }
    }

    // For a declared `alias`, everything the call could have reached.
    let mut aliasedAll = aifVsEmpty()
    let mut aliasedAny = false
    let mut aI = 0
    while (aI < argc) {
        let one = aif_argv_get(base, aI)
        if (aif_vs_is_empty(one) == 0) {
            aliasedAll = aif_vs_union(aliasedAll, one)
            aliasedAny = true
        }
        aI = aI + 1
    }
    aif_argv_end(base)

    if (known) {
        // Item 3. The caller may own what a known callee returned, and the escape
        // lattice cannot say so -- E is per site and a site belongs to one
        // function, so Region(s) never names a scope in the caller. Recording the
        // call node lets the question be asked of the converged facts later; see
        // aif_owns_call_result_at_node for what it takes to answer yes.
        let retVs = aifVsOfKey(aif_key_ret(calleeId))
        aif_note_call_result(callPtr, retVs, calleeId)
        return retVs
    }
    if (readsElement) {
        return element
    }
    if (aliasOf >= 0 and aliasOf < argc) {
        return aliased
    }
    // v0.1 concurrency. A channel endpoint is a runtime object this compilation
    // did not allocate, so like a task handle it contributes no site: there is
    // nothing to place, count or release, and `chan_free` is where it goes.
    // `chan_share` hands back the same endpoint, which is what makes it a second
    // *reference* and not a second owner.
    if (strEquals(plain, "chan_new") or strEquals(plain, "chan_share")) {
        return aifVsEmpty()
    }

    if (aifIsRef(ty)) {
        // FFI 5.2 `alias`: the return is not an allocation -- it borrows from an
        // argument or from static storage. Modelling it as a fresh site would
        // invent an allocation that does not exist, which is what makes every
        // `ptr_to_node` result look like an independent opaque value.
        //
        // FFI.md's `alias` names no argument, so the return is the union of the
        // arguments' value sets. That generalises the `list_get` special case
        // rather than adding a second mechanism, and it is the sound reading:
        // whatever the callee could have returned, it reached through one of
        // them.
        //
        // Returning nothing would NOT be sound. A value set with no sites makes
        // every subsequent store through the result a no-op, so nothing inherits
        // the container's escape -- optimistic, and optimistic is the direction
        // that produces a use-after-free rather than a slow program. Where there
        // is nothing to alias, fall through to the opaque path instead.
        if (aifDeclaredReturnIsAlias(plain)) {
            if (aliasedAny) {
                return aliasedAll
            }
            // `alias` with nothing to alias is FFI 5.2's other case: static
            // storage. That is not an allocation and does not belong on a ladder
            // that ranks ways of reclaiming heap memory -- the same reason a
            // string literal is excluded. Interned names, temp names and the
            // symbol tables are all this shape.
            //
            // The exclusion rests on the declaration being true, which is what
            // FFI 1 means by the boundary being the one place a wrong answer is
            // unsafe. If it is wrong the value leaks rather than being freed
            // twice, which is the direction FFI 5.4 chooses deliberately.
            // Counted so the exclusion is visible rather than silent.
            aifStaticReturns = aifStaticReturns + 1
            return aifVsEmpty()
        }

        aifExternAlloc = aifExternAlloc + 1
        let sid = aifNewSite(ty, fnId, scope, callPtr)
        let mut produces = aifFfiProduces(plain)
        if (aifDeclaredReturnIsProduce(plain)) { produces = true }
        // A return that hands over an allocation made somewhere else entirely
        // owns nothing this frame can place: not a stack slot, not an arena
        // chunk. See aifFfiTransfersExisting for why this is narrower than
        // `produces` -- an ordinary producer allocates through `rt_alloc`, which
        // an enclosing region really does serve.
        if (aifFfiTransfersExisting(plain)) { aif_con_foreign(aifVsOfSite(sid)) }
        if (produces == false) {
            // Undeclared return: provenance unknown. It may already be shared
            // and may already outlive this frame, so it cannot be modelled as a
            // fresh local allocation.
            aifOpaqueReturns = aifOpaqueReturns + 1
            aif_con_opaque(aifVsOfSite(sid))
        }
        return aifVsOfSite(sid)
    }
    return aifVsEmpty()
}

// ---------------------------------------------------------------------------
// Statement walk
// ---------------------------------------------------------------------------

private fn aifIsStatementKind(k: NodeKind) -> Bool {
    if (k == NodeKind.BLOCK) { return true }
    if (k == NodeKind.VARIABLE_DECL) { return true }
    if (k == NodeKind.ASSIGNMENT_STATEMENT) { return true }
    if (k == NodeKind.RETURN_STATEMENT) { return true }
    if (k == NodeKind.IF_STATEMENT) { return true }
    if (k == NodeKind.WHILE_STATEMENT) { return true }
    if (k == NodeKind.FOR_STATEMENT) { return true }
    if (k == NodeKind.LOOP_STATEMENT) { return true }
    if (k == NodeKind.MATCH_STATEMENT) { return true }
    if (k == NodeKind.MATCH_ARM) { return true }
    if (k == NodeKind.EXPRESSION_STATEMENT) { return true }
    if (k == NodeKind.REGION_STATEMENT) { return true }
    return false
}

// SPEC 5's annotations, read off the declaration the parser stored them on.
//
// They apply to the value set the *initialiser* denotes, not to the name: an
// annotation is a statement about an allocation, and the binding is how the
// source points at one. `let unique b = a` therefore annotates whatever `a`
// already named, which is the same value -- the move made it this scope's.
//
// `pin(X)` carries one identifier and there are two things it can be. A tier
// name is one; anything else is a **region name** (SPEC 5.4 as a placement
// constraint), and this is the only place the two are told apart.
//
// Sema no longer adjudicates the name, and that is a deliberate move rather than
// an omission. It used to warn "unknown tier" for anything not in the list here
// and then *drop the annotation* -- which is this project's signature defect
// wearing an annotation's clothes: the programmer asserted something, the
// compiler said something back, and nothing could ever fail. A name is now
// either a tier or a region, and a region that does not exist or does not serve
// the value is refuted by aif_check_placement_pins, which is an error.
private fn aifTierFromName(name: String) -> Int {
    if (strEquals(name, "T0")) { return 0 }
    if (strEquals(name, "T1")) { return 1 }
    if (strEquals(name, "T2")) { return 2 }
    if (strEquals(name, "T3")) { return 3 }
    if (strEquals(name, "T4b")) { return 4 }
    // REQUIREMENTS 15. `pin(T4a)` asks for an atomic count, and it is honoured
    // wherever the derived tier is cheaper -- raising a tier is always sound, so
    // this is the one direction a pin can go without the facts backing it.
    // `pin(T4b)` on a site the solver put at T4a goes the other way and is
    // refuted, which is what the ordinal order buys.
    if (strEquals(name, "T4a")) { return 5 }
    return 0 - 1
}

private fn aifApplyAnnotations(decl: ASTNode, vs: Int) {
    if (strEquals(decl.s2, "")) { return }

    if (strContains(decl.s2, "unique ")) {
        aif_con_unique(vs)
    }

    let at = strIndexOf(decl.s2, "pin:")
    if (at >= 0) {
        let mut name = strSubstring(decl.s2, at + 4, __builtin_string_len(decl.s2) - at - 4)
        let space = strIndexOf(name, " ")
        if (space >= 0) { name = strSubstring(name, 0, space) }
        let tier = aifTierFromName(name)
        if (tier >= 0) {
            aif_con_pin(vs, tier)
        } else {
            // SPEC 5.4 on the placement rather than on the tier. Recorded here
            // and adjudicated after aif_place_arenas, because what it asserts is
            // an *output* of placement -- the tier pins are settled before the
            // cost model runs, and this one cannot be.
            aif_con_pin_region(vs, name)
        }
    }
}

private fn aifWalk(nodePtr: Ptr, fnId: Int, scope: Int) {
    if (nodeIsNull(nodePtr)) { return }
    let n = ptr_to_node(nodePtr)

    // Every constraint added from here down is attributed to this statement.
    // SPEC 6.3's witness path puts a file:line on each edge, and the rule alone
    // does not carry one -- "A-STORE" without a position says which rule fired
    // and not where, which is the half a reader cannot supply themselves.
    aif_con_at(n.file, n.line, n.col)

    if (n.kind == NodeKind.BLOCK) {
        // Every scope is an implicit region (INFERENCE 2.1), which is what makes
        // the T0/T1 boundary a size question rather than an escape question.
        // Which of them gets a real arena is LAYOUT 7.1's cost decision, and it
        // needs the block back to tell codegen where to bracket it.
        let inner = aif_scope_new(scope, fnId)
        aif_scope_note_node(inner, nodePtr)
        aif_scope_set_loop_depth(inner, aifLoopDepth)
        // M3.2. The three chains are one statement list, so they share one
        // numbering. Saved and restored because `aifWalk` below descends into
        // nested blocks, each of which numbers its own statements from 0.
        let savedCursor = aifStmtCursor
        aifStmtCursor = 1
        aifWalkChain(n.child1, fnId, inner)
        aifWalkChain(n.child2, fnId, inner)
        aifWalkChain(n.child3, fnId, inner)
        aifStmtCursor = savedCursor
        return
    }

    // A loop body allocates once per iteration, not once per entry of the
    // enclosing scope. Tracking the depth is what lets the benefit of an arena
    // inside a loop be weighed against one outside it. The header is outside the
    // body: a `while` condition and a `for` range are evaluated in the enclosing
    // scope, and an allocation there is not the loop's.
    if (n.kind == NodeKind.WHILE_STATEMENT) {
        aifWalkChildren(n.child1, fnId, scope)
        aifLoopDepth = aifLoopDepth + 1
        aif_traversal_begin()
        aifWalkChildren(n.child2, fnId, scope)
        aif_traversal_end()
        aifLoopDepth = aifLoopDepth - 1
        return
    }

    if (n.kind == NodeKind.LOOP_STATEMENT) {
        aifLoopDepth = aifLoopDepth + 1
        aif_traversal_begin()
        aifWalkChildren(n.child1, fnId, scope)
        aif_traversal_end()
        aifLoopDepth = aifLoopDepth - 1
        return
    }

    if (n.kind == NodeKind.FOR_STATEMENT) {
        aifWalkChildren(n.child1, fnId, scope)
        aifWalkChildren(n.child2, fnId, scope)
        aifLoopDepth = aifLoopDepth + 1
        aif_traversal_begin()
        aifWalkChildren(n.child3, fnId, scope)
        aif_traversal_end()
        aifLoopDepth = aifLoopDepth - 1
        return
    }

    // SPEC 5.2. The scope it opens is an ordinary one -- the escape fact would
    // have been the same without the keyword. Naming it is what changes: an
    // allocation whose escape bottoms at or below this scope may be served from
    // an arena rather than the heap, and the manifest can say which one.
    if (n.kind == NodeKind.REGION_STATEMENT) {
        let inner = aif_scope_new(scope, fnId)
        aif_scope_set_region(inner, n.s1)
        aif_scope_set_region_span(inner, n.file, n.line, n.col)
        // REQUIREMENTS 19. `region work pin(4096)` asserts a cap on what this
        // arena serves. Recorded here and checked once the facts have converged,
        // for the same reason SPEC 5.4's pins are: the estimate reads tiers.
        if (n.i1 > 0) {
            aif_scope_set_budget(inner, n.i1, n.file, n.line, n.col)
        }
        aifWalk(n.child1, fnId, inner)
        return
    }

    if (n.kind == NodeKind.VARIABLE_DECL) {
        // Recorded whether or not there is an initialiser: a later assignment to
        // this name needs the declaring scope, and `let x: T` with no value is
        // still a declaration.
        aif_var_note_scope(fnId, n.s1, scope)
        if (nodeExists(n.child2)) {
            // LAYOUT 5's `order`. A binding of a container element inside a loop
            // is the shape the cost model calls sequential: the records are
            // visited in container order, which is the only thing that makes a
            // smaller hot record worth anything. Anything else stays a pointer
            // chase, where a split costs a second miss instead.
            let init = ptr_to_node(n.child2)
            if (init.kind == NodeKind.CALL_EXPR) {
                if (nodeExists(init.child1)) {
                    let callee = ptr_to_node(init.child1)
                    if (strEquals(callee.s1, "list_get")) {
                        aif_traversal_elem(aifBaseType(aifNodeType(n)), 1)
                    }
                }
            }
            let v = aifSitesOf(n.child2, fnId, scope)
            aif_con_bind(aif_key_var(fnId, n.s1), v)
            aif_con_live_in(v, scope, fnId)
            aifApplyAnnotations(n, v)
        }
        return
    }

    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT) {
        // Value before target, because both may allocate and site identity is
        // creation order. Nothing downstream depends on it, but the oracle
        // orders them this way and a difference here would be invisible until
        // it was not.
        let mut val = aifVsEmpty()
        if (nodeExists(n.child2)) {
            val = aifSitesOf(n.child2, fnId, scope)
        }

        if (nodeExists(n.child1)) {
            let tgt = ptr_to_node(n.child1)
            if (tgt.kind == NodeKind.IDENTIFIER_EXPR) {
                aif_con_bind(aif_key_var(fnId, tgt.s1), val)
                // E-BIND against the *variable's* scope, not the assignment's.
                // A value created in a loop body and assigned to a binding
                // declared outside it survives the iteration, so its escape has
                // to say so. Using the assignment's scope instead reads as "dies
                // at the end of this iteration", which is how a hoisted T0
                // alloca would hand two live values the same slot.
                //
                // Falls back to the assignment's scope for a name with no
                // declaration on record -- a global, which lives longer than any
                // scope anyway and is handled by the store path.
                let mut holderScope = aif_var_scope(fnId, tgt.s1)
                if (holderScope < 0) { holderScope = scope }
                aif_con_live_in(val, holderScope, fnId)
            } else if (tgt.kind == NodeKind.MEMBER_ACCESS_EXPR) {
                let mut owner = aifVsEmpty()
                let mut base = ""
                if (nodeExists(tgt.child1)) {
                    let obj = ptr_to_node(tgt.child1)
                    base = aifBaseType(aifNodeType(obj))
                    owner = aifSitesOf(tgt.child1, fnId, scope)
                }
                aif_field_access(base, tgt.s1, aifLoopDepth)
                aif_con_store(aif_key_field(base, tgt.s1), val, owner)
                // SPEC 5.2.1's obligation 2, and the case that can actually
                // fail it: `param.field = Foo{}` stores into an object this
                // function did not allocate, so the Foo outlives any region a
                // caller could bracket the call with.
                aif_note_owner_use(fnId, owner)
            }
        }
        return
    }

    if (n.kind == NodeKind.RETURN_STATEMENT) {
        if (nodeExists(n.child1)) {
            let v = aifSitesOf(n.child1, fnId, scope)
            aif_con_bind(aif_key_ret(fnId), v)
            aif_con_return(v, fnId)
        }
        return
    }

    // REQUIREMENTS 18. A payload arm binds names out of the scrutinee's fields,
    // and codegen lowers each one as exactly that field load
    // (`generatePayloadBinders` in src/ir/stmt.psm). This walk had **no case for
    // it at all**: the arms were walked as ordinary statements, so `v` in
    // `match (o) { Option.Some(v) => { return v } }` was bound to nothing --
    // no points-to, and no view of `o`.
    //
    // That is what let a caller free the argument before reading the result.
    // `optionOr(maybeName(), "!")` returns the String inside the Option it was
    // handed, but with `v` bound to nothing the return carried neither `o`'s
    // sites nor a view of them, so `fn_may_return_param` and
    // `fn_may_return_view_of_param` both answered a truthful no to the question
    // codegen was asking. The release for the unbound temporary was emitted
    // immediately after the call and before the `println` that read its result,
    // and the value came back empty. `--verify` could not see it: both releases
    // are ledger-legal, so the run reported `4 allocated, 4 released, 0 leaked,
    // 0 violation(s)` **and** the wrong answer.
    //
    // The scrutinee is evaluated once here, as codegen evaluates it once, and
    // the arms are then walked exactly as the fall-through below would.
    if (n.kind == NodeKind.MATCH_STATEMENT) {
        let scrutinee = aifSitesOf(n.child1, fnId, scope)
        let scrutType = aifBaseType(aifNodeType(ptr_to_node(n.child1)))
        let mut armPtr = n.child2
        while (nodeExists(armPtr)) {
            let arm = ptr_to_node(armPtr)
            aifBindPayloadArm(arm, scrutType, scrutinee, fnId, scope)
            armPtr = arm.next
        }
        aifWalkChildren(n.child2, fnId, scope)
        aifWalkChildren(n.child3, fnId, scope)
        return
    }

    aifWalkChildren(n.child1, fnId, scope)
    aifWalkChildren(n.child2, fnId, scope)
    aifWalkChildren(n.child3, fnId, scope)
}

// One payload arm's binders, bound to the fields they read.
//
// A reference-shaped payload is a **view** of the scrutinee -- the same split
// the element and field rules make above, and for the same reason: a reference
// read out of a container shares the container's lifetime, while a scalar is a
// copy that has none of it. `arm.s2` is empty on any arm sema did not stamp with
// a variant, which is every arm of a match that is not over a payload enum.
private fn aifBindPayloadArm(arm: ASTNode, scrutType: String, scrutinee: Int,
                             fnId: Int, scope: Int) {
    if (strEquals(arm.s2, "")) { return }
    if (nodeIsNull(arm.child1)) { return }
    let pattern = ptr_to_node(arm.child1)
    if (pattern.kind != NodeKind.CALL_EXPR) { return }

    let mut binderPtr = pattern.child2
    let mut index = 0
    while (nodeExists(binderPtr)) {
        let binder = ptr_to_node(binderPtr)
        let field = aifVsOfKey(aif_key_field(scrutType, enumPayloadField(arm.s2, index)))
        if (aifIsRef(aifNodeType(binder))) { aif_vs_view_of(field, scrutinee) }
        aif_var_note_scope(fnId, binder.s1, scope)
        aif_con_bind(aif_key_var(fnId, binder.s1), field)
        index = index + 1
        binderPtr = binder.next
    }
}

// REQUIREMENTS 15, in service of INFERENCE 4.1's E-SPAWN-J. Does this
// expression tree contain `join <name>`?
//
// Stops dead at any statement kind, which is what keeps it from wandering out
// of the expression it was handed and into a nested block's statements. Without
// that guard `if (c) { join t }` would read as an unconditional join.
private fn aifExprHasJoinOf(ptr: Ptr, name: String) -> Bool {
    if (nodeIsNull(ptr)) { return false }
    let n = ptr_to_node(ptr)
    if (aifIsStatementKind(n.kind)) { return false }

    if (n.kind == NodeKind.JOIN_EXPR) {
        if (nodeExists(n.child1)) {
            let target = ptr_to_node(n.child1)
            if (target.kind == NodeKind.IDENTIFIER_EXPR and strEquals(target.s1, name)) {
                return true
            }
        }
    }

    if (aifExprHasJoinOf(n.child1, name)) { return true }
    if (aifExprHasJoinOf(n.child2, name)) { return true }
    if (aifExprHasJoinOf(n.child3, name)) { return true }
    // Call arguments are a sibling chain, so `use(join t)` needs this. Safe
    // because the statement guard above already stopped the walk at any
    // statement, so a chain reached from here is an expression list.
    return aifExprHasJoinOf(n.next, name)
}

// INFERENCE 4.1's E-SPAWN-J: "joined on every path before scope `s` exits".
//
// This decides E-SPAWN-J against E-SPAWN, which INFERENCE calls the place
// structured concurrency pays. It is the whole difference between a task's
// arguments staying region-bound at T1 and being forced to Global, and from
// there through A-ESCAPE to Shared and on to T4a with an atomic count.
//
// **The previous version was a forward scan and it was wrong in a way no
// fixture caught.** Its early-exit helper recursed into `n.next`, so it did not
// ask "can control leave this statement" but "does anything between here and
// the end of the block leave" -- and the block always ends in `return join t`,
// which answered yes. The measured consequence: a single inert `let x = 1`
// between a spawn and its join moved the argument from **T0 with no count at
// all to T4a with an atomic one**. Four of five ordinary shapes fell off that
// cliff, including a loop with no break and a bare `if`. The two fixtures in
// tests/aif_concurrency.psm both happen to join on the statement immediately
// after the spawn, which is the one shape the scan got right.
//
// What replaces it is two mutually recursive judgements over the statement
// tree, in the style src/sema/flow.psm already uses for definite-return:
//
//   * `aifChainJoins`          -- does **every** path through this chain reach a
//                                 join before control leaves the chain?
//   * `aifChainEscapesUnjoined` -- is there **some** path that leaves the
//                                 enclosing scope without having joined?
//
// They are not negations of each other and both are needed. Falling out of the
// bottom of a chain means "not joined" for the first (the scope exits with the
// task still running) but "did not escape" for the second (control simply
// continues into the enclosing chain). Conflating them is how an analysis of
// this shape becomes unsound.
//
// Every default is the conservative one. Being wrong towards "not joined" costs
// a tier; being wrong the other way hands a value a scope-bound lifetime while
// a task still holds it, which is a use-after-free.

// A join in this statement's own expression -- not in any block it contains.
private fn aifStmtDirectJoin(n: ASTNode, name: String) -> Bool {
    if (n.kind == NodeKind.VARIABLE_DECL) { return aifExprHasJoinOf(n.child2, name) }
    if (n.kind == NodeKind.EXPRESSION_STATEMENT) { return aifExprHasJoinOf(n.child1, name) }
    if (n.kind == NodeKind.RETURN_STATEMENT) { return aifExprHasJoinOf(n.child1, name) }
    if (n.kind == NodeKind.ASSIGNMENT_STATEMENT) { return aifExprHasJoinOf(n.child2, name) }
    return false
}

// The statement chain under a block, or "" when there is no block there.
private fn aifBlockChain(ptr: Ptr) -> Ptr {
    if (nodeIsNull(ptr)) { return ptr_null() }
    return ptr_to_node(ptr).child1
}

// Some path through this statement leaves the scope being analysed without
// having joined first.
//
// `inLoop` is what makes `break` and `continue` mean different things at
// different depths. Inside a loop that is itself part of the chain being
// scanned, a break is *absorbed* by that loop and control continues in the
// chain; at the top level it leaves. The old scan could not tell those apart
// and counted every break as an exit, which its own comment admitted.
private fn aifStmtEscapesUnjoined(n: ASTNode, name: String, inLoop: Bool) -> Bool {
    if (n.kind == NodeKind.RETURN_STATEMENT) {
        return aifExprHasJoinOf(n.child1, name) == false
    }
    if (n.kind == NodeKind.BREAK_STATEMENT or n.kind == NodeKind.CONTINUE_STATEMENT) {
        return inLoop == false
    }
    if (n.kind == NodeKind.IF_STATEMENT) {
        if (aifChainEscapesUnjoined(aifBlockChain(n.child2), name, inLoop)) { return true }
        if (nodeIsNull(n.child3)) { return false }
        let elseNode = ptr_to_node(n.child3)
        if (elseNode.kind == NodeKind.IF_STATEMENT) {
            return aifStmtEscapesUnjoined(elseNode, name, inLoop)
        }
        return aifChainEscapesUnjoined(elseNode.child1, name, inLoop)
    }
    if (n.kind == NodeKind.WHILE_STATEMENT) {
        return aifChainEscapesUnjoined(aifBlockChain(n.child2), name, true)
    }
    if (n.kind == NodeKind.LOOP_STATEMENT) {
        return aifChainEscapesUnjoined(aifBlockChain(n.child1), name, true)
    }
    if (n.kind == NodeKind.FOR_STATEMENT) {
        return aifChainEscapesUnjoined(aifBlockChain(n.child3), name, true)
    }
    // A region is not a loop, so a break inside one belongs to whatever encloses
    // it and `inLoop` passes through unchanged -- the same reading
    // semaBlockHasBreak takes.
    if (n.kind == NodeKind.REGION_STATEMENT) {
        return aifChainEscapesUnjoined(aifBlockChain(n.child1), name, inLoop)
    }
    if (n.kind == NodeKind.BLOCK) {
        return aifChainEscapesUnjoined(n.child1, name, inLoop)
    }
    if (n.kind == NodeKind.MATCH_STATEMENT) {
        let mut armPtr = n.child2
        while (nodeExists(armPtr)) {
            let arm = ptr_to_node(armPtr)
            if (aifChainEscapesUnjoined(aifBlockChain(arm.child2), name, inLoop)) { return true }
            armPtr = arm.next
        }
        return false
    }
    return false
}

// Every path through this statement joins.
private fn aifStmtAlwaysJoins(n: ASTNode, name: String, inLoop: Bool) -> Bool {
    if (aifStmtDirectJoin(n, name)) { return true }

    if (n.kind == NodeKind.IF_STATEMENT) {
        // Without an else there is a path that runs none of the arm, so the
        // fall-through decides it and the enclosing chain is what sees that.
        if (nodeIsNull(n.child3)) { return false }
        if (aifChainJoins(aifBlockChain(n.child2), name, inLoop) == false) { return false }
        let elseNode = ptr_to_node(n.child3)
        if (elseNode.kind == NodeKind.IF_STATEMENT) {
            return aifStmtAlwaysJoins(elseNode, name, inLoop)
        }
        return aifChainJoins(elseNode.child1, name, inLoop)
    }
    if (n.kind == NodeKind.BLOCK) {
        return aifChainJoins(n.child1, name, inLoop)
    }
    if (n.kind == NodeKind.REGION_STATEMENT) {
        return aifChainJoins(aifBlockChain(n.child1), name, inLoop)
    }

    // Deliberately **not** MATCH, even though exhaustiveness is checked and
    // "every arm joins" would therefore be sound today. The soundness would be
    // borrowed from another pass: a hole in exhaustiveness would turn into a
    // use-after-free here rather than into a missing-case diagnostic there. A
    // match between a spawn and its join costs a tier and nothing worse.
    //
    // Nor a loop of any kind. `while` and `for` may run zero times, and a `loop`
    // may never terminate; neither is a path this can prove joins.
    return false
}

// Some path through this chain leaves the scope without joining. Statements
// after one that always joins cannot contribute -- the join already happened.
private fn aifChainEscapesUnjoined(head: Ptr, name: String, inLoop: Bool) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (aifStmtEscapesUnjoined(n, name, inLoop)) { return true }
        if (aifStmtAlwaysJoins(n, name, inLoop)) { return false }
        p = n.next
    }
    return false
}

// Every path through this chain joins before control leaves it.
//
// The escape test runs first, and the order is the whole correctness argument:
// `if (c) { return 0 }` followed by `return join t` has a path that leaves
// without joining, and asking "does something later join" first would answer
// yes and miss it. That shape is tests/aif_concurrency.psm's
// `unjoined_is_cross_thread`, which is why it still reports CrossThread.
private fn aifChainJoins(head: Ptr, name: String, inLoop: Bool) -> Bool {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (aifStmtEscapesUnjoined(n, name, inLoop)) { return false }
        if (aifStmtAlwaysJoins(n, name, inLoop)) { return true }
        p = n.next
    }
    // Fell out of the bottom with the task still running.
    return false
}

private fn aifSpawnIsJoined(afterPtr: Ptr, name: String) -> Bool {
    // `inLoop` is false at the top: the scope being analysed is the block
    // holding the spawn, and a `break` written directly in it leaves that block.
    return aifChainJoins(afterPtr, name, false)
}

private fn aifWalkChain(head: Ptr, fnId: Int, scope: Int) {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        // REQUIREMENTS 15. Decided here rather than at the SPAWN_EXPR itself,
        // because "joined before this scope exits" is a property of the
        // statements *around* the spawn and this is the only walk that has
        // them. Stamped on the spawn node, whose i1 the parser leaves 0 -- so
        // the default is the conservative answer and a spawn this pass never
        // reaches is treated as unjoined rather than as joined.
        if (n.kind == NodeKind.VARIABLE_DECL and nodeExists(n.child2)) {
            let init = ptr_to_node(n.child2)
            if (init.kind == NodeKind.SPAWN_EXPR) {
                if (aifSpawnIsJoined(n.next, n.s1)) { init.i1 = 1 }
            }
        }
        // M3.2. Stamped before the statement is walked, so every site and call
        // edge it creates carries the position -- and re-stamped each iteration
        // rather than once per chain, because a nested block will have moved the
        // engine's cursor by the time control returns here.
        if (aifStmtCursor > 0) {
            aif_stmt_at(scope, aifStmtCursor - 1)
            aifStmtCursor = aifStmtCursor + 1
        }
        aifWalk(p, fnId, scope)
        p = n.next
    }
}

// A child is either a nested statement, which keeps walking, or an expression,
// which is evaluated for its allocations.
private fn aifWalkChildren(head: Ptr, fnId: Int, scope: Int) {
    let mut p = head
    while (nodeExists(p)) {
        let n = ptr_to_node(p)
        if (aifIsStatementKind(n.kind)) {
            aifWalk(p, fnId, scope)
        } else {
            aifSitesOf(p, fnId, scope)
        }
        p = n.next
    }
}

internal fn aifDeclare(module: ASTNode) {
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)

        if (d.kind == NodeKind.STRUCT_DECL) {
            aif_struct_new(d.s1)
            let mut fPtr = d.child1
            while (nodeExists(fPtr)) {
                let f = ptr_to_node(fPtr)
                if (f.kind == NodeKind.STRUCT_FIELD) {
                    let mut width = 8
                    if (nodeExists(f.child1)) {
                        width = aifTypeBytes(ptr_to_node(f.child1))
                    }
                    aif_struct_add_field(d.s1, f.s1, aifFieldTypeName(f), width)
                    // The same question `fieldTypeFor` asks in src/ir/module.psm,
                    // from the same definition, so the analysis and the layout
                    // cannot disagree about which fields own a pointer. An inline
                    // field owns nothing: the value is copied into the object's
                    // own storage and whoever produced it still has to free it.
                    if (nodeExists(f.child1)) {
                        if (aifFieldIsInlineExact(module, ptr_to_node(f.child1))) {
                            aif_struct_field_inline(d.s1, f.s1, 1)
                        }
                    }
                }
                fPtr = f.next
            }
        } else if (d.kind == NodeKind.ENUM_DECL) {
            aif_enum_new(d.s1)
        } else if (d.kind == NodeKind.EXTERN_FUNCTION) {
            // Contracts live on each type annotation's s2 (see parser.psm). The
            // return's is filed under index -1.
            let mut index = 0
            let mut pPtr = d.child1
            while (nodeExists(pPtr)) {
                let param = ptr_to_node(pPtr)
                if (param.kind == NodeKind.FUNCTION_PARAMETER) {
                    if (nodeExists(param.child1)) {
                        let ann = ptr_to_node(param.child1)
                        if (strEquals(ann.s2, "") == false) {
                            aif_extern_contract_set(d.s1, index, ann.s2)
                        }
                    }
                    index = index + 1
                }
                pPtr = param.next
            }
            if (nodeExists(d.child2)) {
                let ret = ptr_to_node(d.child2)
                if (strEquals(ret.s2, "") == false) {
                    aif_extern_contract_set(d.s1, 0 - 1, ret.s2)
                }
            }
        } else if (d.kind == NodeKind.FUNCTION) {
            // s2 is the mangled symbol, which is the identity an overloaded name
            // does not have. Falling back to s1 keeps this working on an AST
            // that has not been through sema, which is a debugging convenience
            // rather than a supported path.
            let mut sym = d.s2
            if (strEquals(sym, "")) { sym = d.s1 }
            aif_fn_new(sym, d.s1, d.file)
        }

        p = d.next
    }
}

internal fn aifBuild(module: ASTNode) {
    // Structs must all exist before any edge is added, because an edge names
    // both ends and fields are declared in whatever order the source has.
    let mut p = module.child1
    while (nodeExists(p)) {
        let d = ptr_to_node(p)
        if (d.kind == NodeKind.STRUCT_DECL) {
            aifRegisterTypeEdges(d)
        }
        p = d.next
    }
    aif_compute_type_acyclic()

    let mut q = module.child1
    while (nodeExists(q)) {
        let d = ptr_to_node(q)
        if (d.kind == NodeKind.FUNCTION) {
            let mut sym = d.s2
            if (strEquals(sym, "")) { sym = d.s1 }
            let fid = aif_fn_lookup(sym)

            if (fid >= 0) {
                let root = aif_scope_new(0 - 1, fid)

                let mut paramPtr = d.child1
                let mut index = 0
                while (nodeExists(paramPtr)) {
                    let param = ptr_to_node(paramPtr)
                    if (param.kind == NodeKind.FUNCTION_PARAMETER) {
                        // A parameter is declared at the function root, so a
                        // value assigned to it anywhere in the body outlives
                        // every block inside it.
                        aif_var_note_scope(fid, param.s1, root)
                        // Declared `sink`: the call moved it, so the caller has
                        // no owner left for the guard to protect.
                        if (strEquals(param.s2, "sink")) {
                            aif_note_param_consuming(fid, index)
                        }
                        let mut pty = aifNodeType(param)
                        if (strEquals(pty, "")) {
                            if (nodeExists(param.child1)) {
                                let ann = ptr_to_node(param.child1)
                                pty = ann.s1
                            }
                        }
                        if (aifIsRef(pty)) {
                            aif_con_bind(aif_key_var(fid, param.s1),
                                         aifVsOfKey(aif_key_param(fid, index)))
                            // SPEC 5.1 on a parameter. The axiom belongs to what
                            // the caller passed, which is the parameter key --
                            // the binding key would only cover uses inside this
                            // body and the cut is about what comes from outside.
                            if (param.i2 == 1) {
                                aif_con_unique(aifVsOfKey(aif_key_param(fid, index)))
                            }
                        }
                    }
                    index = index + 1
                    paramPtr = param.next
                }

                // A function body is a statement list too, and the root scope is
                // where a region on the whole body would sit.
                let savedFnCursor = aifStmtCursor
                aifStmtCursor = 1
                aifWalkChain(d.child2, fid, root)
                aifStmtCursor = savedFnCursor
            }
        }
        q = d.next
    }
}
