import common
import std.io

private fn benchTransientAllocation(scale: Int) -> Int {
    let rounds = 200 * scale
    let mut checksum = 0
    let mut r = 0
    while (r < rounds) {
        let mut values: Vec<Int>
        let mut i = 0
        while (i < 4000) {
            values.push((i + r) % 997)
            i = i + 1
        }
        checksum = (checksum + (values[r % 4000])) % 1000000007
        drop(values)
        r = r + 1
    }
    return checksum
}

fn main() -> Int {
    let scale = 4

    let t0 = benchNow()
    benchTransientAllocation(scale)
    let t1 = benchNow()

    println(t1 - t0)
    return 0
}
