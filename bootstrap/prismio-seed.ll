@.str.s5502 = private unnamed_addr constant [3030 x i8] c"\0AUsage:\0A\0AProject commands -- these read build.ums, found at or above the\0Aworking directory, and write to .prismio/build/<profile>/:\0A  prismio init [name]              start a project here, or in a new directory\0A  prismio build [--release]        build every target\0A  prismio run [--release]          build, then run the executable target\0A  prismio test [--release]         build and run every test target\0A  prismio clean [--release]        remove this profile's build output\0A  prismio <name> [args...]         run a command the manifest declares\0A\0ASingle-file commands -- these name a source and need no manifest:\0A\0A  prismio build [source.psm] [-o output.exe] [-g] [--verify]\0A                [--overflow-checks] [--target <triple>] [--sysroot <sdk>]\0A\0A  prismio run <source.psm> [-o output.exe] [-g] [--verify] [--jit]\0A                           [--overflow-checks]\0A\0A  prismio check <source.psm> [--diagnostic-format=json] [--overlay <file.psm> <text>]\0A                             [--module <name>]\0A  prismio bootstrap [source.psm] [-o output.exe] [-g]\0A  prismio runtime-hash\0A  prismio dump-ast <source.psm>\0A  prismio aif <source.psm> [--manifest] [--summary] [--layout] [--copyable-collections] [--theta-fields] [--budget=N]\0A                           [--target <triple>]\0A\0A  prismio aif <source.psm> --why=<ID|symbol>   explain one allocation decision\0A  prismio build|aif <source.psm> --force-layout=<Type>:<hot>   emit a named layout candidate\0A\0A      -g emits DWARF: line tables, functions, scopes, locals and struct\0A      layouts, so the program can be run under lldb or gdb. It also drops\0A      the object step to -O0, because a variable folded into a register is\0A      a variable a debugger cannot show you. Distinct from --debug, which\0A      is the analysis level and says nothing about debug info.\0A\0A      --target takes an LLVM target triple -- x86_64-apple-macos,\0A      aarch64-linux-android, x86_64-pc-windows-msvc,\0A      x86_64-unknown-linux-gnu, wasm32-unknown-unknown. LLVM validates\0A      it and answers with the pointer width and data layout, so there\0A      is no list of supported targets to fall out of date. --sysroot\0A      points clang at that target's SDK, and a cross build links\0A      runtime-<triple> rather than the host's runtime.\0A\0A      check --overlay reads <file.psm>, wherever the program reaches it, from\0A      the file <text> instead -- an editor's unsaved buffer. Check a module\0A      through its program's entry, since a module uses names its program\0A      shares: `prismio check src/main.psm --overlay src/parse/stmt.psm buf`.\0A      --module names a module checked on its own, as its importers name it:\0A      `prismio check std/map.psm --module std.map`.\0A\0A    build/run link against the installed Prismio runtime only.\0A    A project command is the same command with no source named: `prismio build`\0A    builds the project, `prismio build main.psm` builds one file.\0A    bootstrap builds the compiler itself from the repository sources,\0A    linking the compiler backend and the LLVM C API it calls.\0A\00"
@USAGE = internal global %prismio.str { ptr @.str.s5502, i64 3029 }
