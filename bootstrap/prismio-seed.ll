%Target = type { %prismio.str, %prismio.str, i32, i1 }
%TypeInfo = type { i32, ptr, %prismio.str, %prismio.str, ptr }
%UmsTarget = type { i32, i32, %prismio.str, %prismio.str, %prismio.str, %prismio.str, i32, i32 }
%UmsDependency = type { i32, i32, %prismio.str, %prismio.str, i32, i32 }
