%UmsTarget = type { i32, i32, ptr, ptr, ptr, ptr, i32, i32 }
%UmsDependency = type { i32, i32, ptr, ptr, i32, i32 }
%UmsProjectMetadata = type { ptr, ptr, ptr }
%UmsBuildConfiguration = type { ptr, ptr, ptr }
%UmsProjectModel = type { ptr, ptr, ptr, ptr, ptr, ptr }
%UmsDiagnostic = type { ptr, ptr, ptr, i32, i32, i32 }
%UmsAstValue = type { i32, i32, ptr, i32, i32 }
%UmsAstStatement = type { i32, i32, ptr, ptr, ptr, ptr, i32, i32, i1 }
%UmsAstDocument = type { ptr, ptr }
%UmsToken = type { i32, i32, ptr, i32, i32 }
%UmsLexer = type { ptr, ptr, ptr, ptr, i32, i32, i32, i32 }
