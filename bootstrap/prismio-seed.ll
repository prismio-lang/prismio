%UmsAstDocument = type { ptr, ptr }
%UmsLexer = type { %prismio.str, ptr, %prismio.str, ptr, i32, i32, i32, i32 }
%UmsParser = type { ptr, ptr, %prismio.str, i32 }
%UmsWorkspace = type { ptr, ptr, ptr, i1 }
%"Option$Int" = type { i32, i32 }
