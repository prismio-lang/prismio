# IDE directories
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# System files
.DS_Store
Thumbs.db

# Log files
*.log

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.obj
*.ll
*.so
*.a
*.lib
*.la
*.lo
*.pid
*.gz
*.zip
*.tar
*.7z
*.rar

# Build output (bootstrap generations and their intermediates)
build/

# Project-local UMS build state and artifacts.
.prismio/

# Build temporaries the compiler writes beside the source it is compiling:
# ".prismio-<stem>-<suffix>" (compiler_temp_path in runtime/build_driver.c).
# Most are deleted on the way out; two are deliberately kept, so they need a rule
# rather than luck -- a workload's measured profile, and a workload driver's IR
# when it fails to build, which is kept precisely so someone can read it.
.prismio-*

# The bootstrap seed is tracked despite `*.ll` above, but a refreshed one is never
# staged or committed until the maintainer says so (a commit per refresh would bloat
# the history): .githooks/pre-commit refuses it. tools/refresh_seed.py writes it here.
!bootstrap/seed.ll

# LLVM toolchain fetched by tools/setup_llvm.py. Multi-GB, and llvm-paths.json
# holds absolute paths that are only valid on the machine that generated it.
third_party/

# Dependencies
node_modules/
*.jar
*.war
*.ear

external/

# Codeium
*~
configuration/
package.tar.xz

# Release artifacts. Built by tools/release.sh on each platform and attached
# to the release; reproducible from the tagged commit, so not committed.
dist/

# The graphify knowledge graph (`graphify update .`): a local index of this checkout, rebuilt
# from the tree, holding absolute paths of this machine. Not tracked.
**/graphify-out/

# Python bytecode. Interpreter-written build output for tools/ and tests/, keyed
# on the CPython version that wrote it -- `tools/__pycache__/*.cpython-313.pyc`
# is not reusable by anyone on a different 3.x, and two of them were committed.
__pycache__/
*.pyc

# Build products the compiler leaves beside a test source. `prismio run
# tests/foo.psm` writes an executable named `tests/foo` -- no extension, so the
# `*.exe` rule above does not catch it, and three of them were committed once by
# a `git add -A`. Everything tracked under tests/ is a .psm or the runner, so
# those come back explicitly.
tests/*
!tests/*.psm
!tests/*.py
# Modules a test imports live one directory down (`import visibility.gamma` is
# tests/visibility/gamma.psm). Without these three lines the rule above ignored
# them too, so a fixture module added after the rule never reached a commit:
# three were missing, and six tests failed on every CI runner and passed here.
!tests/*/
tests/*/*
!tests/*/*.psm
# The C half of run_produce_deallocator_test's fixture: a library with its own deallocator.
!tests/produce_deallocators/*.c

# ...except this one, which is generated: run_workload_test writes it from
# workload_static.psm with the `workload` block stripped, as the control the
# measured build is compared against.
tests/workload_static_control.psm
scratch/
docs/porting/decode_example
